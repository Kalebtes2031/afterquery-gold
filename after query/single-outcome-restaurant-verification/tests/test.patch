+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Restaurant Claim Verification - Public HTTP Endpoint Behavior", () => {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/restaurant-claim-request", restaurantClaimRouter);
+  app.use((err: any, _req: any, res: any, _next: any) => {
+    res.status(err.statusCode || 500).json({
+      success: false,
+      message: err.message || "Internal Server Error",
+    });
+  });
+
+  beforeEach(() => {
