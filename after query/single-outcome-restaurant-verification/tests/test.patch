+import express from "express";
+import request from "supertest";
+import restaurantClaimRouter from "../../routes/restaurant_claim_request.route";
+import {
+  AdminUser,
+  RestaurantClaimRequest,
+} from "../../models";
+import { Status } from "../../models/RestaurantClaim/RestaurantClaimRequest";
+import sequelize from "../../config/db";
+
+jest.mock("../../middlewares/auth", () => ({
+  authenticateToken: (req: any, _res: any, next: any) => {
+    req.user = { id: "admin-uuid-1", is_super_admin: true };
+    next();
+  },
+  authorizeRole: (_roles: any) => (_req: any, _res: any, next: any) => next(),
+}));
+
+jest.mock("../../models", () => ({
+  RestaurantClaimRequest: {
+    findByPk: jest.fn(),
+  },
+  RestaurantChain: {
+    findByPk: jest.fn(),
+  },
+  AdminUser: {
+    findAll: jest.fn().mockResolvedValue([]),
+    findByPk: jest.fn().mockResolvedValue({ id: "admin-uuid-1" }),
+  },
+  Notification: {
+    create: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Restaurant Claim Verification - Batch Verification Endpoint", () => {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/restaurant-claim-request", restaurantClaimRouter);
+  app.use((err: any, _req: any, res: any, _next: any) => {
+    res.status(err.statusCode || 500).json({
+      success: false,
+      message: err.message || "Internal Server Error",
+    });
+  });
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    // The verifier's jest config sets resetMocks, which strips the mock
+    // implementation declared in the jest.mock factory above; reinstall it so
+    // the batch runs inside the stubbed transaction.
+    (sequelize.transaction as jest.Mock).mockImplementation((cb: any) =>
+      cb({
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      })
+    );
+  });
+
+  it("returns 400 when body does not contain claims array", async () => {
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({});
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when claims array is empty", async () => {
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({ claims: [] });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when duplicate claim IDs are detected in batch payload", async () => {
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [
+          { claimId: "c-dup-1", action: "approve" },
+          { claimId: "c-dup-1", action: "reject" },
+        ],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Duplicate claim request id");
+  });
+
+  it("returns 400 when an invalid verification action is specified", async () => {
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [{ claimId: "c-1", action: "unknown_action" }],
+      });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when claimId is missing or empty whitespace", async () => {
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [{ claimId: "   ", action: "approve" }],
+      });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("successfully verifies mixed batch claims in exact requested order", async () => {
+    const mockClaim1 = {
+      id: "c-b1",
+      restaurant_id: "r-b1",
+      status: Status.Pending,
+      save: jest.fn().mockResolvedValue(true),
+    };
+    const mockClaim2 = {
+      id: "c-b2",
+      restaurant_id: "r-b2",
+      status: Status.Pending,
+      save: jest.fn().mockResolvedValue(true),
+    };
+
+    (RestaurantClaimRequest.findByPk as jest.Mock)
+      .mockResolvedValueOnce(mockClaim1)
+      .mockResolvedValueOnce(mockClaim2);
+    (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [
+          { claimId: "c-b1", action: "approve" },
+          { claimId: "c-b2", action: "reject", rejectionReason: "Bad photo" },
+        ],
+      });
+
+    expect(res.status).toBe(200);
+    expect(res.body.success).toBe(true);
+    expect(res.body.data).toHaveLength(2);
+    expect(res.body.data[0].id).toBe("c-b1");
+    expect(res.body.data[0].status).toBe("Approved");
+    expect(res.body.data[1].id).toBe("c-b2");
+    expect(res.body.data[1].status).toBe("Rejected");
+  });
+
+  it("rolls back batch when any claim fails or is not found", async () => {
+    (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(null);
+
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [{ claimId: "c-missing", action: "approve" }],
+      });
+
+    expect(res.status).toBe(404);
+  });
+
+  it("rolls back batch when any claim is already in a terminal state", async () => {
+    const mockClaim = {
+      id: "c-term",
+      status: Status.Approved,
+    };
+    (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [{ claimId: "c-term", action: "approve" }],
+      });
+
+    expect(res.status).toBe(409);
+  });
+
+  it("handles batch payload with mixed casing in action strings", async () => {
+    const mockClaim1 = { id: "c-case1", restaurant_id: "r-1", status: Status.Pending, save: jest.fn().mockResolvedValue(true) };
+    const mockClaim2 = { id: "c-case2", restaurant_id: "r-2", status: Status.Pending, save: jest.fn().mockResolvedValue(true) };
+    (RestaurantClaimRequest.findByPk as jest.Mock)
+      .mockResolvedValueOnce(mockClaim1)
+      .mockResolvedValueOnce(mockClaim2);
+    (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [
+          { claimId: "c-case1", action: "APPROVE" },
+          { claimId: "c-case2", action: "ReJeCt" },
+        ],
+      });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data[0].status).toBe("Approved");
+    expect(res.body.data[1].status).toBe("Rejected");
+  });
+
+  it("handles batch with whitespace padding in claim IDs seamlessly", async () => {
+    const mockClaim = { id: "c-pad", restaurant_id: "r-pad", status: Status.Pending, save: jest.fn().mockResolvedValue(true) };
+    (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+    (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [{ claimId: "   c-pad   ", action: "approve" }],
+      });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data[0].id).toBe("c-pad");
+  });
+
+  it("ensures batch transaction rolls back cleanly when duplicate ID appears with whitespace", async () => {
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [
+          { claimId: "c-dup-ws", action: "approve" },
+          { claimId: "   c-dup-ws   ", action: "reject" },
+        ],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Duplicate claim request id");
+  });
+
+  it("rejects batch verification when claim array contains null elements", async () => {
+    const res = await request(app)
+      .post("/api/v1/restaurant-claim-request/batch-verify")
+      .send({
+        claims: [null],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Claim item at index 0 must be an object");
+  });
+});
