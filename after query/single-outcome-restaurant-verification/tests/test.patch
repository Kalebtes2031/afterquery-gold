+import {
+  formatClaimVerificationSummary,
+  parseVerificationFilters,
+  isValidClaimIdentifier,
+  sanitizeVerificationMetrics,
+  createVerificationErrorEnvelope,
+  formatClaimVerificationAuditRecord,
+  isPermissibleStatusTransition,
+  serializeClaimVerificationReport,
+  validateBatchClaimVolume,
+} from "../../utils/restaurant-claim-outcome.utils";
+import { ClaimVerificationStatus } from "../../types/restaurant-claim-outcome.types";
+
+describe("Restaurant Claim Verification - Utility & Filter Logic", () => {
+  it("formats claim verification summary correctly for approved and rejected sets", () => {
+    const summary = formatClaimVerificationSummary([
+      {
+        id: "c-1",
+        restaurant_id: "r-1",
+        status: ClaimVerificationStatus.Approved,
+        reviewed_at: new Date(),
+        reviewed_by: "u-1",
+      },
+      {
+        id: "c-2",
+        restaurant_id: "r-2",
+        status: ClaimVerificationStatus.Rejected,
+        reviewed_at: new Date(),
+        reviewed_by: "u-1",
+      },
+    ]);
+
+    expect(summary.total).toBe(2);
+    expect(summary.approved).toBe(1);
+    expect(summary.rejected).toBe(1);
+  });
+
+  it("parses verification filters with limit, offset, and status", () => {
+    const filters = parseVerificationFilters({
+      status: "Approved",
+      restaurantId: "r-100",
+      limit: "25",
+      offset: "10",
+    });
+
+    expect(filters.status).toBe(ClaimVerificationStatus.Approved);
+    expect(filters.restaurantId).toBe("r-100");
+    expect(filters.limit).toBe(25);
+    expect(filters.offset).toBe(10);
+  });
+
+  it("validates claim identifier formats accurately", () => {
+    expect(isValidClaimIdentifier("c-12345")).toBe(true);
+    expect(isValidClaimIdentifier("claim-abcd-1234")).toBe(true);
+    expect(isValidClaimIdentifier("123e4567-e89b-12d3-a456-426614174000")).toBe(true);
+    expect(isValidClaimIdentifier("")).toBe(false);
+  });
+
+  it("sanitizes verification metrics and builds standardized error envelopes", () => {
+    const metrics = sanitizeVerificationMetrics({ pending: 4, approved: 10, rejected: 2 });
+    expect(metrics.totalClaims).toBe(16);
+    expect(metrics.approvedCount).toBe(10);
+
+    const errorBody = createVerificationErrorEnvelope(409, "Claim conflict detected");
+    expect(errorBody.success).toBe(false);
+    expect(errorBody.message).toBe("Claim conflict detected");
+  });
+
+  it("formats claim audit records with timestamps and reviewer IDs", () => {
+    const record = formatClaimVerificationAuditRecord(
+      { id: "c-1", restaurant_id: "r-1", status: "Approved" },
+      "approve",
+      "admin-1"
+    );
+    expect(record.claimId).toBe("c-1");
+    expect(record.resultingStatus).toBe("Approved");
+    expect(record.reviewerId).toBe("admin-1");
+  });
+
+  it("serializes claim verification reports and validates batch volume bounds", () => {
+    const report = serializeClaimVerificationReport([
+      { id: "c-1", restaurant_id: "r-1", status: "Approved" },
+    ]);
+    expect(report[0].id).toBe("c-1");
+
+    const check = validateBatchClaimVolume([{ claimId: "c-1", action: "approve" }]);
+    expect(check.valid).toBe(true);
+
+    const emptyCheck = validateBatchClaimVolume([]);
+    expect(emptyCheck.valid).toBe(false);
+  });
+
+  it("validates permissible status transitions and claim serialization", () => {
+    expect(isPermissibleStatusTransition("Pending", "Approved")).toBe(true);
+    expect(isPermissibleStatusTransition("Pending", "Rejected")).toBe(true);
+    expect(isPermissibleStatusTransition("Approved", "Pending")).toBe(false);
+    expect(isPermissibleStatusTransition("Rejected", "Approved")).toBe(false);
+  });
+});
