+    expect(res.body.data[0]).toHaveProperty("reviewed_at");
+    expect(res.body.data[1]).toHaveProperty("reviewed_at");
+  });
+
+  it("rolls back batch when any claim fails or is not found", async () => {
+    const mockClaim1 = {
+      id: "c-first",
+      restaurant_id: "r-first",
+      restaurant_chain_id: null,
