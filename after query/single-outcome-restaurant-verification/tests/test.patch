+import { NextFunction, Request, Response } from "express";
+import {
+  approveRestaurantClaimRequest,
+  rejectRestaurantClaimRequest,
+} from "../../controllers/restaurant_claim_request.controller";
+import RestaurantClaimRequest, {
+  Status,
+} from "../../models/RestaurantClaim/RestaurantClaimRequest";
+import { AdminUser, Notification, RestaurantChain } from "../../models";
+import sequelize from "../../config/db";
+import {
+  ConflictError,
+  NotFoundError,
+} from "../../utils/error-response.utils";
+
+jest.mock("../../models/RestaurantClaim/RestaurantClaimRequest", () => {
+  const original = jest.requireActual("../../models/RestaurantClaim/RestaurantClaimRequest");
+  return {
+    __esModule: true,
+    default: {
+      findOne: jest.fn(),
+      findByPk: jest.fn(),
+    },
+    Status: original.Status,
+  };
+});
+
+jest.mock("../../models", () => ({
+  AdminUser: {
+    findByPk: jest.fn(),
+    findAll: jest.fn(),
+  },
+  RestaurantChain: {
+    findOne: jest.fn(),
+  },
+  Notification: {
+    create: jest.fn(),
+  },
+  Role: {},
+}));
+
+jest.mock("../../config/db", () => ({
+  transaction: jest.fn(),
+}));
+
+jest.mock("../../utils/notification.utils", () => ({
+  __esModule: true,
+  default: jest.fn().mockResolvedValue(undefined),
+}));
+
+describe("Restaurant Claim Verification - Lifecycle & State Guards", () => {
+  let mockTransaction: any;
+  let req: Partial<Request>;
+  let res: Partial<Response>;
+  let next: NextFunction;
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    mockTransaction = {
+      LOCK: { UPDATE: "UPDATE" },
+      commit: jest.fn().mockResolvedValue(undefined),
+      rollback: jest.fn().mockResolvedValue(undefined),
+    };
+    (sequelize.transaction as jest.Mock).mockResolvedValue(mockTransaction);
+
+    req = {
+      params: { claimId: "claim-100" },
+      body: {},
+      user: { id: "admin-verifier" },
+    };
+    res = {
+      status: jest.fn().mockReturnThis(),
+      json: jest.fn(),
+    };
+    next = jest.fn();
+
+    (AdminUser.findByPk as jest.Mock).mockResolvedValue({ id: "admin-verifier" });
+    (AdminUser.findAll as jest.Mock).mockResolvedValue([
+      { id: "adm-1", fcm_token: "token-1" },
+    ]);
+  });
+
+  describe("Approving Restaurant Claim Requests", () => {
+    it("approves a pending claim request and transitions to Approved", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        restaurant_name: "Abyssinia Grill",
+        status: Status.Pending,
+        restaurant_chain_id: null,
+        save: jest.fn().mockResolvedValue(undefined),
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(mockClaim.status).toBe(Status.Approved);
+      expect(mockClaim.save).toHaveBeenCalledWith({ transaction: mockTransaction });
+      expect(mockTransaction.commit).toHaveBeenCalled();
+      expect(res.status).toHaveBeenCalledWith(200);
+      expect(res.json).toHaveBeenCalledWith(
+        expect.objectContaining({
+          success: true,
+          message: "Request approved successfully",
+          data: expect.objectContaining({ status: Status.Approved }),
+        })
+      );
+    });
+
+    it("creates notification records for super admins upon approval", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        restaurant_name: "Lucy Cafe",
+        status: Status.Pending,
+        restaurant_chain_id: null,
+        save: jest.fn().mockResolvedValue(undefined),
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(Notification.create).toHaveBeenCalledWith(
+        expect.objectContaining({
+          notifiable_type: "RestaurantClaimRequest",
+          notifiable_id: "claim-100",
+          message: "Claim request for restaurant Lucy Cafe has been approved.",
+        }),
+        { transaction: mockTransaction }
+      );
+    });
+
+    it("verifies and synchronizes associated restaurant chain when chainId is present", async () => {
+      const mockChain = {
+        id: "chain-55",
+        name: "Chain Brand",
+        save: jest.fn().mockResolvedValue(undefined),
+      };
+      const mockClaim = {
+        id: "claim-100",
+        restaurant_name: "Chain Brand Store 1",
+        status: Status.Pending,
+        restaurant_chain_id: "chain-55",
+        save: jest.fn().mockResolvedValue(undefined),
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+      (RestaurantChain.findOne as jest.Mock).mockResolvedValue(mockChain);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(RestaurantChain.findOne).toHaveBeenCalledWith(
+        expect.objectContaining({ where: { id: "chain-55" }, transaction: mockTransaction })
+      );
+      expect(mockChain.save).toHaveBeenCalledWith({ transaction: mockTransaction });
+      expect(mockTransaction.commit).toHaveBeenCalled();
+    });
+
+    it("approving claim with null restaurant_chain_id does not query or save chain", async () => {
+      const mockClaim = {
+        id: "claim-no-chain",
+        restaurant_name: "Independent Diner",
+        status: Status.Pending,
+        restaurant_chain_id: null,
+        save: jest.fn().mockResolvedValue(undefined),
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(RestaurantChain.findOne).not.toHaveBeenCalled();
+      expect(mockClaim.status).toBe(Status.Approved);
+      expect(mockTransaction.commit).toHaveBeenCalled();
+    });
+
+    it("returns 409 when attempting to approve an already approved claim request", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        status: Status.Approved,
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Claim request already approved",
+          statusCode: 409,
+        })
+      );
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+    });
+
+    it("returns 409 when attempting to approve an already rejected claim request", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        status: Status.Rejected,
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Claim request already rejected",
+          statusCode: 409,
+        })
+      );
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+    });
+
+    it("returns 404 when claim request does not exist", async () => {
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(null);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Request not found",
+          statusCode: 404,
+        })
+      );
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+    });
+  });
+
+  describe("Rejecting Restaurant Claim Requests", () => {
+    it("rejects a pending claim request and transitions to Rejected with reason", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        restaurant_name: "Red Sea Fish",
+        status: Status.Pending,
+        save: jest.fn().mockResolvedValue(undefined),
+      };
+      req.body = { reason: "Invalid business license" };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await rejectRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(mockClaim.status).toBe(Status.Rejected);
+      expect(mockClaim.save).toHaveBeenCalledWith({ transaction: mockTransaction });
+      expect(Notification.create).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: expect.stringContaining("Reason: Invalid business license"),
+        }),
+        { transaction: mockTransaction }
+      );
+      expect(mockTransaction.commit).toHaveBeenCalled();
+      expect(res.status).toHaveBeenCalledWith(200);
+    });
+
+    it("rejects a pending claim request without reason when none provided", async () => {
+      const mockClaim = {
+        id: "claim-no-reason",
+        restaurant_name: "Tana Spot",
+        status: Status.Pending,
+        save: jest.fn().mockResolvedValue(undefined),
+      };
+      req.body = {};
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await rejectRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(mockClaim.status).toBe(Status.Rejected);
+      expect(Notification.create).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Claim request for restaurant Tana Spot has been rejected.",
+        }),
+        { transaction: mockTransaction }
+      );
+    });
+
+    it("returns 409 when attempting to reject an already rejected claim request", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        status: Status.Rejected,
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await rejectRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Claim request already rejected",
+          statusCode: 409,
+        })
+      );
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+    });
+
+    it("returns 409 when attempting to reject an already approved claim request", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        status: Status.Approved,
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await rejectRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Claim request already approved",
+          statusCode: 409,
+        })
+      );
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+    });
+
+    it("returns 404 when claim request to reject is not found", async () => {
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(null);
+
+      await rejectRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Request not found",
+          statusCode: 404,
+        })
+      );
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+    });
+  });
+
+  describe("Transactional Integrity", () => {
+    it("rolls back approval transaction if database save fails", async () => {
+      const mockClaim = {
+        id: "claim-100",
+        status: Status.Pending,
+        save: jest.fn().mockRejectedValue(new Error("Database lock timeout")),
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(mockClaim);
+
+      await approveRestaurantClaimRequest(req as Request, res as Response, next);
+
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+      expect(next).toHaveBeenCalledWith(expect.any(Error));
+    });
+  });
+});
