+    expect(res.status).toBe(400);
+    expect(res.body.success).toBe(false);
+    expect(res.body.message).toContain("Duplicate claim request id");
+  });
+
+  it("successfully verifies mixed batch claims in exact requested order", async () => {
+    const mockClaim1 = {
+      id: "c-b1",
+      restaurant_id: "r-b1",
+      restaurant_chain_id: null,
