+import { Status } from "../../../models/RestaurantClaim/RestaurantClaimRequest";
+
+export interface MockClaimRequestRecord {
+  id: string;
+  restaurant_name: string;
+  phone_number: string;
+  requester_name: string;
+  business_license: string;
+  tin_number: number;
+  address: string;
+  city: string;
+  email: string;
+  restaurant_chain_id?: string | null;
+  status: Status;
+}
+
+export class MockRestaurantClaimDb {
+  public claims: Map<string, MockClaimRequestRecord> = new Map();
+  public chains: Map<string, any> = new Map();
+  public notifications: any[] = [];
+
+  public reset(): void {
+    this.claims.clear();
+    this.chains.clear();
+    this.notifications = [];
+  }
+
+  public seedClaim(claim: MockClaimRequestRecord): void {
+    this.claims.set(claim.id, { ...claim });
+  }
+
+  public seedChain(chain: { id: string; name: string; admin_user_id?: string | null }): void {
+    this.chains.set(chain.id, { ...chain });
+  }
+
+  public getClaim(id: string): MockClaimRequestRecord | undefined {
+    return this.claims.get(id);
+  }
+}
