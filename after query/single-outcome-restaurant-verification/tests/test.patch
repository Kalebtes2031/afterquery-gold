+import { NextFunction, Request, Response } from "express";
+import { verifyRestaurantClaimBatch } from "../../controllers/restaurant_claim_request.controller";
+import { RestaurantClaimVerificationService } from "../../services/restaurant-claim-verification.service";
+import RestaurantClaimRequest, {
+  Status,
+} from "../../models/RestaurantClaim/RestaurantClaimRequest";
+import { AdminUser, Notification } from "../../models";
+import sequelize from "../../config/db";
+import {
+  BadRequestError,
+  ConflictError,
+  NotFoundError,
+} from "../../utils/error-response.utils";
+
+jest.mock("../../models/RestaurantClaim/RestaurantClaimRequest", () => {
+  const original = jest.requireActual("../../models/RestaurantClaim/RestaurantClaimRequest");
+  return {
+    __esModule: true,
+    default: {
+      findOne: jest.fn(),
+      findByPk: jest.fn(),
+    },
+    Status: original.Status,
+  };
+});
+
+jest.mock("../../models", () => ({
+  AdminUser: {
+    findByPk: jest.fn(),
+    findAll: jest.fn(),
+  },
+  RestaurantChain: {
+    findOne: jest.fn(),
+  },
+  Notification: {
+    create: jest.fn(),
+  },
+  Role: {},
+}));
+
+jest.mock("../../config/db", () => ({
+  transaction: jest.fn(),
+}));
+
+describe("Restaurant Claim Verification - Batch Moderation & Determinism", () => {
+  let mockTransaction: any;
+  let req: Partial<Request>;
+  let res: Partial<Response>;
+  let next: NextFunction;
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    mockTransaction = {
+      LOCK: { UPDATE: "UPDATE" },
+      commit: jest.fn().mockResolvedValue(undefined),
+      rollback: jest.fn().mockResolvedValue(undefined),
+    };
+    (sequelize.transaction as jest.Mock).mockResolvedValue(mockTransaction);
+
+    req = {
+      body: {},
+      user: { id: "admin-super" },
+    };
+    res = {
+      status: jest.fn().mockReturnThis(),
+      json: jest.fn(),
+    };
+    next = jest.fn();
+
+    (AdminUser.findByPk as jest.Mock).mockResolvedValue({ id: "admin-super" });
+    (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+  });
+
+  describe("Batch Verification Payload Validation", () => {
+    it("returns 400 when body has no claims field", async () => {
+      req.body = {};
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Field 'claims' must be a non-empty array",
+          statusCode: 400,
+        })
+      );
+    });
+
+    it("returns 400 when claims array is empty", async () => {
+      req.body = { claims: [] };
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Field 'claims' cannot be empty",
+          statusCode: 400,
+        })
+      );
+    });
+
+    it("returns 400 with 'Duplicate claim request id' when duplicate ids exist in claims array", async () => {
+      req.body = {
+        claims: [
+          { claimId: "claim-dup", action: "approve" },
+          { claimId: "claim-dup", action: "reject" },
+        ],
+      };
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Duplicate claim request id",
+          statusCode: 400,
+        })
+      );
+    });
+
+    it("returns 400 when an action in claims array is invalid", async () => {
+      req.body = {
+        claims: [{ claimId: "claim-1", action: "discard" }],
+      };
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Invalid verification action: must be 'approve' or 'reject'",
+          statusCode: 400,
+        })
+      );
+    });
+
+    it("returns 400 when an item in claims array is not an object", async () => {
+      req.body = {
+        claims: ["invalid-item-string"],
+      };
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: expect.stringContaining("must be an object"),
+          statusCode: 400,
+        })
+      );
+    });
+  });
+
+  describe("Batch Execution & Ordering", () => {
+    it("successfully verifies mixed approval and rejection claims in single transaction", async () => {
+      req.body = {
+        claims: [
+          { claimId: "c-1", action: "approve" },
+          { claimId: "c-2", action: "reject", reason: "Unreadable TIN certificate" },
+        ],
+      };
+
+      const claim1 = { id: "c-1", restaurant_name: "C1", status: Status.Pending, save: jest.fn().mockResolvedValue(undefined) };
+      const claim2 = { id: "c-2", restaurant_name: "C2", status: Status.Pending, save: jest.fn().mockResolvedValue(undefined) };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "c-1") return Promise.resolve(claim1);
+        if (where.id === "c-2") return Promise.resolve(claim2);
+        return Promise.resolve(null);
+      });
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(claim1.status).toBe(Status.Approved);
+      expect(claim2.status).toBe(Status.Rejected);
+      expect(mockTransaction.commit).toHaveBeenCalledTimes(1);
+      expect(res.status).toHaveBeenCalledWith(200);
+      expect(res.json).toHaveBeenCalledWith({
+        success: true,
+        data: [
+          expect.objectContaining({ id: "c-1", status: Status.Approved }),
+          expect.objectContaining({ id: "c-2", status: Status.Rejected }),
+        ],
+      });
+    });
+
+    it("returns results in the exact requested order of claimIds", async () => {
+      req.body = {
+        claims: [
+          { claimId: "claim-second", action: "reject" },
+          { claimId: "claim-first", action: "approve" },
+        ],
+      };
+
+      const claimFirst = { id: "claim-first", status: Status.Pending, save: jest.fn().mockResolvedValue(undefined) };
+      const claimSecond = { id: "claim-second", status: Status.Pending, save: jest.fn().mockResolvedValue(undefined) };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "claim-first") return Promise.resolve(claimFirst);
+        if (where.id === "claim-second") return Promise.resolve(claimSecond);
+        return Promise.resolve(null);
+      });
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(res.json).toHaveBeenCalledWith({
+        success: true,
+        data: [
+          expect.objectContaining({ id: "claim-second" }),
+          expect.objectContaining({ id: "claim-first" }),
+        ],
+      });
+    });
+
+    it("trims whitespace from claim ids in batch", async () => {
+      req.body = {
+        claims: [{ claimId: "  claim-padded  ", action: "approve" }],
+      };
+
+      const claimPadded = { id: "claim-padded", status: Status.Pending, save: jest.fn().mockResolvedValue(undefined) };
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(claimPadded);
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(RestaurantClaimRequest.findOne).toHaveBeenCalledWith(
+        expect.objectContaining({ where: { id: "claim-padded" } })
+      );
+    });
+  });
+
+  describe("Batch Rollback on Failures", () => {
+    it("rolls back entire batch when one claim request is not found", async () => {
+      req.body = {
+        claims: [
+          { claimId: "claim-exists", action: "approve" },
+          { claimId: "claim-missing", action: "reject" },
+        ],
+      };
+
+      const claimExists = { id: "claim-exists", status: Status.Pending, save: jest.fn().mockResolvedValue(undefined) };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "claim-exists") return Promise.resolve(claimExists);
+        return Promise.resolve(null);
+      });
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(mockTransaction.rollback).toHaveBeenCalledTimes(1);
+      expect(mockTransaction.commit).not.toHaveBeenCalled();
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Request not found",
+          statusCode: 404,
+        })
+      );
+    });
+
+    it("rolls back entire batch when one claim request is already approved", async () => {
+      req.body = {
+        claims: [
+          { claimId: "claim-1", action: "reject" },
+          { claimId: "claim-already", action: "approve" },
+        ],
+      };
+
+      const claim1 = { id: "claim-1", status: Status.Pending, save: jest.fn().mockResolvedValue(undefined) };
+      const claimAlready = { id: "claim-already", status: Status.Approved };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "claim-1") return Promise.resolve(claim1);
+        if (where.id === "claim-already") return Promise.resolve(claimAlready);
+        return Promise.resolve(null);
+      });
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Claim request already approved",
+          statusCode: 409,
+        })
+      );
+    });
+
+    it("rolls back entire batch when one claim request is already rejected", async () => {
+      req.body = {
+        claims: [
+          { claimId: "claim-already-rej", action: "approve" },
+          { claimId: "claim-2", action: "reject" },
+        ],
+      };
+
+      const claimAlreadyRej = { id: "claim-already-rej", status: Status.Rejected };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockResolvedValue(claimAlreadyRej);
+
+      await verifyRestaurantClaimBatch(req as Request, res as Response, next);
+
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Claim request already rejected",
+          statusCode: 409,
+        })
+      );
+    });
+  });
+
+  describe("Concurrency & Conflict Resistance", () => {
+    it("serializes concurrent reviews on same claim request so only one succeeds", async () => {
+      let state = {
+        id: "claim-race",
+        restaurant_name: "Racing Cafe",
+        status: Status.Pending,
+        save: jest.fn().mockImplementation(function() {
+          return Promise.resolve(undefined);
+        }),
+      };
+
+      (RestaurantClaimRequest.findOne as jest.Mock).mockImplementation(() => {
+        return Promise.resolve(state);
+      });
+
+      const firstCall = RestaurantClaimVerificationService.approveClaimRequestWithLock(
+        "claim-race",
+        "admin-1"
+      );
+
+      const res1 = await firstCall;
+      expect(res1).toBeDefined();
+      expect(state.status).toBe(Status.Approved);
+
+      await expect(
+        RestaurantClaimVerificationService.rejectClaimRequestWithLock(
+          "claim-race",
+          "admin-2"
+        )
+      ).rejects.toThrow(ConflictError);
+    });
+  });
+});
