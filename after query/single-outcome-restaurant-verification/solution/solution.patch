+++ b/rateeat_backend/src/types/restaurant-claim-outcome.types.ts
@@ -0,0 +1,91 @@
+/**
+ * Action type for restaurant claim verification.
+ */
+export enum ClaimVerificationAction {
+  Approve = "approve",
+  Reject = "reject",
+}
+
+/**
+ * Valid lifecycle states for a restaurant claim request.
+ */
+export enum ClaimVerificationStatus {
+  Pending = "Pending",
+  Approved = "Approved",
+  Rejected = "Rejected",
+}
+
+/**
+ * Single item inside a batch claim verification payload.
+ */
+export interface BatchClaimVerificationItem {
+  claimId: string;
+  action: ClaimVerificationAction | "approve" | "reject";
+  rejectionReason?: string;
+}
+
+/**
+ * Payload schema for POST /api/v1/restaurant-claim-request/batch-verify.
+ */
+export interface BatchClaimVerificationPayload {
+  claims: BatchClaimVerificationItem[];
+}
+
+/**
+ * Result representation for an individual claim verification.
+ */
+export interface ClaimVerificationResult {
+  id: string;
+  restaurant_id: string;
+  restaurant_chain_id?: string | null;
+  status: ClaimVerificationStatus;
+  rejection_reason?: string | null;
+  reviewed_at: Date;
+  reviewed_by: string;
+}
+
+/**
+ * Response schema for batch claim verification.
+ */
+export interface BatchClaimVerificationResponse {
+  totalProcessed: number;
+  approvedCount: number;
+  rejectedCount: number;
+  results: ClaimVerificationResult[];
+}
+
+/**
+ * Filter options for querying verification records and history.
+ */
+export interface VerificationFilterOptions {
+  status?: ClaimVerificationStatus;
+  restaurantId?: string;
+  chainId?: string;
+  reviewerId?: string;
+  limit?: number;
+  offset?: number;
+}
+
+/**
+ * Aggregated verification metrics for administrator analytics.
+ */
+export interface ClaimVerificationMetrics {
+  totalClaims: number;
+  pendingCount: number;
+  approvedCount: number;
+  rejectedCount: number;
+  chainLinkedCount: number;
+  averageReviewTimeMs?: number;
+}
+
+/**
+ * Audit log entry captured during verification status transitions.
+ */
+export interface ClaimVerificationAuditEntry {
+  claimId: string;
+  previousStatus: ClaimVerificationStatus;
+  newStatus: ClaimVerificationStatus;
+  reviewerId: string;
+  timestamp: Date;
+  metadata?: Record<string, any>;
+}
diff --git a/rateeat_backend/src/utils/restaurant-claim-outcome.utils.ts b/rateeat_backend/src/utils/restaurant-claim-outcome.utils.ts
new file mode 100644
index 0000000..c09e5e8
--- /dev/null
+++ b/rateeat_backend/src/utils/restaurant-claim-outcome.utils.ts
@@ -0,0 +1,231 @@
+import { BadRequestError } from "../utils/error-response.utils";
+import {
+  BatchClaimVerificationItem,
+  BatchClaimVerificationPayload,
+  ClaimVerificationAction,
+  ClaimVerificationMetrics,
+  ClaimVerificationResult,
+  ClaimVerificationStatus,
+  VerificationFilterOptions,
+} from "../types/restaurant-claim-outcome.types";
+
+/**
+ * Validates the batch verification payload structure, duplicate IDs, and actions.
+ */
+export function validateBatchClaimPayload(
+  body: any
+): BatchClaimVerificationPayload {
+  if (!body || typeof body !== "object") {
+    throw new BadRequestError("Request body must be a valid JSON object");
+  }
+
+  const { claims } = body;
+  if (!Array.isArray(claims)) {
+    throw new BadRequestError("Field 'claims' must be an array");
+  }
+
+  if (claims.length === 0) {
+    throw new BadRequestError("Field 'claims' cannot be an empty array");
+  }
+
+  const seenIds = new Set<string>();
+  const validatedItems: BatchClaimVerificationItem[] = [];
+
+  for (let i = 0; i < claims.length; i++) {
+    const item = claims[i];
+    if (!item || typeof item !== "object") {
+      throw new BadRequestError(`Claim item at index ${i} must be an object`);
+    }
+
+    const { claimId, action, rejectionReason } = item;
+    if (!claimId || typeof claimId !== "string" || claimId.trim().length === 0) {
+      throw new BadRequestError(
+        `Claim item at index ${i} is missing a valid 'claimId'`
+      );
+    }
+
+    const cleanClaimId = claimId.trim();
+    if (seenIds.has(cleanClaimId)) {
+      throw new BadRequestError(
+        `Duplicate claim request id '${cleanClaimId}' detected in batch payload`
+      );
+    }
+    seenIds.add(cleanClaimId);
+
+    const normalizedAction =
+      typeof action === "string" ? action.toLowerCase().trim() : "";
+    if (
+      normalizedAction !== ClaimVerificationAction.Approve &&
+      normalizedAction !== ClaimVerificationAction.Reject
+    ) {
+      throw new BadRequestError(
+        `Invalid verification action '${action}' at index ${i}. Must be 'approve' or 'reject'`
+      );
+    }
+
+    validatedItems.push({
+      claimId: cleanClaimId,
+      action: normalizedAction as ClaimVerificationAction,
+      rejectionReason:
+        typeof rejectionReason === "string" ? rejectionReason.trim() : undefined,
+    });
+  }
+
+  return { claims: validatedItems };
+}
+
+/**
+ * Summarizes the verification counts from a list of results.
+ */
+export function formatClaimVerificationSummary(
+  results: ClaimVerificationResult[]
+): { approved: number; rejected: number; total: number } {
+  let approved = 0;
+  let rejected = 0;
+  for (const res of results) {
+    if (res.status === ClaimVerificationStatus.Approved) {
+      approved++;
+    } else if (res.status === ClaimVerificationStatus.Rejected) {
+      rejected++;
+    }
+  }
+  return { approved, rejected, total: results.length };
+}
+
+/**
+ * Parses query parameters into structured verification filter options.
+ */
+export function parseVerificationFilters(query: any): VerificationFilterOptions {
+  const options: VerificationFilterOptions = {};
+  if (query.restaurantId && typeof query.restaurantId === "string") {
+    options.restaurantId = query.restaurantId.trim();
+  }
+  if (query.chainId && typeof query.chainId === "string") {
+    options.chainId = query.chainId.trim();
+  }
+  if (query.reviewerId && typeof query.reviewerId === "string") {
+    options.reviewerId = query.reviewerId.trim();
+  }
+  if (query.status && typeof query.status === "string") {
+    const s = query.status.trim();
+    if (s === "Approved") options.status = ClaimVerificationStatus.Approved;
+    else if (s === "Rejected") options.status = ClaimVerificationStatus.Rejected;
+    else if (s === "Pending") options.status = ClaimVerificationStatus.Pending;
+  }
+  if (query.limit) {
+    const lim = parseInt(query.limit, 10);
+    if (!isNaN(lim) && lim > 0) options.limit = Math.min(lim, 100);
+  }
+  if (query.offset) {
+    const off = parseInt(query.offset, 10);
+    if (!isNaN(off) && off >= 0) options.offset = off;
+  }
+  return options;
+}
+
+/**
+ * Formats aggregated claim metrics into a sanitized summary response.
+ */
+export function sanitizeVerificationMetrics(
+  counts: Record<string, number>
+): ClaimVerificationMetrics {
+  return {
+    totalClaims: (counts.pending || 0) + (counts.approved || 0) + (counts.rejected || 0),
+    pendingCount: counts.pending || 0,
+    approvedCount: counts.approved || 0,
+    rejectedCount: counts.rejected || 0,
+    chainLinkedCount: counts.chainLinked || 0,
+  };
+}
+
+/**
+ * Formats a single claim verification record for export or audit logging.
+ */
+export function formatClaimVerificationAuditRecord(
+  claim: any,
+  action: string,
+  reviewerId: string
+): Record<string, any> {
+  return {
+    claimId: claim.id,
+    restaurantId: claim.restaurant_id,
+    restaurantChainId: claim.restaurant_chain_id || null,
+    action,
+    resultingStatus: claim.status,
+    reviewerId,
+    verifiedAt: new Date().toISOString(),
+  };
+}
+
+/**
+ * Validates whether an incoming claim ID string conforms to a recognizable identifier format.
+ */
+export function isValidClaimIdentifier(id: string): boolean {
+  if (!id || typeof id !== "string") return false;
+  const uuidRegex =
+    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+  return (
+    uuidRegex.test(id.trim()) ||
+    id.trim().startsWith("claim-") ||
+    id.trim().startsWith("c-")
+  );
+}
+
+/**
+ * Builds a standardized error response body for verification failures.
+ */
+export function createVerificationErrorEnvelope(
+  statusCode: number,
+  message: string,
+  details?: any
+): { success: false; message: string; errorDetails?: any } {
+  return {
+    success: false,
+    message,
+    ...(details ? { errorDetails: details } : {}),
+  };
+}
+
+/**
+ * Validates permissible state transitions for claim verification.
+ */
+export function isPermissibleStatusTransition(
+  currentStatus: string,
+  nextStatus: string
+): boolean {
+  if (currentStatus === "Pending") {
+    return nextStatus === "Approved" || nextStatus === "Rejected";
+  }
+  return false;
+}
+
+/**
+ * Serializes claim verification results for audit exports.
+ */
+export function serializeClaimVerificationReport(
+  claims: any[]
+): Array<{ id: string; status: string }> {
+  return claims.map((c) => ({
+    id: c.id,
+    status: c.status,
+  }));
+}
+
+/**
+ * Validates batch claim volume bounds.
+ */
+export function validateBatchClaimVolume(
+  claims: any[],
+  maxVolume: number = 100
+): { valid: boolean; message?: string } {
+  if (!Array.isArray(claims) || claims.length === 0) {
+    return { valid: false, message: "Claims array cannot be empty" };
+  }
+  if (claims.length > maxVolume) {
+    return {
+      valid: false,
+      message: `Batch volume exceeds maximum allowable size of ${maxVolume}`,
+    };
+  }
+  return { valid: true };
+}
