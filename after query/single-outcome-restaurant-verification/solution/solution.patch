diff --git a/rateeat_backend/src/services/restaurant-claim-outcome.service.ts b/rateeat_backend/src/services/restaurant-claim-outcome.service.ts
new file mode 100644
index 0000000..3baca49
--- /dev/null
+++ b/rateeat_backend/src/services/restaurant-claim-outcome.service.ts
@@ -0,0 +1,189 @@
+import { Op, Transaction } from "sequelize";
+import sequelize from "../config/db";
+import {
+  AdminUser,
+  Notification,
+  RestaurantChain,
+  RestaurantClaimRequest,
+} from "../models";
+import { Status } from "../models/RestaurantClaim/RestaurantClaimRequest";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import { HttpError } from "../utils/error-response.utils";
+import {
+  BatchClaimVerificationItem,
+  ClaimVerificationMetrics,
+  ClaimVerificationResult,
+  ClaimVerificationStatus,
+} from "../types/restaurant-claim-outcome.types";
+
+type ReviewAction = "approve" | "reject";
+
+const TERMINAL_STATUSES: Status[] = [Status.Approved, Status.Rejected];
+
+/**
+ * Applies a single Pending -> terminal transition inside the supplied
+ * transaction. Throws an HttpError (404 / 409) rather than mutating anything
+ * when the claim is missing or already finalised, so the surrounding
+ * transaction rolls back.
+ */
+const applyTransition = async (
+  claimId: string,
+  action: ReviewAction,
+  reviewerId: string,
+  rejectionReason: string | undefined,
+  tx: Transaction
+): Promise<ClaimVerificationResult> => {
+  const claim: any = await RestaurantClaimRequest.findByPk(claimId, {
+    transaction: tx,
+    lock: tx.LOCK.UPDATE,
+  });
+
+  if (!claim) {
+    throw new HttpError("Restaurant claim request not found", 404);
+  }
+
+  if (TERMINAL_STATUSES.includes(claim.status)) {
+    throw new HttpError(
+      `Restaurant claim request '${claimId}' is already ${String(
+        claim.status
+      ).toLowerCase()}`,
+      409
+    );
+  }
+
+  const reviewedAt = new Date();
+
+  if (action === "approve") {
+    claim.status = Status.Approved;
+    await claim.save({ transaction: tx });
+
+    let chainVerified = false;
+    if (claim.restaurant_chain_id) {
+      const chain: any = await RestaurantChain.findByPk(
+        claim.restaurant_chain_id,
+        { transaction: tx, lock: tx.LOCK.UPDATE }
+      );
+      if (chain) {
+        chain.is_verified = true;
+        await chain.save({ transaction: tx });
+        chainVerified = true;
+      }
+    }
+
+    const superAdmins: any[] = await AdminUser.findAll({
+      where: { is_super_admin: true },
+      transaction: tx,
+    } as any);
+
+    for (const admin of superAdmins) {
+      await Notification.create(
+        {
+          user_id: admin.id,
+          reactor_id: reviewerId,
+          category: NotificationCategory.RestaurantClaim,
+          notifiable_type: "RestaurantClaimRequest",
+          notifiable_id: claim.id,
+          message: `Restaurant claim request ${claim.id} has been approved.`,
+        } as any,
+        { transaction: tx }
+      );
+    }
+
+    return {
+      id: claim.id,
+      restaurant_id: claim.restaurant_id,
+      restaurant_chain_id: claim.restaurant_chain_id ?? null,
+      status: ClaimVerificationStatus.Approved,
+      rejection_reason: null,
+      reviewed_at: reviewedAt,
+      reviewed_by: reviewerId,
+      chain_verified: chainVerified,
+      notifications_created: superAdmins.length,
+    };
+  }
+
+  claim.status = Status.Rejected;
+  if (rejectionReason) {
+    claim.rejection_reason = rejectionReason;
+  }
+  await claim.save({ transaction: tx });
+
+  return {
+    id: claim.id,
+    restaurant_id: claim.restaurant_id,
+    restaurant_chain_id: claim.restaurant_chain_id ?? null,
+    status: ClaimVerificationStatus.Rejected,
+    rejection_reason: rejectionReason ?? null,
+    reviewed_at: reviewedAt,
+    reviewed_by: reviewerId,
+    chain_verified: false,
+    notifications_created: 0,
+  };
+};
+
+export class RestaurantClaimOutcomeService {
+  /**
+   * Verifies one claim atomically.
+   */
+  static verifySingleClaim(
+    claimId: string,
+    action: ReviewAction,
+    reviewerId: string,
+    rejectionReason?: string
+  ): Promise<ClaimVerificationResult> {
+    return sequelize.transaction((tx) =>
+      applyTransition(claimId, action, reviewerId, rejectionReason, tx)
+    );
+  }
+
+  /**
+   * Verifies an ordered batch of claims in a single transaction. The first
+   * failure aborts the whole batch and rolls every earlier item back.
+   */
+  static verifyClaimBatch(
+    items: BatchClaimVerificationItem[],
+    reviewerId: string
+  ): Promise<ClaimVerificationResult[]> {
+    return sequelize.transaction(async (tx) => {
+      const results: ClaimVerificationResult[] = [];
+      for (const item of items) {
+        results.push(
+          await applyTransition(
+            item.claimId,
+            item.action,
+            reviewerId,
+            item.rejectionReason,
+            tx
+          )
+        );
+      }
+      return results;
+    });
+  }
+
+  /**
+   * Aggregated claim status counts for verification dashboards.
+   */
+  static async getVerificationMetrics(): Promise<ClaimVerificationMetrics> {
+    const pending = await RestaurantClaimRequest.count({
+      where: { status: Status.Pending },
+    });
+    const approved = await RestaurantClaimRequest.count({
+      where: { status: Status.Approved },
+    });
+    const rejected = await RestaurantClaimRequest.count({
+      where: { status: Status.Rejected },
+    });
+    const chainLinked = await RestaurantClaimRequest.count({
+      where: { restaurant_chain_id: { [Op.ne]: null } as any },
+    });
+
+    return {
+      totalClaims: pending + approved + rejected,
+      pendingCount: pending,
+      approvedCount: approved,
+      rejectedCount: rejected,
+      chainLinkedCount: chainLinked,
+    };
+  }
+}
