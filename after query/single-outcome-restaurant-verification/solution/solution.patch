@@ -0,0 +1,61 @@
+import {
+  BadRequestError,
+  ConflictError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import { Status } from "../models/RestaurantClaim/RestaurantClaimRequest";
+
+export class RestaurantClaimStateService {
+  public static ensureClaimExists(claim: any): void {
+    if (!claim) {
+      throw new NotFoundError("Request not found");
+    }
+  }
+
+  public static validateClaimForApproval(claim: any): void {
+    this.ensureClaimExists(claim);
+
+    if (claim.status === Status.Approved) {
+      throw new ConflictError("Claim request already approved");
+    }
+
+    if (claim.status === Status.Rejected) {
+      throw new ConflictError("Claim request already rejected");
+    }
+  }
+
+  public static validateClaimForRejection(claim: any): void {
+    this.ensureClaimExists(claim);
+
+    if (claim.status === Status.Rejected) {
+      throw new ConflictError("Claim request already rejected");
+    }
+
+    if (claim.status === Status.Approved) {
+      throw new ConflictError("Claim request already approved");
+    }
+  }
+
+  public static isTerminalState(status: any): boolean {
+    return status === Status.Approved || status === Status.Rejected;
+  }
+
+  public static assertPendingState(claim: any): void {
+    this.ensureClaimExists(claim);
+    if (this.isTerminalState(claim.status)) {
+      if (claim.status === Status.Approved) {
+        throw new ConflictError("Claim request already approved");
+      }
+      throw new ConflictError("Claim request already rejected");
+    }
+  }
+
+  public static validateTransition(currentStatus: Status, targetAction: "approve" | "reject"): void {
+    if (currentStatus === Status.Approved) {
+      throw new ConflictError("Claim request already approved");
+    }
+    if (currentStatus === Status.Rejected) {
+      throw new ConflictError("Claim request already rejected");
+    }
+  }
+}
diff --git a/rateeat_backend/src/services/restaurant-claim-verification.service.ts b/rateeat_backend/src/services/restaurant-claim-verification.service.ts
new file mode 100644
index 0000000..f7edcc1
--- /dev/null
+++ b/rateeat_backend/src/services/restaurant-claim-verification.service.ts
@@ -0,0 +1,225 @@
+import { Transaction } from "sequelize";
+import sequelize from "../config/db";
+import RestaurantClaimRequest, {
+  Status,
+} from "../models/RestaurantClaim/RestaurantClaimRequest";
+import { AdminUser, Notification, RestaurantChain, Role } from "../models";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import sendNotification from "../utils/notification.utils";
+import {
+  RestaurantClaimAuditRecord,
+  RestaurantClaimBatchItem,
+  RestaurantClaimBatchVerificationResult,
+} from "../types/restaurant-claim-verification.types";
+import { RestaurantClaimStateService } from "./restaurant-claim-state.service";
+import {
+  buildClaimNotificationMessage,
+  formatClaimResponse,
+} from "../utils/restaurant-claim-verification.utils";
+import { NotFoundError } from "../utils/error-response.utils";
+
+export class RestaurantClaimVerificationService {
+  public static async approveClaimRequestWithLock(
+    claimId: string,
+    adminUserId: string,
+    existingTransaction?: Transaction
+  ): Promise<any> {
+    const isOuterTransaction = !!existingTransaction;
+    const transaction = existingTransaction || (await sequelize.transaction());
+
+    try {
+      const claim = await RestaurantClaimRequest.findOne({
+        where: { id: claimId },
+        transaction,
+        lock: transaction.LOCK.UPDATE,
+      });
+
+      RestaurantClaimStateService.validateClaimForApproval(claim);
+
+      claim.status = Status.Approved;
+      await claim.save({ transaction });
+
+      if (claim.restaurant_chain_id) {
+        const chain = await RestaurantChain.findOne({
+          where: { id: claim.restaurant_chain_id },
+          transaction,
+          lock: transaction.LOCK.UPDATE,
+        });
+
+        if (chain) {
+          await chain.save({ transaction });
+        }
+      }
+
+      const admins = await AdminUser.findAll({
+        transaction,
+        include: [
+          {
+            model: Role,
+            where: {
+              name: ["super_admin", "admin"],
+            },
+          },
+        ],
+      });
+
+      const message = buildClaimNotificationMessage(claim.restaurant_name, "approve");
+      for (const admin of admins) {
+        await Notification.create(
+          {
+            notifiable_type: "RestaurantClaimRequest",
+            notifiable_id: claim.id,
+            user_id: admin.id,
+            reactor_id: adminUserId || "00000000-0000-0000-0000-000000000000",
+            message,
+            notification_category: NotificationCategory.General,
+          },
+          { transaction }
+        );
+
+        const registrationToken = admin.fcm_token;
+        if (registrationToken) {
+          try {
+            await sendNotification(
+              registrationToken,
+              "Restaurant Claim Approved",
+              message,
+              "businessApp"
+            );
+          } catch (notifErr) {
+            // Notification delivery failure does not roll back verified decision
+          }
+        }
+      }
+
+      if (!isOuterTransaction) {
+        await transaction.commit();
+      }
+
+      return claim;
+    } catch (error) {
+      if (!isOuterTransaction) {
+        try {
+          await transaction.rollback();
+        } catch (rbErr) {
+          // ignore
+        }
+      }
+      throw error;
+    }
+  }
+
+  public static async rejectClaimRequestWithLock(
+    claimId: string,
+    adminUserId: string,
+    existingTransaction?: Transaction,
+    reason?: string
+  ): Promise<any> {
+    const isOuterTransaction = !!existingTransaction;
+    const transaction = existingTransaction || (await sequelize.transaction());
+
+    try {
+      const claim = await RestaurantClaimRequest.findOne({
+        where: { id: claimId },
+        transaction,
+        lock: transaction.LOCK.UPDATE,
+      });
+
+      RestaurantClaimStateService.validateClaimForRejection(claim);
+
+      claim.status = Status.Rejected;
+      await claim.save({ transaction });
+
+      const admins = await AdminUser.findAll({
+        transaction,
+        include: [
+          {
+            model: Role,
+            where: {
+              name: ["super_admin", "admin"],
+            },
+          },
+        ],
+      });
+
+      const rejectMessage = buildClaimNotificationMessage(
+        claim.restaurant_name,
+        "reject",
+        reason
+      );
+
+      for (const admin of admins) {
+        await Notification.create(
+          {
+            notifiable_type: "RestaurantClaimRequest",
+            notifiable_id: claim.id,
+            user_id: admin.id,
+            reactor_id: adminUserId || "00000000-0000-0000-0000-000000000000",
+            message: rejectMessage,
+            notification_category: NotificationCategory.General,
+          },
+          { transaction }
+        );
+      }
+
+      if (!isOuterTransaction) {
+        await transaction.commit();
+      }
+
+      return claim;
+    } catch (error) {
+      if (!isOuterTransaction) {
+        try {
+          await transaction.rollback();
+        } catch (rbErr) {
+          // ignore
+        }
+      }
+      throw error;
+    }
+  }
+
+  public static async processBatchClaimVerification(
+    claims: RestaurantClaimBatchItem[],
+    adminUserId: string
+  ): Promise<RestaurantClaimBatchVerificationResult> {
+    const transaction = await sequelize.transaction();
+    const results: any[] = [];
+
+    try {
+      for (const item of claims) {
+        if (item.action === "approve") {
+          const approved =
+            await RestaurantClaimVerificationService.approveClaimRequestWithLock(
+              item.claimId,
+              adminUserId,
+              transaction
+            );
+          results.push(approved);
+        } else if (item.action === "reject") {
+          const rejected =
+            await RestaurantClaimVerificationService.rejectClaimRequestWithLock(
+              item.claimId,
+              adminUserId,
+              transaction,
+              item.reason
+            );
+          results.push(rejected);
+        }
+      }
+
+      await transaction.commit();
+      return {
+        success: true,
+        data: results,
+      };
+    } catch (error) {
+      try {
+        await transaction.rollback();
+      } catch (rbErr) {
+        // ignore
+      }
+      throw error;
+    }
+  }
+}
