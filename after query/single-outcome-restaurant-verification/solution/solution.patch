@@ -0,0 +1,55 @@
+/**
+ * Lifecycle states a restaurant claim request can be in.
+ */
+export enum ClaimVerificationStatus {
+  Pending = "Pending",
+  Approved = "Approved",
+  Rejected = "Rejected",
+}
+
+/**
+ * A single entry inside a batch verification payload.
+ */
+export interface BatchClaimVerificationItem {
+  claimId: string;
+  action: "approve" | "reject";
+  rejectionReason?: string;
+}
+
+/**
+ * Normalised result for one verified claim, returned to the caller.
+ */
+export interface ClaimVerificationResult {
+  id: string;
+  restaurant_id: string;
+  restaurant_chain_id?: string | null;
+  status: ClaimVerificationStatus;
+  rejection_reason?: string | null;
+  reviewed_at: Date;
+  reviewed_by: string;
+  chain_verified?: boolean;
+  notifications_created?: number;
+}
+
+/**
+ * Aggregated verification counts used by the metrics endpoint.
+ */
+export interface ClaimVerificationMetrics {
+  totalClaims: number;
+  pendingCount: number;
+  approvedCount: number;
+  rejectedCount: number;
+  chainLinkedCount: number;
+}
+
+/**
+ * Structured filters parsed from a verification list query string.
+ */
+export interface VerificationFilterOptions {
+  status?: ClaimVerificationStatus;
+  restaurantId?: string;
+  chainId?: string;
+  reviewerId?: string;
+  limit?: number;
+  offset?: number;
+}
diff --git a/rateeat_backend/src/utils/restaurant-claim-outcome.utils.ts b/rateeat_backend/src/utils/restaurant-claim-outcome.utils.ts
new file mode 100644
index 0000000..e04841b
--- /dev/null
+++ b/rateeat_backend/src/utils/restaurant-claim-outcome.utils.ts
@@ -0,0 +1,250 @@
+import { HttpError } from "./error-response.utils";
+import {
+  BatchClaimVerificationItem,
+  ClaimVerificationMetrics,
+  ClaimVerificationResult,
+  ClaimVerificationStatus,
+  VerificationFilterOptions,
+} from "../types/restaurant-claim-outcome.types";
+
+const REVIEW_ACTIONS = ["approve", "reject"] as const;
+const MAX_BATCH_CLAIMS = 100;
+
+/**
+ * The shared error helpers rewrite the message they are given; batch payload
+ * errors must reach the client verbatim, so build the 400 directly.
+ */
+const badRequest = (message: string): HttpError => new HttpError(message, 400);
+
+/**
+ * Validates the batch verification payload: shape, per-item fields, action
+ * values and duplicate ids (compared after trimming). Returns the normalised,
+ * ordered list of items.
+ */
+export function validateBatchClaimPayload(
+  body: any
+): BatchClaimVerificationItem[] {
+  if (!body || typeof body !== "object") {
+    throw badRequest("Request body must be a JSON object");
+  }
+
+  const { claims } = body as { claims?: unknown };
+
+  if (!Array.isArray(claims)) {
+    throw badRequest("Field 'claims' must be an array");
+  }
+
+  if (claims.length === 0) {
+    throw badRequest("Field 'claims' cannot be empty");
+  }
+
+  const seen = new Set<string>();
+
+  return claims.map((raw, index) => {
+    if (!raw || typeof raw !== "object") {
+      throw badRequest(`Claim item at index ${index} must be an object`);
+    }
+
+    const { claimId, action, rejectionReason } = raw as Record<string, unknown>;
+
+    if (typeof claimId !== "string" || claimId.trim().length === 0) {
+      throw badRequest(
+        `Claim item at index ${index} requires a non-empty 'claimId'`
+      );
+    }
+
+    const normalizedId = claimId.trim();
+
+    if (seen.has(normalizedId)) {
+      throw badRequest(
+        `Duplicate claim request id '${normalizedId}' detected in batch payload`
+      );
+    }
+    seen.add(normalizedId);
+
+    const normalizedAction =
+      typeof action === "string" ? action.trim().toLowerCase() : "";
+
+    if (!REVIEW_ACTIONS.includes(normalizedAction as (typeof REVIEW_ACTIONS)[number])) {
+      throw badRequest(
+        `Claim item at index ${index} has an invalid action; use 'approve' or 'reject'`
+      );
+    }
+
+    return {
+      claimId: normalizedId,
+      action: normalizedAction as "approve" | "reject",
+      rejectionReason:
+        typeof rejectionReason === "string" ? rejectionReason.trim() : undefined,
+    };
+  });
+}
+
+/**
+ * Summarises a list of verification results into approved / rejected / total.
+ */
+export function formatClaimVerificationSummary(
+  results: ClaimVerificationResult[]
+): { approved: number; rejected: number; total: number } {
+  let approved = 0;
+  let rejected = 0;
+  for (const result of results) {
+    if (result.status === ClaimVerificationStatus.Approved) approved += 1;
+    else if (result.status === ClaimVerificationStatus.Rejected) rejected += 1;
+  }
+  return { approved, rejected, total: results.length };
+}
+
+/**
+ * Parses a raw query object into structured verification filter options.
+ */
+export function parseVerificationFilters(query: any): VerificationFilterOptions {
+  const options: VerificationFilterOptions = {};
+
+  if (typeof query?.restaurantId === "string" && query.restaurantId.trim()) {
+    options.restaurantId = query.restaurantId.trim();
+  }
+  if (typeof query?.chainId === "string" && query.chainId.trim()) {
+    options.chainId = query.chainId.trim();
+  }
+  if (typeof query?.reviewerId === "string" && query.reviewerId.trim()) {
+    options.reviewerId = query.reviewerId.trim();
+  }
+  if (typeof query?.status === "string") {
+    const status = query.status.trim();
+    if (status === "Approved") options.status = ClaimVerificationStatus.Approved;
+    else if (status === "Rejected")
+      options.status = ClaimVerificationStatus.Rejected;
+    else if (status === "Pending")
+      options.status = ClaimVerificationStatus.Pending;
+  }
+  if (query?.limit !== undefined) {
+    const limit = parseInt(String(query.limit), 10);
+    if (!Number.isNaN(limit) && limit > 0) options.limit = Math.min(limit, 100);
+  }
+  if (query?.offset !== undefined) {
+    const offset = parseInt(String(query.offset), 10);
+    if (!Number.isNaN(offset) && offset >= 0) options.offset = offset;
+  }
+
+  return options;
+}
+
+/**
+ * Loose identifier check: accepts UUIDs and the short "c-" / "claim-" ids the
+ * product uses for seeded and imported claims.
+ */
+export function isValidClaimIdentifier(id: string): boolean {
+  if (!id || typeof id !== "string") return false;
+  const trimmed = id.trim();
+  if (trimmed.length === 0) return false;
+  const uuid =
+    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+  return (
+    uuid.test(trimmed) ||
+    trimmed.startsWith("claim-") ||
+    trimmed.startsWith("c-")
+  );
+}
+
+/**
+ * Normalises raw status counts into the metrics response shape.
+ */
+export function sanitizeVerificationMetrics(
+  counts: Record<string, number>
+): ClaimVerificationMetrics {
+  const pending = counts.pending || 0;
+  const approved = counts.approved || 0;
+  const rejected = counts.rejected || 0;
+  return {
+    totalClaims: pending + approved + rejected,
+    pendingCount: pending,
+    approvedCount: approved,
+    rejectedCount: rejected,
+    chainLinkedCount: counts.chainLinked || 0,
+  };
+}
+
+/**
+ * Builds an audit-log record for a single verification action.
+ */
+export function formatClaimVerificationAuditRecord(
+  claim: any,
+  action: string,
+  reviewerId: string
+): Record<string, any> {
+  return {
+    claimId: claim.id,
+    restaurantId: claim.restaurant_id ?? null,
+    restaurantChainId: claim.restaurant_chain_id ?? null,
+    action,
+    resultingStatus: claim.status,
+    reviewerId,
+    verifiedAt: new Date().toISOString(),
+  };
+}
+
+/**
+ * Standard error envelope for verification failures.
+ */
+export function createVerificationErrorEnvelope(
+  statusCode: number,
+  message: string,
+  details?: any
+): { success: false; statusCode: number; message: string; errorDetails?: any } {
+  return {
+    success: false,
+    statusCode,
+    message,
+    ...(details ? { errorDetails: details } : {}),
+  };
+}
+
+/**
+ * Only a Pending claim may move to Approved or Rejected; terminal states are
+ * frozen.
+ */
+export function isPermissibleStatusTransition(from: string, to: string): boolean {
+  const allowed: Record<string, string[]> = {
+    Pending: ["Approved", "Rejected"],
+  };
+  return (allowed[from] || []).includes(to);
+}
+
+/**
+ * Serialises claim rows into a compact verification report.
+ */
+export function serializeClaimVerificationReport(
+  claims: any[]
+): Array<Record<string, any>> {
+  return (claims || []).map((claim) => ({
+    id: claim.id,
+    restaurant_id: claim.restaurant_id ?? null,
+    restaurant_chain_id: claim.restaurant_chain_id ?? null,
+    status: claim.status ?? null,
+  }));
+}
+
+/**
+ * Bounds check for a batch: at least one item, at most MAX_BATCH_CLAIMS.
+ */
+export function validateBatchClaimVolume(
+  items: any[]
+): { valid: boolean; count: number; message?: string } {
+  const count = Array.isArray(items) ? items.length : 0;
+  if (count === 0) {
+    return {
+      valid: false,
+      count,
+      message: "Batch must contain at least one claim",
+    };
+  }
+  if (count > MAX_BATCH_CLAIMS) {
+    return {
+      valid: false,
+      count,
+      message: `Batch cannot exceed ${MAX_BATCH_CLAIMS} claims`,
+    };
+  }
+  return { valid: true, count };
+}
