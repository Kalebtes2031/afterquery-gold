@@ -0,0 +1,42 @@
+export enum RestaurantClaimVerificationAction {
+  Approve = "approve",
+  Reject = "reject",
+}
+
+export enum RestaurantClaimTerminalState {
+  Approved = "Approved",
+  Rejected = "Rejected",
+  Pending = "Pending",
+}
+
+export interface RestaurantClaimBatchItem {
+  claimId: string;
+  action: "approve" | "reject";
+  reason?: string;
+}
+
+export interface RestaurantClaimBatchVerificationRequest {
+  claims: RestaurantClaimBatchItem[];
+}
+
+export interface RestaurantClaimVerificationResult {
+  claimId: string;
+  action: "approve" | "reject";
+  status: string;
+  success: boolean;
+  data: any;
+  message?: string;
+}
+
+export interface RestaurantClaimBatchVerificationResult {
+  success: boolean;
+  data: any[];
+}
+
+export interface RestaurantClaimAuditRecord {
+  claimId: string;
+  adminUserId: string;
+  decision: "approve" | "reject";
+  decidedAt: string;
+  reason?: string;
+}
diff --git a/rateeat_backend/src/utils/restaurant-claim-verification.utils.ts b/rateeat_backend/src/utils/restaurant-claim-verification.utils.ts
new file mode 100644
index 0000000..7ae0b73
--- /dev/null
+++ b/rateeat_backend/src/utils/restaurant-claim-verification.utils.ts
@@ -0,0 +1,113 @@
+import { BadRequestError } from "./error-response.utils";
+import {
+  RestaurantClaimBatchItem,
+  RestaurantClaimVerificationAction,
+} from "../types/restaurant-claim-verification.types";
+
+export const validateClaimAction = (action: any): "approve" | "reject" => {
+  if (!action || typeof action !== "string") {
+    throw new BadRequestError("Claim verification action must be a string");
+  }
+  const normalized = action.toLowerCase().trim();
+  if (
+    normalized !== RestaurantClaimVerificationAction.Approve &&
+    normalized !== RestaurantClaimVerificationAction.Reject
+  ) {
+    throw new BadRequestError(
+      "Invalid verification action: must be 'approve' or 'reject'"
+    );
+  }
+  return normalized as "approve" | "reject";
+};
+
+export const sanitizeClaimReason = (reason?: any): string | undefined => {
+  if (reason === undefined || reason === null) {
+    return undefined;
+  }
+  if (typeof reason !== "string") {
+    throw new BadRequestError("Reason must be a string when provided");
+  }
+  const trimmed = reason.trim();
+  return trimmed.length > 0 ? trimmed : undefined;
+};
+
+export const validateBatchClaimPayload = (
+  payload: any
+): RestaurantClaimBatchItem[] => {
+  if (!payload || typeof payload !== "object") {
+    throw new BadRequestError("Request body must be an object");
+  }
+
+  const { claims } = payload;
+  if (!Array.isArray(claims)) {
+    throw new BadRequestError("Field 'claims' must be a non-empty array");
+  }
+
+  if (claims.length === 0) {
+    throw new BadRequestError("Field 'claims' cannot be empty");
+  }
+
+  const seenIds = new Set<string>();
+  const validatedItems: RestaurantClaimBatchItem[] = [];
+
+  for (let i = 0; i < claims.length; i++) {
+    const item = claims[i];
+    if (!item || typeof item !== "object") {
+      throw new BadRequestError(`Batch claim item at index ${i} must be an object`);
+    }
+
+    const { claimId, action, reason } = item;
+    if (!claimId || typeof claimId !== "string") {
+      throw new BadRequestError(
+        `Batch claim item at index ${i} must contain a valid claimId string`
+      );
+    }
+
+    const trimmedId = claimId.trim();
+    if (!trimmedId) {
+      throw new BadRequestError(
+        `Batch claim item at index ${i} must contain a non-empty claimId`
+      );
+    }
+
+    if (seenIds.has(trimmedId)) {
+      throw new BadRequestError("Duplicate claim request id");
+    }
+    seenIds.add(trimmedId);
+
+    const validAction = validateClaimAction(action);
+    const sanitizedReason = sanitizeClaimReason(reason);
+
+    validatedItems.push({
+      claimId: trimmedId,
+      action: validAction,
+      reason: sanitizedReason,
+    });
+  }
+
+  return validatedItems;
+};
+
+export const formatClaimResponse = (claim: any, message?: string): any => {
+  return {
+    id: claim.id,
+    restaurant_name: claim.restaurant_name,
+    status: claim.status,
+    requester_name: claim.requester_name,
+    email: claim.email,
+    phone_number: claim.phone_number,
+    restaurant_chain_id: claim.restaurant_chain_id || null,
+    message: message || "Claim processed successfully",
+  };
+};
+
+export const buildClaimNotificationMessage = (
+  restaurantName: string,
+  action: "approve" | "reject",
+  reason?: string
+): string => {
+  if (action === "approve") {
+    return `Claim request for restaurant ${restaurantName} has been approved.`;
+  }
+  return `Claim request for restaurant ${restaurantName} has been rejected.${reason ? ` Reason: ${reason}` : ""}`;
+};
