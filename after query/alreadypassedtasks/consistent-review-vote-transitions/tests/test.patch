+} from "../../models";
+
+export type Kind = "item" | "restaurant";
+export type Direction = "up" | "down";
+
+export interface Fixture {
+  db: Sequelize;
+  owner: User;
+  voter: User;
+  itemReview: ItemReview;
+  restaurantReview: RestaurantReview;
+}
+
+const suffix = () => randomUUID().replace(/-/g, "").slice(0, 18);
+
+export const createFixture = async (): Promise<Fixture> => {
+  const db = (await Database.getInstance()) as unknown as Sequelize;
+  const [role] = await Role.findOrCreate({
+    where: { name: "review-vote-consistency-user" },
+    defaults: { name: "review-vote-consistency-user" },
+  });
+  const makeUser = (name: string) =>
+    User.create({
+      role_id: role.id,
+      username: `${name}_${suffix()}`,
+      email: `${name}_${suffix()}@example.test`,
+      phone_number: `+2519${suffix().slice(0, 8)}`,
+      first_name: name,
+      last_name: "VoteTest",
+      fcm_token: `fcm-${suffix()}`,
+      verified: 4,
+    } as any);
+  const owner = await makeUser("owner");
+  const voter = await makeUser("voter");
+  const restaurant = await Restaurant.create({
+    name: `Vote Restaurant ${suffix()}`,
+    currency: "ETB",
+  } as any);
+  const menu = await Menu.create({
+    restaurant_id: restaurant.id,
+    menu_updated_at: new Date(),
+  } as any);
+  const category = await Category.create({
+    name: `Vote Category ${suffix()}`,
+    menu_id: menu.id,
+    url: "",
+  } as any);
+  const item = await Item.create({
+    name: `Vote Item ${suffix()}`,
+    price: 10,
+    category_id: category.id,
+    fasting: false,
+  } as any);
+  const itemReview = await ItemReview.create({
+    item_id: item.id,
+    user_id: owner.id,
+    rating: 5,
+    comment: "item vote consistency",
+    visibility: true,
+    up_vote: 0,
+    down_vote: 0,
+  } as any);
+  const restaurantReview = await RestaurantReview.create({
+    restaurant_id: restaurant.id,
+    user_id: owner.id,
+    rating: 5,
+    comment: "restaurant vote consistency",
+    visibility: true,
+    up_vote: 0,
+    down_vote: 0,
+  } as any);
+  return { db, owner, voter, itemReview, restaurantReview };
+};
+
+export const reviewId = (f: Fixture, kind: Kind) =>
+  kind === "item" ? f.itemReview.id : f.restaurantReview.id;
+
+export const postVote = (
+  kind: Kind,
+  direction: Direction,
+  id: string,
+  userId: string
+) =>
+  request(app)
+    .post(
+      `/api/v1/votes/${direction === "up" ? "upvote" : "downvote"}-${kind}-review`
+    )
+    .send({ reviewId: id, userId });
+
+export const setTotals = async (kind: Kind, id: string, up: number, down: number) => {
+  if (kind === "item") {
+    await ItemReview.update(
+      { up_vote: up, down_vote: down },
+      { where: { id } }
+    );
+  } else {
+    await RestaurantReview.update(
+      { up_vote: up, down_vote: down },
+      { where: { id } }
+    );
+  }
+};
+
+export const seedVote = async (
+  kind: Kind,
+  id: string,
+  userId: string,
+  direction: Direction
+) => {
+  const model = kind === "item" ? ItemVote : RestaurantVote;
+  const key = kind === "item" ? "item_review_id" : "restaurant_review_id";
+  return (model as any).create({
+    [key]: id,
+    voter_id: userId,
+    flag: direction === "up",
+    value: direction === "up" ? 1 : -1,
+  });
+};
+
+export const state = async (kind: Kind, id: string) => {
+  const voteModel =
+    kind === "item" ? ItemVote : RestaurantVote;
+
+  const key =
+    kind === "item" ? "item_review_id" : "restaurant_review_id";
+
+  const review =
+    kind === "item"
+      ? await ItemReview.findByPk(id)
+      : await RestaurantReview.findByPk(id);
+  const votes = await (voteModel as any).findAll({ where: { [key]: id } });
+  if (!review) throw new Error("review missing");
+  return {
+    up: review.up_vote,
+    down: review.down_vote,
+    votes: votes.map((v: any) => ({ flag: v.flag, value: v.value })),
+  };
+};
+
+export const seedMention = async (
+  kind: Kind,
+  id: string,
+  ownerId: string,
+  voterId: string,
+  direction: Direction
+) =>
