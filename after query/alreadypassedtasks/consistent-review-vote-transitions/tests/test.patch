+    notifiable_type: kind === "item" ? "ItemReview" : "RestaurantReview",
+    notifiable_id: id,
+    user_id: ownerId,
+    reactor_id: voterId,
+    message: `Your ${kind} review received a ${direction}vote from user.`,
+    notification_category: "Mentions",
+  } as any);
+
+export const mention = (kind: Kind, id: string, ownerId: string, voterId: string) =>
+  Notification.findOne({
+    where: {
+      notifiable_type: kind === "item" ? "ItemReview" : "RestaurantReview",
+      notifiable_id: id,
+      user_id: ownerId,
+      reactor_id: voterId,
+      notification_category: "Mentions",
+    },
+  });
+
+const qi = (s: string) => `"${s.replace(/"/g, '""')}"`;
+
+export const rejectWrite = async (
+  db: Sequelize,
+  table: string,
+  operation: "INSERT" | "UPDATE" | "DELETE"
+): Promise<() => Promise<void>> => {
+  const tag = suffix();
+  const fn = `vote_fail_fn_${tag}`;
+  const trg = `vote_fail_trg_${tag}`;
+  await db.query(
+    `CREATE FUNCTION ${qi(fn)}() RETURNS trigger AS $$ BEGIN RAISE EXCEPTION 'forced vote test failure'; END; $$ LANGUAGE plpgsql`
+  );
+  await db.query(
+    `CREATE TRIGGER ${qi(trg)} BEFORE ${operation} ON ${qi(table)} FOR EACH ROW EXECUTE FUNCTION ${qi(fn)}()`
+  );
+  return async () => {
+    await db.query(`DROP TRIGGER IF EXISTS ${qi(trg)} ON ${qi(table)}`);
+    await db.query(`DROP FUNCTION IF EXISTS ${qi(fn)}()`);
+  };
+};
+
+const installVoteInsertDelay = async (
+  db: Sequelize,
+  table: "item_votes" | "restaurant_votes"
+): Promise<() => Promise<void>> => {
+  const tag = suffix();
+  const fn = `vote_delay_fn_${tag}`;
+  const trg = `vote_delay_trg_${tag}`;
+
+  await db.query(
+    `CREATE FUNCTION ${qi(fn)}() RETURNS trigger AS $$
+     BEGIN
+       PERFORM pg_sleep(0.75);
+       RETURN NEW;
+     END;
+     $$ LANGUAGE plpgsql`
+  );
+
+  await db.query(
+    `CREATE TRIGGER ${qi(trg)}
+     BEFORE INSERT ON ${qi(table)}
+     FOR EACH ROW EXECUTE FUNCTION ${qi(fn)}()`
+  );
+
+  return async () => {
+    await db.query(
+      `DROP TRIGGER IF EXISTS ${qi(trg)} ON ${qi(table)}`
+    );
+    await db.query(
+      `DROP FUNCTION IF EXISTS ${qi(fn)}()`
+    );
+  };
+};
+
+export const concurrentVotes = async (
+  f: Fixture,
+  kind: Kind,
+  directions: Direction[]
+) => {
+  const id = reviewId(f, kind);
+  const table =
+    kind === "item" ? "item_votes" : "restaurant_votes";
+
+  const cleanup = await installVoteInsertDelay(f.db, table);
+
+  try {
+    return await Promise.all(
+      directions.map((direction) =>
+        postVote(kind, direction, id, f.voter.id)
+      )
+    );
+  } finally {
+    await cleanup();
+  }
+};
+
+export const concurrentVotesForUsers = async (
+  f: Fixture,
+  kind: Kind,
+  requests: Array<{
+    direction: Direction;
+    userId: string;
+  }>
+) => {
+  const id = reviewId(f, kind);
+  const table =
+    kind === "item" ? "item_votes" : "restaurant_votes";
+
+  const cleanup = await installVoteInsertDelay(f.db, table);
+
+  try {
+    return await Promise.all(
+      requests.map(({ direction, userId }) =>
+        postVote(kind, direction, id, userId)
+      )
+    );
+  } finally {
+    await cleanup();
+  }
+};
+
+export const voteRowsForUser = async (
+  kind: Kind,
+  id: string,
+  userId: string
+) => {
+  const model = kind === "item" ? ItemVote : RestaurantVote;
+  const key = kind === "item" ? "item_review_id" : "restaurant_review_id";
+  const rows = await (model as any).findAll({
+    where: { [key]: id, voter_id: userId },
+    order: [["createdAt", "ASC"]],
+  });
+  return rows.map((row: any) => ({
+    flag: row.flag,
+    value: row.value,
+  }));
+};
+
+export const expectVoteResponseContract = async (
+  kind: Kind,
+  id: string,
+  response: any,
+  message: "Vote created" | "Vote deleted" | "Vote updated",
+  voted: -1 | 0 | 1
+) => {
+  const review =
+    kind === "item"
+      ? await ItemReview.findByPk(id)
+      : await RestaurantReview.findByPk(id);
+
+  expect(review).not.toBeNull();
+
+  const expectedData = JSON.parse(
+    JSON.stringify({
+      ...(review as any).dataValues,
+      voted,
+    })
+  );
+
+  expect(response.status).toBe(201);
+
+  expect(response.body).toEqual({
+    message,
+    data: expectedData,
+  });
+};
+
+export const expectDurableVoteConsistency = async (
+  kind: Kind,
+  id: string,
+  userId: string,
+  expected: Direction | null
+) => {
+  const current = await state(kind, id);
+  const allVotes = current.votes;
+  const upRows = allVotes.filter((vote) => vote.flag === true);
+  const downRows = allVotes.filter((vote) => vote.flag === false);
+
+  expect(current.up).toBe(upRows.length);
+  expect(current.down).toBe(downRows.length);
+
+  const userVotes = await voteRowsForUser(kind, id, userId);
+  if (expected === null) {
+    expect(userVotes).toEqual([]);
+    return current;
+  }
+
+  expect(userVotes).toEqual([
+    {
+      flag: expected === "up",
+      value: expected === "up" ? 1 : -1,
+    },
+  ]);
+  return current;
+};
