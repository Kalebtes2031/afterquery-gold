+import { randomUUID } from "crypto";
+import { Interaction } from "../../models";
+import {
+  concurrentVotes,
+  concurrentVotesForUsers,
+  createFixture,
+  expectDurableVoteConsistency,
+  interactionCount,
+  mention,
+  mentionCount,
+  postVote,
+  rejectWrite,
+  reviewId,
+  seedMention,
+  seedVote,
+  setTotals,
+  state,
+  expectVoteResponseContract,
+} from "./review_vote_test_support";
+
+describe("consistent review vote transitions item reviews", () => {
+  it("repairs stale totals when a new upvote is created", async () => {
+    const f = await createFixture();
+    const id = reviewId(f, "item");
+    await setTotals("item", id, 7, 4);
+    await postVote("item", "up", id, f.voter.id);
+    expect(await state("item", id)).toMatchObject({ up: 1, down: 0 });
+    await expectDurableVoteConsistency("item", id, f.voter.id, "up");
+    expect(await mentionCount("item", id, f.owner.id, f.voter.id)).toBe(1);
+  });
+
+  it("repairs stale totals when an upvote is toggled off", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await seedVote("item", id, f.voter.id, "up"); await setTotals("item", id, 9, 3);
+    await postVote("item", "up", id, f.voter.id);
+    expect(await state("item", id)).toEqual({ up: 0, down: 0, votes: [] });
+    await expectDurableVoteConsistency("item", id, f.voter.id, null);
+  });
+
+  it("repairs both totals when a downvote becomes an upvote", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await seedVote("item", id, f.voter.id, "down"); await setTotals("item", id, 5, 8);
+    await postVote("item", "up", id, f.voter.id);
+    expect(await state("item", id)).toMatchObject({ up: 1, down: 0 });
+    await expectDurableVoteConsistency("item", id, f.voter.id, "up");
+    expect(await mentionCount("item", id, f.owner.id, f.voter.id)).toBe(1);
+  });
+
+  it("updates the stored vote value when down becomes up", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await seedVote("item", id, f.voter.id, "down"); await setTotals("item", id, 0, 1);
+    await postVote("item", "up", id, f.voter.id);
+    expect((await state("item", id)).votes).toEqual([{ flag: true, value: 1 }]);
+    await expectDurableVoteConsistency("item", id, f.voter.id, "up");
+  });
+
+  it("refreshes an existing mention when the vote direction changes", async () => {
+    const f = await createFixture();
+    const id = reviewId(f, "item");
+
+    await seedVote("item", id, f.voter.id, "down");
+    await setTotals("item", id, 0, 1);
+    await seedMention(
+      "item",
+      id,
+      f.owner.id,
+      f.voter.id,
+      "down"
+    );
+
+    const before = await mention(
+      "item",
+      id,
+      f.owner.id,
+      f.voter.id
+    );
+
+    expect(before).not.toBeNull();
+
+    await before!.update({
+      read_status: true,
+    });
+
+    await postVote(
+      "item",
+      "up",
+      id,
+      f.voter.id
+    );
+
+    const refreshed = await mention(
+      "item",
+      id,
+      f.owner.id,
+      f.voter.id
+    );
+
+    expect(refreshed?.message).toContain("upvote");
+    expect(refreshed?.read_status).toBe(false);
+
+    expect(
+      await mentionCount(
+        "item",
+        id,
+        f.owner.id,
+        f.voter.id
+      )
+    ).toBe(1);
+
+    await expectDurableVoteConsistency(
+      "item",
+      id,
+      f.voter.id,
+      "up"
+    );
+  });
+
+  it("rolls back counters when vote creation fails", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const cleanup = await rejectWrite(f.db, "item_votes", "INSERT");
+    try { expect((await postVote("item", "up", id, f.voter.id)).status).toBeGreaterThanOrEqual(400); }
+    finally { await cleanup(); }
+    expect(await state("item", id)).toEqual({ up: 0, down: 0, votes: [] });
+  });
+
+  it("rolls back a direction change when vote update fails", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await seedVote("item", id, f.voter.id, "down"); await setTotals("item", id, 0, 1);
+    const cleanup = await rejectWrite(f.db, "item_votes", "UPDATE");
+    try {
+      const response = await postVote("item", "up", id, f.voter.id);
+      expect(response.status).toBeGreaterThanOrEqual(400);
+    } finally { await cleanup(); }
+    expect(await state("item", id)).toEqual({ up: 0, down: 1, votes: [{ flag: false, value: -1 }] });
+    await expectDurableVoteConsistency("item", id, f.voter.id, "down");
+  });
+
+  it("rolls back a toggle when vote deletion fails", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await seedVote("item", id, f.voter.id, "up"); await setTotals("item", id, 1, 0);
+    const cleanup = await rejectWrite(f.db, "item_votes", "DELETE");
+    try {
+      const response = await postVote("item", "up", id, f.voter.id);
+      expect(response.status).toBeGreaterThanOrEqual(400);
+    } finally { await cleanup(); }
+    expect(await state("item", id)).toEqual({ up: 1, down: 0, votes: [{ flag: true, value: 1 }] });
+    await expectDurableVoteConsistency("item", id, f.voter.id, "up");
+  });
+
+  it("rolls back vote and totals when notification creation fails", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const cleanup = await rejectWrite(f.db, "notifications", "INSERT");
+    try {
+      const response = await postVote("item", "down", id, f.voter.id);
+      expect(response.status).toBeGreaterThanOrEqual(400);
+    } finally { await cleanup(); }
+    expect(await state("item", id)).toEqual({ up: 0, down: 0, votes: [] });
+  });
+
+  it("rolls back the upvote when interaction persistence fails last", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const cleanup = await rejectWrite(f.db, "interactions", "INSERT");
+    try {
+      const response = await postVote("item", "up", id, f.voter.id);
+      expect(response.status).toBeGreaterThanOrEqual(400);
+    } finally { await cleanup(); }
+    expect(await state("item", id)).toEqual({ up: 0, down: 0, votes: [] });
+    expect(await Interaction.count({ where: { userId: f.voter.id } })).toBe(0);
+    expect(await interactionCount(f.voter.id)).toBe(0);
+    await expectDurableVoteConsistency("item", id, f.voter.id, null);
+  });
+
+  it("leaves an item-review vote unchanged when counter persistence fails", async () => {
+    const f = await createFixture();
+    const id = reviewId(f, "item");
+
+    const cleanup = await rejectWrite(
+      f.db,
+      "item_reviews",
+      "UPDATE"
+    );
+
+    try {
+      const response = await postVote(
+        "item",
+        "up",
+        id,
+        f.voter.id
+      );
+
+      expect(
+        response.status
+      ).toBeGreaterThanOrEqual(400);
+    } finally {
+      await cleanup();
+    }
+
+    expect(
+      await state("item", id)
+    ).toEqual({
+      up: 0,
+      down: 0,
+      votes: [],
+    });
+
+    expect(
+      await mentionCount(
+        "item",
+        id,
+        f.owner.id,
+        f.voter.id
+      )
+    ).toBe(0);
+
+    await expectDurableVoteConsistency(
+      "item",
+      id,
+      f.voter.id,
+      null
+    );
+  });
+
+  it("rolls back an item-review switch when mention refresh fails", async () => {
+    const f = await createFixture();
+    const id = reviewId(f, "item");
+
+    await seedVote(
+      "item",
+      id,
+      f.voter.id,
+      "down"
+    );
+
+    await setTotals(
+      "item",
+      id,
+      0,
+      1
+    );
+
+    await seedMention(
+      "item",
+      id,
+      f.owner.id,
+      f.voter.id,
+      "down"
+    );
+
+    const existing = await mention(
+      "item",
+      id,
+      f.owner.id,
+      f.voter.id
+    );
+
+    expect(existing).not.toBeNull();
+
+    await existing!.update({
+      read_status: true,
+    });
+
+    const cleanup = await rejectWrite(
+      f.db,
+      "notifications",
+      "UPDATE"
+    );
+
+    try {
+      const response = await postVote(
+        "item",
+        "up",
+        id,
+        f.voter.id
+      );
+
+      expect(
+        response.status
+      ).toBeGreaterThanOrEqual(400);
+    } finally {
+      await cleanup();
+    }
+
+    expect(
+      await state("item", id)
+    ).toEqual({
+      up: 0,
+      down: 1,
+      votes: [
+        {
+          flag: false,
+          value: -1,
+        },
+      ],
+    });
+
+    const after = await mention(
+      "item",
+      id,
+      f.owner.id,
+      f.voter.id
+    );
+
+    expect(after?.message).toContain("downvote");
+    expect(after?.read_status).toBe(true);
+
+    expect(
+      await mentionCount(
+        "item",
+        id,
+        f.owner.id,
+        f.voter.id
+      )
+    ).toBe(1);
+
+    await expectDurableVoteConsistency(
+      "item",
+      id,
+      f.voter.id,
+      "down"
+    );
+  });
+
+  it("serializes two simultaneous identical upvotes", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const responses = await concurrentVotes(f, "item", ["up", "up"]);
+    expect(responses.map((r) => r.body.message).sort()).toEqual(["Vote created", "Vote deleted"].sort());
+    expect(await state("item", id)).toEqual({ up: 0, down: 0, votes: [] });
+    expect(responses.every((r) => r.status === 201)).toBe(true);
+    await expectDurableVoteConsistency("item", id, f.voter.id, null);
+  });
+
+  it("serializes simultaneous opposite votes into one current vote", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await concurrentVotes(f, "item", ["up", "down"]);
+    const result = await state("item", id);
+    expect(result.votes).toHaveLength(1);
+    expect(result.up + result.down).toBe(1);
+    expect(result.votes[0].flag ? result.up : result.down).toBe(1);
+    await expectDurableVoteConsistency(
+      "item",
+      id,
+      f.voter.id,
+      result.votes[0].flag ? "up" : "down"
+    );
+  });
+
+  it("preserves simultaneous item-review votes from different users", async () => {
+    const f = await createFixture();
+    const id = reviewId(f, "item");
+
+    const responses = await concurrentVotesForUsers(
+      f,
+      "item",
+      [
+        {
+          direction: "up",
+          userId: f.voter.id,
+        },
+        {
+          direction: "up",
+          userId: f.owner.id,
+        },
+      ]
+    );
+
+    expect(
+      responses.every((response) => response.status === 201)
+    ).toBe(true);
+
+    expect(
+      responses.map((response) => response.body.message)
+    ).toEqual([
+      "Vote created",
+      "Vote created",
+    ]);
+
+    const result = await state("item", id);
+
+    expect(result.votes).toHaveLength(2);
+    expect(result.up).toBe(2);
+    expect(result.down).toBe(0);
+  });
+
+  it("preserves the complete item-review success response payload", async () => {
+    const f = await createFixture();
+    const id = reviewId(f, "item");
+
+    const createdUp = await postVote(
+      "item",
+      "up",
+      id,
+      f.voter.id
+    );
+
+    await expectVoteResponseContract(
+      "item",
+      id,
+      createdUp,
+      "Vote created",
+      1
+    );
+
+    const deletedUp = await postVote(
+      "item",
+      "up",
+      id,
+      f.voter.id
+    );
+
+    await expectVoteResponseContract(
+      "item",
+      id,
+      deletedUp,
+      "Vote deleted",
+      0
+    );
+
+    const createdDown = await postVote(
+      "item",
+      "down",
+      id,
+      f.voter.id
+    );
+
+    await expectVoteResponseContract(
+      "item",
+      id,
+      createdDown,
+      "Vote created",
+      -1
+    );
+
+    const switchedUp = await postVote(
+      "item",
+      "up",
+      id,
+      f.voter.id
+    );
+
+    await expectVoteResponseContract(
+      "item",
+      id,
+      switchedUp,
+      "Vote updated",
+      1
+    );
+  });
+
+  it("preserves item-review missing review and user errors", async () => {
+    const f = await createFixture();
+    const id = reviewId(f, "item");
+
+    const missingReview = await postVote(
+      "item",
+      "up",
+      "ffffffff-ffff-4fff-8fff-ffffffffffff",
+      f.voter.id
+    );
+
+    expect(missingReview.status).toBe(400);
+    expect(missingReview.body.message).toBe(
+      "Bad request"
+    );
+
+    const missingUser = await postVote(
+      "item",
+      "up",
+      id,
+      "ffffffff-ffff-4fff-8fff-ffffffffffff"
+    );
+
+    expect(missingUser.status).toBe(400);
+    expect(missingUser.body.message).toBe(
+      "Bad request"
+    );
+  });
+
+  it("keeps the first item upvote response contract", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const response = await postVote("item", "up", id, f.voter.id);
+    expect(response.status).toBe(201);
+    expect(response.body.message).toBe("Vote created");
+    expect(response.body.data.voted).toBe(1);
+  });
+
+  it("keeps the first item downvote response contract", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const response = await postVote("item", "down", id, f.voter.id);
+    expect(response.status).toBe(201);
+    expect(response.body.message).toBe("Vote created");
+    expect(response.body.data.voted).toBe(-1);
+  });
+
+  it("keeps the existing item upvote toggle behavior", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await postVote("item", "up", id, f.voter.id);
+    const response = await postVote("item", "up", id, f.voter.id);
+    expect(response.status).toBe(201);
+    expect(response.body).toMatchObject({ message: "Vote deleted", data: { voted: 0 } });
+  });
+
+  it("keeps the existing item downvote toggle behavior", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await postVote("item", "down", id, f.voter.id);
+    const response = await postVote("item", "down", id, f.voter.id);
+    expect(response.status).toBe(201);
+    expect(response.body).toMatchObject({ message: "Vote deleted", data: { voted: 0 } });
+  });
+
+  it("keeps the item-review missing-review error", async () => {
+    const f = await createFixture();
+    const response = await postVote("item", "up", randomUUID(), f.voter.id);
+    expect(response.status).toBe(400);
+    expect(await state("item", f.itemReview.id)).toEqual({ up: 0, down: 0, votes: [] });
+  });
+
+  it("keeps the item-review missing-user error", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const response = await postVote("item", "up", id, randomUUID());
+    expect(response.status).toBe(400);
+    expect(await state("item", id)).toEqual({ up: 0, down: 0, votes: [] });
+  });
+
+  it("still skips item-review mentions for a self vote", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const response = await postVote("item", "down", id, f.owner.id);
+    expect(response.status).toBe(201);
+    expect(await mention("item", id, f.owner.id, f.owner.id)).toBeNull();
+  });
+
+
+  it("keeps the item-review up-to-down switch response", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await postVote("item", "up", id, f.voter.id);
+    const response = await postVote("item", "down", id, f.voter.id);
+    expect(response.status).toBe(201);
+    expect(response.body).toMatchObject({ message: "Vote updated", data: { voted: -1 } });
+  });
+
+  it("keeps the item-review down-to-up switch response", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    await postVote("item", "down", id, f.voter.id);
+    const response = await postVote("item", "up", id, f.voter.id);
+    expect(response.status).toBe(201);
+    expect(response.body).toMatchObject({ message: "Vote updated", data: { voted: 1 } });
+  });
+
+  it("still creates one mention for a first item-review downvote", async () => {
+    const f = await createFixture(); const id = reviewId(f, "item");
+    const response = await postVote("item", "down", id, f.voter.id);
+    expect(response.status).toBe(201);
+    expect(await mention("item", id, f.owner.id, f.voter.id)).not.toBeNull();
+  });
+
+});
