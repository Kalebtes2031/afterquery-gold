diff --git a/rateeat_backend/src/services/sponsored-listing-lifecycle-policy.service.ts b/rateeat_backend/src/services/sponsored-listing-lifecycle-policy.service.ts
new file mode 100644
index 000000000..fb54cc217
--- /dev/null
+++ b/rateeat_backend/src/services/sponsored-listing-lifecycle-policy.service.ts
@@ -0,0 +1,213 @@
+import {
+  SponsoredListingBudgetSnapshot,
+  SponsoredListingEligibilityEvaluation,
+  SponsoredListingExpirationEvaluation,
+  SponsoredListingImpressionEvaluation,
+  SponsoredListingLifecycleBoundary,
+  SponsoredListingLifecycleSnapshot,
+  SponsoredListingLifecycleState,
+} from "../types/sponsored-listing-lifecycle.types";
+
+const toTimestamp = (value: Date | string): number =>
+  value instanceof Date ? value.getTime() : new Date(value).getTime();
+
+export const buildLifecycleBoundary = (
+  listing: Pick<SponsoredListingLifecycleState, "start_date" | "end_date">,
+  now: Date
+): SponsoredListingLifecycleBoundary => ({
+  now,
+  startTimestamp: toTimestamp(listing.start_date),
+  endTimestamp: toTimestamp(listing.end_date),
+});
+
+export const buildBudgetSnapshot = (
+  listing: Pick<
+    SponsoredListingLifecycleState,
+    "impressions" | "max_impressions"
+  >
+): SponsoredListingBudgetSnapshot => {
+  const impressions = Number(listing.impressions);
+  const maxImpressions = Number(listing.max_impressions);
+  const remainingImpressions = Math.max(0, maxImpressions - impressions);
+
+  return {
+    impressions,
+    maxImpressions,
+    remainingImpressions,
+    exhausted: impressions >= maxImpressions,
+  };
+};
+
+export const hasLifecycleStarted = (
+  boundary: SponsoredListingLifecycleBoundary
+): boolean => boundary.startTimestamp <= boundary.now.getTime();
+
+export const hasLifecycleEnded = (
+  boundary: SponsoredListingLifecycleBoundary
+): boolean => boundary.endTimestamp <= boundary.now.getTime();
+
+export const buildLifecycleSnapshot = (
+  listing: SponsoredListingLifecycleState,
+  now: Date
+): SponsoredListingLifecycleSnapshot => {
+  const schedule = buildLifecycleBoundary(listing, now);
+  const budget = buildBudgetSnapshot(listing);
+  const hasStarted = hasLifecycleStarted(schedule);
+  const hasEnded = hasLifecycleEnded(schedule);
+
+  return {
+    status: listing.status,
+    schedule,
+    budget,
+    hasStarted,
+    hasEnded,
+    hasBudget: !budget.exhausted,
+  };
+};
+
+export const evaluateSponsoredListingEligibility = (
+  listing: SponsoredListingLifecycleState,
+  now: Date
+): SponsoredListingEligibilityEvaluation => {
+  const snapshot = buildLifecycleSnapshot(listing, now);
+
+  if (snapshot.status !== "Active") {
+    return {
+      eligible: false,
+      reason: "inactive",
+      hasStarted: snapshot.hasStarted,
+      hasEnded: snapshot.hasEnded,
+      hasBudget: snapshot.hasBudget,
+    };
+  }
+
+  if (!snapshot.hasStarted) {
+    return {
+      eligible: false,
+      reason: "not-started",
+      hasStarted: false,
+      hasEnded: snapshot.hasEnded,
+      hasBudget: snapshot.hasBudget,
+    };
+  }
+
+  if (snapshot.hasEnded) {
+    return {
+      eligible: false,
+      reason: "ended",
+      hasStarted: true,
+      hasEnded: true,
+      hasBudget: snapshot.hasBudget,
+    };
+  }
+
+  if (!snapshot.hasBudget) {
+    return {
+      eligible: false,
+      reason: "exhausted",
+      hasStarted: true,
+      hasEnded: false,
+      hasBudget: false,
+    };
+  }
+
+  return {
+    eligible: true,
+    reason: "eligible",
+    hasStarted: true,
+    hasEnded: false,
+    hasBudget: true,
+  };
+};
+
+export const evaluateSponsoredListingExpiration = (
+  listing: SponsoredListingLifecycleState,
+  now: Date
+): SponsoredListingExpirationEvaluation => {
+  const snapshot = buildLifecycleSnapshot(listing, now);
+
+  if (snapshot.status === "Expired") {
+    return {
+      shouldExpire: true,
+      reason: "already-expired",
+      hasEnded: snapshot.hasEnded,
+      hasBudget: snapshot.hasBudget,
+    };
+  }
+
+  if (snapshot.hasEnded) {
+    return {
+      shouldExpire: true,
+      reason: "ended",
+      hasEnded: true,
+      hasBudget: snapshot.hasBudget,
+    };
+  }
+
+  if (!snapshot.hasBudget) {
+    return {
+      shouldExpire: true,
+      reason: "exhausted",
+      hasEnded: snapshot.hasEnded,
+      hasBudget: false,
+    };
+  }
+
+  return {
+    shouldExpire: false,
+    reason: "active",
+    hasEnded: false,
+    hasBudget: true,
+  };
+};
+
+export const evaluateSponsoredListingImpression = (
+  listing: SponsoredListingLifecycleState,
+  now: Date
+): SponsoredListingImpressionEvaluation => {
+  const snapshot = buildLifecycleSnapshot(listing, now);
+
+  if (snapshot.status === "Expired") {
+    return {
+      decision: "expired",
+      expirationReason: "already-expired",
+    };
+  }
+
+  if (!snapshot.hasStarted) {
+    return {
+      decision: "not-started",
+      expirationReason: null,
+    };
+  }
+
+  const expiration = evaluateSponsoredListingExpiration(listing, now);
+
+  if (expiration.shouldExpire) {
+    return {
+      decision: "expired",
+      expirationReason: expiration.reason,
+    };
+  }
+
+  return {
+    decision: "count",
+    expirationReason: null,
+  };
+};
+
+export const isEligibleSponsoredListing = (
+  listing: SponsoredListingLifecycleState,
+  now: Date
+): boolean => evaluateSponsoredListingEligibility(listing, now).eligible;
+
+export const shouldExpireSponsoredListing = (
+  listing: SponsoredListingLifecycleState,
+  now: Date
+): boolean => evaluateSponsoredListingExpiration(listing, now).shouldExpire;
+
+export const canCountSponsoredListingImpression = (
+  listing: SponsoredListingLifecycleState,
+  now: Date
+): boolean =>
+  evaluateSponsoredListingImpression(listing, now).decision === "count";
