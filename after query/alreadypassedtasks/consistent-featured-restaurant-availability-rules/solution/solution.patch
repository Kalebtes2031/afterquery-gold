@@ -0,0 +1,134 @@
+export type SponsoredListingDateValue = Date | string;
+
+export type SponsoredListingLifecycleStatus = "Active" | "Expired" | string;
+
+export interface SponsoredListingScheduleState {
+  start_date: SponsoredListingDateValue;
+  end_date: SponsoredListingDateValue;
+}
+
+export interface SponsoredListingImpressionState {
+  impressions: number;
+  max_impressions: number;
+}
+
+export interface SponsoredListingLifecycleState
+  extends SponsoredListingScheduleState,
+    SponsoredListingImpressionState {
+  status: SponsoredListingLifecycleStatus;
+}
+
+export type SponsoredListingEligibilityReason =
+  | "eligible"
+  | "inactive"
+  | "not-started"
+  | "ended"
+  | "exhausted";
+
+export interface SponsoredListingEligibilityEvaluation {
+  eligible: boolean;
+  reason: SponsoredListingEligibilityReason;
+  hasStarted: boolean;
+  hasEnded: boolean;
+  hasBudget: boolean;
+}
+
+export type SponsoredListingExpirationReason =
+  | "already-expired"
+  | "ended"
+  | "exhausted"
+  | "active";
+
+export interface SponsoredListingExpirationEvaluation {
+  shouldExpire: boolean;
+  reason: SponsoredListingExpirationReason;
+  hasEnded: boolean;
+  hasBudget: boolean;
+}
+
+export type SponsoredListingImpressionDecision =
+  | "not-started"
+  | "expired"
+  | "count";
+
+export interface SponsoredListingImpressionEvaluation {
+  decision: SponsoredListingImpressionDecision;
+  expirationReason: SponsoredListingExpirationReason | null;
+}
+
+export interface SponsoredListingLifecycleBoundary {
+  now: Date;
+  startTimestamp: number;
+  endTimestamp: number;
+}
+
+export interface SponsoredListingBudgetSnapshot {
+  impressions: number;
+  maxImpressions: number;
+  remainingImpressions: number;
+  exhausted: boolean;
+}
+
+export interface SponsoredListingLifecycleSnapshot {
+  status: SponsoredListingLifecycleStatus;
+  schedule: SponsoredListingLifecycleBoundary;
+  budget: SponsoredListingBudgetSnapshot;
+  hasStarted: boolean;
+  hasEnded: boolean;
+  hasBudget: boolean;
+}
+
+export interface SponsoredListingLifecycleQueryInput {
+  now: Date;
+}
+
+export interface SponsoredListingExpirationQueryInput {
+  now: Date;
+}
+
+export interface SponsoredListingImpressionContext<
+  TListing = SponsoredListingLifecycleState,
+> {
+  listing: TListing;
+  now: Date;
+}
+
+export type SponsoredListingImpressionResultKind =
+  | "not-started"
+  | "expired"
+  | "counted";
+
+export interface SponsoredListingNotStartedResult<TListing> {
+  kind: "not-started";
+  listing: TListing;
+}
+
+export interface SponsoredListingExpiredResult<TListing> {
+  kind: "expired";
+  listing: TListing;
+}
+
+export interface SponsoredListingCountedResult<TListing> {
+  kind: "counted";
+  listing: TListing;
+}
+
+export type SponsoredListingImpressionResult<TListing> =
+  | SponsoredListingNotStartedResult<TListing>
+  | SponsoredListingExpiredResult<TListing>
+  | SponsoredListingCountedResult<TListing>;
+
+export const isNotStartedResult = <TListing>(
+  result: SponsoredListingImpressionResult<TListing>
+): result is SponsoredListingNotStartedResult<TListing> =>
+  result.kind === "not-started";
+
+export const isExpiredResult = <TListing>(
+  result: SponsoredListingImpressionResult<TListing>
+): result is SponsoredListingExpiredResult<TListing> =>
+  result.kind === "expired";
+
+export const isCountedResult = <TListing>(
+  result: SponsoredListingImpressionResult<TListing>
+): result is SponsoredListingCountedResult<TListing> =>
+  result.kind === "counted";
diff --git a/rateeat_backend/src/utils/sponsored-listing-lifecycle.utils.ts b/rateeat_backend/src/utils/sponsored-listing-lifecycle.utils.ts
