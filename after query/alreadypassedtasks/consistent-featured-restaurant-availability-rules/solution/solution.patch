+++ b/rateeat_backend/src/utils/sponsored-listing-lifecycle.utils.ts
@@ -0,0 +1,99 @@
+import { Op, col, where as sequelizeWhere } from "sequelize";
+import { SponsoredListingStatus } from "../models/SponsoredListing/SponsoredListing";
+import {
+  SponsoredListingImpressionState,
+  SponsoredListingLifecycleState,
+  SponsoredListingScheduleState,
+} from "../types/sponsored-listing-lifecycle.types";
+import {
+  buildBudgetSnapshot,
+  buildLifecycleBoundary,
+  isEligibleSponsoredListing,
+  shouldExpireSponsoredListing,
+} from "../services/sponsored-listing-lifecycle-policy.service";
+
+export type ListingSchedule = SponsoredListingScheduleState;
+export type ListingBudget = SponsoredListingImpressionState;
+export type ListingLifecycleState = SponsoredListingLifecycleState;
+
+export const hasListingStarted = (
+  listing: Pick<ListingSchedule, "start_date">,
+  now: Date
+): boolean => {
+  const boundary = buildLifecycleBoundary(
+    {
+      start_date: listing.start_date,
+      end_date: listing.start_date,
+    },
+    now
+  );
+
+  return boundary.startTimestamp <= now.getTime();
+};
+
+export const hasListingEnded = (
+  listing: Pick<ListingSchedule, "end_date">,
+  now: Date
+): boolean => {
+  const boundary = buildLifecycleBoundary(
+    {
+      start_date: listing.end_date,
+      end_date: listing.end_date,
+    },
+    now
+  );
+
+  return boundary.endTimestamp <= now.getTime();
+};
+
+export const hasImpressionBudget = (
+  listing: Pick<ListingBudget, "impressions" | "max_impressions">
+): boolean => !buildBudgetSnapshot(listing).exhausted;
+
+export const isSponsoredListingEligible = (
+  listing: ListingLifecycleState,
+  now: Date
+): boolean => isEligibleSponsoredListing(listing, now);
+
+export const shouldSponsoredListingExpire = (
+  listing: Pick<
+    ListingLifecycleState,
+    "end_date" | "impressions" | "max_impressions"
+  >,
+  now: Date
+): boolean =>
+  shouldExpireSponsoredListing(
+    {
+      status: SponsoredListingStatus.Active,
+      start_date: now,
+      end_date: listing.end_date,
+      impressions: listing.impressions,
+      max_impressions: listing.max_impressions,
+    },
+    now
+  );
+
+export const buildEligibleListingWhere = (now: Date) => ({
+  status: SponsoredListingStatus.Active,
+  start_date: {
+    [Op.lte]: now,
+  },
+  end_date: {
+    [Op.gt]: now,
+  },
+  impressions: {
+    [Op.lt]: col("max_impressions"),
+  },
+});
+
+export const buildExpirationWhere = (now: Date) => ({
+  status: SponsoredListingStatus.Active,
+  [Op.or]: [
+    {
+      end_date: {
+        [Op.lte]: now,
+      },
+    },
+    sequelizeWhere(col("impressions"), Op.gte, col("max_impressions")),
+  ],
+});
