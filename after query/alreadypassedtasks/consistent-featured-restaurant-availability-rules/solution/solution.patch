@@ -0,0 +1,138 @@
+import SponsoredListing, {
+  SponsoredListingStatus,
+} from "../models/SponsoredListing/SponsoredListing";
+import { SponsoredListingImpressionResult } from "../types/sponsored-listing-lifecycle.types";
+import {
+  evaluateSponsoredListingImpression,
+  shouldExpireSponsoredListing,
+} from "./sponsored-listing-lifecycle-policy.service";
+import {
+  buildEligibleListingWhere,
+  buildExpirationWhere,
+} from "../utils/sponsored-listing-lifecycle.utils";
+
+export const SPONSORED_LISTING_NOT_FOUND_MESSAGE =
+  "Sponsored listing not found";
+
+export const SPONSORED_LISTING_NOT_STARTED_MESSAGE =
+  "Sponsored listing has not started yet";
+
+export const SPONSORED_LISTING_EXPIRED_MESSAGE = "Listing expired";
+
+export const findEligibleSponsoredListings = async (
+  now: Date,
+  options: Record<string, unknown> = {}
+): Promise<SponsoredListing[]> => {
+  return SponsoredListing.findAll({
+    ...options,
+    where: buildEligibleListingWhere(now),
+  });
+};
+
+export type ImpressionResult =
+  SponsoredListingImpressionResult<SponsoredListing>;
+
+const markExpiredIfNeeded = async (
+  listing: SponsoredListing
+): Promise<SponsoredListing> => {
+  if (listing.status === SponsoredListingStatus.Expired) {
+    return listing;
+  }
+
+  const updated = await listing.update({
+    status: SponsoredListingStatus.Expired,
+  });
+
+  return updated ?? listing;
+};
+
+export const recordSponsoredListingImpression = async ({
+  listing,
+  now,
+}: {
+  listing: SponsoredListing;
+  now: Date;
+}): Promise<ImpressionResult> => {
+  const sequelize = SponsoredListing.sequelize;
+
+  if (!sequelize) {
+    throw new Error("SponsoredListing model is not connected to Sequelize");
+  }
+
+  return sequelize.transaction(async (transaction) => {
+    /*
+     * Lock the current row before checking lifecycle state. Concurrent
+     * impression requests for the same listing will therefore evaluate and
+     * update the budget one at a time instead of incrementing from stale state.
+     */
+    const currentListing = await SponsoredListing.findByPk(listing.id, {
+      transaction,
+      lock: transaction.LOCK.UPDATE,
+    });
+
+    if (!currentListing) {
+      return {
+        kind: "expired",
+        listing,
+      };
+    }
+
+    const decision = evaluateSponsoredListingImpression(
+      currentListing as any,
+      now
+    );
+
+    if (decision.decision === "not-started") {
+      return {
+        kind: "not-started",
+        listing: currentListing,
+      };
+    }
+
+    if (decision.decision === "expired") {
+      if (currentListing.status !== SponsoredListingStatus.Expired) {
+        await currentListing.update(
+          {
+            status: SponsoredListingStatus.Expired,
+          },
+          { transaction }
+        );
+      }
+
+      return {
+        kind: "expired",
+        listing: currentListing,
+      };
+    }
+
+    await currentListing.increment("impressions", { transaction });
+    await currentListing.reload({ transaction });
+
+    if (shouldExpireSponsoredListing(currentListing as any, now)) {
+      await currentListing.update(
+        {
+          status: SponsoredListingStatus.Expired,
+        },
+        { transaction }
+      );
+    }
+
+    return {
+      kind: "counted",
+      listing: currentListing,
+    };
+  });
+};
+
+export const expireSponsoredListingsByLifecycle = async (
+  now: Date
+): Promise<void> => {
+  await SponsoredListing.update(
+    {
+      status: SponsoredListingStatus.Expired,
+    },
+    {
+      where: buildExpirationWhere(now),
+    }
+  );
+};
