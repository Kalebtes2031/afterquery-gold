+jest.mock("../../utils/redis.utils", () => ({
+  __esModule: true,
+  default: {
+    get: jest.fn(),
+    set: jest.fn(),
+    setEx: jest.fn(),
+    del: jest.fn(),
+    keys: jest.fn(),
+    expire: jest.fn(),
+    sAdd: jest.fn(),
+    sMembers: jest.fn(),
+    connect: jest.fn(async () => undefined),
+    quit: jest.fn(async () => undefined),
+    disconnect: jest.fn(),
+    on: jest.fn(),
+    multi: jest.fn(() => ({
+      exec: jest.fn(async () => []),
+    })),
+  },
+}));
+
+import Database from "../db_setup";
+import SponsoredListing from "../../models/SponsoredListing/SponsoredListing";
+import {
+  appForFeaturedRestaurants,
+  clearFeaturedFixtures,
+  CURSOR_TEST_RESTAURANT_IDS,
+  cursorListingId,
+  FEATURED_TEST_NOW,
+  getFeatured,
+  responseIds,
+  responseRestaurantIds,
+  seedListing,
+  seedRestaurant,
+  seedRestaurantImage,
+  updateRestaurantAvailability,
+} from "./helpers/featured_restaurant_test.helpers";
+const app = appForFeaturedRestaurants();
+beforeAll(async () => {
+  await Database.getInstance();
+  jest.useFakeTimers({ doNotFake: ["nextTick", "setImmediate"] });
+});
+afterAll(async () => {
+  await clearFeaturedFixtures();
+  jest.useRealTimers();
+  await Database.close();
+});
+beforeEach(async () => {
+  jest.setSystemTime(FEATURED_TEST_NOW);
+  await clearFeaturedFixtures();
+});
+afterEach(() => jest.setSystemTime(FEATURED_TEST_NOW));
+type Row = {
+  restaurantId: string;
+  listingId: string;
+};
+type SeedOptions = {
+  slot: number;
+  suffix: number;
+  priority: number;
+  endDate?: string;
+  orderable?: boolean;
+  closed?: boolean;
+};
+const seed = async ({
+  slot,
+  suffix,
+  priority,
+  endDate = "2030-07-15T12:00:00.000Z",
+  orderable = false,
+  closed = false,
+}: SeedOptions): Promise<Row> => {
+  const restaurantId = CURSOR_TEST_RESTAURANT_IDS[slot];
+  const listingId = cursorListingId(suffix);
+  await seedRestaurant({
+    id: restaurantId,
+    permanentlyClosed: closed,
+    orderServiceAvailable: orderable,
+    orderServiceOnline: orderable,
+  });
+  await seedListing({
+    id: listingId,
+    restaurantId,
+    priority,
+    endDate,
+  });
+  return { restaurantId, listingId };
+};
+const series = async (
+  count: number,
+  base: number,
+  orderable = false
+): Promise<Row[]> => {
+  const rows: Row[] = [];
+  for (let i = 0; i < count; i += 1) {
+    rows.push(
+      await seed({
+        slot: i,
+        suffix: base + i,
+        priority: count - i,
+        orderable,
+      })
+    );
+  }
+  return rows;
+};
+const page = (
+  limit: number,
+  cursor?: string,
+  availability?: "browse" | "orderable"
+) =>
+  getFeatured(app, {
+    limit: String(limit),
+    ...(cursor !== undefined ? { cursor } : {}),
+    ...(availability !== undefined ? { availability } : {}),
+  });
+const next = (response: any): string | undefined =>
+  typeof response.body.nextCursor === "string"
+    ? response.body.nextCursor
+    : undefined;
+const expectCursorError = async (
+  query: Record<string, unknown>,
+  message = "cursor is invalid"
+) => {
+  const response = await getFeatured(app, query);
+  expect(response.status).toBe(400);
+  expect(response.body).toEqual({
+    success: false,
+    message,
+  });
+};
+describe("featured restaurant cursor behavior", () => {
+  it("globally sorts by priority, end date, and listing id", async () => {
+    const specs: SeedOptions[] = [
+      {
+        slot: 0,
+        suffix: 506,
+        priority: 1,
+        endDate: "2030-07-15T12:00:00.000Z",
+      },
+      {
+        slot: 1,
+        suffix: 505,
+        priority: 9,
+        endDate: "2030-07-20T12:00:00.000Z",
+      },
+      {
+        slot: 2,
+        suffix: 504,
+        priority: 9,
+        endDate: "2030-07-10T12:00:00.000Z",
+      },
+      {
+        slot: 3,
+        suffix: 503,
+        priority: 9,
+        endDate: "2030-07-10T12:00:00.000Z",
+      },
+      {
+        slot: 4,
+        suffix: 502,
+        priority: 5,
+        endDate: "2030-07-01T12:00:00.000Z",
+      },
+      {
+        slot: 5,
+        suffix: 501,
+        priority: 1,
+        endDate: "2030-07-01T12:00:00.000Z",
+      },
+    ];
+    for (const spec of specs) await seed(spec);
+    const expected =
+      [503, 504, 505, 502, 501, 506].map(cursorListingId);
+    const response = await getFeatured(app);
+    expect(response.status).toBe(200);
+    expect(responseIds(response)).toEqual(expected);
+  });
+  it("traverses a persistent snapshot exactly once and ends with null", async () => {
+    const rows = await series(7, 600);
+    const one = await page(3);
+    const c1 = next(one);
+    expect(responseIds(one)).toEqual(
+      rows.slice(0, 3).map((row) => row.listingId)
+    );
+    expect(typeof c1).toBe("string");
+    if (!c1) return;
+    const two = await page(3, c1);
+    const c2 = next(two);
+    expect(responseIds(two)).toEqual(
+      rows.slice(3, 6).map((row) => row.listingId)
+    );
+    expect(typeof c2).toBe("string");
+    if (!c2) return;
+    const three = await page(3, c2);
+    expect(responseIds(three)).toEqual([rows[6].listingId]);
+    expect(three.body.nextCursor).toBeNull();
+    const all = [
+      ...responseRestaurantIds(one),
+      ...responseRestaurantIds(two),
+      ...responseRestaurantIds(three),
+    ];
+    expect(all).toEqual(rows.map((row) => row.restaurantId));
+    expect(new Set(all).size).toBe(rows.length);
+  });
+  it("deduplicates and removes closed restaurants before page slots are chosen", async () => {
+    const duplicate = await seed({
+      slot: 0,
+      suffix: 700,
+      priority: 1,
+    });
+    await seedListing({
+      id: cursorListingId(701),
+      restaurantId: duplicate.restaurantId,
+      priority: 50,
+    });
+    await seed({
+      slot: 1,
+      suffix: 702,
+      priority: 100,
+      closed: true,
+    });
+    const second = await seed({
+      slot: 2,
+      suffix: 703,
+      priority: 10,
+    });
+    const response = await page(2);
+    expect(responseRestaurantIds(response)).toEqual([
+      duplicate.restaurantId,
+      second.restaurantId,
+    ]);
+    expect(responseIds(response)).toContain(cursorListingId(701));
+  });
+  it("removes offline restaurants before orderable page slots are chosen", async () => {
+    const offline = CURSOR_TEST_RESTAURANT_IDS[0];
+    await seedRestaurant({
+      id: offline,
+      orderServiceAvailable: true,
+      orderServiceOnline: false,
+    });
+    await seedListing({
+      id: cursorListingId(800),
+      restaurantId: offline,
+      priority: 100,
+    });
+    const one = await seed({
+      slot: 1,
+      suffix: 801,
+      priority: 3,
+      orderable: true,
+    });
+    const two = await seed({
+      slot: 2,
+      suffix: 802,
+      priority: 2,
+      orderable: true,
+    });
+    const response = await page(2, undefined, "orderable");
+    expect(responseRestaurantIds(response)).toEqual([
+      one.restaurantId,
+      two.restaurantId,
+    ]);
+  });
+  it("keeps the cursor valid and backfills when availability changes between pages", async () => {
+    const rows = await series(6, 900, true);
+    const first = await page(2, undefined, "orderable");
+    const cursor = next(first);
+    expect(typeof cursor).toBe("string");
+    if (!cursor) return;
+    await updateRestaurantAvailability(rows[1].restaurantId, {
+      orderServiceOnline: false,
+    });
+    await updateRestaurantAvailability(rows[2].restaurantId, {
+      orderServiceOnline: false,
+    });
+    const second = await page(2, cursor, "orderable");
+    expect(responseRestaurantIds(second)).toEqual([
+      rows[3].restaurantId,
+      rows[4].restaurantId,
+    ]);
+    const cursor2 = next(second);
+    expect(typeof cursor2).toBe("string");
+    if (!cursor2) return;
+    const third = await page(2, cursor2, "orderable");
+    expect(responseRestaurantIds(third)).toEqual([
+      rows[5].restaurantId,
+    ]);
+    expect(third.body.nextCursor).toBeNull();
+  });
+  it("keeps snapshot membership and order despite inserts, reprioritization, date changes, and new duplicates", async () => {
+    const rows = await series(6, 1000);
+    const first = await page(2);
+    const cursor = next(first);
+    expect(typeof cursor).toBe("string");
+    if (!cursor) return;
+    const addedRestaurant = CURSOR_TEST_RESTAURANT_IDS[6];
+    await seedRestaurant({ id: addedRestaurant });
+    await seedListing({
+      id: cursorListingId(1099),
+      restaurantId: addedRestaurant,
+      priority: 999,
+    });
+    await SponsoredListing.update(
+      { priority: -100 },
+      { where: { id: rows[2].listingId } }
+    );
+    await SponsoredListing.update(
+      { end_date: new Date("2030-07-30T12:00:00.000Z") },
+      { where: { id: rows[3].listingId } }
+    );
+    await SponsoredListing.update(
+      { priority: -200 },
+      { where: { id: rows[0].listingId } }
+    );
+    const replacement = cursorListingId(1098);
+    await seedListing({
+      id: replacement,
+      restaurantId: rows[2].restaurantId,
+      priority: 1000,
+    });
+    const second = await page(2, cursor);
+    expect(responseIds(second)).toEqual([
+      rows[2].listingId,
+      rows[3].listingId,
+    ]);
+    expect(responseIds(second)).not.toContain(replacement);
+    expect(responseRestaurantIds(second)).not.toContain(addedRestaurant);
+    const cursor2 = next(second);
+    expect(typeof cursor2).toBe("string");
+    if (!cursor2) return;
+    const third = await page(2, cursor2);
+    const all = [
+      ...responseRestaurantIds(first),
+      ...responseRestaurantIds(second),
+      ...responseRestaurantIds(third),
+    ];
+    expect(all).toEqual(rows.map((row) => row.restaurantId));
+    expect(new Set(all).size).toBe(rows.length);
+    expect(third.body.nextCursor).toBeNull();
+  });
+  it("skips deleted and no-longer-Active snapshot listings and fills from later entries", async () => {
+    const rows = await series(6, 1100);
+    const first = await page(2);
+    const cursor = next(first);
+    expect(typeof cursor).toBe("string");
+    if (!cursor) return;
+    await SponsoredListing.destroy({
+      where: { id: rows[2].listingId },
+    });
+    await SponsoredListing.update(
+      { status: "Expired" as any },
+      { where: { id: rows[3].listingId } }
+    );
+    const second = await page(2, cursor);
+    expect(responseIds(second)).toEqual([
+      rows[4].listingId,
+      rows[5].listingId,
+    ]);
+    expect(second.body.nextCursor).toBeNull();
+  });
+  it("keeps the cursor at most 512 characters for a large snapshot", async () => {
+    await series(25, 1200);
+    const response = await page(20);
+    const cursor = next(response);
+    expect(response.body.data).toHaveLength(20);
+    expect(typeof cursor).toBe("string");
+    if (!cursor) return;
+    expect(cursor.length).toBeLessThanOrEqual(512);
+  });
+  it("binds a cursor to its original limit and availability", async () => {
+    await series(6, 1300, true);
+    const first = await page(2, undefined, "browse");
+    const cursor = next(first);
+    expect(typeof cursor).toBe("string");
+    if (!cursor) return;
+    await expectCursorError({
+      limit: "3",
+      availability: "browse",
+      cursor,
+    });
+    await expectCursorError({
+      limit: "2",
+      availability: "orderable",
+      cursor,
+    });
+  });
+  it("expires a pagination snapshot fifteen minutes after page one", async () => {
+    await series(4, 1400);
+    const first = await page(2);
+    const cursor = next(first);
+    expect(typeof cursor).toBe("string");
+    if (!cursor) return;
+    jest.setSystemTime(
+      new Date(
+        FEATURED_TEST_NOW.getTime() +
+          15 * 60 * 1000 +
+          1
+      )
+    );
+    await expectCursorError({
+      limit: "2",
+      cursor,
+    });
+  });
+  it("rejects blank, malformed, repeated, oversized, and changed cursors exactly", async () => {
+    await expectCursorError({
+      limit: "2",
+      cursor: "",
+    });
+    await expectCursorError({
+      limit: "2",
+      cursor: "not-a-cursor",
+    });
+    await expectCursorError({
+      limit: "2",
+      cursor: ["one", "two"],
+    });
+    await expectCursorError({
+      limit: "2",
+      cursor: "x".repeat(513),
+    });
+    await series(3, 1500);
+    const first = await page(1);
+    const cursor = next(first);
+    expect(typeof cursor).toBe("string");
+    if (!cursor) return;
+    const changed =
