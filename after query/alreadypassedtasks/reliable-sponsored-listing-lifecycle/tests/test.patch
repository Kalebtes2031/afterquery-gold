+
+const app = appForFeaturedRestaurants();
+
+const requestId = (suffix: number): string =>
+  `57000000-0000-4000-8000-${String(suffix).padStart(12, "0")}`;
+
+const seedSeries = async (
+  count: number,
+  listingBase: number,
+  orderable = false
+) => {
+  const rows: Array<{
+    restaurantId: string;
+    listingId: string;
+  }> = [];
+
+  for (let i = 0; i < count; i += 1) {
+    const restaurantId =
+      CURSOR_TEST_RESTAURANT_IDS[i];
+
+    const listingId =
+      cursorListingId(listingBase + i);
+
+    await seedRestaurant({
+      id: restaurantId,
+      orderServiceAvailable: orderable,
+      orderServiceOnline: orderable,
+    });
+
+    await seedListing({
+      id: listingId,
+      restaurantId,
+      priority: count - i,
+    });
+
+    rows.push({
+      restaurantId,
+      listingId,
+    });
+  }
+
+  return rows;
+};
+
+const limited = (
+  limit: number,
+  id: string,
+  cursor?: string,
+  availability?: "browse" | "orderable"
+) =>
+  getFeatured(app, {
+    limit: String(limit),
+    requestId: id,
+    ...(cursor ? { cursor } : {}),
+    ...(availability
