+        : right;
+
+    expect(loser.body).toEqual({
+      success: false,
+      message: "cursor is invalid",
+    });
+  });
+
+  it("makes concurrent first-page retries return the same snapshot and cursor", async () => {
+    await seedSeries(6, 8000);
+
+    const id = requestId(60);
+
+    const [left, right] =
+      await Promise.all([
+        limited(2, id),
+        limited(2, id),
+      ]);
+
+    expect(left.status).toBe(200);
+    expect(right.status).toBe(200);
+    expect(left.body).toEqual(
+      right.body
+    );
+
+    expect(
+      typeof left.body.nextCursor
+    ).toBe("string");
+  });
+
+  it("replays an exact terminal page with null nextCursor after data changes", async () => {
+    await seedSeries(
+      3,
+      9000
+    );
+
+    const first =
+      await limited(
+        2,
+        requestId(70)
+      );
+
+    expect(first.status).toBe(200);
+    expect(
+      typeof first.body.nextCursor
+    ).toBe("string");
+
+    const cursor =
+      first.body.nextCursor as string;
+
+    const id =
+      requestId(71);
+
+    const terminal =
+      await limited(
+        2,
+        id,
+        cursor
+      );
+
+    expect(terminal.status).toBe(200);
+    expect(terminal.body.data).toHaveLength(1);
+    expect(terminal.body.nextCursor).toBeNull();
+
+    const returned =
+      terminal.body.data[0];
+
+    await SponsoredListing.destroy({
+      where: {
+        id: returned.id,
+      },
+    });
+
+    await updateRestaurantAvailability(
+      returned.restaurant_id,
+      {
+        orderServiceOnline: false,
+      }
+    );
+
+    const replay =
+      await limited(
+        2,
+        id,
+        cursor
+      );
+
+    expect(replay.status).toBe(200);
+    expect(replay.body).toEqual(
+      terminal.body
+    );
+  });
+
+});
