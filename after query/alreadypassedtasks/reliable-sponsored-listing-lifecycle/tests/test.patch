+    );
+  });
+
+  it("allows only one competing requestId to consume a cursor", async () => {
+    await seedSeries(6, 7000);
+
+    const first =
+      await limited(
+        2,
+        requestId(50)
+      );
+
+    const cursor =
+      first.body.nextCursor as string;
+
+    const [left, right] =
+      await Promise.all([
+        limited(
+          2,
+          requestId(51),
+          cursor
+        ),
+        limited(
+          2,
+          requestId(52),
+          cursor
+        ),
+      ]);
+
+    expect(
+      [left.status, right.status]
