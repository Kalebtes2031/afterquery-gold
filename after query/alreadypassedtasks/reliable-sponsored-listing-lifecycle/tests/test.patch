+      4,
+      2000,
+      true
+    );
+
+    const first = await page(
+      2,
+      undefined,
+      "orderable"
+    );
+
+    const cursor = next(first);
+
+    await updateRestaurantAvailability(
+      rows[2].restaurantId,
+      {
+        orderServiceOnline: false,
+      }
