+    );
+
+    expect(second.status).toBe(200);
+
+    await updateRestaurantAvailability(
+      rows[2].restaurantId,
+      {
+        orderServiceOnline: false,
+      }
+    );
+
+    await seedRestaurantImage({
+      restaurantId:
+        rows[3].restaurantId,
+      url:
+        "https://images.example/changed-after-commit.jpg",
+      leading: true,
+    });
+
+    await SponsoredListing.destroy({
+      where: {
+        id: rows[2].listingId,
+      },
+    });
+
+    const replay = await limited(
+      2,
+      id,
+      cursor,
+      "orderable"
+    );
+
+    expect(replay.status).toBe(200);
+    expect(replay.body).toEqual(
+      second.body
+    );
