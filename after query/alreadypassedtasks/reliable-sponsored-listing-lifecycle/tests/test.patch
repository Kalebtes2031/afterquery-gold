+jest.mock("../../utils/redis.utils", () => ({
+  __esModule: true,
+  default: {
+    get: jest.fn(),
+    set: jest.fn(),
+    setEx: jest.fn(),
+    del: jest.fn(),
+    keys: jest.fn(),
+    expire: jest.fn(),
+    sAdd: jest.fn(),
+    sMembers: jest.fn(),
+    connect: jest.fn(async () => undefined),
+    quit: jest.fn(async () => undefined),
+    disconnect: jest.fn(),
+    on: jest.fn(),
+    multi: jest.fn(() => ({
+      exec: jest.fn(async () => []),
+    })),
+  },
+}));
+
+import Database from "../db_setup";
+import {
+  appForFeaturedRestaurants,
+  clearFeaturedFixtures,
+  FEATURED_TEST_NOW,
+  getFeatured,
+  listingId,
+  RESTAURANT_A,
+  RESTAURANT_B,
+  RESTAURANT_C,
+  responseRestaurantIds,
+  seedListing,
+  seedRestaurant,
+  seedRestaurantImage,
+  updateRestaurantAvailability,
+} from "./helpers/featured_restaurant_test.helpers";
+
+const app = appForFeaturedRestaurants();
+
+beforeAll(async () => {
+  await Database.getInstance();
+  jest.useFakeTimers({
+    doNotFake: ["nextTick", "setImmediate"],
+  });
+  jest.setSystemTime(FEATURED_TEST_NOW);
+});
+
+afterAll(async () => {
+  await clearFeaturedFixtures();
+  jest.useRealTimers();
+  await Database.close();
+});
+
+beforeEach(async () => {
+  await clearFeaturedFixtures();
+});
+
+describe("featured restaurant availability rules", () => {
+  describe("restaurant eligibility", () => {
+    it("hides a permanently closed restaurant in the default browse mode", async () => {
+      await seedRestaurant({ id: RESTAURANT_A, permanentlyClosed: true });
+      await seedListing({ id: listingId(1), restaurantId: RESTAURANT_A });
+
+      const response = await getFeatured(app);
+
+      expect(response.status).toBe(200);
+      expect(response.body).toEqual({ success: true, data: [] });
+    });
+
+
+    it("hides a restaurant with ordering disabled in orderable mode", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: false,
+        orderServiceOnline: true,
+      });
+      await seedListing({ id: listingId(3), restaurantId: RESTAURANT_A });
+
+      const response = await getFeatured(app, { availability: "orderable" });
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toEqual([]);
+    });
+
+    it("hides an offline restaurant in orderable mode", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: true,
+        orderServiceOnline: false,
+      });
+      await seedListing({ id: listingId(4), restaurantId: RESTAURANT_A });
+
+      const response = await getFeatured(app, { availability: "orderable" });
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toEqual([]);
+    });
+
+
+    it("returns only orderable restaurants from a mixed availability set", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: true,
+        orderServiceOnline: true,
+      });
+      await seedRestaurant({
+        id: RESTAURANT_B,
+        orderServiceAvailable: true,
+        orderServiceOnline: false,
+      });
+      await seedRestaurant({
+        id: RESTAURANT_C,
+        orderServiceAvailable: false,
+        orderServiceOnline: true,
+      });
+      await seedListing({ id: listingId(6), restaurantId: RESTAURANT_A });
+      await seedListing({ id: listingId(7), restaurantId: RESTAURANT_B });
+      await seedListing({ id: listingId(8), restaurantId: RESTAURANT_C });
+
+      const response = await getFeatured(app, { availability: "orderable" });
+
+      expect(response.status).toBe(200);
+      expect(responseRestaurantIds(response)).toEqual([RESTAURANT_A]);
+    });
+
+  });
+
+  describe("browse compatibility", () => {
+    it("keeps a non-closed restaurant visible in browse mode when ordering is disabled", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: false,
+        orderServiceOnline: false,
+      });
+      await seedListing({ id: listingId(15), restaurantId: RESTAURANT_A });
+
+      const response = await getFeatured(app);
+
+      expect(response.status).toBe(200);
+      expect(responseRestaurantIds(response)).toEqual([RESTAURANT_A]);
+    });
+
+
+    it("keeps the existing image fallback and remaining-time response fields", async () => {
+      await seedRestaurant({ id: RESTAURANT_A });
+      await seedListing({
+        id: listingId(17),
+        restaurantId: RESTAURANT_A,
+        endDate: "2030-06-16T12:00:00.000Z",
+      });
+      await seedRestaurantImage({
+        restaurantId: RESTAURANT_A,
+        url: "https://images.example/fallback-logo.jpg",
+        leading: false,
+      });
+
+      const response = await getFeatured(app);
+
+      expect(response.status).toBe(200);
+      expect(response.body.data[0].restaurant_logo).toBe(
+        "https://images.example/fallback-logo.jpg"
+      );
+      expect(response.body.data[0].remainingTime).toEqual({
+        days: 1,
+        hours: 0,
+        minutes: 0,
+        seconds: 0,
+      });
+    });
+
+    it("does not expose restaurant availability flags in the successful response", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: true,
+        orderServiceOnline: true,
+      });
+      await seedListing({ id: listingId(18), restaurantId: RESTAURANT_A });
+
+      const response = await getFeatured(app);
+      const restaurant = response.body.data[0].restaurant;
+
+      expect(response.status).toBe(200);
+      expect(restaurant.name).toBe("Featured Cafe");
+      expect(restaurant).not.toHaveProperty("is_permanently_closed");
+      expect(restaurant).not.toHaveProperty("is_order_service_available");
+      expect(restaurant).not.toHaveProperty("is_order_service_online");
+    });
+  });
+
+  describe("fresh availability", () => {
+
+    it("removes a restaurant on the next orderable request after it goes offline", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: true,
+        orderServiceOnline: true,
+      });
+      await seedListing({ id: listingId(12), restaurantId: RESTAURANT_A });
+
+      const before = await getFeatured(app, { availability: "orderable" });
+      expect(before.body.data).toHaveLength(1);
+
+      await updateRestaurantAvailability(RESTAURANT_A, {
+        orderServiceOnline: false,
+      });
+
+      const after = await getFeatured(app, { availability: "orderable" });
+      expect(after.status).toBe(200);
+      expect(after.body.data).toEqual([]);
+    });
+
+
+    it("can become orderable on the next request without changing the sponsored listing", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: true,
+        orderServiceOnline: false,
+      });
+      await seedListing({ id: listingId(14), restaurantId: RESTAURANT_A });
+
+      const before = await getFeatured(app, { availability: "orderable" });
+      expect(before.body.data).toEqual([]);
+
+      await updateRestaurantAvailability(RESTAURANT_A, {
+        orderServiceOnline: true,
+      });
+
+      const after = await getFeatured(app, { availability: "orderable" });
+      expect(after.status).toBe(200);
+      expect(responseRestaurantIds(after)).toEqual([RESTAURANT_A]);
+    });
+  });
+
+  describe("availability query validation", () => {
+    it("rejects an unsupported availability value", async () => {
+      const response = await getFeatured(app, { availability: "closed" });
+
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "availability must be browse or orderable",
+      });
+    });
+
+    it("rejects repeated availability values", async () => {
+      const response = await requestRepeatedAvailability();
+
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "availability must be browse or orderable",
+      });
+    });
+
+
+    it("rejects an empty availability value", async () => {
+      const response = await getFeatured(app, { availability: "" });
+
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "availability must be browse or orderable",
+      });
+    });
+  });
+});
+
+const requestRepeatedAvailability = () =>
+  getFeatured(app, {
+    availability: ["browse", "orderable"],
+  });
