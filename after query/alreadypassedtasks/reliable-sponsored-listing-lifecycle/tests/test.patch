+
+    it("rejects a negative limit", async () => {
+      const response = await getFeatured(app, { limit: "-1" });
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "limit must be a whole number from 1 to 20",
+      });
+    });
+
+    it("rejects a fractional limit", async () => {
+      const response = await getFeatured(app, { limit: "1.5" });
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "limit must be a whole number from 1 to 20",
+      });
+    });
+
+    it("rejects a non-numeric limit", async () => {
+      const response = await getFeatured(app, { limit: "many" });
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "limit must be a whole number from 1 to 20",
+      });
+    });
+
+    it("rejects a limit above twenty", async () => {
+      const response = await getFeatured(app, { limit: "21" });
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "limit must be a whole number from 1 to 20",
+      });
+    });
+
+    it("rejects repeated limit values", async () => {
+      const response = await getFeatured(app, { limit: ["1", "2"] });
+      expect(response.status).toBe(400);
+      expect(response.body).toEqual({
+        success: false,
+        message: "limit must be a whole number from 1 to 20",
+      });
+    });
+  });
+});
