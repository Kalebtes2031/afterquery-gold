+
+beforeAll(async () => {
+  await Database.getInstance();
+
+  jest.useFakeTimers({
+    doNotFake: [
+      "nextTick",
+      "setImmediate",
+    ],
+  });
+
+  jest.setSystemTime(FEATURED_TEST_NOW);
+});
+
+afterAll(async () => {
+  await clearFeaturedFixtures();
+  jest.useRealTimers();
+  await Database.close();
+});
+
+beforeEach(async () => {
+  await clearFeaturedFixtures();
+});
+
+describe("featured restaurant durable page requests", () => {
+  it("requires requestId whenever limit is supplied", async () => {
+    const response = await request(app)
+      .get("/api/v1/sponsored-listings")
+      .query({
+        limit: "2",
+      });
+
+    expect(response.status).toBe(400);
+    expect(response.body).toEqual({
+      success: false,
+      message: "limit requires requestId",
+    });
+  });
+
+  it("rejects invalid and repeated requestId values exactly", async () => {
+    const invalid = await request(app)
+      .get("/api/v1/sponsored-listings")
+      .query({
+        limit: "2",
+        requestId: "not-a-uuid",
+      });
+
+    expect(invalid.status).toBe(400);
+    expect(invalid.body).toEqual({
+      success: false,
+      message: "requestId is invalid",
+    });
+
+    const repeated = await request(app)
+      .get("/api/v1/sponsored-listings")
+      .query({
+        limit: "2",
+        requestId: [
+          requestId(1),
+          requestId(2),
+        ],
+      });
+
+    expect(repeated.status).toBe(400);
+    expect(repeated.body).toEqual({
+      success: false,
+      message: "requestId is invalid",
+    });
+  });
+
+  it("rejects requestId when limit is absent", async () => {
+    const response = await request(app)
+      .get("/api/v1/sponsored-listings")
+      .query({
+        requestId: requestId(3),
+      });
+
+    expect(response.status).toBe(400);
+    expect(response.body).toEqual({
+      success: false,
+      message: "requestId requires limit",
+    });
+  });
+
+  it("replays the exact first-page body after membership changes", async () => {
+    await seedSeries(4, 3000);
+
+    const id = requestId(10);
+
+    const first = await limited(
+      2,
+      id
+    );
+
+    expect(first.status).toBe(200);
+
+    const extraRestaurant =
+      CURSOR_TEST_RESTAURANT_IDS[6];
+
+    await seedRestaurant({
+      id: extraRestaurant,
+    });
+
+    await seedListing({
+      id: cursorListingId(3999),
+      restaurantId:
+        extraRestaurant,
+      priority: 1000,
+    });
+
+    const replay = await limited(
+      2,
+      id
+    );
+
+    expect(replay.status).toBe(200);
+    expect(replay.body).toEqual(
+      first.body
+    );
+  });
+
+  it("replays the exact committed continuation after data changes", async () => {
+    const rows = await seedSeries(
+      6,
+      4000,
+      true
+    );
+
+    const first = await limited(
+      2,
+      requestId(20),
+      undefined,
+      "orderable"
+    );
+
+    const cursor =
+      first.body.nextCursor as string;
+
+    const id = requestId(21);
+
+    const second = await limited(
+      2,
+      id,
+      cursor,
