+
+    expect(
+      [left.status, right.status].sort((a, b) => a - b)
+    ).toEqual([200, 400]);
+
+    const winner =
+      left.status === 200 ? left : right;
+
+    const loser =
+      left.status === 400 ? left : right;
+
+    expect(responseIds(winner)).toEqual([
+      rows[2].listingId,
+      rows[3].listingId,
