+        id,
+        firstCursor
+      );
+
+    expect(second.status).toBe(200);
+
+    const rebound =
+      await limited(
+        3,
+        id,
+        firstCursor
+      );
+
+    expect(rebound.status).toBe(400);
+    expect(rebound.body).toEqual({
+      success: false,
+      message: "requestId is invalid",
+    });
+  });
+
+  it("makes concurrent retries converge on the same durable page", async () => {
+    const rows =
+      await seedSeries(
+        6,
+        6000
+      );
+
+    const first =
+      await limited(
+        2,
+        requestId(40)
+      );
+
+    expect(first.status).toBe(200);
+
+    const cursor =
+      first.body.nextCursor as string;
+
+    const id =
+      requestId(41);
+
+    const [left, right] =
+      await Promise.all([
+        limited(
+          2,
+          id,
+          cursor
+        ),
+        limited(
+          2,
+          id,
+          cursor
+        ),
+      ]);
+
+    expect(left.status).toBe(200);
+    expect(right.status).toBe(200);
+
+    expect(left.body).toEqual(
+      right.body
+    );
+
+    expect(left.body.data).toHaveLength(
+      2
+    );
+
+    expect(
+      typeof left.body.nextCursor
+    ).toBe("string");
+
+    await SponsoredListing.destroy({
+      where: {
+        id: rows[2].listingId,
+      },
+    });
+
+    await updateRestaurantAvailability(
+      rows[3].restaurantId,
+      {
+        orderServiceOnline: false,
+      }
+    );
+
+    const replay =
+      await limited(
+        2,
+        id,
