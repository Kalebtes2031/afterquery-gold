+import { randomUUID } from "crypto";
+import express, { NextFunction, Request, Response } from "express";
+import request from "supertest";
+import { Op } from "sequelize";
+
+import Database from "../../db_setup";
+import { Restaurant, RestaurantImage } from "../../../models";
+import SponsoredListing from "../../../models/SponsoredListing/SponsoredListing";
+import { getSponsoredListings } from "../../../controllers/sponsored_listing.controller";
+
+export const FEATURED_TEST_NOW = new Date("2030-06-15T12:00:00.000Z");
+
+export const RESTAURANT_A = "41000000-0000-4000-8000-000000000001";
+export const RESTAURANT_B = "41000000-0000-4000-8000-000000000002";
+export const RESTAURANT_C = "41000000-0000-4000-8000-000000000003";
+export const RESTAURANT_D = "41000000-0000-4000-8000-000000000004";
+export const RESTAURANT_E = "41000000-0000-4000-8000-000000000005";
+
+export const LIMIT_TEST_RESTAURANT_IDS = Array.from(
+  { length: 21 },
+  (_, index) =>
+    `43000000-0000-4000-8000-${String(index + 1).padStart(12, "0")}`
+);
+
+export const CURSOR_TEST_RESTAURANT_IDS = Array.from(
+  { length: 30 },
+  (_, index) =>
+    `44000000-0000-4000-8000-${String(index + 1).padStart(12, "0")}`
+);
+
+export const FEATURED_RESTAURANT_IDS = [
+  RESTAURANT_A,
+  RESTAURANT_B,
+  RESTAURANT_C,
+  RESTAURANT_D,
+  RESTAURANT_E,
+  ...LIMIT_TEST_RESTAURANT_IDS,
+  ...CURSOR_TEST_RESTAURANT_IDS,
+];
+
+export const listingId = (suffix: number): string =>
+  `42000000-0000-4000-8000-${String(suffix).padStart(12, "0")}`;
+
+export const cursorListingId = (suffix: number): string =>
+  `45000000-0000-4000-8000-${String(suffix).padStart(12, "0")}`;
+
+export const nextFeaturedRequestId = (): string =>
+  randomUUID();
+
+export const appForFeaturedRestaurants = () => {
+  const app = express();
+  app.use(express.json());
+  app.get("/api/v1/sponsored-listings", getSponsoredListings as any);
+  app.use(
+    (
+      error: any,
+      _req: Request,
+      res: Response,
+      _next: NextFunction
+    ) => {
+      res.status(error?.statusCode ?? error?.status ?? 500).json({
+        success: false,
+        message: error?.message ?? "Internal Server Error",
+      });
+    }
+  );
+  return app;
+};
+
+export const getFeatured = (
+  app: ReturnType<typeof appForFeaturedRestaurants>,
+  query?: Record<string, unknown>
+) => {
+  const call = request(app).get("/api/v1/sponsored-listings");
+
+  if (!query) {
+    return call;
+  }
+
+  const normalized = {
+    ...query,
+  };
+
+  if (
+    normalized.limit !== undefined &&
+    normalized.requestId === undefined
+  ) {
+    normalized.requestId =
+      nextFeaturedRequestId();
+  }
+
+  return call.query(normalized as any);
+};
+
+export const clearFeaturedFixtures = async () => {
+  await RestaurantImage.destroy({
+    where: {
+      restaurant_id: {
+        [Op.in]: FEATURED_RESTAURANT_IDS,
+      },
+    },
+  });
+
+  await SponsoredListing.destroy({
+    where: {
+      restaurant_id: {
+        [Op.in]: FEATURED_RESTAURANT_IDS,
+      },
+    },
+  });
+
+  await Restaurant.destroy({
+    where: {
+      id: {
+        [Op.in]: FEATURED_RESTAURANT_IDS,
+      },
+    },
+  });
+};
+
+export const seedRestaurant = async ({
+  id,
+  name = "Featured Cafe",
+  permanentlyClosed = false,
+  orderServiceAvailable = false,
+  orderServiceOnline = false,
+}: {
+  id: string;
+  name?: string;
+  permanentlyClosed?: boolean;
+  orderServiceAvailable?: boolean;
+  orderServiceOnline?: boolean;
+}) => {
+  const sequelize = await Database.getInstance();
+
+  await sequelize.getQueryInterface().bulkInsert("restaurants", [
+    {
+      id,
+      name,
+      currency: "ETB",
+      is_permanently_closed: permanentlyClosed,
+      is_order_service_available: orderServiceAvailable,
+      is_order_service_online: orderServiceOnline,
+      createdAt: FEATURED_TEST_NOW,
+      updatedAt: FEATURED_TEST_NOW,
+    },
+  ]);
+};
+
+export const updateRestaurantAvailability = async (
+  id: string,
+  values: {
+    permanentlyClosed?: boolean;
+    orderServiceAvailable?: boolean;
+    orderServiceOnline?: boolean;
+  }
+) => {
+  const update: Record<string, boolean> = {};
+
+  if (values.permanentlyClosed !== undefined) {
+    update.is_permanently_closed = values.permanentlyClosed;
+  }
+  if (values.orderServiceAvailable !== undefined) {
+    update.is_order_service_available = values.orderServiceAvailable;
+  }
+  if (values.orderServiceOnline !== undefined) {
+    update.is_order_service_online = values.orderServiceOnline;
+  }
+
+  await Restaurant.update(update, {
+    where: { id },
+  });
+};
+
+export const seedListing = async ({
+  id,
+  restaurantId,
+  priority = 1,
+  endDate = "2030-07-15T12:00:00.000Z",
+}: {
+  id: string;
+  restaurantId: string;
+  priority?: number;
+  endDate?: Date | string;
+}) =>
+  SponsoredListing.create({
+    id,
+    restaurant_id: restaurantId,
+    start_date: new Date("2030-06-01T00:00:00.000Z"),
+    end_date: new Date(endDate),
+    impressions: 1,
+    max_impressions: 100,
+    status: "Active",
+    priority,
+    rotation_interval: 5,
+    image_url: `https://images.example/${id}.jpg`,
+    discount_info: null,
+  } as any);
+
+export const seedRestaurantImage = async ({
+  restaurantId,
+  url,
+  leading,
+}: {
+  restaurantId: string;
+  url: string;
+  leading: boolean;
+}) =>
+  RestaurantImage.create({
+    restaurant_id: restaurantId,
+    url,
+    is_leading: leading,
+  } as any);
+
+export const responseIds = (response: request.Response): string[] =>
+  response.body.data.map((entry: any) => entry.id);
+
+export const responseRestaurantIds = (response: request.Response): string[] =>
+  response.body.data.map((entry: any) => entry.restaurant_id);