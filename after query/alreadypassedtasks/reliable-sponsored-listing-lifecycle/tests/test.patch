+      await seedListing({ id: listingId(110), restaurantId: RESTAURANT_A, priority: 1 });
+      await seedListing({ id: listingId(111), restaurantId: RESTAURANT_A, priority: 9 });
+
+      const first = await getFeatured(app);
+      expect(responseIds(first)).toEqual([listingId(111)]);
+
+      await SponsoredListing.destroy({ where: { restaurant_id: RESTAURANT_A } });
+
+      await seedListing({ id: listingId(111), restaurantId: RESTAURANT_A, priority: 9 });
+      await seedListing({ id: listingId(110), restaurantId: RESTAURANT_A, priority: 1 });
+
+      const second = await getFeatured(app);
+      expect(second.status).toBe(200);
+      expect(responseIds(second)).toEqual([listingId(111)]);
+    });
+  });
+
+  describe("limit after eligibility and duplicate removal", () => {
+    it("applies limit after duplicate listings have been collapsed", async () => {
+      await seedBasicRestaurant(RESTAURANT_A);
+      await seedBasicRestaurant(RESTAURANT_B);
+      await seedListing({ id: listingId(120), restaurantId: RESTAURANT_A, priority: 1 });
+      await seedListing({ id: listingId(121), restaurantId: RESTAURANT_A, priority: 6 });
+      await seedListing({ id: listingId(122), restaurantId: RESTAURANT_B, priority: 2 });
+
+      const response = await getFeatured(app, { limit: "2" });
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toHaveLength(2);
+      expect(new Set(responseRestaurantIds(response)).size).toBe(2);
+    });
+
+    it("does not let a permanently closed restaurant consume a limit slot", async () => {
+      await seedRestaurant({ id: RESTAURANT_A, permanentlyClosed: true });
+      await seedBasicRestaurant(RESTAURANT_B);
+      await seedBasicRestaurant(RESTAURANT_C);
+      await seedListing({ id: listingId(123), restaurantId: RESTAURANT_A, priority: 10 });
+      await seedListing({ id: listingId(124), restaurantId: RESTAURANT_B, priority: 2 });
+      await seedListing({ id: listingId(125), restaurantId: RESTAURANT_C, priority: 1 });
+
+      const response = await getFeatured(app, { limit: "2" });
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toHaveLength(2);
+      expect(responseRestaurantIds(response)).not.toContain(RESTAURANT_A);
+    });
+
+    it("does not let an offline restaurant consume an orderable limit slot", async () => {
+      await seedRestaurant({
+        id: RESTAURANT_A,
+        orderServiceAvailable: true,
+        orderServiceOnline: false,
+      });
+      await seedOrderableRestaurant(RESTAURANT_B);
+      await seedOrderableRestaurant(RESTAURANT_C);
+      await seedListing({ id: listingId(126), restaurantId: RESTAURANT_A, priority: 10 });
+      await seedListing({ id: listingId(127), restaurantId: RESTAURANT_B, priority: 2 });
+      await seedListing({ id: listingId(128), restaurantId: RESTAURANT_C, priority: 1 });
+
+      const response = await getFeatured(app, {
+        availability: "orderable",
+        limit: "2",
+      });
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toHaveLength(2);
+      expect(responseRestaurantIds(response)).not.toContain(RESTAURANT_A);
+    });
+
+
+    it("returns one restaurant when limit is one even when several are eligible", async () => {
+      await seedBasicRestaurant(RESTAURANT_A);
+      await seedBasicRestaurant(RESTAURANT_B);
+      await seedBasicRestaurant(RESTAURANT_C);
+      await seedListing({ id: listingId(132), restaurantId: RESTAURANT_A, priority: 1 });
+      await seedListing({ id: listingId(133), restaurantId: RESTAURANT_B, priority: 2 });
+      await seedListing({ id: listingId(134), restaurantId: RESTAURANT_C, priority: 3 });
+
+      const response = await getFeatured(app, { limit: "1" });
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toHaveLength(1);
+    });
+
+    it("counts unique restaurants rather than raw listing rows toward the limit", async () => {
+      await seedBasicRestaurant(RESTAURANT_A);
+      await seedBasicRestaurant(RESTAURANT_B);
+      await seedBasicRestaurant(RESTAURANT_C);
+      await seedListing({ id: listingId(135), restaurantId: RESTAURANT_A, priority: 1 });
+      await seedListing({ id: listingId(136), restaurantId: RESTAURANT_A, priority: 9 });
+      await seedListing({ id: listingId(137), restaurantId: RESTAURANT_B, priority: 3 });
+      await seedListing({ id: listingId(138), restaurantId: RESTAURANT_C, priority: 2 });
+
+      const response = await getFeatured(app, { limit: "2" });
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toHaveLength(2);
+      expect(new Set(responseRestaurantIds(response)).size).toBe(2);
+    });
+
+
+  });
+
+  describe("limit query validation", () => {
+    it("accepts every whole-number limit from 3 through 20", async () => {
+      for (const limit of Array.from({ length: 18 }, (_, index) => index + 3)) {
+        await clearFeaturedFixtures();
+        const restaurantCount = limit + 1;
+        for (let index = 0; index < restaurantCount; index += 1) {
+            const restaurantId = LIMIT_TEST_RESTAURANT_IDS[index];
+            await seedBasicRestaurant(restaurantId);
+            await seedListing({
+                id: listingId(200 + index),
+                restaurantId,
+                priority: restaurantCount - index,
+            });
+        }
+        const response = await getFeatured(app, {
+            limit: String(limit),
+        });
+        expect(response.status).toBe(200);
+        expect(response.body.data).toHaveLength(limit);
+        expect(new Set(responseRestaurantIds(response)).size).toBe(limit);
