+import { Transaction } from "sequelize";
+
+import { Category, Item } from "../models";
+import {
+  CANDIDATE_ITEM_CATEGORY_ENTITY_NAME,
+  CANDIDATE_ITEM_ENTITY_NAME,
+} from "../constants/candidate-item-moderation.constants";
+import { CandidateItemUpdateFields } from "../types/candidate-item-moderation.types";
+import {
+  transactionLockOptions,
+  transactionOptions,
+  withoutModerationControlFields,
+} from "../utils/candidate-item-moderation.utils";
+import { NotFoundError } from "../utils/error-response.utils";
+
+export const loadCandidateItemForModeration = async (
+  itemId: string,
+  transaction?: Transaction
+) => {
+  const candidateItem = await Item.findByPk(
+    itemId,
+    transactionLockOptions(transaction)
+  );
+
+  if (!candidateItem) {
+    throw new NotFoundError(CANDIDATE_ITEM_ENTITY_NAME);
+  }
+
+  return candidateItem;
+};
+
+export const approveCandidateCategory = async (
+  categoryId: string,
+  transaction?: Transaction
+) => {
+  const category = await Category.findByPk(
+    categoryId,
+    transactionOptions(transaction)
+  );
+
+  if (!category) {
+    throw new NotFoundError(CANDIDATE_ITEM_CATEGORY_ENTITY_NAME);
+  }
+
+  if (!category.is_approved) {
+    category.is_approved = true;
+    await category.save(transactionOptions(transaction));
+  }
+
+  return category;
+};
+
+export const persistCandidateItemModeration = async ({
+  candidateItem,
+  nextApproval,
+  updateFields,
+  transaction,
+}: {
+  candidateItem: Item;
+  nextApproval: boolean;
+  updateFields: CandidateItemUpdateFields;
+  transaction?: Transaction;
+}) => {
+  const persistedFields = withoutModerationControlFields(updateFields);
+  Object.assign(candidateItem, persistedFields);
+  candidateItem.is_approved = nextApproval;
+  await candidateItem.save(transactionOptions(transaction));
+
+  return candidateItem;
+};
