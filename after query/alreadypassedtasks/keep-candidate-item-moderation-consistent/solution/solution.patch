@@ -0,0 +1,36 @@
+import { Transaction } from "sequelize";
+
+import { Notification } from "../models";
+import { NotificationCategory } from "../models/Feedback/Notification";
+
+type CandidateBatchNotificationInput = {
+  itemId: string;
+  ownerId: string;
+  isApproved: boolean;
+  transaction: Transaction;
+};
+
+export const createCandidateBatchModerationNotification = async ({
+  itemId,
+  ownerId,
+  isApproved,
+  transaction,
+}: CandidateBatchNotificationInput) => {
+  const message = isApproved
+    ? "Your candidate item has been approved"
+    : "Your candidate item has been rejected";
+
+  return Notification.create(
+    {
+      notifiable_type: "Item",
+      notifiable_id: itemId,
+      user_id: ownerId,
+      reactor_id: ownerId,
+      notification_category: NotificationCategory.Order,
+      message,
+    } as any,
+    {
+      transaction,
+    }
+  );
+};
diff --git a/rateeat_backend/src/services/candidate-item-incentive.service.ts b/rateeat_backend/src/services/candidate-item-incentive.service.ts
new file mode 100644
index 000000000..c4e8fc596
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-item-incentive.service.ts
@@ -0,0 +1,115 @@
+import { Transaction } from "sequelize";
+
+import { CandidateItemUser, Incentive, User } from "../models";
+import { CandidateModerationIncentiveInput } from "../types/candidate-item-moderation.types";
+import {
+  getModerationRewardDelta,
+  transactionLockOptions,
+  transactionOptions,
+} from "../utils/candidate-item-moderation.utils";
+
+export const findCandidateOwnerId = async (
+  itemId: string,
+  transaction?: Transaction
+) => {
+  const candidateOwner = await CandidateItemUser.findOne({
+    where: { item_id: itemId },
+    attributes: ["user_id"],
+    ...transactionOptions(transaction),
+  });
+
+  return candidateOwner?.user_id ?? null;
+};
+
+export const lockCandidateOwnerForIncentiveUpdate = async (
+  ownerId: string,
+  transaction?: Transaction
+) => {
+  if (!transaction) {
+    return;
+  }
+
+  const sequelizeInstance = User.sequelize;
+
+  if (!sequelizeInstance) {
+    await User.findByPk(ownerId, transactionLockOptions(transaction));
+    return;
+  }
+
+  await sequelizeInstance.query(
+    `SELECT id FROM users WHERE id = :ownerId FOR UPDATE`,
+    {
+      replacements: { ownerId },
+      transaction,
+    }
+  );
+};
+
+const findOwnerIncentiveForUpdate = async (
+  ownerId: string,
+  transaction?: Transaction
+) =>
+  Incentive.findOne({
+    where: { user_id: ownerId },
+    ...transactionLockOptions(transaction),
+  });
+
+const createOwnerIncentive = async (
+  ownerId: string,
+  transaction?: Transaction
+) =>
+  Incentive.create(
+    {
+      user_id: ownerId,
+    } as any,
+    transactionOptions(transaction)
+  );
+
+export const loadOrCreateOwnerIncentive = async (
+  ownerId: string,
+  transaction?: Transaction
+) => {
+  const existing = await findOwnerIncentiveForUpdate(ownerId, transaction);
+
+  if (existing) {
+    return existing;
+  }
+
+  return createOwnerIncentive(ownerId, transaction);
+};
+
+export const applyLockedOwnerIncentiveDelta = async (
+  ownerId: string,
+  delta: number,
+  transaction?: Transaction
+) => {
+  if (delta === 0) {
+    return;
+  }
+
+  const incentive = await loadOrCreateOwnerIncentive(ownerId, transaction);
+  incentive.current_total += delta;
+  await incentive.save(transactionOptions(transaction));
+};
+
+export const adjustCandidateOwnerIncentive = async ({
+  itemId,
+  previousApproval,
+  nextApproval,
+  transaction,
+}: CandidateModerationIncentiveInput) => {
+  const ownerId = await findCandidateOwnerId(itemId, transaction);
+
+  if (!ownerId) {
+    return;
+  }
+
+  const delta = getModerationRewardDelta(previousApproval, nextApproval);
+
+  if (delta === 0) {
+    return;
+  }
+
+  await lockCandidateOwnerForIncentiveUpdate(ownerId, transaction);
+  await applyLockedOwnerIncentiveDelta(ownerId, delta, transaction);
+};
diff --git a/rateeat_backend/src/services/candidate-item-media.service.ts b/rateeat_backend/src/services/candidate-item-media.service.ts
new file mode 100644
index 000000000..a83170eb0
