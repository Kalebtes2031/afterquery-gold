@@ -0,0 +1,333 @@
+import { Transaction } from "sequelize";
+
+import { Item } from "../models";
+import { BadRequestError } from "../utils/error-response.utils";
+import {
+  CandidateBatchModerationInput,
+  CandidateModerationInput,
+} from "../types/candidate-item-moderation.types";
+import {
+  assertModerationChangesState,
+  getModerationRewardDelta,
+} from "../utils/candidate-item-moderation.utils";
+import {
+  adjustCandidateOwnerIncentive,
+  applyLockedOwnerIncentiveDelta,
+  findCandidateOwnerId,
+  lockCandidateOwnerForIncentiveUpdate,
+} from "./candidate-item-incentive.service";
+import {
+  loadCandidateWithMedia,
+  persistCandidateMedia,
+} from "./candidate-item-media.service";
+import {
+  approveCandidateCategory,
+  loadCandidateItemForModeration,
+  persistCandidateItemModeration,
+} from "./candidate-item-state.service";
+import {
+  createCandidateBatchModerationNotification,
+} from "./candidate-item-batch-notification.service";
+
+const moderateWithinTransaction = async (
+  input: CandidateModerationInput,
+  transaction?: Transaction
+) => {
+  const candidateItem =
+    await loadCandidateItemForModeration(
+      input.id,
+      transaction
+    );
+
+  const previousApproval =
+    candidateItem.is_approved;
+
+  assertModerationChangesState(
+    previousApproval,
+    input.isApproved
+  );
+
+  await approveCandidateCategory(
+    candidateItem.category_id,
+    transaction
+  );
+
+  await persistCandidateItemModeration({
+    candidateItem,
+    nextApproval: input.isApproved,
+    updateFields: input.updateFields,
+    transaction,
+  });
+
+  await persistCandidateMedia({
+    itemId: candidateItem.id,
+    images: input.mediaImages,
+    videos: input.mediaVideos,
+    transaction,
+  });
+
+  await adjustCandidateOwnerIncentive({
+    itemId: candidateItem.id,
+    previousApproval,
+    nextApproval: input.isApproved,
+    transaction,
+  });
+
+  return loadCandidateWithMedia(
+    candidateItem.id,
+    transaction
+  );
+};
+
+export const moderateCandidateItem = async (
+  input: CandidateModerationInput
+) => {
+  const sequelizeInstance = Item.sequelize;
+
+  if (!sequelizeInstance) {
+    return moderateWithinTransaction(input);
+  }
+
+  return sequelizeInstance.transaction(
+    (transaction) =>
+      moderateWithinTransaction(
+        input,
+        transaction
+      )
+  );
+};
+
+const assertUniqueBatchIds = (
+  input: CandidateBatchModerationInput
+) => {
+  const ids = input.items.map(
+    (item) => item.id
+  );
+
+  if (new Set(ids).size !== ids.length) {
+    throw new BadRequestError(
+      "Duplicate candidate item id"
+    );
+  }
+};
+
+const moderateBatchWithinTransaction = async (
+  input: CandidateBatchModerationInput,
+  transaction: Transaction
+) => {
+  const orderedIds = input.items
+    .map((item) => item.id)
+    .sort();
+
+  const candidatesById =
+    new Map<string, Item>();
+
+  for (const itemId of orderedIds) {
+    const candidate =
+      await loadCandidateItemForModeration(
+        itemId,
+        transaction
+      );
+
+    candidatesById.set(
+      itemId,
+      candidate
+    );
+  }
+
+  /*
+   * Check every transition before we change anything.
+   */
+  for (const requested of input.items) {
+    const candidate =
+      candidatesById.get(requested.id)!;
+
+    assertModerationChangesState(
+      candidate.is_approved,
+      requested.isApproved
+    );
+  }
+
+  /*
+   * Keep category writes deterministic as well.
+   */
+  const categoryIds = Array.from(
+    new Set(
+      orderedIds.map(
+        (id) =>
+          candidatesById.get(id)!
+            .category_id
+      )
+    )
+  ).sort();
+
+  for (const categoryId of categoryIds) {
+    await approveCandidateCategory(
+      categoryId,
+      transaction
+    );
+  }
+
+  /*
+   * Keep the owner for every owned candidate.
+   * We need this even when its reward delta is zero
+   * because an owned moderated candidate still gets
+   * one batch notification.
+   */
+  const ownerByItem =
+    new Map<string, string>();
+
+  const rewardDeltasByOwner =
+    new Map<string, number>();
+
+  for (const requested of input.items) {
+    const candidate =
+      candidatesById.get(requested.id)!;
+
+    const ownerId =
+      await findCandidateOwnerId(
+        candidate.id,
+        transaction
+      );
+
+    if (!ownerId) {
+      continue;
+    }
+
+    ownerByItem.set(
+      candidate.id,
+      ownerId
+    );
+
+    const delta =
+      getModerationRewardDelta(
+        candidate.is_approved,
+        requested.isApproved
+      );
+
+    if (delta !== 0) {
+      rewardDeltasByOwner.set(
+        ownerId,
+        (rewardDeltasByOwner.get(
+          ownerId
+        ) ?? 0) + delta
+      );
+    }
+  }
+
+  /*
+   * Lock owners in a stable order so batches touching
+   * the same owner do not lose incentive updates.
+   */
+  const ownerIds = Array.from(
+    rewardDeltasByOwner.keys()
+  ).sort();
+
+  for (const ownerId of ownerIds) {
+    await lockCandidateOwnerForIncentiveUpdate(
+      ownerId,
+      transaction
+    );
+  }
+
+  /*
+   * Persist candidate state and optional media.
+   */
+  for (const requested of input.items) {
+    const candidate =
+      candidatesById.get(requested.id)!;
+
+    await persistCandidateItemModeration({
+      candidateItem: candidate,
+      nextApproval:
+        requested.isApproved,
+      updateFields: {},
+      transaction,
+    });
+
+    await persistCandidateMedia({
+      itemId: candidate.id,
+      images:
+        requested.mediaImages,
+      videos:
+        requested.mediaVideos,
+      transaction,
+    });
+  }
+
+  /*
+   * Apply aggregated owner reward changes.
+   */
+  for (const ownerId of ownerIds) {
+    await applyLockedOwnerIncentiveDelta(
+      ownerId,
+      rewardDeltasByOwner.get(
+        ownerId
+      )!,
+      transaction
+    );
+  }
+
+  /*
+   * Notifications are ordinary transactional writes.
+   * If this write fails, the entire batch rolls back.
+   */
+  for (const requested of input.items) {
+    const ownerId =
+      ownerByItem.get(requested.id);
+
+    if (!ownerId) {
+      continue;
+    }
+
+    await createCandidateBatchModerationNotification({
+      itemId: requested.id,
+      ownerId,
+      isApproved:
+        requested.isApproved,
+      transaction,
+    });
+  }
+
+  /*
+   * Preserve request ordering.
+   */
+  const finalItems = [];
+
+  for (const requested of input.items) {
+    finalItems.push(
+      await loadCandidateWithMedia(
+        requested.id,
+        transaction
+      )
+    );
+  }
+
+  return finalItems;
+};
+
+export const moderateCandidateItemsBatch =
+  async (
+    input: CandidateBatchModerationInput
+  ) => {
+    assertUniqueBatchIds(input);
+
+    const sequelizeInstance =
+      Item.sequelize;
+
+    if (!sequelizeInstance) {
+      throw new Error(
+        "Candidate item batch moderation requires a database transaction"
+      );
+    }
+
+    return sequelizeInstance.transaction(
+      (transaction) =>
+        moderateBatchWithinTransaction(
+          input,
+          transaction
+        )
+    );
+  };
+
+export default moderateCandidateItem;
diff --git a/rateeat_backend/src/services/candidate-item-state.service.ts b/rateeat_backend/src/services/candidate-item-state.service.ts
