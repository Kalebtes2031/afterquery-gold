@@ -0,0 +1,102 @@
+import { Transaction } from "sequelize";
+
+import { Item, ItemImage, ItemVideo } from "../models";
+import { CANDIDATE_ITEM_MEDIA_ATTRIBUTES } from "../constants/candidate-item-moderation.constants";
+import {
+  CandidateMediaImageInput,
+  CandidateModerationMediaInput,
+} from "../types/candidate-item-moderation.types";
+import { transactionOptions } from "../utils/candidate-item-moderation.utils";
+
+const createCandidateImage = async (
+  itemId: string,
+  image: CandidateMediaImageInput,
+  transaction?: Transaction
+) =>
+  ItemImage.create(
+    {
+      url: image.highQualityImg,
+      low_quality_url: image.lowQualityImg,
+      medium_quality_url: image.mediumQualityImg,
+      high_quality_url: image.highQualityImg,
+      item_id: itemId,
+    } as any,
+    transactionOptions(transaction)
+  );
+
+const createCandidateVideo = async (
+  itemId: string,
+  videoUrl: string,
+  transaction?: Transaction
+) =>
+  ItemVideo.create(
+    {
+      url: videoUrl,
+      item_id: itemId,
+    } as any,
+    transactionOptions(transaction)
+  );
+
+export const replaceCandidateImages = async (
+  itemId: string,
+  images: CandidateMediaImageInput[],
+  transaction?: Transaction
+) => {
+  await ItemImage.destroy({
+    where: { item_id: itemId },
+    ...transactionOptions(transaction),
+  });
+
+  for (const image of images) {
+    await createCandidateImage(itemId, image, transaction);
+  }
+};
+
+export const replaceCandidateVideos = async (
+  itemId: string,
+  videos: string[],
+  transaction?: Transaction
+) => {
+  await ItemVideo.destroy({
+    where: { item_id: itemId },
+    ...transactionOptions(transaction),
+  });
+
+  for (const video of videos) {
+    await createCandidateVideo(itemId, video, transaction);
+  }
+};
+
+export const persistCandidateMedia = async ({
+  itemId,
+  images,
+  videos,
+  transaction,
+}: CandidateModerationMediaInput) => {
+  if (images) {
+    await replaceCandidateImages(itemId, images, transaction);
+  }
+
+  if (videos) {
+    await replaceCandidateVideos(itemId, videos, transaction);
+  }
+};
+
+export const loadCandidateWithMedia = async (
+  itemId: string,
+  transaction?: Transaction
+) =>
+  Item.findOne({
+    where: { id: itemId },
+    include: [
+      {
+        model: ItemImage,
+        attributes: [...CANDIDATE_ITEM_MEDIA_ATTRIBUTES],
+      },
+      {
+        model: ItemVideo,
+        attributes: [...CANDIDATE_ITEM_MEDIA_ATTRIBUTES],
+      },
+    ],
+    ...transactionOptions(transaction),
+  });
diff --git a/rateeat_backend/src/services/candidate-item-moderation.service.ts b/rateeat_backend/src/services/candidate-item-moderation.service.ts
