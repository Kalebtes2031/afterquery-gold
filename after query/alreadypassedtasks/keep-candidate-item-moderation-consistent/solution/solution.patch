diff --git a/rateeat_backend/src/utils/candidate-item-moderation.utils.ts b/rateeat_backend/src/utils/candidate-item-moderation.utils.ts
new file mode 100644
index 000000000..4fbd986fa
--- /dev/null
+++ b/rateeat_backend/src/utils/candidate-item-moderation.utils.ts
@@ -0,0 +1,110 @@
+import { Transaction } from "sequelize";
+
+import {
+  CANDIDATE_ITEM_ALREADY_APPROVED,
+  CANDIDATE_ITEM_ALREADY_REJECTED,
+  CANDIDATE_ITEM_APPROVAL_REWARD,
+} from "../constants/candidate-item-moderation.constants";
+import {
+  CandidateApprovalState,
+  CandidateItemUpdateFields,
+  CandidateModerationTransition,
+} from "../types/candidate-item-moderation.types";
+import { BadRequestError } from "./error-response.utils";
+
+export const parseCandidateApprovalValue = (value: unknown): boolean => {
+  if (typeof value === "boolean") {
+    return value;
+  }
+
+  if (typeof value === "string") {
+    const normalized = value.trim();
+
+    if (normalized === "true") {
+      return true;
+    }
+
+    if (normalized === "false") {
+      return false;
+    }
+  }
+
+  return JSON.parse(String(value));
+};
+
+export const getRepeatedModerationMessage = (approval: boolean) =>
+  approval
+    ? CANDIDATE_ITEM_ALREADY_APPROVED
+    : CANDIDATE_ITEM_ALREADY_REJECTED;
+
+export const assertModerationChangesState = (
+  previousApproval: CandidateApprovalState,
+  nextApproval: boolean
+) => {
+  if (previousApproval === nextApproval) {
+    throw new BadRequestError(getRepeatedModerationMessage(nextApproval));
+  }
+};
+
+export const getModerationTransition = (
+  previousApproval: CandidateApprovalState,
+  nextApproval: boolean
+): CandidateModerationTransition => {
+  if (previousApproval === true && nextApproval === false) {
+    return "approved-to-rejected";
+  }
+
+  if (previousApproval === false && nextApproval === true) {
+    return "rejected-to-approved";
+  }
+
+  if (previousApproval === null && nextApproval === true) {
+    return "pending-to-approved";
+  }
+
+  return "pending-to-rejected";
+};
+
+export const getModerationRewardDelta = (
+  previousApproval: CandidateApprovalState,
+  nextApproval: boolean
+) => {
+  const transition = getModerationTransition(previousApproval, nextApproval);
+
+  if (
+    transition === "pending-to-approved" ||
+    transition === "rejected-to-approved"
+  ) {
+    return CANDIDATE_ITEM_APPROVAL_REWARD;
+  }
+
+  if (transition === "approved-to-rejected") {
+    return -CANDIDATE_ITEM_APPROVAL_REWARD;
+  }
+
+  return 0;
+};
+
+export const withoutModerationControlFields = (
+  updateFields: CandidateItemUpdateFields
+) => {
+  const { isApproved: _isApproved, ...persistedFields } = updateFields;
+  return persistedFields;
+};
+
+export const transactionOptions = (transaction?: Transaction) =>
+  transaction ? { transaction } : {};
+
+export const transactionLockOptions = (transaction?: Transaction) =>
+  transaction
+    ? {
+        transaction,
+        lock: transaction.LOCK.UPDATE,
+      }
+    : {};
+
+export const shouldReplaceImages = (images: unknown): images is unknown[] =>
+  Array.isArray(images);
+
+export const shouldReplaceVideos = (videos: unknown): videos is unknown[] =>
+  Array.isArray(videos);