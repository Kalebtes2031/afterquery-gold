+++ b/rateeat_backend/src/__tests__/unit/waitlist_otp_send_behavior.test.ts
@@ -0,0 +1,455 @@
+jest.mock("../../utils/whatsapp.utils", () => ({
+  sendWhatsAppOTP: jest.fn(),
+}));
+
+jest.mock("../../utils/telegram.utils", () => ({
+  sendTelegramMessage: jest.fn(),
+}));
+
+import { sendWhatsAppOTP } from "../../utils/whatsapp.utils";
+import { sendTelegramMessage } from "../../utils/telegram.utils";
+import {
+  cleanWaitlistOtpTables,
+  concurrent,
+  createOtp,
+  createWaitlist,
+  db,
+  expectUnverifiedWaitlist,
+  gate,
+  otpState,
+  pause,
+  registerAgain,
+  sendOtp,
+  setOtpCounters,
+  uniquePhone,
+} from "./waitlist_otp_test_support";
+
+const whatsapp = sendWhatsAppOTP as jest.MockedFunction<
+  typeof sendWhatsAppOTP
+>;
+const telegram = sendTelegramMessage as jest.MockedFunction<
+  typeof sendTelegramMessage
+>;
+
+describe("durable waitlist OTP send behavior", () => {
+  beforeAll(async () => {
+    await db();
+  });
+
+  beforeEach(async () => {
+    await cleanWaitlistOtpTables();
+    whatsapp.mockReset();
+    telegram.mockReset();
+    whatsapp.mockResolvedValue(undefined);
+    telegram.mockResolvedValue(undefined as any);
+  });
+
+  it("keeps the existing missing-phone response", async () => {
+    const response = await sendOtp();
+    expect(response.status).toBe(400);
+    expect(response.body.message).toBe("Phone is required");
+  });
+
+  it("keeps the existing unknown-phone response", async () => {
+    const phone = uniquePhone();
+    const response = await sendOtp(phone);
+    expect(response.status).toBe(404);
+    expect(response.body.message).toBe("Phone not found on waitlist");
+  });
+
+  it("keeps the successful development response and sends the generated code", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+
+    const response = await sendOtp(phone);
+
+    expect(response.status).toBe(200);
+    expect(response.body.message).toBe("OTP sent");
+    expect(response.body.otp).toMatch(/^\d{6}$/);
+    expect(Object.keys(response.body).sort()).toEqual(["message", "otp"]);
+    expect(whatsapp).toHaveBeenCalledTimes(1);
+    expect(whatsapp).toHaveBeenCalledWith(phone, response.body.otp);
+  });
+
+  it("stores the first send count, method, timestamp, and expiry in PostgreSQL", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+
+    const response = await sendOtp(phone);
+    expect(response.status).toBe(200);
+
+    const state = await otpState(phone);
+    expect(state).not.toBeNull();
+    expect(state?.phoneOtpCode).toBe(response.body.otp);
+    expect(state?.resendCount).toBe(1);
+    expect(state?.attempts).toBe(0);
+    expect(state?.method).toBe("whatsapp");
+    expect(state?.lastSentAt).not.toBeNull();
+    expect(state?.expiresAt).not.toBeNull();
+    expect(state!.expiresAt!.getTime()).toBeGreaterThan(Date.now());
+  });
+
+  it("increments the persisted resend count and resets attempts for a fresh code", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "111111", { attempts: 2, resendCount: 1 });
+
+    const response = await sendOtp(phone);
+    expect(response.status).toBe(200);
+
+    const state = await otpState(phone);
+    expect(state?.phoneOtpCode).toBe(response.body.otp);
+    expect(state?.phoneOtpCode).not.toBe("111111");
+    expect(state?.resendCount).toBe(2);
+    expect(state?.attempts).toBe(0);
+  });
+
+  it("enforces the resend limit from the stored row without any process history", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "222222", { attempts: 0, resendCount: 3 });
+
+    const response = await sendOtp(phone);
+
+    expect(response.status).toBe(429);
+    expect(response.body.message).toBe("Max resend attempts reached");
+    expect(whatsapp).not.toHaveBeenCalled();
+    expect((await otpState(phone))?.phoneOtpCode).toBe("222222");
+    expect((await otpState(phone))?.resendCount).toBe(3);
+  });
+
+  it("reports persisted resend and verification counts for an active registration", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "333333", { attempts: 2, resendCount: 3 });
+
+    const response = await registerAgain(phone);
+
+    expect(response.status).toBe(409);
+    expect(response.body).toMatchObject({
+      message:
+        "You have an active pending WhatsApp registration. OTP already sent.",
+      resendAttempts: 3,
+      verificationAttempts: 2,
+    });
+  });
+
+  it("rolls back a first OTP and keeps the waitlist entry when delivery fails", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    whatsapp.mockRejectedValueOnce(new Error("provider unavailable"));
+
+    const response = await sendOtp(phone);
+
+    expect(response.status).toBe(500);
+    expect(response.body.message).toBe("Error sending verification");
+    expect(await otpState(phone)).toBeNull();
+    await expectUnverifiedWaitlist(phone);
+  });
+
+  it("restores the previous usable OTP and counters when replacement delivery fails", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "444444", {
+      attempts: 2,
+      resendCount: 1,
+      method: "whatsapp",
+    });
+    const before = await otpState(phone);
+
+    whatsapp.mockRejectedValueOnce(new Error("provider unavailable"));
+    const response = await sendOtp(phone);
+
+    expect(response.status).toBe(500);
+    expect(response.body.message).toBe("Error sending verification");
+
+    const after = await otpState(phone);
+    expect(after?.phoneOtpCode).toBe("444444");
+    expect(after?.attempts).toBe(2);
+    expect(after?.resendCount).toBe(1);
+    expect(after?.method).toBe(before?.method);
+    expect(after?.expiresAt?.getTime()).toBe(before?.expiresAt?.getTime());
+    await expectUnverifiedWaitlist(phone);
+  });
+
+  it("uses the stored method when the request does not override it", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone, "telegram");
+
+    const response = await sendOtp(phone, { telegramChatId: "gold-chat-1" });
+
+    expect(response.status).toBe(200);
+    expect(telegram).toHaveBeenCalledTimes(1);
+    expect(telegram).toHaveBeenCalledWith("gold-chat-1", response.body.otp);
+    expect(whatsapp).not.toHaveBeenCalled();
+    expect((await otpState(phone))?.method).toBe("telegram");
+  });
+
+  it("keeps a failed Telegram delivery inside the same rollback boundary", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone, "telegram");
+    telegram.mockRejectedValueOnce(new Error("telegram unavailable"));
+
+    const response = await sendOtp(phone, { telegramChatId: "gold-chat-2" });
+
+    expect(response.status).toBe(500);
+    expect(response.body.message).toBe("Error sending verification");
+    expect(await otpState(phone)).toBeNull();
+    await expectUnverifiedWaitlist(phone);
+  });
+
+  it("serializes three simultaneous sends for one phone without losing resend increments", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    whatsapp.mockImplementation(async () => {
+      await pause(75);
+    });
+
+    const responses = await concurrent([
+      () => sendOtp(phone),
+      () => sendOtp(phone),
+      () => sendOtp(phone),
+    ]);
+
+    expect(responses.map((response) => response.status)).toEqual([200, 200, 200]);
+    expect(whatsapp).toHaveBeenCalledTimes(3);
+    expect((await otpState(phone))?.resendCount).toBe(3);
+    expect((await otpState(phone))?.attempts).toBe(0);
+  });
+
+  it("allows only one overlapping send when the durable resend count starts at two", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "555555", { resendCount: 2, attempts: 1 });
+    whatsapp.mockImplementation(async () => {
+      await pause(75);
+    });
+
+    const responses = await concurrent([
+      () => sendOtp(phone),
+      () => sendOtp(phone),
+    ]);
+
+    expect(responses.map((response) => response.status).sort()).toEqual([200, 429]);
+    expect(whatsapp).toHaveBeenCalledTimes(1);
+    expect((await otpState(phone))?.resendCount).toBe(3);
+    expect((await otpState(phone))?.attempts).toBe(0);
+  });
+
+  it("keeps counters independent for different phones", async () => {
+    const first = uniquePhone();
+    const second = uniquePhone();
+    await createWaitlist(first);
+    await createWaitlist(second);
+    whatsapp.mockImplementation(async () => {
+      await pause(40);
+    });
+
+    const responses = await concurrent([
+      () => sendOtp(first),
+      () => sendOtp(second),
+    ]);
+
+    expect(responses.every((response) => response.status === 200)).toBe(true);
+    expect((await otpState(first))?.resendCount).toBe(1);
+    expect((await otpState(second))?.resendCount).toBe(1);
+  });
+
+  it("rejects negative verification attempts at the database boundary", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "666666");
+
+    await expect(setOtpCounters(phone, -1, 0)).rejects.toThrow();
+  });
+
+  it("rejects verification attempts above the supported maximum at the database boundary", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "676767");
+
+    await expect(setOtpCounters(phone, 4, 0)).rejects.toThrow();
+  });
+
+  it("rejects a negative resend count at the database boundary", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "686868");
+
+    await expect(setOtpCounters(phone, 0, -1)).rejects.toThrow();
+  });
+
+  it("rejects a resend count above the supported maximum at the database boundary", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "777777");
+
+    await expect(setOtpCounters(phone, 0, 4)).rejects.toThrow();
+  });
+
+  it("starts a fresh resend cycle after the stored OTP expires", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "818181", {
+      attempts: 3,
+      resendCount: 3,
+      expiresAt: new Date(Date.now() - 60_000),
+    });
+
+    const response = await sendOtp(phone);
+
+    expect(response.status).toBe(200);
+
+    const state = await otpState(phone);
+    expect(state?.phoneOtpCode).toBe(response.body.otp);
+    expect(state?.phoneOtpCode).not.toBe("818181");
+    expect(state?.resendCount).toBe(1);
+    expect(state?.attempts).toBe(0);
+    expect(state?.expiresAt?.getTime()).toBeGreaterThan(Date.now());
+  });
+
+  it("restores an expired OTP row when delivery of its replacement fails", async () => {
+    const phone = uniquePhone();
+    await createWaitlist(phone);
+    await createOtp(phone, "828282", {
+      attempts: 3,
+      resendCount: 3,
+      method: "whatsapp",
+      expiresAt: new Date(Date.now() - 60_000),
+    });
+
+    const before = await otpState(phone);
+
+    whatsapp.mockRejectedValueOnce(
+      new Error("provider unavailable")
+    );
+
+    const response = await sendOtp(phone);
+
+    expect(response.status).toBe(500);
+    expect(response.body.message).toBe(
+      "Error sending verification"
+    );
+
+    const after = await otpState(phone);
+
+    expect(after?.phoneOtpCode).toBe("828282");
+    expect(after?.attempts).toBe(3);
+    expect(after?.resendCount).toBe(3);
+    expect(after?.method).toBe(before?.method);
+    expect(after?.expiresAt?.getTime()).toBe(
+      before?.expiresAt?.getTime()
+    );
+
+    await expectUnverifiedWaitlist(phone);
+  });
+
+  it("reports the committed counters when registration overlaps a resend", async () => {
+    const phone = uniquePhone();
+
+    await createWaitlist(phone);
+
+    await createOtp(phone, "838383", {
+      attempts: 2,
+      resendCount: 1,
+    });
+
+    const deliveryEntered = gate();
+    const releaseDelivery = gate();
+
+    whatsapp.mockImplementationOnce(async () => {
+      deliveryEntered.release();
+      await releaseDelivery.promise;
+    });
+
+    const sendPromise = sendOtp(phone).then(
+      (response) => response
+    );
+
+    await deliveryEntered.promise;
+
+    const registrationPromise = registerAgain(phone).then(
+      (response) => response
+    );
+
+    await pause(30);
+
+    releaseDelivery.release();
+
+    const [sendResponse, registrationResponse] =
+      await Promise.all([
+        sendPromise,
+        registrationPromise,
+      ]);
+
+    expect(sendResponse.status).toBe(200);
+    expect(registrationResponse.status).toBe(409);
+
+    expect(
+      registrationResponse.body.resendAttempts
+    ).toBe(2);
+
+    expect(
+      registrationResponse.body.verificationAttempts
+    ).toBe(0);
+
+    const state = await otpState(phone);
+
+    expect(state?.resendCount).toBe(2);
+    expect(state?.attempts).toBe(0);
+  });
+
+  it("does not let a slow delivery for one phone block another phone", async () => {
+    const slowPhone = uniquePhone();
+    const otherPhone = uniquePhone();
+
+    await createWaitlist(slowPhone);
+    await createWaitlist(otherPhone);
+
+    const deliveryEntered = gate();
+    const releaseDelivery = gate();
+
+    whatsapp.mockImplementationOnce(async () => {
+      deliveryEntered.release();
+      await releaseDelivery.promise;
+    });
+
+    whatsapp.mockResolvedValueOnce(undefined);
+
+    const slowPromise = sendOtp(slowPhone).then(
+      (response) => response
+    );
+
+    await deliveryEntered.promise;
+
+    const otherPromise = sendOtp(otherPhone).then(
+      (response) => response
+    );
+
+    const otherFinishedBeforeRelease =
+      await Promise.race([
+        otherPromise.then(() => true),
+        pause(600).then(() => false),
+      ]);
+
+    releaseDelivery.release();
+
+    const [slowResponse, otherResponse] =
+      await Promise.all([
+        slowPromise,
+        otherPromise,
+      ]);
+
+    expect(otherFinishedBeforeRelease).toBe(true);
+    expect(slowResponse.status).toBe(200);
+    expect(otherResponse.status).toBe(200);
+
+    expect(
+      (await otpState(slowPhone))?.resendCount
+    ).toBe(1);
+
+    expect(
+      (await otpState(otherPhone))?.resendCount
+    ).toBe(1);
+  });
+});
