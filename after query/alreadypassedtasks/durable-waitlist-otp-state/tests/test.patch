@@ -0,0 +1,317 @@
+import express from "express";
+import request from "supertest";
+import { QueryTypes, Sequelize } from "sequelize";
+
+import Database from "../db_setup";
+import { errorHandler } from "../../middlewares/error-handler";
+import {
+  registerWaitlist,
+  sendWaitlistOtp,
+  verifyWaitlistOtp,
+} from "../../controllers/waitlist.controller";
+import { PhoneOtp, Waitlist, PendingVerification } from "../../models";
+
+export const app = express();
+app.use(express.json());
+app.post("/api/v1/waitlist/register", registerWaitlist);
+app.post("/api/v1/waitlist/send-otp", sendWaitlistOtp);
+app.post("/api/v1/waitlist/verify-otp", verifyWaitlistOtp);
+app.use(errorHandler);
+
+let phoneSequence = 100000000;
+
+export const uniquePhone = (): string => {
+  phoneSequence += 1;
+  return `+250${String(phoneSequence).padStart(9, "0").slice(-9)}`;
+};
+
+export const db = async (): Promise<Sequelize> => Database.getInstance();
+
+export const cleanWaitlistOtpTables = async (): Promise<void> => {
+  await PendingVerification.destroy({ where: {} });
+  await PhoneOtp.destroy({ where: {} });
+  await Waitlist.destroy({ where: {} });
+};
+
+export const createWaitlist = async (
+  phone: string,
+  method: "whatsapp" | "telegram" = "whatsapp"
+): Promise<Waitlist> =>
+  Waitlist.create({
+    user_type: "Eater",
+    phone,
+    name: "Gold Waitlist User",
+    email: `${phone.replace(/\D/g, "")}@example.com`,
+    location: "Kigali",
+    preferences: "quiet tables",
+    privacy_consent: true,
+    method,
+    verified: false,
+  } as any);
+
+export const sendOtp = (
+  phone?: string,
+  overrides: Record<string, unknown> = {}
+) =>
+  request(app)
+    .post("/api/v1/waitlist/send-otp")
+    .send({
+      ...(phone ? { phone } : {}),
+      ...overrides,
+    });
+
+export const verifyOtp = (phone?: string, otp?: string) =>
+  request(app)
+    .post("/api/v1/waitlist/verify-otp")
+    .send({
+      ...(phone ? { phone } : {}),
+      ...(otp ? { otp } : {}),
+    });
+
+export const registerAgain = (phone: string) =>
+  request(app)
+    .post("/api/v1/waitlist/register")
+    .send({
+      userType: "Eater",
+      phone,
+      name: "Gold Waitlist User",
+      method: "whatsapp",
+    });
+
+export interface PersistedOtpState {
+  phoneOtpCode: string;
+  attempts: number;
+  resendCount: number;
+  method: string | null;
+  expiresAt: Date | null;
+  lastSentAt: Date | null;
+}
+
+export const otpState = async (
+  phone: string
+): Promise<PersistedOtpState | null> => {
+  const sequelize = await db();
+  const rows = await sequelize.query<any>(
+    `SELECT
+       "phoneOtpCode",
+       attempts,
+       resend_count AS "resendCount",
+       method,
+       expires_at AS "expiresAt",
+       last_sent_at AS "lastSentAt"
+     FROM phone_otps
+     WHERE "phoneNumber" = :phone`,
+    {
+      replacements: { phone },
+      type: QueryTypes.SELECT,
+    }
+  );
+
+  if (!rows.length) return null;
+
+  const row = rows[0];
+  return {
+    phoneOtpCode: String(row.phoneOtpCode),
+    attempts: Number(row.attempts),
+    resendCount: Number(row.resendCount),
+    method: row.method ?? null,
+    expiresAt: row.expiresAt ? new Date(row.expiresAt) : null,
+    lastSentAt: row.lastSentAt ? new Date(row.lastSentAt) : null,
+  };
+};
+
+export const createOtp = async (
+  phone: string,
+  code = "123456",
+  options: {
+    attempts?: number;
+    resendCount?: number;
+    method?: string;
+    expiresAt?: Date;
+  } = {}
+): Promise<void> => {
+  const expiresAt =
+    options.expiresAt || new Date(Date.now() + 10 * 60 * 1000);
+
+  await PhoneOtp.create({
+    phoneNumber: phone,
+    phoneOtpCode: code,
+    expires_at: expiresAt,
+  } as any);
+
+  const sequelize = await db();
+  await sequelize.query(
+    `UPDATE phone_otps
+     SET attempts = :attempts,
+         resend_count = :resendCount,
+         method = :method,
+         last_sent_at = NOW()
+     WHERE "phoneNumber" = :phone`,
+    {
+      replacements: {
+        phone,
+        attempts: options.attempts ?? 0,
+        resendCount: options.resendCount ?? 0,
+        method: options.method || "whatsapp",
+      },
+    }
+  );
+};
+
+export const setOtpCounters = async (
+  phone: string,
+  attempts: number,
+  resendCount: number
+): Promise<void> => {
+  const sequelize = await db();
+  await sequelize.query(
+    `UPDATE phone_otps
+     SET attempts = :attempts,
+         resend_count = :resendCount
+     WHERE "phoneNumber" = :phone`,
+    { replacements: { phone, attempts, resendCount } }
+  );
+};
+
+const safeIdent = (value: string): string => {
+  if (!/^[a-zA-Z0-9_]+$/.test(value)) {
+    throw new Error(`Unsafe identifier: ${value}`);
+  }
+  return `"${value}"`;
+};
+
+let failureSequence = 0;
+
+export const rejectDatabaseWrite = async (
+  table: "phone_otps" | "waitlists",
+  operation: "INSERT" | "UPDATE" | "DELETE"
+): Promise<() => Promise<void>> => {
+  const sequelize = await db();
+  failureSequence += 1;
+  const suffix = `${Date.now()}_${failureSequence}`;
+  const fn = `gold_waitlist_fail_fn_${suffix}`;
+  const trigger = `gold_waitlist_fail_trg_${suffix}`;
+
+  await sequelize.query(`
+    CREATE FUNCTION ${safeIdent(fn)}()
+    RETURNS trigger AS $$
+    BEGIN
+      RAISE EXCEPTION 'forced waitlist otp write failure';
+    END;
+    $$ LANGUAGE plpgsql;
+  `);
+
+  await sequelize.query(`
+    CREATE TRIGGER ${safeIdent(trigger)}
+    BEFORE ${operation} ON ${safeIdent(table)}
+    FOR EACH ROW
+    EXECUTE FUNCTION ${safeIdent(fn)}();
+  `);
+
+  return async () => {
+    await sequelize.query(
+      `DROP TRIGGER IF EXISTS ${safeIdent(trigger)} ON ${safeIdent(table)}`
+    );
+    await sequelize.query(`DROP FUNCTION IF EXISTS ${safeIdent(fn)}()`);
+  };
+};
+
+let delaySequence = 0;
+
+export const delayDatabaseWrite = async (
+  table: "phone_otps" | "waitlists",
+  operation: "INSERT" | "UPDATE" | "DELETE",
+  milliseconds: number
+): Promise<() => Promise<void>> => {
+  if (
+    !Number.isInteger(milliseconds) ||
+    milliseconds < 1 ||
+    milliseconds > 5_000
+  ) {
+    throw new Error("Invalid database delay");
+  }
+
+  const sequelize = await db();
+  delaySequence += 1;
+
+  const suffix = `${Date.now()}_${delaySequence}`;
+  const fn = `gold_waitlist_delay_fn_${suffix}`;
+  const trigger = `gold_waitlist_delay_trg_${suffix}`;
+  const seconds = milliseconds / 1000;
+
+  await sequelize.query(`
+    CREATE FUNCTION ${safeIdent(fn)}()
+    RETURNS trigger AS $$
+    BEGIN
+      PERFORM pg_sleep(${seconds});
+
+      IF TG_OP = 'DELETE' THEN
+        RETURN OLD;
+      END IF;
+
+      RETURN NEW;
+    END;
+    $$ LANGUAGE plpgsql;
+  `);
+
+  await sequelize.query(`
+    CREATE TRIGGER ${safeIdent(trigger)}
+    BEFORE ${operation} ON ${safeIdent(table)}
+    FOR EACH ROW
+    EXECUTE FUNCTION ${safeIdent(fn)}();
+  `);
+
+  return async () => {
+    await sequelize.query(
+      `DROP TRIGGER IF EXISTS ${safeIdent(trigger)}
+       ON ${safeIdent(table)}`
+    );
+
+    await sequelize.query(
+      `DROP FUNCTION IF EXISTS ${safeIdent(fn)}()`
+    );
+  };
+};
+
+export const waitlistState = async (phone: string) => {
+  const row = await Waitlist.findOne({ where: { phone } });
+  if (!row) return null;
+  return {
+    verified: Boolean(row.verified),
+    verifiedAt: row.verified_at ? new Date(row.verified_at) : null,
+  };
+};
+
+export const expectUnverifiedWaitlist = async (phone: string) => {
+  const state = await waitlistState(phone);
+  expect(state).not.toBeNull();
+  expect(state?.verified).toBe(false);
+  expect(state?.verifiedAt).toBeNull();
+};
+
+export const expectVerifiedWaitlist = async (phone: string) => {
+  const state = await waitlistState(phone);
+  expect(state).not.toBeNull();
+  expect(state?.verified).toBe(true);
+  expect(state?.verifiedAt).not.toBeNull();
+};
+
+export const concurrent = async <T>(
+  actions: Array<() => Promise<T>>
+): Promise<T[]> => Promise.all(actions.map((action) => action()));
+
+export const gate = () => {
+  let release!: () => void;
+
+  const promise = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+
+  return {
+    promise,
+    release,
+  };
+};
+
+export const pause = (ms: number): Promise<void> =>
+  new Promise((resolve) => setTimeout(resolve, ms));
