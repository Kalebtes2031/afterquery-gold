new file mode 100644
index 000000000..a3bc2f7c5
--- /dev/null
+++ b/rateeat_backend/src/types/waitlist-otp.types.ts
@@ -0,0 +1,46 @@
+export type WaitlistOtpMethod = "whatsapp" | "telegram" | string;
+
+export type WaitlistOtpDelivery = (
+  phone: string,
+  otp: string,
+  method: WaitlistOtpMethod,
+  telegramChatId?: string
+) => Promise<void>;
+
+export interface IssueWaitlistOtpInput {
+  phone: string;
+  method?: WaitlistOtpMethod;
+  telegramChatId?: string;
+  deliver: WaitlistOtpDelivery;
+}
+
+export interface IssuedWaitlistOtp {
+  otp: string;
+  method: WaitlistOtpMethod;
+  expiresAt: Date;
+  resendCount: number;
+}
+
+export interface WaitlistOtpCounters {
+  resendCount: number;
+  verificationAttempts: number;
+}
+
+export type WaitlistOtpVerificationFailure = {
+  ok: false;
+  status: 401 | 404 | 429;
+  message:
+    | "Phone not found on waitlist"
+    | "OTP is not correct"
+    | "OTP expired"
+    | "Max verification attempts reached";
+};
+
+export type WaitlistOtpVerificationSuccess = {
+  ok: true;
+  verifiedAt: Date;
+};
+
+export type WaitlistOtpVerificationResult =
+  | WaitlistOtpVerificationFailure
+  | WaitlistOtpVerificationSuccess;
diff --git a/rateeat_backend/src/utils/waitlist-otp-state.utils.ts b/rateeat_backend/src/utils/waitlist-otp-state.utils.ts
new file mode 100644
index 000000000..e25126461
--- /dev/null
+++ b/rateeat_backend/src/utils/waitlist-otp-state.utils.ts
@@ -0,0 +1,124 @@
+import { PhoneOtp } from "../models";
+import { WaitlistOtpMethod } from "../types/waitlist-otp.types";
+import {
+  durableCount,
+  WAITLIST_OTP_MAX_ATTEMPTS,
+  WAITLIST_OTP_MAX_RESENDS,
+  waitlistOtpExpiry,
+  isExpiredWaitlistOtp,
+} from "./waitlist-otp.utils";
+
+export interface WaitlistOtpIssueState {
+  phoneOtpCode: string;
+  expiresAt: Date;
+  attempts: number;
+  resendCount: number;
+  method: WaitlistOtpMethod;
+  lastSentAt: Date;
+}
+
+export const WAITLIST_OTP_ISSUE_FIELDS: (keyof PhoneOtp)[] = [
+  "phoneOtpCode",
+  "expires_at",
+  "attempts",
+  "resend_count",
+  "method",
+  "last_sent_at",
+  "verified",
+  "verified_at",
+  "updatedAt",
+];
+
+export const WAITLIST_OTP_ATTEMPT_FIELDS: (keyof PhoneOtp)[] = [
+  "attempts",
+  "updatedAt",
+];
+
+export const persistedResendCount = (otpRow: PhoneOtp | null): number =>
+  durableCount(otpRow?.get("resend_count"));
+
+export const persistedVerificationAttempts = (
+  otpRow: PhoneOtp | null
+): number => durableCount(otpRow?.get("attempts"));
+
+export interface WaitlistOtpCounterSnapshot {
+  resendCount: number;
+  verificationAttempts: number;
+}
+
+export const persistedWaitlistOtpCounters = (
+  otpRow: PhoneOtp | null
+): WaitlistOtpCounterSnapshot => ({
+  resendCount: persistedResendCount(otpRow),
+  verificationAttempts: persistedVerificationAttempts(otpRow),
+});
+
+export const canResendWaitlistOtp = (
+  otpRow: PhoneOtp | null
+): boolean =>
+  !otpRow ||
+  isExpiredWaitlistOtp(otpRow.expires_at) ||
+  persistedResendCount(otpRow) < WAITLIST_OTP_MAX_RESENDS;
+
+export const canAttemptWaitlistOtpVerification = (
+  otpRow: PhoneOtp | null
+): boolean => persistedVerificationAttempts(otpRow) < WAITLIST_OTP_MAX_ATTEMPTS;
+
+export const nextWaitlistOtpResendCount = (
+  otpRow: PhoneOtp | null
+): number =>
+  otpRow && isExpiredWaitlistOtp(otpRow.expires_at)
+    ? 1
+    : persistedResendCount(otpRow) + 1;
+
+export const nextWaitlistOtpVerificationAttempt = (otpRow: PhoneOtp): number =>
+  persistedVerificationAttempts(otpRow) + 1;
+
+export const buildWaitlistOtpIssueState = (
+  otpRow: PhoneOtp | null,
+  otp: string,
+  method: WaitlistOtpMethod,
+  now: Date = new Date()
+): WaitlistOtpIssueState => {
+  const nextResendCount = nextWaitlistOtpResendCount(otpRow);
+
+  if (nextResendCount < 1 || nextResendCount > WAITLIST_OTP_MAX_RESENDS) {
+    throw new RangeError("Waitlist OTP resend count is outside its supported range");
+  }
+
+  return {
+    phoneOtpCode: otp,
+    expiresAt: waitlistOtpExpiry(now),
+    attempts: 0,
+    resendCount: nextResendCount,
+    method,
+    lastSentAt: now,
+  };
+};
+
+export const applyWaitlistOtpIssueState = (
+  otpRow: PhoneOtp,
+  state: WaitlistOtpIssueState
+): void => {
+  otpRow.set("phoneOtpCode", state.phoneOtpCode);
+  otpRow.set("expires_at", state.expiresAt);
+  otpRow.set("attempts", state.attempts);
+  otpRow.set("resend_count", state.resendCount);
+  otpRow.set("method", state.method);
+  otpRow.set("last_sent_at", state.lastSentAt);
+  otpRow.set("verified", false);
+  otpRow.set("verified_at", null);
+};
+
+export const recordFailedWaitlistOtpAttempt = (otpRow: PhoneOtp): number => {
+  const nextAttempt = nextWaitlistOtpVerificationAttempt(otpRow);
+
+  if (nextAttempt < 1 || nextAttempt > WAITLIST_OTP_MAX_ATTEMPTS) {
+    throw new RangeError(
+      "Waitlist OTP verification attempts are outside their supported range"
+    );
+  }
+
+  otpRow.set("attempts", nextAttempt);
+  return nextAttempt;
+};
diff --git a/rateeat_backend/src/utils/waitlist-otp.utils.ts b/rateeat_backend/src/utils/waitlist-otp.utils.ts
new file mode 100644
index 000000000..bfdfa738c
--- /dev/null
+++ b/rateeat_backend/src/utils/waitlist-otp.utils.ts
@@ -0,0 +1,40 @@
+import { WaitlistOtpMethod } from "../types/waitlist-otp.types";
+
+export const WAITLIST_OTP_MAX_RESENDS = 3;
+export const WAITLIST_OTP_MAX_ATTEMPTS = 3;
+export const WAITLIST_OTP_TTL_MS = 10 * 60 * 1000;
+
+export const durableCount = (value: unknown): number => {
+  const parsed = Number(value);
+  if (!Number.isFinite(parsed) || parsed < 0) {
+    return 0;
+  }
+  return Math.floor(parsed);
+};
+
+export const resolveWaitlistOtpMethod = (
+  requestedMethod: unknown,
+  storedMethod: unknown
+): WaitlistOtpMethod => {
+  const requested = String(requestedMethod || "").trim();
+  if (requested) {
+    return requested;
+  }
+
+  const stored = String(storedMethod || "").trim();
+  return stored || "whatsapp";
+};
+
+export const isExpiredWaitlistOtp = (
+  expiresAt: Date | string | null | undefined,
+  now: Date = new Date()
+): boolean => {
+  if (!expiresAt) {
+    return false;
+  }
+
+  return new Date(expiresAt).getTime() < now.getTime();
+};
+
+export const waitlistOtpExpiry = (now: Date = new Date()): Date =>
+  new Date(now.getTime() + WAITLIST_OTP_TTL_MS);