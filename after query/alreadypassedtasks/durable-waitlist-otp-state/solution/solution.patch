new file mode 100644
index 000000000..d38ec65e9
--- /dev/null
+++ b/rateeat_backend/src/services/waitlist-otp.service.ts
@@ -0,0 +1,275 @@
+import { Transaction } from "sequelize";
+
+import { PhoneOtp, Waitlist } from "../models";
+import ErrorResponse from "../utils/error-response.utils";
+import { generateOTP } from "../utils/otp.utils";
+import {
+  durableCount,
+  isExpiredWaitlistOtp,
+  resolveWaitlistOtpMethod,
+} from "../utils/waitlist-otp.utils";
+import {
+  applyWaitlistOtpIssueState,
+  buildWaitlistOtpIssueState,
+  canAttemptWaitlistOtpVerification,
+  canResendWaitlistOtp,
+  persistedWaitlistOtpCounters,
+  recordFailedWaitlistOtpAttempt,
+  WAITLIST_OTP_ATTEMPT_FIELDS,
+  WAITLIST_OTP_ISSUE_FIELDS,
+  WaitlistOtpIssueState,
+} from "../utils/waitlist-otp-state.utils";
+import {
+  IssueWaitlistOtpInput,
+  IssuedWaitlistOtp,
+  WaitlistOtpCounters,
+  WaitlistOtpVerificationResult,
+} from "../types/waitlist-otp.types";
+
+class WaitlistOtpDeliveryError extends Error {
+  constructor() {
+    super("Error sending verification");
+    this.name = "WaitlistOtpDeliveryError";
+  }
+}
+
+const getSequelize = () => {
+  const sequelize = Waitlist.sequelize || PhoneOtp.sequelize;
+  if (!sequelize) {
+    throw new Error("Waitlist OTP models are not connected to a database");
+  }
+  return sequelize;
+};
+
+const lockWaitlistEntry = async (
+  phone: string,
+  transaction: Transaction
+): Promise<Waitlist | null> =>
+  Waitlist.findOne({
+    where: { phone },
+    transaction,
+    lock: transaction.LOCK.UPDATE,
+  });
+
+const lockOtpRow = async (
+  phone: string,
+  transaction: Transaction
+): Promise<PhoneOtp | null> =>
+  PhoneOtp.findOne({
+    where: { phoneNumber: phone },
+    transaction,
+    lock: transaction.LOCK.UPDATE,
+  });
+
+const persistIssuedOtp = async (
+  current: PhoneOtp | null,
+  phone: string,
+  issueState: WaitlistOtpIssueState,
+  transaction: Transaction
+): Promise<PhoneOtp> => {
+  if (!current) {
+    return PhoneOtp.create(
+      {
+        phoneNumber: phone,
+        phoneOtpCode: issueState.phoneOtpCode,
+        expires_at: issueState.expiresAt,
+        attempts: issueState.attempts,
+        resend_count: issueState.resendCount,
+        method: issueState.method,
+        last_sent_at: issueState.lastSentAt,
+        verified: false,
+        verified_at: null,
+      } as any,
+      { transaction }
+    );
+  }
+
+  applyWaitlistOtpIssueState(current, issueState);
+
+  await current.save({
+    transaction,
+    fields: WAITLIST_OTP_ISSUE_FIELDS,
+  });
+
+  return current;
+};
+
+export const issueWaitlistOtp = async (
+  input: IssueWaitlistOtpInput
+): Promise<IssuedWaitlistOtp> => {
+  const sequelize = getSequelize();
+
+  try {
+    return await sequelize.transaction(async (transaction) => {
+      // The waitlist row is the per-phone serialization point. Lock it before
+      // reading the OTP row so concurrent sends and verifies use one order.
+      const waitEntry = await lockWaitlistEntry(input.phone, transaction);
+      if (!waitEntry) {
+        throw new ErrorResponse("Phone not found on waitlist", 404);
+      }
+
+      const currentOtp = await lockOtpRow(input.phone, transaction);
+      if (!canResendWaitlistOtp(currentOtp)) {
+        throw new ErrorResponse("Max resend attempts reached", 429);
+      }
+
+      const otp = generateOTP(6);
+      const method = resolveWaitlistOtpMethod(input.method, waitEntry.method);
+      const issueState = buildWaitlistOtpIssueState(currentOtp, otp, method);
+
+      await persistIssuedOtp(
+        currentOtp,
+        input.phone,
+        issueState,
+        transaction
+      );
+
+      // Delivery is intentionally part of this transaction's success boundary.
+      // If the provider rejects the send, the newly generated code and resend
+      // count are rolled back together, leaving the previous usable state intact.
+      try {
+        await input.deliver(
+          input.phone,
+          otp,
+          method,
+          input.telegramChatId
+        );
+      } catch (_error) {
+        throw new WaitlistOtpDeliveryError();
+      }
+
+      return {
+        otp,
+        method,
+        expiresAt: issueState.expiresAt,
+        resendCount: issueState.resendCount,
+      };
+    });
+  } catch (error) {
+    if (error instanceof WaitlistOtpDeliveryError) {
+      throw new ErrorResponse("Error sending verification", 500);
+    }
+    throw error;
+  }
+};
+
+const verificationFailure = (
+  status: 401 | 404 | 429,
+  message:
+    | "Phone not found on waitlist"
+    | "OTP is not correct"
+    | "OTP expired"
+    | "Max verification attempts reached"
+): WaitlistOtpVerificationResult => ({
+  ok: false,
+  status,
+  message,
+});
+
+export const verifyPersistedWaitlistOtp = async (
+  phone: string,
+  otp: string
+): Promise<WaitlistOtpVerificationResult> => {
+  const sequelize = getSequelize();
+
+  return sequelize.transaction(async (transaction) => {
+    const waitEntry = await lockWaitlistEntry(phone, transaction);
+    if (!waitEntry) {
+      return verificationFailure(404, "Phone not found on waitlist");
+    }
+
+    const otpRow = await lockOtpRow(phone, transaction);
+    if (!otpRow) {
+      return verificationFailure(401, "OTP is not correct");
+    }
+
+    if (isExpiredWaitlistOtp(otpRow.expires_at)) {
+      return verificationFailure(401, "OTP expired");
+    }
+
+    if (!canAttemptWaitlistOtpVerification(otpRow)) {
+      return verificationFailure(429, "Max verification attempts reached");
+    }
+
+    if (otpRow.phoneOtpCode !== otp) {
+      recordFailedWaitlistOtpAttempt(otpRow);
+      await otpRow.save({
+        transaction,
+        fields: WAITLIST_OTP_ATTEMPT_FIELDS,
+      });
+
+      // Return the failure instead of throwing it here. Throwing inside the
+      // callback would roll back the persisted attempt increment.
+      return verificationFailure(401, "OTP is not correct");
+    }
+
+    const verifiedAt = new Date();
+    waitEntry.verified = true;
+    waitEntry.verified_at = verifiedAt;
+    await waitEntry.save({
+      transaction,
+      fields: ["verified", "verified_at", "updatedAt"],
+    });
+
+    await otpRow.destroy({ transaction });
+
+    return {
+      ok: true,
+      verifiedAt,
+    };
+  });
+};
+
+export const getActiveWaitlistOtpRegistrationState = async (
+  phone: string
+) => {
+  const sequelize = getSequelize();
+
+  return sequelize.transaction(async (transaction) => {
+    // Registration participates in the same per-phone lock order
+    // as send and verify.
+    const waitEntry = await lockWaitlistEntry(phone, transaction);
+
+    // A verification that committed while registration waited on
+    // this lock must be observed here.
+    if (!waitEntry || waitEntry.verified) {
+      return null;
+    }
+
+    const otpRow = await lockOtpRow(phone, transaction);
+
+    if (
+      !otpRow ||
+      isExpiredWaitlistOtp(otpRow.expires_at)
+    ) {
+      return null;
+    }
+
+    const counters = persistedWaitlistOtpCounters(otpRow);
+
+    return {
+      resendCount: counters.resendCount,
+      verificationAttempts: counters.verificationAttempts,
+      expiresAt: otpRow.expires_at
+        ? new Date(otpRow.expires_at)
+        : null,
+    };
+  });
+};
+
+export const getWaitlistOtpCounters = async (
+  phone: string
+): Promise<WaitlistOtpCounters> => {
+  const sequelize = getSequelize();
+
+  return sequelize.transaction(async (transaction) => {
+    // Registration uses the same per-phone serialization
+    // boundary as send and verify. This prevents it from
+    // observing stale counters during an in-flight resend.
+    await lockWaitlistEntry(phone, transaction);
+
+    const otpRow = await lockOtpRow(phone, transaction);
+
+    return persistedWaitlistOtpCounters(otpRow);
+  });
+};
