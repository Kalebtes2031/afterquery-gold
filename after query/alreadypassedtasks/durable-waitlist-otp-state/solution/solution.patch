+        fields: ["resend_count"],
+        type: "check",
+        name: "phone_otps_resend_count_range_check",
+        where: {
+          resend_count: {
+            [Sequelize.Op.gte]: 0,
+            [Sequelize.Op.lte]: 3,
+          },
+        },
+        transaction,
+      });
+    });
+  },
+
+  async down(queryInterface) {
+    await queryInterface.sequelize.transaction(async (transaction) => {
+      await queryInterface.removeConstraint(
+        "phone_otps",
+        "phone_otps_resend_count_range_check",
+        { transaction }
+      );
+      await queryInterface.removeConstraint(
+        "phone_otps",
+        "phone_otps_attempts_range_check",
+        { transaction }
+      );
+    });
+  },
+};
