+import {
+  HttpError,
+  NotFoundError,
+  OrderCartItemNotAvailableError,
+  OrderCartItemRestaurantMismatchError,
+} from "./error-response.utils";
+import {
+  CartItemEligibility,
+  CartItemEligibilityReason,
+  CartItemInput,
+  CartItemLike,
+  CartTotals,
+} from "../types/order-cart.types";
+
+/**
+ * Structurally validate the raw `items` field of a cart-replacement request.
+ *
+ * This runs before the order (or any item) is looked up in the database, so
+ * a malformed request can never partially change anything: the caller must
+ * hold a fully-parsed, well-formed item list before it does a single query.
+ *
+ * Requirements enforced here:
+ *  - `rawItems` must be a non-empty array.
+ *  - every entry must carry a non-empty string `itemId`.
+ *  - every entry's `quantity` must be a positive integer.
+ *  - no `itemId` may appear more than once in the same request.
+ *
+ * @param rawItems - the untrusted `items` field straight off `req.body`.
+ * @returns the parsed, de-duplicated list of `{ itemId, quantity }` entries.
+ * @throws {HttpError} a 400 describing the first validation failure found.
+ */
+export const parseCartItems = (rawItems: unknown): CartItemInput[] => {
+  if (!Array.isArray(rawItems) || rawItems.length === 0) {
+    throw new HttpError("items must be a non-empty array", 400);
+  }
+
+  const seenItemIds = new Set<string>();
+
+  return rawItems.map((entry) => {
+    const itemId = (entry as Partial<CartItemInput>)?.itemId;
+    const quantity = (entry as Partial<CartItemInput>)?.quantity;
+
+    if (typeof itemId !== "string" || itemId.trim().length === 0) {
+      throw new HttpError("Each cart item must include a valid itemId", 400);
+    }
+
+    if (!Number.isInteger(quantity) || (quantity as number) <= 0) {
+      throw new HttpError(
+        "Each cart item quantity must be a positive integer",
+        400
+      );
+    }
+
+    if (seenItemIds.has(itemId)) {
+      throw new HttpError(
+        "Cart items cannot contain the same itemId more than once",
+        400
+      );
+    }
+    seenItemIds.add(itemId);
+
+    return { itemId, quantity: quantity as number };
+  });
+};
+
+/**
+ * Decide whether a single fetched item may be added to the cart.
+ *
+ * Pure and side-effect free: it takes the item already fetched from the
+ * database (or `undefined` when no row was found) plus the restaurant the
+ * order was placed at, and returns a reason rather than throwing. Keeping
+ * this decision separate from the database orchestration in
+ * order-cart.service.ts makes every eligibility rule testable without a
+ * mocked model or transaction.
+ *
+ * @param item - the item fetched for this itemId, or `undefined` if no row
+ *   was found.
+ * @param orderRestaurantId - the restaurant_id of the order the cart belongs
+ *   to; the item must belong to the same restaurant to be eligible.
+ * @returns whether the item is eligible, and if not, which rule it failed.
+ */
+export const evaluateCartItemEligibility = (
+  item: CartItemLike | undefined,
+  orderRestaurantId: string
+): CartItemEligibility => {
+  if (!item) {
+    return { eligible: false, reason: "missing" };
+  }
+
+  if (!item.is_available_for_order) {
+    return { eligible: false, reason: "unavailable" };
+  }
+
+  const itemRestaurantId = item.categories?.menu?.restaurant_id;
+
+  if (itemRestaurantId !== orderRestaurantId) {
+    return { eligible: false, reason: "wrong-restaurant" };
+  }
+
+  return { eligible: true, reason: "eligible" };
+};
+
+/**
+ * Translate a rejected CartItemEligibilityReason into the HTTP error the
+ * cart endpoint responds with. A missing item is a 404 ("Item not found");
+ * an item that exists but can't be ordered here is a 400 describing why.
+ *
+ * @param item - the item the reason was computed for (used to name it in
+ *   the 400 messages); may be `undefined` when reason is "missing".
+ * @param reason - the rejection reason returned by
+ *   evaluateCartItemEligibility. Must not be "eligible".
+ * @returns an HttpError instance ready to be thrown or passed to `next`.
+ */
+export const buildCartItemRejectionError = (
+  item: CartItemLike | undefined,
+  reason: CartItemEligibilityReason
+): HttpError => {
+  switch (reason) {
+    case "missing":
+      return new NotFoundError("Item");
+    case "unavailable":
+      return new OrderCartItemNotAvailableError(item?.id ?? "");
+    case "wrong-restaurant":
+      return new OrderCartItemRestaurantMismatchError(item?.id ?? "");
+    case "eligible":
+    default:
+      // Defensive: callers only invoke this after evaluateCartItemEligibility
+      // reported eligible: false, so "eligible" should never reach here.
+      return new HttpError("Item is not eligible for this order", 400);
+  }
+};
+
+/**
+ * Recompute the order's aggregate totals from the accepted cart items and
+ * their current prices. Runs once every requested item has already passed
+ * evaluateCartItemEligibility, so this never needs to reject anything
+ * itself.
+ *
+ * @param items - the parsed cart items the order is being replaced with.
+ * @param itemsById - the fetched items, keyed by id, used to look up each
+ *   requested item's current price.
+ * @returns the new `total_number_of_items` and `total_price` for the order.
+ */
+export const calculateCartTotals = (
+  items: CartItemInput[],
+  itemsById: Map<string, CartItemLike>
+): CartTotals => {
+  return items.reduce(
+    (totals, requested) => {
+      const item = itemsById.get(requested.itemId);
+      const price = item?.price ?? 0;
+
+      return {
+        totalNumberOfItems: totals.totalNumberOfItems + requested.quantity,
+        totalPrice: totals.totalPrice + price * requested.quantity,
+      };
+    },
+    { totalNumberOfItems: 0, totalPrice: 0 }
+  );
+};
