@@ -0,0 +1,62 @@
+/* eslint-disable no-use-before-define */
+import {
+  Table,
+  Column,
+  Model,
+  DataType,
+  ForeignKey,
+  PrimaryKey,
+  BelongsTo,
+} from "sequelize-typescript";
+
+import { Order } from "..";
+
+/**
+ * Records the response a successful PUT /api/v1/orders/:orderId/cart
+ * request produced when the request carried an Idempotency-Key header,
+ * keyed by (order_id, idempotency_key). A later request reusing the same
+ * key against the same order looks its response up here instead of
+ * re-validating items or writing to the cart again - see
+ * `replaceOrderCart` in order-cart.service.ts.
+ *
+ * Only a successful replacement is ever recorded here: a rejected request
+ * (400/403/404/409) throws before this row would be written, so the same
+ * key is still free to be retried after fixing whatever was rejected.
+ */
+@Table({
+  tableName: "order_cart_idempotency_keys",
+  timestamps: true,
+})
+class OrderCartIdempotencyKey extends Model<OrderCartIdempotencyKey> {
+  @PrimaryKey
+  @Column({
+    type: DataType.UUID,
+    defaultValue: DataType.UUIDV4,
+    allowNull: false,
+  })
+  id!: string;
+
+  @ForeignKey(() => Order)
+  @Column({
+    type: DataType.UUID,
+    allowNull: false,
+  })
+  order_id!: string;
+
+  @Column({
+    type: DataType.STRING(255),
+    allowNull: false,
+  })
+  idempotency_key!: string;
+
+  @Column({
+    type: DataType.JSONB,
+    allowNull: false,
+  })
+  response_body!: Record<string, unknown>;
+
+  @BelongsTo(() => Order)
+  order!: Order;
+}
+
+export default OrderCartIdempotencyKey;
