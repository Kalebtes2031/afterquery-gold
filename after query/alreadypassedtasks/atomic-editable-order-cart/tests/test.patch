+import request from "supertest";
+import app from "../../app";
+import { Item, Order } from "../../models";
+import { OrderStatus } from "../../models/Order/Order";
+import {
+  createItemInCategory,
+  createOwner,
+  createRestaurantWithItem,
+  createSuperAdmin,
+  TestRestaurant,
+} from "./order_cart_test_support";
+
+// External integrations the cart endpoint has no business needing during a
+// black-box HTTP test: none of these change the endpoint's own behavior, so
+// they're mocked purely to keep the test environment self-contained.
+jest.mock("../../utils/redis.utils", () => ({
+  __esModule: true,
+  default: {
+    get: jest.fn(),
+    set: jest.fn(),
+    setEx: jest.fn(),
+    del: jest.fn(),
+    keys: jest.fn().mockResolvedValue([]),
+    expire: jest.fn(),
+    sAdd: jest.fn(),
+    sMembers: jest.fn(),
+    multi: jest.fn(() => ({ exec: jest.fn() })),
+    connect: jest.fn(),
+    quit: jest.fn(),
+  },
+}));
+
+jest.mock("../../utils/socket.utils", () => ({
+  io: undefined,
+}));
+
+jest.mock("../../utils/notification.utils", () => ({
+  __esModule: true,
+  default: jest.fn(async () => undefined),
+}));
+
+jest.mock("../../utils/telegram.utils", () => ({
+  initializeTelegramClient: jest.fn(),
+  sendTelegramMessage: jest.fn(),
+  sendTelegramContactRequest: jest.fn(),
+  handleTelegramUpdate: jest.fn(),
+  getTelegramSessionString: jest.fn(() => ""),
+  setTelegramSessionString: jest.fn(),
+  checkTelegramHealth: jest.fn(async () => true),
+  disconnectTelegramClient: jest.fn(async () => undefined),
+}));
+
+// Neither pattern pins down the implementation's exact wording - each
+// accepts several reasonable ways of saying the same thing - but an
+// arbitrary or placeholder message ("a", "Bad request") satisfies neither,
+// so these genuinely check that the 400 describes *which* problem occurred
+// rather than merely being present and non-empty.
+const UNAVAILABLE_ITEM_MESSAGE_PATTERN =
+  /\bavailab|\borderable\b|out.?of.?stock|sold.?out|no longer.*(order|available)|can(?:not|'t).*(?:currently )?(?:be )?ordered/i;
+const WRONG_RESTAURANT_MESSAGE_PATTERN =
+  /\brestaurant\b|\bmenu\b|does(?:n't| not) belong|different (restaurant|location)/i;
+
+describe("PUT /api/v1/orders/:orderId/cart", () => {
+  let owner: { userId: string; token: string };
+  let otherUser: { userId: string; token: string };
+  let admin: { adminId: string; token: string };
+  let restaurant: TestRestaurant;
+  let secondRestaurant: TestRestaurant;
+  let secondItemId: string;
+  let unavailableItemId: string;
+  let restaurantItemPrice: number;
+  let secondItemPrice: number;
+
+  const createOrder = async (
+    token: string,
+    restaurantId: string,
+    itemId: string,
+    quantity = 1
+  ): Promise<string> => {
+    const res = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .send({
+        items: [{ itemId, quantity }],
+        orderType: "DineIn",
+        estimatedWaitingTime: 20,
+        orderMessage: "cart test order",
+        restaurantId,
+      });
+
+    if (res.status !== 201) {
+      throw new Error(
+        `failed to create the order fixture: ${JSON.stringify(res.body)}`
+      );
+    }
+
+    return res.body.data.id as string;
+  };
+
+  const getOrder = (orderId: string) =>
+    request(app)
+      .get(`/api/v1/orders/${orderId}`)
+      .set("Authorization", `Bearer ${admin.token}`);
+
+  /**
+   * Asserts that a rejected request left the order's cart and totals
+   * exactly as they were - every rejected case (malformed payload, wrong
+   * owner, wrong status, or a bad item) must satisfy this. Every order this
+   * is called against was seeded with exactly one order-item row, so this
+   * checks the persisted row itself (id and quantity), not just the
+   * aggregates a buggy implementation could recompute without ever writing
+   * the right quantities.
+   */
+  const expectCartUnchanged = async (
+    orderId: string,
+    expectedTotalItems: number,
+    expectedTotalPrice: number,
+    expectedItemId: string = restaurant.itemId
+  ) => {
+    const fetched = await getOrder(orderId);
+    expect(fetched.body.data.total_number_of_items).toBe(expectedTotalItems);
+    expect(fetched.body.data.total_price).toBe(expectedTotalPrice);
+    expect(fetched.body.data.order_items).toHaveLength(1);
+    expect(fetched.body.data.order_items[0]).toMatchObject({
+      item_id: expectedItemId,
+      quantity: expectedTotalItems,
+    });
+  };
+
+  beforeAll(async () => {
+    // Deliberately no separate Database.getInstance() call here: importing
+    // `app` above already constructs and registers the real app's own
+    // Sequelize instance (see config/db.ts), which every model import used
+    // below (Item, Order, ...) is already bound to - a second, independent
+    // instance sharing those same model classes isn't needed, and would
+    // fight the first over their shared association wiring.
+    owner = await createOwner();
+    otherUser = await createOwner();
+    admin = await createSuperAdmin();
+
+    restaurant = await createRestaurantWithItem(admin.token);
+    secondRestaurant = await createRestaurantWithItem(admin.token);
+
+    const secondItem = await createItemInCategory(restaurant.categoryId);
+    secondItemId = secondItem.id;
+
+    const unavailableItem = await createItemInCategory(restaurant.categoryId, {
+      is_available_for_order: false,
+    });
+    unavailableItemId = unavailableItem.id;
+
+    const restaurantItem = await Item.findByPk(restaurant.itemId);
+    restaurantItemPrice = restaurantItem!.price;
+    secondItemPrice = secondItem.price;
+  });
+
+  describe("payload validation", () => {
+    it("returns 400 when items is missing", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({});
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 when items is an empty array", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [] });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 when items is not an array", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: { itemId: restaurant.itemId, quantity: 1 } });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 when a quantity is zero", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 0 }] });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 when a quantity is not an integer", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 1.5 }] });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 when the same itemId is submitted twice", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({
+          items: [
+            { itemId: restaurant.itemId, quantity: 1 },
+            { itemId: restaurant.itemId, quantity: 2 },
+          ],
+        });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 401 when no auth token is provided", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 1 }] });
+
+      expect(res.status).toBe(401);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 when a quantity is negative", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: -3 }] });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 when an item entry is missing itemId", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ quantity: 1 }] });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+  });
+
+  describe("order eligibility", () => {
+    it("returns 404 with 'Order not found' for an order id that doesn't exist", async () => {
+      const res = await request(app)
+        .put("/api/v1/orders/00000000-0000-4000-8000-000000000000/cart")
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 1 }] });
+
+      expect(res.status).toBe(404);
+      expect(res.body).toMatchObject({
+        success: false,
+        message: "Order not found",
