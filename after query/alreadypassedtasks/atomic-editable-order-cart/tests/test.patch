--- /dev/null
+++ b/rateeat_backend/src/__tests__/unit/order_cart_transaction.test.ts
@@ -0,0 +1,286 @@
+import request from "supertest";
+import { Pool } from "pg";
+import app from "../../app";
+import { Item } from "../../models";
+import {
+  createItemInCategory,
+  createOwner,
+  createPool,
+  createRestaurantWithItem,
+  createSuperAdmin,
+  installFailingOrderItemWriteTrigger,
+  removeFailingOrderItemWriteTrigger,
+  TestRestaurant,
+} from "./order_cart_test_support";
+
+// Same external-integration mocks as order_cart_endpoint.test.ts - none of
+// them are part of what this file verifies.
+jest.mock("../../utils/redis.utils", () => ({
+  __esModule: true,
+  default: {
+    get: jest.fn(),
+    set: jest.fn(),
+    setEx: jest.fn(),
+    del: jest.fn(),
+    keys: jest.fn().mockResolvedValue([]),
+    expire: jest.fn(),
+    sAdd: jest.fn(),
+    sMembers: jest.fn(),
+    multi: jest.fn(() => ({ exec: jest.fn() })),
+    connect: jest.fn(),
+    quit: jest.fn(),
+  },
+}));
+
+jest.mock("../../utils/socket.utils", () => ({
+  io: undefined,
+}));
+
+jest.mock("../../utils/notification.utils", () => ({
+  __esModule: true,
+  default: jest.fn(async () => undefined),
+}));
+
+jest.mock("../../utils/telegram.utils", () => ({
+  initializeTelegramClient: jest.fn(),
+  sendTelegramMessage: jest.fn(),
+  sendTelegramContactRequest: jest.fn(),
+  handleTelegramUpdate: jest.fn(),
+  getTelegramSessionString: jest.fn(() => ""),
+  setTelegramSessionString: jest.fn(),
+  checkTelegramHealth: jest.fn(async () => true),
+  disconnectTelegramClient: jest.fn(async () => undefined),
+}));
+
+describe("PUT /api/v1/orders/:orderId/cart transactional behavior", () => {
+  let owner: { userId: string; token: string };
+  let admin: { adminId: string; token: string };
+  let restaurant: TestRestaurant;
+  let secondItemId: string;
+  let restaurantItemPrice: number;
+  let secondItemPrice: number;
+  let pool: Pool;
+
+  const createOrder = async (itemId: string, quantity = 1): Promise<string> => {
+    const res = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${owner.token}`)
+      .send({
+        items: [{ itemId, quantity }],
+        orderType: "DineIn",
+        estimatedWaitingTime: 20,
+        orderMessage: "cart transaction test order",
+        restaurantId: restaurant.restaurantId,
+      });
+
+    if (res.status !== 201) {
+      throw new Error(
+        `failed to create the order fixture: ${JSON.stringify(res.body)}`
+      );
+    }
+
+    return res.body.data.id as string;
+  };
+
+  const getOrder = (orderId: string) =>
+    request(app)
+      .get(`/api/v1/orders/${orderId}`)
+      .set("Authorization", `Bearer ${admin.token}`);
+
+  beforeAll(async () => {
+    // Deliberately no separate Database.getInstance() call here - see the
+    // matching note in order_cart_endpoint.test.ts: importing `app` above
+    // already constructs and registers the real app's own Sequelize
+    // instance, which every model used below is already bound to.
+    pool = createPool();
+
+    owner = await createOwner();
+    admin = await createSuperAdmin();
+    restaurant = await createRestaurantWithItem(admin.token);
+
+    const secondItem = await createItemInCategory(restaurant.categoryId);
+    secondItemId = secondItem.id;
+
+    const restaurantItem = await Item.findByPk(restaurant.itemId);
+    restaurantItemPrice = restaurantItem!.price;
+    secondItemPrice = secondItem.price;
+  });
+
+  afterAll(async () => {
+    await pool.end();
+  });
+
+  describe("atomicity", () => {
+    it("rolls back and leaves the previous cart and totals untouched when the write fails", async () => {
+      const orderId = await createOrder(restaurant.itemId, 2);
+      const before = await getOrder(orderId);
+
+      await installFailingOrderItemWriteTrigger(pool);
+
+      let res;
+      try {
+        res = await request(app)
+          .put(`/api/v1/orders/${orderId}/cart`)
+          .set("Authorization", `Bearer ${owner.token}`)
+          .send({ items: [{ itemId: secondItemId, quantity: 5 }] });
+      } finally {
+        await removeFailingOrderItemWriteTrigger(pool);
+      }
+
+      expect(res.status).toBe(500);
+
+      const after = await getOrder(orderId);
+
+      expect(after.body.data.total_price).toBe(before.body.data.total_price);
+      expect(after.body.data.total_number_of_items).toBe(
+        before.body.data.total_number_of_items
+      );
+
+      const afterItemIds = after.body.data.order_items.map(
+        (orderItem: any) => orderItem.item_id
+      );
+      expect(afterItemIds).toEqual([restaurant.itemId]);
+    });
+
+    it("leaves the order retryable after a failed write, and a subsequent request succeeds", async () => {
+      const orderId = await createOrder(restaurant.itemId, 1);
+
+      await installFailingOrderItemWriteTrigger(pool);
+      let failedRes;
+      try {
+        failedRes = await request(app)
+          .put(`/api/v1/orders/${orderId}/cart`)
+          .set("Authorization", `Bearer ${owner.token}`)
+          .send({ items: [{ itemId: secondItemId, quantity: 3 }] });
+      } finally {
+        await removeFailingOrderItemWriteTrigger(pool);
+      }
+      expect(failedRes.status).toBe(500);
+
+      const retryRes = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: secondItemId, quantity: 3 }] });
+
+      expect(retryRes.status).toBe(200);
+      expect(retryRes.body.data.total_number_of_items).toBe(3);
+    });
+  });
+
+  describe("concurrency", () => {
+    it("serializes concurrent replacements so the final state matches exactly one request", async () => {
+      const orderId = await createOrder(restaurant.itemId, 1);
+
+      const payloadA = { items: [{ itemId: restaurant.itemId, quantity: 7 }] };
+      const payloadB = { items: [{ itemId: secondItemId, quantity: 9 }] };
+
+      const [resA, resB] = await Promise.all([
+        request(app)
+          .put(`/api/v1/orders/${orderId}/cart`)
+          .set("Authorization", `Bearer ${owner.token}`)
+          .send(payloadA),
+        request(app)
+          .put(`/api/v1/orders/${orderId}/cart`)
+          .set("Authorization", `Bearer ${owner.token}`)
+          .send(payloadB),
+      ]);
+
+      // The row lock serializes the two writes rather than rejecting
+      // either one, so both individually-valid requests succeed.
+      expect(resA.status).toBe(200);
+      expect(resB.status).toBe(200);
+
+      const final = await getOrder(orderId);
+      const finalOrderItems = final.body.data.order_items;
+      const finalItemIds = finalOrderItems.map(
+        (orderItem: any) => orderItem.item_id
+      );
+
+      // Checked against every field the winning payload determines - item
+      // id, the persisted row's own quantity, the aggregate item count, and
+      // total_price - not just the item id and item count. A mixed/blended
+      // final state (e.g. the right single item id but a stale or
+      // interleaved price/quantity left over from the losing request) must
+      // fail every one of these, not slip through on a partial match.
+      const matchesA =
+        finalItemIds.length === 1 &&
+        finalItemIds[0] === restaurant.itemId &&
+        finalOrderItems[0].quantity === 7 &&
+        final.body.data.total_number_of_items === 7 &&
+        final.body.data.total_price === 7 * restaurantItemPrice;
+
+      const matchesB =
+        finalItemIds.length === 1 &&
+        finalItemIds[0] === secondItemId &&
+        finalOrderItems[0].quantity === 9 &&
+        final.body.data.total_number_of_items === 9 &&
+        final.body.data.total_price === 9 * secondItemPrice;
+
+      // The final state must be exactly one of the two requests, never a
+      // mix (e.g. both items present, or a blended item count/price).
+      expect(matchesA || matchesB).toBe(true);
+    });
+  });
+
+  describe("idempotency", () => {
+    it("serializes two concurrent requests sharing one Idempotency-Key so only one is ever actually processed", async () => {
+      const orderId = await createOrder(restaurant.itemId, 1);
+      const key = `cart-idem-race-${Math.random().toString(36).slice(2)}`;
+
+      // Same key, deliberately different bodies: true dedup means whichever
+      // request's write actually lands, the *other* response must be an
+      // exact replay of it - not its own (different) body having also been
+      // applied.
+      const payloadA = { items: [{ itemId: restaurant.itemId, quantity: 4 }] };
+      const payloadB = { items: [{ itemId: secondItemId, quantity: 10 }] };
+
+      const [resA, resB] = await Promise.all([
+        request(app)
+          .put(`/api/v1/orders/${orderId}/cart`)
+          .set("Authorization", `Bearer ${owner.token}`)
+          .set("Idempotency-Key", key)
+          .send(payloadA),
+        request(app)
+          .put(`/api/v1/orders/${orderId}/cart`)
+          .set("Authorization", `Bearer ${owner.token}`)
+          .set("Idempotency-Key", key)
+          .send(payloadB),
+      ]);
+
+      expect(resA.status).toBe(200);
+      expect(resB.status).toBe(200);
+      // The order lock (see the plain concurrency test above) makes one of
+      // these process fully and commit first; whichever request's
+      // transaction reaches the idempotency check second, having been
+      // blocked until the first committed, must see the stored response and
+      // replay it verbatim rather than writing its own body.
+      expect(resB.body).toEqual(resA.body);
+
+      // Cross-checked against a separate GET, same as the plain concurrency
+      // test above - matched on item id/quantity/totals rather than a full
+      // deep-equal, since the GET endpoint's order_items shape (it nests the
+      // full item) legitimately differs from the PUT response's.
+      const final = await getOrder(orderId);
+      const finalOrderItems = final.body.data.order_items;
+      const finalItemIds = finalOrderItems.map(
+        (orderItem: any) => orderItem.item_id
+      );
+
