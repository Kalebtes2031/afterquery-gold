+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 6 }] });
+
+      expect(res.status).toBe(200);
+      expect(res.body.data.total_number_of_items).toBe(6);
+      expect(res.body.data.total_price).toBe(6 * restaurantItemPrice);
+      expect(res.body.data.order_items).toMatchObject([
+        { item_id: restaurant.itemId, quantity: 6 },
+      ]);
+    });
+
+    it("recomputes totals from the item's current price, not its price when the order was created", async () => {
+      const priceChangingItem = await createItemInCategory(
+        restaurant.categoryId,
+        { price: 20 }
+      );
+
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        priceChangingItem.id,
+        2
+      );
+
+      // The item's price changes after the order (and its original cart)
+      // already exist - exactly the situation "current item prices" in the
+      // instructions is about. An implementation that reused a price
+      // captured at order-creation time, instead of re-reading the item's
+      // price at replacement time, would still compute totals from the old
+      // price of 20 here.
+      await Item.update({ price: 35 }, { where: { id: priceChangingItem.id } });
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: priceChangingItem.id, quantity: 2 }] });
+
+      expect(res.status).toBe(200);
+      expect(res.body.data.total_price).toBe(2 * 35);
+    });
+  });
+
+  describe("idempotency", () => {
+    const uniqueKey = () => `cart-idem-${Math.random().toString(36).slice(2)}`;
+
+    it("replays the first successful response for a repeated Idempotency-Key, ignoring the retry's own body", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId,
+        1
+      );
+      const key = uniqueKey();
+
+      const first = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", key)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 2 }] });
+
+      expect(first.status).toBe(200);
+      expect(first.body.data.total_number_of_items).toBe(2);
+
+      // Same key, a completely different body - if this were reprocessed
+      // instead of replayed, it would produce a different total.
+      const replay = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", key)
+        .send({ items: [{ itemId: secondItemId, quantity: 9 }] });
+
+      expect(replay.status).toBe(200);
+      expect(replay.body).toEqual(first.body);
+
+      // The replay must not have touched the cart a second time - it should
+      // still reflect the first, genuinely-processed request.
+      await expectCartUnchanged(orderId, 2, 2 * restaurantItemPrice);
+    });
+
+    it("replays the first successful response even when the retry's own body is structurally invalid", async () => {
+      // The replay guarantee is unconditional - "without re-validating its
+      // items", not "as long as the retry happens to still be well-formed".
+      // An implementation that validates the retry's body before checking
+      // whether the key has already been used - even if it only rejects a
+      // genuinely malformed body rather than reprocessing a valid one -
+      // would still return 400 here instead of the first attempt's 200.
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId,
+        1
+      );
+      const key = uniqueKey();
+
+      const first = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", key)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 2 }] });
+
+      expect(first.status).toBe(200);
+
+      const replay = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", key)
+        .send({ items: [] });
+
+      expect(replay.status).toBe(200);
+      expect(replay.body).toEqual(first.body);
+
+      await expectCartUnchanged(orderId, 2, 2 * restaurantItemPrice);
+    });
+
+    it("does not replay across a different Idempotency-Key, even for the same order", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId,
+        1
+      );
+
+      const first = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", uniqueKey())
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 2 }] });
+      expect(first.status).toBe(200);
+
+      const second = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", uniqueKey())
+        .send({ items: [{ itemId: secondItemId, quantity: 6 }] });
+
+      expect(second.status).toBe(200);
+      expect(second.body.data.total_number_of_items).toBe(6);
+      expect(second.body.data.order_items).toMatchObject([
+        { item_id: secondItemId, quantity: 6 },
+      ]);
+    });
+
+    it("does not consume the key when the request under it was rejected", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId,
+        1
+      );
+      const key = uniqueKey();
+
+      const rejected = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", key)
+        .send({
+          items: [
+            { itemId: "00000000-0000-4000-8000-000000000002", quantity: 1 },
+          ],
+        });
+      expect(rejected.status).toBe(404);
+
+      // Reusing the same key after a rejection must process normally - a
+      // failed attempt must never get "cached" as if it had succeeded.
+      const retry = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .set("Idempotency-Key", key)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 5 }] });
+
+      expect(retry.status).toBe(200);
+      expect(retry.body.data.total_number_of_items).toBe(5);
+    });
+
+    it("never replays when no Idempotency-Key is supplied, no matter how similar consecutive requests are", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId,
+        1
+      );
+
+      const first = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 2 }] });
+      expect(first.status).toBe(200);
+
+      const second = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: secondItemId, quantity: 8 }] });
+
+      expect(second.status).toBe(200);
+      expect(second.body.data.total_number_of_items).toBe(8);
+      expect(second.body.data.order_items).toMatchObject([
+        { item_id: secondItemId, quantity: 8 },
+      ]);
+    });
+  });
+});
diff --git a/rateeat_backend/src/__tests__/unit/order_cart_test_support.ts b/rateeat_backend/src/__tests__/unit/order_cart_test_support.ts
new file mode 100644
index 0000000..a5fab01
--- /dev/null
+++ b/rateeat_backend/src/__tests__/unit/order_cart_test_support.ts
@@ -0,0 +1,153 @@
+import jwt from "jsonwebtoken";
+import { Pool } from "pg";
+import { AdminUser, Item, Role, User } from "../../models";
+import { setupRestaurantDetail } from "../helpers/auth_helper";
+
+/**
+ * Shared fixtures for the black-box PUT /api/v1/orders/:orderId/cart tests.
+ * Everything here talks to the real database (through the real Sequelize
+ * models, the real HTTP API via setupRestaurantDetail, or, for the
+ * atomicity helpers, a raw pg connection) - nothing here is a test double
+ * for the feature under test.
+ */
+
+const randomSuffix = () => Math.random().toString(36).slice(2, 10);
+
+export const signToken = (id: string): string =>
+  jwt.sign({ id }, process.env.JWT_SECRET || "");
+
+/**
+ * Create a real client User and a bearer token for it. `protectRoute`
+ * resolves this token straight to the User row via User.findByPk.
+ */
+export const createOwner = async (): Promise<{
+  userId: string;
+  token: string;
+}> => {
+  const [role] = await Role.findOrCreate({ where: { name: "user" } });
+  const suffix = randomSuffix();
+
+  const user = await User.create({
+    role_id: role.id,
+    username: `cart_owner_${suffix}`,
+    email: `cart_owner_${suffix}@example.com`,
+    first_name: "Cart",
+    last_name: "Owner",
+  } as any);
+
+  return { userId: user.id, token: signToken(user.id) };
+};
+
+/**
+ * Create a real AdminUser with a "super_admin" role and a bearer token for
+ * it. `protectRouteForAdmin` resolves this token to the AdminUser row, and
+ * a super_admin role satisfies checkOrderAuthorization for every
+ * restaurant, so this same admin can create restaurants and confirm orders.
+ */
+export const createSuperAdmin = async (): Promise<{
+  adminId: string;
+  token: string;
+}> => {
+  const [role] = await Role.findOrCreate({ where: { name: "super_admin" } });
+  const suffix = randomSuffix();
+
+  const admin = await AdminUser.create({
+    role_id: role.id,
+    email: `cart_admin_${suffix}@example.com`,
+    password: "not-used-by-tests",
+    phone_number: `+2519${Math.floor(Math.random() * 100000000)
+      .toString()
+      .padStart(8, "0")}`,
+    first_name: "Cart",
+    last_name: "Admin",
+  } as any);
+
+  return { adminId: admin.id, token: signToken(admin.id) };
+};
+
+export interface TestRestaurant {
+  restaurantId: string;
+  menuId: string;
+  categoryId: string;
+  itemId: string;
+}
+
+/**
+ * Create a restaurant chain, restaurant, menu, category, and one item. The
+ * chain and restaurant are created through the real HTTP API (via the
+ * shared setupRestaurantDetail helper other order tests already rely on),
+ * exactly as a real admin would.
+ */
+export const createRestaurantWithItem = async (
+  adminToken: string
+): Promise<TestRestaurant> => {
+  const { restaurantId, menuId, categoryId, itemId } =
+    await setupRestaurantDetail(adminToken);
+
+  return { restaurantId, menuId, categoryId, itemId };
+};
+
+export const createItemInCategory = (
+  categoryId: string,
+  overrides: Record<string, unknown> = {}
+) =>
+  Item.create({
+    name: `Cart Test Item ${randomSuffix()}`,
+    price: 15,
+    fasting: false,
+    category_id: categoryId,
+    is_available_for_order: true,
+    ...overrides,
+  } as any);
+
+// --- Raw-SQL helpers for forcing a genuine database-level write failure ---
+// These exist purely to prove atomicity from the outside: they never touch
+// the feature's implementation, only the order_items table itself.
+
+export const createPool = () =>
+  new Pool({
+    host: process.env.DEVELOPMENT_PG_HOST,
+    port: Number(process.env.DEVELOPMENT_PG_PORT || 5432),
+    user: process.env.DEVELOPMENT_PG_USER,
+    password: process.env.DEVELOPMENT_PG_PASSWORD,
+    database: process.env.DEVELOPMENT_PG_DATABASE,
+  });
+
+// Fires on INSERT, UPDATE, *and* DELETE - deliberately not just INSERT.
+// This forces a genuine write failure no matter how the cart replacement is
+// implemented at the SQL level: delete-then-insert, an in-place UPDATE of
+// the existing row, or an upsert all touch order_items through one of these
+// three operations, so all three are covered rather than only one
+// particular delete+insert strategy.
+export const installFailingOrderItemWriteTrigger = async (pool: Pool) => {
+  await pool.query(`
+    CREATE OR REPLACE FUNCTION cart_test_fail_order_item_write()
+    RETURNS trigger AS $$
+    BEGIN
+      RAISE EXCEPTION 'cart test forced order_items write failure';
+    END;
+    $$ LANGUAGE plpgsql;
+  `);
+
+  await pool.query(`
+    DROP TRIGGER IF EXISTS cart_test_fail_order_item_write_trigger
+    ON order_items;
+  `);
+
+  await pool.query(`
+    CREATE TRIGGER cart_test_fail_order_item_write_trigger
+    BEFORE INSERT OR UPDATE OR DELETE ON order_items
+    FOR EACH ROW
+    EXECUTE FUNCTION cart_test_fail_order_item_write();
+  `);
+};
+
+export const removeFailingOrderItemWriteTrigger = async (pool: Pool) => {
+  await pool.query(`
+    DROP TRIGGER IF EXISTS cart_test_fail_order_item_write_trigger
+    ON order_items;
+  `);
+  await pool.query(`
+    DROP FUNCTION IF EXISTS cart_test_fail_order_item_write();
+  `);
+};
diff --git a/rateeat_backend/src/__tests__/unit/order_cart_transaction.test.ts b/rateeat_backend/src/__tests__/unit/order_cart_transaction.test.ts
