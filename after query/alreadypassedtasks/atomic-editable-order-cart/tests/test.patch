+    });
+
+    it("returns 403 when the requester does not own the order", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
