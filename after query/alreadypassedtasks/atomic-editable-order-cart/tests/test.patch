+      expect(res.status).toBe(403);
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 409 with 'Order is not editable' once the order has been confirmed", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const confirmRes = await request(app)
+        .put(`/api/v1/orders/${orderId}/confirm`)
+        .set("Authorization", `Bearer ${admin.token}`)
+        .send({});
+      expect(confirmRes.status).toBe(200);
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: restaurant.itemId, quantity: 2 }] });
+
+      expect(res.status).toBe(409);
+      expect(res.body).toMatchObject({
+        success: false,
+        message: "Order is not editable",
+      });
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    // The contract is "any status other than Order Created / Order Edited",
+    // not just "confirmed" - exercise every other status the model defines,
+    // not just one or two samples, so an implementation that only special-
+    // cases the couple of statuses reachable through a short HTTP sequence
+    // (like the "confirmed" test above) can't slip through for the rest.
+    const NON_EDITABLE_STATUSES = Object.values(OrderStatus).filter(
+      (status) =>
+        status !== OrderStatus.OrderCreated &&
+        status !== OrderStatus.OrderEdited
+    );
+
+    it.each(NON_EDITABLE_STATUSES)(
+      "returns 409 with 'Order is not editable' when the order's status is %s",
+      async (status) => {
+        const orderId = await createOrder(
+          owner.token,
+          restaurant.restaurantId,
+          restaurant.itemId
+        );
+
+        // Move the order straight to the status under test. Several of
+        // these statuses (Bill Requested, Payment Confirmed, ...) have no
+        // single reachable HTTP step from a freshly created order, so this
+        // sets up the precondition directly rather than testing the whole
+        // order lifecycle again here - what's under test is the cart
+        // endpoint's own reaction to the order's current status.
+        await Order.update(
+          { order_status: status },
+          { where: { id: orderId } }
+        );
+
+        const res = await request(app)
+          .put(`/api/v1/orders/${orderId}/cart`)
+          .set("Authorization", `Bearer ${owner.token}`)
+          .send({ items: [{ itemId: restaurant.itemId, quantity: 2 }] });
+
+        expect(res.status).toBe(409);
+        expect(res.body).toMatchObject({
+          success: false,
+          message: "Order is not editable",
+        });
+        await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+      }
+    );
+  });
+
+  describe("item eligibility", () => {
+    it("returns 404 with 'Item not found' for an item id that doesn't exist", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({
+          items: [
+            { itemId: "00000000-0000-4000-8000-000000000001", quantity: 1 },
+          ],
+        });
+
+      expect(res.status).toBe(404);
+      expect(res.body).toMatchObject({
+        success: false,
+        message: "Item not found",
+      });
+      await expectCartUnchanged(orderId, 1, restaurantItemPrice);
+    });
+
+    it("returns 400 describing that the item is not available for ordering, and leaves the cart untouched", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId,
+        3
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: unavailableItemId, quantity: 1 }] });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      // The exact wording isn't part of the contract, but an arbitrary or
+      // placeholder message ("a", "Bad request") must not pass either - the
+      // message has to actually say the item can't currently be ordered, in
+      // one of several reasonable phrasings, not just be present.
+      expect(res.body.message).toEqual(
+        expect.stringMatching(UNAVAILABLE_ITEM_MESSAGE_PATTERN)
+      );
+
+      await expectCartUnchanged(orderId, 3, 3 * restaurantItemPrice);
+    });
+
+    it("returns 400 describing that the item belongs to a different restaurant, and leaves the cart untouched", async () => {
+      const orderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId,
+        2
+      );
+
+      const res = await request(app)
+        .put(`/api/v1/orders/${orderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: secondRestaurant.itemId, quantity: 1 }] });
+
+      expect(res.status).toBe(400);
+      expect(res.body.success).toBe(false);
+      // Same reasoning as the unavailable-item case above: the message must
+      // actually say the item doesn't belong to this restaurant/menu, not
+      // just be some non-empty string.
+      expect(res.body.message).toEqual(
+        expect.stringMatching(WRONG_RESTAURANT_MESSAGE_PATTERN)
+      );
+
+      await expectCartUnchanged(orderId, 2, 2 * restaurantItemPrice);
+    });
+
+    it("describes the not-available and wrong-restaurant problems with distinguishable messages", async () => {
+      // Neither test above pins down exact wording (any correct
+      // implementation's phrasing is fine), but the instructions promise
+      // the response describes *which* problem occurred - so the two
+      // messages, produced under otherwise-identical conditions, must
+      // actually differ from each other rather than sharing one generic
+      // "item rejected" string.
+      const unavailableOrderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+      const unavailableRes = await request(app)
+        .put(`/api/v1/orders/${unavailableOrderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: unavailableItemId, quantity: 1 }] });
+
+      const wrongRestaurantOrderId = await createOrder(
+        owner.token,
+        restaurant.restaurantId,
+        restaurant.itemId
+      );
+      const wrongRestaurantRes = await request(app)
+        .put(`/api/v1/orders/${wrongRestaurantOrderId}/cart`)
+        .set("Authorization", `Bearer ${owner.token}`)
+        .send({ items: [{ itemId: secondRestaurant.itemId, quantity: 1 }] });
+
+      expect(unavailableRes.status).toBe(400);
+      expect(wrongRestaurantRes.status).toBe(400);
+      expect(unavailableRes.body.message).not.toBe(
