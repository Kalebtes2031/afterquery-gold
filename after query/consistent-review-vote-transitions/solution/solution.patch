@@ -0,0 +1,18 @@
+export type ReviewVoteDirection = "up" | "down";
+export type ReviewVoteKind = "item" | "restaurant";
+export type ReviewVoteMessage = "Vote created" | "Vote updated" | "Vote deleted";
+
+export interface ReviewVoteDelivery {
+  registrationToken: string;
+  title: string;
+  message: string;
+  appName: "clientApp";
+}
+
+export interface ReviewVoteResult {
+  response: {
+    message: ReviewVoteMessage;
+    data: Record<string, unknown> & { voted: -1 | 0 | 1 };
+  };
+  pushNotification?: ReviewVoteDelivery;
+}
diff --git a/rateeat_backend/src/utils/review-vote-notification.utils.ts b/rateeat_backend/src/utils/review-vote-notification.utils.ts
new file mode 100644
index 000000000..04e631b67
--- /dev/null
+++ b/rateeat_backend/src/utils/review-vote-notification.utils.ts
@@ -0,0 +1,82 @@
+import { Transaction } from "sequelize";
+import { User } from "../models";
+import Notification, {
+  NotificationCategory,
+} from "../models/Feedback/Notification";
+import {
+  ReviewVoteDelivery,
+  ReviewVoteDirection,
+  ReviewVoteKind,
+} from "../types/review-vote.types";
+
+interface NotificationInput {
+  kind: ReviewVoteKind;
+  reviewId: string;
+  ownerId: string;
+  voterId: string;
+  direction: ReviewVoteDirection;
+  transaction: Transaction;
+}
+
+const notificationType = (kind: ReviewVoteKind) =>
+  kind === "item" ? "ItemReview" : "RestaurantReview";
+
+const notificationMessage = (
+  kind: ReviewVoteKind,
+  direction: ReviewVoteDirection
+) =>
+  `Your ${kind === "item" ? "item review" : "restaurant review"} received a ${
+    direction === "up" ? "upvote" : "downvote"
+  } from user.`;
+
+export const persistReviewVoteNotification = async (
+  input: NotificationInput
+): Promise<ReviewVoteDelivery | undefined> => {
+  if (input.ownerId === input.voterId) return undefined;
+
+  const message = notificationMessage(input.kind, input.direction);
+  const where = {
+    notifiable_type: notificationType(input.kind),
+    notifiable_id: input.reviewId,
+    user_id: input.ownerId,
+    reactor_id: input.voterId,
+    notification_category: NotificationCategory.Mentions,
+  };
+
+  const existing = await Notification.findOne({
+    where,
+    transaction: input.transaction,
+    lock: input.transaction.LOCK.UPDATE,
+  });
+
+  if (existing) {
+    await existing.update(
+      { message, read_status: false },
+      { transaction: input.transaction }
+    );
+    return undefined;
+  }
+
+  await Notification.create(
+    { ...where, message },
+    { transaction: input.transaction }
+  );
+
+  if (input.direction !== "up") return undefined;
+
+  const owner = await User.findByPk(input.ownerId, {
+    transaction: input.transaction,
+    attributes: ["fcm_token"],
+  });
+  if (!owner?.fcm_token) return undefined;
+
+  return {
+    registrationToken: owner.fcm_token,
+    title:
+      input.kind === "item"
+        ? "👍 Your review got an upvote! 🎉"
+        : "👍 You got an upvote! 🎉",
+    message,
+    appName: "clientApp",
+  };
+};
