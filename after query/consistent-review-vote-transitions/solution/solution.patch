diff --git a/rateeat_backend/src/services/review-vote-consistency.service.ts b/rateeat_backend/src/services/review-vote-consistency.service.ts
new file mode 100644
index 000000000..65031decf
--- /dev/null
+++ b/rateeat_backend/src/services/review-vote-consistency.service.ts
@@ -0,0 +1,123 @@
+import { Transaction } from "sequelize";
+import {
+  ItemReview,
+  ItemVote,
+  RestaurantReview,
+  RestaurantVote,
+} from "../models";
+import { ReviewVoteDirection, ReviewVoteKind } from "../types/review-vote.types";
+
+interface ConsistencyAdapter {
+  kind: ReviewVoteKind;
+  reviewModel: typeof ItemReview | typeof RestaurantReview;
+  voteModel: typeof ItemVote | typeof RestaurantVote;
+  foreignKey: "item_review_id" | "restaurant_review_id";
+}
+
+interface ReconcileInput {
+  adapter: ConsistencyAdapter;
+  review: ItemReview | RestaurantReview;
+  reviewId: string;
+  userId: string;
+  expectedDirection: ReviewVoteDirection | null;
+  transaction: Transaction;
+}
+
+const expectedFlag = (direction: ReviewVoteDirection) => direction === "up";
+const expectedValue = (direction: ReviewVoteDirection) =>
+  direction === "up" ? 1 : -1;
+
+const countVotes = async (
+  adapter: ConsistencyAdapter,
+  reviewId: string,
+  transaction: Transaction
+) => {
+  const where = { [adapter.foreignKey]: reviewId };
+  const [up, down] = await Promise.all([
+    (adapter.voteModel as any).count({
+      where: { ...where, flag: true },
+      transaction,
+    }),
+    (adapter.voteModel as any).count({
+      where: { ...where, flag: false },
+      transaction,
+    }),
+  ]);
+  return { up, down };
+};
+
+const verifyCurrentUserVote = async (
+  adapter: ConsistencyAdapter,
+  reviewId: string,
+  userId: string,
+  expectedDirection: ReviewVoteDirection | null,
+  transaction: Transaction
+) => {
+  const votes = await (adapter.voteModel as any).findAll({
+    where: {
+      [adapter.foreignKey]: reviewId,
+      voter_id: userId,
+    },
+    transaction,
+  });
+
+  if (expectedDirection === null) {
+    if (votes.length !== 0) {
+      throw new Error("Vote deletion did not leave a consistent current vote");
+    }
+    return;
+  }
+
+  if (votes.length !== 1) {
+    throw new Error("Vote transition did not leave exactly one current vote");
+  }
+
+  const vote = votes[0];
+  if (
+    vote.flag !== expectedFlag(expectedDirection) ||
+    vote.value !== expectedValue(expectedDirection)
+  ) {
+    throw new Error("Stored vote direction does not match the requested vote");
+  }
+};
+
+export const reconcileReviewVoteState = async ({
+  adapter,
+  review,
+  reviewId,
+  userId,
+  expectedDirection,
+  transaction,
+}: ReconcileInput): Promise<ItemReview | RestaurantReview> => {
+  const counts = await countVotes(adapter, reviewId, transaction);
+
+  await (review as any).update(
+    { up_vote: counts.up, down_vote: counts.down },
+    { transaction }
+  );
+
+  await verifyCurrentUserVote(
+    adapter,
+    reviewId,
+    userId,
+    expectedDirection,
+    transaction
+  );
+
+  const persistedReview = await (adapter.reviewModel as any).findByPk(reviewId, {
+    transaction,
+  });
+  if (!persistedReview) {
+    throw new Error("Review disappeared during vote transition");
+  }
+
+  const confirmed = await countVotes(adapter, reviewId, transaction);
+  if (
+    Number(persistedReview.up_vote) !== confirmed.up ||
+    Number(persistedReview.down_vote) !== confirmed.down
+  ) {
+    throw new Error("Review vote totals do not match stored votes");
+  }
+
+  return persistedReview;
+};
diff --git a/rateeat_backend/src/services/review-vote-transition.service.ts b/rateeat_backend/src/services/review-vote-transition.service.ts
new file mode 100644
index 000000000..7ed88d213
--- /dev/null
+++ b/rateeat_backend/src/services/review-vote-transition.service.ts
@@ -0,0 +1,240 @@
+import { Transaction } from "sequelize";
+import {
+  Interaction,
+  ItemReview,
+  ItemVote,
+  RestaurantReview,
+  RestaurantVote,
+  User,
+} from "../models";
+import { BadRequestError } from "../utils/error-response.utils";
+import { persistReviewVoteNotification } from "../utils/review-vote-notification.utils";
+import { reconcileReviewVoteState } from "./review-vote-consistency.service";
+import {
+  ReviewVoteDirection,
+  ReviewVoteKind,
+  ReviewVoteMessage,
+  ReviewVoteResult,
+} from "../types/review-vote.types";
+
+interface ReviewAdapter {
+  kind: ReviewVoteKind;
+  reviewModel: typeof ItemReview | typeof RestaurantReview;
+  voteModel: typeof ItemVote | typeof RestaurantVote;
+  foreignKey: "item_review_id" | "restaurant_review_id";
+}
+
+interface TransitionState {
+  message: ReviewVoteMessage;
+  nextDirection: ReviewVoteDirection | null;
+}
+
+const itemAdapter: ReviewAdapter = {
+  kind: "item",
+  reviewModel: ItemReview,
+  voteModel: ItemVote,
+  foreignKey: "item_review_id",
+};
+
+const restaurantAdapter: ReviewAdapter = {
+  kind: "restaurant",
+  reviewModel: RestaurantReview,
+  voteModel: RestaurantVote,
+  foreignKey: "restaurant_review_id",
+};
+
+const voteFlag = (direction: ReviewVoteDirection) => direction === "up";
+const voteValue = (direction: ReviewVoteDirection) =>
+  direction === "up" ? 1 : -1;
+const responseVote = (direction: ReviewVoteDirection | null): -1 | 0 | 1 =>
+  direction === "up" ? 1 : direction === "down" ? -1 : 0;
+
+const getTransition = (
+  currentFlag: boolean | null,
+  requested: ReviewVoteDirection
+): TransitionState => {
+  if (currentFlag === null) {
+    return { message: "Vote created", nextDirection: requested };
+  }
+  if (currentFlag === voteFlag(requested)) {
+    return { message: "Vote deleted", nextDirection: null };
+  }
+  return { message: "Vote updated", nextDirection: requested };
+};
+
+const requireReview = async (
+  adapter: ReviewAdapter,
+  reviewId: string,
+  transaction: Transaction
+): Promise<ItemReview | RestaurantReview> => {
+  const review = await (adapter.reviewModel as any).findByPk(reviewId, {
+    transaction,
+    lock: transaction.LOCK.UPDATE,
+  });
+  if (!review) throw new BadRequestError("Review Not Found");
+  return review;
+};
+
+const requireVoter = async (userId: string, transaction: Transaction) => {
+  const voter = await User.findByPk(userId, { transaction });
+  if (!voter) throw new BadRequestError("User Not Found");
+};
+
+const findVote = async (
+  adapter: ReviewAdapter,
+  reviewId: string,
+  userId: string,
+  transaction: Transaction
+): Promise<ItemVote | RestaurantVote | null> =>
+  (adapter.voteModel as any).findOne({
+    where: { [adapter.foreignKey]: reviewId, voter_id: userId },
+    transaction,
+    lock: transaction.LOCK.UPDATE,
+  });
+
+const mutateVote = async (
+  adapter: ReviewAdapter,
+  reviewId: string,
+  userId: string,
+  currentVote: ItemVote | RestaurantVote | null,
+  transition: TransitionState,
+  transaction: Transaction
+) => {
+  if (transition.nextDirection === null) {
+    if (currentVote) await currentVote.destroy({ transaction });
+    return;
+  }
+
+  const flag = voteFlag(transition.nextDirection);
+  const value = voteValue(transition.nextDirection);
+  if (currentVote) {
+    await (currentVote as any).update(
+      { flag, value },
+      { transaction }
+    );
+    return;
+  }
+
+  await (adapter.voteModel as any).create(
+    {
+      [adapter.foreignKey]: reviewId,
+      voter_id: userId,
+      flag,
+      value,
+    },
+    { transaction }
+  );
+};
+
+const persistItemInteraction = async (
+  adapter: ReviewAdapter,
+  review: ItemReview | RestaurantReview,
+  userId: string,
+  requested: ReviewVoteDirection,
+  nextDirection: ReviewVoteDirection | null,
+  transaction: Transaction
+) => {
+  if (
+    adapter.kind !== "item" ||
+    requested !== "up" ||
+    nextDirection !== "up"
+  ) {
+    return;
+  }
+  await Interaction.create(
+    {
+      userId,
+      itemId: (review as ItemReview).item_id,
+      type: "upvote item review",
+    },
+    { transaction }
+  );
+};
+
+const transitionReviewVote = async (
+  adapter: ReviewAdapter,
+  userId: string,
+  reviewId: string,
+  requested: ReviewVoteDirection
+): Promise<ReviewVoteResult> => {
+  const sequelize = (adapter.reviewModel as any).sequelize;
+  if (!sequelize) throw new Error("Review model is not connected to a database");
+
+  let pushNotification: ReviewVoteResult["pushNotification"];
+  const response = await sequelize.transaction(async (transaction: Transaction) => {
+    // One review row is the serialization point for every transition on that
+    // review. Nothing reads or mutates the user's vote until this lock is held.
+    const review = await requireReview(adapter, reviewId, transaction);
+    await requireVoter(userId, transaction);
+
+    const currentVote = await findVote(adapter, reviewId, userId, transaction);
+    const transition = getTransition(
+      currentVote ? currentVote.flag : null,
+      requested
+    );
+
+    await mutateVote(
+      adapter,
+      reviewId,
+      userId,
+      currentVote,
+      transition,
+      transaction
+    );
+
+    // Stored vote rows are authoritative. Reconcile the aggregate totals and
+    // verify the current user's durable vote before any side effects commit.
+    const freshReview = await reconcileReviewVoteState({
+      adapter,
+      review,
+      reviewId,
+      userId,
+      expectedDirection: transition.nextDirection,
+      transaction,
+    });
+
+    if (transition.nextDirection !== null) {
+      pushNotification = await persistReviewVoteNotification({
+        kind: adapter.kind,
+        reviewId,
+        ownerId: review.user_id,
+        voterId: userId,
+        direction: transition.nextDirection,
+        transaction,
+      });
+    }
+
+    // Keep the existing item recommendation activity, but commit it with the
+    // vote instead of leaving a half-finished transition if this final write fails.
+    await persistItemInteraction(
+      adapter,
+      review,
+      userId,
+      requested,
+      transition.nextDirection,
+      transaction
+    );
+
+    return {
+      message: transition.message,
+      data: {
+        ...freshReview.dataValues,
+        voted: responseVote(transition.nextDirection),
+      },
+    };
+  });
+
+  return { response, pushNotification };
+};
+
+export const transitionItemReviewVote = (
+  userId: string,
+  reviewId: string,
+  direction: ReviewVoteDirection
+) => transitionReviewVote(itemAdapter, userId, reviewId, direction);
+
+export const transitionRestaurantReviewVote = (
+  userId: string,
+  reviewId: string,
+  direction: ReviewVoteDirection
+) => transitionReviewVote(restaurantAdapter, userId, reviewId, direction);
