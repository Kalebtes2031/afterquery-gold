+"use strict";
+
+module.exports = {
+  async up(queryInterface) {
+    await queryInterface.sequelize.transaction(async (transaction) => {
+      // Keep the newest row if an older deployment already contains duplicate
+      // votes for one user/review pair, then make that state impossible again.
+      await queryInterface.sequelize.query(
+        `DELETE FROM item_votes older
+         USING item_votes newer
+         WHERE older.voter_id = newer.voter_id
+           AND older.item_review_id = newer.item_review_id
+           AND (older."updatedAt", older.id) < (newer."updatedAt", newer.id)`,
+        { transaction }
+      );
+      await queryInterface.sequelize.query(
+        `DELETE FROM restaurant_votes older
+         USING restaurant_votes newer
+         WHERE older.voter_id = newer.voter_id
+           AND older.restaurant_review_id = newer.restaurant_review_id
+           AND (older."updatedAt", older.id) < (newer."updatedAt", newer.id)`,
+        { transaction }
+      );
+      await queryInterface.addConstraint("item_votes", {
+        fields: ["voter_id", "item_review_id"],
+        type: "unique",
+        name: "item_votes_voter_review_unique",
+        transaction,
+      });
+      await queryInterface.addConstraint("restaurant_votes", {
+        fields: ["voter_id", "restaurant_review_id"],
+        type: "unique",
+        name: "restaurant_votes_voter_review_unique",
+        transaction,
+      });
+    });
+  },
+
+  async down(queryInterface) {
+    await queryInterface.sequelize.transaction(async (transaction) => {
+      await queryInterface.removeConstraint(
+        "restaurant_votes",
+        "restaurant_votes_voter_review_unique",
+        { transaction }
+      );
+      await queryInterface.removeConstraint(
+        "item_votes",
+        "item_votes_voter_review_unique",
+        { transaction }
+      );
+    });
+  },
+};
