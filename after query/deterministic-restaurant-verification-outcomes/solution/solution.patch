@@ -0,0 +1,63 @@
+import sequelize from "../config/db";
+import {
+  BatchClaimVerificationItem,
+  BatchClaimVerificationResponse,
+  ClaimVerificationAction,
+  ClaimVerificationResult,
+} from "../types/restaurant-claim-outcome.types";
+import { RestaurantClaimOutcomeService } from "./restaurant-claim-outcome.service";
+
+export class RestaurantClaimDeterminismService {
+  /**
+   * Executes a batch of claim verification actions atomically in requested sequence.
+   */
+  public static async executeBatchVerification(
+    items: BatchClaimVerificationItem[],
+    reviewerId: string
+  ): Promise<BatchClaimVerificationResponse> {
+    return sequelize.transaction(async (tx) => {
+      const results: ClaimVerificationResult[] = [];
+      let approvedCount = 0;
+      let rejectedCount = 0;
+
+      for (const item of items) {
+        const verified =
+          await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+            item.claimId,
+            item.action,
+            reviewerId,
+            item.rejectionReason,
+            tx
+          );
+
+        results.push(verified);
+        if (
+          item.action === ClaimVerificationAction.Approve ||
+          item.action === "approve"
+        ) {
+          approvedCount++;
+        } else {
+          rejectedCount++;
+        }
+      }
+
+      return {
+        totalProcessed: results.length,
+        approvedCount,
+        rejectedCount,
+        results,
+      };
+    });
+  }
+
+  /**
+   * Validates whether all claim IDs in a batch are distinct and non-empty.
+   */
+  public static async validateBatchPrerequisites(
+    claimIds: string[]
+  ): Promise<boolean> {
+    if (!claimIds || claimIds.length === 0) return false;
+    const uniqueIds = new Set(claimIds.map((id) => id.trim()));
+    return uniqueIds.size === claimIds.length;
+  }
+}
diff --git a/rateeat_backend/src/services/restaurant-claim-outcome.service.ts b/rateeat_backend/src/services/restaurant-claim-outcome.service.ts
new file mode 100644
index 0000000..3b6b765
--- /dev/null
+++ b/rateeat_backend/src/services/restaurant-claim-outcome.service.ts
@@ -0,0 +1,203 @@
+import { Transaction } from "sequelize";
+import sequelize from "../config/db";
+import {
+  AdminUser,
+  Notification,
+  RestaurantChain,
+  RestaurantClaimRequest,
+} from "../models";
+import { Status } from "../models/RestaurantClaim/RestaurantClaimRequest";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import {
+  ConflictError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import {
+  ClaimVerificationAction,
+  ClaimVerificationResult,
+  ClaimVerificationStatus,
+  VerificationFilterOptions,
+} from "../types/restaurant-claim-outcome.types";
+import { createAuditLogEntry } from "../utils/restaurant-claim-outcome.utils";
+
+export class RestaurantClaimOutcomeService {
+  /**
+   * Performs an atomic, locked state transition on a restaurant claim request.
+   */
+  public static async verifySingleClaimWithLock(
+    claimId: string,
+    action: ClaimVerificationAction | "approve" | "reject",
+    reviewerId: string,
+    rejectionReason?: string,
+    externalTransaction?: Transaction
+  ): Promise<ClaimVerificationResult> {
+    const executeVerification = async (tx: Transaction) => {
+      const claim = await RestaurantClaimRequest.findByPk(claimId, {
+        transaction: tx,
+        lock: tx.LOCK.UPDATE,
+      });
+
+      if (!claim) {
+        throw new NotFoundError("Restaurant claim request not found");
+      }
+
+      const initialStatus = claim.status as unknown as ClaimVerificationStatus;
+
+      if (claim.status === Status.Approved) {
+        throw new ConflictError(
+          `Restaurant claim request '${claimId}' is already in terminal state 'Approved'`
+        );
+      }
+
+      if (claim.status === Status.Rejected) {
+        throw new ConflictError(
+          `Restaurant claim request '${claimId}' is already in terminal state 'Rejected'`
+        );
+      }
+
+      const now = new Date();
+      let chainSynchronized = false;
+      let notificationsDispatched = 0;
+
+      if (action === ClaimVerificationAction.Approve || action === "approve") {
+        claim.status = Status.Approved;
+        await claim.save({ transaction: tx });
+
+        if (claim.restaurant_chain_id) {
+          const chain = await RestaurantChain.findByPk(
+            claim.restaurant_chain_id,
+            {
+              transaction: tx,
+              lock: tx.LOCK.UPDATE,
+            }
+          );
+          if (chain) {
+            chain.is_verified = true;
+            await chain.save({ transaction: tx });
+            chainSynchronized = true;
+          }
+        }
+
+        const superAdmins = await AdminUser.findAll({
+          where: { is_super_admin: true },
+          transaction: tx,
+        });
+
+        for (const admin of superAdmins) {
+          await Notification.create(
+            {
+              user_id: admin.id,
+              category: NotificationCategory.RestaurantClaim,
+              title: "Restaurant Claim Approved",
+              message: `Restaurant claim request for restaurant ${claim.restaurant_id} has been verified and approved.`,
+            },
+            { transaction: tx }
+          );
+          notificationsDispatched++;
+        }
+
+        createAuditLogEntry(
+          claim.id,
+          claim.restaurant_id,
+          claim.restaurant_chain_id,
+          initialStatus,
+          ClaimVerificationStatus.Approved,
+          ClaimVerificationAction.Approve,
+          reviewerId,
+          chainSynchronized,
+          notificationsDispatched
+        );
+
+        return {
+          id: claim.id,
+          restaurant_id: claim.restaurant_id,
+          restaurant_chain_id: claim.restaurant_chain_id,
+          status: ClaimVerificationStatus.Approved,
+          rejection_reason: null,
+          reviewed_at: now,
+          reviewed_by: reviewerId,
+        };
+      } else {
+        claim.status = Status.Rejected;
+        if (rejectionReason) {
+          (claim as any).rejection_reason = rejectionReason;
+        }
+        await claim.save({ transaction: tx });
+
+        createAuditLogEntry(
+          claim.id,
+          claim.restaurant_id,
+          claim.restaurant_chain_id,
+          initialStatus,
+          ClaimVerificationStatus.Rejected,
+          ClaimVerificationAction.Reject,
+          reviewerId,
+          false,
+          0
+        );
+
+        return {
+          id: claim.id,
+          restaurant_id: claim.restaurant_id,
+          restaurant_chain_id: claim.restaurant_chain_id,
+          status: ClaimVerificationStatus.Rejected,
+          rejection_reason: rejectionReason || null,
+          reviewed_at: now,
+          reviewed_by: reviewerId,
+        };
+      }
+    };
+
+    if (externalTransaction) {
+      return executeVerification(externalTransaction);
+    } else {
+      return sequelize.transaction(async (tx) => executeVerification(tx));
+    }
+  }
+
+  /**
+   * Retrieves historical verification records filtered by query options.
+   */
+  public static async queryVerificationHistory(
+    filters: VerificationFilterOptions = {}
+  ): Promise<any[]> {
+    const where: any = {};
+    if (filters.restaurantId) {
+      where.restaurant_id = filters.restaurantId;
+    }
+    if (filters.chainId) {
+      where.restaurant_chain_id = filters.chainId;
+    }
+    if (filters.status) {
+      where.status = filters.status;
+    }
+
+    return RestaurantClaimRequest.findAll({
+      where,
+      limit: filters.limit || 50,
+      offset: filters.offset || 0,
+      order: [["updatedAt", "DESC"]],
+    });
+  }
+
+  /**
+   * Counts claim requests grouped by status.
+   */
+  public static async getClaimStatusCounts(): Promise<{
+    pending: number;
+    approved: number;
+    rejected: number;
+  }> {
+    const pending = await RestaurantClaimRequest.count({
+      where: { status: Status.Pending },
+    });
+    const approved = await RestaurantClaimRequest.count({
+      where: { status: Status.Approved },
+    });
+    const rejected = await RestaurantClaimRequest.count({
+      where: { status: Status.Rejected },
+    });
+
+    return { pending, approved, rejected };
+  }
+}
