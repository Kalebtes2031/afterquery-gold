diff --git a/rateeat_backend/src/services/restaurant-claim-outcome.service.ts b/rateeat_backend/src/services/restaurant-claim-outcome.service.ts
new file mode 100644
index 0000000..02e4c4b
--- /dev/null
+++ b/rateeat_backend/src/services/restaurant-claim-outcome.service.ts
@@ -0,0 +1,192 @@
+import { Transaction, Op } from "sequelize";
+import sequelize from "../config/db";
+import {
+  AdminUser,
+  Notification,
+  RestaurantChain,
+  RestaurantClaimRequest,
+} from "../models";
+import { Status } from "../models/RestaurantClaim/RestaurantClaimRequest";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import {
+  ConflictError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import {
+  BatchClaimVerificationItem,
+  ClaimVerificationAction,
+  ClaimVerificationMetrics,
+  ClaimVerificationResult,
+  ClaimVerificationStatus,
+  VerificationFilterOptions,
+} from "../types/restaurant-claim-outcome.types";
+
+export class RestaurantClaimOutcomeService {
+  /**
+   * Performs an atomic, locked state transition on a restaurant claim request.
+   */
+  public static async verifySingleClaimWithLock(
+    claimId: string,
+    action: ClaimVerificationAction | "approve" | "reject",
+    reviewerId: string,
+    rejectionReason?: string,
+    externalTransaction?: Transaction
+  ): Promise<ClaimVerificationResult> {
+    const executeVerification = async (tx: Transaction) => {
+      const claim = await RestaurantClaimRequest.findByPk(claimId, {
+        transaction: tx,
+        lock: tx.LOCK.UPDATE,
+      });
+
+      if (!claim) {
+        throw new NotFoundError("Restaurant claim request not found");
+      }
+
+      if (claim.status === Status.Approved) {
+        throw new ConflictError(
+          `Restaurant claim request '${claimId}' is already in terminal state 'Approved'`
+        );
+      }
+
+      if (claim.status === Status.Rejected) {
+        throw new ConflictError(
+          `Restaurant claim request '${claimId}' is already in terminal state 'Rejected'`
+        );
+      }
+
+      const now = new Date();
+
+      if (action === ClaimVerificationAction.Approve || action === "approve") {
+        claim.status = Status.Approved;
+        await claim.save({ transaction: tx });
+
+        if (claim.restaurant_chain_id) {
+          const chain = await RestaurantChain.findByPk(
+            claim.restaurant_chain_id,
+            {
+              transaction: tx,
+              lock: tx.LOCK.UPDATE,
+            }
+          );
+          if (chain) {
+            chain.is_verified = true;
+            await chain.save({ transaction: tx });
+          }
+        }
+
+        const superAdmins = await AdminUser.findAll({
+          where: { is_super_admin: true },
+          transaction: tx,
+        });
+
+        for (const admin of superAdmins) {
+          await Notification.create(
+            {
+              user_id: admin.id,
+              category: NotificationCategory.RestaurantClaim,
+              title: "Restaurant Claim Approved",
+              message: `Restaurant claim request for restaurant ${claim.restaurant_id} has been verified and approved.`,
+            },
+            { transaction: tx }
+          );
+        }
+
+        return {
+          id: claim.id,
+          restaurant_id: claim.restaurant_id,
+          restaurant_chain_id: claim.restaurant_chain_id,
+          status: ClaimVerificationStatus.Approved,
+          rejection_reason: null,
+          reviewed_at: now,
+          reviewed_by: reviewerId,
+        };
+      } else {
+        claim.status = Status.Rejected;
+        if (rejectionReason) {
+          (claim as any).rejection_reason = rejectionReason;
+        }
+        await claim.save({ transaction: tx });
+
+        return {
+          id: claim.id,
+          restaurant_id: claim.restaurant_id,
+          restaurant_chain_id: claim.restaurant_chain_id,
+          status: ClaimVerificationStatus.Rejected,
+          rejection_reason: rejectionReason || null,
+          reviewed_at: now,
+          reviewed_by: reviewerId,
+        };
+      }
+    };
+
+    if (externalTransaction) {
+      return executeVerification(externalTransaction);
+    } else {
+      return sequelize.transaction(async (tx) => executeVerification(tx));
+    }
+  }
+
+  /**
+   * Executes a batch of claim verification actions atomically in requested sequence.
+   */
+  public static async executeBatchVerification(
+    items: BatchClaimVerificationItem[],
+    reviewerId: string
+  ): Promise<ClaimVerificationResult[]> {
+    return sequelize.transaction(async (tx) => {
+      const results: ClaimVerificationResult[] = [];
+      for (const item of items) {
+        const verified = await this.verifySingleClaimWithLock(
+          item.claimId,
+          item.action,
+          reviewerId,
+          item.rejectionReason,
+          tx
+        );
+        results.push(verified);
+      }
+      return results;
+    });
+  }
+
+  /**
+   * Queries claim requests based on filter criteria.
+   */
+  public static async getFilteredClaims(
+    filters: VerificationFilterOptions
+  ): Promise<{ rows: RestaurantClaimRequest[]; count: number }> {
+    const where: any = {};
+    if (filters.status) where.status = filters.status;
+    if (filters.restaurantId) where.restaurant_id = filters.restaurantId;
+    if (filters.chainId) where.restaurant_chain_id = filters.chainId;
+
+    return RestaurantClaimRequest.findAndCountAll({
+      where,
+      limit: filters.limit || 20,
+      offset: filters.offset || 0,
+      order: [["createdAt", "DESC"]],
+    });
+  }
+
+  /**
+   * Computes aggregated claim status counts for verification dashboards.
+   */
+  public static async getClaimStatusMetrics(): Promise<ClaimVerificationMetrics> {
+    const pending = await RestaurantClaimRequest.count({ where: { status: Status.Pending } });
+    const approved = await RestaurantClaimRequest.count({ where: { status: Status.Approved } });
+    const rejected = await RestaurantClaimRequest.count({ where: { status: Status.Rejected } });
+    const chainLinked = await RestaurantClaimRequest.count({
+      where: {
+        restaurant_chain_id: { [Op.ne]: null },
+      },
+    });
+
+    return {
+      totalClaims: pending + approved + rejected,
+      pendingCount: pending,
+      approvedCount: approved,
+      rejectedCount: rejected,
+      chainLinkedCount: chainLinked,
+    };
+  }
+}
