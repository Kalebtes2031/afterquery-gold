+import { Status } from "../../models/RestaurantClaim/RestaurantClaimRequest";
+
+export function createMockRestaurantClaim(overrides: any = {}) {
+  return {
+    id: overrides.id || "claim-uuid-1",
+    restaurant_id: overrides.restaurant_id || "rest-uuid-1",
+    restaurant_chain_id: overrides.restaurant_chain_id !== undefined ? overrides.restaurant_chain_id : "chain-uuid-1",
+    user_id: overrides.user_id || "user-uuid-1",
+    status: overrides.status || Status.Pending,
+    save: jest.fn().mockResolvedValue(true),
+    update: jest.fn().mockResolvedValue(true),
+    ...overrides,
+  };
+}
+
+export function createMockRestaurantChain(overrides: any = {}) {
+  return {
+    id: overrides.id || "chain-uuid-1",
+    name: overrides.name || "Test Chain",
+    is_verified: overrides.is_verified || false,
+    save: jest.fn().mockResolvedValue(true),
+    ...overrides,
+  };
+}
