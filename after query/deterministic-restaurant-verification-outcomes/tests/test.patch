+import { validateBatchClaimPayload } from "../../utils/restaurant-claim-outcome.utils";
+import { RestaurantClaimDeterminismService } from "../../services/restaurant-claim-determinism.service";
+import { RestaurantClaimOutcomeService } from "../../services/restaurant-claim-outcome.service";
+import { Status } from "../../models/RestaurantClaim/RestaurantClaimRequest";
+import { ClaimVerificationAction } from "../../types/restaurant-claim-outcome.types";
+
+jest.mock("../../services/restaurant-claim-outcome.service");
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Restaurant Claim Outcome Determinism - Batch Moderation & Ordering", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe("Batch Verification Payload Validation", () => {
+    it("returns 400 when body has no claims field", () => {
+      expect(() => validateBatchClaimPayload({})).toThrow(
+        "Field 'claims' must be an array"
+      );
+    });
+
+    it("returns 400 when claims array is empty", () => {
+      expect(() => validateBatchClaimPayload({ claims: [] })).toThrow(
+        "Field 'claims' cannot be an empty array"
+      );
+    });
+
+    it("returns 400 with duplicate claim request id when duplicate ids exist in claims array", () => {
+      const payload = {
+        claims: [
+          { claimId: "claim-1", action: "approve" },
+          { claimId: "claim-1", action: "reject" },
+        ],
+      };
+      expect(() => validateBatchClaimPayload(payload)).toThrow(
+        "Duplicate claim request id 'claim-1' detected"
+      );
+    });
+
+    it("returns 400 when an action in claims array is invalid", () => {
+      const payload = {
+        claims: [{ claimId: "claim-1", action: "delete" }],
+      };
+      expect(() => validateBatchClaimPayload(payload)).toThrow(
+        "Invalid verification action 'delete'"
+      );
+    });
+
+    it("returns 400 when an item in claims array is not an object", () => {
+      const payload = {
+        claims: ["invalid-string-item"],
+      };
+      expect(() => validateBatchClaimPayload(payload)).toThrow(
+        "Claim item at index 0 must be an object"
+      );
+    });
+  });
+
+  describe("Batch Execution & Ordering", () => {
+    it("successfully verifies mixed approval and rejection claims in single transaction", async () => {
+      const items = [
+        { claimId: "c-1", action: ClaimVerificationAction.Approve },
+        {
+          claimId: "c-2",
+          action: ClaimVerificationAction.Reject,
+          rejectionReason: "Incomplete docs",
+        },
+      ];
+
+      (
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock as jest.Mock
+      )
+        .mockResolvedValueOnce({
+          id: "c-1",
+          restaurant_id: "r-1",
+          status: "Approved",
+          rejection_reason: null,
+          reviewed_at: new Date(),
+          reviewed_by: "admin-1",
+        })
+        .mockResolvedValueOnce({
+          id: "c-2",
+          restaurant_id: "r-2",
+          status: "Rejected",
+          rejection_reason: "Incomplete docs",
+          reviewed_at: new Date(),
+          reviewed_by: "admin-1",
+        });
+
+      const response =
+        await RestaurantClaimDeterminismService.executeBatchVerification(
+          items,
+          "admin-1"
+        );
+
+      expect(response.totalProcessed).toBe(2);
+      expect(response.approvedCount).toBe(1);
+      expect(response.rejectedCount).toBe(1);
+      expect(response.results[0].id).toBe("c-1");
+      expect(response.results[1].id).toBe("c-2");
+    });
+
+    it("returns results in the exact requested order of claimIds", async () => {
+      const items = [
+        { claimId: "c-99", action: ClaimVerificationAction.Approve },
+        { claimId: "c-11", action: ClaimVerificationAction.Approve },
+        { claimId: "c-44", action: ClaimVerificationAction.Reject },
+      ];
+
+      (
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock as jest.Mock
+      )
+        .mockResolvedValueOnce({ id: "c-99", status: "Approved" })
+        .mockResolvedValueOnce({ id: "c-11", status: "Approved" })
+        .mockResolvedValueOnce({ id: "c-44", status: "Rejected" });
+
+      const response =
+        await RestaurantClaimDeterminismService.executeBatchVerification(
+          items,
+          "admin-1"
+        );
+
+      expect(response.results.map((r) => r.id)).toEqual([
+        "c-99",
+        "c-11",
+        "c-44",
+      ]);
+    });
+
+    it("trims whitespace from claim ids in batch", () => {
+      const payload = {
+        claims: [{ claimId: "  claim-padded  ", action: "approve" }],
+      };
+      const result = validateBatchClaimPayload(payload);
+      expect(result.claims[0].claimId).toBe("claim-padded");
+    });
+  });
+
+  describe("Batch Rollback on Failures", () => {
+    it("rolls back entire batch when one claim request is not found", async () => {
+      (
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock as jest.Mock
+      )
+        .mockResolvedValueOnce({ id: "c-1", status: "Approved" })
+        .mockRejectedValueOnce(new Error("Restaurant claim request not found"));
+
+      const items = [
+        { claimId: "c-1", action: ClaimVerificationAction.Approve },
+        { claimId: "c-missing", action: ClaimVerificationAction.Approve },
+      ];
+
+      await expect(
+        RestaurantClaimDeterminismService.executeBatchVerification(
+          items,
+          "admin-1"
+        )
+      ).rejects.toThrow("Restaurant claim request not found");
+    });
+
+    it("rolls back entire batch when one claim request is already approved", async () => {
+      (
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock as jest.Mock
+      )
+        .mockRejectedValueOnce(
+          new Error("already in terminal state 'Approved'")
+        );
+
+      const items = [
+        { claimId: "c-already-approved", action: ClaimVerificationAction.Approve },
+      ];
+
+      await expect(
+        RestaurantClaimDeterminismService.executeBatchVerification(
+          items,
+          "admin-1"
+        )
+      ).rejects.toThrow("already in terminal state 'Approved'");
+    });
+
+    it("rolls back entire batch when one claim request is already rejected", async () => {
+      (
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock as jest.Mock
+      )
+        .mockRejectedValueOnce(
+          new Error("already in terminal state 'Rejected'")
+        );
+
+      const items = [
+        { claimId: "c-already-rejected", action: ClaimVerificationAction.Reject },
+      ];
+
+      await expect(
+        RestaurantClaimDeterminismService.executeBatchVerification(
+          items,
+          "admin-1"
+        )
+      ).rejects.toThrow("already in terminal state 'Rejected'");
+    });
+
+    it("serializes concurrent reviews on same claim request so only one succeeds", async () => {
+      const mockFn = jest
+        .fn()
+        .mockResolvedValueOnce({ id: "c-race", status: "Approved" })
+        .mockRejectedValueOnce(
+          new Error("already in terminal state 'Approved'")
+        );
+
+      (
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock as jest.Mock
+      ) = mockFn;
+
+      const p1 = RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "c-race",
+        "approve",
+        "admin-1"
+      );
+      const p2 = RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "c-race",
+        "approve",
+        "admin-2"
+      );
+
+      const results = await Promise.allSettled([p1, p2]);
+      expect(results[0].status).toBe("fulfilled");
+      expect(results[1].status).toBe("rejected");
+    });
+  });
+});
