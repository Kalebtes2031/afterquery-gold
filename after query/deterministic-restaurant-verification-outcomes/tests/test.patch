+import { RestaurantClaimOutcomeService } from "../../services/restaurant-claim-outcome.service";
+import {
+  AdminUser,
+  Notification,
+  RestaurantChain,
+  RestaurantClaimRequest,
+} from "../../models";
+import { Status } from "../../models/RestaurantClaim/RestaurantClaimRequest";
+import {
+  createMockRestaurantChain,
+  createMockRestaurantClaim,
+} from "./restaurant_claim_outcome_test_support";
+import sequelize from "../../config/db";
+
+jest.mock("../../models", () => ({
+  RestaurantClaimRequest: {
+    findByPk: jest.fn(),
+  },
+  RestaurantChain: {
+    findByPk: jest.fn(),
+  },
+  AdminUser: {
+    findAll: jest.fn(),
+  },
+  Notification: {
+    create: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Restaurant Claim Outcome Determinism - Single Verification Lifecycle", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe("Approving Restaurant Claim Requests", () => {
+    it("approves a pending claim request and transitions to Approved", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-101",
+        status: Status.Pending,
+        restaurant_chain_id: null,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      const result =
+        await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-101",
+          "approve",
+          "admin-1"
+        );
+
+      expect(result.status).toBe("Approved");
+      expect(mockClaim.status).toBe(Status.Approved);
+      expect(mockClaim.save).toHaveBeenCalled();
+    });
+
+    it("creates notification records for super admins upon approval", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-102",
+        status: Status.Pending,
+        restaurant_chain_id: null,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([
+        { id: "super-admin-1", is_super_admin: true },
+        { id: "super-admin-2", is_super_admin: true },
+      ]);
+
+      await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "claim-102",
+        "approve",
+        "admin-1"
+      );
+
+      expect(Notification.create).toHaveBeenCalledTimes(2);
+    });
+
+    it("verifies and synchronizes associated restaurant chain when chainId is present", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-103",
+        status: Status.Pending,
+        restaurant_chain_id: "chain-55",
+      });
+      const mockChain = createMockRestaurantChain({
+        id: "chain-55",
+        is_verified: false,
+      });
+
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+      (RestaurantChain.findByPk as jest.Mock).mockResolvedValue(mockChain);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "claim-103",
+        "approve",
+        "admin-1"
+      );
+
+      expect(mockChain.is_verified).toBe(true);
+      expect(mockChain.save).toHaveBeenCalled();
+    });
+
+    it("approving claim with null restaurant_chain_id does not query or save chain", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-104",
+        status: Status.Pending,
+        restaurant_chain_id: null,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "claim-104",
+        "approve",
+        "admin-1"
+      );
+
+      expect(RestaurantChain.findByPk).not.toHaveBeenCalled();
+    });
+
+    it("returns 409 when attempting to approve an already approved claim request", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-105",
+        status: Status.Approved,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+      await expect(
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-105",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("already in terminal state 'Approved'");
+    });
+
+    it("returns 409 when attempting to approve an already rejected claim request", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-106",
+        status: Status.Rejected,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+      await expect(
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-106",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("already in terminal state 'Rejected'");
+    });
+
+    it("returns 404 when claim request does not exist", async () => {
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(null);
+
+      await expect(
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-missing",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("Restaurant claim request not found");
+    });
+  });
+
+  describe("Rejecting Restaurant Claim Requests", () => {
+    it("rejects a pending claim request and transitions to Rejected with reason", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-201",
+        status: Status.Pending,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+      const result =
+        await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-201",
+          "reject",
+          "admin-1",
+          "Invalid documentation"
+        );
+
+      expect(result.status).toBe("Rejected");
+      expect(result.rejection_reason).toBe("Invalid documentation");
+      expect(mockClaim.status).toBe(Status.Rejected);
+      expect(mockClaim.save).toHaveBeenCalled();
+    });
+
+    it("rejects a pending claim request without reason when none provided", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-202",
+        status: Status.Pending,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+      const result =
+        await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-202",
+          "reject",
+          "admin-1"
+        );
+
+      expect(result.status).toBe("Rejected");
+      expect(result.rejection_reason).toBeNull();
+    });
+
+    it("returns 409 when attempting to reject an already rejected claim request", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-203",
+        status: Status.Rejected,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+      await expect(
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-203",
+          "reject",
+          "admin-1"
+        )
+      ).rejects.toThrow("already in terminal state 'Rejected'");
+    });
+
+    it("returns 409 when attempting to reject an already approved claim request", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-204",
+        status: Status.Approved,
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+      await expect(
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-204",
+          "reject",
+          "admin-1"
+        )
+      ).rejects.toThrow("already in terminal state 'Approved'");
+    });
+
+    it("returns 404 when claim request to reject is not found", async () => {
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(null);
+
+      await expect(
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-notfound",
+          "reject",
+          "admin-1"
+        )
+      ).rejects.toThrow("Restaurant claim request not found");
+    });
+  });
+
+  describe("Transactional Integrity", () => {
+    it("rolls back approval transaction if database save fails", async () => {
+      const mockClaim = createMockRestaurantClaim({
+        id: "claim-301",
+        status: Status.Pending,
+        save: jest.fn().mockRejectedValue(new Error("DB Connection Lost")),
+      });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+
+      await expect(
+        RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+          "claim-301",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("DB Connection Lost");
+    });
+
+    it("handles concurrent approval and rejection where first action wins deterministically", async () => {
+      const mockFn = jest
+        .fn()
+        .mockResolvedValueOnce({ id: "c-concurrent", status: "Approved" })
+        .mockRejectedValueOnce(new Error("already in terminal state 'Approved'"));
+
+      (RestaurantClaimOutcomeService.verifySingleClaimWithLock as jest.Mock) = mockFn;
+
+      const p1 = RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "c-concurrent",
+        "approve",
+        "admin-1"
+      );
+      const p2 = RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "c-concurrent",
+        "reject",
+        "admin-2"
+      );
+
+      const res = await Promise.allSettled([p1, p2]);
+      expect(res[0].status).toBe("fulfilled");
+      expect(res[1].status).toBe("rejected");
+    });
+
+    it("verifies single claim with external transaction without opening nested transaction", async () => {
+      const mockTx: any = { LOCK: { UPDATE: "UPDATE" } };
+      const mockClaim = createMockRestaurantClaim({ id: "c-ext", status: Status.Pending });
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(mockClaim);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      const result = await RestaurantClaimOutcomeService.verifySingleClaimWithLock(
+        "c-ext",
+        "approve",
+        "admin-1",
+        undefined,
+        mockTx
+      );
+
+      expect(result.status).toBe("Approved");
+    });
+
+    it("returns empty history when no claims exist for given restaurant filter", async () => {
+      (RestaurantClaimRequest.findByPk as jest.Mock).mockResolvedValue(null);
+      const history = await RestaurantClaimOutcomeService.queryVerificationHistory({
+        restaurantId: "non-existent-rest",
+      });
+      expect(history).toBeDefined();
+    });
+
+    it("counts claim requests accurately across pending, approved, and rejected", async () => {
+      const counts = await RestaurantClaimOutcomeService.getClaimStatusCounts();
+      expect(counts).toHaveProperty("pending");
+      expect(counts).toHaveProperty("approved");
+      expect(counts).toHaveProperty("rejected");
+    });
+  });
+});
