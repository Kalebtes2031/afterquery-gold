@@ -0,0 +1,332 @@
+import crypto from "crypto";
+import { Transaction, UniqueConstraintError } from "sequelize";
+import sequelize from "../config/db";
+import { HttpError } from "../utils/error-response.utils";
+import OrderIdempotencyKey, {
+  OrderIdempotencyStatus,
+} from "../models/Order/OrderIdempotencyKey";
+import { OrderType } from "../models/Order/Order";
+
+const MAX_IDEMPOTENCY_KEY_LENGTH = 128;
+const IDEMPOTENCY_KEY_HEADER = "idempotency-key";
+
+export type OrderItemInput = {
+  itemId: string;
+  quantity: number;
+};
+
+export type OrderCreationPayload = {
+  orderType?: OrderType;
+  estimatedWaitingTime?: number;
+  orderMessage?: string;
+  restaurantId: string;
+  items: OrderItemInput[];
+};
+
+type SerializableValue =
+  | string
+  | number
+  | boolean
+  | null
+  | SerializableValue[]
+  | { [key: string]: SerializableValue };
+
+export type OrderCreationResult = {
+  orderId: string;
+  replayed: boolean;
+};
+
+type CreateOrderCallback = (transaction: Transaction) => Promise<string>;
+
+export class InvalidIdempotencyKeyError extends HttpError {
+  constructor(message: string) {
+    super(message, 400, true);
+  }
+}
+
+export class IdempotencyConflictError extends HttpError {
+  constructor() {
+    super(
+      "This idempotency key was already used with a different order request",
+      409,
+      true
+    );
+  }
+}
+
+export class IdempotencyStateError extends HttpError {
+  constructor() {
+    super(
+      "The previous request for this idempotency key has not completed",
+      409,
+      true
+    );
+  }
+}
+
+/**
+ * Reads and validates the optional Idempotency-Key request header.
+ *
+ * Header names are case-insensitive in Express, so callers should pass the
+ * value returned by req.get("Idempotency-Key") rather than reading raw headers.
+ */
+export const parseIdempotencyKey = (
+  rawValue: string | string[] | undefined
+): string | undefined => {
+  if (rawValue === undefined) {
+    return undefined;
+  }
+
+  if (Array.isArray(rawValue)) {
+    throw new InvalidIdempotencyKeyError(
+      "Idempotency-Key must contain a single value"
+    );
+  }
+
+  const key = rawValue.trim();
+
+  if (!key) {
+    throw new InvalidIdempotencyKeyError("Idempotency-Key cannot be empty");
+  }
+
+  if (key.length > MAX_IDEMPOTENCY_KEY_LENGTH) {
+    throw new InvalidIdempotencyKeyError(
+      `Idempotency-Key cannot exceed ${MAX_IDEMPOTENCY_KEY_LENGTH} characters`
+    );
+  }
+
+  // Control characters are intentionally rejected. They are not useful as
+  // client-generated keys and can make logs and proxies behave unpredictably.
+  if (/[^\x20-\x7E]/.test(key)) {
+    throw new InvalidIdempotencyKeyError(
+      "Idempotency-Key must contain printable ASCII characters only"
+    );
+  }
+
+  return key;
+};
+
+const normalizeItems = (items: OrderItemInput[]): OrderItemInput[] => {
+  return items
+    .map((item) => ({
+      itemId: item.itemId,
+      quantity: item.quantity,
+    }))
+    .sort((left, right) => {
+      const idComparison = left.itemId.localeCompare(right.itemId);
+
+      if (idComparison !== 0) {
+        return idComparison;
+      }
+
+      return left.quantity - right.quantity;
+    });
+};
+
+/**
+ * Build the business representation used for idempotency comparisons.
+ *
+ * Object property ordering in JSON must not change the meaning of a request.
+ * Item ordering is also normalized because an order containing item A then B
+ * is the same business request as the same quantities sent as B then A.
+ */
+export const normalizeOrderPayload = (
+  payload: OrderCreationPayload
+): SerializableValue => {
+  return {
+    estimatedWaitingTime: payload.estimatedWaitingTime ?? null,
+    items: normalizeItems(payload.items),
+    orderMessage: payload.orderMessage ?? null,
+    orderType: payload.orderType ?? null,
+    restaurantId: payload.restaurantId,
+  };
+};
+
+const stableSerialize = (value: SerializableValue): string => {
+  if (value === null || typeof value !== "object") {
+    return JSON.stringify(value);
+  }
+
+  if (Array.isArray(value)) {
+    return `[${value.map((entry) => stableSerialize(entry)).join(",")}]`;
+  }
+
+  const entries = Object.entries(value).sort(([leftKey], [rightKey]) =>
+    leftKey.localeCompare(rightKey)
+  );
+
+  return `{${entries
+    .map(([key, entry]) => `${JSON.stringify(key)}:${stableSerialize(entry)}`)
+    .join(",")}}`;
+};
+
+export const hashOrderPayload = (payload: OrderCreationPayload): string => {
+  const canonicalPayload = stableSerialize(normalizeOrderPayload(payload));
+
+  return crypto.createHash("sha256").update(canonicalPayload).digest("hex");
+};
+
+const ensureMatchingRequest = (
+  record: OrderIdempotencyKey,
+  requestHash: string
+) => {
+  if (record.request_hash !== requestHash) {
+    throw new IdempotencyConflictError();
+  }
+};
+
+const replayCompletedRecord = (
+  record: OrderIdempotencyKey,
+  requestHash: string
+): OrderCreationResult => {
+  ensureMatchingRequest(record, requestHash);
+
+  if (record.status !== OrderIdempotencyStatus.Completed || !record.order_id) {
+    throw new IdempotencyStateError();
+  }
+
+  return {
+    orderId: record.order_id,
+    replayed: true,
+  };
+};
+
+const findExistingRecord = async (
+  userId: string,
+  idempotencyKey: string,
+  transaction?: Transaction
+): Promise<OrderIdempotencyKey | null> => {
+  return OrderIdempotencyKey.findOne({
+    where: {
+      user_id: userId,
+      idempotency_key: idempotencyKey,
+    },
+    transaction,
+    ...(transaction ? { lock: transaction.LOCK.UPDATE } : {}),
+  });
+};
+
+const recoverFromConcurrentInsert = async (
+  userId: string,
+  idempotencyKey: string,
+  requestHash: string
+): Promise<OrderCreationResult> => {
+  const existing = await findExistingRecord(userId, idempotencyKey);
+
+  if (!existing) {
+    // A uniqueness error without a visible winning row is unexpected. Do not
+    // turn it into a successful replay because there is no order to return.
+    throw new IdempotencyStateError();
+  }
+
+  return replayCompletedRecord(existing, requestHash);
+};
+
+/**
+ * Runs order creation atomically and adds optional request idempotency.
+ *
+ * When no key is supplied the callback still runs in a transaction so the
+ * Order and OrderItem records can be committed or rolled back as one unit.
+ * When a key is supplied, the idempotency row is created in that same
+ * transaction. A failed transaction therefore does not consume the key.
+ */
+export const createOrderWithIdempotency = async ({
+  userId,
+  idempotencyKey,
+  payload,
+  createOrder,
+}: {
+  userId: string;
+  idempotencyKey?: string;
+  payload: OrderCreationPayload;
+  createOrder: CreateOrderCallback;
+}): Promise<OrderCreationResult> => {
+  if (!idempotencyKey) {
+    const orderId = await sequelize.transaction(async (transaction) => {
+      return createOrder(transaction);
+    });
+
+    return {
+      orderId,
+      replayed: false,
+    };
+  }
+
+  const requestHash = hashOrderPayload(payload);
+
+  try {
+    return await sequelize.transaction(async (transaction) => {
+      const existing = await findExistingRecord(
+        userId,
+        idempotencyKey,
+        transaction
+      );
+
+      if (existing) {
+        return replayCompletedRecord(existing, requestHash);
+      }
+
+      /*
+       * findOrCreate handles the race where two requests both observe that
+       * the key does not exist and then attempt to insert it concurrently.
+       *
+       * With the outer transaction supplied, Sequelize uses a savepoint for
+       * the insert attempt. That allows a uniqueness conflict to be handled
+       * without leaving the outer PostgreSQL transaction in an aborted state.
+       */
+      const [record, created] = await OrderIdempotencyKey.findOrCreate({
+        where: {
+          user_id: userId,
+          idempotency_key: idempotencyKey,
+        },
+        defaults: {
+          user_id: userId,
+          idempotency_key: idempotencyKey,
+          request_hash: requestHash,
+          order_id: null,
+          status: OrderIdempotencyStatus.Processing,
+        },
+        transaction,
+      });
+
+      /*
+       * If another concurrent transaction won the insert race, findOrCreate
+       * returns its persisted record. By the time the uniqueness conflict is
+       * resolved, PostgreSQL has visibility into the winning transaction.
+       */
+      if (!created) {
+        return replayCompletedRecord(record, requestHash);
+      }
+
+      /*
+       * The new idempotency row, order, and order items all remain inside the
+       * same transaction. If createOrder fails, none of them are committed and
+       * the key remains usable for a later retry.
+       */
+      const orderId = await createOrder(transaction);
+
+      record.order_id = orderId;
+      record.status = OrderIdempotencyStatus.Completed;
+
+      await record.save({ transaction });
+
+      return {
+        orderId,
+        replayed: false,
+      };
+    });
+  } catch (error) {
+    /*
+     * Keep a defensive recovery path for uniqueness errors that escape
+     * findOrCreate. Recovery happens outside the failed transaction, so any
+     * winning committed idempotency record can be read safely.
+     */
+    if (error instanceof UniqueConstraintError) {
+      return recoverFromConcurrentInsert(userId, idempotencyKey, requestHash);
+    }
+
+    throw error;
+  }
+};