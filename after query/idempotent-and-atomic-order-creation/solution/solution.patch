diff --git a/rateeat_backend/src/services/order-creation.service.ts b/rateeat_backend/src/services/order-creation.service.ts
new file mode 100644
index 000000000..b603c1324
--- /dev/null
+++ b/rateeat_backend/src/services/order-creation.service.ts
@@ -0,0 +1,232 @@
+import { Transaction } from "sequelize";
+import {
+  AdminUser,
+  Item,
+  Notification,
+  Order,
+  Restaurant,
+  User,
+} from "../models";
+import OrderItem from "../models/Order/OrderItem";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import { io } from "../utils/socket.utils";
+import sendNotification from "../utils/notification.utils";
+import { OrderCreationPayload } from "./order-idempotency.service";
+
+export type PersistOrderInput = {
+  userId: string;
+  payload: OrderCreationPayload;
+  totalItems: number;
+  totalPrice: number;
+};
+
+export type OrderItemWithDetails = {
+  item_id: string;
+  quantity: number;
+  order_id: string;
+  restaurant_id: string;
+  item: {
+    name?: string;
+    price?: number;
+  };
+};
+
+type UserSummary = {
+  firstName?: string;
+  lastName?: string;
+  email?: string;
+  phoneNumber?: string;
+};
+
+/**
+ * Persists the order aggregate inside a caller-owned transaction.
+ *
+ * The transaction is required rather than optional. This makes it difficult
+ * for future callers to accidentally reintroduce the partial-write behavior
+ * where an Order exists but one or more OrderItem rows do not.
+ */
+export const persistOrderAggregate = async (
+  input: PersistOrderInput,
+  transaction: Transaction
+): Promise<string> => {
+  const { userId, payload, totalItems, totalPrice } = input;
+
+  const order = await Order.create(
+    {
+      order_type: payload.orderType,
+      total_number_of_items: totalItems,
+      total_price: totalPrice,
+      estimated_waiting_time: payload.estimatedWaitingTime,
+      order_message: payload.orderMessage,
+      user_id: userId,
+      restaurant_id: payload.restaurantId,
+    },
+    { transaction }
+  );
+
+  const orderItems = payload.items.map((item) => ({
+    item_id: item.itemId,
+    quantity: item.quantity,
+    order_id: order.id,
+    restaurant_id: payload.restaurantId,
+  }));
+
+  await OrderItem.bulkCreate(orderItems, { transaction });
+
+  return order.id;
+};
+
+export const getDetailedOrderItems = async (
+  orderId: string,
+  payload: OrderCreationPayload
+): Promise<OrderItemWithDetails[]> => {
+  const itemIds = payload.items.map((item) => item.itemId);
+  const itemDetails = await Item.findAll({
+    where: {
+      id: itemIds,
+    },
+    attributes: ["id", "name", "price"],
+  });
+
+  return payload.items.map((orderItem) => {
+    const itemDetail = itemDetails.find((item) => item.id === orderItem.itemId);
+
+    return {
+      item_id: orderItem.itemId,
+      quantity: orderItem.quantity,
+      order_id: orderId,
+      restaurant_id: payload.restaurantId,
+      item: {
+        name: itemDetail?.name,
+        price: itemDetail?.price,
+      },
+    };
+  });
+};
+
+const buildUserSummary = (user: User): UserSummary => ({
+  firstName: user.first_name,
+  lastName: user.last_name,
+  email: user.email,
+  phoneNumber: user.phone_number,
+});
+
+export const emitOrderCreatedEvents = ({
+  order,
+  orderItems,
+  user,
+}: {
+  order: Order;
+  orderItems: OrderItemWithDetails[];
+  user: User;
+}) => {
+  if (!io) {
+    return;
+  }
+
+  const userSummary = buildUserSummary(user);
+
+  io.to(`restaurant-${order.restaurant_id}`).emit("newOrder", {
+    order,
+    orderItems,
+    user: userSummary,
+  });
+
+  io.to(`user-${user.id}`).emit("orderCreated", {
+    userId: user.id,
+    order,
+    orderItems,
+  });
+};
+
+const notifyManager = async ({
+  recipientId,
+  order,
+  user,
+}: {
+  recipientId: string;
+  order: Order;
+  user: User;
+}) => {
+  const message = `New order from ${user.first_name} ${user.last_name}`;
+
+  await Notification.create({
+    notifiable_type: "Order",
+    notifiable_id: order.id,
+    user_id: recipientId,
+    reactor_id: user.id,
+    notification_category: NotificationCategory.Order,
+    message,
+  });
+
+  const adminUser = await AdminUser.findOne({
+    where: { id: recipientId },
+  });
+
+  await sendNotification(
+    adminUser?.fcm_token,
+    "New Order",
+    message,
+    "businessApp"
+  );
+};
+
+export const notifyRestaurantManagersOfNewOrder = async ({
+  order,
+  user,
+}: {
+  order: Order;
+  user: User;
+}) => {
+  const restaurant = await Restaurant.findByPk(order.restaurant_id);
+
+  if (!restaurant) {
+    return;
+  }
+
+  const recipients = new Set<string>();
+
+  if (restaurant.branch_manager_id) {
+    recipients.add(restaurant.branch_manager_id);
+  }
+
+  if (restaurant.order_manager_id) {
+    recipients.add(restaurant.order_manager_id);
+  }
+
+  // A restaurant can have the same person in both manager roles. Using a Set
+  // ensures that a single order does not create duplicate notifications.
+  await Promise.all(
+    Array.from(recipients).map((recipientId) =>
+      notifyManager({
+        recipientId,
+        order,
+        user,
+      })
+    )
+  );
+};
+
+/**
+ * Runs external side effects after the order transaction has committed.
+ *
+ * This function is deliberately separate from persistOrderAggregate. Socket,
+ * push-notification, or notification-table failures must never cause the
+ * database transaction that creates the order to be partially committed.
+ */
+export const dispatchOrderCreatedSideEffects = async ({
+  order,
+  orderItems,
+  user,
+}: {
+  order: Order;
+  orderItems: OrderItemWithDetails[];
+  user: User;
+}) => {
+  emitOrderCreatedEvents({ order, orderItems, user });
+
+  await notifyRestaurantManagersOfNewOrder({
+    order,
+    user,
+  });
+};
