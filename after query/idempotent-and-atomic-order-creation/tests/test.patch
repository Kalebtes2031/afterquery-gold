+import request from "supertest";
+
+jest.mock("../../utils/telegram.utils", () => ({
+  initializeTelegramClient: jest.fn(),
+  sendTelegramMessage: jest.fn(),
+  sendTelegramContactRequest: jest.fn(),
+  handleTelegramUpdate: jest.fn(),
+  getTelegramSessionString: jest.fn(() => ""),
+  setTelegramSessionString: jest.fn(),
+  checkTelegramHealth: jest.fn(async () => true),
+  disconnectTelegramClient: jest.fn(async () => undefined),
+}));
+
+jest.mock("../../utils/redis.utils", () => ({
+  __esModule: true,
+  default: {
+    get: jest.fn(),
+    set: jest.fn(),
+    setEx: jest.fn(),
+    del: jest.fn(),
+    keys: jest.fn(),
+    expire: jest.fn(),
+    sAdd: jest.fn(),
+    sMembers: jest.fn(),
+    multi: jest.fn(() => ({
+      exec: jest.fn(),
+    })),
+  },
+}));
+
+jest.mock("../../utils/slack-alerting", () => ({
+  sendSlackNotification: jest.fn(async () => undefined),
+}));
+
+const mockSocketEmit = jest.fn();
+
+const mockSocketTo = jest.fn(() => ({
+  emit: mockSocketEmit,
+}));
+
+const mockSocketsLeave = jest.fn();
+
+const mockSocketIn = jest.fn(() => ({
+  socketsLeave: mockSocketsLeave,
+}));
+
+jest.mock("../../utils/socket.utils", () => ({
+  io: {
+    to: mockSocketTo,
+    in: mockSocketIn,
+  },
+}));
+
+const mockSendNotification = jest.fn(async () => undefined);
+
+jest.mock("../../utils/notification.utils", () => ({
+  __esModule: true,
+  default: mockSendNotification,
+}));
+
+import app from "../../app";
+import sequelize from "../../config/db";
+
+import {
+  USER_ID,
+  USER_2_ID,
+  RESTAURANT_ID,
+  RESTAURANT_2_ID,
+  ITEM_1,
+  ITEM_2,
+  MANAGER_ID,
+  token,
+  token2,
+  createDatabasePool,
+  clearOrders,
+  installFailingOrderItemTrigger,
+  removeFailingOrderItemTrigger,
+  runOrderInFreshProcess,
+  seedOrderTestFixtures,
+} from "./order_real_db_test_support";
+
+const pool = createDatabasePool();
+const observerPool = createDatabasePool();
+
+beforeEach(() => {
+  mockSocketTo.mockImplementation(() => ({
+    emit: mockSocketEmit,
+  }));
+
+  mockSocketIn.mockImplementation(() => ({
+    socketsLeave: mockSocketsLeave,
+  }));
+
+  mockSendNotification.mockImplementation(async () => undefined);
+});
+
+beforeAll(async () => {
+  await clearOrders(pool);
+  await seedOrderTestFixtures(pool);
+});
+
+afterAll(async () => {
+  await clearOrders(pool);
+  await pool.end();
+  await observerPool.end();
+  await sequelize.close();
+});
+
+describe("real PostgreSQL order atomicity and side effects", () => {
+  it("rolls back the order and leaves a failed idempotency key retryable", async () => {
+    const key = `gold-rollback-${Date.now()}`;
+    const orderMessage = `Gold rollback ${Date.now()}`;
+
+    const body = {
+      orderType: "DineIn",
+      estimatedWaitingTime: 30,
+      orderMessage,
+      restaurantId: RESTAURANT_ID,
+      items: [
+        { itemId: ITEM_1, quantity: 1 },
+        { itemId: ITEM_2, quantity: 2 },
+      ],
+    };
+
+    try {
+      await installFailingOrderItemTrigger(pool);
+
+      const failed = await request(app)
+        .post("/api/v1/orders")
+        .set("Authorization", `Bearer ${token}`)
+        .set("Idempotency-Key", key)
+        .send(body);
+
+      expect(failed.status).toBe(500);
+
+      const afterFailure = await pool.query(
+        `
+        SELECT id
+        FROM orders
+        WHERE user_id = $1
+          AND order_message = $2
+      `,
+        [USER_ID, orderMessage]
+      );
+
+      expect(afterFailure.rowCount).toBe(0);
+    } finally {
+      await removeFailingOrderItemTrigger(pool);
+    }
+
+    const retry = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .set("Idempotency-Key", key)
+      .send(body);
+
+    expect(retry.status).toBe(201);
+    expect(retry.headers["idempotency-replayed"]).toBe("false");
+    expect(retry.body.success).toBe(true);
+
+    const durableOrders = await pool.query(
+      `
+      SELECT id
+      FROM orders
+      WHERE user_id = $1
+        AND order_message = $2
+    `,
+      [USER_ID, orderMessage]
+    );
+
+    expect(durableOrders.rowCount).toBe(1);
+    expect(durableOrders.rows[0].id).toBe(retry.body.data.id);
+
+    const durableItems = await pool.query(
+      `
+      SELECT item_id, quantity
+      FROM order_items
+      WHERE order_id = $1
+      ORDER BY item_id
+    `,
+      [retry.body.data.id]
+    );
+
+    expect(durableItems.rowCount).toBe(2);
+    expect(
+      durableItems.rows.map((row) => ({
+        itemId: row.item_id,
+        quantity: Number(row.quantity),
+      }))
+    ).toEqual([
+      { itemId: ITEM_1, quantity: 1 },
+      { itemId: ITEM_2, quantity: 2 },
+    ]);
+  });
+  it("rolls back an unkeyed order when order-item persistence fails", async () => {
+    const orderMessage = `Gold unkeyed rollback ${Date.now()}`;
+
+    const body = {
+      orderType: "DineIn",
+      estimatedWaitingTime: 30,
+      orderMessage,
+      restaurantId: RESTAURANT_ID,
+      items: [
+        { itemId: ITEM_1, quantity: 1 },
+        { itemId: ITEM_2, quantity: 2 },
+      ],
+    };
+
+    try {
+      await installFailingOrderItemTrigger(pool);
+
+      const failed = await request(app)
+        .post("/api/v1/orders")
+        .set("Authorization", `Bearer ${token}`)
+        .send(body);
+
+      expect(failed.status).toBe(500);
+
+      const durableOrders = await pool.query(
+        `
+        SELECT id
+        FROM orders
+        WHERE user_id = $1
+          AND order_message = $2
+      `,
+        [USER_ID, orderMessage]
+      );
+
+      expect(durableOrders.rowCount).toBe(0);
+    } finally {
+      await removeFailingOrderItemTrigger(pool);
+    }
+  });
+  it("does not repeat order-created side effects when a keyed request is replayed", async () => {
+    const key = `gold-side-effects-${Date.now()}`;
+    const orderMessage = `Gold side effects ${Date.now()}`;
+
+    const body = {
+      orderType: "DineIn",
+      estimatedWaitingTime: 20,
+      orderMessage,
+      restaurantId: RESTAURANT_ID,
+      items: [{ itemId: ITEM_1, quantity: 1 }],
+    };
+
+    const first = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .set("Idempotency-Key", key)
+      .send(body);
+
+    expect(first.status).toBe(201);
+    expect(first.headers["idempotency-replayed"]).toBe("false");
+
+    const orderId = first.body.data.id;
+
+    expect(mockSocketEmit).toHaveBeenCalledTimes(2);
+
+    expect(mockSocketEmit).toHaveBeenCalledWith("newOrder", expect.any(Object));
+
+    expect(mockSocketEmit).toHaveBeenCalledWith(
+      "orderCreated",
+      expect.any(Object)
+    );
+
+    expect(mockSendNotification).toHaveBeenCalledTimes(1);
+
+    const notificationsAfterFirst = await pool.query(
+      `
+      SELECT id, notifiable_id, user_id, reactor_id, notification_category
+      FROM notifications
+      WHERE notifiable_type = 'Order'
+        AND notifiable_id = $1
+        AND user_id = $2
+    `,
+      [orderId, MANAGER_ID]
+    );
+
+    expect(notificationsAfterFirst.rowCount).toBe(1);
+    expect(notificationsAfterFirst.rows[0].reactor_id).toBe(USER_ID);
+    expect(notificationsAfterFirst.rows[0].notification_category).toBe("Order");
+
+    const replay = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .set("Idempotency-Key", key)
+      .send(body);
+
+    expect(replay.status).toBe(201);
+    expect(replay.headers["idempotency-replayed"]).toBe("true");
+    expect(replay.body.data.id).toBe(orderId);
+
+    // Replay must not emit either socket event again.
+    expect(mockSocketEmit).toHaveBeenCalledTimes(2);
+
+    // Replay must not send another push notification.
+    expect(mockSendNotification).toHaveBeenCalledTimes(1);
+
+    // Replay must not persist another manager notification.
+    const notificationsAfterReplay = await pool.query(
+      `
+      SELECT id
+      FROM notifications
+      WHERE notifiable_type = 'Order'
+        AND notifiable_id = $1
+        AND user_id = $2
+    `,
+      [orderId, MANAGER_ID]
+    );
+
+    expect(notificationsAfterReplay.rowCount).toBe(1);
+  });
+  it("does not emit order-created side effects when the order transaction rolls back", async () => {
+    const key = `gold-side-effect-rollback-${Date.now()}`;
+    const orderMessage = `Gold side-effect rollback ${Date.now()}`;
+
+    const body = {
+      orderType: "DineIn",
+      estimatedWaitingTime: 20,
+      orderMessage,
+      restaurantId: RESTAURANT_ID,
+      items: [{ itemId: ITEM_1, quantity: 1 }],
+    };
+
+    try {
+      await installFailingOrderItemTrigger(pool);
+
+      const failed = await request(app)
+        .post("/api/v1/orders")
+        .set("Authorization", `Bearer ${token}`)
+        .set("Idempotency-Key", key)
+        .send(body);
+
+      expect(failed.status).toBe(500);
+
+      expect(mockSocketEmit).not.toHaveBeenCalled();
+      expect(mockSendNotification).not.toHaveBeenCalled();
+
+      const orders = await pool.query(
+        `
+        SELECT id
+        FROM orders
+        WHERE user_id = $1
+          AND order_message = $2
+      `,
+        [USER_ID, orderMessage]
+      );
+
+      expect(orders.rowCount).toBe(0);
+
+      const notifications = await pool.query(
+        `
+        SELECT id
+        FROM notifications
+        WHERE reactor_id = $1
+          AND message = $2
+      `,
+        [USER_ID, "New order from Gold Tester"]
+      );
+
+      /*
+       * There may be notifications from earlier successful tests with the same
+       * generic message, so verify none can be associated with this failed order
+       * by looking for an order created by this request.
+       */
+      expect(orders.rowCount).toBe(0);
+    } finally {
+      await removeFailingOrderItemTrigger(pool);
+    }
+
+    // The failed key must still be usable, and side effects should happen
+    // exactly once when the retry finally commits.
+    const retry = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .set("Idempotency-Key", key)
+      .send(body);
+
+    expect(retry.status).toBe(201);
+    expect(retry.headers["idempotency-replayed"]).toBe("false");
+
+    expect(mockSocketEmit).toHaveBeenCalledTimes(2);
+    expect(mockSendNotification).toHaveBeenCalledTimes(1);
+
+    const notificationsAfterRetry = await pool.query(
+      `
+      SELECT id
+      FROM notifications
+      WHERE notifiable_type = 'Order'
+        AND notifiable_id = $1
+        AND user_id = $2
+    `,
+      [retry.body.data.id, MANAGER_ID]
+    );
+
+    expect(notificationsAfterRetry.rowCount).toBe(1);
+  });
+  it("runs manager notification side effects only after the order commit is externally visible", async () => {
+    const orderMessage = `Gold after commit ${Date.now()}`;
+
+    let observedOrderId: string | undefined;
+
+    let resolveObservation!: () => void;
+    let rejectObservation!: (error: unknown) => void;
+
+    const observationFinished = new Promise<void>((resolve, reject) => {
+      resolveObservation = resolve;
+      rejectObservation = reject;
+    });
+
+    mockSendNotification.mockImplementation(async () => {
+      try {
+        const visibleOrder = await observerPool.query(
+          `
+        SELECT id
+        FROM orders
+        WHERE user_id = $1
+          AND order_message = $2
+        `,
+          [USER_ID, orderMessage]
+        );
+
+        expect(visibleOrder.rowCount).toBe(1);
+
+        observedOrderId = visibleOrder.rows[0].id;
+
+        const visibleItems = await observerPool.query(
+          `
+        SELECT item_id, quantity
+        FROM order_items
+        WHERE order_id = $1
+        `,
+          [observedOrderId]
+        );
+
+        expect(visibleItems.rowCount).toBe(1);
+        expect(visibleItems.rows[0].item_id).toBe(ITEM_1);
+        expect(Number(visibleItems.rows[0].quantity)).toBe(1);
+
+        resolveObservation();
+      } catch (error) {
+        rejectObservation(error);
+      }
+    });
+
+    const response = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .send({
+        orderType: "DineIn",
+        estimatedWaitingTime: 20,
+        orderMessage,
+        restaurantId: RESTAURANT_ID,
+        items: [{ itemId: ITEM_1, quantity: 1 }],
+      });
+
+    expect(response.status).toBe(201);
+
+    await Promise.race([
+      observationFinished,
+      new Promise<never>((_, reject) =>
+        setTimeout(
+          () =>
+            reject(new Error("manager notification side effect did not run")),
+          5000
+        )
+      ),
+    ]);
+
+    expect(mockSendNotification).toHaveBeenCalledTimes(1);
+    expect(observedOrderId).toBe(response.body.data.id);
+  });
+});
