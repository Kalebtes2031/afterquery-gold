+export async function clearOrders(pool: Pool) {
+  const userIds = [USER_ID, USER_2_ID];
+
+  await pool.query(
+    `
+      DELETE FROM order_items
+      WHERE order_id IN (
+        SELECT id
+        FROM orders
+        WHERE user_id = ANY($1::uuid[])
+      )
+    `,
+    [userIds]
+  );
+
+  await pool.query(
+    `
+      DELETE FROM orders
+      WHERE user_id = ANY($1::uuid[])
+    `,
+    [userIds]
+  );
+}
+
+export async function installFailingOrderItemTrigger(pool: Pool) {
+  await pool.query(`
+    CREATE OR REPLACE FUNCTION gold_fail_order_item_insert()
+    RETURNS trigger AS $$
+    BEGIN
+      RAISE EXCEPTION 'gold forced order_items failure';
+    END;
+    $$ LANGUAGE plpgsql;
+  `);
+
+  await pool.query(`
+    DROP TRIGGER IF EXISTS gold_fail_order_item_insert_trigger
+    ON order_items;
+  `);
+
+  await pool.query(`
+    CREATE TRIGGER gold_fail_order_item_insert_trigger
+    BEFORE INSERT ON order_items
+    FOR EACH ROW
+    EXECUTE FUNCTION gold_fail_order_item_insert();
+  `);
+}
+
+export async function removeFailingOrderItemTrigger(pool: Pool) {
+  await pool.query(`
+    DROP TRIGGER IF EXISTS gold_fail_order_item_insert_trigger
+    ON order_items;
+  `);
+
+  await pool.query(`
+    DROP FUNCTION IF EXISTS gold_fail_order_item_insert();
+  `);
+}
+
+export const runOrderInFreshProcess = (
+  key: string,
+  body: Record<string, unknown>
+) => {
+  const workerPath = path.join(__dirname, "order_process_worker.ts");
+
+  const child = spawnSync(
+    process.execPath,
+    ["-r", "ts-node/register/transpile-only", workerPath],
+    {
+      cwd: process.cwd(),
+      encoding: "utf8",
+      timeout: 30000,
+      env: {
+        ...process.env,
+        NODE_ENV: "development",
+        JWT_SECRET: process.env.JWT_SECRET || "gold-test-secret",
+        GOLD_ORDER_TOKEN: token,
+        GOLD_IDEMPOTENCY_KEY: key,
+        GOLD_ORDER_BODY: JSON.stringify(body),
+      },
+    }
+  );
+
+  if (child.status !== 0) {
+    throw new Error(
+      [
+        `fresh order process exited with ${child.status}`,
+        `stdout: ${child.stdout}`,
+        `stderr: ${child.stderr}`,
+      ].join("\n")
+    );
+  }
+
+  const marker = "__GOLD_RESULT__";
+  const markerIndex = child.stdout.lastIndexOf(marker);
+
+  if (markerIndex === -1) {
+    throw new Error(`worker result marker missing:\n${child.stdout}`);
+  }
+
+  return JSON.parse(child.stdout.slice(markerIndex + marker.length));
+};
