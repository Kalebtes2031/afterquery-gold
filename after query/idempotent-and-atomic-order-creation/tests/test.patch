+import express from "express";
+import request from "supertest";
+import sequelize from "../../config/db";
+import orderRouter from "../../routes/order.route";
+
+async function main() {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/orders", orderRouter);
+
+  app.use((err: any, _req: any, res: any, _next: any) => {
+    res.status(err.statusCode || 500).json({
+      success: false,
+      message: err.message,
+    });
+  });
+
+  const token = process.env.GOLD_ORDER_TOKEN;
+  const key = process.env.GOLD_IDEMPOTENCY_KEY;
+  const body = JSON.parse(process.env.GOLD_ORDER_BODY || "{}");
+
+  if (!token || !key) {
+    throw new Error("GOLD_ORDER_TOKEN and GOLD_IDEMPOTENCY_KEY are required");
+  }
+
+  const response = await request(app)
+    .post("/api/v1/orders")
+    .set("Authorization", `Bearer ${token}`)
+    .set("Idempotency-Key", key)
+    .send(body);
+
+  process.stdout.write(
+    `__GOLD_RESULT__${JSON.stringify({
+      status: response.status,
+      headers: {
+        replayed: response.headers["idempotency-replayed"],
+      },
+      body: response.body,
+    })}`
+  );
+  await sequelize.close();
+}
+
+main()
+  .then(() => process.exit(0))
+  .catch(async (error) => {
+    console.error(error);
+    try {
+      await sequelize.close();
+    } catch {}
+    process.exit(1);
+  });
