+
+describe("real PostgreSQL order API smoke test", () => {
+  it("creates an order through HTTP and exposes it through order history", async () => {
+    const created = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .send({
+        orderType: "DineIn",
+        estimatedWaitingTime: 20,
+        orderMessage: "Gold integration smoke test",
+        restaurantId: RESTAURANT_ID,
+        items: [
+          { itemId: ITEM_1, quantity: 2 },
+          { itemId: ITEM_2, quantity: 1 },
+        ],
+      });
+
+    expect(created.status).toBe(201);
+    expect(created.body.success).toBe(true);
+    expect(created.body.data?.id).toBeTruthy();
+
+    const orderId = created.body.data.id;
+
+    const history = await request(app)
+      .get("/api/v1/orders/history?limit=20")
+      .set("Authorization", `Bearer ${token}`);
+
+    expect(history.status).toBe(200);
+    expect(history.body.success).toBe(true);
+
+    expect(history.body.data.some((order: any) => order.id === orderId)).toBe(
+      true
+    );
+  });
+  it("replays a keyed order after the application process is restarted", () => {
+    const key = `gold-process-replay-${Date.now()}`;
+
+    const body = {
+      orderType: "DineIn",
+      estimatedWaitingTime: 20,
+      orderMessage: `Gold process durability ${Date.now()}`,
+      restaurantId: RESTAURANT_ID,
+      items: [
+        { itemId: ITEM_1, quantity: 2 },
+        { itemId: ITEM_2, quantity: 1 },
+      ],
+    };
+
+    const firstProcess = runOrderInFreshProcess(key, body);
+    const secondProcess = runOrderInFreshProcess(key, body);
+
+    expect(firstProcess.status).toBe(201);
+    expect(firstProcess.headers.replayed).toBe("false");
+    expect(firstProcess.body.success).toBe(true);
+
+    expect(secondProcess.status).toBe(201);
+    expect(secondProcess.headers.replayed).toBe("true");
+    expect(secondProcess.body).toEqual(firstProcess.body);
+
+    expect(secondProcess.body.data.id).toBe(firstProcess.body.data.id);
+  });
+  it("creates only one durable order when equivalent keyed requests arrive concurrently", async () => {
+    const key = `gold-concurrent-${Date.now()}`;
+
+    const body = {
+      orderType: "DineIn",
+      estimatedWaitingTime: 25,
+      orderMessage: `Gold concurrent ${Date.now()}`,
+      restaurantId: RESTAURANT_ID,
+      items: [
+        { itemId: ITEM_1, quantity: 2 },
+        { itemId: ITEM_2, quantity: 3 },
+      ],
+    };
+
+    const makeRequest = () =>
+      request(app)
+        .post("/api/v1/orders")
+        .set("Authorization", `Bearer ${token}`)
+        .set("Idempotency-Key", key)
+        .send(body);
+
+    const [first, second] = await Promise.all([makeRequest(), makeRequest()]);
+    if (first.status !== 201 || second.status !== 201) {
+      throw new Error(
+        JSON.stringify(
+          {
+            first: {
+              status: first.status,
+              body: first.body,
+            },
+            second: {
+              status: second.status,
+              body: second.body,
+            },
+          },
+          null,
+          2
+        )
+      );
+    }
+
+    expect(first.status).toBe(201);
+    expect(second.status).toBe(201);
+
+    expect(first.body.success).toBe(true);
+    expect(second.body.success).toBe(true);
+
+    expect(first.body.data.id).toBe(second.body.data.id);
+
+    const replayHeaders = [
+      first.headers["idempotency-replayed"],
+      second.headers["idempotency-replayed"],
+    ].sort();
+
+    expect(replayHeaders).toEqual(["false", "true"]);
+
+    const orders = await pool.query(
+      `
+      SELECT id
+      FROM orders
+      WHERE user_id = $1
+        AND order_message = $2
+    `,
+      [USER_ID, body.orderMessage]
+    );
+
+    expect(orders.rowCount).toBe(1);
+    expect(orders.rows[0].id).toBe(first.body.data.id);
+
+    const items = await pool.query(
+      `
+      SELECT item_id, quantity
+      FROM order_items
+      WHERE order_id = $1
+      ORDER BY item_id
+    `,
+      [first.body.data.id]
+    );
+
+    expect(items.rowCount).toBe(2);
+
+    expect(
+      items.rows.map((row) => ({
+        itemId: row.item_id,
+        quantity: Number(row.quantity),
+      }))
+    ).toEqual([
+      { itemId: ITEM_1, quantity: 2 },
+      { itemId: ITEM_2, quantity: 3 },
+    ]);
+  });
+  it("rejects reuse of an idempotency key for a different order", async () => {
+    const key = `gold-conflict-${Date.now()}`;
+    const originalMessage = `Gold original ${Date.now()}`;
+    const conflictingMessage = `Gold conflicting ${Date.now()}`;
+
+    const originalBody = {
+      orderType: "DineIn",
+      estimatedWaitingTime: 20,
+      orderMessage: originalMessage,
+      restaurantId: RESTAURANT_ID,
+      items: [
+        { itemId: ITEM_1, quantity: 1 },
+        { itemId: ITEM_2, quantity: 1 },
+      ],
+    };
+
+    const first = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .set("Idempotency-Key", key)
+      .send(originalBody);
+
+    expect(first.status).toBe(201);
+    expect(first.headers["idempotency-replayed"]).toBe("false");
+
+    const conflicting = await request(app)
+      .post("/api/v1/orders")
+      .set("Authorization", `Bearer ${token}`)
+      .set("Idempotency-Key", key)
+      .send({
+        ...originalBody,
+        orderMessage: conflictingMessage,
+      });
+
+    expect(conflicting.status).toBe(409);
+    expect(conflicting.body.success).toBe(false);
