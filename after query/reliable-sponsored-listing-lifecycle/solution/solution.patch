index 000000000..334fdf0c2
--- /dev/null
+++ b/rateeat_backend/src/utils/featured-restaurant-availability.utils.ts
@@ -0,0 +1,308 @@
+import {
+  FEATURED_RESTAURANT_AVAILABILITY_BROWSE,
+  FEATURED_RESTAURANT_AVAILABILITY_ORDERABLE,
+  FEATURED_RESTAURANT_CURSOR_REQUIRES_LIMIT_MESSAGE,
+  FEATURED_RESTAURANT_DEFAULT_AVAILABILITY,
+  FEATURED_RESTAURANT_INVALID_AVAILABILITY_MESSAGE,
+  FEATURED_RESTAURANT_INVALID_CURSOR_MESSAGE,
+  FEATURED_RESTAURANT_INVALID_LIMIT_MESSAGE,
+  FEATURED_RESTAURANT_MAX_LIMIT,
+  FEATURED_RESTAURANT_MIN_LIMIT,
+  FEATURED_RESTAURANT_INVALID_REQUEST_ID_MESSAGE,
+  FEATURED_RESTAURANT_LIMIT_REQUIRES_REQUEST_ID_MESSAGE,
+  FEATURED_RESTAURANT_REQUEST_ID_REQUIRES_LIMIT_MESSAGE,
+} from "../constants/featured-restaurant-availability.constants";
+import {
+  FeaturedListingShape,
+  FeaturedRestaurantAvailability,
+  FeaturedRestaurantAvailabilityState,
+  FeaturedRestaurantQueryResult,
+} from "../types/featured-restaurant-availability.types";
+
+const invalid = (message: string) => ({
+  ok: false as const,
+  message,
+});
+
+export const parseFeaturedRestaurantAvailability = (
+  value: unknown
+):
+  | { ok: true; value: FeaturedRestaurantAvailability }
+  | { ok: false; message: string } => {
+  if (value === undefined) {
+    return {
+      ok: true,
+      value: FEATURED_RESTAURANT_DEFAULT_AVAILABILITY,
+    };
+  }
+
+  if (
+    value === FEATURED_RESTAURANT_AVAILABILITY_BROWSE ||
+    value === FEATURED_RESTAURANT_AVAILABILITY_ORDERABLE
+  ) {
+    return {
+      ok: true,
+      value,
+    };
+  }
+
+  return invalid(FEATURED_RESTAURANT_INVALID_AVAILABILITY_MESSAGE);
+};
+
+export const parseFeaturedRestaurantLimit = (
+  value: unknown
+):
+  | { ok: true; value?: number }
+  | { ok: false; message: string } => {
+  if (value === undefined) return { ok: true };
+
+  if (
+    typeof value !== "string" &&
+    typeof value !== "number"
+  ) {
+    return invalid(FEATURED_RESTAURANT_INVALID_LIMIT_MESSAGE);
+  }
+
+  const raw = String(value);
+
+  if (!/^\d+$/.test(raw)) {
+    return invalid(FEATURED_RESTAURANT_INVALID_LIMIT_MESSAGE);
+  }
+
+  const parsed = Number(raw);
+
+  if (
+    !Number.isSafeInteger(parsed) ||
+    parsed < FEATURED_RESTAURANT_MIN_LIMIT ||
+    parsed > FEATURED_RESTAURANT_MAX_LIMIT
+  ) {
+    return invalid(FEATURED_RESTAURANT_INVALID_LIMIT_MESSAGE);
+  }
+
+  return {
+    ok: true,
+    value: parsed,
+  };
+};
+
+export const parseFeaturedRestaurantCursorQuery = (
+  value: unknown
+):
+  | { ok: true; value?: string }
+  | { ok: false; message: string } => {
+  if (value === undefined) return { ok: true };
+
+  return typeof value === "string" && value.length > 0
+    ? { ok: true, value }
+    : invalid(FEATURED_RESTAURANT_INVALID_CURSOR_MESSAGE);
+};
+
+const FEATURED_REQUEST_ID_PATTERN =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+export const parseFeaturedRestaurantRequestId = (
+  value: unknown
+):
+  | { ok: true; value?: string }
+  | { ok: false; message: string } => {
+  if (value === undefined) {
+    return { ok: true };
+  }
+
+  if (
+    typeof value !== "string" ||
+    !FEATURED_REQUEST_ID_PATTERN.test(value)
+  ) {
+    return {
+      ok: false,
+      message:
+        FEATURED_RESTAURANT_INVALID_REQUEST_ID_MESSAGE,
+    };
+  }
+
+  return {
+    ok: true,
+    value: value.toLowerCase(),
+  };
+};
+
+export const parseFeaturedRestaurantQuery = (query: {
+  availability?: unknown;
+  limit?: unknown;
+  cursor?: unknown;
+  requestId?: unknown;
+}): FeaturedRestaurantQueryResult => {
+  const availability =
+    parseFeaturedRestaurantAvailability(
+      query.availability
+    );
+
+  if (availability.ok === false) {
+    return {
+      ok: false,
+      status: 400,
+      message: availability.message,
+    };
+  }
+
+  const limit =
+    parseFeaturedRestaurantLimit(
+      query.limit
+    );
+
+  if (limit.ok === false) {
+    return {
+      ok: false,
+      status: 400,
+      message: limit.message,
+    };
+  }
+
+  const cursor =
+    parseFeaturedRestaurantCursorQuery(
+      query.cursor
+    );
+
+  if (cursor.ok === false) {
+    return {
+      ok: false,
+      status: 400,
+      message: cursor.message,
+    };
+  }
+
+  const requestId =
+    parseFeaturedRestaurantRequestId(
+      query.requestId
+    );
+
+  if (requestId.ok === false) {
+    return {
+      ok: false,
+      status: 400,
+      message: requestId.message,
+    };
+  }
+
+  if (
+    cursor.value !== undefined &&
+    limit.value === undefined
+  ) {
+    return {
+      ok: false,
+      status: 400,
+      message:
+        FEATURED_RESTAURANT_CURSOR_REQUIRES_LIMIT_MESSAGE,
+    };
+  }
+
+  if (
+    requestId.value !== undefined &&
+    limit.value === undefined
+  ) {
+    return {
+      ok: false,
+      status: 400,
+      message:
+        FEATURED_RESTAURANT_REQUEST_ID_REQUIRES_LIMIT_MESSAGE,
+    };
+  }
+
+  if (
+    limit.value !== undefined &&
+    requestId.value === undefined
+  ) {
+    return {
+      ok: false,
+      status: 400,
+      message:
+        FEATURED_RESTAURANT_LIMIT_REQUIRES_REQUEST_ID_MESSAGE,
+    };
+  }
+
+  return {
+    ok: true,
+    query: {
+      availability:
+        availability.value,
+      limit: limit.value,
+      cursor: cursor.value,
+      requestId: requestId.value,
+    },
+  };
+};
+
+
+export const isFeaturedRestaurantEligible = (
+  restaurant:
+    | FeaturedRestaurantAvailabilityState
+    | null
+    | undefined,
+  availability: FeaturedRestaurantAvailability
+): boolean => {
+  if (
+    !restaurant ||
+    restaurant.is_permanently_closed === true
+  ) {
+    return false;
+  }
+
+  if (
+    availability ===
+    FEATURED_RESTAURANT_AVAILABILITY_BROWSE
+  ) {
+    return true;
+  }
+
+  return (
+    restaurant.is_order_service_available === true &&
+    restaurant.is_order_service_online === true
+  );
+};
+
+export const featuredListingPriority = (
+  listing: FeaturedListingShape
+): number => {
+  const value = Number(listing.priority ?? 0);
+
+  return Number.isFinite(value)
+    ? value
+    : 0;
+};
+
+export const featuredListingEndTimestamp = (
+  listing: FeaturedListingShape
+): number => {
+  const value =
+    new Date(listing.end_date).getTime();
+
+  return Number.isFinite(value)
+    ? value
+    : Number.POSITIVE_INFINITY;
+};
+
+export const compareFeaturedListings = (
+  left: FeaturedListingShape,
+  right: FeaturedListingShape
+): number => {
+  const priority =
+    featuredListingPriority(right) -
+    featuredListingPriority(left);
+
+  if (priority) return priority;
+
+  const end =
+    featuredListingEndTimestamp(left) -
+    featuredListingEndTimestamp(right);
+
+  return end ||
+    String(left.id).localeCompare(String(right.id));
+};
+
+export const preferredFeaturedListing = (
+  current: FeaturedListingShape,
+  candidate: FeaturedListingShape
+): FeaturedListingShape =>
+  compareFeaturedListings(candidate, current) < 0
+    ? candidate
+    : current;