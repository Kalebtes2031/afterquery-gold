+import {
+  FEATURED_RESTAURANT_AVAILABILITY_BROWSE,
+  FEATURED_RESTAURANT_AVAILABILITY_ORDERABLE,
+} from "../constants/featured-restaurant-availability.constants";
+export type FeaturedRestaurantAvailability =
+  | typeof FEATURED_RESTAURANT_AVAILABILITY_BROWSE
+  | typeof FEATURED_RESTAURANT_AVAILABILITY_ORDERABLE;
+export type FeaturedRestaurantQuery = {
+  availability: FeaturedRestaurantAvailability;
+  limit?: number;
+  cursor?: string;
+  requestId?: string;
+};
+export type FeaturedRestaurantQueryResult =
+  | {
+      ok: true;
+      query: FeaturedRestaurantQuery;
+    }
+  | {
+      ok: false;
+      status: 400;
+      message: string;
+    };
+export type FeaturedRestaurantAvailabilityState = {
+  is_permanently_closed?: boolean | null;
+  is_order_service_available?: boolean | null;
+  is_order_service_online?: boolean | null;
+};
+export type FeaturedRestaurantPublicShape =
+  FeaturedRestaurantAvailabilityState & {
+    id?: string;
+    name?: string;
+    restaurant_locations?: unknown[];
+    [key: string]: unknown;
+  };
+export type FeaturedListingShape = {
+  id: string;
+  restaurant_id: string;
+  priority?: number | null;
+  end_date: Date | string;
+  restaurant?: FeaturedRestaurantPublicShape | null;
+  toJSON?: () => Record<string, unknown>;
+  [key: string]: unknown;
+};
+export type FeaturedRestaurantSelectionOptions = {
+  availability: FeaturedRestaurantAvailability;
+};
+export type FeaturedRestaurantDisplayDecoration = {
+  remainingTime: {
+    days: number;
+    hours: number;
+    minutes: number;
+    seconds: number;
+  };
+  restaurant_logo: string | null;
+};
+export type FeaturedRestaurantCursorPayload = {
+  v: 3;
+  snapshotId: string;
+  position: number;
+};
+export type FeaturedRestaurantLimitedResponseBody = {
+  success: true;
+  data: Record<string, unknown>[];
+  nextCursor: string | null;
+};
+
+export type FeaturedRestaurantPageResult =
+  | {
+      ok: true;
+      body: FeaturedRestaurantLimitedResponseBody;
+    }
+  | {
+      ok: false;
+      message: string;
+    };
diff --git a/rateeat_backend/src/utils/featured-restaurant-availability.utils.ts b/rateeat_backend/src/utils/featured-restaurant-availability.utils.ts
