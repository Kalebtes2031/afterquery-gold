+import { RestaurantImage } from "../models";
+import {
+  FeaturedListingShape,
+  FeaturedRestaurantDisplayDecoration,
+} from "../types/featured-restaurant-availability.types";
+import { buildFeaturedRestaurantResponse } from "./featured-restaurant-availability.service";
+export const calculateFeaturedRemainingTime = (
+  endDate: Date | string,
+  now: Date
+): FeaturedRestaurantDisplayDecoration["remainingTime"] => {
+  const remainingTime = Math.max(
+    0,
+    new Date(endDate).getTime() - now.getTime()
+  );
+  return {
+    days: Math.floor(remainingTime / (1000 * 60 * 60 * 24)),
+    hours: Math.floor((remainingTime / (1000 * 60 * 60)) % 24),
+    minutes: Math.floor((remainingTime / (1000 * 60)) % 60),
+    seconds: Math.floor((remainingTime / 1000) % 60),
+  };
+};
+export const findFeaturedRestaurantLogo = async (
+  restaurantId: string
+): Promise<string | null> => {
+  let restaurantImage = await RestaurantImage.findOne({
+    where: {
+      restaurant_id: restaurantId,
+      is_leading: true,
+    },
+  });
+  if (!restaurantImage) {
+    restaurantImage = await RestaurantImage.findOne({
+      where: {
+        restaurant_id: restaurantId,
+        is_leading: false,
+      },
+    });
+  }
+  return restaurantImage ? restaurantImage.url : null;
+};
+export const decorateFeaturedRestaurantListing = async (
+  listing: FeaturedListingShape,
+  now: Date
+): Promise<Record<string, unknown>> => {
+  const restaurantLogo = await findFeaturedRestaurantLogo(listing.restaurant_id);
+  return buildFeaturedRestaurantResponse(listing, {
+    remainingTime: calculateFeaturedRemainingTime(listing.end_date, now),
+    restaurant_logo: restaurantLogo,
+  });
+};
