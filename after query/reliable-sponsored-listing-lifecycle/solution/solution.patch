@@ -0,0 +1,111 @@
+import {
+  FEATURED_RESTAURANT_INTERNAL_AVAILABILITY_FIELDS,
+} from "../constants/featured-restaurant-availability.constants";
+import {
+  FeaturedListingShape,
+  FeaturedRestaurantDisplayDecoration,
+  FeaturedRestaurantPublicShape,
+  FeaturedRestaurantSelectionOptions,
+} from "../types/featured-restaurant-availability.types";
+import {
+  compareFeaturedListings,
+  isFeaturedRestaurantEligible,
+} from "../utils/featured-restaurant-availability.utils";
+const listingRestaurant = (
+  listing: FeaturedListingShape
+): FeaturedRestaurantPublicShape | null | undefined =>
+  listing.restaurant;
+export const filterFeaturedListingsByRestaurantAvailability = (
+  listings: FeaturedListingShape[],
+  options: FeaturedRestaurantSelectionOptions
+): FeaturedListingShape[] =>
+  listings.filter((listing) =>
+    isFeaturedRestaurantEligible(
+      listingRestaurant(listing),
+      options.availability
+    )
+  );
+export const collapseFeaturedListingsByRestaurant = (
+  listings: FeaturedListingShape[]
+): FeaturedListingShape[] => {
+  const winners =
+    new Map<string, FeaturedListingShape>();
+  for (const listing of listings) {
+    const restaurantId =
+      String(listing.restaurant_id);
+    const current =
+      winners.get(restaurantId);
+    if (!current) {
+      winners.set(restaurantId, listing);
+      continue;
+    }
+    if (
+      compareFeaturedListings(
+        listing,
+        current
+      ) < 0
+    ) {
+      winners.set(restaurantId, listing);
+    }
+  }
+  return Array.from(winners.values());
+};
+export const selectFeaturedRestaurantListings = (
+  listings: FeaturedListingShape[],
+  options: FeaturedRestaurantSelectionOptions
+): FeaturedListingShape[] => {
+  const eligible =
+    filterFeaturedListingsByRestaurantAvailability(
+      listings,
+      options
+    );
+  return collapseFeaturedListingsByRestaurant(
+    eligible
+  ).sort(compareFeaturedListings);
+};
+const serializedListing = (
+  listing: FeaturedListingShape
+): Record<string, unknown> => {
+  if (typeof listing.toJSON === "function") {
+    return listing.toJSON();
+  }
+  return { ...listing };
+};
+const removeInternalRestaurantAvailability = (
+  restaurant: unknown
+): unknown => {
+  if (
+    !restaurant ||
+    typeof restaurant !== "object" ||
+    Array.isArray(restaurant)
+  ) {
+    return restaurant;
+  }
+  const publicRestaurant = {
+    ...(restaurant as Record<string, unknown>),
+  };
+  for (
+    const field of
+    FEATURED_RESTAURANT_INTERNAL_AVAILABILITY_FIELDS
+  ) {
+    delete publicRestaurant[field];
+  }
+  return publicRestaurant;
+};
+export const buildFeaturedRestaurantResponse = (
+  listing: FeaturedListingShape,
+  decoration: FeaturedRestaurantDisplayDecoration
+): Record<string, unknown> => {
+  const serialized =
+    serializedListing(listing);
+  return {
+    ...serialized,
+    restaurant:
+      removeInternalRestaurantAvailability(
+        serialized.restaurant
+      ),
+    remainingTime: decoration.remainingTime,
+    restaurant_logo:
+      decoration.restaurant_logo,
+  };
+};
