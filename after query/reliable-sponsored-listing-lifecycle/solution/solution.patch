+import {
+  createHmac,
+  randomUUID,
+  timingSafeEqual,
+} from "crypto";
+import {
+  QueryTypes,
+  Transaction,
+} from "sequelize";
+
+import {
+  FEATURED_RESTAURANT_INVALID_CURSOR_MESSAGE,
+  FEATURED_RESTAURANT_INVALID_REQUEST_ID_MESSAGE,
+} from "../constants/featured-restaurant-availability.constants";
+import SponsoredListing from "../models/SponsoredListing/SponsoredListing";
+import {
+  FeaturedListingShape,
+  FeaturedRestaurantAvailability,
+  FeaturedRestaurantCursorPayload,
+  FeaturedRestaurantLimitedResponseBody,
+  FeaturedRestaurantPageResult,
+} from "../types/featured-restaurant-availability.types";
+import {
+  decorateFeaturedRestaurantListing,
+} from "./featured-restaurant-display.service";
+
+const CURSOR_VERSION = 3 as const;
+const MAX_CURSOR_LENGTH = 512;
+const SNAPSHOT_TTL_MS =
+  15 * 60 * 1000;
+
+type SnapshotRow = {
+  id: string;
+  listingIds: string[];
+  availability:
+    FeaturedRestaurantAvailability;
+  pageLimit: number;
+  currentPosition: number;
+  expiresAt: Date | string;
+};
+
+type RequestRow = {
+  requestId: string;
+  snapshotId: string;
+  availability:
+    FeaturedRestaurantAvailability;
+  pageLimit: number;
+  cursorToken: string | null;
+  responseBody:
+    | FeaturedRestaurantLimitedResponseBody
+    | string;
+  expiresAt: Date | string;
+};
+
+type RequestBinding = {
+  requestId: string;
+  availability:
+    FeaturedRestaurantAvailability;
+  limit: number;
+  rawCursor?: string;
+  now: Date;
+};
+
+const invalidCursor = () => ({
+  ok: false as const,
+  message:
+    FEATURED_RESTAURANT_INVALID_CURSOR_MESSAGE,
+});
+
+const invalidRequest = () => ({
+  ok: false as const,
+  message:
+    FEATURED_RESTAURANT_INVALID_REQUEST_ID_MESSAGE,
+});
+
+const cursorSecret = (): string =>
+  process.env.JWT_SECRET ||
+  "rateeat-featured-restaurant-cursor";
+
+const sign = (
+  value: string
+): string =>
+  createHmac(
+    "sha256",
+    cursorSecret()
+  )
+    .update(value)
+    .digest("base64url");
+
+const signaturesEqual = (
+  left: string,
+  right: string
+): boolean => {
+  const leftBuffer =
+    Buffer.from(left, "utf8");
+
+  const rightBuffer =
+    Buffer.from(right, "utf8");
+
+  return (
+    leftBuffer.length ===
+      rightBuffer.length &&
+    timingSafeEqual(
+      leftBuffer,
+      rightBuffer
+    )
+  );
+};
+
+const encodeCursor = (
+  payload:
+    FeaturedRestaurantCursorPayload
+): string => {
+  const encoded = Buffer.from(
+    JSON.stringify(payload),
+    "utf8"
+  ).toString("base64url");
+
+  return `${encoded}.${sign(encoded)}`;
+};
+
+export const createFeaturedRestaurantCursor = (
+  snapshotId: string,
+  position: number
+): string =>
+  encodeCursor({
+    v: CURSOR_VERSION,
+    snapshotId,
+    position,
+  });
+
+export const decodeFeaturedRestaurantCursor = (
+  cursor: string
+):
+  | {
+      ok: true;
+      value:
+        FeaturedRestaurantCursorPayload;
+    }
+  | {
+      ok: false;
+      message: string;
+    } => {
+  if (
+    !cursor ||
+    cursor.length > MAX_CURSOR_LENGTH
+  ) {
+    return invalidCursor();
+  }
+
+  const parts = cursor.split(".");
+
+  if (
+    parts.length !== 2 ||
+    !parts[0] ||
+    !parts[1]
+  ) {
+    return invalidCursor();
+  }
+
+  const [encoded, signature] =
+    parts;
+
+  const expected =
+    sign(encoded);
+
+  if (
+    !signaturesEqual(
+      signature,
+      expected
+    )
+  ) {
+    return invalidCursor();
+  }
+
+  let decoded: unknown;
+
+  try {
+    decoded = JSON.parse(
+      Buffer.from(
+        encoded,
+        "base64url"
+      ).toString("utf8")
+    );
+  } catch {
+    return invalidCursor();
+  }
+
+  if (
+    !decoded ||
+    typeof decoded !== "object" ||
+    Array.isArray(decoded)
+  ) {
+    return invalidCursor();
+  }
+
+  const candidate =
+    decoded as Partial<
+      FeaturedRestaurantCursorPayload
+    >;
+
+  if (
+    candidate.v !==
+      CURSOR_VERSION ||
+    typeof candidate.snapshotId !==
+      "string" ||
+    !candidate.snapshotId ||
+    !Number.isInteger(
+      candidate.position
+    ) ||
+    (candidate.position as number) <
+      0
+  ) {
+    return invalidCursor();
+  }
+
+  return {
+    ok: true,
+    value: {
+      v: CURSOR_VERSION,
+      snapshotId:
+        candidate.snapshotId,
+      position:
+        candidate.position as number,
+    },
+  };
+};
+
+const db = () => {
+  const sequelize =
+    SponsoredListing.sequelize;
+
+  if (!sequelize) {
+    throw new Error(
+      "SponsoredListing model is not initialized"
+    );
+  }
+
+  return sequelize;
+};
+
+const parseStoredBody = (
+  value:
+    | FeaturedRestaurantLimitedResponseBody
+    | string
+): FeaturedRestaurantLimitedResponseBody => {
+  if (
+    typeof value === "string"
+  ) {
+    return JSON.parse(
+      value
+    ) as FeaturedRestaurantLimitedResponseBody;
+  }
+
+  return value;
+};
+
+const loadRequest = async (
+  requestId: string,
+  transaction?: Transaction
+): Promise<RequestRow | null> => {
+  const rows =
+    await db().query<RequestRow>(
+      `
+        SELECT
+          request_id AS "requestId",
+          snapshot_id AS "snapshotId",
+          availability,
+          page_limit AS "pageLimit",
+          cursor_token AS "cursorToken",
+          response_body AS "responseBody",
+          expires_at AS "expiresAt"
+        FROM featured_restaurant_page_requests
+        WHERE request_id = :requestId
+        LIMIT 1
+      `,
+      {
+        replacements: {
+          requestId,
+        },
+        type: QueryTypes.SELECT,
+        transaction,
+      }
+    );
+
+  return rows[0] ?? null;
+};
+
+const replay = (
+  row: RequestRow,
+  binding: RequestBinding
+): FeaturedRestaurantPageResult => {
+  if (
+    new Date(
+      row.expiresAt
+    ).getTime() <=
+    binding.now.getTime()
+  ) {
+    return binding.rawCursor
+      ? invalidCursor()
+      : invalidRequest();
+  }
+
+  if (
+    row.availability !==
+      binding.availability ||
+    Number(row.pageLimit) !==
+      binding.limit ||
+    (row.cursorToken ?? undefined) !==
+      binding.rawCursor
+  ) {
+    return invalidRequest();
+  }
+
+  return {
+    ok: true,
+    body:
+      parseStoredBody(
+        row.responseBody
+      ),
+  };
+};
+
+const createSnapshot = async (
+  listings:
+    FeaturedListingShape[],
+  availability:
+    FeaturedRestaurantAvailability,
+  limit: number,
+  now: Date,
+  transaction: Transaction
+): Promise<SnapshotRow> => {
+  const snapshot: SnapshotRow = {
+    id: randomUUID(),
+    listingIds:
+      listings.map(
+        ({ id }) =>
+          String(id)
+      ),
+    availability,
+    pageLimit: limit,
+    currentPosition: -1,
+    expiresAt: new Date(
+      now.getTime() +
+        SNAPSHOT_TTL_MS
+    ),
+  };
+
+  await db().query(
+    `
+      INSERT INTO featured_restaurant_snapshots (
+        id,
+        listing_ids,
+        availability,
+        page_limit,
+        current_position,
+        expires_at,
+        "createdAt",
+        "updatedAt"
+      )
+      VALUES (
+        :id,
+        CAST(:listingIds AS JSONB),
+        :availability,
+        :pageLimit,
+        -1,
+        :expiresAt,
+        :now,
+        :now
+      )
+    `,
+    {
+      replacements: {
+        id: snapshot.id,
+        listingIds:
+          JSON.stringify(
+            snapshot.listingIds
+          ),
+        availability,
+        pageLimit: limit,
+        expiresAt:
+          snapshot.expiresAt,
+        now,
+      },
+      transaction,
+    }
+  );
+
+  return snapshot;
+};
+
+const loadSnapshotForUpdate =
+  async (
+    id: string,
+    transaction: Transaction
+  ): Promise<
+    SnapshotRow | null
+  > => {
+    const rows =
+      await db().query<SnapshotRow>(
+        `
+          SELECT
+            id,
+            listing_ids AS "listingIds",
+            availability,
+            page_limit AS "pageLimit",
+            current_position AS "currentPosition",
+            expires_at AS "expiresAt"
+          FROM featured_restaurant_snapshots
+          WHERE id = :id
+          FOR UPDATE
+        `,
+        {
+          replacements: {
+            id,
+          },
+          type: QueryTypes.SELECT,
+          transaction,
+        }
+      );
+
+    return rows[0] ?? null;
+  };
+
+const advanceSnapshot = async (
+  id: string,
+  position: number,
+  now: Date,
+  transaction: Transaction
+) => {
+  await db().query(
+    `
+      UPDATE featured_restaurant_snapshots
+      SET
+        current_position = :position,
+        "updatedAt" = :now
+      WHERE id = :id
+    `,
+    {
+      replacements: {
+        id,
+        position,
+        now,
+      },
+      transaction,
+    }
+  );
+};
+
+const persistRequest = async ({
+  binding,
+  snapshot,
+  body,
+  transaction,
+}: {
+  binding: RequestBinding;
+  snapshot: SnapshotRow;
+  body:
+    FeaturedRestaurantLimitedResponseBody;
+  transaction: Transaction;
+}) => {
+  await db().query(
+    `
+      INSERT INTO featured_restaurant_page_requests (
+        request_id,
+        snapshot_id,
+        availability,
+        page_limit,
+        cursor_token,
+        response_body,
+        expires_at,
+        "createdAt",
+        "updatedAt"
+      )
+      VALUES (
+        :requestId,
+        :snapshotId,
+        :availability,
+        :pageLimit,
+        :cursorToken,
+        CAST(:responseBody AS JSONB),
+        :expiresAt,
+        :now,
+        :now
+      )
+    `,
+    {
+      replacements: {
+        requestId:
+          binding.requestId,
+        snapshotId:
+          snapshot.id,
+        availability:
+          binding.availability,
+        pageLimit:
+          binding.limit,
+        cursorToken:
+          binding.rawCursor ??
+          null,
+        responseBody:
+          JSON.stringify(body),
+        expiresAt:
+          snapshot.expiresAt,
+        now:
+          binding.now,
+      },
+      transaction,
+    }
+  );
+};
+
+const snapshotValid = (
+  snapshot: SnapshotRow,
+  binding: RequestBinding
+) =>
+  snapshot.availability ===
+    binding.availability &&
+  Number(
+    snapshot.pageLimit
+  ) === binding.limit &&
+  new Date(
+    snapshot.expiresAt
+  ).getTime() >
+    binding.now.getTime();
+
+const buildPage = ({
+  snapshot,
+  listings,
+  limit,
+  start,
+}: {
+  snapshot: SnapshotRow;
+  listings:
+    FeaturedListingShape[];
+  limit: number;
+  start: number;
+}) => {
+  const listingById =
+    new Map(
+      listings.map(
+        (listing) => [
+          String(listing.id),
+          listing,
+        ]
+      )
+    );
+
+  const page:
+    FeaturedListingShape[] = [];
+
+  let position = start;
+  let lastExamined =
+    start - 1;
+
+  while (
+    position <
+      snapshot.listingIds.length &&
+    page.length < limit
+  ) {
+    lastExamined = position;
+
+    const listing =
+      listingById.get(
+        snapshot.listingIds[
+          position
+        ]
+      );
+
+    if (listing) {
+      page.push(listing);
+    }
+
+    position += 1;
+  }
+
+  let hasMore = false;
+
+  if (
+    page.length === limit
+  ) {
+    while (
+      position <
+      snapshot.listingIds.length
+    ) {
+      const listing =
+        listingById.get(
+          snapshot.listingIds[
+            position
+          ]
+        );
+
+      if (listing) {
+        hasMore = true;
+        break;
+      }
+
+      lastExamined =
+        position;
+
+      position += 1;
+    }
+  }
+
+  return {
+    page,
+    lastExamined,
+    hasMore,
+  };
+};
+
+const isUniqueViolation = (
+  error: unknown
+): boolean => {
+  const candidate =
+    error as {
+      parent?: {
+        code?: string;
+      };
+      original?: {
+        code?: string;
+      };
+    };
+
+  return (
+    candidate.parent?.code ===
+      "23505" ||
+    candidate.original?.code ===
+      "23505"
+  );
+};
+
+export const paginateFeaturedRestaurantListings =
+  async ({
+    listings,
+    limit,
+    availability,
+    cursor,
+    rawCursor,
+    requestId,
+    now,
+  }: {
+    listings:
+      FeaturedListingShape[];
+    limit: number;
+    availability:
+      FeaturedRestaurantAvailability;
+    cursor?:
+      FeaturedRestaurantCursorPayload;
+    rawCursor?: string;
+    requestId: string;
+    now: Date;
+  }): Promise<
+    FeaturedRestaurantPageResult
+  > => {
+    const binding:
+      RequestBinding = {
+      requestId,
+      availability,
+      limit,
+      rawCursor,
+      now,
+    };
+
+    try {
+      return await db().transaction(
+        async (
+          transaction
+        ) => {
+          const existing =
+            await loadRequest(
+              requestId,
+              transaction
+            );
+
+          if (existing) {
+            return replay(
+              existing,
+              binding
+            );
+          }
+
+          let snapshot:
+            | SnapshotRow
+            | null;
+
+          if (cursor) {
+            snapshot =
+              await loadSnapshotForUpdate(
+                cursor.snapshotId,
+                transaction
+              );
+
+            if (
+              !snapshot ||
+              !snapshotValid(
+                snapshot,
+                binding
+              )
+            ) {
+              return invalidCursor();
+            }
+
+            const afterLock =
+              await loadRequest(
+                requestId,
+                transaction
+              );
+
+            if (afterLock) {
+              return replay(
+                afterLock,
+                binding
+              );
+            }
+
+            if (
+              Number(
+                snapshot.currentPosition
+              ) !==
+                cursor.position ||
+              cursor.position >=
+                snapshot.listingIds
+                  .length
+            ) {
+              return invalidCursor();
+            }
+          } else {
+            snapshot =
+              await createSnapshot(
+                listings,
+                availability,
+                limit,
+                now,
+                transaction
+              );
+          }
+
+          const start =
+            cursor
+              ? cursor.position + 1
+              : 0;
+
+          const {
+            page,
+            lastExamined,
+            hasMore,
+          } = buildPage({
+            snapshot,
+            listings,
+            limit,
+            start,
+          });
+
+          const nextCursor =
+            hasMore
+              ? createFeaturedRestaurantCursor(
+                  snapshot.id,
+                  lastExamined
+                )
+              : null;
+
+          const data =
+            await Promise.all(
+              page.map(
+                (listing) =>
+                  decorateFeaturedRestaurantListing(
+                    listing,
+                    now
+                  )
+              )
+            );
+
+          const body:
+            FeaturedRestaurantLimitedResponseBody =
+            {
+              success: true,
+              data,
+              nextCursor,
+            };
+
+          await persistRequest({
+            binding,
+            snapshot,
+            body,
+            transaction,
+          });
+
+          if (
+            lastExamined >= 0
+          ) {
+            await advanceSnapshot(
+              snapshot.id,
+              lastExamined,
+              now,
+              transaction
+            );
+          }
+
+          return {
+            ok: true as const,
+            body,
+          };
+        }
+      );
+    } catch (error) {
+      if (
+        !isUniqueViolation(
+          error
+        )
+      ) {
+        throw error;
+      }
+
+      const existing =
+        await loadRequest(
+          requestId
+        );
+
+      if (existing) {
+        return replay(
+          existing,
+          binding
+        );
+      }
+
+      return rawCursor
+        ? invalidCursor()
+        : invalidRequest();
+    }
+  };
