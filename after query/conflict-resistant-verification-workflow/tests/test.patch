+export function createMockCandidateRestaurant(overrides: any = {}) {
+  return {
+    id: overrides.id || "cand-uuid-1",
+    name: overrides.name || "Test Candidate Restaurant",
+    is_approved: overrides.is_approved !== undefined ? overrides.is_approved : null,
+    address: overrides.address || "123 Main St",
+    phone_number: overrides.phone_number || "555-0100",
+    candidate_restaurant_images: overrides.candidate_restaurant_images || [],
+    candidate_restaurant_videos: overrides.candidate_restaurant_videos || [],
+    save: jest.fn().mockResolvedValue(true),
+    update: jest.fn().mockResolvedValue(true),
+    ...overrides,
+  };
+}
+
+export function createMockRestaurant(overrides: any = {}) {
+  return {
+    id: overrides.id || "rest-uuid-1",
+    name: overrides.name || "Active Restaurant",
+    is_active: overrides.is_active || true,
+    ...overrides,
+  };
+}
+
+export function createMockRestaurantMedia(overrides: any = {}) {
+  return {
+    id: overrides.id || "media-uuid-1",
+    restaurant_id: overrides.restaurant_id || "rest-uuid-1",
+    url: overrides.url || "https://img.example.com/default.jpg",
+    media_type: overrides.media_type || "image",
+    save: jest.fn().mockResolvedValue(true),
+    ...overrides,
+  };
+}
