--- /dev/null
+++ b/rateeat_backend/src/__tests__/unit/candidate_restaurant_verification_behavior.test.ts
@@ -0,0 +1,705 @@
+import express from "express";
+import request from "supertest";
+
+import Database from "../db_setup";
+import candidateRestaurantRouter from "../../routes/candidate_restaurant.route";
+import { errorHandler } from "../../middlewares/error-handler";
+import {
+  CandidateRestaurant,
+  Notification,
+  Restaurant,
+  RestaurantImage,
+} from "../../models";
+
+/**
+ * Behavioural coverage for the candidate-restaurant verification workflow —
+ * the single `/review` endpoint, the atomic `/batch-review` endpoint and the
+ * `/metrics` endpoint. Everything is exercised over the real router against a
+ * real PostgreSQL database: requests go in as HTTP and the expectations are the
+ * HTTP response plus the rows that actually landed in the database.
+ */
+
+const REVIEWER_ID = "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a101";
+const ROLE_ID = "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a102";
+const ADMIN_1 = "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a111";
+const ADMIN_2 = "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a112";
+const ADMIN_3 = "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a113";
+const ALL_ADMINS = [ADMIN_1, ADMIN_2, ADMIN_3];
+
+const CAND_A = "b1b1b1b1-b1b1-4b1b-8b1b-b1b1b1b1b101";
+const CAND_B = "b1b1b1b1-b1b1-4b1b-8b1b-b1b1b1b1b102";
+const MISSING = "b1b1b1b1-b1b1-4b1b-8b1b-b1b1b1b1b199";
+
+const NAME_PREFIX = "CRVW Verify";
+const NAME_A = `${NAME_PREFIX} Alpha`;
+const NAME_B = `${NAME_PREFIX} Bravo`;
+
+jest.mock("../../middlewares/auth", () => ({
+  protectRoute: (req: any, _res: any, next: any) => {
+    req.user = { id: "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a101" };
+    next();
+  },
+  protectRouteForAdmin: (req: any, _res: any, next: any) => {
+    req.user = { id: "a1a1a1a1-a1a1-4a1a-8a1a-a1a1a1a1a101" };
+    next();
+  },
+  optionalAuth: (_req: any, _res: any, next: any) => next(),
+}));
+
+const app = express();
+app.use(express.json());
+app.use("/api/v1/candidate-restaurants", candidateRestaurantRouter);
+app.use(errorHandler);
+
+const review = (id: string, body: any) =>
+  request(app).put(`/api/v1/candidate-restaurants/${id}/review`).send(body);
+
+const batch = (body: any) =>
+  request(app).put("/api/v1/candidate-restaurants/batch-review").send(body);
+
+const metrics = () =>
+  request(app).get("/api/v1/candidate-restaurants/metrics").send();
+
+let sequelize: Awaited<ReturnType<typeof Database.getInstance>>;
+
+const run = (sql: string, replacements: any[] = []) =>
+  sequelize.query(sql, { replacements });
+
+const wipe = async () => {
+  await run(`DELETE FROM notifications WHERE reactor_id = ?`, [REVIEWER_ID]);
+  await run(
+    `DELETE FROM restaurant_images WHERE restaurant_id IN
+       (SELECT id FROM restaurants WHERE name LIKE '${NAME_PREFIX}%')`
+  );
+  await run(`DELETE FROM restaurants WHERE name LIKE '${NAME_PREFIX}%'`);
+  await run(
+    `DELETE FROM candidate_restaurant_menu_images WHERE candidate_restaurant_id IN
+       (SELECT id FROM candidate_restaurants WHERE name LIKE '${NAME_PREFIX}%')`
+  );
+  await run(`DELETE FROM candidate_restaurants WHERE name LIKE '${NAME_PREFIX}%'`);
+};
+
+const seedAdmins = async (ids: string[]) => {
+  for (const id of ids) {
+    const tail = id.replace(/-/g, "").slice(-12);
+    const digits = id.replace(/\D/g, "").slice(-11);
+    await run(
+      `INSERT INTO admin_users
+         (id, first_name, last_name, email, password, phone_number, role_id,
+          "createdAt", "updatedAt")
+       VALUES (?, 'CRVW', 'Admin', ?, 'x', ?, ?, NOW(), NOW())
+       ON CONFLICT (id) DO NOTHING`,
+      [id, `crvw-${tail}@ex.co`, `+9${digits}`, ROLE_ID]
+    );
+  }
+};
+
+const removeAdmins = async (ids: string[]) => {
+  for (const id of ids) {
+    await run(`DELETE FROM admin_users WHERE id = ?`, [id]);
+  }
+};
+
+const seedCandidate = async (
+  id: string,
+  name: string,
+  overrides: { is_approved?: boolean; is_rejected?: boolean } = {}
+) => {
+  const { is_approved = false, is_rejected = false } = overrides;
+  await run(
+    `INSERT INTO candidate_restaurants
+       (id, name, description, opening_hour, closing_hour, is_open,
+        is_approved, is_rejected, user_id, candidate_admin_user_id,
+        "createdAt", "updatedAt")
+     VALUES (?, ?, 'seeded description', '07:30:00', '22:15:00', false,
+             ?, ?, NULL, NULL, NOW(), NOW())`,
+    [id, name, is_approved, is_rejected]
+  );
+};
+
+const addMenuImage = async (candidateId: string, url: string) => {
+  await run(
+    `INSERT INTO candidate_restaurant_menu_images
+       (id, candidate_restaurant_id, url, "createdAt", "updatedAt")
+     VALUES (gen_random_uuid(), ?, ?, NOW(), NOW())`,
+    [candidateId, url]
+  );
+};
+
+const notificationsByReviewer = () =>
+  Notification.findAll({ where: { reactor_id: REVIEWER_ID } });
+
+const rejectionReasonRow = async (id: string) => {
+  const [rows]: any = await run(
+    `SELECT is_rejected, rejection_reason FROM candidate_restaurants WHERE id = ?`,
+    [id]
+  );
+  return rows[0];
+};
+
+beforeAll(async () => {
+  sequelize = await Database.getInstance();
+  await run(
+    `INSERT INTO roles (id, name, "createdAt", "updatedAt")
+     VALUES (?, 'crvw-verify-role', NOW(), NOW()) ON CONFLICT (id) DO NOTHING`,
+    [ROLE_ID]
+  );
+});
+
+afterAll(async () => {
+  await wipe();
+  await removeAdmins([REVIEWER_ID, ...ALL_ADMINS]);
+  await run(`DELETE FROM roles WHERE id = ?`, [ROLE_ID]);
+  await Database.close();
+});
+
+beforeEach(async () => {
+  jest.clearAllMocks();
+  await wipe();
+  await removeAdmins(ALL_ADMINS);
+  await seedAdmins([ADMIN_1]);
+});
+
+describe("Candidate Restaurant Verification - Single Review Endpoint", () => {
+  it("approves a pending candidate, creates the restaurant and copies media", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+    await addMenuImage(CAND_A, "https://cdn.example/a.jpg");
+    await addMenuImage(CAND_A, "https://cdn.example/b.jpg");
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(200);
+    expect(res.body.success).toBe(true);
+    expect(res.body.data).toMatchObject({
+      candidate_restaurant_id: CAND_A,
+      status: "approved",
+      rejection_reason: null,
+      reviewed_by: REVIEWER_ID,
+    });
+    expect(res.body.data.restaurant_id).toEqual(expect.any(String));
+
+    const candidate = await CandidateRestaurant.findByPk(CAND_A);
+    expect(candidate?.is_approved).toBe(true);
+
+    const restaurant = await Restaurant.findByPk(res.body.data.restaurant_id);
+    expect(restaurant?.name).toBe(NAME_A);
+
+    const images = await RestaurantImage.findAll({
+      where: { restaurant_id: res.body.data.restaurant_id },
+    });
+    expect(images).toHaveLength(2);
+  });
+
+  it("creates the restaurant open and copies the candidate description and hours", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(200);
+    const restaurant = await Restaurant.findByPk(res.body.data.restaurant_id);
+    expect(restaurant?.description).toBe("seeded description");
+    expect(restaurant?.is_open).toBe(true);
+    expect(String(restaurant?.opening_hour)).toBe("07:30:00");
+    expect(String(restaurant?.closing_hour)).toBe("22:15:00");
+  });
+
+  it("serializes two concurrent reviews of the same candidate so one wins", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const [first, second] = await Promise.all([
+      review(CAND_A, { action: "approve" }),
+      review(CAND_A, { action: "reject" }),
+    ]);
+    expect([first.status, second.status].sort()).toEqual([200, 409]);
+
+    const loser = [first, second].find((r) => r.status === 409)!;
+    expect(loser.body.success).toBe(false);
+    expect(loser.body.statusCode).toBe(409);
+
+    const candidate = await CandidateRestaurant.findByPk(CAND_A);
+    expect(candidate?.is_approved !== candidate?.is_rejected).toBe(true);
+    expect(await Restaurant.count({ where: { name: NAME_A } })).toBe(
+      candidate?.is_approved ? 1 : 0
+    );
+  });
+
+  it("writes one notification per admin user on approval", async () => {
+    await seedAdmins([ADMIN_2, ADMIN_3]);
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(200);
+    const notes = await notificationsByReviewer();
+    expect(notes).toHaveLength(3);
+    expect(notes.map((n) => n.user_id).sort()).toEqual([...ALL_ADMINS].sort());
+  });
+
+  it("rejects a pending candidate and stores the trimmed rejection reason", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, {
+      action: "reject",
+      rejectionReason: "  incomplete menu photos  ",
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data).toMatchObject({
+      status: "rejected",
+      rejection_reason: "incomplete menu photos",
+      restaurant_id: null,
+    });
+
+    const row = await rejectionReasonRow(CAND_A);
+    expect(row.is_rejected).toBe(true);
+    expect(row.rejection_reason).toBe("incomplete menu photos");
+    expect(await Restaurant.count({ where: { name: NAME_A } })).toBe(0);
+  });
+
+  it("does not create restaurant images when the candidate has no media", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(200);
+    expect(
+      await RestaurantImage.count({
+        where: { restaurant_id: res.body.data.restaurant_id },
+      })
+    ).toBe(0);
+  });
+
+  it("returns 404 when the candidate restaurant does not exist", async () => {
+    const res = await review(MISSING, { action: "approve" });
+
+    expect(res.status).toBe(404);
+    expect(res.body.success).toBe(false);
+    expect(res.body.statusCode).toBe(404);
+    expect(await Restaurant.count({ where: { name: NAME_A } })).toBe(0);
+  });
+
+  it("returns 409 when the candidate was already approved", async () => {
+    await seedCandidate(CAND_A, NAME_A, { is_approved: true });
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(409);
+    expect(res.body.success).toBe(false);
+    expect(res.body.statusCode).toBe(409);
+    expect(res.body.message).toMatch(/approved/i);
+  });
+
+  it("returns 409 when the candidate was already rejected", async () => {
+    await seedCandidate(CAND_A, NAME_A, { is_rejected: true });
+
+    const res = await review(CAND_A, { action: "reject" });
+
+    expect(res.status).toBe(409);
+    expect(res.body.success).toBe(false);
+    expect(res.body.message).toMatch(/rejected/i);
+  });
+
+  it("returns 400 when the action is not approve or reject", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "delete" });
+
+    expect(res.status).toBe(400);
+    expect(res.body.statusCode).toBe(400);
+    expect(res.body.message).toMatch(/approve or reject/i);
+    expect((await CandidateRestaurant.findByPk(CAND_A))?.is_approved).toBe(false);
+  });
+
+  it("normalizes a mixed-case, padded action", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "  ApPrOvE  " });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data.status).toBe("approved");
+  });
+
+  it("surfaces a 500 and does not resolve when notifying admins fails", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+    await run(`
+      CREATE OR REPLACE FUNCTION crvw_fail_notification() RETURNS trigger AS $$
+      BEGIN RAISE EXCEPTION 'notification store unavailable'; END;
+      $$ LANGUAGE plpgsql;
+      CREATE TRIGGER crvw_fail_notification BEFORE INSERT ON notifications
+      FOR EACH ROW EXECUTE FUNCTION crvw_fail_notification();
+    `);
+
+    try {
+      const res = await review(CAND_A, { action: "approve" });
+
+      expect(res.status).toBe(500);
+      expect(res.body.success).toBe(false);
+      expect((await CandidateRestaurant.findByPk(CAND_A))?.is_approved).toBe(
+        false
+      );
+      expect(await Restaurant.count({ where: { name: NAME_A } })).toBe(0);
+    } finally {
+      await run(
+        `DROP TRIGGER IF EXISTS crvw_fail_notification ON notifications`
+      );
+      await run(`DROP FUNCTION IF EXISTS crvw_fail_notification()`);
+    }
+  });
+
+  it("returns the review envelope with a message and the candidate name", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(200);
+    expect(typeof res.body.message).toBe("string");
+    expect(res.body.message.length).toBeGreaterThan(0);
+    expect(res.body.data.name).toBe(NAME_A);
+    expect(res.body.data.reviewed_by).toBe(REVIEWER_ID);
+  });
+
+  it("notifies each admin with the reviewer id and a message naming the restaurant", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(200);
+    const notes = await notificationsByReviewer();
+    expect(notes).toHaveLength(1);
+    expect(notes[0].reactor_id).toBe(REVIEWER_ID);
+    expect(notes[0].message).toEqual(expect.stringContaining(NAME_A));
+  });
+
+  it("copies each candidate menu image url into a restaurant image row", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+    await addMenuImage(CAND_A, "https://cdn.example/one.jpg");
+    await addMenuImage(CAND_A, "https://cdn.example/two.jpg");
+
+    const res = await review(CAND_A, { action: "approve" });
+
+    expect(res.status).toBe(200);
+    const images = await RestaurantImage.findAll({
+      where: { restaurant_id: res.body.data.restaurant_id },
+      order: [["url", "ASC"]],
+    });
+    expect(images.map((i) => i.url)).toEqual([
+      "https://cdn.example/one.jpg",
+      "https://cdn.example/two.jpg",
+    ]);
+    for (const image of images) {
+      expect(image.restaurant_id).toBe(res.body.data.restaurant_id);
+    }
+  });
+
+  it("does not create a restaurant, media or notifications when rejecting", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+    await addMenuImage(CAND_A, "https://cdn.example/skip.jpg");
+
+    const res = await review(CAND_A, { action: "reject" });
+
+    expect(res.status).toBe(200);
+    expect(await Restaurant.count({ where: { name: NAME_A } })).toBe(0);
+    expect(await notificationsByReviewer()).toHaveLength(0);
+  });
+
+  it("stores a null rejection reason when the reason is whitespace only", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await review(CAND_A, { action: "reject", rejectionReason: "   " });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data.rejection_reason).toBeNull();
+    expect((await rejectionReasonRow(CAND_A)).rejection_reason).toBeNull();
+  });
+});
+
+describe("Candidate Restaurant Verification - Metrics Endpoint", () => {
+  const seedMany = async (
+    count: number,
+    state: "pending" | "approved" | "rejected"
+  ) => {
+    for (let i = 0; i < count; i += 1) {
+      await run(
+        `INSERT INTO candidate_restaurants
+           (id, name, description, opening_hour, closing_hour, is_open,
+            is_approved, is_rejected, "createdAt", "updatedAt")
+         VALUES (gen_random_uuid(), ?, 'metrics', '08:00:00', '20:00:00', false,
+                 ?, ?, NOW(), NOW())`,
+        [
+          `${NAME_PREFIX} Metrics ${state} ${i}`,
+          state === "approved",
+          state === "rejected",
+        ]
+      );
+    }
+  };
+
+  beforeEach(async () => {
+    await run(`DELETE FROM candidate_restaurant_menu_images`);
+    await run(`DELETE FROM candidate_restaurants`);
+  });
+
+  it("returns aggregated pending/approved/rejected/total counts", async () => {
+    await seedMany(5, "pending");
+    await seedMany(4, "approved");
+    await seedMany(3, "rejected");
+
+    const res = await metrics();
+
+    expect(res.status).toBe(200);
+    expect(res.body.data).toEqual({
+      pending: 5,
+      approved: 4,
+      rejected: 3,
+      total: 12,
+    });
+  });
+
+  it("never reports a negative pending count", async () => {
+    await seedMany(6, "approved");
+    await seedMany(6, "rejected");
+
+    const res = await metrics();
+
+    expect(res.status).toBe(200);
+    expect(res.body.data.pending).toBe(0);
+    expect(res.body.data.total).toBe(12);
+  });
+});
+
+describe("Candidate Restaurant Verification - Batch Review Endpoint", () => {
+  const restaurantCount = () =>
+    Restaurant.count({ where: { name: [NAME_A, NAME_B] } });
+
+  it("reviews a mixed batch and returns results in the exact requested order", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+    await seedCandidate(CAND_B, NAME_B);
+
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: CAND_B, action: "reject", rejectionReason: "duplicate" },
+        { candidateRestaurantId: CAND_A, action: "approve" },
+      ],
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.body.success).toBe(true);
+    expect(res.body.data.map((r: any) => r.candidate_restaurant_id)).toEqual([
+      CAND_B,
+      CAND_A,
+    ]);
+    expect(res.body.data[0]).toMatchObject({
+      status: "rejected",
+      rejection_reason: "duplicate",
+      restaurant_id: null,
+    });
+    expect(res.body.data[1]).toMatchObject({ status: "approved" });
+    expect(res.body.data[1].restaurant_id).toEqual(expect.any(String));
+
+    expect((await CandidateRestaurant.findByPk(CAND_A))?.is_approved).toBe(true);
+    expect((await CandidateRestaurant.findByPk(CAND_B))?.is_rejected).toBe(true);
+    expect(await Restaurant.count({ where: { name: NAME_A } })).toBe(1);
+    expect(await Restaurant.count({ where: { name: NAME_B } })).toBe(0);
+  });
+
+  it("returns 400 when the reviews field is missing", async () => {
+    await seedCandidate(CAND_A, NAME_A);
+
+    const res = await batch({});
+
+    expect(res.status).toBe(400);
+    expect(res.body.success).toBe(false);
