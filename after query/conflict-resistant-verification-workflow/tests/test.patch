+import express from "express";
+import request from "supertest";
+
+import candidateRestaurantRouter from "../../routes/candidate_restaurant.route";
+import sequelize from "../../config/db";
+import {
+  AdminUser,
+  CandidateRestaurant,
+  CandidateRestaurantMenuImage,
+  Notification,
+  Restaurant,
+  RestaurantImage,
+} from "../../models";
+
+jest.mock("../../middlewares/auth", () => ({
+  protectRoute: (req: any, _res: any, next: any) => {
+    req.user = { id: "reviewer-9" };
+    next();
+  },
+  protectRouteForAdmin: (req: any, _res: any, next: any) => {
+    req.user = { id: "reviewer-9" };
+    next();
+  },
+  optionalAuth: (_req: any, _res: any, next: any) => next(),
+}));
+
+jest.mock("../../models", () => ({
+  CandidateRestaurant: { findByPk: jest.fn(), count: jest.fn() },
+  Restaurant: { create: jest.fn() },
+  RestaurantImage: { create: jest.fn() },
+  CandidateRestaurantMenuImage: { findAll: jest.fn() },
+  AdminUser: { findAll: jest.fn() },
+  Notification: { create: jest.fn() },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: { transaction: jest.fn() },
+}));
+
+const app = express();
+app.use(express.json());
+app.use("/api/v1/candidate-restaurants", candidateRestaurantRouter);
+app.use((err: any, _req: any, res: any, _next: any) => {
+  res
+    .status(err.statusCode || 500)
+    .json({ success: false, message: err.message || "Internal Server Error" });
+});
+
+const transaction = (sequelize as unknown as { transaction: jest.Mock }).transaction;
+const findByPk = CandidateRestaurant.findByPk as jest.Mock;
+const createRestaurant = Restaurant.create as jest.Mock;
+const findCandidateMedia = CandidateRestaurantMenuImage.findAll as jest.Mock;
+const findAdmins = AdminUser.findAll as jest.Mock;
+
+const pendingCandidate = (id: string, name: string) => ({
+  id,
+  name,
+  description: `${name} description`,
+  is_approved: false,
+  is_rejected: false,
+  save: jest.fn().mockResolvedValue(true),
+});
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  transaction.mockImplementation(async (cb: any) => cb({ LOCK: { UPDATE: "UPDATE" } }));
+  findCandidateMedia.mockResolvedValue([]);
+  findAdmins.mockResolvedValue([{ id: "admin-1" }]);
+  createRestaurant.mockResolvedValue({ id: "rest-x" });
+  (RestaurantImage.create as jest.Mock).mockResolvedValue({ id: "img" });
+  (Notification.create as jest.Mock).mockResolvedValue({ id: "note" });
+});
+
+const batch = (body: any) =>
+  request(app).put("/api/v1/candidate-restaurants/batch-review").send(body);
+
+describe("Candidate Restaurant Verification - Batch Review Endpoint", () => {
+  it("reviews a mixed batch and returns results in the exact requested order", async () => {
+    findByPk.mockImplementation((id: string) =>
+      Promise.resolve(
+        id === "cand-a"
+          ? pendingCandidate("cand-a", "Alpha")
+          : pendingCandidate("cand-b", "Bravo")
+      )
+    );
+
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-b", action: "reject", rejectionReason: "duplicate" },
+        { candidateRestaurantId: "cand-a", action: "approve" },
+      ],
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.body.success).toBe(true);
+    expect(res.body.data.map((r: any) => r.candidate_restaurant_id)).toEqual([
+      "cand-b",
+      "cand-a",
+    ]);
+    expect(res.body.data[0]).toMatchObject({ status: "rejected", rejection_reason: "duplicate" });
+    expect(res.body.data[1]).toMatchObject({ status: "approved", restaurant_id: "rest-x" });
+  });
+
+  it("returns 400 when the reviews field is missing", async () => {
+    const res = await batch({});
+    expect(res.status).toBe(400);
+    expect(res.body.success).toBe(false);
+    expect(res.body.message).toMatch(/reviews field must be a non-empty array/i);
+    expect(findByPk).not.toHaveBeenCalled();
+  });
+
+  it("returns 400 when the reviews array is empty", async () => {
+    const res = await batch({ reviews: [] });
+    expect(res.status).toBe(400);
+    expect(res.body.message).toMatch(/reviews field must be a non-empty array/i);
+  });
+
+  it("returns 400 when a review entry is not an object", async () => {
+    const res = await batch({ reviews: ["approve cand-a"] });
+    expect(res.status).toBe(400);
+    expect(res.body.success).toBe(false);
+    expect(res.body.message).toMatch(/object/i);
+  });
+
+  it("returns 400 when a review entry has no candidateRestaurantId", async () => {
+    const res = await batch({ reviews: [{ action: "approve" }] });
+    expect(res.status).toBe(400);
+    expect(res.body.success).toBe(false);
+    expect(res.body.message).toMatch(/candidateRestaurantId/i);
+  });
+
+  it("returns 400 when a review entry has an unknown action", async () => {
+    const res = await batch({
+      reviews: [{ candidateRestaurantId: "cand-a", action: "archive" }],
+    });
+    expect(res.status).toBe(400);
+    expect(res.body.message).toMatch(/approve or reject/i);
+  });
+
+  it("returns 400 with 'Duplicate candidate restaurant id' for a repeated id", async () => {
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-a", action: "approve" },
+        { candidateRestaurantId: "cand-a", action: "reject" },
+      ],
+    });
+    expect(res.status).toBe(400);
+    expect(res.body.message).toBe("Duplicate candidate restaurant id");
+  });
+
+  it("detects duplicate ids that differ only by surrounding whitespace", async () => {
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-a", action: "approve" },
+        { candidateRestaurantId: "  cand-a  ", action: "reject" },
+      ],
+    });
+    expect(res.status).toBe(400);
+    expect(res.body.message).toBe("Duplicate candidate restaurant id");
+  });
+
+  it("accepts mixed-case actions inside the batch", async () => {
+    findByPk.mockImplementation((id: string) =>
+      Promise.resolve(pendingCandidate(id, "Case Test"))
+    );
+
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-a", action: "APPROVE" },
+        { candidateRestaurantId: "cand-b", action: "ReJeCt" },
+      ],
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data.map((r: any) => r.status)).toEqual(["approved", "rejected"]);
+  });
+
+  it("trims whitespace-padded candidate ids before lookup", async () => {
+    findByPk.mockResolvedValue(pendingCandidate("cand-a", "Padded"));
+
+    const res = await batch({
+      reviews: [{ candidateRestaurantId: "   cand-a   ", action: "approve" }],
+    });
+
+    expect(res.status).toBe(200);
+    expect(findByPk).toHaveBeenCalledWith("cand-a", expect.anything());
+  });
+
+  it("fails the whole batch with 404 when any candidate is missing", async () => {
+    findByPk.mockImplementation((id: string) =>
+      Promise.resolve(id === "cand-a" ? pendingCandidate("cand-a", "Alpha") : null)
+    );
+
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-a", action: "approve" },
+        { candidateRestaurantId: "cand-missing", action: "approve" },
+      ],
+    });
+
+    expect(res.status).toBe(404);
+    expect(res.body).not.toHaveProperty("data");
+  });
+
+  it("fails the whole batch with 409 when any candidate is already reviewed", async () => {
+    findByPk.mockImplementation((id: string) =>
+      Promise.resolve(
+        id === "cand-a"
+          ? pendingCandidate("cand-a", "Alpha")
+          : { id: "cand-b", name: "Bravo", is_approved: true, is_rejected: false }
+      )
+    );
+
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-a", action: "approve" },
+        { candidateRestaurantId: "cand-b", action: "approve" },
+      ],
+    });
+
+    expect(res.status).toBe(409);
+    expect(res.body).not.toHaveProperty("data");
+  });
+
+  it("keeps a whitespace-only rejectionReason out of the stored reason", async () => {
+    findByPk.mockResolvedValue(pendingCandidate("cand-a", "Blank Reason"));
+
+    const res = await batch({
+      reviews: [{ candidateRestaurantId: "cand-a", action: "reject", rejectionReason: "    " }],
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data[0].rejection_reason).toBeNull();
+  });
+
+  it("returns success, a message and one result for a single-item batch", async () => {
+    findByPk.mockResolvedValue(pendingCandidate("cand-a", "Solo"));
+
+    const res = await batch({
+      reviews: [{ candidateRestaurantId: "cand-a", action: "approve" }],
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.body.success).toBe(true);
+    expect(typeof res.body.message).toBe("string");
+    expect(res.body.data).toHaveLength(1);
+    expect(res.body.data[0]).toMatchObject({
+      candidate_restaurant_id: "cand-a",
+      status: "approved",
+      reviewed_by: "reviewer-9",
+    });
+  });
+
+  it("stamps the reviewer id on every entry of the batch", async () => {
+    findByPk.mockImplementation((id: string) =>
+      Promise.resolve(pendingCandidate(id, "Batch"))
+    );
+
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-a", action: "approve" },
+        { candidateRestaurantId: "cand-b", action: "reject" },
+      ],
+    });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data.map((r: any) => r.reviewed_by)).toEqual([
+      "reviewer-9",
+      "reviewer-9",
+    ]);
+  });
+
+  it("does not create any restaurant when the batch rolls back on the first entry", async () => {
+    findByPk.mockResolvedValue(null);
+
+    const res = await batch({
+      reviews: [
+        { candidateRestaurantId: "cand-missing", action: "approve" },
+        { candidateRestaurantId: "cand-a", action: "approve" },
+      ],
+    });
+
+    expect(res.status).toBe(404);
+    expect(createRestaurant).not.toHaveBeenCalled();
+  });
+
+  it("rejects a review entry whose action is not a string", async () => {
+    const res = await batch({
+      reviews: [{ candidateRestaurantId: "cand-a", action: 1 }],
+    });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toMatch(/approve or reject/i);
+  });
+});
