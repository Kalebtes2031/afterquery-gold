@@ -0,0 +1,212 @@
+import { validateBatchCandidatePayload } from "../../utils/candidate-restaurant-workflow.utils";
+import { CandidateRestaurantConflictService } from "../../services/candidate-restaurant-conflict.service";
+import { CandidateRestaurantWorkflowService } from "../../services/candidate-restaurant-workflow.service";
+import { CandidateVerificationAction } from "../../types/candidate-restaurant-workflow.types";
+
+jest.mock("../../services/candidate-restaurant-workflow.service");
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Candidate Restaurant Verification Workflow - Batch Review & Conflict Guards", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe("Batch Payload Validation", () => {
+    it("returns 400 when body has no reviews field", () => {
+      expect(() => validateBatchCandidatePayload({})).toThrow(
+        "Field 'reviews' must be an array"
+      );
+    });
+
+    it("returns 400 when reviews array is empty", () => {
+      expect(() => validateBatchCandidatePayload({ reviews: [] })).toThrow(
+        "Field 'reviews' cannot be an empty array"
+      );
+    });
+
+    it("returns 400 with duplicate candidate id when duplicate ids exist in batch", () => {
+      const payload = {
+        reviews: [
+          { candidateRestaurantId: "cand-1", action: "approve" },
+          { candidateRestaurantId: "cand-1", action: "reject" },
+        ],
+      };
+      expect(() => validateBatchCandidatePayload(payload)).toThrow(
+        "Duplicate candidate restaurant id 'cand-1' detected"
+      );
+    });
+
+    it("returns 400 when action is invalid", () => {
+      const payload = {
+        reviews: [{ candidateRestaurantId: "cand-1", action: "ignore" }],
+      };
+      expect(() => validateBatchCandidatePayload(payload)).toThrow(
+        "Invalid verification action 'ignore'"
+      );
+    });
+
+    it("returns 400 when review item is not an object", () => {
+      const payload = {
+        reviews: [123],
+      };
+      expect(() => validateBatchCandidatePayload(payload)).toThrow(
+        "Review item at index 0 must be an object"
+      );
+    });
+  });
+
+  describe("Batch Review Execution", () => {
+    it("successfully executes mixed batch reviews in a single transaction", async () => {
+      const items = [
+        {
+          candidateRestaurantId: "cand-1",
+          action: CandidateVerificationAction.Approve,
+        },
+        {
+          candidateRestaurantId: "cand-2",
+          action: CandidateVerificationAction.Reject,
+          rejectionReason: "Invalid location",
+        },
+      ];
+
+      (
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock as jest.Mock
+      )
+        .mockResolvedValueOnce({
+          id: "cand-1",
+          name: "Rest 1",
+          is_approved: true,
+          reviewed_by: "admin-1",
+          reviewed_at: new Date(),
+          created_restaurant_id: "rest-1",
+        })
+        .mockResolvedValueOnce({
+          id: "cand-2",
+          name: "Rest 2",
+          is_approved: false,
+          reviewed_by: "admin-1",
+          reviewed_at: new Date(),
+          created_restaurant_id: null,
+          rejection_reason: "Invalid location",
+        });
+
+      const res = await CandidateRestaurantConflictService.executeBatchReview(
+        items,
+        "admin-1"
+      );
+
+      expect(res.totalReviewed).toBe(2);
+      expect(res.approvedCount).toBe(1);
+      expect(res.rejectedCount).toBe(1);
+      expect(res.results[0].id).toBe("cand-1");
+      expect(res.results[1].id).toBe("cand-2");
+    });
+
+    it("rolls back batch when any candidate restaurant is not found", async () => {
+      (
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock as jest.Mock
+      ).mockRejectedValue(new Error("Candidate restaurant not found"));
+
+      const items = [
+        {
+          candidateRestaurantId: "cand-missing",
+          action: CandidateVerificationAction.Approve,
+        },
+      ];
+
+      await expect(
+        CandidateRestaurantConflictService.executeBatchReview(items, "admin-1")
+      ).rejects.toThrow("Candidate restaurant not found");
+    });
+
+    it("rolls back batch when any candidate restaurant is already approved", async () => {
+      (
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock as jest.Mock
+      ).mockRejectedValue(new Error("already approved"));
+
+      const items = [
+        {
+          candidateRestaurantId: "cand-dup",
+          action: CandidateVerificationAction.Approve,
+        },
+      ];
+
+      await expect(
+        CandidateRestaurantConflictService.executeBatchReview(items, "admin-1")
+      ).rejects.toThrow("already approved");
+    });
+
+    it("returns results in the exact requested order of candidateRestaurantIds", async () => {
+      const items = [
+        { candidateRestaurantId: "cand-99", action: CandidateVerificationAction.Approve },
+        { candidateRestaurantId: "cand-11", action: CandidateVerificationAction.Approve },
+        { candidateRestaurantId: "cand-44", action: CandidateVerificationAction.Reject },
+      ];
+
+      (CandidateRestaurantWorkflowService.verifyCandidateWithLock as jest.Mock)
+        .mockResolvedValueOnce({ id: "cand-99", is_approved: true })
+        .mockResolvedValueOnce({ id: "cand-11", is_approved: true })
+        .mockResolvedValueOnce({ id: "cand-44", is_approved: false });
+
+      const res = await CandidateRestaurantConflictService.executeBatchReview(
+        items,
+        "admin-1"
+      );
+
+      expect(res.results.map((r) => r.id)).toEqual(["cand-99", "cand-11", "cand-44"]);
+    });
+
+    it("trims whitespace from candidate restaurant ids in batch payload", () => {
+      const payload = {
+        reviews: [{ candidateRestaurantId: "  cand-padded  ", action: "approve" }],
+      };
+      const result = validateBatchCandidatePayload(payload);
+      expect(result.reviews[0].candidateRestaurantId).toBe("cand-padded");
+    });
+
+    it("rolls back batch when any candidate restaurant is already rejected", async () => {
+      (CandidateRestaurantWorkflowService.verifyCandidateWithLock as jest.Mock)
+        .mockRejectedValue(new Error("already rejected"));
+
+      const items = [
+        { candidateRestaurantId: "cand-already-rej", action: CandidateVerificationAction.Reject },
+      ];
+
+      await expect(
+        CandidateRestaurantConflictService.executeBatchReview(items, "admin-1")
+      ).rejects.toThrow("already rejected");
+    });
+
+    it("validates distinctness of batch candidate identifiers successfully", async () => {
+      const valid = await CandidateRestaurantConflictService.validateBatchDistinctness([
+        "cand-1",
+        "cand-2",
+        "cand-3",
+      ]);
+      expect(valid).toBe(true);
+
+      const invalid = await CandidateRestaurantConflictService.validateBatchDistinctness([
+        "cand-1",
+        "cand-1",
+      ]);
+      expect(invalid).toBe(false);
+    });
+
+    it("returns false for batch distinctness check when candidate list is empty", async () => {
+      const emptyCheck = await CandidateRestaurantConflictService.validateBatchDistinctness([]);
+      expect(emptyCheck).toBe(false);
+    });
+  });
+});
diff --git a/rateeat_backend/src/__tests__/unit/candidate_restaurant_conflict_workflow.test.ts b/rateeat_backend/src/__tests__/unit/candidate_restaurant_conflict_workflow.test.ts
