+import express from "express";
+import request from "supertest";
+
+import candidateRestaurantRouter from "../../routes/candidate_restaurant.route";
+
+/**
+ * Drives the new verification endpoints through the real router with the
+ * repository's real admin guard in place, confirming the routes exist and stay
+ * behind admin authorization.
+ */
+const app = express();
+app.use(express.json());
+app.use("/api/v1/candidate-restaurants", candidateRestaurantRouter);
+
+const CANDIDATE_ID = "11111111-1111-4111-8111-111111111111";
+
+describe("Candidate Restaurant Verification - Route Authorization", () => {
+  it("rejects an unauthenticated single candidate review with 401", async () => {
+    const res = await request(app)
+      .put(`/api/v1/candidate-restaurants/${CANDIDATE_ID}/review`)
+      .send({ action: "approve" });
+
+    expect(res.status).toBe(401);
+  });
+
+  it("rejects an unauthenticated batch review with 401", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({ reviews: [{ candidateRestaurantId: CANDIDATE_ID, action: "approve" }] });
+
+    expect(res.status).toBe(401);
+  });
+
+  it("rejects an unauthenticated metrics request with 401", async () => {
+    const res = await request(app)
+      .get("/api/v1/candidate-restaurants/metrics")
+      .send();
+
+    expect(res.status).toBe(401);
+  });
+});
