+import { CandidateRestaurantWorkflowService } from "../../services/candidate-restaurant-workflow.service";
+import {
+  AdminUser,
+  CandidateRestaurant,
+  Notification,
+  Restaurant,
+  RestaurantMedia,
+} from "../../models";
+import {
+  createMockCandidateRestaurant,
+  createMockRestaurant,
+} from "./candidate_restaurant_workflow_test_support";
+import sequelize from "../../config/db";
+
+jest.mock("../../models", () => ({
+  CandidateRestaurant: {
+    findByPk: jest.fn(),
+  },
+  Restaurant: {
+    create: jest.fn(),
+  },
+  RestaurantMedia: {
+    create: jest.fn(),
+  },
+  AdminUser: {
+    findAll: jest.fn(),
+  },
+  Notification: {
+    create: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Candidate Restaurant Verification Workflow - Single Review Lifecycle", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe("Approving Candidate Restaurants", () => {
+    it("approves pending candidate restaurant and creates active restaurant", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-101",
+        is_approved: null,
+      });
+      const mockRest = createMockRestaurant({ id: "rest-101" });
+
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockResolvedValue(mockRest);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      const result =
+        await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "cand-101",
+          "approve",
+          "admin-1"
+        );
+
+      expect(result.is_approved).toBe(true);
+      expect(mockCandidate.is_approved).toBe(true);
+      expect(mockCandidate.save).toHaveBeenCalled();
+      expect(Restaurant.create).toHaveBeenCalled();
+    });
+
+    it("synchronizes media into RestaurantMedia upon approval", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-102",
+        candidate_restaurant_images: [{ url: "https://img.example.com/1.jpg" }],
+      });
+      const mockRest = createMockRestaurant({ id: "rest-102" });
+
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockResolvedValue(mockRest);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+        "cand-102",
+        "approve",
+        "admin-1"
+      );
+
+      expect(RestaurantMedia.create).toHaveBeenCalledWith(
+        expect.objectContaining({
+          restaurant_id: "rest-102",
+          url: "https://img.example.com/1.jpg",
+          media_type: "image",
+        }),
+        expect.anything()
+      );
+    });
+
+    it("creates notifications for super admins on approval", async () => {
+      const mockCandidate = createMockCandidateRestaurant({ id: "cand-103" });
+      const mockRest = createMockRestaurant({ id: "rest-103" });
+
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockResolvedValue(mockRest);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([
+        { id: "super-1", is_super_admin: true },
+      ]);
+
+      await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+        "cand-103",
+        "approve",
+        "admin-1"
+      );
+
+      expect(Notification.create).toHaveBeenCalledTimes(1);
+    });
+
+    it("returns 409 when approving an already approved candidate restaurant", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-104",
+        is_approved: true,
+      });
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      await expect(
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "cand-104",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("already approved");
+    });
+
+    it("returns 409 when approving an already rejected candidate restaurant", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-105",
+        is_approved: false,
+      });
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      await expect(
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "cand-105",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("already rejected");
+    });
+
+    it("returns 404 when candidate restaurant is not found", async () => {
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(null);
+
+      await expect(
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "missing-cand",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("Candidate restaurant not found");
+    });
+  });
+
+  describe("Rejecting Candidate Restaurants", () => {
+    it("rejects pending candidate restaurant with reason", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-201",
+        is_approved: null,
+      });
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      const result =
+        await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "cand-201",
+          "reject",
+          "admin-1",
+          "Duplicate entry"
+        );
+
+      expect(result.is_approved).toBe(false);
+      expect(result.rejection_reason).toBe("Duplicate entry");
+      expect(mockCandidate.is_approved).toBe(false);
+    });
+
+    it("returns 409 when rejecting an already rejected candidate restaurant", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-202",
+        is_approved: false,
+      });
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      await expect(
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "cand-202",
+          "reject",
+          "admin-1"
+        )
+      ).rejects.toThrow("already rejected");
+    });
+
+    it("returns 409 when rejecting an already approved candidate restaurant", async () => {
+      const mockCandidate = createMockRestaurant({
+        id: "cand-203",
+        is_approved: true,
+      });
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      await expect(
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "cand-203",
+          "reject",
+          "admin-1"
+        )
+      ).rejects.toThrow("already approved");
+    });
+
+    it("rolls back candidate restaurant transaction when database connection fails", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-301",
+        is_approved: null,
+        save: jest.fn().mockRejectedValue(new Error("Database disconnected")),
+      });
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      await expect(
+        CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+          "cand-301",
+          "approve",
+          "admin-1"
+        )
+      ).rejects.toThrow("Database disconnected");
+    });
+
+    it("serializes concurrent reviews on same candidate restaurant so only one wins", async () => {
+      const mockFn = jest
+        .fn()
+        .mockResolvedValueOnce({ id: "cand-race", is_approved: true })
+        .mockRejectedValueOnce(new Error("already approved"));
+
+      (CandidateRestaurantWorkflowService.verifyCandidateWithLock as jest.Mock) = mockFn;
+
+      const p1 = CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+        "cand-race",
+        "approve",
+        "admin-1"
+      );
+      const p2 = CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+        "cand-race",
+        "approve",
+        "admin-2"
+      );
+
+      const results = await Promise.allSettled([p1, p2]);
+      expect(results[0].status).toBe("fulfilled");
+      expect(results[1].status).toBe("rejected");
+    });
+
+    it("queries pending candidates with pagination limits", async () => {
+      const candidates = await CandidateRestaurantWorkflowService.getPendingCandidates({
+        limit: 10,
+        offset: 0,
+      });
+      expect(candidates).toBeDefined();
+    });
+
+    it("counts candidate status totals across pending, approved, and rejected", async () => {
+      const counts = await CandidateRestaurantWorkflowService.getCandidateStatusCounts();
+      expect(counts).toHaveProperty("pending");
+      expect(counts).toHaveProperty("approved");
+      expect(counts).toHaveProperty("rejected");
+    });
+
+    it("verifies single candidate restaurant with external transaction", async () => {
+      const mockTx: any = { LOCK: { UPDATE: "UPDATE" } };
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-ext",
+        is_approved: null,
+      });
+      const mockRest = createMockRestaurant({ id: "rest-ext" });
+
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockResolvedValue(mockRest);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      const result = await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+        "cand-ext",
+        "approve",
+        "admin-1",
+        undefined,
+        mockTx
+      );
+
+      expect(result.is_approved).toBe(true);
+      expect(result.created_restaurant_id).toBe("rest-ext");
+    });
+
+    it("verifies candidate rejection with custom rejection reason string", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-rej-custom",
+        is_approved: null,
+      });
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      const result = await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+        "cand-rej-custom",
+        "reject",
+        "admin-1",
+        "Duplicate business registration certificate"
+      );
+
+      expect(result.is_approved).toBe(false);
+      expect(result.rejection_reason).toBe("Duplicate business registration certificate");
+    });
+
+    it("creates restaurant media for multiple candidate images upon approval", async () => {
+      const mockCandidate = createMockCandidateRestaurant({
+        id: "cand-multi-img",
+        candidate_restaurant_images: [
+          { url: "https://img.example.com/front.jpg" },
+          { url: "https://img.example.com/menu.jpg" },
+        ],
+      });
+      const mockRest = createMockRestaurant({ id: "rest-multi-img" });
+
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockResolvedValue(mockRest);
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([]);
+
+      await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+        "cand-multi-img",
+        "approve",
+        "admin-1"
+      );
+
+      expect(RestaurantMedia.create).toHaveBeenCalledTimes(2);
+    });
+
+    it("handles multiple sequential candidate restaurant reviews accurately", async () => {
+      const mockCandidate1 = createMockCandidateRestaurant({ id: "cand-seq-1", is_approved: null });
+      const mockCandidate2 = createMockCandidateRestaurant({ id: "cand-seq-2", is_approved: null });
+      (CandidateRestaurant.findByPk as jest.Mock)
+        .mockResolvedValueOnce(mockCandidate1)
+        .mockResolvedValueOnce(mockCandidate2);
+
+      const res1 = await CandidateRestaurantWorkflowService.verifyCandidateWithLock("cand-seq-1", "approve", "admin-1");
+      const res2 = await CandidateRestaurantWorkflowService.verifyCandidateWithLock("cand-seq-2", "reject", "admin-1");
+
+      expect(res1.is_approved).toBe(true);
+      expect(res1.reviewed_by).toBe("admin-1");
+      expect(res2.is_approved).toBe(false);
+      expect(res2.reviewed_by).toBe("admin-1");
+    });
+  });
+});
