diff --git a/rateeat_backend/src/services/candidate-restaurant-workflow.service.ts b/rateeat_backend/src/services/candidate-restaurant-workflow.service.ts
new file mode 100644
index 0000000..4d2d60b
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-restaurant-workflow.service.ts
@@ -0,0 +1,184 @@
+import { Transaction } from "sequelize";
+import sequelize from "../config/db";
+import {
+  AdminUser,
+  CandidateRestaurant,
+  CandidateRestaurantImage,
+  CandidateRestaurantVideo,
+  Notification,
+  Restaurant,
+  RestaurantMedia,
+} from "../models";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import {
+  ConflictError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import {
+  BatchCandidateReviewItem,
+  CandidateReviewAction,
+  CandidateReviewResult,
+  CandidateFilterOptions,
+} from "../types/candidate-restaurant-workflow.types";
+
+export class CandidateRestaurantWorkflowService {
+  /**
+   * Reviews a single candidate restaurant with row-level locking.
+   */
+  public static async verifyCandidateWithLock(
+    candidateId: string,
+    action: CandidateReviewAction | "approve" | "reject",
+    reviewerId: string,
+    rejectionReason?: string,
+    externalTransaction?: Transaction
+  ): Promise<CandidateReviewResult> {
+    const executeReview = async (tx: Transaction) => {
+      const candidate = await CandidateRestaurant.findByPk(candidateId, {
+        transaction: tx,
+        lock: tx.LOCK.UPDATE,
+        include: [
+          { model: CandidateRestaurantImage, as: "candidate_restaurant_images" },
+          { model: CandidateRestaurantVideo, as: "candidate_restaurant_videos" },
+        ],
+      });
+
+      if (!candidate) {
+        throw new NotFoundError("Candidate restaurant not found");
+      }
+
+      if (candidate.is_approved === true) {
+        throw new ConflictError(
+          `Candidate restaurant '${candidateId}' is already approved`
+        );
+      }
+
+      if (candidate.is_approved === false) {
+        throw new ConflictError(
+          `Candidate restaurant '${candidateId}' is already rejected`
+        );
+      }
+
+      if (action === CandidateReviewAction.Approve || action === "approve") {
+        candidate.is_approved = true;
+        await candidate.save({ transaction: tx });
+
+        const createdRestaurant = await Restaurant.create(
+          {
+            name: candidate.name,
+            address: (candidate as any).address,
+            phone_number: (candidate as any).phone_number,
+            is_active: true,
+          },
+          { transaction: tx }
+        );
+
+        if ((candidate as any).candidate_restaurant_images) {
+          for (const img of (candidate as any).candidate_restaurant_images) {
+            await RestaurantMedia.create(
+              {
+                restaurant_id: createdRestaurant.id,
+                url: img.url || img.highQualityImg || img.lowQualityImg,
+                media_type: "image",
+              },
+              { transaction: tx }
+            );
+          }
+        }
+
+        const superAdmins = await AdminUser.findAll({
+          where: { is_super_admin: true },
+          transaction: tx,
+        });
+
+        for (const admin of superAdmins) {
+          await Notification.create(
+            {
+              user_id: admin.id,
+              category: NotificationCategory.RestaurantClaim,
+              title: "Candidate Restaurant Approved",
+              message: `Candidate restaurant '${candidate.name}' has been approved and activated.`,
+            },
+            { transaction: tx }
+          );
+        }
+
+        return {
+          id: candidate.id,
+          name: candidate.name,
+          is_approved: true,
+          rejection_reason: null,
+          reviewed_by: reviewerId,
+          created_restaurant_id: createdRestaurant.id,
+        };
+      } else {
+        candidate.is_approved = false;
+        if (rejectionReason) {
+          (candidate as any).rejection_reason = rejectionReason;
+        }
+        await candidate.save({ transaction: tx });
+
+        return {
+          id: candidate.id,
+          name: candidate.name,
+          is_approved: false,
+          rejection_reason: rejectionReason || null,
+          reviewed_by: reviewerId,
+        };
+      }
+    };
+
+    if (externalTransaction) {
+      return executeReview(externalTransaction);
+    } else {
+      return sequelize.transaction(async (tx) => executeReview(tx));
+    }
+  }
+
+  /**
+   * Executes a batch of candidate reviews within a single atomic transaction.
+   */
+  public static async executeBatchReviews(
+    items: BatchCandidateReviewItem[],
+    reviewerId: string
+  ): Promise<CandidateReviewResult[]> {
+    return sequelize.transaction(async (tx) => {
+      const results: CandidateReviewResult[] = [];
+      for (const item of items) {
+        const res = await this.verifyCandidateWithLock(
+          item.candidateRestaurantId,
+          item.action,
+          reviewerId,
+          item.rejectionReason,
+          tx
+        );
+        results.push(res);
+      }
+      return results;
+    });
+  }
+
+  /**
+   * Queries pending candidate restaurants with pagination.
+   */
+  public static async getPendingCandidates(
+    options: CandidateFilterOptions
+  ): Promise<{ rows: CandidateRestaurant[]; count: number }> {
+    return CandidateRestaurant.findAndCountAll({
+      where: { is_approved: null },
+      limit: options.limit || 20,
+      offset: options.offset || 0,
+      order: [["createdAt", "ASC"]],
+    });
+  }
+
+  /**
+   * Counts candidate status totals.
+   */
+  public static async getCandidateStatusCounts(): Promise<Record<string, number>> {
+    const pending = await CandidateRestaurant.count({ where: { is_approved: null } });
+    const approved = await CandidateRestaurant.count({ where: { is_approved: true } });
+    const rejected = await CandidateRestaurant.count({ where: { is_approved: false } });
+
+    return { pending, approved, rejected, total: pending + approved + rejected };
+  }
+}
