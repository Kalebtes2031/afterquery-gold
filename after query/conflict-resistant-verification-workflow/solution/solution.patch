+/**
+ * Action type for candidate restaurant review.
+ */
+export enum CandidateVerificationAction {
+  Approve = "approve",
+  Reject = "reject",
+}
+
+/**
+ * Valid approval states for candidate restaurants.
+ */
+export enum CandidateApprovalState {
+  Pending = "Pending",
+  Approved = "Approved",
+  Rejected = "Rejected",
+}
+
+/**
+ * Item inside the batch review payload for candidate restaurants.
+ */
+export interface BatchCandidateReviewItem {
+  candidateRestaurantId: string;
+  action: CandidateVerificationAction | "approve" | "reject";
+  rejectionReason?: string;
+}
+
+/**
+ * Payload structure for PUT /api/v1/candidate-restaurants/batch-review.
+ */
+export interface BatchCandidateReviewPayload {
+  reviews: BatchCandidateReviewItem[];
+}
+
+/**
+ * Output format for an individual candidate restaurant review.
+ */
+export interface CandidateReviewResult {
+  id: string;
+  name: string;
+  is_approved: boolean | null;
+  reviewed_by: string;
+  reviewed_at: Date;
+  created_restaurant_id?: string | null;
+  rejection_reason?: string | null;
+}
+
+/**
+ * Batch review response schema.
+ */
+export interface BatchCandidateReviewResponse {
+  totalReviewed: number;
+  approvedCount: number;
+  rejectedCount: number;
+  results: CandidateReviewResult[];
+}
+
+/**
+ * Audit log entry for candidate review transitions.
+ */
+export interface CandidateReviewAuditRecord {
+  auditId: string;
+  candidateRestaurantId: string;
+  restaurantName: string;
+  action: CandidateVerificationAction;
+  previousApprovalState: boolean | null;
+  newApprovalState: boolean;
+  createdRestaurantId?: string | null;
+  reviewerId: string;
+  timestamp: string;
+}
+
+/**
+ * Query filter options for candidate restaurant reviews.
+ */
+export interface CandidateWorkflowFilterOptions {
+  status?: string;
+  adminId?: string;
+  limit?: number;
+  offset?: number;
+  createdAfter?: Date;
+  createdBefore?: Date;
+}
+
+/**
+ * Aggregated statistics for candidate restaurant reviews.
+ */
+export interface CandidateWorkflowStatistics {
+  totalPending: number;
+  totalApproved: number;
+  totalRejected: number;
+  conversionRatePercentage: number;
+}
+
+/**
+ * Detailed candidate restaurant notification payload.
+ */
+export interface CandidateNotificationEvent {
+  eventId: string;
+  candidateId: string;
+  adminRecipientIds: string[];
+  action: CandidateVerificationAction;
+  occurredAt: Date;
+}
diff --git a/rateeat_backend/src/utils/candidate-restaurant-workflow.utils.ts b/rateeat_backend/src/utils/candidate-restaurant-workflow.utils.ts
new file mode 100644
index 0000000..b115e75
--- /dev/null
+++ b/rateeat_backend/src/utils/candidate-restaurant-workflow.utils.ts
@@ -0,0 +1,184 @@
+import { BadRequestError } from "../utils/error-response.utils";
+import {
+  BatchCandidateReviewItem,
+  BatchCandidateReviewPayload,
+  CandidateApprovalState,
+  CandidateReviewAuditRecord,
+  CandidateReviewResult,
+  CandidateVerificationAction,
+  CandidateWorkflowFilterOptions,
+  CandidateWorkflowStatistics,
+} from "../types/candidate-restaurant-workflow.types";
+
+/**
+ * Validates batch candidate review payload, ensuring array bounds and duplicate prevention.
+ */
+export function validateBatchCandidatePayload(
+  body: any
+): BatchCandidateReviewPayload {
+  if (!body || typeof body !== "object") {
+    throw new BadRequestError("Request body must be a valid JSON object");
+  }
+
+  const { reviews } = body;
+  if (!Array.isArray(reviews)) {
+    throw new BadRequestError("Field 'reviews' must be an array");
+  }
+
+  if (reviews.length === 0) {
+    throw new BadRequestError("Field 'reviews' cannot be an empty array");
+  }
+
+  const seenIds = new Set<string>();
+  const validatedItems: BatchCandidateReviewItem[] = [];
+
+  for (let i = 0; i < reviews.length; i++) {
+    const item = reviews[i];
+    if (!item || typeof item !== "object") {
+      throw new BadRequestError(`Review item at index ${i} must be an object`);
+    }
+
+    const { candidateRestaurantId, action, rejectionReason } = item;
+    if (
+      !candidateRestaurantId ||
+      typeof candidateRestaurantId !== "string" ||
+      candidateRestaurantId.trim().length === 0
+    ) {
+      throw new BadRequestError(
+        `Review item at index ${i} is missing a valid 'candidateRestaurantId'`
+      );
+    }
+
+    const cleanId = candidateRestaurantId.trim();
+    if (seenIds.has(cleanId)) {
+      throw new BadRequestError(
+        `Duplicate candidate restaurant id '${cleanId}' detected in batch payload`
+      );
+    }
+    seenIds.add(cleanId);
+
+    const normalizedAction =
+      typeof action === "string" ? action.toLowerCase().trim() : "";
+    if (
+      normalizedAction !== CandidateVerificationAction.Approve &&
+      normalizedAction !== CandidateVerificationAction.Reject
+    ) {
+      throw new BadRequestError(
+        `Invalid verification action '${action}' at index ${i}. Must be 'approve' or 'reject'`
+      );
+    }
+
+    validatedItems.push({
+      candidateRestaurantId: cleanId,
+      action: normalizedAction as CandidateVerificationAction,
+      rejectionReason:
+        typeof rejectionReason === "string" ? rejectionReason.trim() : undefined,
+    });
+  }
+
+  return { reviews: validatedItems };
+}
+
+/**
+ * Summarizes the review results into counts.
+ */
+export function formatCandidateReviewSummary(
+  results: CandidateReviewResult[]
+): { approved: number; rejected: number; total: number } {
+  let approved = 0;
+  let rejected = 0;
+  for (const res of results) {
+    if (res.is_approved === true) {
+      approved++;
+    } else if (res.is_approved === false) {
+      rejected++;
+    }
+  }
+  return { approved, rejected, total: results.length };
+}
+
+/**
+ * Parses query options into structured filter parameters.
+ */
+export function parseCandidateWorkflowFilters(query: any): CandidateWorkflowFilterOptions {
+  const options: CandidateWorkflowFilterOptions = {};
+  if (query.status && typeof query.status === "string") {
+    options.status = query.status.trim();
+  }
+  if (query.adminId && typeof query.adminId === "string") {
+    options.adminId = query.adminId.trim();
+  }
+  if (query.limit) {
+    const lim = parseInt(query.limit, 10);
+    if (!isNaN(lim) && lim > 0) options.limit = Math.min(lim, 100);
+  }
+  if (query.offset) {
+    const off = parseInt(query.offset, 10);
+    if (!isNaN(off) && off >= 0) options.offset = off;
+  }
+  return options;
+}
+
+/**
+ * Builds an immutable audit log entry for candidate restaurant reviews.
+ */
+export function createCandidateAuditEntry(
+  candidateId: string,
+  name: string,
+  action: CandidateVerificationAction,
+  prevState: boolean | null,
+  newState: boolean,
+  createdRestId: string | null | undefined,
+  reviewerId: string
+): CandidateReviewAuditRecord {
+  return {
+    auditId: `cand_audit_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`,
+    candidateRestaurantId: candidateId,
+    restaurantName: name,
+    action,
+    previousApprovalState: prevState,
+    newApprovalState: newState,
+    createdRestaurantId: createdRestId || null,
+    reviewerId,
+    timestamp: new Date().toISOString(),
+  };
+}
+
+/**
+ * Calculates statistics across candidate review outcomes.
+ */
+export function computeCandidateStatistics(
+  results: CandidateReviewResult[]
+): CandidateWorkflowStatistics {
+  let pending = 0;
+  let approved = 0;
+  let rejected = 0;
+
+  for (const r of results) {
+    if (r.is_approved === true) approved++;
+    else if (r.is_approved === false) rejected++;
+    else pending++;
+  }
+
+  const totalDecided = approved + rejected;
+  const conversionRate =
+    totalDecided > 0 ? Math.round((approved / totalDecided) * 10000) / 100 : 0;
+
+  return {
+    totalPending: pending,
+    totalApproved: approved,
+    totalRejected: rejected,
+    conversionRatePercentage: conversionRate,
+  };
+}
+
+/**
+ * Formats an event log string for verification debugging.
+ */
+export function formatCandidateEventLog(
+  candidateId: string,
+  action: CandidateVerificationAction,
+  reviewerId: string
+): string {
+  return `[CandidateWorkflow] Candidate '${candidateId}' was reviewed with action '${action}' by reviewer '${reviewerId}' at ${new Date().toISOString()}`;
+}
