diff --git a/rateeat_backend/src/services/candidate-restaurant-verification.service.ts b/rateeat_backend/src/services/candidate-restaurant-verification.service.ts
new file mode 100644
index 0000000..e3d07df
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-restaurant-verification.service.ts
@@ -0,0 +1,197 @@
+/**
+ * Reliable candidate restaurant verification.
+ *
+ * Every review (single or batch) runs inside a database transaction with a
+ * row-level lock on the candidate so concurrent reviewers are serialized. A
+ * batch shares one transaction: if any entry is missing, already reviewed or
+ * fails while persisting its side effects, the whole batch rolls back.
+ */
+import { Transaction } from "sequelize";
+import {
+  AdminUser,
+  CandidateRestaurant,
+  CandidateRestaurantMenuImage,
+  Notification,
+  Restaurant,
+  RestaurantImage,
+} from "../models";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import {
+  CandidateAlreadyReviewedError,
+  CandidateRestaurantNotFoundError,
+} from "../utils/candidate-restaurant-verification.errors";
+import { buildRestaurantDraftFromCandidate } from "../utils/candidate-restaurant-verification.utils";
+import {
+  CandidateReviewInput,
+  CandidateReviewResult,
+  CandidateStatusMetrics,
+} from "../types/candidate-restaurant-verification.types";
+
+interface SequelizeLike {
+  transaction<T>(callback: (tx: Transaction) => PromiseLike<T>): Promise<T>;
+}
+
+/**
+ * Use the Sequelize instance the models are actually registered on, rather than
+ * importing `config/db` directly. That keeps every write on one connection (so
+ * the transaction and its row lock are honoured) and avoids eagerly loading
+ * `config/db` — which would instantiate every model and break unit suites that
+ * partially mock `../models`.
+ */
+const getSequelize = (): SequelizeLike => {
+  const instance = (CandidateRestaurant as unknown as {
+    sequelize?: SequelizeLike;
+  }).sequelize;
+  if (!instance) {
+    throw new Error("Sequelize instance is not initialised");
+  }
+  return instance;
+};
+
+export class CandidateRestaurantVerificationService {
+  /**
+   * Review a single candidate restaurant inside its own transaction.
+   */
+  static async reviewOne(
+    input: CandidateReviewInput,
+    reviewedBy: string
+  ): Promise<CandidateReviewResult> {
+    return getSequelize().transaction((tx) =>
+      this.reviewWithinTransaction(input, reviewedBy, tx)
+    );
+  }
+
+  /**
+   * Review a list of candidate restaurants atomically. Results are returned in
+   * the exact order requested; any failure rolls the entire batch back.
+   */
+  static async reviewBatch(
+    inputs: CandidateReviewInput[],
+    reviewedBy: string
+  ): Promise<CandidateReviewResult[]> {
+    return getSequelize().transaction(async (tx) => {
+      const results: CandidateReviewResult[] = [];
+      for (const input of inputs) {
+        results.push(
+          await this.reviewWithinTransaction(input, reviewedBy, tx)
+        );
+      }
+      return results;
+    });
+  }
+
+  /**
+   * Aggregate candidate restaurant counts by lifecycle state.
+   */
+  static async getMetrics(): Promise<CandidateStatusMetrics> {
+    const [approved, rejected, total] = await Promise.all([
+      CandidateRestaurant.count({ where: { is_approved: true } }),
+      CandidateRestaurant.count({ where: { is_rejected: true } }),
+      CandidateRestaurant.count(),
+    ]);
+    const pending = Math.max(total - approved - rejected, 0);
+    return { pending, approved, rejected, total };
+  }
+
+  private static async reviewWithinTransaction(
+    input: CandidateReviewInput,
+    reviewedBy: string,
+    tx: Transaction
+  ): Promise<CandidateReviewResult> {
+    const candidate = await CandidateRestaurant.findByPk(
+      input.candidateRestaurantId,
+      { transaction: tx, lock: tx.LOCK.UPDATE }
+    );
+
+    if (!candidate) {
+      throw new CandidateRestaurantNotFoundError();
+    }
+
+    if (candidate.is_approved) {
+      throw new CandidateAlreadyReviewedError(
+        `Candidate restaurant ${candidate.id} has already been approved`
+      );
+    }
+    if (candidate.is_rejected) {
+      throw new CandidateAlreadyReviewedError(
+        `Candidate restaurant ${candidate.id} has already been rejected`
+      );
+    }
+
+    if (input.action === "reject") {
+      candidate.is_rejected = true;
+      candidate.rejection_reason = input.rejectionReason;
+      await candidate.save({ transaction: tx });
+      return {
+        candidate_restaurant_id: candidate.id,
+        name: candidate.name,
+        status: "rejected",
+        rejection_reason: input.rejectionReason,
+        restaurant_id: null,
+        reviewed_by: reviewedBy,
+      };
+    }
+
+    candidate.is_approved = true;
+    await candidate.save({ transaction: tx });
+
+    const restaurant = await Restaurant.create(
+      buildRestaurantDraftFromCandidate(candidate) as any,
+      { transaction: tx }
+    );
+
+    await this.copyCandidateMedia(candidate.id, restaurant.id, tx);
+    await this.notifyAdmins(candidate.name, restaurant.id, reviewedBy, tx);
+
+    return {
+      candidate_restaurant_id: candidate.id,
+      name: candidate.name,
+      status: "approved",
+      rejection_reason: null,
+      restaurant_id: restaurant.id,
+      reviewed_by: reviewedBy,
+    };
+  }
+
+  private static async copyCandidateMedia(
+    candidateRestaurantId: string,
+    restaurantId: string,
+    tx: Transaction
+  ): Promise<void> {
+    const media = await CandidateRestaurantMenuImage.findAll({
+      where: { candidate_restaurant_id: candidateRestaurantId },
+      transaction: tx,
+    });
+
+    for (const image of media) {
+      await RestaurantImage.create(
+        { restaurant_id: restaurantId, url: image.url } as any,
+        { transaction: tx }
+      );
+    }
+  }
+
+  private static async notifyAdmins(
+    candidateName: string,
+    restaurantId: string,
+    reviewedBy: string,
+    tx: Transaction
+  ): Promise<void> {
+    const admins = await AdminUser.findAll({ transaction: tx });
+
+    for (const admin of admins) {
+      await Notification.create(
+        {
+          user_id: admin.id,
+          user_type: "AdminUser",
+          reactor_id: reviewedBy,
+          notifiable_type: "Restaurant",
+          notifiable_id: restaurantId,
+          message: `Candidate restaurant "${candidateName}" has been activated`,
+          notification_category: NotificationCategory.General,
+        } as any,
+        { transaction: tx }
+      );
+    }
+  }
+}
