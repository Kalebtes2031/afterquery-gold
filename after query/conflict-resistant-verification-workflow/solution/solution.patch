@@ -0,0 +1,126 @@
+/**
+ * Pure helpers for the reliable candidate restaurant verification workflow:
+ * action normalization, batch payload validation and the restaurant draft
+ * builder. Kept free of database and Express imports.
+ */
+import { CandidateReviewValidationError } from "./candidate-restaurant-verification.errors";
+import {
+  CandidateReviewAction,
+  CandidateReviewInput,
+} from "../types/candidate-restaurant-verification.types";
+
+const REVIEW_ACTIONS: CandidateReviewAction[] = ["approve", "reject"];
+
+/**
+ * Normalizes an arbitrary action value to `"approve"` / `"reject"`, tolerating
+ * surrounding whitespace and mixed casing. Returns `null` when unrecognized.
+ */
+export function normalizeReviewAction(
+  raw: unknown
+): CandidateReviewAction | null {
+  if (typeof raw !== "string") return null;
+  const cleaned = raw.trim().toLowerCase();
+  return (REVIEW_ACTIONS as string[]).includes(cleaned)
+    ? (cleaned as CandidateReviewAction)
+    : null;
+}
+
+/**
+ * Trims a candidate-supplied rejection reason, returning `null` when it is
+ * missing or blank.
+ */
+export function normalizeRejectionReason(raw: unknown): string | null {
+  return typeof raw === "string" && raw.trim().length > 0 ? raw.trim() : null;
+}
+
+/**
+ * Validates and normalizes the `PUT /batch-review` request body.
+ *
+ * Throws {@link CandidateReviewValidationError} (HTTP 400) when the payload is
+ * missing / `reviews` is not a non-empty array, an entry is not an object, an
+ * entry lacks a usable `candidateRestaurantId`, an action is unknown, or the
+ * same candidate id (trimmed) appears more than once.
+ */
+export function validateBatchReviewPayload(
+  body: unknown
+): CandidateReviewInput[] {
+  const reviews =
+    body && typeof body === "object"
+      ? (body as Record<string, unknown>).reviews
+      : undefined;
+
+  if (!Array.isArray(reviews) || reviews.length === 0) {
+    throw new CandidateReviewValidationError(
+      "The reviews field must be a non-empty array"
+    );
+  }
+
+  const seen = new Set<string>();
+  const normalized: CandidateReviewInput[] = [];
+
+  reviews.forEach((entry, index) => {
+    if (!entry || typeof entry !== "object" || Array.isArray(entry)) {
+      throw new CandidateReviewValidationError(
+        `Review entry at index ${index} must be an object`
+      );
+    }
+
+    const record = entry as Record<string, unknown>;
+    const rawId = record.candidateRestaurantId;
+    const candidateRestaurantId =
+      typeof rawId === "string" ? rawId.trim() : "";
+
+    if (!candidateRestaurantId) {
+      throw new CandidateReviewValidationError(
+        `Review entry at index ${index} requires a candidateRestaurantId`
+      );
+    }
+
+    const action = normalizeReviewAction(record.action);
+    if (!action) {
+      throw new CandidateReviewValidationError(
+        `Review entry at index ${index} requires an action of approve or reject`
+      );
+    }
+
+    if (seen.has(candidateRestaurantId)) {
+      throw new CandidateReviewValidationError(
+        "Duplicate candidate restaurant id"
+      );
+    }
+    seen.add(candidateRestaurantId);
+
+    normalized.push({
+      candidateRestaurantId,
+      action,
+      rejectionReason: normalizeRejectionReason(record.rejectionReason),
+    });
+  });
+
+  return normalized;
+}
+
+/**
+ * Builds the active `Restaurant` attributes copied from a candidate on
+ * approval.
+ */
+export function buildRestaurantDraftFromCandidate(candidate: {
+  name: string;
+  description?: string | null;
+  opening_hour?: unknown;
+  closing_hour?: unknown;
+}): {
+  name: string;
+  description: string | null;
+  opening_hour: unknown;
+  closing_hour: unknown;
+  is_open: boolean;
+} {
+  return {
+    name: candidate.name,
+    description: candidate.description ?? null,
+    opening_hour: candidate.opening_hour,
+    closing_hour: candidate.closing_hour,
+    is_open: true,
+  };
+}
