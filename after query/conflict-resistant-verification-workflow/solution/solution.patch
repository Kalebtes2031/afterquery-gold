@@ -0,0 +1,35 @@
+/**
+ * Thin error subclasses for the candidate restaurant verification workflow.
+ *
+ * The shared helpers in `error-response.utils` rewrite the message that is
+ * handed to them (`BadRequestError` collapses everything to "Bad request",
+ * `NotFoundError`/`ConflictError` append canned suffixes). These subclasses
+ * keep the correct `statusCode` and `instanceof` behavior while restoring the
+ * literal, caller-supplied message so API responses stay precise.
+ */
+import {
+  BadRequestError,
+  ConflictError,
+  NotFoundError,
+} from "./error-response.utils";
+
+export class CandidateReviewValidationError extends BadRequestError {
+  constructor(message: string) {
+    super(message);
+    this.message = message;
+  }
+}
+
+export class CandidateRestaurantNotFoundError extends NotFoundError {
+  constructor(message = "Candidate restaurant not found") {
+    super(message);
+    this.message = message;
+  }
+}
+
+export class CandidateAlreadyReviewedError extends ConflictError {
+  constructor(message: string) {
+    super(message);
+    this.message = message;
+  }
+}
diff --git a/rateeat_backend/src/utils/candidate-restaurant-verification.utils.ts b/rateeat_backend/src/utils/candidate-restaurant-verification.utils.ts
