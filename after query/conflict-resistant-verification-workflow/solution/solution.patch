+/**
+ * Action options for candidate restaurant review.
+ */
+export enum CandidateReviewAction {
+  Approve = "approve",
+  Reject = "reject",
+}
+
+/**
+ * Valid lifecycle states for candidate restaurant review.
+ */
+export enum CandidateReviewStatus {
+  Pending = "Pending",
+  Approved = "Approved",
+  Rejected = "Rejected",
+}
+
+/**
+ * Single item inside a batch candidate review payload.
+ */
+export interface BatchCandidateReviewItem {
+  candidateRestaurantId: string;
+  action: CandidateReviewAction | "approve" | "reject";
+  rejectionReason?: string;
+}
+
+/**
+ * Payload schema for PUT /api/v1/candidate-restaurants/batch-review.
+ */
+export interface BatchCandidateReviewPayload {
+  reviews: BatchCandidateReviewItem[];
+}
+
+/**
+ * Result representation for an individual candidate restaurant review.
+ */
+export interface CandidateReviewResult {
+  id: string;
+  name: string;
+  is_approved: boolean;
+  rejection_reason?: string | null;
+  reviewed_by: string;
+  created_restaurant_id?: string;
+}
+
+/**
+ * Response schema for batch candidate review execution.
+ */
+export interface BatchCandidateReviewResponse {
+  totalProcessed: number;
+  approvedCount: number;
+  rejectedCount: number;
+  results: CandidateReviewResult[];
+}
+
+/**
+ * Filter options for candidate restaurant queries.
+ */
+export interface CandidateFilterOptions {
+  status?: "pending" | "approved" | "rejected";
+  search?: string;
+  limit?: number;
+  offset?: number;
+}
diff --git a/rateeat_backend/src/utils/candidate-restaurant-workflow.utils.ts b/rateeat_backend/src/utils/candidate-restaurant-workflow.utils.ts
new file mode 100644
index 0000000..4798e24
--- /dev/null
+++ b/rateeat_backend/src/utils/candidate-restaurant-workflow.utils.ts
@@ -0,0 +1,198 @@
+import { BadRequestError } from "../utils/error-response.utils";
+import {
+  BatchCandidateReviewItem,
+  BatchCandidateReviewPayload,
+  CandidateFilterOptions,
+  CandidateReviewAction,
+  CandidateReviewResult,
+} from "../types/candidate-restaurant-workflow.types";
+
+/**
+ * Validates batch review payload for structural integrity and duplicate identifiers.
+ */
+export function validateBatchCandidateReviewPayload(
+  body: any
+): BatchCandidateReviewPayload {
+  if (!body || typeof body !== "object") {
+    throw new BadRequestError("Request body must be a valid JSON object");
+  }
+
+  const { reviews } = body;
+  if (!Array.isArray(reviews)) {
+    throw new BadRequestError("Field 'reviews' must be an array");
+  }
+
+  if (reviews.length === 0) {
+    throw new BadRequestError("Field 'reviews' cannot be an empty array");
+  }
+
+  const seenIds = new Set<string>();
+  const validatedItems: BatchCandidateReviewItem[] = [];
+
+  for (let i = 0; i < reviews.length; i++) {
+    const item = reviews[i];
+    if (!item || typeof item !== "object") {
+      throw new BadRequestError(`Review item at index ${i} must be an object`);
+    }
+
+    const { candidateRestaurantId, action, rejectionReason } = item;
+    if (
+      !candidateRestaurantId ||
+      typeof candidateRestaurantId !== "string" ||
+      candidateRestaurantId.trim().length === 0
+    ) {
+      throw new BadRequestError(
+        `Review item at index ${i} is missing a valid 'candidateRestaurantId'`
+      );
+    }
+
+    const cleanId = candidateRestaurantId.trim();
+    if (seenIds.has(cleanId)) {
+      throw new BadRequestError(
+        `Duplicate candidate restaurant id '${cleanId}' detected in batch payload`
+      );
+    }
+    seenIds.add(cleanId);
+
+    const normAction =
+      typeof action === "string" ? action.toLowerCase().trim() : "";
+    if (
+      normAction !== CandidateReviewAction.Approve &&
+      normAction !== CandidateReviewAction.Reject
+    ) {
+      throw new BadRequestError(
+        `Invalid review action '${action}' at index ${i}. Must be 'approve' or 'reject'`
+      );
+    }
+
+    validatedItems.push({
+      candidateRestaurantId: cleanId,
+      action: normAction as CandidateReviewAction,
+      rejectionReason:
+        typeof rejectionReason === "string" ? rejectionReason.trim() : undefined,
+    });
+  }
+
+  return { reviews: validatedItems };
+}
+
+/**
+ * Summarizes the review counts from a batch result list.
+ */
+export function formatCandidateReviewSummary(
+  results: CandidateReviewResult[]
+): { approved: number; rejected: number; total: number } {
+  let approved = 0;
+  let rejected = 0;
+  for (const r of results) {
+    if (r.is_approved) approved++;
+    else rejected++;
+  }
+  return { approved, rejected, total: results.length };
+}
+
+/**
+ * Parses query string parameters into structured candidate filter options.
+ */
+export function parseCandidateFilters(query: any): CandidateFilterOptions {
+  const options: CandidateFilterOptions = {};
+  if (query.status && typeof query.status === "string") {
+    const s = query.status.toLowerCase().trim();
+    if (s === "pending" || s === "approved" || s === "rejected") {
+      options.status = s;
+    }
+  }
+  if (query.search && typeof query.search === "string") {
+    options.search = query.search.trim();
+  }
+  if (query.limit) {
+    const lim = parseInt(query.limit, 10);
+    if (!isNaN(lim) && lim > 0) options.limit = Math.min(lim, 100);
+  }
+  if (query.offset) {
+    const off = parseInt(query.offset, 10);
+    if (!isNaN(off) && off >= 0) options.offset = off;
+  }
+  return options;
+}
+
+/**
+ * Validates candidate identifier string format.
+ */
+
+/**
+ * Formats a candidate restaurant record for audit logging.
+ */
+export function formatCandidateAuditLog(
+  candidate: any,
+  action: string,
+  reviewerId: string
+): Record<string, any> {
+  return {
+    candidateId: candidate.id,
+    name: candidate.name,
+    decision: action === "approve" ? "Approved" : "Rejected",
+    reviewerId,
+    timestamp: new Date().toISOString(),
+  };
+}
+
+/**
+ * Validates candidate review transition eligibility.
+ */
+export function isCandidateReviewable(isApproved: boolean | null | undefined): boolean {
+  return isApproved === null || isApproved === undefined;
+}
+
+
+/**
+ * Serializes candidate restaurant records for export reporting.
+ */
+export function serializeCandidateReport(
+  candidates: CandidateRestaurant[] | any[]
+): Array<Record<string, any>> {
+  return candidates.map((c) => ({
+    id: c.id,
+    name: c.name,
+    isApproved: c.is_approved === true ? "Approved" : c.is_approved === false ? "Rejected" : "Pending",
+    address: c.address || "N/A",
+    phoneNumber: c.phone_number || "N/A",
+    imageCount: c.candidate_restaurant_images ? c.candidate_restaurant_images.length : 0,
+    videoCount: c.candidate_restaurant_videos ? c.candidate_restaurant_videos.length : 0,
+  }));
+}
+
+/**
+ * Validates candidate review payload bounds.
+ */
+export function validateCandidateBatchBounds(
+  reviews: BatchCandidateReviewItem[],
+  maxLimit: number = 50
+): { valid: boolean; error?: string } {
+  if (!reviews || reviews.length === 0) {
+    return { valid: false, error: "Reviews array cannot be empty" };
+  }
+  if (reviews.length > maxLimit) {
+    return { valid: false, error: `Reviews array exceeds limit of ${maxLimit}` };
+  }
+  return { valid: true };
+}
+
+/**
+ * Formats restaurant creation payload derived from candidate record.
+ */
+export function buildRestaurantFromCandidate(
+  candidate: any
+): { name: string; address?: string; phone_number?: string; is_active: boolean } {
+  return {
+    name: candidate.name,
+    address: candidate.address,
+    phone_number: candidate.phone_number,
+    is_active: true,
+  };
+}
+
+export function isValidCandidateIdentifier(id: string): boolean {
+  if (!id || typeof id !== "string") return false;
+  return id.trim().length > 0;
+}
