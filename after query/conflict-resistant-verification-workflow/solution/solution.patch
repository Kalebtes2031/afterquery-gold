+import sequelize from "../config/db";
+import {
+  BatchCandidateReviewItem,
+  BatchCandidateReviewResponse,
+  CandidateReviewResult,
+  CandidateVerificationAction,
+} from "../types/candidate-restaurant-workflow.types";
+import { CandidateRestaurantWorkflowService } from "./candidate-restaurant-workflow.service";
+
+export class CandidateRestaurantConflictService {
+  /**
+   * Executes multiple candidate restaurant reviews atomically in a single transaction.
+   */
+  public static async executeBatchReview(
+    items: BatchCandidateReviewItem[],
+    reviewerId: string
+  ): Promise<BatchCandidateReviewResponse> {
+    return sequelize.transaction(async (tx) => {
+      const results: CandidateReviewResult[] = [];
+      let approvedCount = 0;
+      let rejectedCount = 0;
+
+      for (const item of items) {
+        const result =
+          await CandidateRestaurantWorkflowService.verifyCandidateWithLock(
+            item.candidateRestaurantId,
+            item.action,
+            reviewerId,
+            item.rejectionReason,
+            tx
+          );
+
+        results.push(result);
+        if (
+          item.action === CandidateVerificationAction.Approve ||
+          item.action === "approve"
+        ) {
+          approvedCount++;
+        } else {
+          rejectedCount++;
+        }
+      }
+
+      return {
+        totalReviewed: results.length,
+        approvedCount,
+        rejectedCount,
+        results,
+      };
+    });
+  }
+
+  /**
+   * Validates that batch review candidate identifiers are distinct.
+   */
+  public static async validateBatchDistinctness(
+    candidateIds: string[]
+  ): Promise<boolean> {
+    if (!candidateIds || candidateIds.length === 0) return false;
+    const set = new Set(candidateIds.map((c) => c.trim()));
+    return set.size === candidateIds.length;
+  }
+}
diff --git a/rateeat_backend/src/services/candidate-restaurant-workflow.service.ts b/rateeat_backend/src/services/candidate-restaurant-workflow.service.ts
new file mode 100644
index 0000000..82afa43
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-restaurant-workflow.service.ts
@@ -0,0 +1,193 @@
+import { Transaction } from "sequelize";
+import sequelize from "../config/db";
+import {
+  AdminUser,
+  CandidateRestaurant,
+  CandidateRestaurantImage,
+  CandidateRestaurantVideo,
+  Notification,
+  Restaurant,
+  RestaurantMedia,
+} from "../models";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import {
+  ConflictError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import {
+  CandidateReviewResult,
+  CandidateVerificationAction,
+  CandidateWorkflowFilterOptions,
+} from "../types/candidate-restaurant-workflow.types";
+import { createCandidateAuditEntry } from "../utils/candidate-restaurant-workflow.utils";
+
+export class CandidateRestaurantWorkflowService {
+  /**
+   * Evaluates and updates a single candidate restaurant atomically under a row lock.
+   */
+  public static async verifyCandidateWithLock(
+    candidateId: string,
+    action: CandidateVerificationAction | "approve" | "reject",
+    reviewerId: string,
+    rejectionReason?: string,
+    externalTransaction?: Transaction
+  ): Promise<CandidateReviewResult> {
+    const executeReview = async (tx: Transaction) => {
+      const candidate = await CandidateRestaurant.findByPk(candidateId, {
+        include: [
+          { model: CandidateRestaurantImage, as: "candidate_restaurant_images" },
+          { model: CandidateRestaurantVideo, as: "candidate_restaurant_videos" },
+        ],
+        transaction: tx,
+        lock: tx.LOCK.UPDATE,
+      });
+
+      if (!candidate) {
+        throw new NotFoundError("Candidate restaurant not found");
+      }
+
+      const initialStatus = candidate.is_approved;
+
+      if (candidate.is_approved === true) {
+        throw new ConflictError(
+          `Candidate restaurant '${candidateId}' is already approved`
+        );
+      }
+
+      if (candidate.is_approved === false) {
+        throw new ConflictError(
+          `Candidate restaurant '${candidateId}' is already rejected`
+        );
+      }
+
+      const now = new Date();
+
+      if (action === CandidateVerificationAction.Approve || action === "approve") {
+        candidate.is_approved = true;
+        await candidate.save({ transaction: tx });
+
+        const createdRestaurant = await Restaurant.create(
+          {
+            name: candidate.name,
+            address: (candidate as any).address || null,
+            phone_number: (candidate as any).phone_number || null,
+            description: (candidate as any).description || null,
+            is_active: true,
+          },
+          { transaction: tx }
+        );
+
+        if ((candidate as any).candidate_restaurant_images) {
+          for (const img of (candidate as any).candidate_restaurant_images) {
+            await RestaurantMedia.create(
+              {
+                restaurant_id: createdRestaurant.id,
+                url: img.url,
+                media_type: "image",
+              },
+              { transaction: tx }
+            );
+          }
+        }
+
+        const superAdmins = await AdminUser.findAll({
+          where: { is_super_admin: true },
+          transaction: tx,
+        });
+
+        for (const admin of superAdmins) {
+          await Notification.create(
+            {
+              user_id: admin.id,
+              category: NotificationCategory.RestaurantClaim,
+              title: "Candidate Restaurant Approved",
+              message: `Candidate restaurant '${candidate.name}' approved and restaurant '${createdRestaurant.id}' created.`,
+            },
+            { transaction: tx }
+          );
+        }
+
+        createCandidateAuditEntry(
+          candidate.id,
+          candidate.name,
+          CandidateVerificationAction.Approve,
+          initialStatus,
+          true,
+          createdRestaurant.id,
+          reviewerId
+        );
+
+        return {
+          id: candidate.id,
+          name: candidate.name,
+          is_approved: true,
+          reviewed_by: reviewerId,
+          reviewed_at: now,
+          created_restaurant_id: createdRestaurant.id,
+          rejection_reason: null,
+        };
+      } else {
+        candidate.is_approved = false;
+        if (rejectionReason) {
+          (candidate as any).rejection_reason = rejectionReason;
+        }
+        await candidate.save({ transaction: tx });
+
+        createCandidateAuditEntry(
+          candidate.id,
+          candidate.name,
+          CandidateVerificationAction.Reject,
+          initialStatus,
+          false,
+          null,
+          reviewerId
+        );
+
+        return {
+          id: candidate.id,
+          name: candidate.name,
+          is_approved: false,
+          reviewed_by: reviewerId,
+          reviewed_at: now,
+          created_restaurant_id: null,
+          rejection_reason: rejectionReason || null,
+        };
+      }
+    };
+
+    if (externalTransaction) {
+      return executeReview(externalTransaction);
+    } else {
+      return sequelize.transaction(async (tx) => executeReview(tx));
+    }
+  }
+
+  /**
+   * Retrieves pending candidate restaurants.
+   */
+  public static async getPendingCandidates(
+    filters: CandidateWorkflowFilterOptions = {}
+  ): Promise<any[]> {
+    const where: any = { is_approved: null };
+    return CandidateRestaurant.findAll({
+      where,
+      limit: filters.limit || 50,
+      offset: filters.offset || 0,
+      order: [["createdAt", "ASC"]],
+    });
+  }
+
+  /**
+   * Counts candidate restaurants by approval status.
+   */
+  public static async getCandidateStatusCounts(): Promise<{
+    pending: number;
+    approved: number;
+    rejected: number;
+  }> {
+    const pending = await CandidateRestaurant.count({ where: { is_approved: null } });
+    const approved = await CandidateRestaurant.count({ where: { is_approved: true } });
+    const rejected = await CandidateRestaurant.count({ where: { is_approved: false } });
+    return { pending, approved, rejected };
+  }
+}
