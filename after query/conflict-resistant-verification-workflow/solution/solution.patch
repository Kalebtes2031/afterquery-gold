+/**
+ * Shared types for the reliable candidate restaurant verification workflow.
+ */
+
+export type CandidateReviewAction = "approve" | "reject";
+
+export type CandidateReviewStatus = "approved" | "rejected";
+
+/**
+ * A single normalized review instruction, produced by payload validation and
+ * consumed by the verification service.
+ */
+export interface CandidateReviewInput {
+  candidateRestaurantId: string;
+  action: CandidateReviewAction;
+  rejectionReason: string | null;
+}
+
+/**
+ * The per-candidate outcome returned to API callers, in the exact order the
+ * reviews were requested.
+ */
+export interface CandidateReviewResult {
+  candidate_restaurant_id: string;
+  name: string;
+  status: CandidateReviewStatus;
+  rejection_reason: string | null;
+  restaurant_id: string | null;
+  reviewed_by: string;
+}
+
+/**
+ * Aggregated candidate restaurant counts for the metrics endpoint.
+ */
+export interface CandidateStatusMetrics {
+  pending: number;
+  approved: number;
+  rejected: number;
+  total: number;
+}
