+import { Transaction } from "sequelize";
+import { CandidateRestaurantReviewAction } from "../constants/candidate-restaurant-review.constants";
+
+export interface CandidateRestaurantReviewContext {
+  reviewerAdminUserId: string;
+  transaction?: Transaction;
+}
+
+export interface CandidateRestaurantReviewResult {
+  candidateRestaurantId: string;
+  action: CandidateRestaurantReviewAction;
+  is_approved: boolean;
+  is_rejected: boolean;
+  restaurant_id: string | null;
+}
diff --git a/rateeat_backend/src/utils/candidate-restaurant-review.utils.ts b/rateeat_backend/src/utils/candidate-restaurant-review.utils.ts
new file mode 100644
index 0000000..67f3b1b
--- /dev/null
+++ b/rateeat_backend/src/utils/candidate-restaurant-review.utils.ts
@@ -0,0 +1,37 @@
+import { HttpError } from "./error-response.utils";
+import {
+  CANDIDATE_RESTAURANT_CHAIN_NAME_SEPARATOR,
+  CandidateRestaurantReviewAction,
+} from "../constants/candidate-restaurant-review.constants";
+
+/**
+ * The generic helpers in error-response.utils.ts rewrite the text they are
+ * handed. These review flows need to surface the message verbatim, so build the
+ * HttpError directly with the exact status/message pair.
+ */
+export const reviewError = (message: string, statusCode: number): HttpError =>
+  new HttpError(message, statusCode);
+
+export const notFoundError = (message: string): HttpError =>
+  reviewError(message, 404);
+
+export const conflictError = (message: string): HttpError =>
+  reviewError(message, 409);
+
+export const serverError = (message: string): HttpError =>
+  reviewError(message, 500);
+
+export const reviewNotificationMessage = (
+  candidateRestaurantName: string,
+  action: CandidateRestaurantReviewAction
+): string => {
+  const verb = action === "approve" ? "approved" : "rejected";
+  return `Candidate restaurant "${candidateRestaurantName}" was ${verb}.`;
+};
+
+export const deriveChainName = (candidateRestaurantName: string): string => {
+  const [head] = String(candidateRestaurantName || "").split(
+    CANDIDATE_RESTAURANT_CHAIN_NAME_SEPARATOR
+  );
+  return (head || "").trim() || String(candidateRestaurantName || "").trim();
+};
