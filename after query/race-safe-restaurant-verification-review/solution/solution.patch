new file mode 100644
index 0000000..cc6ac38
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-restaurant-state.service.ts
@@ -0,0 +1,49 @@
+import {
+  BadRequestError,
+  ConflictError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import { CandidateRestaurantReviewAction } from "../types/candidate-restaurant-verification.types";
+
+export class CandidateRestaurantStateService {
+  public static ensurePendingForReview(
+    candidate: any,
+    action: CandidateRestaurantReviewAction
+  ): void {
+    if (!candidate) {
+      throw new NotFoundError("Candidate Restaurant not found");
+    }
+
+    if (candidate.is_approved) {
+      throw new ConflictError("Candidate Restaurant already approved");
+    }
+
+    if (candidate.is_rejected) {
+      throw new ConflictError("Candidate Restaurant already rejected");
+    }
+  }
+
+  public static validateCandidateStateForApproval(candidate: any): void {
+    if (!candidate) {
+      throw new NotFoundError("Candidate Restaurant not found");
+    }
+    if (candidate.is_approved) {
+      throw new ConflictError("Candidate Restaurant already approved");
+    }
+    if (candidate.is_rejected) {
+      throw new ConflictError("Candidate Restaurant already rejected");
+    }
+  }
+
+  public static validateCandidateStateForRejection(candidate: any): void {
+    if (!candidate) {
+      throw new NotFoundError("Candidate Restaurant not found");
+    }
+    if (candidate.is_rejected) {
+      throw new ConflictError("Candidate Restaurant already rejected");
+    }
+    if (candidate.is_approved) {
+      throw new ConflictError("Candidate Restaurant already approved");
+    }
+  }
+}
diff --git a/rateeat_backend/src/services/candidate-restaurant-verification.service.ts b/rateeat_backend/src/services/candidate-restaurant-verification.service.ts
new file mode 100644
index 0000000..a291e31
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-restaurant-verification.service.ts
@@ -0,0 +1,316 @@
+import { Transaction } from "sequelize";
+import sequelize from "../config/db";
+import {
+  AdminUser,
+  CandidateAdminUser,
+  CandidateRestaurant,
+  CandidateRestaurantLocation,
+  Incentive,
+  ItemReviewIncentive,
+  Restaurant,
+  RestaurantChain,
+  RestaurantLocation,
+} from "../models";
+import { IncentiveType } from "../models/Incentive/ItemReviewIncentive";
+import { generateRandomPassword } from "../utils/auth.util";
+import { sendAdminUserCredentialsEmail } from "../utils/email_otp.utils";
+import {
+  CandidateRestaurantBatchItem,
+  CandidateRestaurantBatchReviewResult,
+} from "../types/candidate-restaurant-verification.types";
+import { extractChainName } from "../utils/candidate-restaurant-verification.utils";
+import { CandidateRestaurantStateService } from "./candidate-restaurant-state.service";
+import {
+  BadRequestError,
+  InternalServerError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+
+export class CandidateRestaurantVerificationService {
+  public static async approveCandidateRestaurantWithLock(
+    candidateRestaurantId: string,
+    adminUserId: string,
+    existingTransaction?: Transaction,
+    accumulatedIncentives?: Map<string, number>
+  ): Promise<any> {
+    const isOuterTransaction = !!existingTransaction;
+    const transaction = existingTransaction || (await sequelize.transaction());
+
+    try {
+      const candidateRestaurant = await CandidateRestaurant.findOne({
+        where: { id: candidateRestaurantId },
+        transaction,
+        lock: transaction.LOCK.UPDATE,
+      });
+
+      CandidateRestaurantStateService.validateCandidateStateForApproval(
+        candidateRestaurant
+      );
+
+      const chainName = extractChainName(candidateRestaurant.name);
+      let restaurantChain = await RestaurantChain.findOne({
+        where: { name: chainName },
+        transaction,
+        lock: transaction.LOCK.UPDATE,
+      });
+
+      if (!restaurantChain) {
+        restaurantChain = await RestaurantChain.create(
+          {
+            name: chainName,
+          },
+          { transaction }
+        );
+      }
+
+      const newRestaurant = await Restaurant.create(
+        {
+          name: candidateRestaurant.name,
+          description: candidateRestaurant.description,
+          opening_hour: candidateRestaurant.opening_hour,
+          closing_hour: candidateRestaurant.closing_hour,
+          is_open: true,
+          restaurant_chain_id: restaurantChain.id,
+        },
+        { transaction }
+      );
+
+      const candidateRestaurantLocation =
+        await CandidateRestaurantLocation.findOne({
+          where: { candidate_restaurant_id: candidateRestaurantId },
+          transaction,
+        });
+
+      if (candidateRestaurantLocation) {
+        await RestaurantLocation.create(
+          {
+            restaurant_id: newRestaurant.id,
+            latitude: candidateRestaurantLocation.latitude,
+            longitude: candidateRestaurantLocation.longitude,
+            description: candidateRestaurantLocation.description,
+          },
+          { transaction }
+        );
+      }
+
+      await CandidateRestaurant.update(
+        { is_approved: true, is_rejected: false },
+        { where: { id: candidateRestaurantId }, transaction }
+      );
+
+      const moneyEarned = 20;
+      if (candidateRestaurant.user_id) {
+        const userId = candidateRestaurant.user_id;
+        let incentive = await Incentive.findOne({
+          where: { user_id: userId },
+          transaction,
+          lock: transaction.LOCK.UPDATE,
+        });
+
+        if (!incentive) {
+          incentive = await Incentive.create(
+            {
+              user_id: userId,
+              current_total: 0,
+            },
+            { transaction }
+          );
+        }
+
+        incentive.current_total = (incentive.current_total || 0) + moneyEarned;
+        await incentive.save({ transaction });
+
+        await ItemReviewIncentive.create(
+          {
+            user_id: userId,
+            points_earned: moneyEarned,
+            incentive_type: IncentiveType.General,
+          },
+          { transaction }
+        );
+
+        if (accumulatedIncentives) {
+          const current = accumulatedIncentives.get(userId) || 0;
+          accumulatedIncentives.set(userId, current + moneyEarned);
+        }
+      }
+
+      if (candidateRestaurant.candidate_admin_user_id) {
+        const candidateAdminUser = await CandidateAdminUser.findOne({
+          where: { id: candidateRestaurant.candidate_admin_user_id },
+          transaction,
+          lock: transaction.LOCK.UPDATE,
+        });
+
+        if (!candidateAdminUser) {
+          throw new NotFoundError("Candidate Admin User not found");
+        }
+
+        if (candidateAdminUser.is_approved) {
+          throw new BadRequestError("Candidate Admin User already approved");
+        }
+
+        const password = generateRandomPassword();
+        const adminUser = await AdminUser.create(
+          {
+            first_name: candidateAdminUser.first_name,
+            last_name: candidateAdminUser.last_name,
+            email: candidateAdminUser.email,
+            phone_number: candidateAdminUser.phone_number,
+            role_id: candidateAdminUser.role_id,
+            password,
+          },
+          { transaction }
+        );
+
+        if (!restaurantChain.admin_user_id) {
+          restaurantChain.admin_user_id = adminUser.id;
+          await restaurantChain.save({ transaction });
+        }
+
+        try {
+          await sendAdminUserCredentialsEmail({
+            email: adminUser.email,
+            password,
+            first_name: adminUser.first_name,
+          });
+        } catch (emailError) {
+          // If sending email fails, fail the transaction
+          throw new InternalServerError("Failed to send credentials email");
+        }
+
+        await CandidateAdminUser.update(
+          { is_approved: true, is_rejected: false },
+          {
+            where: { id: candidateRestaurant.candidate_admin_user_id },
+            transaction,
+          }
+        );
+      }
+
+      if (!isOuterTransaction) {
+        await transaction.commit();
+      }
+
+      return newRestaurant;
+    } catch (error) {
+      if (!isOuterTransaction) {
+        try {
+          await transaction.rollback();
+        } catch (rbErr) {
+          // Ignore rollback error if already resolved
+        }
+      }
+      throw error;
+    }
+  }
+
+  public static async rejectCandidateRestaurantWithLock(
+    candidateRestaurantId: string,
+    adminUserId: string,
+    existingTransaction?: Transaction
+  ): Promise<any> {
+    const isOuterTransaction = !!existingTransaction;
+    const transaction = existingTransaction || (await sequelize.transaction());
+
+    try {
+      const candidateRestaurant = await CandidateRestaurant.findOne({
+        where: { id: candidateRestaurantId },
+        transaction,
+        lock: transaction.LOCK.UPDATE,
+      });
+
+      CandidateRestaurantStateService.validateCandidateStateForRejection(
+        candidateRestaurant
+      );
+
+      if (candidateRestaurant.candidate_admin_user_id) {
+        const candidateAdminUser = await CandidateAdminUser.findOne({
+          where: { id: candidateRestaurant.candidate_admin_user_id },
+          transaction,
+          lock: transaction.LOCK.UPDATE,
+        });
+
+        if (candidateAdminUser) {
+          await CandidateAdminUser.update(
+            { is_rejected: true, is_approved: false, email: null },
+            {
+              where: { id: candidateRestaurant.candidate_admin_user_id },
+              transaction,
+            }
+          );
+        }
+      }
+
+      await CandidateRestaurant.update(
+        { is_rejected: true, is_approved: false },
+        { where: { id: candidateRestaurantId }, transaction }
+      );
+
+      const updatedCandidate = await CandidateRestaurant.findOne({
+        where: { id: candidateRestaurantId },
+        transaction,
+      });
+
+      if (!isOuterTransaction) {
+        await transaction.commit();
+      }
+
+      return updatedCandidate;
+    } catch (error) {
+      if (!isOuterTransaction) {
+        try {
+          await transaction.rollback();
+        } catch (rbErr) {
+          // Ignore rollback error
+        }
+      }
+      throw error;
+    }
+  }
+
+  public static async processBatchCandidateRestaurantReview(
+    items: CandidateRestaurantBatchItem[],
+    adminUserId: string
+  ): Promise<CandidateRestaurantBatchReviewResult> {
+    const transaction = await sequelize.transaction();
+    const accumulatedIncentives = new Map<string, number>();
+    const results: any[] = [];
+
+    try {
+      for (const item of items) {
+        if (item.action === "approve") {
+          const approved =
+            await CandidateRestaurantVerificationService.approveCandidateRestaurantWithLock(
+              item.candidateRestaurantId,
+              adminUserId,
+              transaction,
+              accumulatedIncentives
+            );
+          results.push(approved);
+        } else if (item.action === "reject") {
+          const rejected =
+            await CandidateRestaurantVerificationService.rejectCandidateRestaurantWithLock(
+              item.candidateRestaurantId,
+              adminUserId,
+              transaction
+            );
+          results.push(rejected);
+        }
+      }
+
+      await transaction.commit();
+      return {
+        success: true,
+        data: results,
+      };
+    } catch (error) {
+      try {
+        await transaction.rollback();
+      } catch (rbErr) {
+        // rollback
+      }
+      throw error;
+    }
+  }
+}
