diff --git a/rateeat_backend/src/services/candidate-restaurant-review.service.ts b/rateeat_backend/src/services/candidate-restaurant-review.service.ts
new file mode 100644
index 0000000..a5bd642
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-restaurant-review.service.ts
@@ -0,0 +1,330 @@
+import { Transaction } from "sequelize";
+import {
+  AdminUser,
+  CandidateAdminUser,
+  CandidateRestaurant,
+  Incentive,
+  ItemReviewIncentive,
+  Notification,
+  Restaurant,
+  RestaurantChain,
+} from "../models";
+import { IncentiveType } from "../models/Incentive/ItemReviewIncentive";
+import { NotificationCategory } from "../models/Feedback/Notification";
+import { generateRandomPassword } from "../utils/auth.util";
+import { sendAdminUserCredentialsEmail } from "../utils/email_otp.utils";
+import {
+  CANDIDATE_RESTAURANT_APPROVAL_REWARD,
+  CANDIDATE_RESTAURANT_REVIEW_MESSAGES,
+  CandidateRestaurantReviewAction,
+} from "../constants/candidate-restaurant-review.constants";
+import { CandidateRestaurantReviewResult } from "../types/candidate-restaurant-review.types";
+import {
+  conflictError,
+  deriveChainName,
+  notFoundError,
+  reviewNotificationMessage,
+  serverError,
+} from "../utils/candidate-restaurant-review.utils";
+
+const M = CANDIDATE_RESTAURANT_REVIEW_MESSAGES;
+
+const lockOptions = (transaction?: Transaction) =>
+  transaction ? { transaction, lock: transaction.LOCK.UPDATE } : {};
+
+const txOptions = (transaction?: Transaction) =>
+  transaction ? { transaction } : {};
+
+const loadCandidateForReview = async (
+  candidateRestaurantId: string,
+  transaction?: Transaction
+) => {
+  const candidate = await CandidateRestaurant.findOne({
+    where: { id: candidateRestaurantId },
+    ...lockOptions(transaction),
+  });
+
+  if (!candidate) {
+    throw notFoundError(M.NOT_FOUND);
+  }
+
+  if (candidate.is_approved) {
+    throw conflictError(M.ALREADY_APPROVED);
+  }
+
+  if (candidate.is_rejected) {
+    throw conflictError(M.ALREADY_REJECTED);
+  }
+
+  return candidate;
+};
+
+const findOrCreateChain = async (
+  chainName: string,
+  transaction?: Transaction
+) => {
+  const existing = await RestaurantChain.findOne({
+    where: { name: chainName },
+    ...txOptions(transaction),
+  });
+
+  if (existing) {
+    return existing;
+  }
+
+  return RestaurantChain.create(
+    { name: chainName } as any,
+    txOptions(transaction)
+  );
+};
+
+const awardSubmitterIncentive = async (
+  userId: string,
+  transaction?: Transaction
+) => {
+  let incentive = await Incentive.findOne({
+    where: { user_id: userId },
+    ...lockOptions(transaction),
+  });
+
+  if (!incentive) {
+    incentive = await Incentive.create(
+      { user_id: userId, current_total: 0 } as any,
+      txOptions(transaction)
+    );
+  }
+
+  incentive.current_total =
+    (incentive.current_total || 0) + CANDIDATE_RESTAURANT_APPROVAL_REWARD;
+  await incentive.save(txOptions(transaction));
+
+  await ItemReviewIncentive.create(
+    {
+      user_id: userId,
+      points_earned: CANDIDATE_RESTAURANT_APPROVAL_REWARD,
+      incentive_type: IncentiveType.General,
+    } as any,
+    txOptions(transaction)
+  );
+};
+
+const provisionCandidateAdminUser = async (
+  candidateAdminUserId: string,
+  chain: RestaurantChain,
+  transaction?: Transaction
+) => {
+  const candidateAdminUser = await CandidateAdminUser.findOne({
+    where: { id: candidateAdminUserId },
+    ...lockOptions(transaction),
+  });
+
+  if (!candidateAdminUser) {
+    throw notFoundError(M.ADMIN_NOT_FOUND);
+  }
+
+  if (candidateAdminUser.is_approved) {
+    throw conflictError(M.ADMIN_ALREADY_APPROVED);
+  }
+
+  const password = generateRandomPassword();
+  const adminUser = await AdminUser.create(
+    {
+      first_name: candidateAdminUser.first_name,
+      last_name: candidateAdminUser.last_name,
+      email: candidateAdminUser.email,
+      phone_number: candidateAdminUser.phone_number,
+      role_id: candidateAdminUser.role_id,
+      password,
+    } as any,
+    txOptions(transaction)
+  );
+
+  if (!chain.admin_user_id) {
+    chain.admin_user_id = adminUser.id;
+    await chain.save(txOptions(transaction));
+  }
+
+  try {
+    await sendAdminUserCredentialsEmail({
+      email: adminUser.email,
+      password,
+      first_name: adminUser.first_name,
+    });
+  } catch (error) {
+    throw serverError(M.CREDENTIAL_EMAIL_FAILED);
+  }
+
+  await CandidateAdminUser.update(
+    { is_approved: true },
+    { where: { id: candidateAdminUserId }, ...txOptions(transaction) }
+  );
+};
+
+const notifyAdminsOfReview = async (
+  candidate: CandidateRestaurant,
+  action: CandidateRestaurantReviewAction,
+  reviewerAdminUserId: string,
+  transaction?: Transaction
+) => {
+  const admins = await AdminUser.findAll({ ...txOptions(transaction) });
+  const message = reviewNotificationMessage(candidate.name, action);
+
+  for (const admin of admins) {
+    await Notification.create(
+      {
+        notifiable_type: "CandidateRestaurant",
+        notifiable_id: candidate.id,
+        user_id: admin.id,
+        reactor_id: reviewerAdminUserId,
+        message,
+        notification_category: NotificationCategory.General,
+      } as any,
+      txOptions(transaction)
+    );
+  }
+};
+
+const approveWithinTransaction = async (
+  candidateRestaurantId: string,
+  reviewerAdminUserId: string,
+  transaction?: Transaction
+): Promise<CandidateRestaurantReviewResult> => {
+  const candidate = await loadCandidateForReview(
+    candidateRestaurantId,
+    transaction
+  );
+
+  const chain = await findOrCreateChain(
+    deriveChainName(candidate.name),
+    transaction
+  );
+
+  const restaurant = await Restaurant.create(
+    {
+      name: candidate.name,
+      description: candidate.description,
+      opening_hour: candidate.opening_hour,
+      closing_hour: candidate.closing_hour,
+      is_open: true,
+      restaurant_chain_id: chain.id,
+    } as any,
+    txOptions(transaction)
+  );
+
+  await CandidateRestaurant.update(
+    { is_approved: true },
+    { where: { id: candidateRestaurantId }, ...txOptions(transaction) }
+  );
+
+  if (candidate.user_id) {
+    await awardSubmitterIncentive(candidate.user_id, transaction);
+  }
+
+  if (candidate.candidate_admin_user_id) {
+    await provisionCandidateAdminUser(
+      candidate.candidate_admin_user_id,
+      chain,
+      transaction
+    );
+  }
+
+  await notifyAdminsOfReview(
+    candidate,
+    "approve",
+    reviewerAdminUserId,
+    transaction
+  );
+
+  return {
+    candidateRestaurantId,
+    action: "approve",
+    is_approved: true,
+    is_rejected: false,
+    restaurant_id: restaurant.id,
+  };
+};
+
+const rejectWithinTransaction = async (
+  candidateRestaurantId: string,
+  reviewerAdminUserId: string,
+  transaction?: Transaction
+): Promise<CandidateRestaurantReviewResult> => {
+  const candidate = await loadCandidateForReview(
+    candidateRestaurantId,
+    transaction
+  );
+
+  if (candidate.candidate_admin_user_id) {
+    await CandidateAdminUser.update(
+      { is_rejected: true },
+      {
+        where: { id: candidate.candidate_admin_user_id },
+        ...txOptions(transaction),
+      }
+    );
+  }
+
+  await CandidateRestaurant.update(
+    { is_rejected: true },
+    { where: { id: candidateRestaurantId }, ...txOptions(transaction) }
+  );
+
+  await notifyAdminsOfReview(
+    candidate,
+    "reject",
+    reviewerAdminUserId,
+    transaction
+  );
+
+  return {
+    candidateRestaurantId,
+    action: "reject",
+    is_approved: false,
+    is_rejected: true,
+    restaurant_id: null,
+  };
+};
+
+const runWithinTransaction = (
+  action: CandidateRestaurantReviewAction,
+  candidateRestaurantId: string,
+  reviewerAdminUserId: string,
+  transaction?: Transaction
+) =>
+  action === "approve"
+    ? approveWithinTransaction(
+        candidateRestaurantId,
+        reviewerAdminUserId,
+        transaction
+      )
+    : rejectWithinTransaction(
+        candidateRestaurantId,
+        reviewerAdminUserId,
+        transaction
+      );
+
+const withTransaction = <T>(
+  work: (transaction?: Transaction) => Promise<T>
+): Promise<T> => {
+  const sequelize = CandidateRestaurant.sequelize;
+
+  if (!sequelize) {
+    return work();
+  }
+
+  return sequelize.transaction((transaction) => work(transaction));
+};
+
+export const reviewCandidateRestaurant = (
+  action: CandidateRestaurantReviewAction,
+  candidateRestaurantId: string,
+  reviewerAdminUserId: string
+): Promise<CandidateRestaurantReviewResult> =>
+  withTransaction((transaction) =>
+    runWithinTransaction(
+      action,
+      candidateRestaurantId,
+      reviewerAdminUserId,
+      transaction
+    )
+  );
