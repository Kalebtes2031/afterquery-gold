+import { BadRequestError } from "./error-response.utils";
+import {
+  CandidateRestaurantBatchItem,
+  CandidateRestaurantReviewAction,
+} from "../types/candidate-restaurant-verification.types";
+
+export const validateReviewAction = (action: any): CandidateRestaurantReviewAction => {
+  if (!action || typeof action !== "string") {
+    throw new BadRequestError("Review action must be a string");
+  }
+  const normalized = action.toLowerCase().trim();
+  if (normalized !== "approve" && normalized !== "reject") {
+    throw new BadRequestError("Invalid review action: must be 'approve' or 'reject'");
+  }
+  return normalized as CandidateRestaurantReviewAction;
+};
+
+export const validateBatchReviewPayload = (
+  payload: any
+): CandidateRestaurantBatchItem[] => {
+  if (!payload || typeof payload !== "object") {
+    throw new BadRequestError("Request body must be an object");
+  }
+
+  const { items } = payload;
+  if (!Array.isArray(items)) {
+    throw new BadRequestError("Field 'items' must be a non-empty array");
+  }
+
+  if (items.length === 0) {
+    throw new BadRequestError("Field 'items' cannot be empty");
+  }
+
+  const seenIds = new Set<string>();
+  const validatedItems: CandidateRestaurantBatchItem[] = [];
+
+  for (let i = 0; i < items.length; i++) {
+    const item = items[i];
+    if (!item || typeof item !== "object") {
+      throw new BadRequestError(`Batch item at index ${i} must be an object`);
+    }
+
+    const { candidateRestaurantId, action } = item;
+    if (!candidateRestaurantId || typeof candidateRestaurantId !== "string") {
+      throw new BadRequestError(
+        `Batch item at index ${i} must contain a valid candidateRestaurantId string`
+      );
+    }
+
+    const trimmedId = candidateRestaurantId.trim();
+    if (!trimmedId) {
+      throw new BadRequestError(
+        `Batch item at index ${i} must contain a non-empty candidateRestaurantId`
+      );
+    }
+
+    if (seenIds.has(trimmedId)) {
+      throw new BadRequestError("Duplicate candidate restaurant id");
+    }
+    seenIds.add(trimmedId);
+
+    const validAction = validateReviewAction(action);
+    validatedItems.push({
+      candidateRestaurantId: trimmedId,
+      action: validAction,
+    });
+  }
+
+  return validatedItems;
+};
+
+export const extractChainName = (restaurantName: string): string => {
+  if (!restaurantName || typeof restaurantName !== "string") {
+    return "Default Chain";
+  }
+  const parts = restaurantName.split(" | ");
+  return parts[0].trim() || restaurantName.trim();
+};
