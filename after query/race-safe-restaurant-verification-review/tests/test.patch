+import express from "express";
+import request from "supertest";
+import candidateRestaurantRouter from "../../routes/candidate_restaurant.route";
+import {
+  CandidateRestaurant,
+  Restaurant,
+  RestaurantMedia,
+} from "../../models";
+
+jest.mock("../../middlewares/auth", () => ({
+  authenticateToken: (req: any, _res: any, next: any) => {
+    req.user = { id: "admin-uuid-1", is_super_admin: true };
+    next();
+  },
+  authorizeRole: (_roles: any) => (_req: any, _res: any, next: any) => next(),
+}));
+
+jest.mock("../../models", () => ({
+  CandidateRestaurant: {
+    findByPk: jest.fn(),
+    count: jest.fn(),
+    findAndCountAll: jest.fn(),
+  },
+  Restaurant: {
+    create: jest.fn(),
+  },
+  RestaurantMedia: {
+    create: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Candidate Restaurant Verification - Batch Review Endpoint", () => {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/candidate-restaurants", candidateRestaurantRouter);
+  app.use((err: any, _req: any, res: any, _next: any) => {
+    res.status(err.statusCode || 500).json({
+      success: false,
+      message: err.message || "Internal Server Error",
+    });
+  });
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  it("returns 400 when body does not contain reviews array", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({});
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when reviews array is empty", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({ reviews: [] });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when duplicate candidate restaurant IDs are detected in batch payload", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [
+          { candidateRestaurantId: "cand-dup-1", action: "approve" },
+          { candidateRestaurantId: "cand-dup-1", action: "reject" },
+        ],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Duplicate candidate restaurant id");
+  });
+
+  it("returns 400 when an invalid candidate review action is specified", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [{ candidateRestaurantId: "cand-1", action: "unknown_action" }],
+      });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when candidateRestaurantId is missing or whitespace only", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [{ candidateRestaurantId: "   ", action: "approve" }],
+      });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("successfully reviews mixed batch candidates in exact requested order", async () => {
+    const mock1 = {
+      id: "cand-b1",
+      name: "Bakery A",
+      is_approved: null,
+      candidate_restaurant_images: [],
+      save: jest.fn().mockResolvedValue(true),
+    };
+    const mock2 = {
+      id: "cand-b2",
+      name: "Bakery B",
+      is_approved: null,
+      save: jest.fn().mockResolvedValue(true),
+    };
+
+    (CandidateRestaurant.findByPk as jest.Mock)
+      .mockResolvedValueOnce(mock1)
+      .mockResolvedValueOnce(mock2);
+    (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-b1" });
+
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [
+          { candidateRestaurantId: "cand-b1", action: "approve" },
+          { candidateRestaurantId: "cand-b2", action: "reject", rejectionReason: "Incomplete menu" },
+        ],
+      });
+
+    expect(res.status).toBe(200);
+    expect(res.body.success).toBe(true);
+    expect(res.body.data).toHaveLength(2);
+    expect(res.body.data[0].id).toBe("cand-b1");
+    expect(res.body.data[0].is_approved).toBe(true);
+    expect(res.body.data[1].id).toBe("cand-b2");
+    expect(res.body.data[1].is_approved).toBe(false);
+  });
+
+  it("rolls back batch when any candidate fails or is not found", async () => {
+    (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(null);
+
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [{ candidateRestaurantId: "cand-missing", action: "approve" }],
+      });
+
+    expect(res.status).toBe(404);
+  });
+
+  it("rolls back batch when any candidate is already in a terminal state", async () => {
+    const mockCandidate = {
+      id: "cand-term",
+      is_approved: true,
+    };
+    (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [{ candidateRestaurantId: "cand-term", action: "approve" }],
+      });
+
+    expect(res.status).toBe(409);
+  });
+
+  it("handles batch candidate reviews with mixed casing in action fields", async () => {
+    const mock1 = { id: "c-case1", name: "C1", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+    const mock2 = { id: "c-case2", name: "C2", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+    (CandidateRestaurant.findByPk as jest.Mock)
+      .mockResolvedValueOnce(mock1)
+      .mockResolvedValueOnce(mock2);
+    (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-c1" });
+
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [
+          { candidateRestaurantId: "c-case1", action: "APPROVE" },
+          { candidateRestaurantId: "c-case2", action: "ReJeCt" },
+        ],
+      });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data[0].is_approved).toBe(true);
+    expect(res.body.data[1].is_approved).toBe(false);
+  });
+
+  it("handles candidate batch with whitespace padding in candidate IDs", async () => {
+    const mock = { id: "c-pad2", name: "Pad Rest", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+    (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mock);
+    (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-pad2" });
+
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [{ candidateRestaurantId: "   c-pad2   ", action: "approve" }],
+      });
+
+    expect(res.status).toBe(200);
+    expect(res.body.data[0].id).toBe("c-pad2");
+  });
+
+  it("ensures batch transaction rolls back when duplicate ID appears with whitespace", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [
+          { candidateRestaurantId: "c-dup-ws2", action: "approve" },
+          { candidateRestaurantId: "   c-dup-ws2   ", action: "reject" },
+        ],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Duplicate candidate restaurant id");
+  });
+
+  it("validates candidate restaurant batch processing with empty comments cleanly", async () => {
+    const mock = { id: "c-comm", name: "Comm Rest", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+    (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mock);
+
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [{ candidateRestaurantId: "c-comm", action: "reject", rejectionReason: "   " }],
+      });
+
+    expect(res.status).toBe(200);
+  });
+
+  it("rejects candidate restaurant batch when reviews array contains non-object items", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: ["invalid_string_item"],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Candidate review item at index 0 must be an object");
+  });
+});
