+describe("Candidate Restaurant Review - concurrency", () => {
+  it("serializes a concurrent approve and reject so exactly one wins", async () => {
+    await seedCandidate(CAND_A, CAND_A_NAME);
+    await seedIncentive(0);
+
+    const [first, second] = await Promise.all([approve(CAND_A), reject(CAND_A)]);
+    const statuses = [first.status, second.status].sort();
+
+    expect(statuses).toEqual([200, 409]);
+
+    const candidate = await CandidateRestaurant.findByPk(CAND_A);
+    expect(candidate?.is_approved !== candidate?.is_rejected).toBe(true);
+
+    const restaurants = await restaurantsFor(CAND_A_NAME);
+    if (candidate?.is_approved) {
+      expect(restaurants).toHaveLength(1);
+    } else {
+      expect(restaurants).toHaveLength(0);
+    }
+  });
+
+  it("serializes two concurrent approvals so only one provisions a restaurant", async () => {
+    await seedCandidate(CAND_A, CAND_A_NAME);
+    await seedIncentive(0);
+
+    const [first, second] = await Promise.all([approve(CAND_A), approve(CAND_A)]);
+    const statuses = [first.status, second.status].sort();
+
+    expect(statuses).toEqual([200, 409]);
+    const loser = [first, second].find((r) => r.status === 409);
+    expect(loser?.body.message).toMatch(/already approved/i);
+
+    expect(await restaurantsFor(CAND_A_NAME)).toHaveLength(1);
+    expect(await incentiveTotal()).toBe(20);
+  });
+});
