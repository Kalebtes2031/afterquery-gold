@@ -0,0 +1,64 @@
+import express from "express";
+import request from "supertest";
+
+import candidateRestaurantRouter from "../../routes/candidate_restaurant.route";
+import { errorHandler } from "../../middlewares/error-handler";
+
+/**
+ * These checks exercise the wiring of the review endpoints through the real
+ * router with the repository's real admin guard in place, so they confirm the
+ * routes exist and stay behind admin authorization.
+ */
+const app = express();
+app.use(express.json());
+app.use("/api/v1/candidate-restaurants", candidateRestaurantRouter);
+app.use(errorHandler);
+
+const UNKNOWN_ID = "eeeeeeee-eeee-4eee-8eee-eeeeeeeeee01";
+
+describe("Candidate Restaurant Review - authorization", () => {
+  it("rejects an unauthenticated approve with 401", async () => {
+    const response = await request(app)
+      .put(`/api/v1/candidate-restaurants/${UNKNOWN_ID}/approve`)
+      .send({});
+
+    expect(response.status).toBe(401);
+    expect(response.body).toEqual({
+      error: "Not authorized to access this route",
+    });
+  });
+
+  it("rejects an unauthenticated reject with 401", async () => {
+    const response = await request(app)
+      .put(`/api/v1/candidate-restaurants/${UNKNOWN_ID}/reject`)
+      .send({});
+
+    expect(response.status).toBe(401);
+    expect(response.body).toEqual({
+      error: "Not authorized to access this route",
+    });
+  });
+
+  it("rejects an unauthenticated batch review with 401", async () => {
+    const response = await request(app)
+      .put("/api/v1/candidate-restaurants/review-batch")
+      .send({
+        items: [{ candidateRestaurantId: UNKNOWN_ID, action: "approve" }],
+      });
+
+    expect(response.status).toBe(401);
+    expect(response.body).toEqual({
+      error: "Not authorized to access this route",
+    });
+  });
+
+  it("keeps the batch review route registered as a PUT endpoint", async () => {
+    const response = await request(app)
+      .get("/api/v1/candidate-restaurants/review-batch")
+      .send();
+
+    // GET is not defined for this path; the router should not treat
+    // "review-batch" as a candidate id and 404 instead of 200.
+    expect(response.status).not.toBe(200);
+  });
+});
diff --git a/rateeat_backend/src/__tests__/unit/candidate_restaurant_review_behavior.test.ts b/rateeat_backend/src/__tests__/unit/candidate_restaurant_review_behavior.test.ts
