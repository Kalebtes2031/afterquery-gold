+
+jest.mock("../../utils/email_otp.utils");
+
+const app = express();
+app.use(express.json());
+app.use("/api/v1/candidate-restaurants", candidateRestaurantRouter);
+app.use(errorHandler);
+
+const approve = (id: string) =>
+  request(app).put(`/api/v1/candidate-restaurants/${id}/approve`).send({});
