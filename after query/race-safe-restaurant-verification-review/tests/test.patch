+};
+
+const incentiveTotal = async () => {
+  const incentive = await Incentive.findOne({
+    where: { user_id: SUBMITTER_ID },
+  });
+  return incentive ? Number(incentive.current_total) : null;
+};
+
+const historyCount = async () => {
+  const rows = await ItemReviewIncentive.findAll({
+    where: { user_id: SUBMITTER_ID },
+  });
+  return rows.length;
+};
+
+const restaurantsFor = (name: string) =>
+  Restaurant.findAll({ where: { name } });
+
+const notificationsFor = (candidateId: string) =>
+  Notification.findAll({ where: { notifiable_id: candidateId } });
+
+const expectReviewShape = (
+  response: request.Response,
+  action: "approve" | "reject"
+) => {
+  expect(response.status).toBe(200);
+  expect(response.body.success).toBe(true);
+  expect(response.body.data).toMatchObject({
+    action,
+    candidateRestaurantId: expect.any(String),
+    is_approved: action === "approve",
+    is_rejected: action === "reject",
+  });
+};
+
+beforeAll(async () => {
+  sequelize = await Database.getInstance();
+
+  await run(
+    `INSERT INTO roles (id, name, "createdAt", "updatedAt")
+     VALUES (?, 'rs-gold-role', NOW(), NOW())
+     ON CONFLICT (id) DO NOTHING`,
+    [ROLE_ID]
+  );
+  await run(
+    `INSERT INTO users (id, role_id, username, "createdAt", "updatedAt")
+     VALUES (?, ?, 'rs_gold_submitter', NOW(), NOW())
+     ON CONFLICT (id) DO NOTHING`,
+    [SUBMITTER_ID, ROLE_ID]
+  );
+  await run(
+    `INSERT INTO admin_users
+       (id, first_name, last_name, email, password, phone_number, role_id,
+        "createdAt", "updatedAt")
+     VALUES (?, 'Reviewer', 'Admin', 'rs-gold-reviewer@example.com', 'x',
+             '+251900000001', ?, NOW(), NOW())
+     ON CONFLICT (id) DO NOTHING`,
+    [ADMIN_ID, ROLE_ID]
+  );
+});
+
+afterAll(async () => {
+  await wipe();
+  await run(`DELETE FROM admin_users WHERE id = ?`, [ADMIN_ID]);
+  await run(`DELETE FROM users WHERE id = ?`, [SUBMITTER_ID]);
+  await run(`DELETE FROM roles WHERE id = ?`, [ROLE_ID]);
+  await Database.close();
+});
+
+beforeEach(async () => {
+  jest.clearAllMocks();
+  (emailUtils.sendAdminUserCredentialsEmail as jest.Mock).mockResolvedValue(
+    undefined
+  );
+  await wipe();
+});
+
+describe("Candidate Restaurant Review - single approve/reject behavior", () => {
+  describe("approving a pending candidate", () => {
+    it("provisions a restaurant and flips the candidate to approved", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME);
+      await seedIncentive(5);
+
+      const response = await approve(CAND_A);
+
+      expect(response.status).toBe(200);
+      expect(response.body.success).toBe(true);
+      expect(response.body.data).toMatchObject({
+        candidateRestaurantId: CAND_A,
+        action: "approve",
+        is_approved: true,
+        is_rejected: false,
+      });
+      expect(response.body.data.restaurant_id).toEqual(expect.any(String));
+
+      const candidate = await CandidateRestaurant.findByPk(CAND_A);
+      expect(candidate?.is_approved).toBe(true);
+      expect(candidate?.is_rejected).toBe(false);
+
+      const restaurants = await restaurantsFor(CAND_A_NAME);
+      expect(restaurants).toHaveLength(1);
+      expect(restaurants[0].id).toBe(response.body.data.restaurant_id);
+    });
+
+    it("creates the restaurant chain from the name before the separator", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME);
+      await seedIncentive(0);
+
+      const response = await approve(CAND_A);
+      expectReviewShape(response, "approve");
+
+      const chain = await RestaurantChain.findOne({
+        where: { name: "RS Gold Alpha" },
+      });
+      expect(chain).not.toBeNull();
+
+      const restaurant = (await restaurantsFor(CAND_A_NAME))[0];
+      expect(restaurant.restaurant_chain_id).toBe(chain?.id);
+    });
+
+    it("reuses an existing chain instead of creating a duplicate", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME);
+      await seedIncentive(0);
+      await run(
+        `INSERT INTO restaurant_chains (id, name, "createdAt", "updatedAt")
+         VALUES (gen_random_uuid(), 'RS Gold Alpha', NOW(), NOW())`
+      );
+
+      const response = await approve(CAND_A);
+      expectReviewShape(response, "approve");
+
+      const chains = await RestaurantChain.findAll({
+        where: { name: "RS Gold Alpha" },
+      });
+      expect(chains).toHaveLength(1);
+    });
+
+    it("adds 20 points to the submitter incentive and records the history entry", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME);
+      await seedIncentive(30);
+
+      const response = await approve(CAND_A);
+      expectReviewShape(response, "approve");
+
+      expect(await incentiveTotal()).toBe(50);
+      expect(await historyCount()).toBe(1);
+      const [history] = await ItemReviewIncentive.findAll({
+        where: { user_id: SUBMITTER_ID },
+      });
+      expect(Number(history.points_earned)).toBe(20);
+    });
+
+    it("creates the incentive row when the submitter has none yet", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME);
+
+      const response = await approve(CAND_A);
+      expectReviewShape(response, "approve");
+
+      expect(await incentiveTotal()).toBe(20);
+    });
+
+    it("approves an ownerless candidate without touching incentives", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME, { user_id: null });
+
+      const response = await approve(CAND_A);
+
+      expectReviewShape(response, "approve");
+      const candidate = await CandidateRestaurant.findByPk(CAND_A);
+      expect(candidate?.is_approved).toBe(true);
+      expect(await incentiveTotal()).toBeNull();
+      expect(await historyCount()).toBe(0);
+    });
+  });
+
+  describe("approving with a linked candidate admin user", () => {
+    it("provisions the admin user, links the chain, and marks the candidate admin approved", async () => {
+      await seedCandidateAdmin(CADMIN_A);
+      await seedCandidate(CAND_A, CAND_A_NAME, {
+        candidate_admin_user_id: CADMIN_A,
+      });
+      await seedIncentive(0);
+
+      const response = await approve(CAND_A);
+      expectReviewShape(response, "approve");
+
+      const created = await CandidateAdminUser.findByPk(CADMIN_A);
+      expect(created?.is_approved).toBe(true);
+
+      const admin = await AdminUser.findOne({
+        where: { email: `rs-gold-cadmin-${CADMIN_A.slice(0, 8)}@example.com` },
+      });
+      expect(admin).not.toBeNull();
+
+      const chain = await RestaurantChain.findOne({
+        where: { name: "RS Gold Alpha" },
+      });
+      expect(chain?.admin_user_id).toBe(admin?.id);
+
+      expect(
+        emailUtils.sendAdminUserCredentialsEmail
+      ).toHaveBeenCalledTimes(1);
+    });
+
+    it("rolls the whole approval back when the candidate admin was already approved", async () => {
+      await seedCandidateAdmin(CADMIN_A, { is_approved: true });
+      await seedCandidate(CAND_A, CAND_A_NAME, {
+        candidate_admin_user_id: CADMIN_A,
+      });
+      await seedIncentive(12);
+
+      const response = await approve(CAND_A);
+
+      expect(response.status).toBe(409);
+      expect(response.body.message).toMatch(/already approved/i);
+
+      const candidate = await CandidateRestaurant.findByPk(CAND_A);
+      expect(candidate?.is_approved).toBe(false);
+      expect(await restaurantsFor(CAND_A_NAME)).toHaveLength(0);
+      expect(await incentiveTotal()).toBe(12);
+    });
+
+  });
+
+  describe("approval guards", () => {
+    it("returns 404 for an unknown candidate id", async () => {
+      const response = await approve(CAND_C);
+
+      expect(response.status).toBe(404);
+      expect(response.body.success).toBe(false);
+      expect(response.body.message).toMatch(/not found/i);
+      expect(response.body.statusCode).toBe(404);
+    });
+
+    it("returns 409 when the candidate is already approved", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME, { is_approved: true });
+
+      const response = await approve(CAND_A);
+
+      expect(response.status).toBe(409);
+      expect(response.body.message).toMatch(/already approved/i);
+      expect(await restaurantsFor(CAND_A_NAME)).toHaveLength(0);
+    });
+
+    it("returns 409 when the candidate is already rejected", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME, { is_rejected: true });
+
+      const response = await approve(CAND_A);
+
+      expect(response.status).toBe(409);
+      expect(response.body.message).toMatch(/already rejected/i);
+    });
+  });
+
+  describe("approval atomicity", () => {
+    it("rolls everything back when the credential email fails", async () => {
+      (emailUtils.sendAdminUserCredentialsEmail as jest.Mock).mockRejectedValue(
+        new Error("smtp down")
+      );
+      await seedCandidateAdmin(CADMIN_A);
+      await seedCandidate(CAND_A, CAND_A_NAME, {
+        candidate_admin_user_id: CADMIN_A,
+      });
+      await seedIncentive(7);
+
+      const response = await approve(CAND_A);
+
+      expect(response.status).toBe(500);
+      expect(response.body.success).toBe(false);
+
+      const candidate = await CandidateRestaurant.findByPk(CAND_A);
+      expect(candidate?.is_approved).toBe(false);
+      expect(await restaurantsFor(CAND_A_NAME)).toHaveLength(0);
+      expect(await incentiveTotal()).toBe(7);
+      expect(await historyCount()).toBe(0);
+
+      const candidateAdmin = await CandidateAdminUser.findByPk(CADMIN_A);
+      expect(candidateAdmin?.is_approved).toBe(false);
+      const admin = await AdminUser.findOne({
+        where: { email: `rs-gold-cadmin-${CADMIN_A.slice(0, 8)}@example.com` },
+      });
+      expect(admin).toBeNull();
+    });
+  });
+
+  describe("rejecting a pending candidate", () => {
+    it("flips the candidate to rejected and creates no restaurant", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME);
+
+      const response = await reject(CAND_A);
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toMatchObject({
+        candidateRestaurantId: CAND_A,
+        action: "reject",
+        is_approved: false,
+        is_rejected: true,
+        restaurant_id: null,
+      });
+
+      const candidate = await CandidateRestaurant.findByPk(CAND_A);
+      expect(candidate?.is_rejected).toBe(true);
+      expect(await restaurantsFor(CAND_A_NAME)).toHaveLength(0);
+    });
+
+    it("marks the linked candidate admin as rejected", async () => {
+      await seedCandidateAdmin(CADMIN_A);
+      await seedCandidate(CAND_A, CAND_A_NAME, {
+        candidate_admin_user_id: CADMIN_A,
+      });
+
+      const response = await reject(CAND_A);
+
+      expect(response.status).toBe(200);
+      expect(response.body.data).toMatchObject({
+        candidateRestaurantId: CAND_A,
+        action: "reject",
+        is_rejected: true,
+        restaurant_id: null,
+      });
+
+      const candidateAdmin = await CandidateAdminUser.findByPk(CADMIN_A);
+      expect(candidateAdmin?.is_rejected).toBe(true);
+      expect(candidateAdmin?.is_approved).toBe(false);
+    });
+
+    it("returns 404 for an unknown candidate id", async () => {
+      const response = await reject(CAND_C);
+      expect(response.status).toBe(404);
+      expect(response.body.message).toMatch(/not found/i);
+    });
+
+    it("returns 409 when the candidate is already rejected", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME, { is_rejected: true });
+      const response = await reject(CAND_A);
+      expect(response.status).toBe(409);
+      expect(response.body.message).toMatch(/already rejected/i);
+    });
+
+    it("returns 409 when the candidate is already approved", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME, { is_approved: true });
+      const response = await reject(CAND_A);
+      expect(response.status).toBe(409);
+      expect(response.body.message).toMatch(/already approved/i);
+    });
+  });
+});
+
+describe("Candidate Restaurant Review - batch moderation", () => {
+  describe("payload validation", () => {
+    // The message assertions below pin the failure to the batch payload
+    // validator: a route that never parses `items` (e.g. one that only
+    // validates the path segment) cannot produce them.
+    const BATCH_PAYLOAD_ERROR = /items|each item|candidateRestaurantId|action|approve or reject/i;
+
+    it("returns 400 when items is missing", async () => {
+      await seedCandidate(CAND_A, CAND_A_NAME);
+      const response = await reviewBatch({});
+      expect(response.status).toBe(400);
+      expect(response.body.success).toBe(false);
+      expect(response.body.message).toMatch(BATCH_PAYLOAD_ERROR);
+      const candidate = await CandidateRestaurant.findByPk(CAND_A);
+      expect(candidate?.is_approved).toBe(false);
+    });
+
+    it("returns 400 when items is empty", async () => {
+      const response = await reviewBatch({ items: [] });
+      expect(response.status).toBe(400);
+      expect(response.body.success).toBe(false);
+      expect(response.body.message).toMatch(BATCH_PAYLOAD_ERROR);
+    });
+
+    it("returns 400 when an item is not an object", async () => {
+      const response = await reviewBatch({ items: ["nope"] });
+      expect(response.status).toBe(400);
+      expect(response.body.success).toBe(false);
+      expect(response.body.message).toMatch(BATCH_PAYLOAD_ERROR);
+    });
+
+    it("returns 400 when an item has no candidateRestaurantId", async () => {
