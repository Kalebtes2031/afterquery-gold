+import express from "express";
+import request from "supertest";
+import candidateRestaurantRouter from "../../routes/candidate_restaurant.route";
+
+describe("Candidate Restaurant Verification - Route Authorization", () => {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/candidate-restaurants", candidateRestaurantRouter);
+
+  it("returns 401 when batch-review is requested without authorization token", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/batch-review")
+      .send({
+        reviews: [{ candidateRestaurantId: "cand-101", action: "approve" }],
+      });
+    expect(res.status).toBe(401);
+  });
+
+  it("returns 401 when single candidate review is requested without authorization token", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-restaurants/cand-101/review")
+      .send({ action: "approve" });
+    expect(res.status).toBe(401);
+  });
+
+  it("returns 401 when metrics endpoint is requested without authorization token", async () => {
+    const res = await request(app)
+      .get("/api/v1/candidate-restaurants/metrics")
+      .send();
+    expect(res.status).toBe(401);
+  });
+});
