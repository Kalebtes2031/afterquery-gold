+      (RestaurantChain.findOne as jest.Mock).mockResolvedValue({ id: "chain-1" });
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-valid" });
+      (CandidateRestaurantLocation.findOne as jest.Mock).mockResolvedValue(null);
