+
+const reviewBatch = (body: any) =>
+  request(app).put("/api/v1/candidate-restaurants/review-batch").send(body);
+
+let sequelize: Awaited<ReturnType<typeof Database.getInstance>>;
+
+const run = (sql: string, replacements: any[] = []) =>
+  sequelize.query(sql, { replacements });
+
+const wipe = async () => {
+  await run(
+    `DELETE FROM notifications WHERE notifiable_id IN (?, ?, ?)`,
+    [CAND_A, CAND_B, CAND_C]
+  );
+  await run(
+    `DELETE FROM item_review_incentives WHERE user_id = ?`,
+    [SUBMITTER_ID]
+  );
+  await run(`DELETE FROM incentives WHERE user_id = ?`, [SUBMITTER_ID]);
+  await run(`DELETE FROM restaurants WHERE name LIKE 'RS Gold%'`);
+  await run(`DELETE FROM restaurant_chains WHERE name LIKE 'RS Gold%'`);
+  await run(`DELETE FROM admin_users WHERE email LIKE '%rs-gold-cadmin%'`);
+  await run(`DELETE FROM notifications WHERE reactor_id = ?`, [ADMIN2_ID]);
+  await run(`DELETE FROM admin_users WHERE id = ?`, [ADMIN2_ID]);
+  await run(`DELETE FROM candidate_restaurants WHERE id IN (?, ?, ?)`, [
+    CAND_A,
+    CAND_B,
+    CAND_C,
+  ]);
+  await run(`DELETE FROM candidate_admin_users WHERE id = ?`, [CADMIN_A]);
+};
+
+const seedCandidate = async (
+  id: string,
+  name: string,
+  overrides: {
+    is_approved?: boolean;
+    is_rejected?: boolean;
+    user_id?: string | null;
+    candidate_admin_user_id?: string | null;
+    description?: string;
+  } = {}
