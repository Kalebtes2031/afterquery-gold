+import {
+  formatCandidateReviewSummary,
+  parseCandidateFilters,
+  isValidCandidateIdentifier,
+  formatCandidateAuditLog,
+  isCandidateReviewable,
+  isCandidateEligibleForPromotion,
+  validateCandidateReviewAction,
+  serializeCandidateReport,
+  validateCandidateBatchBounds,
+  buildRestaurantFromCandidate,
+} from "../../utils/candidate-restaurant-workflow.utils";
+
+describe("Candidate Restaurant Verification - Utility & Filter Logic", () => {
+  it("formats candidate review summary correctly for approved and rejected sets", () => {
+    const summary = formatCandidateReviewSummary([
+      { id: "c-1", is_approved: true, reviewed_at: new Date() },
+      { id: "c-2", is_approved: false, reviewed_at: new Date() },
+    ]);
+
+    expect(summary.total).toBe(2);
+    expect(summary.approved).toBe(1);
+    expect(summary.rejected).toBe(1);
+  });
+
+  it("parses candidate filter parameters accurately", () => {
+    const filters = parseCandidateFilters({
+      status: "Approved",
+      name: "Bistro",
+      limit: "20",
+      offset: "5",
+    });
+
+    expect(filters.status).toBe("Approved");
+    expect(filters.name).toBe("Bistro");
+    expect(filters.limit).toBe(20);
+    expect(filters.offset).toBe(5);
+  });
+
+  it("validates candidate identifier formats accurately", () => {
+    expect(isValidCandidateIdentifier("cand-12345")).toBe(true);
+    expect(isValidCandidateIdentifier("c-abcd-1234")).toBe(true);
+    expect(isValidCandidateIdentifier("123e4567-e89b-12d3-a456-426614174000")).toBe(true);
+    expect(isValidCandidateIdentifier("")).toBe(false);
+  });
+
+  it("formats candidate audit logs and validates reviewability", () => {
+    const log = formatCandidateAuditLog({ id: "c-1", name: "R1" }, "approve", "u-1");
+    expect(log.candidateId).toBe("c-1");
+    expect(log.decision).toBe("Approved");
+    expect(isCandidateReviewable(null)).toBe(true);
+    expect(isCandidateReviewable(true)).toBe(false);
+  });
+
+  it("validates candidate promotion eligibility and review action syntax", () => {
+    expect(isCandidateEligibleForPromotion({ name: "Good", address: "123 St" })).toBe(true);
+    expect(isCandidateEligibleForPromotion({ name: "No Info" })).toBe(false);
+    expect(validateCandidateReviewAction("approve")).toBe(true);
+    expect(validateCandidateReviewAction("REJECT")).toBe(true);
+    expect(validateCandidateReviewAction("invalid")).toBe(false);
+  });
+
+  it("serializes candidate reports, validates batch bounds, and builds restaurant models", () => {
+    const report = serializeCandidateReport([
+      { id: "c-1", name: "R1", is_approved: true, address: "123 St" },
+    ]);
+    expect(report[0].id).toBe("c-1");
+    expect(report[0].isApproved).toBe("Approved");
+
+    const check = validateCandidateBatchBounds([{ candidateRestaurantId: "c-1", action: "approve" }]);
+    expect(check.valid).toBe(true);
+
+    const model = buildRestaurantFromCandidate({ name: "R1", address: "123 St", phone_number: "555" });
+    expect(model.name).toBe("R1");
+    expect(model.is_active).toBe(true);
+  });
+});
