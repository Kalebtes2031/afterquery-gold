+import { NextFunction, Request, Response } from "express";
+import { reviewCandidateRestaurantBatch } from "../../controllers/candidate_restaurant.controller";
+import { CandidateRestaurantVerificationService } from "../../services/candidate-restaurant-verification.service";
+import {
+  CandidateRestaurant,
+  Restaurant,
+  RestaurantChain,
+  RestaurantLocation,
+  CandidateRestaurantLocation,
+  Incentive,
+  ItemReviewIncentive,
+  AdminUser,
+} from "../../models";
+import sequelize from "../../config/db";
+import {
+  BadRequestError,
+  ConflictError,
+  NotFoundError,
+} from "../../utils/error-response.utils";
+
+jest.mock("../../models", () => ({
+  CandidateRestaurant: {
+    findOne: jest.fn(),
+    update: jest.fn(),
+  },
+  Restaurant: {
+    create: jest.fn(),
+  },
+  RestaurantChain: {
+    findOne: jest.fn(),
+    create: jest.fn(),
+  },
+  RestaurantLocation: {
+    create: jest.fn(),
+  },
+  CandidateRestaurantLocation: {
+    findOne: jest.fn(),
+  },
+  Incentive: {
+    findOne: jest.fn(),
+    create: jest.fn(),
+  },
+  ItemReviewIncentive: {
+    create: jest.fn(),
+  },
+  AdminUser: {
+    findByPk: jest.fn(),
+    create: jest.fn(),
+  },
+  CandidateAdminUser: {
+    findOne: jest.fn(),
+    update: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  transaction: jest.fn(),
+}));
+
+describe("Candidate Restaurant Verification - Batch Moderation & Concurrency", () => {
+  let mockTransaction: any;
+  let req: Partial<Request>;
+  let res: Partial<Response>;
+  let next: NextFunction;
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    mockTransaction = {
+      LOCK: { UPDATE: "UPDATE" },
+      commit: jest.fn().mockResolvedValue(undefined),
+      rollback: jest.fn().mockResolvedValue(undefined),
+    };
+    (sequelize.transaction as jest.Mock).mockResolvedValue(mockTransaction);
+
+    req = {
+      body: {},
+      user: { id: "admin-master" },
+    };
+    res = {
+      status: jest.fn().mockReturnThis(),
+      json: jest.fn(),
+    };
+    next = jest.fn();
+
+    (AdminUser.findByPk as jest.Mock).mockResolvedValue({ id: "admin-master" });
+  });
+
+  describe("Batch Review Payload Validation", () => {
+    it("returns 400 when body has no items field", async () => {
+      req.body = {};
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Field 'items' must be a non-empty array",
+          statusCode: 400,
+        })
+      );
+    });
+
+    it("returns 400 when items array is empty", async () => {
+      req.body = { items: [] };
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Field 'items' cannot be empty",
+          statusCode: 400,
+        })
+      );
+    });
+
+    it("returns 400 with 'Duplicate candidate restaurant id' when duplicate ids exist in batch", async () => {
+      req.body = {
+        items: [
+          { candidateRestaurantId: "cand-duplicate", action: "approve" },
+          { candidateRestaurantId: "cand-duplicate", action: "reject" },
+        ],
+      };
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Duplicate candidate restaurant id",
+          statusCode: 400,
+        })
+      );
+    });
+
+    it("returns 400 when action is invalid", async () => {
+      req.body = {
+        items: [{ candidateRestaurantId: "cand-1", action: "destroy" }],
+      };
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Invalid review action: must be 'approve' or 'reject'",
+          statusCode: 400,
+        })
+      );
+    });
+  });
+
+  describe("Batch Execution & Ordering", () => {
+    it("successfully approves and rejects mixed candidates in single transaction", async () => {
+      req.body = {
+        items: [
+          { candidateRestaurantId: "cand-1", action: "approve" },
+          { candidateRestaurantId: "cand-2", action: "reject" },
+        ],
+      };
+
+      const mockCand1 = { id: "cand-1", name: "R1", is_approved: false, is_rejected: false };
+      const mockCand2 = { id: "cand-2", name: "R2", is_approved: false, is_rejected: false };
+
+      (CandidateRestaurant.findOne as jest.Mock)
+        .mockImplementation(({ where }) => {
+          if (where.id === "cand-1") return Promise.resolve(mockCand1);
+          if (where.id === "cand-2") return Promise.resolve(mockCand2);
+          return Promise.resolve(null);
+        });
+
+      (RestaurantChain.findOne as jest.Mock).mockResolvedValue({ id: "chain-1" });
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-1", name: "R1" });
+      (CandidateRestaurantLocation.findOne as jest.Mock).mockResolvedValue(null);
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(mockTransaction.commit).toHaveBeenCalledTimes(1);
+      expect(res.status).toHaveBeenCalledWith(200);
+      expect(res.json).toHaveBeenCalledWith({
+        success: true,
+        data: [
+          expect.objectContaining({ id: "rest-1" }),
+          expect.objectContaining({ id: "cand-2" }),
+        ],
+      });
+    });
+
+    it("returns results in the exact requested order of candidateRestaurantIds", async () => {
+      req.body = {
+        items: [
+          { candidateRestaurantId: "cand-z", action: "reject" },
+          { candidateRestaurantId: "cand-a", action: "approve" },
+        ],
+      };
+
+      const candZ = { id: "cand-z", name: "Zebra Grill", is_approved: false, is_rejected: false };
+      const candA = { id: "cand-a", name: "Apple Cafe", is_approved: false, is_rejected: false };
+
+      (CandidateRestaurant.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "cand-z") return Promise.resolve(candZ);
+        if (where.id === "cand-a") return Promise.resolve(candA);
+        return Promise.resolve(null);
+      });
+
+      (RestaurantChain.findOne as jest.Mock).mockResolvedValue({ id: "chain-a" });
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-apple", name: "Apple Cafe" });
+      (CandidateRestaurantLocation.findOne as jest.Mock).mockResolvedValue(null);
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(res.json).toHaveBeenCalledWith({
+        success: true,
+        data: [
+          expect.objectContaining({ id: "cand-z" }),
+          expect.objectContaining({ id: "rest-apple" }),
+        ],
+      });
+    });
+
+    it("accumulates user incentives correctly across multiple approved candidates from same user", async () => {
+      req.body = {
+        items: [
+          { candidateRestaurantId: "cand-u1", action: "approve" },
+          { candidateRestaurantId: "cand-u2", action: "approve" },
+        ],
+      };
+
+      const cand1 = { id: "cand-u1", name: "Place 1", user_id: "user-super", is_approved: false, is_rejected: false };
+      const cand2 = { id: "cand-u2", name: "Place 2", user_id: "user-super", is_approved: false, is_rejected: false };
+
+      const userIncentive = { user_id: "user-super", current_total: 10, save: jest.fn().mockResolvedValue(undefined) };
+
+      (CandidateRestaurant.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "cand-u1") return Promise.resolve(cand1);
+        if (where.id === "cand-u2") return Promise.resolve(cand2);
+        return Promise.resolve(null);
+      });
+
+      (RestaurantChain.findOne as jest.Mock).mockResolvedValue({ id: "chain-1" });
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-ok" });
+      (CandidateRestaurantLocation.findOne as jest.Mock).mockResolvedValue(null);
+      (Incentive.findOne as jest.Mock).mockResolvedValue(userIncentive);
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(userIncentive.current_total).toBe(50); // 10 + 20 + 20
+      expect(ItemReviewIncentive.create).toHaveBeenCalledTimes(2);
+      expect(mockTransaction.commit).toHaveBeenCalled();
+    });
+  });
+
+  describe("Batch Rollback on Partial Failures", () => {
+    it("rolls back entire batch when one candidate restaurant does not exist", async () => {
+      req.body = {
+        items: [
+          { candidateRestaurantId: "cand-valid", action: "approve" },
+          { candidateRestaurantId: "cand-non-existent", action: "reject" },
+        ],
+      };
+
+      const candValid = { id: "cand-valid", name: "Valid Diner", is_approved: false, is_rejected: false };
+
+      (CandidateRestaurant.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "cand-valid") return Promise.resolve(candValid);
+        return Promise.resolve(null);
+      });
