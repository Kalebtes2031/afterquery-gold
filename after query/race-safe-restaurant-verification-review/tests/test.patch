+       (id, name, description, opening_hour, closing_hour, is_open,
+        is_approved, is_rejected, user_id, candidate_admin_user_id,
+        "createdAt", "updatedAt")
+     VALUES (?, ?, ?, '09:00:00', '21:00:00', true, ?, ?, ?, ?, NOW(), NOW())`,
+    [
+      id,
+      name,
+      description,
+      is_approved,
+      is_rejected,
+      user_id,
+      candidate_admin_user_id,
+    ]
+  );
+};
+
+const seedCandidateAdmin = async (
+  id: string,
+  overrides: { is_approved?: boolean } = {}
+) => {
+  await run(
+    `INSERT INTO candidate_admin_users
+       (id, first_name, last_name, email, phone_number, role_id,
+        is_approved, is_rejected, "createdAt", "updatedAt")
+     VALUES (?, 'Chain', 'Manager', ?, ?, ?, ?, false, NOW(), NOW())`,
+    [
+      id,
+      `rs-gold-cadmin-${id.slice(0, 8)}@example.com`,
+      `+2519${id.replace(/\D/g, "").slice(0, 8)}`,
+      ROLE_ID,
+      overrides.is_approved ?? false,
+    ]
+  );
+};
+
+const seedIncentive = async (total: number) => {
