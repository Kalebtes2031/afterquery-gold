+
+jest.mock("../../middlewares/auth", () => ({
+  protectRoute: (req: any, _res: any, next: any) => {
+    req.user = { id: "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaa01" };
+    next();
+  },
+  protectRouteForAdmin: (req: any, _res: any, next: any) => {
+    req.user = { id: "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaa01" };
+    next();
+  },
