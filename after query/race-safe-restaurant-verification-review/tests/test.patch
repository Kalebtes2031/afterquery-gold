+import express from "express";
+import request from "supertest";
+import candidateRouter from "../../routes/candidate_restaurant.route";
+import {
+  AdminUser,
+  CandidateRestaurant,
+  Notification,
+  Restaurant,
+  RestaurantMedia,
+} from "../../models";
+
+jest.mock("../../middlewares/auth", () => ({
+  authenticateToken: (req: any, _res: any, next: any) => {
+    req.user = { id: "admin-uuid-1", is_super_admin: true };
+    next();
+  },
+  authorizeRole: (_roles: any) => (_req: any, _res: any, next: any) => next(),
+}));
+
+jest.mock("../../models", () => ({
+  CandidateRestaurant: {
+    findByPk: jest.fn(),
+    count: jest.fn(),
+    findAndCountAll: jest.fn(),
+  },
+  CandidateRestaurantImage: {},
+  CandidateRestaurantVideo: {},
+  Restaurant: {
+    create: jest.fn(),
+  },
+  RestaurantMedia: {
+    create: jest.fn(),
+  },
+  AdminUser: {
+    findAll: jest.fn().mockResolvedValue([]),
+    findByPk: jest.fn().mockResolvedValue({ id: "admin-uuid-1" }),
+  },
+  Notification: {
+    create: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Candidate Restaurant Verification - Public HTTP Endpoint Behavior", () => {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/candidate-restaurants", candidateRouter);
+  app.use((err: any, _req: any, res: any, _next: any) => {
+    res.status(err.statusCode || 500).json({
+      success: false,
+      message: err.message || "Internal Server Error",
+    });
+  });
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe("PUT /api/v1/candidate-restaurants/:candidateRestaurantId/review", () => {
+    it("approves pending candidate restaurant and creates active restaurant with media", async () => {
+      const mockCandidate = {
+        id: "cand-101",
+        name: "Test Restaurant",
+        address: "123 Main St",
+        phone_number: "555-0100",
+        is_approved: null,
+        candidate_restaurant_images: [{ url: "https://img.com/1.jpg" }],
+        save: jest.fn().mockResolvedValue(true),
+      };
+      const mockCreatedRest = { id: "rest-101", name: "Test Restaurant" };
+
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockResolvedValue(mockCreatedRest);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/cand-101/review")
+        .send({ action: "approve" });
+
+      expect(res.status).toBe(200);
+      expect(res.body.success).toBe(true);
+      expect(res.body.data.is_approved).toBe(true);
+      expect(Restaurant.create).toHaveBeenCalled();
+      expect(RestaurantMedia.create).toHaveBeenCalled();
+    });
+
+    it("creates notification records for super admins on candidate approval", async () => {
+      const mockCandidate = {
+        id: "cand-102",
+        name: "Test Restaurant 2",
+        is_approved: null,
+        save: jest.fn().mockResolvedValue(true),
+      };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-102" });
+      (AdminUser.findAll as jest.Mock).mockResolvedValue([{ id: "super-1", is_super_admin: true }]);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/cand-102/review")
+        .send({ action: "approve" });
+
+      expect(res.status).toBe(200);
+      expect(Notification.create).toHaveBeenCalledTimes(1);
+    });
+
+    it("rejects candidate restaurant with rejection reason and returns 200", async () => {
+      const mockCandidate = {
+        id: "cand-201",
+        name: "Rejected Restaurant",
+        is_approved: null,
+        save: jest.fn().mockResolvedValue(true),
+      };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/cand-201/review")
+        .send({ action: "reject", rejectionReason: "Incomplete address" });
+
+      expect(res.status).toBe(200);
+      expect(res.body.success).toBe(true);
+      expect(res.body.data.is_approved).toBe(false);
+      expect(res.body.data.rejection_reason).toBe("Incomplete address");
+    });
+
+    it("returns 409 when reviewing an already approved candidate restaurant", async () => {
+      const mockCandidate = { id: "cand-301", is_approved: true };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/cand-301/review")
+        .send({ action: "approve" });
+
+      expect(res.status).toBe(409);
+    });
+
+    it("returns 409 when reviewing an already rejected candidate restaurant", async () => {
+      const mockCandidate = { id: "cand-302", is_approved: false };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/cand-302/review")
+        .send({ action: "reject" });
+
+      expect(res.status).toBe(409);
+    });
+
+    it("returns 404 when candidate restaurant is not found", async () => {
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(null);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/cand-missing/review")
+        .send({ action: "approve" });
+
+      expect(res.status).toBe(404);
+    });
+  });
+
+  
+    it("handles multiple sequential candidate restaurant reviews accurately", async () => {
+      const mock1 = { id: "c-seq-1", name: "Seq 1", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+      const mock2 = { id: "c-seq-2", name: "Seq 2", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+      (CandidateRestaurant.findByPk as jest.Mock)
+        .mockResolvedValueOnce(mock1)
+        .mockResolvedValueOnce(mock2);
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-seq" });
+
+      const res1 = await request(app).put("/api/v1/candidate-restaurants/c-seq-1/review").send({ action: "approve" });
+      const res2 = await request(app).put("/api/v1/candidate-restaurants/c-seq-2/review").send({ action: "reject" });
+
+      expect(res1.status).toBe(200);
+      expect(res1.body.data.is_approved).toBe(true);
+      expect(res2.status).toBe(200);
+      expect(res2.body.data.is_approved).toBe(false);
+    });
+
+    it("creates restaurant media for multiple candidate images upon approval", async () => {
+      const mock = {
+        id: "c-multi",
+        name: "Multi Media",
+        is_approved: null,
+        candidate_restaurant_images: [{ url: "https://img.com/a.jpg" }, { url: "https://img.com/b.jpg" }],
+        save: jest.fn().mockResolvedValue(true),
+      };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mock);
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-multi" });
+
+      const res = await request(app).put("/api/v1/candidate-restaurants/c-multi/review").send({ action: "approve" });
+      expect(res.status).toBe(200);
+      expect(RestaurantMedia.create).toHaveBeenCalledTimes(2);
+    });
+
+    it("rolls back review when created restaurant database write fails", async () => {
+      const mockCandidate = { id: "c-fail", name: "Fail Rest", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mockCandidate);
+      (Restaurant.create as jest.Mock).mockRejectedValue(new Error("Database write error"));
+
+      const res = await request(app).put("/api/v1/candidate-restaurants/c-fail/review").send({ action: "approve" });
+      expect(res.status).toBe(500);
+    });
+
+  
+    it("handles batch review whitespace trimming in candidate ids", async () => {
+      const mock = { id: "cand-trim", name: "Trim Rest", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mock);
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-trim" });
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/batch-review")
+        .send({ reviews: [{ candidateRestaurantId: "   cand-trim   ", action: "approve" }] });
+
+      expect(res.status).toBe(200);
+      expect(res.body.data[0].id).toBe("cand-trim");
+    });
+
+    it("verifies single candidate review with custom rejection reasons cleanly", async () => {
+      const mock = { id: "cand-custom", name: "Custom Rej", is_approved: null, save: jest.fn().mockResolvedValue(true) };
+      (CandidateRestaurant.findByPk as jest.Mock).mockResolvedValue(mock);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-restaurants/cand-custom/review")
+        .send({ action: "reject", rejectionReason: "Invalid hygiene permit document" });
+
+      expect(res.status).toBe(200);
+      expect(res.body.data.rejection_reason).toBe("Invalid hygiene permit document");
+    });
+
+  describe("GET /api/v1/candidate-restaurants/metrics", () => {
+    it("returns aggregated candidate metrics with 200 status", async () => {
+      (CandidateRestaurant.count as jest.Mock)
+        .mockResolvedValueOnce(3)
+        .mockResolvedValueOnce(15)
+        .mockResolvedValueOnce(2);
+
+      const res = await request(app)
+        .get("/api/v1/candidate-restaurants/metrics")
+        .send();
+
+      expect(res.status).toBe(200);
+      expect(res.body.success).toBe(true);
+      expect(res.body.data.pending).toBe(3);
+    });
+  });
+});
