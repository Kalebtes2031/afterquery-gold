+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(mockTransaction.rollback).toHaveBeenCalledTimes(1);
+      expect(mockTransaction.commit).not.toHaveBeenCalled();
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Candidate Restaurant not found",
+          statusCode: 404,
+        })
+      );
+    });
+
+    it("rolls back entire batch when one candidate is already approved", async () => {
+      req.body = {
+        items: [
+          { candidateRestaurantId: "cand-1", action: "reject" },
+          { candidateRestaurantId: "cand-already-approved", action: "approve" },
+        ],
+      };
+
+      const cand1 = { id: "cand-1", name: "Diner", is_approved: false, is_rejected: false };
+      const candAlready = { id: "cand-already-approved", name: "Diner 2", is_approved: true, is_rejected: false };
+
+      (CandidateRestaurant.findOne as jest.Mock).mockImplementation(({ where }) => {
+        if (where.id === "cand-1") return Promise.resolve(cand1);
+        if (where.id === "cand-already-approved") return Promise.resolve(candAlready);
+        return Promise.resolve(null);
+      });
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Candidate Restaurant already approved",
+          statusCode: 409,
+        })
+      );
+    });
+
+    it("rolls back entire batch when one candidate is already rejected", async () => {
+      req.body = {
+        items: [
+          { candidateRestaurantId: "cand-already-rejected", action: "reject" },
+          { candidateRestaurantId: "cand-2", action: "approve" },
+        ],
+      };
+
+      const candAlready = { id: "cand-already-rejected", name: "Diner Old", is_approved: false, is_rejected: true };
+
+      (CandidateRestaurant.findOne as jest.Mock).mockResolvedValue(candAlready);
+
+      await reviewCandidateRestaurantBatch(req as Request, res as Response, next);
+
+      expect(mockTransaction.rollback).toHaveBeenCalled();
+      expect(next).toHaveBeenCalledWith(
+        expect.objectContaining({
+          message: "Candidate Restaurant already rejected",
+          statusCode: 409,
+        })
+      );
+    });
+  });
+
+  describe("Concurrency & Race Condition Serialization", () => {
+    it("serializes concurrent reviews on the same candidate using row lock", async () => {
+      let state = {
+        id: "cand-race",
+        name: "Racing Diner",
+        is_approved: false,
+        is_rejected: false,
+      };
+
+      (CandidateRestaurant.findOne as jest.Mock).mockImplementation(() => {
+        return Promise.resolve({ ...state });
+      });
+      (RestaurantChain.findOne as jest.Mock).mockResolvedValue({ id: "chain-1" });
+      (Restaurant.create as jest.Mock).mockResolvedValue({ id: "rest-race" });
+      (CandidateRestaurantLocation.findOne as jest.Mock).mockResolvedValue(null);
+      (CandidateRestaurant.update as jest.Mock).mockImplementation((updates) => {
+        state = { ...state, ...updates };
+        return Promise.resolve([1]);
+      });
+
+      const firstCall = CandidateRestaurantVerificationService.approveCandidateRestaurantWithLock(
+        "cand-race",
+        "admin-1"
+      );
+
+      const res1 = await firstCall;
+      expect(res1).toBeDefined();
+      expect(state.is_approved).toBe(true);
+
+      await expect(
+        CandidateRestaurantVerificationService.rejectCandidateRestaurantWithLock(
+          "cand-race",
+          "admin-2"
+        )
+      ).rejects.toThrow(ConflictError);
+    });
+  });
+});
