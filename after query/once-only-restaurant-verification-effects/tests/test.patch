+export function createMockItemReview(overrides: any = {}) {
+  return {
+    id: overrides.id || "rev-uuid-1",
+    item_id: overrides.item_id || "item-uuid-1",
+    user_id: overrides.user_id || "user-uuid-1",
+    is_approved: overrides.is_approved !== undefined ? overrides.is_approved : null,
+    item_review_images: overrides.item_review_images || [],
+    item_review_videos: overrides.item_review_videos || [],
+    save: jest.fn().mockResolvedValue(true),
+    update: jest.fn().mockResolvedValue(true),
+    ...overrides,
+  };
+}
+
+export function createMockItem(overrides: any = {}) {
+  return {
+    id: overrides.id || "item-uuid-1",
+    name: overrides.name || "Test Item",
+    is_approved: overrides.is_approved !== undefined ? overrides.is_approved : true,
+    ...overrides,
+  };
+}
+
+export function createMockIncentive(overrides: any = {}) {
+  return {
+    id: overrides.id || "inc-uuid-1",
+    user_id: overrides.user_id || "user-uuid-1",
+    current_total: overrides.current_total || 0,
+    save: jest.fn().mockResolvedValue(true),
+    ...overrides,
+  };
+}
