+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({
+        reviews: [{ reviewId: "rev-missing", isApproved: true }],
+      });
+
+    expect(res.status).toBe(404);
+  });
+
+  it("rolls back batch when parent item is not approved", async () => {
+    const mockReview = { id: "rev-unapp", item_id: "item-unapp", is_approved: false };
+    (ItemReview.findByPk as jest.Mock).mockResolvedValue(mockReview);
+    (Item.findByPk as jest.Mock).mockResolvedValue({ id: "item-unapp", is_approved: false });
+
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({
