+    findByPk: jest.fn(),
+  },
+  Incentive: {
+    findOne: jest.fn(),
+    create: jest.fn(),
+  },
+  User: {
+    findByPk: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Candidate Item Review Verification - Public HTTP Endpoint Behavior", () => {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/candidate-item-reviews", candidateReviewRouter);
+  app.use((err: any, _req: any, res: any, _next: any) => {
+    res.status(err.statusCode || 500).json({
+      success: false,
+      message: err.message || "Internal Server Error",
+    });
+  });
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe("PUT /api/v1/candidate-item-reviews/:id", () => {
+    it("approves unmoderated review and awards incentive when parent item is approved", async () => {
+      const mockReview = {
+        id: "rev-101",
+        item_id: "item-101",
+        user_id: "user-101",
+        is_approved: false,
+        save: jest.fn().mockResolvedValue(true),
+      };
+      const mockItem = { id: "item-101", is_approved: true };
+      const mockUser = { id: "user-101", balance: 50, save: jest.fn().mockResolvedValue(true) };
+
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mockReview);
+      (Item.findByPk as jest.Mock).mockResolvedValue(mockItem);
+      (Incentive.findOne as jest.Mock).mockResolvedValue(null);
+      (User.findByPk as jest.Mock).mockResolvedValue(mockUser);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-item-reviews/rev-101")
+        .send({ isApproved: true });
+
+      expect(res.status).toBe(200);
+      expect(res.body.success).toBe(true);
+      expect(res.body.data.is_approved).toBe(true);
+      expect(Incentive.create).toHaveBeenCalled();
+    });
+
+    it("returns 400 when parent item is not yet approved", async () => {
+      const mockReview = { id: "rev-102", item_id: "item-102", is_approved: false };
+      const mockItem = { id: "item-102", is_approved: false };
+
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mockReview);
+      (Item.findByPk as jest.Mock).mockResolvedValue(mockItem);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-item-reviews/rev-102")
+        .send({ isApproved: true });
+
+      expect(res.status).toBe(400);
+      expect(res.body.message).toContain("Item is not approved yet");
+    });
+
+    it("does not re-award incentives when approving an already rewarded review", async () => {
+      const mockReview = {
+        id: "rev-103",
+        item_id: "item-103",
+        user_id: "user-103",
+        is_approved: true,
+        save: jest.fn().mockResolvedValue(true),
+      };
+      const mockItem = { id: "item-103", is_approved: true };
+
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mockReview);
+      (Item.findByPk as jest.Mock).mockResolvedValue(mockItem);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-item-reviews/rev-103")
+        .send({ isApproved: true });
+
+      expect(res.status).toBe(200);
+      expect(Incentive.create).not.toHaveBeenCalled();
+    });
+
+    it("deducts incentive when rejecting an approved review", async () => {
+      const mockReview = {
+        id: "rev-104",
+        item_id: "item-104",
+        user_id: "user-104",
+        is_approved: true,
+        save: jest.fn().mockResolvedValue(true),
+      };
+      const mockItem = { id: "item-104", is_approved: true };
+      const mockIncentive = { amount: 10, destroy: jest.fn().mockResolvedValue(true) };
+      const mockUser = { id: "user-104", balance: 50, save: jest.fn().mockResolvedValue(true) };
+
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mockReview);
+      (Item.findByPk as jest.Mock).mockResolvedValue(mockItem);
+      (Incentive.findOne as jest.Mock).mockResolvedValue(mockIncentive);
+      (User.findByPk as jest.Mock).mockResolvedValue(mockUser);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-item-reviews/rev-104")
+        .send({ isApproved: false });
+
+      expect(res.status).toBe(200);
+      expect(mockIncentive.destroy).toHaveBeenCalled();
+    });
+
+    it("returns 404 when review is not found", async () => {
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(null);
+
+      const res = await request(app)
+        .put("/api/v1/candidate-item-reviews/rev-missing")
+        .send({ isApproved: true });
+
+      expect(res.status).toBe(404);
+    });
+
+    
+    it("handles multiple sequential candidate item review moderations accurately", async () => {
+      const mock1 = { id: "rev-seq-1", item_id: "item-1", user_id: "u-1", is_approved: false, save: jest.fn().mockResolvedValue(true) };
+      const mock2 = { id: "rev-seq-2", item_id: "item-2", user_id: "u-2", is_approved: false, save: jest.fn().mockResolvedValue(true) };
+      (ItemReview.findByPk as jest.Mock)
+        .mockResolvedValueOnce(mock1)
+        .mockResolvedValueOnce(mock2);
+      (Item.findByPk as jest.Mock).mockResolvedValue({ id: "item-ok", is_approved: true });
+      (Incentive.findOne as jest.Mock).mockResolvedValue(null);
+
+      const res1 = await request(app).put("/api/v1/candidate-item-reviews/rev-seq-1").send({ isApproved: true });
+      const res2 = await request(app).put("/api/v1/candidate-item-reviews/rev-seq-2").send({ isApproved: false });
+
+      expect(res1.status).toBe(200);
+      expect(res1.body.data.is_approved).toBe(true);
+      expect(res2.status).toBe(200);
+      expect(res2.body.data.is_approved).toBe(false);
+    });
+
+    it("retains user balance without negative numbers when balance is less than deduction", async () => {
+      const mockReview = { id: "rev-bal", item_id: "item-1", user_id: "u-low", is_approved: true, save: jest.fn().mockResolvedValue(true) };
+      const mockItem = { id: "item-1", is_approved: true };
+      const mockIncentive = { amount: 10, destroy: jest.fn().mockResolvedValue(true) };
+      const mockUser = { id: "u-low", balance: 5, save: jest.fn().mockResolvedValue(true) };
+
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mockReview);
+      (Item.findByPk as jest.Mock).mockResolvedValue(mockItem);
+      (Incentive.findOne as jest.Mock).mockResolvedValue(mockIncentive);
+      (User.findByPk as jest.Mock).mockResolvedValue(mockUser);
+
+      const res = await request(app).put("/api/v1/candidate-item-reviews/rev-bal").send({ isApproved: false });
+      expect(res.status).toBe(200);
+      expect(mockUser.balance).toBe(0);
+    });
+
+    it("rolls back moderation transaction when user balance update fails", async () => {
+      const mockReview = { id: "rev-fail", item_id: "item-1", user_id: "u-fail", is_approved: false, save: jest.fn().mockResolvedValue(true) };
+      const mockItem = { id: "item-1", is_approved: true };
+      const mockUser = { id: "u-fail", balance: 50, save: jest.fn().mockRejectedValue(new Error("User update failed")) };
+
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mockReview);
+      (Item.findByPk as jest.Mock).mockResolvedValue(mockItem);
+      (Incentive.findOne as jest.Mock).mockResolvedValue(null);
+      (User.findByPk as jest.Mock).mockResolvedValue(mockUser);
+
+      const res = await request(app).put("/api/v1/candidate-item-reviews/rev-fail").send({ isApproved: true });
+      expect(res.status).toBe(500);
+    });
+
+    
+    it("handles batch moderation whitespace trimming in review ids", async () => {
+      const mock = { id: "rev-trim", item_id: "i-1", user_id: "u-1", is_approved: false, save: jest.fn().mockResolvedValue(true) };
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mock);
