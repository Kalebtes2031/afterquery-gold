+import express from "express";
+import request from "supertest";
+import candidateReviewRouter from "../../routes/candidate_item_review.route";
+import {
+  Item,
+  ItemReview,
+} from "../../models";
+
+jest.mock("../../middlewares/auth", () => ({
+  authenticateToken: (req: any, _res: any, next: any) => {
+    req.user = { id: "admin-uuid-1" };
+    next();
+  },
+  authorizeRole: (_roles: any) => (_req: any, _res: any, next: any) => next(),
+}));
+
+jest.mock("../../models", () => ({
+  ItemReview: {
+    findByPk: jest.fn(),
+    count: jest.fn().mockResolvedValue(1),
+  },
+  Item: {
+    findByPk: jest.fn(),
+  },
+  Incentive: {
+    findOne: jest.fn(),
+    create: jest.fn(),
+  },
+  User: {
+    findByPk: jest.fn(),
+  },
+}));
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        LOCK: { UPDATE: "UPDATE" },
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Candidate Item Review Verification - Batch Moderation Endpoint", () => {
+  const app = express();
+  app.use(express.json());
+  app.use("/api/v1/candidate-item-reviews", candidateReviewRouter);
+  app.use((err: any, _req: any, res: any, _next: any) => {
+    res.status(err.statusCode || 500).json({
+      success: false,
+      message: err.message || "Internal Server Error",
+    });
+  });
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  it("returns 400 when body has no reviews field", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({});
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 when reviews array is empty", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({ reviews: [] });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("returns 400 with duplicate review id when duplicate ids exist in batch", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({
+        reviews: [
+          { reviewId: "rev-dup", isApproved: true },
+          { reviewId: "rev-dup", isApproved: false },
+        ],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Duplicate review id");
+  });
+
+  it("returns 400 when isApproved is not a boolean", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({
+        reviews: [{ reviewId: "rev-1", isApproved: "invalid_bool" }],
+      });
+
+    expect(res.status).toBe(400);
+  });
+
+  it("successfully moderates mixed batch reviews in exact requested order", async () => {
+    const mock1 = {
+      id: "rev-b1",
+      item_id: "item-b1",
+      user_id: "user-b1",
+      is_approved: false,
+      save: jest.fn().mockResolvedValue(true),
+    };
+    const mock2 = {
+      id: "rev-b2",
+      item_id: "item-b2",
+      user_id: "user-b2",
+      is_approved: true,
+      save: jest.fn().mockResolvedValue(true),
+    };
+
+    (ItemReview.findByPk as jest.Mock)
+      .mockResolvedValueOnce(mock1)
+      .mockResolvedValueOnce(mock2);
+    (Item.findByPk as jest.Mock).mockResolvedValue({ id: "item-ok", is_approved: true });
+
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({
+        reviews: [
+          { reviewId: "rev-b1", isApproved: true },
+          { reviewId: "rev-b2", isApproved: false },
+        ],
+      });
+
+    expect(res.status).toBe(200);
+    expect(res.body.success).toBe(true);
+    expect(res.body.data).toHaveLength(2);
+    expect(res.body.data[0].id).toBe("rev-b1");
+    expect(res.body.data[0].is_approved).toBe(true);
+    expect(res.body.data[1].id).toBe("rev-b2");
+    expect(res.body.data[1].is_approved).toBe(false);
+  });
+
+  it("rolls back batch when any review is not found", async () => {
+    (ItemReview.findByPk as jest.Mock).mockResolvedValue(null);
+
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({
+        reviews: [{ reviewId: "rev-missing", isApproved: true }],
+      });
+
+    expect(res.status).toBe(404);
+  });
+});
