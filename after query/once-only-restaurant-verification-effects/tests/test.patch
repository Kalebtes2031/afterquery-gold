+  it("ensures duplicate review IDs with whitespace trigger 400 validation error", async () => {
+    const res = await request(app)
+      .put("/api/v1/candidate-item-reviews/batch-manage")
+      .send({
+        reviews: [
+          { reviewId: "rev-dup-ws", isApproved: true },
+          { reviewId: "   rev-dup-ws   ", isApproved: false },
+        ],
+      });
+
+    expect(res.status).toBe(400);
+    expect(res.body.message).toContain("Duplicate review id");
+  });
+
+  it("validates review batch processing when incentive deduction matches exact balance", async () => {
+    const mockReview = { id: "rev-exact", item_id: "i-1", user_id: "u-ex", is_approved: true, save: jest.fn().mockResolvedValue(true) };
+    const mockIncentive = { amount: 15, destroy: jest.fn().mockResolvedValue(true) };
+    const mockUser = { id: "u-ex", balance: 15, save: jest.fn().mockResolvedValue(true) };
