+import {
+  formatReviewModerationSummary,
+  parseReviewFilters,
+  isValidReviewIdentifier,
+  calculateReviewIncentiveReward,
+  formatReviewModerationAuditLog,
+  validateModerationTransition,
+  serializeReviewModerationReport,
+  validateReviewBatchBounds,
+  calculateBatchIncentiveDelta,
+  buildUserModerationSummary,
+  isIncentiveDeductible,
+} from "../../utils/candidate-item-review-effects.utils";
+
+describe("Candidate Item Review Verification - Utility & Filter Logic", () => {
+  it("formats review moderation summary correctly for approved and rejected sets", () => {
+    const summary = formatReviewModerationSummary([
+      { id: "rev-1", is_approved: true, reviewed_at: new Date() },
+      { id: "rev-2", is_approved: false, reviewed_at: new Date() },
+    ]);
+
+    expect(summary.total).toBe(2);
+    expect(summary.approved).toBe(1);
+    expect(summary.rejected).toBe(1);
+  });
+
+  it("parses review filter parameters accurately", () => {
+    const filters = parseReviewFilters({
+      status: "Approved",
+      itemId: "item-100",
+      limit: "15",
+      offset: "0",
+    });
+
+    expect(filters.status).toBe("Approved");
+    expect(filters.itemId).toBe("item-100");
+    expect(filters.limit).toBe(15);
+  });
+
+  it("validates review identifier formats accurately", () => {
+    expect(isValidReviewIdentifier("rev-12345")).toBe(true);
+    expect(isValidReviewIdentifier("r-abcd-1234")).toBe(true);
+    expect(isValidReviewIdentifier("123e4567-e89b-12d3-a456-426614174000")).toBe(true);
+    expect(isValidReviewIdentifier("")).toBe(false);
+  });
+
+  it("calculates review incentive reward amounts accurately", () => {
+    expect(calculateReviewIncentiveReward(1)).toBe(10);
+    expect(calculateReviewIncentiveReward(2)).toBe(10);
+  });
+
+  it("formats review moderation audit logs and checks transition rules", () => {
+    const log = formatReviewModerationAuditLog({ id: "rev-1", item_id: "i-1", user_id: "u-1" }, true, 10);
+    expect(log.reviewId).toBe("rev-1");
+    expect(log.incentiveAwarded).toBe(10);
+
+    const check = validateModerationTransition(false, true);
+    expect(check.allowed).toBe(true);
+    expect(check.isReversal).toBe(true);
+  });
+
+  it("serializes review reports, validates bounds, and computes batch incentive deltas", () => {
+    const report = serializeReviewModerationReport([
+      { id: "rev-1", item_id: "i-1", user_id: "u-1", is_approved: true },
+    ]);
+    expect(report[0].id).toBe("rev-1");
+
+    const check = validateReviewBatchBounds([{ reviewId: "rev-1", isApproved: true }]);
+    expect(check.valid).toBe(true);
+
+    const delta = calculateBatchIncentiveDelta([
+      { id: "rev-1", item_id: "i-1", user_id: "u-1", is_approved: true, incentive_awarded: 10, reviewed_at: new Date() },
+      { id: "rev-2", item_id: "i-2", user_id: "u-2", is_approved: false, reviewed_at: new Date() },
+    ]);
+    expect(delta.totalAwarded).toBe(10);
+    expect(delta.approvedCount).toBe(1);
+    expect(delta.rejectedCount).toBe(1);
+  });
+
+  it("validates user moderation summaries, bounds, and incentive deductions", () => {
+    const summary = buildUserModerationSummary("u-sum", 5, 2, 50);
+    expect(summary.userId).toBe("u-sum");
+    expect(summary.totalPointsEarned).toBe(50);
+
+    expect(isIncentiveDeductible(10, 20)).toBe(true);
+    expect(isIncentiveDeductible(0, 20)).toBe(false);
+
+    const serialized = serializeReviewModerationReport([
+      { id: "r-1", item_id: "i-1", user_id: "u-1", is_approved: true, rating: 5 },
+    ]);
+    expect(serialized[0].isApproved).toBe("Approved");
+    expect(serialized[0].rating).toBe(5);
+  });
+});
