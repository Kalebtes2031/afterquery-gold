+import { validateBatchReviewPayload } from "../../utils/candidate-item-review-effects.utils";
+import { CandidateItemReviewModerationService } from "../../services/candidate-item-review-moderation.service";
+import { CandidateItemReviewEffectsService } from "../../services/candidate-item-review-effects.service";
+
+jest.mock("../../services/candidate-item-review-effects.service");
+
+jest.mock("../../config/db", () => ({
+  __esModule: true,
+  default: {
+    transaction: jest.fn().mockImplementation((cb) => {
+      const mockTx = {
+        commit: jest.fn().mockResolvedValue(undefined),
+        rollback: jest.fn().mockResolvedValue(undefined),
+      };
+      return cb(mockTx);
+    }),
+  },
+}));
+
+describe("Candidate Item Review Effects - Batch Moderation & Atomicity", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe("Batch Payload Validation", () => {
+    it("returns 400 when body has no reviews field", () => {
+      expect(() => validateBatchReviewPayload({})).toThrow(
+        "Field 'reviews' must be an array"
+      );
+    });
+
+    it("returns 400 when reviews array is empty", () => {
+      expect(() => validateBatchReviewPayload({ reviews: [] })).toThrow(
+        "Field 'reviews' cannot be an empty array"
+      );
+    });
+
+    it("returns 400 with duplicate review id when duplicate ids exist in batch", () => {
+      const payload = {
+        reviews: [
+          { reviewId: "rev-1", isApproved: true },
+          { reviewId: "rev-1", isApproved: false },
+        ],
+      };
+      expect(() => validateBatchReviewPayload(payload)).toThrow(
+        "Duplicate review id 'rev-1' detected"
+      );
+    });
+
+    it("returns 400 when isApproved is not boolean", () => {
+      const payload = {
+        reviews: [{ reviewId: "rev-1", isApproved: "true" }],
+      };
+      expect(() => validateBatchReviewPayload(payload)).toThrow(
+        "invalid 'isApproved' field. Must be boolean"
+      );
+    });
+  });
+
+  describe("Batch Moderation Execution", () => {
+    it("successfully manages batch decisions in a single transaction", async () => {
+      const decisions = [
+        { reviewId: "rev-1", isApproved: true },
+        { reviewId: "rev-2", isApproved: false },
+      ];
+
+      (
+        CandidateItemReviewEffectsService.manageReviewWithLock as jest.Mock
+      )
+        .mockResolvedValueOnce({
+          id: "rev-1",
+          item_id: "item-1",
+          user_id: "user-1",
+          is_approved: true,
+          incentive_awarded: 10,
+          reviewed_at: new Date(),
+          reviewed_by: "admin-1",
+        })
+        .mockResolvedValueOnce({
+          id: "rev-2",
+          item_id: "item-2",
+          user_id: "user-2",
+          is_approved: false,
+          incentive_awarded: 0,
+          reviewed_at: new Date(),
+          reviewed_by: "admin-1",
+        });
+
+      const res =
+        await CandidateItemReviewModerationService.executeBatchManage(
+          decisions,
+          "admin-1"
+        );
+
+      expect(res.totalProcessed).toBe(2);
+      expect(res.totalIncentivesAwarded).toBe(10);
+      expect(res.results[0].id).toBe("rev-1");
+      expect(res.results[1].id).toBe("rev-2");
+    });
+
+    it("rolls back batch when any review fails verification", async () => {
+      (
+        CandidateItemReviewEffectsService.manageReviewWithLock as jest.Mock
+      ).mockRejectedValue(new Error("Item not approved yet"));
+
+      const decisions = [{ reviewId: "rev-fail", isApproved: true }];
+
+      await expect(
+        CandidateItemReviewModerationService.executeBatchManage(
+          decisions,
+          "admin-1"
+        )
+      ).rejects.toThrow("Item not approved yet");
+    });
+
+    it("returns results in the exact requested order of reviewIds", async () => {
+      const decisions = [
+        { reviewId: "rev-99", isApproved: true },
+        { reviewId: "rev-11", isApproved: true },
+        { reviewId: "rev-44", isApproved: false },
+      ];
+
+      (CandidateItemReviewEffectsService.manageReviewWithLock as jest.Mock)
+        .mockResolvedValueOnce({ id: "rev-99", is_approved: true, incentive_awarded: 10 })
+        .mockResolvedValueOnce({ id: "rev-11", is_approved: true, incentive_awarded: 5 })
+        .mockResolvedValueOnce({ id: "rev-44", is_approved: false, incentive_awarded: 0 });
+
+      const res = await CandidateItemReviewModerationService.executeBatchManage(
+        decisions,
+        "admin-1"
+      );
+
+      expect(res.results.map((r) => r.id)).toEqual(["rev-99", "rev-11", "rev-44"]);
+      expect(res.totalIncentivesAwarded).toBe(15);
+    });
+
+    it("trims whitespace from review ids in batch payload", () => {
+      const payload = {
+        reviews: [{ reviewId: "  rev-padded  ", isApproved: true }],
+      };
+      const result = validateBatchReviewPayload(payload);
+      expect(result.reviews[0].reviewId).toBe("rev-padded");
+    });
+
+    it("rolls back batch when any review is already rejected", async () => {
+      (CandidateItemReviewEffectsService.manageReviewWithLock as jest.Mock)
+        .mockRejectedValue(new Error("already rejected"));
+
+      const decisions = [{ reviewId: "rev-dup-rej", isApproved: false }];
+
+      await expect(
+        CandidateItemReviewModerationService.executeBatchManage(decisions, "admin-1")
+      ).rejects.toThrow("already rejected");
+    });
+
+    it("validates batch uniqueness of review IDs accurately", async () => {
+      const valid = await CandidateItemReviewModerationService.validateBatchUniqueness([
+        "rev-1",
+        "rev-2",
+        "rev-3",
+      ]);
+      expect(valid).toBe(true);
+
+      const invalid = await CandidateItemReviewModerationService.validateBatchUniqueness([
+        "rev-1",
+        "rev-1",
+      ]);
+      expect(invalid).toBe(false);
+    });
+
+    it("returns false for batch uniqueness check when review ID list is empty", async () => {
+      const emptyCheck = await CandidateItemReviewModerationService.validateBatchUniqueness([]);
+      expect(emptyCheck).toBe(false);
+    });
+  });
+});
