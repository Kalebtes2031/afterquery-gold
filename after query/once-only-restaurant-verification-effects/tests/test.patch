+      expect(res.status).toBe(200);
+      expect(res.body.data[0].id).toBe("rev-trim");
+    });
+
+    it("verifies single item review moderation with unapproved parent item returns 400", async () => {
+      const mock = { id: "rev-unapp-item", item_id: "i-unapp", user_id: "u-1", is_approved: false };
+      (ItemReview.findByPk as jest.Mock).mockResolvedValue(mock);
+      (Item.findByPk as jest.Mock).mockResolvedValue({ id: "i-unapp", is_approved: false });
+
+      const res = await request(app)
+        .put("/api/v1/candidate-item-reviews/rev-unapp-item")
+        .send({ isApproved: true });
+
+      expect(res.status).toBe(400);
+      expect(res.body.message).toContain("Item is not approved yet");
+    });
+
+    it("returns 400 when isApproved field is missing", async () => {
+      const res = await request(app)
+        .put("/api/v1/candidate-item-reviews/rev-101")
+        .send({});
+
+      expect(res.status).toBe(400);
+    });
+  });
+});
