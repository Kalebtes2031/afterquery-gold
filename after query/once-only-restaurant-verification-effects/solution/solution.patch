+/**
+ * Single item in candidate review moderation batch.
+ */
+export interface BatchReviewModerationItem {
+  reviewId: string;
+  isApproved: boolean;
+}
+
+/**
+ * Payload schema for PUT /api/v1/candidate-item-reviews/batch-manage.
+ */
+export interface BatchReviewModerationPayload {
+  reviews: BatchReviewModerationItem[];
+}
+
+/**
+ * Result representation for an individual item review moderation.
+ */
+export interface ReviewModerationResult {
+  id: string;
+  user_id: string;
+  item_id: string;
+  is_approved: boolean;
+  incentive_awarded?: number;
+  reviewed_at: Date;
+}
+
+/**
+ * Response schema for batch review moderation.
+ */
+export interface BatchReviewModerationResponse {
+  totalProcessed: number;
+  approvedCount: number;
+  rejectedCount: number;
+  results: ReviewModerationResult[];
+}
+
+/**
+ * Query options for filtering item reviews during moderation.
+ */
+export interface ItemReviewFilterOptions {
+  itemId?: string;
+  userId?: string;
+  isApproved?: boolean;
+  limit?: number;
+  offset?: number;
+}
diff --git a/rateeat_backend/src/utils/candidate-item-review-effects.utils.ts b/rateeat_backend/src/utils/candidate-item-review-effects.utils.ts
