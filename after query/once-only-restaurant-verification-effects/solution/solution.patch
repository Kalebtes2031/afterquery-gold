diff --git a/rateeat_backend/src/services/candidate-item-review-effects.service.ts b/rateeat_backend/src/services/candidate-item-review-effects.service.ts
new file mode 100644
index 0000000..cc83a28
--- /dev/null
+++ b/rateeat_backend/src/services/candidate-item-review-effects.service.ts
@@ -0,0 +1,178 @@
+import { Op, Transaction } from "sequelize";
+import sequelize from "../config/db";
+import {
+  Incentive,
+  Item,
+  ItemReview,
+  ItemReviewImage,
+  ItemReviewVideo,
+} from "../models";
+import {
+  BadRequestError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import {
+  ReviewEffectResult,
+  ReviewFilterOptions,
+} from "../types/candidate-item-review-effects.types";
+import { createReviewEffectAuditEntry } from "../utils/candidate-item-review-effects.utils";
+
+export class CandidateItemReviewEffectsService {
+  /**
+   * Evaluates review approval and executes once-only incentive awards within a locked transaction.
+   */
+  public static async manageReviewWithLock(
+    reviewId: string,
+    isApproved: boolean,
+    reviewerId: string,
+    externalTransaction?: Transaction
+  ): Promise<ReviewEffectResult> {
+    const executeEffect = async (tx: Transaction) => {
+      const review = await ItemReview.findByPk(reviewId, {
+        include: [
+          { model: ItemReviewImage, as: "item_review_images" },
+          { model: ItemReviewVideo, as: "item_review_videos" },
+        ],
+        transaction: tx,
+        lock: tx.LOCK.UPDATE,
+      });
+
+      if (!review) {
+        throw new NotFoundError("Candidate item review not found");
+      }
+
+      const currentStatus = review.is_approved;
+      if (currentStatus === isApproved) {
+        const msg = isApproved
+          ? "Candidate item review already approved"
+          : "Candidate item review already rejected";
+        throw new BadRequestError(msg);
+      }
+
+      const item = await Item.findByPk(review.item_id, { transaction: tx });
+      if (!item || !item.is_approved) {
+        throw new BadRequestError(
+          "Item not approved yet, first approve the item"
+        );
+      }
+
+      review.is_approved = isApproved;
+      await review.save({ transaction: tx });
+
+      let moneyEarned = 0;
+      const hasImages = (review as any).item_review_images && (review as any).item_review_images.length > 0;
+      const hasVideos = (review as any).item_review_videos && (review as any).item_review_videos.length > 0;
+
+      if (hasImages || hasVideos) {
+        const approvedReviews = await ItemReview.findAll({
+          where: {
+            is_approved: true,
+            item_id: item.id,
+            [Op.or]: [
+              { "$item_review_images.url$": { [Op.not]: null } },
+              { "$item_review_videos.url$": { [Op.not]: null } },
+            ],
+          },
+          include: [
+            { model: ItemReviewImage, as: "item_review_images" },
+            { model: ItemReviewVideo, as: "item_review_videos" },
+          ],
+          order: [["createdAt", "ASC"]],
+          transaction: tx,
+        });
+
+        const rankInTime = approvedReviews.findIndex((r) => r.id === review.id);
+        moneyEarned =
+          rankInTime < 3 ? 10 : rankInTime < 6 ? 5 : rankInTime < 10 ? 3 : 0;
+      }
+
+      let currentBalance = 0;
+      let incentiveDelta = 0;
+
+      if (moneyEarned > 0) {
+        let incentive = await Incentive.findOne({
+          where: { user_id: review.user_id },
+          transaction: tx,
+          lock: tx.LOCK.UPDATE,
+        });
+
+        if (!incentive) {
+          incentive = await Incentive.create(
+            { user_id: review.user_id, current_total: 0 },
+            { transaction: tx }
+          );
+        }
+
+        if (isApproved) {
+          incentive.current_total += moneyEarned;
+          incentiveDelta = moneyEarned;
+        } else if (!isApproved && currentStatus === true && incentive.current_total >= moneyEarned) {
+          incentive.current_total -= moneyEarned;
+          incentiveDelta = -moneyEarned;
+        }
+        await incentive.save({ transaction: tx });
+        currentBalance = incentive.current_total;
+      }
+
+      createReviewEffectAuditEntry(
+        review.id,
+        review.item_id,
+        review.user_id,
+        isApproved,
+        currentStatus,
+        incentiveDelta,
+        currentBalance,
+        reviewerId
+      );
+
+      return {
+        id: review.id,
+        item_id: review.item_id,
+        user_id: review.user_id,
+        is_approved: isApproved,
+        incentive_awarded: isApproved ? moneyEarned : 0,
+        reviewed_at: new Date(),
+        reviewed_by: reviewerId,
+      };
+    };
+
+    if (externalTransaction) {
+      return executeEffect(externalTransaction);
+    } else {
+      return sequelize.transaction(async (tx) => executeEffect(tx));
+    }
+  }
+
+  /**
+   * Retrieves candidate item reviews matching filter options.
+   */
+  public static async queryReviewsWithFilters(
+    filters: ReviewFilterOptions = {}
+  ): Promise<any[]> {
+    const where: any = {};
+    if (filters.itemId) where.item_id = filters.itemId;
+    if (filters.userId) where.user_id = filters.userId;
+    if (filters.isApproved !== undefined) where.is_approved = filters.isApproved;
+
+    return ItemReview.findAll({
+      where,
+      limit: filters.limit || 50,
+      offset: filters.offset || 0,
+      order: [["createdAt", "DESC"]],
+    });
+  }
+
+  /**
+   * Counts reviews by approval status.
+   */
+  public static async getReviewStatusCounts(): Promise<{
+    pending: number;
+    approved: number;
+    rejected: number;
+  }> {
+    const pending = await ItemReview.count({ where: { is_approved: null } });
+    const approved = await ItemReview.count({ where: { is_approved: true } });
+    const rejected = await ItemReview.count({ where: { is_approved: false } });
+    return { pending, approved, rejected };
+  }
+}
