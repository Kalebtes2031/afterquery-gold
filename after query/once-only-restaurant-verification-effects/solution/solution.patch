+import sequelize from "../config/db";
+import {
+  BatchCandidateItemReviewPayload,
+  BatchReviewEffectsResponse,
+  CandidateItemReviewDecision,
+  ReviewEffectResult,
+} from "../types/candidate-item-review-effects.types";
+import { CandidateItemReviewEffectsService } from "./candidate-item-review-effects.service";
+
+export class CandidateItemReviewModerationService {
+  /**
+   * Executes a batch of review moderation actions atomically in transaction.
+   */
+  public static async executeBatchManage(
+    decisions: CandidateItemReviewDecision[],
+    reviewerId: string
+  ): Promise<BatchReviewEffectsResponse> {
+    return sequelize.transaction(async (tx) => {
+      const results: ReviewEffectResult[] = [];
+      let totalIncentivesAwarded = 0;
+
+      for (const d of decisions) {
+        const res = await CandidateItemReviewEffectsService.manageReviewWithLock(
+          d.reviewId,
+          d.isApproved,
+          reviewerId,
+          tx
+        );
+        results.push(res);
+        totalIncentivesAwarded += res.incentive_awarded;
+      }
+
+      return {
+        totalProcessed: results.length,
+        totalIncentivesAwarded,
+        results,
+      };
+    });
+  }
+
+  /**
+   * Validates uniqueness of review IDs in batch decision payload.
+   */
+  public static async validateBatchUniqueness(
+    reviewIds: string[]
+  ): Promise<boolean> {
+    if (!reviewIds || reviewIds.length === 0) return false;
+    const set = new Set(reviewIds.map((r) => r.trim()));
+    return set.size === reviewIds.length;
+  }
+}
