@@ -0,0 +1,228 @@
+import { BadRequestError } from "../utils/error-response.utils";
+import {
+  BatchReviewModerationItem,
+  BatchReviewModerationPayload,
+  ItemReviewFilterOptions,
+  ReviewModerationResult,
+} from "../types/candidate-item-review-effects.types";
+
+/**
+ * Validates the batch review moderation payload for duplicate IDs and valid structures.
+ */
+export function validateBatchReviewModerationPayload(
+  body: any
+): BatchReviewModerationPayload {
+  if (!body || typeof body !== "object") {
+    throw new BadRequestError("Request body must be a valid JSON object");
+  }
+
+  const { reviews } = body;
+  if (!Array.isArray(reviews)) {
+    throw new BadRequestError("Field 'reviews' must be an array");
+  }
+
+  if (reviews.length === 0) {
+    throw new BadRequestError("Field 'reviews' cannot be an empty array");
+  }
+
+  const seenIds = new Set<string>();
+  const validatedItems: BatchReviewModerationItem[] = [];
+
+  for (let i = 0; i < reviews.length; i++) {
+    const item = reviews[i];
+    if (!item || typeof item !== "object") {
+      throw new BadRequestError(`Review item at index ${i} must be an object`);
+    }
+
+    const { reviewId, isApproved } = item;
+    if (!reviewId || typeof reviewId !== "string" || reviewId.trim().length === 0) {
+      throw new BadRequestError(
+        `Review item at index ${i} is missing a valid 'reviewId'`
+      );
+    }
+
+    if (typeof isApproved !== "boolean") {
+      throw new BadRequestError(
+        `Review item at index ${i} is missing a boolean 'isApproved'`
+      );
+    }
+
+    const cleanId = reviewId.trim();
+    if (seenIds.has(cleanId)) {
+      throw new BadRequestError(
+        `Duplicate review id '${cleanId}' detected in batch payload`
+      );
+    }
+    seenIds.add(cleanId);
+
+    validatedItems.push({
+      reviewId: cleanId,
+      isApproved,
+    });
+  }
+
+  return { reviews: validatedItems };
+}
+
+/**
+ * Summarizes the moderation outcome totals.
+ */
+export function formatReviewModerationSummary(
+  results: ReviewModerationResult[]
+): { approved: number; rejected: number; total: number } {
+  let approved = 0;
+  let rejected = 0;
+  for (const r of results) {
+    if (r.is_approved) approved++;
+    else rejected++;
+  }
+  return { approved, rejected, total: results.length };
+}
+
+/**
+ * Parses query options for filtering candidate reviews.
+ */
+export function parseReviewFilters(query: any): ItemReviewFilterOptions {
+  const options: ItemReviewFilterOptions = {};
+  if (query.itemId && typeof query.itemId === "string") {
+    options.itemId = query.itemId.trim();
+  }
+  if (query.userId && typeof query.userId === "string") {
+    options.userId = query.userId.trim();
+  }
+  if (query.isApproved !== undefined) {
+    options.isApproved = query.isApproved === "true" || query.isApproved === true;
+  }
+  if (query.limit) {
+    const lim = parseInt(query.limit, 10);
+    if (!isNaN(lim) && lim > 0) options.limit = Math.min(lim, 100);
+  }
+  if (query.offset) {
+    const off = parseInt(query.offset, 10);
+    if (!isNaN(off) && off >= 0) options.offset = off;
+  }
+  return options;
+}
+
+/**
+ * Computes incentive rank reward based on chronological position.
+ */
+
+/**
+ * Formats an item review moderation audit entry.
+ */
+export function formatReviewModerationAuditLog(
+  review: any,
+  isApproved: boolean,
+  incentiveAwarded: number
+): Record<string, any> {
+  return {
+    reviewId: review.id,
+    itemId: review.item_id,
+    userId: review.user_id,
+    isApproved,
+    incentiveAwarded,
+    timestamp: new Date().toISOString(),
+  };
+}
+
+/**
+ * Validates item review moderation transition parameters.
+ */
+export function validateModerationTransition(
+  currentApproved: boolean | null | undefined,
+  targetApproved: boolean
+): { allowed: boolean; isReversal: boolean } {
+  if (currentApproved === null || currentApproved === undefined) {
+    return { allowed: true, isReversal: false };
+  }
+  if (currentApproved === targetApproved) {
+    return { allowed: true, isReversal: false };
+  }
+  return { allowed: true, isReversal: true };
+}
+
+
+/**
+ * Serializes item review moderation records for export and audit.
+ */
+export function serializeReviewModerationReport(
+  reviews: ItemReview[] | any[]
+): Array<Record<string, any>> {
+  return reviews.map((r) => ({
+    id: r.id,
+    itemId: r.item_id,
+    userId: r.user_id,
+    isApproved: r.is_approved ? "Approved" : "Unapproved",
+    rating: r.rating || "N/A",
+    comment: r.comment || "",
+  }));
+}
+
+/**
+ * Validates batch review moderation array bounds.
+ */
+export function validateReviewBatchBounds(
+  reviews: BatchReviewModerationItem[],
+  maxLimit: number = 50
+): { valid: boolean; error?: string } {
+  if (!reviews || reviews.length === 0) {
+    return { valid: false, error: "Reviews array cannot be empty" };
+  }
+  if (reviews.length > maxLimit) {
+    return { valid: false, error: `Reviews array exceeds limit of ${maxLimit}` };
+  }
+  return { valid: true };
+}
+
+/**
+ * Computes net incentive adjustments across a moderation batch.
+ */
+export function calculateBatchIncentiveDelta(
+  results: ReviewModerationResult[]
+): { totalAwarded: number; approvedCount: number; rejectedCount: number } {
+  let totalAwarded = 0;
+  let approvedCount = 0;
+  let rejectedCount = 0;
+  for (const res of results) {
+    if (res.is_approved) {
+      approvedCount++;
+      totalAwarded += (res.incentive_awarded || 0);
+    } else {
+      rejectedCount++;
+    }
+  }
+  return { totalAwarded, approvedCount, rejectedCount };
+}
+
+export function calculateReviewIncentiveReward(rank: number): number {
+  if (rank <= 1) return 10;
+  if (rank <= 3) return 5;
+  if (rank <= 5) return 3;
+  return 0;
+}
+
+/**
+ * Validates whether an incentive reward is eligible for deduction.
+ */
+export function isIncentiveDeductible(amount: number, userBalance: number): boolean {
+  return amount > 0 && userBalance >= 0;
+}
+
+/**
+ * Builds user moderation summary envelope.
+ */
+export function buildUserModerationSummary(
+  userId: string,
+  approvedCount: number,
+  rejectedCount: number,
+  totalPoints: number
+): Record<string, any> {
+  return {
+    userId,
+    approvedReviews: approvedCount,
+    rejectedReviews: rejectedCount,
+    totalPointsEarned: totalPoints,
+    calculatedAt: new Date().toISOString(),
+  };
+}
