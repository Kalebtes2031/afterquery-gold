@@ -0,0 +1,104 @@
+/**
+ * Individual decision structure for candidate item review moderation.
+ */
+export interface CandidateItemReviewDecision {
+  reviewId: string;
+  isApproved: boolean;
+  notes?: string;
+}
+
+/**
+ * Request payload schema for PUT /api/v1/candidate-item-reviews/batch-manage.
+ */
+export interface BatchCandidateItemReviewPayload {
+  reviews: CandidateItemReviewDecision[];
+}
+
+/**
+ * Result representation for once-only review side effects.
+ */
+export interface ReviewEffectResult {
+  id: string;
+  item_id: string;
+  user_id: string;
+  is_approved: boolean;
+  incentive_awarded: number;
+  reviewed_at: Date;
+  reviewed_by: string;
+}
+
+/**
+ * Batch response representation for review side effects.
+ */
+export interface BatchReviewEffectsResponse {
+  totalProcessed: number;
+  totalIncentivesAwarded: number;
+  results: ReviewEffectResult[];
+}
+
+/**
+ * Filter options for querying candidate item reviews.
+ */
+export interface ReviewFilterOptions {
+  itemId?: string;
+  userId?: string;
+  isApproved?: boolean | null;
+  limit?: number;
+  offset?: number;
+  startDate?: Date;
+  endDate?: Date;
+}
+
+/**
+ * Immutable audit log record for incentive and verification side effects.
+ */
+export interface ReviewSideEffectAuditRecord {
+  auditId: string;
+  reviewId: string;
+  itemId: string;
+  userId: string;
+  isApproved: boolean;
+  previousApprovalStatus: boolean | null;
+  incentiveDelta: number;
+  resultingBalance: number;
+  reviewerId: string;
+  timestamp: string;
+}
+
+/**
+ * Summary metrics of incentive awards across reviews.
+ */
+export interface ReviewIncentiveMetrics {
+  totalAwardsDistributed: number;
+  totalPointsValue: number;
+  distinctRecipients: number;
+  averageRewardPerApprovedReview: number;
+}
+
+export interface IncentiveTransactionAuditRecord {
+  transactionId: string;
+  userId: string;
+  reviewId: string;
+  delta: number;
+  balanceBefore: number;
+  balanceAfter: number;
+  reason: string;
+  timestamp: string;
+}
+
+export interface ReviewModerationBatchReport {
+  batchId: string;
+  totalSubmissions: number;
+  approvedCount: number;
+  rejectedCount: number;
+  totalIncentivesDistributed: number;
+  executionDurationMs: number;
+}
+
+export interface CandidateItemReviewQueryCriteria {
+  minRating?: number;
+  maxRating?: number;
+  hasMediaOnly?: boolean;
+  limit?: number;
+  offset?: number;
+}
diff --git a/rateeat_backend/src/utils/candidate-item-review-effects.utils.ts b/rateeat_backend/src/utils/candidate-item-review-effects.utils.ts
new file mode 100644
index 0000000..a6835a8
--- /dev/null
+++ b/rateeat_backend/src/utils/candidate-item-review-effects.utils.ts
@@ -0,0 +1,180 @@
+import { BadRequestError } from "../utils/error-response.utils";
+import {
+  BatchCandidateItemReviewPayload,
+  CandidateItemReviewDecision,
+  ReviewEffectResult,
+  ReviewFilterOptions,
+  ReviewIncentiveMetrics,
+  ReviewSideEffectAuditRecord,
+} from "../types/candidate-item-review-effects.types";
+
+/**
+ * Validates the batch moderation payload, ensuring arrays are well-formed and unique.
+ */
+export function validateBatchReviewPayload(
+  body: any
+): BatchCandidateItemReviewPayload {
+  if (!body || typeof body !== "object") {
+    throw new BadRequestError("Request body must be a valid JSON object");
+  }
+
+  const { reviews } = body;
+  if (!Array.isArray(reviews)) {
+    throw new BadRequestError("Field 'reviews' must be an array");
+  }
+
+  if (reviews.length === 0) {
+    throw new BadRequestError("Field 'reviews' cannot be an empty array");
+  }
+
+  const seenIds = new Set<string>();
+  const validatedDecisions: CandidateItemReviewDecision[] = [];
+
+  for (let i = 0; i < reviews.length; i++) {
+    const item = reviews[i];
+    if (!item || typeof item !== "object") {
+      throw new BadRequestError(`Review item at index ${i} must be an object`);
+    }
+
+    const { reviewId, isApproved, notes } = item;
+    if (!reviewId || typeof reviewId !== "string" || reviewId.trim().length === 0) {
+      throw new BadRequestError(
+        `Review item at index ${i} is missing a valid 'reviewId'`
+      );
+    }
+
+    const cleanId = reviewId.trim();
+    if (seenIds.has(cleanId)) {
+      throw new BadRequestError(
+        `Duplicate review id '${cleanId}' detected in batch payload`
+      );
+    }
+    seenIds.add(cleanId);
+
+    if (typeof isApproved !== "boolean") {
+      throw new BadRequestError(
+        `Review item at index ${i} has invalid 'isApproved' field. Must be boolean`
+      );
+    }
+
+    validatedDecisions.push({
+      reviewId: cleanId,
+      isApproved,
+      notes: typeof notes === "string" ? notes.trim() : undefined,
+    });
+  }
+
+  return { reviews: validatedDecisions };
+}
+
+/**
+ * Summarizes the total incentives awarded and processed reviews.
+ */
+export function formatReviewEffectsSummary(
+  results: ReviewEffectResult[]
+): { totalAwarded: number; count: number } {
+  let totalAwarded = 0;
+  for (const res of results) {
+    totalAwarded += res.incentive_awarded;
+  }
+  return { totalAwarded, count: results.length };
+}
+
+/**
+ * Parses query options into structured filter parameters for review searches.
+ */
+export function parseReviewFilters(query: any): ReviewFilterOptions {
+  const options: ReviewFilterOptions = {};
+  if (query.itemId && typeof query.itemId === "string") {
+    options.itemId = query.itemId.trim();
+  }
+  if (query.userId && typeof query.userId === "string") {
+    options.userId = query.userId.trim();
+  }
+  if (query.isApproved !== undefined) {
+    if (query.isApproved === "true" || query.isApproved === true) options.isApproved = true;
+    else if (query.isApproved === "false" || query.isApproved === false) options.isApproved = false;
+    else if (query.isApproved === "null" || query.isApproved === null) options.isApproved = null;
+  }
+  if (query.limit) {
+    const lim = parseInt(query.limit, 10);
+    if (!isNaN(lim) && lim > 0) options.limit = Math.min(lim, 100);
+  }
+  if (query.offset) {
+    const off = parseInt(query.offset, 10);
+    if (!isNaN(off) && off >= 0) options.offset = off;
+  }
+  return options;
+}
+
+/**
+ * Creates an audit log record for incentive adjustments and side effects.
+ */
+export function createReviewEffectAuditEntry(
+  reviewId: string,
+  itemId: string,
+  userId: string,
+  isApproved: boolean,
+  prevStatus: boolean | null,
+  incentiveDelta: number,
+  balance: number,
+  reviewerId: string
+): ReviewSideEffectAuditRecord {
+  return {
+    auditId: `rev_effect_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`,
+    reviewId,
+    itemId,
+    userId,
+    isApproved,
+    previousApprovalStatus: prevStatus,
+    incentiveDelta,
+    resultingBalance: balance,
+    reviewerId,
+    timestamp: new Date().toISOString(),
+  };
+}
+
+/**
+ * Computes statistical metrics across a list of review side effect executions.
+ */
+export function computeIncentiveMetrics(
+  results: ReviewEffectResult[]
+): ReviewIncentiveMetrics {
+  const recipients = new Set<string>();
+  let totalAwards = 0;
+  let totalPoints = 0;
+
+  for (const r of results) {
+    if (r.incentive_awarded > 0) {
+      totalAwards++;
+      totalPoints += r.incentive_awarded;
+      recipients.add(r.user_id);
+    }
+  }
+
+  const avg =
+    totalAwards > 0 ? Math.round((totalPoints / totalAwards) * 100) / 100 : 0;
+
+  return {
+    totalAwardsDistributed: totalAwards,
+    totalPointsValue: totalPoints,
+    distinctRecipients: recipients.size,
+    averageRewardPerApprovedReview: avg,
+  };
+}
+
+export function parseReviewQueryCriteria(query: any): CandidateItemReviewQueryCriteria {
+  const criteria: CandidateItemReviewQueryCriteria = {};
+  if (query.minRating) {
+    const min = parseFloat(query.minRating);
+    if (!isNaN(min)) criteria.minRating = min;
+  }
+  if (query.maxRating) {
+    const max = parseFloat(query.maxRating);
+    if (!isNaN(max)) criteria.maxRating = max;
+  }
+  if (query.hasMediaOnly === "true" || query.hasMediaOnly === true) {
+    criteria.hasMediaOnly = true;
+  }
+  return criteria;
+}
