@@ -0,0 +1,171 @@
+import { Transaction } from "sequelize";
+import sequelize from "../config/db";
+import {
+  Incentive,
+  Item,
+  ItemReview,
+  User,
+} from "../models";
+import {
+  BadRequestError,
+  NotFoundError,
+} from "../utils/error-response.utils";
+import {
+  BatchReviewModerationItem,
+  ItemReviewFilterOptions,
+  ReviewModerationResult,
+} from "../types/candidate-item-review-effects.types";
+import { calculateReviewIncentiveReward } from "../utils/candidate-item-review-effects.utils";
+
+export class CandidateItemReviewEffectsService {
+  /**
+   * Manages candidate item review moderation with once-only incentive guarantees.
+   */
+  public static async manageReviewWithEffects(
+    reviewId: string,
+    isApproved: boolean,
+    externalTransaction?: Transaction
+  ): Promise<ReviewModerationResult> {
+    const executeModeration = async (tx: Transaction) => {
+      const review = await ItemReview.findByPk(reviewId, {
+        transaction: tx,
+        lock: tx.LOCK.UPDATE,
+      });
+
+      if (!review) {
+        throw new NotFoundError("Candidate item review doesn't exist");
+      }
+
+      const item = await Item.findByPk(review.item_id, {
+        transaction: tx,
+      });
+
+      if (!item || !item.is_approved) {
+        throw new BadRequestError("Item is not approved yet");
+      }
+
+      let incentiveAwarded = 0;
+      const wasApproved = review.is_approved === true;
+
+      if (isApproved && !wasApproved) {
+        review.is_approved = true;
+        await review.save({ transaction: tx });
+
+        const existingIncentive = await Incentive.findOne({
+          where: {
+            user_id: review.user_id,
+            item_review_id: review.id,
+          },
+          transaction: tx,
+        });
+
+        if (!existingIncentive) {
+          const priorCount = await ItemReview.count({
+            where: { item_id: review.item_id, is_approved: true },
+            transaction: tx,
+          });
+          incentiveAwarded = calculateReviewIncentiveReward(priorCount);
+
+          if (incentiveAwarded > 0) {
+            await Incentive.create(
+              {
+                user_id: review.user_id,
+                item_review_id: review.id,
+                amount: incentiveAwarded,
+              },
+              { transaction: tx }
+            );
+
+            const user = await User.findByPk(review.user_id, {
+              transaction: tx,
+              lock: tx.LOCK.UPDATE,
+            });
+            if (user) {
+              user.balance = (user.balance || 0) + incentiveAwarded;
+              await user.save({ transaction: tx });
+            }
+          }
+        }
+      } else if (!isApproved && wasApproved) {
+        review.is_approved = false;
+        await review.save({ transaction: tx });
+
+        const existingIncentive = await Incentive.findOne({
+          where: {
+            user_id: review.user_id,
+            item_review_id: review.id,
+          },
+          transaction: tx,
+        });
+
+        if (existingIncentive) {
+          const deductAmount = existingIncentive.amount;
+          await existingIncentive.destroy({ transaction: tx });
+
+          const user = await User.findByPk(review.user_id, {
+            transaction: tx,
+            lock: tx.LOCK.UPDATE,
+          });
+          if (user && user.balance !== undefined) {
+            user.balance = Math.max(0, user.balance - deductAmount);
+            await user.save({ transaction: tx });
+          }
+        }
+      }
+
+      return {
+        id: review.id,
+        user_id: review.user_id,
+        item_id: review.item_id,
+        is_approved: review.is_approved,
+        incentive_awarded: incentiveAwarded,
+        reviewed_at: new Date(),
+      };
+    };
+
+    if (externalTransaction) {
+      return executeModeration(externalTransaction);
+    } else {
+      return sequelize.transaction(async (tx) => executeModeration(tx));
+    }
+  }
+
+  /**
+   * Executes batch moderation of item reviews within a single atomic transaction.
+   */
+  public static async executeBatchModeration(
+    items: BatchReviewModerationItem[]
+  ): Promise<ReviewModerationResult[]> {
+    return sequelize.transaction(async (tx) => {
+      const results: ReviewModerationResult[] = [];
+      for (const item of items) {
+        const res = await this.manageReviewWithEffects(
+          item.reviewId,
+          item.isApproved,
+          tx
+        );
+        results.push(res);
+      }
+      return results;
+    });
+  }
+
+  /**
+   * Queries reviews matching specific moderation criteria.
+   */
+  public static async getFilteredReviews(
+    options: ItemReviewFilterOptions
+  ): Promise<{ rows: ItemReview[]; count: number }> {
+    const where: any = {};
+    if (options.itemId) where.item_id = options.itemId;
+    if (options.userId) where.user_id = options.userId;
+    if (options.isApproved !== undefined) where.is_approved = options.isApproved;
+
+    return ItemReview.findAndCountAll({
+      where,
+      limit: options.limit || 20,
+      offset: options.offset || 0,
+      order: [["createdAt", "DESC"]],
+    });
+  }
+}
