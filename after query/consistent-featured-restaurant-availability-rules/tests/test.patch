+import { NextFunction, Request, Response } from "express";
+import Database from "../db_setup";
+import { Restaurant, RestaurantImage } from "../../models";
+import SponsoredListing from "../../models/SponsoredListing/SponsoredListing";
+
+import {
+  expireSponsoredListings,
+  getSponsoredListings,
+} from "../../controllers/sponsored_listing.controller";
+
+const NOW = new Date("2030-01-10T12:00:00.000Z");
+
+const RESTAURANT_ID = "11111111-1111-4111-8111-111111111111";
+
+const LISTING_ID = "33333333-3333-4333-8333-333333333333";
+
+const responseFor = () => {
+  const response: any = {
+    statusCode: 200,
+    body: undefined,
+  };
+
+  response.status = jest.fn((statusCode: number) => {
+    response.statusCode = statusCode;
+    return response;
+  });
+
+  response.json = jest.fn((body: unknown) => {
+    /*
+     * Serialize the same way an HTTP response would, rather than exposing
+     * Sequelize instances to the assertions.
+     */
+    response.body = JSON.parse(JSON.stringify(body));
+    return response;
+  });
+
+  return response as Response & {
+    statusCode: number;
+    body: any;
+  };
+};
+
+const execute = async (handler: any, req: Partial<Request> = {}) => {
+  const res = responseFor();
+
+  const next = jest.fn((error?: unknown) => {
+    if (error) {
+      throw error;
+    }
+  }) as unknown as NextFunction;
+
+  await handler(req as Request, res, next);
+
+  return {
+    res,
+    next: next as unknown as jest.Mock,
+  };
+};
+
+const createListing = async (overrides: Record<string, unknown> = {}) =>
+  SponsoredListing.create({
+    id: LISTING_ID,
+    restaurant_id: RESTAURANT_ID,
+    start_date: new Date("2030-01-10T00:00:00.000Z"),
+    end_date: new Date("2030-01-20T00:00:00.000Z"),
+    impressions: 2,
+    max_impressions: 10,
+    status: "Active",
+    priority: 2,
+    rotation_interval: 5,
+    image_url: "https://images.example/listing.jpg",
+    discount_info: "10% off",
+    ...overrides,
+  } as any);
+
+beforeAll(async () => {
+  const sequelize = await Database.getInstance();
+
+  /*
+   * Establish the DB connection before fake timers are enabled. The fixed
+   * clock makes exact start/end boundary tests deterministic.
+   */
+  jest.useFakeTimers({
+    doNotFake: ["nextTick", "setImmediate"],
+  });
+
+  jest.setSystemTime(NOW);
+
+  await SponsoredListing.destroy({
+    where: {
+      restaurant_id: RESTAURANT_ID,
+    },
+  });
+
+  await RestaurantImage.destroy({
+    where: {
+      restaurant_id: RESTAURANT_ID,
+    },
+  });
+
+  await Restaurant.destroy({
+    where: {
+      id: RESTAURANT_ID,
+    },
+  });
+
+  /*
+   * Insert test restaurants directly so setup does not depend on restaurant
+   * controller hooks or unrelated API behavior.
+   */
+  await sequelize.getQueryInterface().bulkInsert("restaurants", [
+    {
+      id: RESTAURANT_ID,
+      name: "Lifecycle Cafe",
+      currency: "ETB",
+      createdAt: NOW,
+      updatedAt: NOW,
+    },
+  ]);
+});
+
+afterAll(async () => {
+  await SponsoredListing.destroy({
+    where: {
+      restaurant_id: RESTAURANT_ID,
+    },
+  });
+
+  await RestaurantImage.destroy({
+    where: {
+      restaurant_id: RESTAURANT_ID,
+    },
+  });
+
+  await Restaurant.destroy({
+    where: {
+      id: RESTAURANT_ID,
+    },
+  });
+
+  jest.useRealTimers();
+
+  await Database.close();
+});
+
+beforeEach(async () => {
+  await SponsoredListing.destroy({
+    where: {
+      restaurant_id: RESTAURANT_ID,
+    },
+  });
+
+  await RestaurantImage.destroy({
+    where: {
+      restaurant_id: RESTAURANT_ID,
+    },
+  });
+});
+
+describe("sponsored listing schedule lifecycle", () => {
+  describe("display eligibility", () => {
+    it("hides an Active listing whose schedule has not started", async () => {
+      await createListing({
+        start_date: new Date("2030-01-11T00:00:00.000Z"),
+      });
+
+      const { res } = await execute(getSponsoredListings);
+
+      expect(res.statusCode).toBe(200);
+
+      expect(res.body).toEqual({
+        success: true,
+        data: [],
+      });
+    });
+
+    it("hides an Active listing after its end time", async () => {
+      await createListing({
+        start_date: new Date("2030-01-01T00:00:00.000Z"),
+        end_date: new Date("2030-01-10T11:59:59.000Z"),
+      });
+
+      const { res } = await execute(getSponsoredListings);
+
+      expect(res.statusCode).toBe(200);
+      expect(res.body.data).toEqual([]);
+    });
+
+    it("treats the end time as exclusive", async () => {
+      await createListing({
+        start_date: new Date("2030-01-01T00:00:00.000Z"),
+        end_date: new Date(NOW),
+      });
+
+      const { res } = await execute(getSponsoredListings);
+
+      expect(res.statusCode).toBe(200);
+      expect(res.body.data).toEqual([]);
+    });
+
+    it("hides an Active listing whose impression budget is exhausted", async () => {
+      await createListing({
+        impressions: 10,
+        max_impressions: 10,
+      });
+
+      const { res } = await execute(getSponsoredListings);
+
+      expect(res.statusCode).toBe(200);
+      expect(res.body.data).toEqual([]);
+    });
+
+    it("hides a listing after it has expired", async () => {
+      const listing = await createListing({
+        status: "Active",
+        start_date: new Date("2030-01-01T00:00:00.000Z"),
+        end_date: new Date("2030-01-10T11:00:00.000Z"),
+        impressions: 2,
+        max_impressions: 10,
+      });
+
+      await expireSponsoredListings();
+      await listing.reload();
+
+      expect(listing.status).toBe("Expired");
+
+      const { res } = await execute(getSponsoredListings);
+
+      expect(res.statusCode).toBe(200);
+      expect(res.body.data).toEqual([]);
+    });
+
+    it("keeps the existing response shape for a currently eligible listing", async () => {
+      await createListing({
+        start_date: new Date(NOW),
+        end_date: new Date("2030-01-11T12:00:00.000Z"),
+        impressions: 1,
+      });
+
+      await RestaurantImage.create({
+        restaurant_id: RESTAURANT_ID,
+        url: "https://images.example/logo.jpg",
+        is_leading: true,
