+/* eslint-disable no-use-before-define */
+import {
+  Table,
+  Column,
+  Model,
+  DataType,
+  ForeignKey,
+  PrimaryKey,
+  BelongsTo,
+} from "sequelize-typescript";
+
+import { SplitGroup, SplitParticipant, User } from "..";
+
+/**
+ * An audit record of one participant's payment settlement, written by PUT
+ * /api/v1/split-group/:groupId/member/:participantId/payment and updated
+ * by its DELETE counterpart - who confirmed it, for how much, when, and,
+ * if the confirmation was later reversed as a mistake, by whom and when
+ * that happened. There is at most one row per participant (see the unique
+ * index on `split_participant_id`): a reversal followed by a fresh
+ * confirmation updates this same row rather than adding another, so its
+ * own lifecycle - confirmed, possibly reversed, possibly confirmed again -
+ * is the audit trail, rather than the row itself.
+ *
+ * Every write to this table happens inside the same transaction as the
+ * participant/group update it accompanies - see `confirmParticipantPayment`
+ * and `reverseParticipantPayment` in split-payment.service.ts - so it can
+ * never fall out of step with the settlement it's recording.
+ */
+@Table({
+  tableName: "split_payment_confirmations",
+  timestamps: true,
+})
+class SplitPaymentConfirmation extends Model<SplitPaymentConfirmation> {
+  @PrimaryKey
+  @Column({
+    type: DataType.UUID,
+    defaultValue: DataType.UUIDV4,
+    allowNull: false,
+  })
+  id!: string;
+
+  @ForeignKey(() => SplitGroup)
+  @Column({
+    type: DataType.UUID,
+    allowNull: false,
+  })
+  split_group_id!: string;
+
+  @ForeignKey(() => SplitParticipant)
+  @Column({
+    type: DataType.UUID,
+    allowNull: false,
+  })
+  split_participant_id!: string;
+
+  @ForeignKey(() => User)
+  @Column({
+    type: DataType.UUID,
+    allowNull: false,
+  })
+  confirmed_by_user_id!: string;
+
+  @Column({
+    type: DataType.DOUBLE,
+    allowNull: false,
+  })
+  amount_confirmed!: number;
+
+  @Column({
+    type: DataType.DATE,
+    allowNull: true,
+  })
+  reversed_at!: Date | null;
+
+  @ForeignKey(() => User)
+  @Column({
+    type: DataType.UUID,
+    allowNull: true,
+  })
+  reversed_by_user_id!: string | null;
+
+  // Relationships
+  @BelongsTo(() => SplitGroup)
+  split_group!: SplitGroup;
+
+  @BelongsTo(() => SplitParticipant)
+  split_participant!: SplitParticipant;
+
+  @BelongsTo(() => User, { foreignKey: "confirmed_by_user_id" })
+  confirmed_by!: User;
+
+  @BelongsTo(() => User, { foreignKey: "reversed_by_user_id" })
+  reversed_by!: User | null;
+}
+
+export default SplitPaymentConfirmation;
