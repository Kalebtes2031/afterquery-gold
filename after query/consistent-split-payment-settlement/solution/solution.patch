diff --git a/rateeat_backend/src/services/split-payment.service.ts b/rateeat_backend/src/services/split-payment.service.ts
new file mode 100644
index 0000000..b08cb35
--- /dev/null
+++ b/rateeat_backend/src/services/split-payment.service.ts
@@ -0,0 +1,249 @@
+import { Transaction } from "sequelize";
+import sequelize from "../config/db";
+import { SplitGroup, SplitParticipant } from "../models";
+import { ParticipantStatus } from "../models/SharedBill/SplitParticipant";
+import SplitPaymentConfirmation from "../models/SharedBill/SplitPaymentConfirmation";
+import { ForbiddenError, NotFoundError } from "../utils/error-response.utils";
+import { SplitPaymentParticipantActionInput } from "../types/split-payment.types";
+
+/**
+ * `remaining_balance` is a DOUBLE column, adjusted one participant's
+ * `owed_amount` at a time. A total that doesn't divide evenly among
+ * participants (100 split three ways, say) means those adjustments don't
+ * necessarily sum back to exactly 0 - floating-point arithmetic can leave a
+ * residue like 1e-13 instead. Anything within this tolerance of zero counts
+ * as fully settled, so a total's own rounding never prevents the group from
+ * finalizing once every participant has genuinely paid.
+ */
+const BALANCE_EPSILON = 1e-6;
+
+/**
+ * Lock the split group row, confirm the requesting user owns it, and look
+ * up the participant scoped to that group. Shared by both
+ * `confirmParticipantPayment` and `reverseParticipantPayment`, since both
+ * start from exactly this same precondition check.
+ *
+ * @param transaction - the open transaction both callers run their whole
+ *   operation inside.
+ * @throws {NotFoundError} when the split group, or a participant belonging
+ *   to it, does not exist.
+ * @throws {ForbiddenError} when `userId` does not own the split group.
+ */
+const lockOwnedGroupAndParticipant = async (
+  { groupId, participantId, userId }: SplitPaymentParticipantActionInput,
+  transaction: Transaction
+): Promise<{
+  splitGroup: InstanceType<typeof SplitGroup>;
+  participant: InstanceType<typeof SplitParticipant>;
+}> => {
+  const splitGroup = await SplitGroup.findByPk(groupId, {
+    transaction,
+    lock: transaction.LOCK.UPDATE,
+  });
+
+  if (!splitGroup) {
+    throw new NotFoundError("Split Group");
+  }
+
+  if (splitGroup.user_id !== userId) {
+    throw new ForbiddenError();
+  }
+
+  const participant = await SplitParticipant.findOne({
+    where: { id: participantId, split_group_id: splitGroup.id },
+    transaction,
+  });
+
+  if (!participant) {
+    throw new NotFoundError("Participant");
+  }
+
+  return { splitGroup, participant };
+};
+
+/**
+ * Re-fetch a split group with its participants and payment confirmations
+ * eager-loaded, for the response both service calls below return. A plain
+ * object assignment isn't how Sequelize populates an association, so the
+ * response has to be loaded back through it to actually carry every
+ * participant and confirmation.
+ */
+const loadGroupForResponse = (
+  groupId: string
+): Promise<InstanceType<typeof SplitGroup> | null> =>
+  SplitGroup.findByPk(groupId, {
+    include: [{ model: SplitParticipant }, { model: SplitPaymentConfirmation }],
+  });
+
+/**
+ * @description Atomically record one participant's share of a split bill as
+ * paid, outside the online payment flow, and finalize the group the moment
+ * every participant has.
+ *
+ * The whole operation runs inside one transaction:
+ *  1. The split group row is locked with `SELECT ... FOR UPDATE`, so a
+ *     second, concurrent confirmation (or reversal) for a different
+ *     participant of the *same* group blocks here until this one commits or
+ *     rolls back - the group's `remaining_balance` can never be adjusted
+ *     from two stale reads at once.
+ *  2. Ownership is checked against the locked row.
+ *  3. The participant is looked up scoped to this group, so an id that
+ *     exists but belongs to a different split group is treated the same as
+ *     one that doesn't exist at all.
+ *  4. If the participant is already marked paid, nothing further happens -
+ *     this call is a no-op, and the group's current state is returned as
+ *     it stood. This is what makes a repeated confirmation (a retried
+ *     request, two people submitting the same in-person payment twice)
+ *     safe to call more than once without double-deducting, or recording a
+ *     second audit entry for the same participant.
+ *  5. Otherwise, the participant is marked paid, their `owed_amount` is
+ *     deducted from the group's `remaining_balance`, and - once that
+ *     balance has reached (approximately) zero - the group is marked
+ *     finalized with the moment that happened.
+ *  6. The participant's `SplitPaymentConfirmation` row is created (or, if a
+ *     previous confirmation of this same participant was since reversed,
+ *     reused and un-reversed) recording who confirmed this payment and for
+ *     how much, in the same transaction as the settlement itself.
+ *
+ * Any failure at any step rolls the whole transaction back, so the
+ * participant's status, the group's balance, and the audit trail are all
+ * left exactly as they were.
+ *
+ * @param input.groupId - the split group whose participant is being
+ *   confirmed.
+ * @param input.participantId - the participant being marked paid; must
+ *   belong to `groupId`.
+ * @param input.userId - the id of the authenticated user making the
+ *   request; must match the split group's owner.
+ * @returns the updated split group, with its participants and payment
+ *   confirmations attached.
+ * @throws {NotFoundError} when the split group, or a participant belonging
+ *   to it, does not exist.
+ * @throws {ForbiddenError} when `userId` does not own the split group.
+ */
+export const confirmParticipantPayment = async (
+  input: SplitPaymentParticipantActionInput
+): Promise<InstanceType<typeof SplitGroup>> => {
+  const transaction: Transaction = await sequelize.transaction();
+
+  try {
+    const { splitGroup, participant } = await lockOwnedGroupAndParticipant(
+      input,
+      transaction
+    );
+
+    if (participant.status !== ParticipantStatus.PAID) {
+      participant.status = ParticipantStatus.PAID;
+      await participant.save({ transaction });
+
+      splitGroup.remaining_balance -= participant.owed_amount;
+
+      if (Math.abs(splitGroup.remaining_balance) <= BALANCE_EPSILON) {
+        splitGroup.remaining_balance = 0;
+        splitGroup.is_finalized = true;
+        splitGroup.payment_confirmed_at = new Date();
+      }
+
+      await splitGroup.save({ transaction });
+
+      const existingConfirmation = await SplitPaymentConfirmation.findOne({
+        where: { split_participant_id: participant.id },
+        transaction,
+      });
+
+      if (existingConfirmation) {
+        existingConfirmation.confirmed_by_user_id = input.userId;
+        existingConfirmation.amount_confirmed = participant.owed_amount;
+        existingConfirmation.reversed_at = null;
+        existingConfirmation.reversed_by_user_id = null;
+        await existingConfirmation.save({ transaction });
+      } else {
+        await SplitPaymentConfirmation.create(
+          {
+            split_group_id: splitGroup.id,
+            split_participant_id: participant.id,
+            confirmed_by_user_id: input.userId,
+            amount_confirmed: participant.owed_amount,
+          },
+          { transaction }
+        );
+      }
+    }
+
+    await transaction.commit();
+
+    return (await loadGroupForResponse(splitGroup.id))!;
+  } catch (error) {
+    await transaction.rollback();
+    throw error;
+  }
+};
+
+/**
+ * @description Atomically reverse a mistaken payment confirmation: restore
+ * the participant to pending, add their `owed_amount` back to the group's
+ * `remaining_balance`, and un-finalize the group if reversing this payment
+ * means it's no longer fully settled.
+ *
+ * Mirrors `confirmParticipantPayment`'s own locking and ownership checks
+ * exactly (see its documentation), so the same guarantee holds here too: a
+ * concurrent reversal or confirmation for a different participant of the
+ * same group serializes rather than racing.
+ *
+ * If the participant is not currently marked paid - never confirmed, or
+ * already reversed - this call is a no-op, and the group's current state
+ * is returned as it stood; reversing something that was never paid has
+ * nothing to undo.
+ *
+ * @param input.groupId - the split group whose participant's payment is
+ *   being reversed.
+ * @param input.participantId - the participant being marked unpaid again;
+ *   must belong to `groupId`.
+ * @param input.userId - the id of the authenticated user making the
+ *   request; must match the split group's owner.
+ * @returns the updated split group, with its participants and payment
+ *   confirmations attached.
+ * @throws {NotFoundError} when the split group, or a participant belonging
+ *   to it, does not exist.
+ * @throws {ForbiddenError} when `userId` does not own the split group.
+ */
+export const reverseParticipantPayment = async (
+  input: SplitPaymentParticipantActionInput
+): Promise<InstanceType<typeof SplitGroup>> => {
+  const transaction: Transaction = await sequelize.transaction();
+
+  try {
+    const { splitGroup, participant } = await lockOwnedGroupAndParticipant(
+      input,
+      transaction
+    );
+
+    if (participant.status === ParticipantStatus.PAID) {
+      participant.status = ParticipantStatus.PENDING;
+      await participant.save({ transaction });
+
+      splitGroup.remaining_balance += participant.owed_amount;
+      splitGroup.is_finalized = false;
+      splitGroup.payment_confirmed_at = null;
+      await splitGroup.save({ transaction });
+
+      const confirmation = await SplitPaymentConfirmation.findOne({
+        where: { split_participant_id: participant.id },
+        transaction,
+      });
+
+      if (confirmation) {
+        confirmation.reversed_at = new Date();
+        confirmation.reversed_by_user_id = input.userId;
+        await confirmation.save({ transaction });
+      }
+    }
+
+    await transaction.commit();
+
+    return (await loadGroupForResponse(splitGroup.id))!;
+  } catch (error) {
+    await transaction.rollback();
+    throw error;
+  }
+};
