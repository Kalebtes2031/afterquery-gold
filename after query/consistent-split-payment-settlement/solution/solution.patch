+++ b/rateeat_backend/src/types/split-payment.types.ts
@@ -0,0 +1,14 @@
+/**
+ * Shared shapes for the manual split-payment-settlement feature (PUT and
+ * DELETE /api/v1/split-group/:groupId/member/:participantId/payment). Kept
+ * separate from the service module so the contract is visible without
+ * reading the implementation.
+ */
+
+/** Input to both the confirm- and reverse-payment service calls. */
+export interface SplitPaymentParticipantActionInput {
+  groupId: string;
+  participantId: string;
+  /** The id of the authenticated user; must own the split group. */
+  userId: string;
+}