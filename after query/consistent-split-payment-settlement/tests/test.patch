+import jwt from "jsonwebtoken";
+import { randomUUID } from "crypto";
+import { Pool } from "pg";
+
+/**
+ * Shared fixtures for the black-box PUT/DELETE
+ * /api/v1/split-group/:groupId/member/:participantId/payment tests.
+ *
+ * Nothing here imports a single line of application source. The held-out
+ * suite that uses this file runs in a process that never loads the
+ * repository's own `app`, routes, controllers, services, or Sequelize
+ * models (see tests/test.sh) - it only makes real HTTP requests to a
+ * separately-running instance of the real app, and reaches the database
+ * directly over this same raw `pg` connection to arrange fixtures and
+ * verify persisted state. That process-level separation, not just file
+ * permissions, is what keeps a submitted solution's own code from ever
+ * running inside the same process that decides whether its tests passed:
+ * there is no `import app` left anywhere for it to run from.
+ *
+ * Table/column names below match the base repository's own pre-existing
+ * schema (roles, users, split_groups, split_participants) - none of it is
+ * introduced by, or specific to, the reference solution.
+ */
+
+export enum ParticipantStatus {
+  PENDING = "PENDING",
+  PAID = "PAID",
+}
+
+const randomSuffix = () => Math.random().toString(36).slice(2, 10);
+
+export const createPool = () =>
+  new Pool({
+    host: process.env.DEVELOPMENT_PG_HOST,
+    port: Number(process.env.DEVELOPMENT_PG_PORT || 5432),
+    user: process.env.DEVELOPMENT_PG_USER,
+    password: process.env.DEVELOPMENT_PG_PASSWORD,
+    database: process.env.DEVELOPMENT_PG_DATABASE,
+  });
+
+// A single pool for this file's own fixture reads/writes - separate from
+// whatever pool a test file creates (via createPool, above) to manage the
+// atomicity-forcing trigger's lifecycle itself.
+const fixturePool = createPool();
+
+export const signToken = (id: string): string =>
+  jwt.sign({ id }, process.env.JWT_SECRET || "");
+
+/**
+ * Create a real user and a bearer token for it. `protectRoute` resolves this
+ * token straight to the user row via `User.findByPk` - a plain
+ * `{ id: <uuid> }` JWT payload is all that contract requires.
+ */
+export const createOwner = async (): Promise<{
+  userId: string;
+  token: string;
+}> => {
+  let roleId: string | undefined = (
+    await fixturePool.query(`SELECT id FROM roles WHERE name = $1 LIMIT 1`, [
+      "user",
+    ])
+  ).rows[0]?.id;
+
+  if (!roleId) {
+    roleId = randomUUID();
+    await fixturePool.query(
+      `INSERT INTO roles (id, name, "createdAt", "updatedAt")
+       VALUES ($1, $2, NOW(), NOW())`,
+      [roleId, "user"]
+    );
+  }
+
+  const suffix = randomSuffix();
+  const userId = randomUUID();
+  await fixturePool.query(
+    `INSERT INTO users
+       (id, role_id, username, email, first_name, last_name, "createdAt", "updatedAt")
+     VALUES ($1, $2, $3, $4, $5, $6, NOW(), NOW())`,
+    [
+      userId,
+      roleId,
+      `split_owner_${suffix}`,
+      `split_owner_${suffix}@example.com`,
+      "Split",
+      "Owner",
+    ]
+  );
+
+  return { userId, token: signToken(userId) };
+};
+
+export interface CreateSplitGroupOptions {
+  ownerId: string;
+  totalAmount: number;
+}
+
+/**
+ * Create a real split group directly in the database, owned by the given
+ * user, with its whole `total_amount` still outstanding. Bypasses
+ * `POST /api/v1/split-group` (which, through its current mount, never
+ * actually receives a `restaurantId` to attach) so fixtures aren't coupled
+ * to that route's own, unrelated behavior.
+ */
+export const createSplitGroup = async (
+  options: CreateSplitGroupOptions
+): Promise<{ id: string }> => {
+  const id = randomUUID();
+  await fixturePool.query(
+    `INSERT INTO split_groups
+       (id, user_id, split_type, remaining_balance, total_amount, is_finalized, "createdAt", "updatedAt")
+     VALUES ($1, $2, 'equal', $3, $3, false, NOW(), NOW())`,
+    [id, options.ownerId, options.totalAmount]
+  );
+  return { id };
+};
+
+export interface CreateParticipantOptions {
+  splitGroupId: string;
+  owedAmount: number;
+  status?: ParticipantStatus;
+}
+
+/**
+ * Create a real participant on a split group, owing the given amount.
+ */
+export const createParticipant = async (
+  options: CreateParticipantOptions
+): Promise<{ id: string }> => {
+  const id = randomUUID();
+  await fixturePool.query(
+    `INSERT INTO split_participants
+       (id, split_group_id, username, owed_amount, status, is_owner, "createdAt", "updatedAt")
+     VALUES ($1, $2, $3, $4, $5, false, NOW(), NOW())`,
+    [
+      id,
+      options.splitGroupId,
+      `Participant ${randomSuffix()}`,
+      options.owedAmount,
+      options.status ?? ParticipantStatus.PENDING,
+    ]
+  );
+  return { id };
+};
+
+/**
+ * Read a participant's persisted status directly, independent of anything
+ * a response body claims.
+ */
+export const fetchParticipant = async (
+  participantId: string
+): Promise<{ status: string } | null> => {
+  const { rows } = await fixturePool.query(
+    `SELECT status FROM split_participants WHERE id = $1`,
+    [participantId]
+  );
+  return rows[0] ?? null;
+};
+
+/**
+ * Read a split group's persisted balance/finalization state directly,
+ * independent of anything a response body claims.
+ */
+export const fetchGroup = async (
+  groupId: string
+): Promise<{
+  remaining_balance: number;
+  is_finalized: boolean;
+  payment_confirmed_at: Date | null;
+} | null> => {
+  const { rows } = await fixturePool.query(
+    `SELECT remaining_balance, is_finalized, payment_confirmed_at
+     FROM split_groups WHERE id = $1`,
+    [groupId]
+  );
+  return rows[0] ?? null;
+};
+
+/**
+ * Force a split group directly into an already-paid/already-finalized
+ * starting state, bypassing the endpoint under test entirely - used only to
+ * arrange a scenario (e.g. a reversal test that needs a pre-existing paid
+ * participant on a finalized group), never to assert anything.
+ */
+export const updateSplitGroup = async (
+  groupId: string,
+  fields: Partial<{
+    remaining_balance: number;
+    is_finalized: boolean;
+    payment_confirmed_at: Date;
+  }>
+): Promise<void> => {
+  const keys = Object.keys(fields) as (keyof typeof fields)[];
+  if (keys.length === 0) {
+    return;
+  }
+  const setClause = keys.map((key, i) => `${key} = $${i + 2}`).join(", ");
+  await fixturePool.query(
+    `UPDATE split_groups SET ${setClause} WHERE id = $1`,
+    [groupId, ...keys.map((key) => (fields as Record<string, unknown>)[key])]
+  );
+};
+
+// --- Raw-SQL helpers for forcing a genuine database-level write failure ---
+// These exist purely to prove atomicity from the outside: they never touch
+// the feature's implementation, only the split_groups table itself.
+
+// Fires on UPDATE to split_groups - the settlement's own write always
+// updates this table (recording the deducted balance, and possibly
+// finalizing), regardless of how a given implementation is structured, so
+// forcing failure here proves the whole transaction - including whatever
+// it already did to the participant's own row - rolls back together.
+export const installFailingSplitGroupWriteTrigger = async (pool: Pool) => {
+  await pool.query(`
+    CREATE OR REPLACE FUNCTION split_test_fail_group_write()
+    RETURNS trigger AS $$
+    BEGIN
+      RAISE EXCEPTION 'split payment test forced split_groups write failure';
+    END;
+    $$ LANGUAGE plpgsql;
+  `);
+
+  await pool.query(`
+    DROP TRIGGER IF EXISTS split_test_fail_group_write_trigger
+    ON split_groups;
+  `);
+
+  await pool.query(`
+    CREATE TRIGGER split_test_fail_group_write_trigger
+    BEFORE UPDATE ON split_groups
+    FOR EACH ROW
+    EXECUTE FUNCTION split_test_fail_group_write();
+  `);
+};
+
+export const removeFailingSplitGroupWriteTrigger = async (pool: Pool) => {
+  await pool.query(`
+    DROP TRIGGER IF EXISTS split_test_fail_group_write_trigger
+    ON split_groups;
+  `);
+  await pool.query(`
+    DROP FUNCTION IF EXISTS split_test_fail_group_write();
+  `);
+};
