+import request from "supertest";
+import {
+  ParticipantStatus,
+  createOwner,
+  createParticipant,
+  createSplitGroup,
+  fetchParticipant,
+} from "./split_payment_test_support";
+
+// Every request in this file goes over a real socket to a separately-running
+// instance of the real app (see tests/test.sh) - never through an in-process
+// `import app`. That's what keeps a submitted solution's own code from ever
+// sharing a process with whatever decides these tests' outcome.
+const BASE_URL = process.env.SPLIT_TEST_BASE_URL || "http://127.0.0.1:4600";
+
+describe("PUT /api/v1/split-group/:groupId/member/:participantId/payment", () => {
+  let owner: { userId: string; token: string };
+  let otherUser: { userId: string; token: string };
+
+  const confirmPayment = (
+    groupId: string,
+    participantId: string,
+    token: string
+  ) =>
+    request(BASE_URL)
+      .put(`/api/v1/split-group/${groupId}/member/${participantId}/payment`)
+      .set("Authorization", `Bearer ${token}`)
+      .send();
+
+  const reversePayment = (
+    groupId: string,
+    participantId: string,
+    token: string
+  ) =>
+    request(BASE_URL)
+      .delete(`/api/v1/split-group/${groupId}/member/${participantId}/payment`)
+      .set("Authorization", `Bearer ${token}`)
+      .send();
+
+  beforeAll(async () => {
+    owner = await createOwner();
+    otherUser = await createOwner();
+  });
+
+  describe("group and participant eligibility", () => {
+    it("returns 404 with 'Split Group not found' for a group id that doesn't exist", async () => {
+      const res = await confirmPayment(
+        "00000000-0000-4000-8000-000000000000",
+        "00000000-0000-4000-8000-000000000001",
+        owner.token
+      );
+
+      expect(res.status).toBe(404);
+      expect(res.body).toMatchObject({
+        success: false,
+        message: "Split Group not found",
+      });
+    });
+
+    it("returns 401 when no auth token is provided", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const participant = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 100,
+      });
+
+      const res = await request(BASE_URL)
+        .put(`/api/v1/split-group/${group.id}/member/${participant.id}/payment`)
+        .send();
+
+      expect(res.status).toBe(401);
+    });
+
+    it("returns 403 when the requester is not the group's owner", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const participant = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 100,
+      });
+
+      const res = await confirmPayment(
+        group.id,
+        participant.id,
+        otherUser.token
+      );
+
+      expect(res.status).toBe(403);
+
+      const persisted = await fetchParticipant(participant.id);
+      expect(persisted!.status).toBe(ParticipantStatus.PENDING);
+    });
+
+    it("returns 404 with 'Participant not found' for a participant id that doesn't exist", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+
+      const res = await confirmPayment(
+        group.id,
+        "00000000-0000-4000-8000-000000000002",
+        owner.token
+      );
+
+      expect(res.status).toBe(404);
+      expect(res.body).toMatchObject({
+        success: false,
+        message: "Participant not found",
+      });
+    });
+
+    it("returns 404 with 'Participant not found' when the participant belongs to a different split group", async () => {
+      const groupA = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const groupB = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 50,
+      });
+      const participantOfB = await createParticipant({
+        splitGroupId: groupB.id,
+        owedAmount: 50,
+      });
+
+      const res = await confirmPayment(
+        groupA.id,
+        participantOfB.id,
+        owner.token
+      );
+
+      expect(res.status).toBe(404);
+      expect(res.body).toMatchObject({
+        success: false,
+        message: "Participant not found",
+      });
+
+      const persisted = await fetchParticipant(participantOfB.id);
+      expect(persisted!.status).toBe(ParticipantStatus.PENDING);
+    });
+  });
+
+  describe("successful settlement", () => {
+    it("marks the participant paid and deducts their owed amount from the group's remaining balance", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const paying = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+      await createParticipant({ splitGroupId: group.id, owedAmount: 60 });
+
+      const res = await confirmPayment(group.id, paying.id, owner.token);
+
+      expect(res.status).toBe(200);
+      expect(res.body.success).toBe(true);
+      expect(res.body.data.remaining_balance).toBe(60);
+
+      const persisted = await fetchParticipant(paying.id);
+      expect(persisted!.status).toBe(ParticipantStatus.PAID);
+    });
+
+    it("does not finalize the group while other participants remain unpaid", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const paying = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+      await createParticipant({ splitGroupId: group.id, owedAmount: 60 });
+
+      const res = await confirmPayment(group.id, paying.id, owner.token);
+
+      expect(res.body.data.is_finalized).toBe(false);
+      expect(res.body.data.payment_confirmed_at).toBeFalsy();
+    });
+
+    it("finalizes the group exactly when the last participant's payment brings the balance to zero", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const first = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+      const last = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 60,
+      });
+
+      const firstRes = await confirmPayment(group.id, first.id, owner.token);
+      expect(firstRes.body.data.is_finalized).toBe(false);
+
+      const lastRes = await confirmPayment(group.id, last.id, owner.token);
+
+      expect(lastRes.status).toBe(200);
+      expect(lastRes.body.data.remaining_balance).toBe(0);
+      expect(lastRes.body.data.is_finalized).toBe(true);
+      expect(lastRes.body.data.payment_confirmed_at).toBeTruthy();
+    });
+
+    it("finalizes a single-participant group on its only payment", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 75,
+      });
+      const onlyParticipant = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 75,
+      });
+
+      const res = await confirmPayment(
+        group.id,
+        onlyParticipant.id,
+        owner.token
+      );
+
+      expect(res.status).toBe(200);
+      expect(res.body.data.remaining_balance).toBe(0);
+      expect(res.body.data.is_finalized).toBe(true);
+    });
+
+    it("settles a total that does not divide evenly among participants, still finalizing once every participant has paid", async () => {
+      // 100 split three ways leaves 33.333... per participant - repeated
+      // subtraction of that from 100 does not land on exactly 0 in
+      // floating-point arithmetic. An implementation that only finalizes on
+      // an exact-equality check against 0 would leave this group stuck
+      // unfinalized forever, even though everyone has genuinely paid.
+      const owedShare = 100 / 3;
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: owedShare * 3,
+      });
+      const participants = await Promise.all([
+        createParticipant({ splitGroupId: group.id, owedAmount: owedShare }),
+        createParticipant({ splitGroupId: group.id, owedAmount: owedShare }),
+        createParticipant({ splitGroupId: group.id, owedAmount: owedShare }),
+      ]);
+
+      let finalRes;
+      for (const participant of participants) {
+        finalRes = await confirmPayment(group.id, participant.id, owner.token);
+      }
+
+      expect(finalRes.status).toBe(200);
+      expect(finalRes.body.data.remaining_balance).toBe(0);
+      expect(finalRes.body.data.is_finalized).toBe(true);
+    });
+
+    it("returns the updated split group with its participants in the response data", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const paying = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 100,
+      });
+
+      const res = await confirmPayment(group.id, paying.id, owner.token);
+
+      expect(res.body.data.id).toBe(group.id);
+      expect(Array.isArray(res.body.data.participants)).toBe(true);
+      const participantInResponse = res.body.data.participants.find(
+        (p: any) => p.id === paying.id
+      );
+      expect(participantInResponse).toMatchObject({
+        id: paying.id,
+        status: ParticipantStatus.PAID,
+      });
+    });
+
+    it("keeps every other participant's status untouched when confirming one participant's payment", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const paying = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+      const untouched = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 60,
+      });
+
+      const res = await confirmPayment(group.id, paying.id, owner.token);
+      expect(res.status).toBe(200);
+
+      const persistedPaying = await fetchParticipant(paying.id);
+      expect(persistedPaying!.status).toBe(ParticipantStatus.PAID);
+
+      const persisted = await fetchParticipant(untouched.id);
+      expect(persisted!.status).toBe(ParticipantStatus.PENDING);
+    });
+
+    it("records a payment confirmation naming the confirming user and the amount owed", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const paying = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+
+      const res = await confirmPayment(group.id, paying.id, owner.token);
+
+      expect(Array.isArray(res.body.data.payment_confirmations)).toBe(true);
+      const confirmation = res.body.data.payment_confirmations.find(
+        (c: any) => c.split_participant_id === paying.id
+      );
+      expect(confirmation).toMatchObject({
+        split_participant_id: paying.id,
+        confirmed_by_user_id: owner.userId,
+        amount_confirmed: 40,
+      });
+    });
+  });
+
+  describe("idempotency of an already-paid participant", () => {
+    it("confirming an already-paid participant a second time leaves the balance and finalized state unchanged", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const paying = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+      await createParticipant({ splitGroupId: group.id, owedAmount: 60 });
+
+      const first = await confirmPayment(group.id, paying.id, owner.token);
+      expect(first.body.data.remaining_balance).toBe(60);
+
+      const second = await confirmPayment(group.id, paying.id, owner.token);
+
+      expect(second.status).toBe(200);
+      expect(second.body.data.remaining_balance).toBe(60);
+      expect(second.body.data.is_finalized).toBe(false);
+
+      // Exactly one audit entry for this participant, not one per call.
+      const confirmationsForPaying =
+        second.body.data.payment_confirmations.filter(
+          (c: any) => c.split_participant_id === paying.id
+        );
+      expect(confirmationsForPaying).toHaveLength(1);
+    });
+
+    it("is a no-op for a participant that was already paid before this endpoint was ever called", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const alreadyPaid = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+        status: ParticipantStatus.PAID,
+      });
+      await createParticipant({ splitGroupId: group.id, owedAmount: 60 });
+
+      const res = await confirmPayment(group.id, alreadyPaid.id, owner.token);
+
+      expect(res.status).toBe(200);
+      // remaining_balance still reflects the full, untouched 100 - the
+      // participant's pre-existing PAID status was never accounted for by
+      // this call, so it must not be deducted a first time either.
+      expect(res.body.data.remaining_balance).toBe(100);
+      expect(res.body.data.is_finalized).toBe(false);
+
+      // Never having gone through this endpoint's paying branch, this
+      // participant must have no audit entry at all.
+      const confirmationsForParticipant =
+        res.body.data.payment_confirmations.filter(
+          (c: any) => c.split_participant_id === alreadyPaid.id
+        );
+      expect(confirmationsForParticipant).toHaveLength(0);
+    });
+  });
+});
