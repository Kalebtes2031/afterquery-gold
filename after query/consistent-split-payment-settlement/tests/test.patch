+import request from "supertest";
+import { Pool } from "pg";
+import {
+  ParticipantStatus,
+  createOwner,
+  createParticipant,
+  createPool,
+  createSplitGroup,
+  fetchGroup,
+  fetchParticipant,
+  installFailingSplitGroupWriteTrigger,
+  removeFailingSplitGroupWriteTrigger,
+  updateSplitGroup,
+} from "./split_payment_test_support";
+
+// Every request in this file goes over a real socket to a separately-running
+// instance of the real app (see tests/test.sh) - never through an in-process
+// `import app`. That's what keeps a submitted solution's own code from ever
+// sharing a process with whatever decides these tests' outcome.
+const BASE_URL = process.env.SPLIT_TEST_BASE_URL || "http://127.0.0.1:4600";
+
+describe("PUT /api/v1/split-group/:groupId/member/:participantId/payment transactional behavior", () => {
+  let owner: { userId: string; token: string };
+  let pool: Pool;
+
+  const confirmPayment = (groupId: string, participantId: string) =>
+    request(BASE_URL)
+      .put(`/api/v1/split-group/${groupId}/member/${participantId}/payment`)
+      .set("Authorization", `Bearer ${owner.token}`)
+      .send();
+
+  const reversePayment = (groupId: string, participantId: string) =>
+    request(BASE_URL)
+      .delete(`/api/v1/split-group/${groupId}/member/${participantId}/payment`)
+      .set("Authorization", `Bearer ${owner.token}`)
+      .send();
+
+  beforeAll(async () => {
+    pool = createPool();
+    owner = await createOwner();
+  });
+
+  afterAll(async () => {
+    await pool.end();
+  });
+
+  describe("atomicity", () => {
+    it("rolls back and leaves the participant's status and the group's balance untouched when the write fails", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const participant = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+
+      await installFailingSplitGroupWriteTrigger(pool);
+
+      let res;
+      try {
+        res = await confirmPayment(group.id, participant.id);
+      } finally {
+        await removeFailingSplitGroupWriteTrigger(pool);
+      }
+
+      expect(res.status).toBe(500);
+
+      const persistedGroup = await fetchGroup(group.id);
+      expect(persistedGroup!.remaining_balance).toBe(100);
+      expect(persistedGroup!.is_finalized).toBe(false);
+
+      // The participant's own row-level update happens earlier in the same
+      // transaction as the group write the trigger fails - a correct
+      // implementation must roll that back too, not just the group.
+      const persistedParticipant = await fetchParticipant(participant.id);
+      expect(persistedParticipant!.status).toBe(ParticipantStatus.PENDING);
+    });
+
+    it("leaves the participant retryable after a failed write, and a subsequent confirmation succeeds", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const participant = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 100,
+      });
+
+      await installFailingSplitGroupWriteTrigger(pool);
+      let failedRes;
+      try {
+        failedRes = await confirmPayment(group.id, participant.id);
+      } finally {
+        await removeFailingSplitGroupWriteTrigger(pool);
+      }
+      expect(failedRes.status).toBe(500);
+
+      const retryRes = await confirmPayment(group.id, participant.id);
+
+      expect(retryRes.status).toBe(200);
+      expect(retryRes.body.data.remaining_balance).toBe(0);
+      expect(retryRes.body.data.is_finalized).toBe(true);
+
+      // The failed attempt must not have left behind a confirmation record
+      // that blocks (or duplicates) this one: exactly one entry for this
+      // participant, not zero and not two.
+      const confirmationsForParticipant =
+        retryRes.body.data.payment_confirmations.filter(
+          (c: any) => c.split_participant_id === participant.id
+        );
+      expect(confirmationsForParticipant).toHaveLength(1);
+    });
+  });
+
+  describe("concurrency", () => {
+    it("serializes concurrent confirmations for different participants so the final balance reflects both payments exactly once", async () => {
+      const group = await createSplitGroup({
+        ownerId: owner.userId,
+        totalAmount: 100,
+      });
+      const participantA = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 40,
+      });
+      const participantB = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 60,
+      });
+
+      const [resA, resB] = await Promise.all([
+        confirmPayment(group.id, participantA.id),
+        confirmPayment(group.id, participantB.id),
+      ]);
+
+      expect(resA.status).toBe(200);
+      expect(resB.status).toBe(200);
+
+      // If the two confirmations both read remaining_balance before either
+      // wrote it back, the loser's write would overwrite the winner's -
+      // classic lost update - leaving the balance at 40 or 60 instead of 0.
+      const finalGroup = await fetchGroup(group.id);
+      expect(finalGroup!.remaining_balance).toBe(0);
+      expect(finalGroup!.is_finalized).toBe(true);
