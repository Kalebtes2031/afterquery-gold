+        ownerId: owner.userId,
+        totalAmount: 150,
+      });
+      const already = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 50,
+      });
+      await confirmPayment(group.id, already.id);
+
+      const participantB = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 50,
+      });
+      const participantC = await createParticipant({
+        splitGroupId: group.id,
+        owedAmount: 50,
+      });
+
+      const [resB, resC] = await Promise.all([
+        confirmPayment(group.id, participantB.id),
+        confirmPayment(group.id, participantC.id),
+      ]);
+
+      expect(resB.status).toBe(200);
+      expect(resC.status).toBe(200);
+
+      const finalGroup = await fetchGroup(group.id);
+      expect(finalGroup!.remaining_balance).toBe(0);
+      expect(finalGroup!.is_finalized).toBe(true);
+
+      // Exactly one of the two responses should have been the one that
+      // observed the group actually flip to finalized - not both (which
+      // would suggest each ran against its own stale, pre-lock snapshot),
+      // and not neither.
+      const finalizedResponses = [resB, resC].filter(
+        (r) => r.body.data.is_finalized === true
