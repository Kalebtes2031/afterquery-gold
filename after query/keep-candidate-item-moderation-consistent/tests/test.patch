+import express from "express";
+import request from "supertest";
+
+import candidateItemRouter from "../../routes/candidate_item.route";
+
+describe("candidate item batch moderation authorization", () => {
+  const app = express();
+
+  app.use(express.json());
+  app.use("/api/v1/candidate-items", candidateItemRouter);
+
+  it("requires admin authorization for batch moderation", async () => {
+    const response = await request(app)
+      .put("/api/v1/candidate-items/moderate-batch")
+      .send({
+        items: [
+          {
+            id: "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa6",
+            isApproved: true,
+          },
+        ],
+      });
+
+    expect(response.status).toBe(401);
+    expect(response.body).toEqual({
+      error: "Not authorized to access this route",
+    });
+  });
+});
