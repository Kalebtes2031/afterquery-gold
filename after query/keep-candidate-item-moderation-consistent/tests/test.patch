+const responseFor = () => {
+  const response: any = {
+    statusCode: 200,
+    body: undefined,
+  };
+
+  response.status = jest.fn((statusCode: number) => {
+    response.statusCode = statusCode;
+    return response;
+  });
+
+  response.json = jest.fn((body: unknown) => {
+    response.body = JSON.parse(JSON.stringify(body));
+    return response;
+  });
+
+  return response as Response & {
+    statusCode: number;
+    body: any;
+  };
+};
+
+const executeModeration = async (
+  isApproved: boolean | string,
+  mediaImages?: Array<{
+    highQualityImg: string;
+    mediumQualityImg?: string;
+    lowQualityImg?: string;
+  }>,
+  mediaVideos?: string[],
+  bodyOverrides: Record<string, unknown> = {},
+  itemId: string = ITEM_ID
+) => {
+  const res = responseFor();
+  let forwardedError: any;
+
+  const next = ((error?: unknown) => {
+    forwardedError = error;
+  }) as NextFunction;
+
+  await manageCandidateItem(
+    {
+      params: { id: itemId },
+      body: { ...bodyOverrides, isApproved },
+      user: { id: "dddddddd-dddd-4ddd-8ddd-dddddddddddd" },
+      mediaImages,
+      mediaVideos,
+    } as any,
+    res,
+    next
+  );
+
+  return { res, error: forwardedError };
+};
+
+const removeFailingIncentiveTrigger = async () => {
+  const sequelize = await Database.getInstance();
+  await sequelize.query(
+    `DROP TRIGGER IF EXISTS ${FAIL_TRIGGER} ON incentives;`
+  );
+  await sequelize.query(`DROP FUNCTION IF EXISTS ${FAIL_FUNCTION}();`);
+};
+
+const installFailingIncentiveTrigger = async () => {
+  const sequelize = await Database.getInstance();
+
+  await removeFailingIncentiveTrigger();
+  await sequelize.query(`
+    CREATE FUNCTION ${FAIL_FUNCTION}()
+    RETURNS trigger AS $$
+    BEGIN
+      IF NEW.user_id = '${USER_ID}'::uuid THEN
+        RAISE EXCEPTION 'forced candidate incentive write failure';
+      END IF;
+      RETURN NEW;
+    END;
+    $$ LANGUAGE plpgsql;
+  `);
+  await sequelize.query(`
+    CREATE TRIGGER ${FAIL_TRIGGER}
+    BEFORE INSERT OR UPDATE ON incentives
+    FOR EACH ROW
+    EXECUTE FUNCTION ${FAIL_FUNCTION}();
+  `);
+};
