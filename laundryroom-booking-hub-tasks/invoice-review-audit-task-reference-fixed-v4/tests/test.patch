diff --git a/src/__tests__/toast-reducer-regression.test.ts b/src/__tests__/toast-reducer-regression.test.ts
new file mode 100644
index 0000000..17fbc63
--- /dev/null
+++ b/src/__tests__/toast-reducer-regression.test.ts
@@ -0,0 +1,62 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { reducer } from "@/hooks/use-toast";
+
+const toast = (id: string, title = `Toast ${id}`) => ({ id, title, open: true });
+
+describe("Toast reducer regression", () => {
+  afterEach(() => vi.useRealTimers());
+
+  it("adds a toast to an empty state", () => {
+    expect(reducer({ toasts: [] }, { type: "ADD_TOAST", toast: toast("1") } as any).toasts).toHaveLength(1);
+  });
+
+  it("puts the newest toast first", () => {
+    const state = { toasts: [toast("1")] };
+    const next = reducer(state as any, { type: "ADD_TOAST", toast: toast("2") } as any);
+    expect(next.toasts[0].id).toBe("2");
+  });
+
+  it("enforces the single-toast limit", () => {
+    const state = { toasts: [toast("1")] };
+    const next = reducer(state as any, { type: "ADD_TOAST", toast: toast("2") } as any);
+    expect(next.toasts.map((entry: any) => entry.id)).toEqual(["2"]);
+  });
+
+  it("updates the matching toast", () => {
+    const state = { toasts: [toast("1")] };
+    const next = reducer(state as any, { type: "UPDATE_TOAST", toast: { id: "1", title: "Updated" } } as any);
+    expect(next.toasts[0].title).toBe("Updated");
+  });
+
+  it("leaves a toast unchanged when update id is missing", () => {
+    const state = { toasts: [toast("1")] };
+    const next = reducer(state as any, { type: "UPDATE_TOAST", toast: { id: "other", title: "Updated" } } as any);
+    expect(next.toasts[0].title).toBe("Toast 1");
+  });
+
+  it("dismisses one matching toast by closing it", () => {
+    vi.useFakeTimers();
+    const state = { toasts: [toast("1")] };
+    const next = reducer(state as any, { type: "DISMISS_TOAST", toastId: "1" } as any);
+    expect(next.toasts[0].open).toBe(false);
+  });
+
+  it("dismiss all closes every toast in state", () => {
+    vi.useFakeTimers();
+    const state = { toasts: [toast("1"), toast("2")] };
+    const next = reducer(state as any, { type: "DISMISS_TOAST" } as any);
+    expect(next.toasts.every((entry: any) => entry.open === false)).toBe(true);
+  });
+
+  it("remove by id deletes only the matching toast", () => {
+    const state = { toasts: [toast("1"), toast("2")] };
+    const next = reducer(state as any, { type: "REMOVE_TOAST", toastId: "1" } as any);
+    expect(next.toasts.map((entry: any) => entry.id)).toEqual(["2"]);
+  });
+
+  it("remove without an id clears all toasts", () => {
+    const state = { toasts: [toast("1"), toast("2")] };
+    const next = reducer(state as any, { type: "REMOVE_TOAST" } as any);
+    expect(next.toasts).toEqual([]);
+  });
+});
