diff --git a/src/lib/invoice/review/types.ts b/src/lib/invoice/review/types.ts
new file mode 100644
index 0000000..f9f19ca
--- /dev/null
+++ b/src/lib/invoice/review/types.ts
@@ -0,0 +1,171 @@
+export type InvoiceStatus = "pending" | "balance" | "cleared" | "cancelled";
+
+export type InvoiceIssueCode =
+  | "missing_invoice_number"
+  | "missing_customer_name"
+  | "invalid_status"
+  | "invalid_total_bill"
+  | "invalid_paid_amount"
+  | "invalid_balance"
+  | "negative_total_bill"
+  | "negative_paid_amount"
+  | "negative_balance"
+  | "overpayment"
+  | "balance_mismatch"
+  | "status_mismatch"
+  | "payment_log_total_mismatch"
+  | "invalid_payment_log"
+  | "invalid_created_at";
+
+export type InvoiceSortBy =
+  | "invoiceNumber"
+  | "customerName"
+  | "createdAt"
+  | "totalBill"
+  | "paidAmount"
+  | "outstanding"
+  | "status";
+
+export type SortDirection = "asc" | "desc";
+
+export interface RawPaymentLog {
+  amount?: unknown;
+  createdAt?: unknown;
+  createdBy?: unknown;
+  createdByUsername?: unknown;
+}
+
+export interface RawInvoiceReviewRecord {
+  id?: unknown;
+  invoiceNumber?: unknown;
+  laundryId?: unknown;
+  customerId?: unknown;
+  customerName?: unknown;
+  mainServiceName?: unknown;
+  branchId?: unknown;
+  status?: unknown;
+  totalBill?: unknown;
+  paidAmount?: unknown;
+  balance?: unknown;
+  createdAt?: unknown;
+  paymentLogs?: unknown;
+}
+
+export interface NormalizedPaymentLog {
+  amount: number | null;
+  createdAt: string | null;
+  createdBy: string;
+  createdByUsername: string;
+  valid: boolean;
+}
+
+export interface InvoiceReviewRecord {
+  id: string;
+  invoiceNumber: string;
+  laundryId: string;
+  customerId: string;
+  customerName: string;
+  mainServiceName: string;
+  branchId: string;
+  status: InvoiceStatus | null;
+  totalBill: number | null;
+  paidAmount: number | null;
+  balance: number | null;
+  expectedBalance: number | null;
+  expectedStatus: InvoiceStatus | null;
+  paymentLogTotal: number;
+  createdAt: string | null;
+  paymentLogs: NormalizedPaymentLog[];
+  issues: InvoiceIssueCode[];
+  hasIssues: boolean;
+  outstanding: number | null;
+}
+
+export interface InvoiceReviewNormalizationResult {
+  records: InvoiceReviewRecord[];
+  issueCounts: Record<InvoiceIssueCode, number>;
+}
+
+export interface InvoiceReviewQuery {
+  query?: string;
+  statuses?: InvoiceStatus[];
+  branchIds?: string[];
+  issueCodes?: InvoiceIssueCode[];
+  hasIssues?: boolean;
+  minimumOutstanding?: number;
+  maximumOutstanding?: number;
+  sortBy?: InvoiceSortBy;
+  sortDirection?: SortDirection;
+  page?: number;
+  pageSize?: number;
+}
+
+export interface InvoiceReviewQueryResult {
+  items: InvoiceReviewRecord[];
+  page: number;
+  pageSize: number;
+  totalItems: number;
+  totalPages: number;
+}
+
+export interface InvoiceStatusSummary {
+  status: InvoiceStatus | "unknown";
+  count: number;
