@@ -0,0 +1,26 @@
+import type { NotificationTemplateValidationCode } from "./types";
+
+export const NOTIFICATION_VALIDATION_MESSAGES: Readonly<
+  Record<NotificationTemplateValidationCode, string>
+> = {
+  EMPTY_TEMPLATE_NAME: "Template name is required",
+  EMPTY_TEMPLATE_KEY: "Template key is required",
+  INVALID_TEMPLATE_KEY: "Template key may contain only lowercase letters, numbers and underscores",
+  EMPTY_TEMPLATE_MESSAGE: "Template message is required",
+  MALFORMED_VARIABLE: "Template contains a malformed variable placeholder",
+  UNKNOWN_VARIABLE: "Template contains an unsupported variable placeholder",
+  DUPLICATE_TEMPLATE_KEY: "Template keys must be unique after normalization",
+  INVALID_VARIABLE_VALUE: "Template variable values must be finite numbers or strings",
+  EMPTY_RECIPIENT_ID: "Recipient id is required",
+  DUPLICATE_RECIPIENT_ID: "Recipient ids must be unique after trimming",
+};
+
+export class NotificationTemplateValidationError extends Error {
+  readonly code: NotificationTemplateValidationCode;
+
+  constructor(code: NotificationTemplateValidationCode, message?: string) {
+    super(message ?? NOTIFICATION_VALIDATION_MESSAGES[code]);
+    this.name = "NotificationTemplateValidationError";
+    this.code = code;
+  }
+}
