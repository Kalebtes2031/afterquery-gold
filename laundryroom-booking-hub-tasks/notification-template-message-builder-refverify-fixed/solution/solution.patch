+++ b/src/lib/notifications/batch.ts
@@ -0,0 +1,73 @@
+import { NotificationTemplateNormalizer } from "./normalizer";
+import { NotificationMessageRenderer } from "./renderer";
+import { NotificationTemplateValidationError } from "./errors";
+import {
+  type NotificationBatchResult,
+  type NotificationBatchSummary,
+  type NotificationRecipientInput,
+  type NotificationTemplateInput,
+} from "./types";
+
+export class NotificationBatchComposer {
+  constructor(
+    private readonly normalizer = new NotificationTemplateNormalizer(),
+    private readonly renderer = new NotificationMessageRenderer(normalizer),
+  ) {}
+
+  compose(
+    templateInput: NotificationTemplateInput,
+    recipients: readonly NotificationRecipientInput[],
+  ): NotificationBatchResult {
+    const template = this.normalizer.normalize(templateInput);
+    const seenRecipients = new Set<string>();
+    const summary = this.emptySummary();
+
+    const messages = recipients.map((recipient) => {
+      const recipientId = String(recipient.recipientId ?? "").trim();
+      if (!recipientId) {
+        throw new NotificationTemplateValidationError("EMPTY_RECIPIENT_ID");
+      }
+      if (seenRecipients.has(recipientId)) {
+        throw new NotificationTemplateValidationError("DUPLICATE_RECIPIENT_ID");
+      }
+      seenRecipients.add(recipientId);
+
+      const rendered = this.renderer.render(template, recipient.values ?? {});
+      summary.total += 1;
+      if (rendered.complete) {
+        summary.complete += 1;
+      } else {
+        summary.incomplete += 1;
+      }
+      rendered.missingVariables.forEach((variable) => {
+        summary.missingByVariable[variable] += 1;
+      });
+
+      return {
+        recipientId,
+        text: rendered.text,
+        complete: rendered.complete,
+        missingVariables: [...rendered.missingVariables],
+      };
+    });
+
+    return {
+      key: template.key,
+      messages,
+      summary,
+    };
+  }
+
+  private emptySummary(): NotificationBatchSummary {
+    return {
+      total: 0,
+      complete: 0,
+      incomplete: 0,
+      missingByVariable: {
+        name: 0,
+        id: 0,
+        link: 0,
+      },
+    };
+  }
+}
