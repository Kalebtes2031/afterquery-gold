diff --git a/tests/notification_message_renderer.test.ts b/tests/notification_message_renderer.test.ts
new file mode 100644
index 0000000..4117f00
--- /dev/null
+++ b/tests/notification_message_renderer.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from "vitest";
+import {
+  NotificationMessageRenderer,
+  NotificationTemplateValidationError,
+  type NotificationTemplateInput,
+} from "@/lib/notifications";
+
+const renderer = new NotificationMessageRenderer();
+const base: NotificationTemplateInput = {
+  id: "t1",
+  name: "Ready",
+  key: "order_ready",
+  message: "Hi {name}, order {id} is ready. {link}",
+};
+
+function codeOf(run: () => unknown): string | undefined {
+  try {
+    run();
+    return undefined;
+  } catch (error) {
+    return error instanceof NotificationTemplateValidationError ? error.code : undefined;
+  }
+}
+
+describe("Notification message rendering", () => {
+  it("renders every supported variable into the message", () => {
+    expect(renderer.render(base, { name: "Dawit", id: "LR-12", link: "https://x.test/12" })).toEqual({
+      key: "order_ready",
+      text: "Hi Dawit, order LR-12 is ready. https://x.test/12",
+      usedVariables: ["name", "id", "link"],
+      missingVariables: [],
+      complete: true,
+      characterCount: 49,
+    });
+  });
+
+  it("replaces every occurrence of a repeated variable", () => {
+    const input = { ...base, message: "{name}-{name}-{id}-{id}" };
+    expect(renderer.render(input, { name: "A", id: "9" }).text).toBe("A-A-9-9");
+  });
+
+  it("collapses whitespace in name values", () => {
+    expect(renderer.render({ ...base, message: "Hi {name}" }, { name: "  Mary   Jane  " }).text).toBe("Hi Mary Jane");
+  });
+
+  it("trims id and link values", () => {
+    const result = renderer.render({ ...base, message: "{id}|{link}" }, { id: "  LR-9 ", link: " https://x.test " });
+    expect(result.text).toBe("LR-9|https://x.test");
+  });
+
+  it("accepts finite numeric variable values", () => {
+    expect(renderer.render({ ...base, message: "Order {id}" }, { id: 42 }).text).toBe("Order 42");
+  });
+
+  it("treats blank variable values as missing and leaves their token unchanged", () => {
+    const result = renderer.render(base, { name: " ", id: "LR-1", link: "" });
+    expect(result.text).toBe("Hi {name}, order LR-1 is ready. {link}");
+    expect(result.missingVariables).toEqual(["name", "link"]);
+  });
+
+  it("keeps used variables in template first-use order", () => {
+    const input = { ...base, message: "{link} {name} {id}" };
+    expect(renderer.render(input, { name: "A", id: "B", link: "C" }).usedVariables).toEqual(["link", "name", "id"]);
+  });
+
+  it("keeps missing variables in template first-use order", () => {
+    const input = { ...base, message: "{link} {name} {id} {link}" };
+    expect(renderer.render(input, { id: "B" }).missingVariables).toEqual(["link", "name"]);
+  });
+
+  it("marks a render incomplete when any required template variable is missing", () => {
+    expect(renderer.render(base, { name: "A", id: "B" }).complete).toBe(false);
+  });
+
+  it("marks literal-only templates complete without values", () => {
+    const result = renderer.render({ ...base, message: "Your laundry is ready." });
+    expect(result).toMatchObject({ usedVariables: [], missingVariables: [], complete: true });
+  });
+
+  it("reports characterCount from the final rendered text", () => {
+    const result = renderer.render({ ...base, message: "Hi {name}!" }, { name: "Ada" });
+    expect(result.characterCount).toBe("Hi Ada!".length);
+  });
+
+  it("returns the normalized template key", () => {
+    expect(renderer.render({ ...base, key: " READY_2 ", message: "Done" }).key).toBe("ready_2");
+  });
+
+  it("rejects non-finite numeric values used by the template", () => {
+    expect(codeOf(() => renderer.render({ ...base, message: "{id}" }, { id: Number.POSITIVE_INFINITY }))).toBe("INVALID_VARIABLE_VALUE");
+  });
+
+  it("rejects non-string non-number values used by the template", () => {
+    expect(codeOf(() => renderer.render({ ...base, message: "{name}" }, { name: { bad: true } as any }))).toBe("INVALID_VARIABLE_VALUE");
+  });
+
+  it("ignores values for variables the template does not use", () => {
+    const result = renderer.render({ ...base, message: "Order {id}" }, { id: "5", name: { ignored: true } as any });
+    expect(result).toMatchObject({ text: "Order 5", complete: true });
+  });
+
+  it("rendering does not mutate the template or values object", () => {
+    const input = { ...base };
+    const values = { name: "  A B ", id: " 2 ", link: " x " };
+    const inputSnapshot = { ...input };
+    const valuesSnapshot = { ...values };
+    renderer.render(input, values);
+    expect(input).toEqual(inputSnapshot);
+    expect(values).toEqual(valuesSnapshot);
+  });
+});
