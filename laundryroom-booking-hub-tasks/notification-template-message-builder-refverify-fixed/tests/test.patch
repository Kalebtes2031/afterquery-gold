+import { describe, expect, it } from "vitest";
+import { cn } from "@/lib/utils";
+
+describe("Existing utility behavior", () => {
+  it("cn returns an empty string when called without classes", () => {
+    expect(cn()).toBe("");
+  });
+
+  it("cn keeps a single class", () => {
+    expect(cn("block")).toBe("block");
+  });
+
+  it("cn joins independent classes", () => {
+    expect(cn("block", "rounded-md")).toBe("block rounded-md");
+  });
+
+  it("cn ignores false values", () => {
+    expect(cn("block", false && "hidden")).toBe("block");
+  });
+
+  it("cn ignores undefined values", () => {
+    expect(cn("block", undefined)).toBe("block");
+  });
+
+  it("cn accepts object syntax", () => {
+    expect(cn({ block: true, hidden: false })).toBe("block");
+  });
+
+  it("cn accepts array syntax", () => {
+    expect(cn(["block", "rounded-md"])).toBe("block rounded-md");
+  });
+
+  it("cn resolves conflicting background classes to the last one", () => {
+    expect(cn("bg-red-500", "bg-blue-500")).toBe("bg-blue-500");
+  });
+
+  it("cn resolves conflicting text size classes to the last one", () => {
+    expect(cn("text-sm", "text-lg")).toBe("text-lg");
+  });
+
+  it("cn resolves conflicting padding classes to the last one", () => {
+    expect(cn("p-2", "p-4")).toBe("p-4");
+  });
+});
