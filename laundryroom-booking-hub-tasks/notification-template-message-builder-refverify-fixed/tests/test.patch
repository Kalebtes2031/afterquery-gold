@@ -0,0 +1,93 @@
+import { describe, expect, it } from "vitest";
+import { SERVICE_DETAILS } from "@/lib/data/serviceDetails";
+
+const slugs = [
+  "laundry-services",
+  "duvet-cleaning",
+  "mat-cleaning",
+  "carpet-cleaning",
+  "eyelet-curtains",
+  "pillows",
+  "suits",
+] as const;
+
+describe("Existing service details behavior", () => {
+  it("contains exactly the seven supported service slugs", () => {
+    expect(Object.keys(SERVICE_DETAILS).sort()).toEqual([...slugs].sort());
+  });
+
+  it("keeps laundry services available", () => {
+    expect(SERVICE_DETAILS["laundry-services"]).toBeDefined();
+  });
+
+  it("keeps duvet cleaning available", () => {
+    expect(SERVICE_DETAILS["duvet-cleaning"]).toBeDefined();
+  });
+
+  it("keeps mat cleaning available", () => {
+    expect(SERVICE_DETAILS["mat-cleaning"]).toBeDefined();
+  });
+
+  it("keeps carpet cleaning available", () => {
+    expect(SERVICE_DETAILS["carpet-cleaning"]).toBeDefined();
+  });
+
+  it("keeps eyelet curtains available", () => {
+    expect(SERVICE_DETAILS["eyelet-curtains"]).toBeDefined();
+  });
+
+  it("keeps pillows available", () => {
+    expect(SERVICE_DETAILS.pillows).toBeDefined();
+  });
+
+  it("keeps suits available", () => {
+    expect(SERVICE_DETAILS.suits).toBeDefined();
+  });
+
+  for (const slug of slugs) {
+    it(`${slug} has a non-empty title`, () => {
+      expect(SERVICE_DETAILS[slug].title.trim().length).toBeGreaterThan(0);
+    });
+
+    it(`${slug} has a non-empty tagline`, () => {
+      expect(SERVICE_DETAILS[slug].tagline.trim().length).toBeGreaterThan(0);
+    });
+
+    it(`${slug} has a non-empty description`, () => {
+      expect(SERVICE_DETAILS[slug].description.trim().length).toBeGreaterThan(0);
+    });
+
+    it(`${slug} exposes at least one package`, () => {
+      expect(SERVICE_DETAILS[slug].packages.length).toBeGreaterThan(0);
+    });
+
+    it(`${slug} packages have names prices and turnaround values`, () => {
+      for (const pkg of SERVICE_DETAILS[slug].packages) {
+        expect(pkg.name.trim().length).toBeGreaterThan(0);
+        expect(pkg.price.trim().length).toBeGreaterThan(0);
+        expect(pkg.turnaround.trim().length).toBeGreaterThan(0);
+      }
+    });
+
+    it(`${slug} packages expose at least one feature`, () => {
+      for (const pkg of SERVICE_DETAILS[slug].packages) {
+        expect(pkg.features.length).toBeGreaterThan(0);
+      }
+    });
+
+    it(`${slug} exposes a non-empty process`, () => {
+      expect(SERVICE_DETAILS[slug].process.length).toBeGreaterThan(0);
+    });
+
+    it(`${slug} process steps have titles and descriptions`, () => {
+      for (const step of SERVICE_DETAILS[slug].process) {
+        expect(step.title.trim().length).toBeGreaterThan(0);
+        expect(step.description.trim().length).toBeGreaterThan(0);
+      }
+    });
+
+    it(`${slug} exposes at least one why-choose reason`, () => {
+      expect(SERVICE_DETAILS[slug].whyChoose.length).toBeGreaterThan(0);
