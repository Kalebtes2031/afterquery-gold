+/// Splits a `{% cycle %}` tag into an optional group name and its values.
+pub fn split_cycle_group(
+    source: &Source,
+    rest: &str,
+    rest_offset: usize,
+) -> Result<(Option<String>, Vec<Expr>)> {
+    let text = rest.trim();
+    if text.is_empty() {
+        return Ok((None, Vec::new()));
+    }
+    let trim_start = rest.find(text).unwrap_or(0);
+    let base = rest_offset + trim_start;
+    let tokens = tokenize(source, text, base)?;
+    let Some(first) = tokens.first() else {
+        return Ok((None, Vec::new()));
+    };
+    if let Token::Ident(name) = &first.token {
+        if is_plain_name(name) {
+            let after_ident = tokens.get(1).map(|spanned| spanned.offset);
+            let text_after = match after_ident {
+                Some(offset) => &text[offset - base..],
+                None => "",
+            };
+            let trimmed_after = text_after.trim();
+            if trimmed_after.is_empty() {
+                let expr = parse_expression(source, text, base)?;
+                return Ok((None, vec![expr]));
+            }
+            if trimmed_after.starts_with(',') {
+                let values = parse_comma_separated_expressions(source, text, base)?;
+                return Ok((None, values));
+            }
+            let values = parse_comma_separated_expressions(source, trimmed_after, after_ident.unwrap())?;
+            return Ok((Some(name.clone()), values));
+        }
+    }
+    let values = parse_comma_separated_expressions(source, text, base)?;
+    Ok((None, values))
+}
+
+fn parse_comma_separated_expressions(
+    source: &Source,
+    text: &str,
+    base: usize,
+) -> Result<Vec<Expr>> {
+    let mut values = Vec::new();
+    for (piece, piece_offset) in split_top_level_commas(text, base) {
+        values.push(parse_expression(source, &piece, piece_offset)?);
+    }
+    Ok(values)
+}
