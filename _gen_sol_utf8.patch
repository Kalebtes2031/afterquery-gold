 }
 
+fn is_loop_cycle_call(callee: &Expr) -> bool {
+    matches!(
+        callee,
+        Expr::Member { base, name, .. }
+            if name == "cycle"
+                && matches!(base.as_ref(), Expr::Name { name, .. } if name == "loop")
+    )
+}
+
+fn map_usize(value: Option<&Value>) -> usize {
+    match value {
+        Some(Value::Number(number)) => crate::value::number::as_integer(*number).unwrap_or(0) as usize,
+        _ => 0,
+    }
+}
