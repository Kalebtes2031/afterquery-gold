+//! Cycle-group state for `{% cycle %}` tags during rendering.
+
+use crate::error::{Error, ErrorKind, Result};
+use crate::source::Source;
+use crate::syntax::ast::Expr;
+use crate::value::ValueMap;
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::rc::Rc;
+
+use super::eval::Evaluator;
+use super::scope::Scope;
+use crate::filters::args::to_text;
+
+/// Tracks anonymous and named cycle cursors for one render pass.
+#[derive(Debug, Default)]
+pub struct CycleTracker {
+    loop_depth: usize,
+    anonymous: RefCell<Vec<usize>>,
+    named: RefCell<BTreeMap<String, usize>>,
+}
+
+impl CycleTracker {
+    /// Creates an empty tracker.
+    pub fn new() -> CycleTracker {
+        CycleTracker::default()
+    }
+
+    /// Enters a non-empty `{% for %}` body.
+    pub fn enter_loop(&mut self) {
+        self.loop_depth += 1;
+        self.anonymous.borrow_mut().push(0);
+    }
+
+    /// Leaves a `{% for %}` body.
+    pub fn exit_loop(&mut self) {
+        self.loop_depth = self.loop_depth.saturating_sub(1);
+        self.anonymous.borrow_mut().pop();
+    }
+
+    /// True when at least one non-empty `{% for %}` body is active.
+    pub fn in_loop(&self) -> bool {
+        self.loop_depth > 0
+    }
+
+    /// Renders the next value from a `{% cycle %}` tag.
+    pub fn render_tag(
+        &self,
+        group: Option<&str>,
+        values: &[Expr],
+        offset: usize,
+        source: &Rc<Source>,
+        scope: &mut Scope,
+        evaluator: &Evaluator<'_>,
+    ) -> Result<String> {
+        let mut rendered_values = Vec::with_capacity(values.len());
+        for value in values {
+            rendered_values.push(evaluator.eval(value, scope)?);
+        }
+        if rendered_values.is_empty() {
+            return Err(Error::syntax(
+                "`cycle` needs at least one value",
+                source.location(offset),
+            )
+            .in_template(source.name()));
+        }
+        let len = rendered_values.len();
+        let index = if let Some(name) = group {
+            let mut cursors = self.named.borrow_mut();
+            let cursor = cursors.entry(name.to_string()).or_insert(0);
+            let current = *cursor;
+            *cursor = current + 1;
+            current
+        } else {
+            if self.loop_depth == 0 {
+                return Err(Error::new(
+                    ErrorKind::Undefined,
+                    "anonymous `cycle` must appear inside a for loop",
+                )
+                .at(source.location(offset))
+                .in_template(source.name()));
+            }
+            let mut cursors = self.anonymous.borrow_mut();
+            let cursor = cursors.last_mut().ok_or_else(|| {
+                Error::new(
+                    ErrorKind::Undefined,
+                    "anonymous `cycle` must appear inside a for loop",
+                )
+                .at(source.location(offset))
+                .in_template(source.name())
+            })?;
+            let current = *cursor;
+            *cursor = current + 1;
+            current
+        };
+        Ok(to_text(&rendered_values[index % len]))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::filters::FilterSet;
+    use crate::runtime::options::Options;
+    use crate::syntax::ast::Expr;
+    use crate::syntax::parser::parse_expression;
+    use crate::source::Source;
+
+    fn literal(text: &str) -> Expr {
+        parse_expression(&Source::anonymous("x"), &format!("{text:?}"), 0).unwrap()
+    }
+
+    #[test]
+    fn named_groups_advance_independently() {
+        let tracker = CycleTracker::new();
+        let source = Rc::new(Source::new("t", "{% cycle %}"));
+        let filters = FilterSet::standard();
+        let options = Options::default();
+        let evaluator = Evaluator::new(&source, &filters, &options);
+        let mut scope = Scope::new(ValueMap::new());
+        let values = vec![literal("a"), literal("b")];
+        let first = tracker
+            .render_tag(Some("g"), &values, 0, &source, &mut scope, &evaluator)
+            .unwrap();
+        let second = tracker
+            .render_tag(Some("h"), &values, 0, &source, &mut scope, &evaluator)
+            .unwrap();
+        assert_eq!(first, "a");
+        assert_eq!(second, "a");
+    }
+
+    #[test]
+    fn anonymous_cycle_requires_an_active_loop() {
+        let tracker = CycleTracker::new();
+        let source = Rc::new(Source::new("t", "{% cycle %}"));
+        let filters = FilterSet::standard();
+        let options = Options::default();
+        let evaluator = Evaluator::new(&source, &filters, &options);
+        let mut scope = Scope::new(ValueMap::new());
+        let values = vec![literal("a")];
+        let err = tracker
+            .render_tag(None, &values, 0, &source, &mut scope, &evaluator)
+            .unwrap_err();
+        assert!(err.to_string().contains("inside a for loop"));
+    }
+
+    #[test]
+    fn anonymous_cycle_advances_inside_a_loop_frame() {
+        let mut tracker = CycleTracker::new();
+        tracker.enter_loop();
+        let source = Rc::new(Source::new("t", "{% cycle %}"));
+        let filters = FilterSet::standard();
+        let options = Options::default();
+        let evaluator = Evaluator::new(&source, &filters, &options);
+        let mut scope = Scope::new(ValueMap::new());
+        let values = vec![literal("x"), literal("y")];
+        let first = tracker
+            .render_tag(None, &values, 0, &source, &mut scope, &evaluator)
+            .unwrap();
+        let second = tracker
+            .render_tag(None, &values, 0, &source, &mut scope, &evaluator)
+            .unwrap();
+        tracker.exit_loop();
+        assert_eq!(first, "x");
+        assert_eq!(second, "y");
+    }
+}
