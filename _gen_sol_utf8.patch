+    fn invoke_loop_cycle(
+        &self,
+        args: &[Expr],
+        offset: usize,
+        source: &Rc<Source>,
+        scope: &mut Scope,
+        evaluator: &Evaluator<'_>,
+    ) -> Result<String> {
