+                ErrorKind::Undefined,
+                "`loop.cycle` must appear inside a for loop",
+            )
+            .at(source.location(offset))
+            .in_template(source.name()));
+        }
+        let Some(Value::Map(map)) = scope.get("loop") else {
+            return Err(Error::new(
+                ErrorKind::Undefined,
+                "`loop.cycle` must appear inside a for loop",
+            )
+            .at(source.location(offset))
+            .in_template(source.name()));
+        };
+        let index0 = map_usize(map.get("index0"));
+        let mut values = Vec::with_capacity(args.len());
+        for arg in args {
+            values.push(evaluator.eval(arg, scope)?);
+        }
+        if values.is_empty() {
+            return Ok(String::new());
+        }
+        Ok(to_text(&values[index0 % values.len()]))
+    }
