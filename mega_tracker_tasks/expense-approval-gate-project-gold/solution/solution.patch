diff --git a/src/modules/expenses/domain/ExpenseApproval.ts b/src/modules/expenses/domain/ExpenseApproval.ts
new file mode 100644
index 0000000..16e437c
--- /dev/null
+++ b/src/modules/expenses/domain/ExpenseApproval.ts
@@ -0,0 +1,192 @@
+import { PoolClient } from "pg";
+import { ConflictError, ForbiddenError, ValidationError } from "../../../shared/domain/DomainError";
+import type { Expense } from "./Expense";
+
+export enum ExpenseStatus {
+  POSTED = "POSTED",
+  DRAFT = "DRAFT",
+  SUBMITTED = "SUBMITTED",
+  APPROVED = "APPROVED",
+  REJECTED = "REJECTED"
+}
+
+export enum ExpenseApprovalAction {
+  SUBMITTED = "SUBMITTED",
+  APPROVED = "APPROVED",
+  REJECTED = "REJECTED"
+}
+
+export type ExpenseApprovalPermission = "submit" | "approve" | "reject";
+
+export interface ExpenseApprovalBandProps {
+  id?: number;
+  companyId: number;
+  roleId: number;
+  minAmount: number;
+  maxAmount: number | null;
+  canSubmit: boolean;
+  canApprove: boolean;
+  canReject: boolean;
+  createdAt?: Date;
+}
+
+export class ExpenseApprovalBand {
+  private constructor(private readonly props: ExpenseApprovalBandProps) {
+    this.validate();
+  }
+
+  static create(input: Omit<ExpenseApprovalBandProps, "id" | "createdAt">): ExpenseApprovalBand {
+    return new ExpenseApprovalBand(input);
+  }
+
+  static hydrate(props: ExpenseApprovalBandProps): ExpenseApprovalBand {
+    return new ExpenseApprovalBand(props);
+  }
+
+  private validate(): void {
+    if (!Number.isFinite(this.props.minAmount) || this.props.minAmount < 0) {
+      throw new ValidationError("Approval band minimum amount must be zero or greater");
+    }
+    if (this.props.maxAmount !== null) {
+      if (!Number.isFinite(this.props.maxAmount) || this.props.maxAmount < this.props.minAmount) {
+        throw new ValidationError("Approval band maximum amount must be greater than or equal to its minimum amount");
+      }
+    }
+    if (!this.props.canSubmit && !this.props.canApprove && !this.props.canReject) {
+      throw new ValidationError("Approval band must allow at least one action");
+    }
+  }
+
+  matches(amount: number, action: ExpenseApprovalPermission): boolean {
+    if (amount < this.props.minAmount) return false;
+    if (this.props.maxAmount !== null && amount > this.props.maxAmount) return false;
+    if (action === "submit") return this.props.canSubmit;
+    if (action === "approve") return this.props.canApprove;
+    return this.props.canReject;
+  }
+
+  toPrimitives(): ExpenseApprovalBandProps {
+    return { ...this.props };
+  }
+}
+
+export interface ExpenseApprovalActor {
+  userId: number;
+  isOwner: boolean;
+  roleId: number | null;
+}
+
+export class ExpenseApprovalGate {
+  static assertCanSubmit(expense: Expense, actor: ExpenseApprovalActor, bands: ExpenseApprovalBand[]): void {
+    this.assertApprovalExpense(expense);
+    if (expense.status !== ExpenseStatus.DRAFT) {
+      throw new ConflictError("Only draft expenses can be submitted");
+    }
+    if (expense.createdBy !== actor.userId) {
+      throw new ForbiddenError("Only the expense creator can submit it");
+    }
+    this.assertBandPermission(expense.totalAmount, actor, bands, "submit");
+  }
+
+  static assertCanApprove(expense: Expense, actor: ExpenseApprovalActor, bands: ExpenseApprovalBand[]): void {
+    this.assertDecisionAllowed(expense, actor);
+    this.assertBandPermission(expense.totalAmount, actor, bands, "approve");
+  }
+
+  static assertCanReject(expense: Expense, actor: ExpenseApprovalActor, bands: ExpenseApprovalBand[]): void {
+    this.assertDecisionAllowed(expense, actor);
+    this.assertBandPermission(expense.totalAmount, actor, bands, "reject");
+  }
+
+  private static assertApprovalExpense(expense: Expense): void {
+    if (!expense.requiresApproval) {
+      throw new ConflictError("This expense does not require approval");
+    }
+  }
+
+  private static assertDecisionAllowed(expense: Expense, actor: ExpenseApprovalActor): void {
+    this.assertApprovalExpense(expense);
+    if (expense.status !== ExpenseStatus.SUBMITTED) {
+      throw new ConflictError("Only submitted expenses can be approved or rejected");
+    }
+    if (expense.createdBy === actor.userId) {
+      throw new ForbiddenError("An expense creator cannot approve or reject their own expense");
+    }
+  }
+
+  private static assertBandPermission(
+    amount: number,
+    actor: ExpenseApprovalActor,
+    bands: ExpenseApprovalBand[],
+    action: ExpenseApprovalPermission
+  ): void {
+    if (actor.isOwner) return;
+    if (!actor.roleId) {
+      throw new ForbiddenError("An employee role is required for expense approval actions");
+    }
+    const allowed = bands.some((band) => {
+      const p = band.toPrimitives();
+      return p.roleId === actor.roleId && band.matches(amount, action);
+    });
+    if (!allowed) {
+      throw new ForbiddenError(`Role is not allowed to ${action} an expense of this amount`);
+    }
+  }
+}
+
+export interface ExpenseApprovalDecisionProps {
+  id?: number;
+  companyId: number;
+  expenseId: number;
+  action: ExpenseApprovalAction;
+  actorUserId: number;
+  actorRoleId: number | null;
+  amount: number;
+  reason?: string | null;
+  createdAt?: Date;
+}
+
+export class ExpenseApprovalDecision {
+  private constructor(private readonly props: ExpenseApprovalDecisionProps) {
+    if (!Number.isFinite(props.amount) || props.amount <= 0) {
+      throw new ValidationError("Approval decision amount must be positive");
+    }
+    if (props.action === ExpenseApprovalAction.REJECTED) {
+      const reason = props.reason?.trim() ?? "";
+      if (reason.length === 0) throw new ValidationError("Rejection reason is required");
+      if (reason.length > 1000) throw new ValidationError("Rejection reason must be 1000 characters or fewer");
+      this.props.reason = reason;
+    } else if (props.reason != null) {
+      this.props.reason = props.reason.trim() || null;
+    }
+  }
+
+  static create(input: Omit<ExpenseApprovalDecisionProps, "id" | "createdAt">): ExpenseApprovalDecision {
+    return new ExpenseApprovalDecision({ ...input, createdAt: new Date() });
+  }
+
+  static hydrate(props: ExpenseApprovalDecisionProps): ExpenseApprovalDecision {
+    return new ExpenseApprovalDecision(props);
+  }
+
+  toPrimitives(): ExpenseApprovalDecisionProps {
+    return { ...this.props };
+  }
+}
+
+export interface ExpenseApprovalBandRepository {
+  replaceForRole(
+    companyId: number,
+    roleId: number,
+    bands: ExpenseApprovalBand[],
+    client?: PoolClient
+  ): Promise<ExpenseApprovalBand[]>;
+  list(companyId: number, roleId?: number | null, client?: PoolClient): Promise<ExpenseApprovalBand[]>;
+}
+
+export interface ExpenseApprovalWorkflowRepository {
+  findExpenseForUpdate(companyId: number, expenseId: number, client: PoolClient): Promise<Expense | null>;
+  updateStatus(companyId: number, expenseId: number, status: ExpenseStatus, client: PoolClient): Promise<void>;
+  addDecision(decision: ExpenseApprovalDecision, client: PoolClient): Promise<ExpenseApprovalDecision>;
+  listDecisions(companyId: number, expenseId: number): Promise<ExpenseApprovalDecision[]>;
+}
