+import { PoolClient } from "pg";
+import { pgPool } from "../../../shared/infrastructure/db/pgPool";
+import { Expense, ExpenseType } from "../domain/Expense";
+import {
+  ExpenseApprovalAction,
+  ExpenseApprovalBand,
+  ExpenseApprovalBandRepository,
+  ExpenseApprovalDecision,
+  ExpenseApprovalWorkflowRepository,
+  ExpenseStatus
+} from "../domain/ExpenseApproval";
+
+export class PgExpenseApprovalRepository implements ExpenseApprovalBandRepository, ExpenseApprovalWorkflowRepository {
+  async replaceForRole(
+    companyId: number,
+    roleId: number,
+    bands: ExpenseApprovalBand[],
+    client?: PoolClient
+  ): Promise<ExpenseApprovalBand[]> {
+    const operation = async (db: PoolClient | typeof pgPool): Promise<ExpenseApprovalBand[]> => {
+      await db.query(
+        "DELETE FROM expense_approval_band WHERE company_id = $1 AND role_id = $2",
+        [companyId, roleId]
+      );
+      const saved: ExpenseApprovalBand[] = [];
+      for (const band of bands) {
+        const p = band.toPrimitives();
+        const result = await db.query(
+          `INSERT INTO expense_approval_band
+             (company_id, role_id, min_amount, max_amount, can_submit, can_approve, can_reject)
+           VALUES ($1,$2,$3,$4,$5,$6,$7)
+           RETURNING *`,
+          [companyId, roleId, p.minAmount, p.maxAmount, p.canSubmit, p.canApprove, p.canReject]
+        );
+        saved.push(this.mapBand(result.rows[0]));
+      }
+      return saved;
+    };
+
+    if (client) return operation(client);
+    const dbClient = await pgPool.connect();
+    try {
+      await dbClient.query("BEGIN");
+      const result = await operation(dbClient);
+      await dbClient.query("COMMIT");
+      return result;
+    } catch (error) {
+      await dbClient.query("ROLLBACK");
+      throw error;
+    } finally {
+      dbClient.release();
+    }
+  }
+
+  async list(companyId: number, roleId?: number | null, client?: PoolClient): Promise<ExpenseApprovalBand[]> {
+    const db = client || pgPool;
+    const params: any[] = [companyId];
+    let sql = "SELECT * FROM expense_approval_band WHERE company_id = $1";
+    if (roleId != null) {
+      params.push(roleId);
+      sql += ` AND role_id = $${params.length}`;
+    }
+    sql += " ORDER BY role_id ASC, min_amount ASC, id ASC";
+    const result = await db.query(sql, params);
+    return result.rows.map((row) => this.mapBand(row));
+  }
+
+  async findExpenseForUpdate(companyId: number, expenseId: number, client: PoolClient): Promise<Expense | null> {
+    const result = await client.query(
+      "SELECT * FROM expense WHERE company_id = $1 AND id = $2 FOR UPDATE",
+      [companyId, expenseId]
+    );
+    if (result.rowCount === 0) return null;
+    return this.mapExpense(result.rows[0]);
+  }
+
+  async updateStatus(companyId: number, expenseId: number, status: ExpenseStatus, client: PoolClient): Promise<void> {
+    await client.query(
+      `UPDATE expense
+       SET approval_status = $3, approval_updated_at = NOW()
+       WHERE company_id = $1 AND id = $2`,
+      [companyId, expenseId, status]
+    );
+  }
+
+  async addDecision(decision: ExpenseApprovalDecision, client: PoolClient): Promise<ExpenseApprovalDecision> {
+    const p = decision.toPrimitives();
+    const result = await client.query(
+      `INSERT INTO expense_approval_decision
+         (company_id, expense_id, action, actor_user_id, actor_role_id, amount, reason)
+       VALUES ($1,$2,$3,$4,$5,$6,$7)
+       RETURNING *`,
+      [p.companyId, p.expenseId, p.action, p.actorUserId, p.actorRoleId, p.amount, p.reason ?? null]
+    );
+    return this.mapDecision(result.rows[0]);
+  }
+
+  async listDecisions(companyId: number, expenseId: number): Promise<ExpenseApprovalDecision[]> {
+    const result = await pgPool.query(
+      `SELECT d.*
+       FROM expense_approval_decision d
+       JOIN expense e ON e.id = d.expense_id AND e.company_id = d.company_id
+       WHERE d.company_id = $1 AND d.expense_id = $2
+       ORDER BY d.created_at ASC, d.id ASC`,
+      [companyId, expenseId]
+    );
+    return result.rows.map((row) => this.mapDecision(row));
+  }
+
+  private mapBand(row: any): ExpenseApprovalBand {
+    return ExpenseApprovalBand.hydrate({
+      id: Number(row.id),
+      companyId: Number(row.company_id),
+      roleId: Number(row.role_id),
+      minAmount: Number(row.min_amount),
+      maxAmount: row.max_amount == null ? null : Number(row.max_amount),
+      canSubmit: Boolean(row.can_submit),
+      canApprove: Boolean(row.can_approve),
+      canReject: Boolean(row.can_reject),
+      createdAt: row.created_at
+    });
+  }
+
+  private mapExpense(row: any): Expense {
+    return Expense.hydrate({
+      id: Number(row.id),
+      companyId: Number(row.company_id),
+      expenseDate: row.expense_date,
+      reason: row.reason,
+      expenseType: row.expense_type as ExpenseType,
+      totalAmount: Number(row.total_amount),
+      note: row.note,
+      partnerId: row.partner_id == null ? null : Number(row.partner_id),
+      createdBy: row.created_by == null ? null : Number(row.created_by),
+      createdAt: row.created_at,
+      requiresApproval: Boolean(row.requires_approval),
+      status: row.approval_status as ExpenseStatus
+    });
+  }
+
+  private mapDecision(row: any): ExpenseApprovalDecision {
+    return ExpenseApprovalDecision.hydrate({
+      id: Number(row.id),
+      companyId: Number(row.company_id),
+      expenseId: Number(row.expense_id),
+      action: row.action as ExpenseApprovalAction,
+      actorUserId: Number(row.actor_user_id),
+      actorRoleId: row.actor_role_id == null ? null : Number(row.actor_role_id),
+      amount: Number(row.amount),
+      reason: row.reason,
+      createdAt: row.created_at
+    });
+  }
+}
