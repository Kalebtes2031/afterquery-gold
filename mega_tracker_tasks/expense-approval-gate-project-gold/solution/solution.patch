new file mode 100644
index 0000000..eedff1a
--- /dev/null
+++ b/db/migrations/035_expense_approval_gate.sql
@@ -0,0 +1,57 @@
+-- Expense approval workflow and role/amount approval bands.
+
+CREATE TYPE expense_approval_status AS ENUM (
+  'POSTED',
+  'DRAFT',
+  'SUBMITTED',
+  'APPROVED',
+  'REJECTED'
+);
+
+CREATE TYPE expense_approval_action AS ENUM (
+  'SUBMITTED',
+  'APPROVED',
+  'REJECTED'
+);
+
+ALTER TABLE expense
+  ADD COLUMN requires_approval BOOLEAN NOT NULL DEFAULT FALSE,
+  ADD COLUMN approval_status expense_approval_status NOT NULL DEFAULT 'POSTED',
+  ADD COLUMN approval_updated_at TIMESTAMPTZ;
+
+CREATE TABLE expense_approval_band (
+  id          BIGSERIAL PRIMARY KEY,
+  company_id  BIGINT NOT NULL REFERENCES company(id) ON DELETE CASCADE,
+  role_id     BIGINT NOT NULL REFERENCES role(id) ON DELETE CASCADE,
+  min_amount  NUMERIC(18,2) NOT NULL,
+  max_amount  NUMERIC(18,2),
+  can_submit  BOOLEAN NOT NULL DEFAULT FALSE,
+  can_approve BOOLEAN NOT NULL DEFAULT FALSE,
+  can_reject  BOOLEAN NOT NULL DEFAULT FALSE,
+  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  CONSTRAINT chk_expense_approval_band_min CHECK (min_amount >= 0),
+  CONSTRAINT chk_expense_approval_band_max CHECK (max_amount IS NULL OR max_amount >= min_amount),
+  CONSTRAINT chk_expense_approval_band_action CHECK (can_submit OR can_approve OR can_reject)
+);
+
+CREATE INDEX idx_expense_approval_band_company_role_amount
+  ON expense_approval_band(company_id, role_id, min_amount, max_amount);
+
+CREATE TABLE expense_approval_decision (
+  id            BIGSERIAL PRIMARY KEY,
+  company_id    BIGINT NOT NULL REFERENCES company(id) ON DELETE CASCADE,
+  expense_id    BIGINT NOT NULL REFERENCES expense(id) ON DELETE CASCADE,
+  action        expense_approval_action NOT NULL,
+  actor_user_id BIGINT NOT NULL REFERENCES user_account(id),
+  actor_role_id BIGINT REFERENCES role(id),
+  amount        NUMERIC(18,2) NOT NULL,
+  reason        TEXT,
+  created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  CONSTRAINT chk_expense_approval_decision_amount CHECK (amount > 0),
+  CONSTRAINT chk_expense_rejection_reason CHECK (
+    action <> 'REJECTED' OR (reason IS NOT NULL AND length(btrim(reason)) BETWEEN 1 AND 1000)
+  )
+);
+
+CREATE INDEX idx_expense_approval_decision_history
+  ON expense_approval_decision(company_id, expense_id, created_at ASC, id ASC);
diff --git a/src/modules/expenses/application/ExpenseApprovalUseCases.ts b/src/modules/expenses/application/ExpenseApprovalUseCases.ts
new file mode 100644
index 0000000..8abdb04
--- /dev/null
+++ b/src/modules/expenses/application/ExpenseApprovalUseCases.ts
@@ -0,0 +1,268 @@
+import { PoolClient } from "pg";
+import { TransactionManager } from "../../../shared/infrastructure/transactions/TransactionManager";
+import { EntityNotFoundError, ValidationError } from "../../../shared/domain/DomainError";
+import { RoleRepository } from "../../roles/domain/Role";
+import { EmployeeRepository } from "../../employees/domain/Employee";
+import { Partner, PartnerRepository } from "../../partners/domain/Partner";
+import { AccountTransaction } from "../../finance/domain/AccountTransaction";
+import { RecordAccountTransactionUseCase } from "../../finance/application/RecordAccountTransactionUseCase";
+import { RecordLoanTransactionUseCase } from "../../finance/application/RecordLoanTransactionUseCase";
+import { LoanTransactionSourceType } from "../../finance/domain/LoanTransaction";
+import { ExpensePaymentRepository, PaymentMethod } from "../domain/Expense";
+import {
+  ExpenseApprovalAction,
+  ExpenseApprovalActor,
+  ExpenseApprovalBand,
+  ExpenseApprovalBandRepository,
+  ExpenseApprovalDecision,
+  ExpenseApprovalGate,
+  ExpenseApprovalWorkflowRepository,
+  ExpenseStatus
+} from "../domain/ExpenseApproval";
+
+export interface ApprovalBandInput {
+  minAmount: number;
+  maxAmount: number | null;
+  canSubmit: boolean;
+  canApprove: boolean;
+  canReject: boolean;
+}
+
+export class SetExpenseApprovalBandsUseCase {
+  constructor(
+    private readonly roleRepo: RoleRepository,
+    private readonly bandRepo: ExpenseApprovalBandRepository
+  ) {}
+
+  async execute(companyId: number, roleId: number, inputs: ApprovalBandInput[]): Promise<any[]> {
+    const role = await this.roleRepo.findById(companyId, roleId);
+    if (!role) throw new EntityNotFoundError("Role not found");
+
+    const bands = inputs.map((input) => ExpenseApprovalBand.create({
+      companyId,
+      roleId,
+      minAmount: input.minAmount,
+      maxAmount: input.maxAmount,
+      canSubmit: input.canSubmit,
+      canApprove: input.canApprove,
+      canReject: input.canReject
+    }));
+
+    const saved = await this.bandRepo.replaceForRole(companyId, roleId, bands);
+    return saved.map((band) => band.toPrimitives());
+  }
+}
+
+export class ListExpenseApprovalBandsUseCase {
+  constructor(private readonly bandRepo: ExpenseApprovalBandRepository) {}
+
+  async execute(companyId: number, roleId?: number | null): Promise<any[]> {
+    const bands = await this.bandRepo.list(companyId, roleId ?? null);
+    return bands.map((band) => band.toPrimitives());
+  }
+}
+
+export interface ApprovalActorInput {
+  userId: number;
+  isOwner: boolean;
+}
+
+abstract class ExpenseApprovalActionUseCase {
+  constructor(
+    protected readonly txManager: TransactionManager,
+    protected readonly workflowRepo: ExpenseApprovalWorkflowRepository,
+    protected readonly bandRepo: ExpenseApprovalBandRepository,
+    protected readonly employeeRepo: EmployeeRepository
+  ) {}
+
+  protected async resolveActor(companyId: number, input: ApprovalActorInput, client: PoolClient): Promise<ExpenseApprovalActor> {
+    if (input.isOwner) {
+      return { userId: input.userId, isOwner: true, roleId: null };
+    }
+    const employee = await this.employeeRepo.findByUserId(companyId, input.userId, client);
+    return {
+      userId: input.userId,
+      isOwner: false,
+      roleId: employee?.roleId ?? null
+    };
+  }
+
+  protected async bandsFor(companyId: number, actor: ExpenseApprovalActor, client: PoolClient): Promise<ExpenseApprovalBand[]> {
+    if (actor.isOwner || !actor.roleId) return [];
+    return this.bandRepo.list(companyId, actor.roleId, client);
+  }
+}
+
+export class SubmitExpenseUseCase extends ExpenseApprovalActionUseCase {
+  async execute(companyId: number, expenseId: number, actorInput: ApprovalActorInput): Promise<{ expenseId: number; status: ExpenseStatus }> {
+    return this.txManager.run(async (client) => {
+      const expense = await this.workflowRepo.findExpenseForUpdate(companyId, expenseId, client);
+      if (!expense) throw new EntityNotFoundError("Expense not found");
+
+      const actor = await this.resolveActor(companyId, actorInput, client);
+      const bands = await this.bandsFor(companyId, actor, client);
+      ExpenseApprovalGate.assertCanSubmit(expense, actor, bands);
+
+      await this.workflowRepo.updateStatus(companyId, expenseId, ExpenseStatus.SUBMITTED, client);
+      await this.workflowRepo.addDecision(ExpenseApprovalDecision.create({
+        companyId,
+        expenseId,
+        action: ExpenseApprovalAction.SUBMITTED,
+        actorUserId: actor.userId,
+        actorRoleId: actor.roleId,
+        amount: expense.totalAmount,
+        reason: null
+      }), client);
+
+      return { expenseId, status: ExpenseStatus.SUBMITTED };
+    });
+  }
+}
+
+export class ApproveExpenseUseCase extends ExpenseApprovalActionUseCase {
+  constructor(
+    txManager: TransactionManager,
+    workflowRepo: ExpenseApprovalWorkflowRepository,
+    bandRepo: ExpenseApprovalBandRepository,
+    employeeRepo: EmployeeRepository,
+    private readonly paymentRepo: ExpensePaymentRepository,
+    private readonly accountTxService: RecordAccountTransactionUseCase,
+    private readonly recordLoanTransactionUseCase: RecordLoanTransactionUseCase,
+    private readonly partnerRepo: PartnerRepository
+  ) {
+    super(txManager, workflowRepo, bandRepo, employeeRepo);
+  }
+
+  async execute(companyId: number, expenseId: number, actorInput: ApprovalActorInput): Promise<{ expenseId: number; status: ExpenseStatus }> {
+    return this.txManager.run(async (client) => {
+      const expense = await this.workflowRepo.findExpenseForUpdate(companyId, expenseId, client);
+      if (!expense) throw new EntityNotFoundError("Expense not found");
+
+      const actor = await this.resolveActor(companyId, actorInput, client);
+      const bands = await this.bandsFor(companyId, actor, client);
+      ExpenseApprovalGate.assertCanApprove(expense, actor, bands);
+
+      const payments = await this.paymentRepo.findByExpenseId(companyId, expenseId, client);
+      const lines = payments.flatMap((payment) => {
+        const paymentId = payment.toPrimitives().id;
+        return payment.toPrimitives().lines.map((line: any) => ({ ...line, expensePaymentId: paymentId }));
+      });
+      const total = lines.reduce((sum, line) => sum + Number(line.amount), 0);
+      if (lines.length === 0 || Math.abs(total - expense.totalAmount) > 0.01) {
+        throw new ValidationError("Stored expense payments do not equal total expense amount");
+      }
+
+      const partnerIds = Array.from(new Set(
+        lines.filter((line) => line.method === PaymentMethod.PARTNER).map((line) => line.partnerId!)
+      ));
+      const lockedPartners: Partner[] = [];
+      for (const partnerId of partnerIds) {
+        const partner = await this.partnerRepo.findByIdForUpdate(companyId, partnerId, client);
+        if (!partner) throw new EntityNotFoundError("Partner not found");
+        lockedPartners.push(partner);
+      }
+
+      const accountTxs: AccountTransaction[] = [];
+      const loanInputs: Array<{
+        companyId: number;
+        partnerId: number;
+        transactionDate: Date;
+        amount: number;
+        sourceType: LoanTransactionSourceType;
+        sourceId?: number | null;
+        description?: string | null;
+        createdBy?: number | null;
+      }> = [];
+
+      for (const line of lines) {
+        if (line.method === PaymentMethod.CASH || line.method === PaymentMethod.BANK) {
+          if (!line.accountId) throw new ValidationError("Stored bank or cash payment is missing an account");
+          accountTxs.push(AccountTransaction.create({
+            companyId,
+            accountId: line.accountId,
+            date: line.date,
+            amount: -Number(line.amount),
+            description: line.description || `Expense: ${expense.reason}`,
+            sourceType: "EXPENSE_PAYMENT",
+            sourceId: line.expensePaymentId
+          }));
+        } else if (line.method === PaymentMethod.PARTNER) {
+          if (!line.partnerId) throw new ValidationError("Stored partner payment is missing a partner");
+          loanInputs.push({
+            companyId,
+            partnerId: line.partnerId,
+            transactionDate: line.date,
+            amount: -Number(line.amount),
+            sourceType: LoanTransactionSourceType.EXPENSE,
+            sourceId: expenseId,
+            description: line.description || `Expense paid by partner: ${expense.reason}`,
+            createdBy: expense.createdBy ?? undefined
+          });
+        }
+      }
+
+      if (accountTxs.length > 0) await this.accountTxService.executeBatch(accountTxs, client);
+      if (loanInputs.length > 0) {
+        await this.recordLoanTransactionUseCase.executeBatch(loanInputs, client, lockedPartners);
+      }
+
+      await this.workflowRepo.updateStatus(companyId, expenseId, ExpenseStatus.APPROVED, client);
+      await this.workflowRepo.addDecision(ExpenseApprovalDecision.create({
+        companyId,
+        expenseId,
+        action: ExpenseApprovalAction.APPROVED,
+        actorUserId: actor.userId,
+        actorRoleId: actor.roleId,
+        amount: expense.totalAmount,
+        reason: null
+      }), client);
+
+      return { expenseId, status: ExpenseStatus.APPROVED };
+    });
+  }
+}
+
+export class RejectExpenseUseCase extends ExpenseApprovalActionUseCase {
+  async execute(
+    companyId: number,
+    expenseId: number,
+    actorInput: ApprovalActorInput,
+    reason: string
+  ): Promise<{ expenseId: number; status: ExpenseStatus }> {
+    return this.txManager.run(async (client) => {
+      const expense = await this.workflowRepo.findExpenseForUpdate(companyId, expenseId, client);
+      if (!expense) throw new EntityNotFoundError("Expense not found");
+
+      const actor = await this.resolveActor(companyId, actorInput, client);
+      const bands = await this.bandsFor(companyId, actor, client);
+      ExpenseApprovalGate.assertCanReject(expense, actor, bands);
+
+      const decision = ExpenseApprovalDecision.create({
+        companyId,
+        expenseId,
+        action: ExpenseApprovalAction.REJECTED,
+        actorUserId: actor.userId,
+        actorRoleId: actor.roleId,
+        amount: expense.totalAmount,
+        reason
+      });
+      await this.workflowRepo.updateStatus(companyId, expenseId, ExpenseStatus.REJECTED, client);
+      await this.workflowRepo.addDecision(decision, client);
+      return { expenseId, status: ExpenseStatus.REJECTED };
+    });
+  }
+}
+
+export class GetExpenseApprovalHistoryUseCase {
+  constructor(
+    private readonly workflowRepo: ExpenseApprovalWorkflowRepository,
+    private readonly expenseRepo: { findById(companyId: number, expenseId: number): Promise<any> }
+  ) {}
+
+  async execute(companyId: number, expenseId: number): Promise<any[]> {
+    const expense = await this.expenseRepo.findById(companyId, expenseId);
+    if (!expense) throw new EntityNotFoundError("Expense not found");
+    const decisions = await this.workflowRepo.listDecisions(companyId, expenseId);
+    return decisions.map((decision) => decision.toPrimitives());
+  }
+}
