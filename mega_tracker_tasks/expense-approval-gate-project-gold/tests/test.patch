+import { Expense, ExpenseType } from "../Expense";
+import {
+  ExpenseApprovalAction,
+  ExpenseApprovalBand,
+  ExpenseApprovalDecision,
+  ExpenseApprovalGate,
+  ExpenseStatus
+} from "../ExpenseApproval";
+
+function expense(overrides: Partial<any> = {}): Expense {
+  return Expense.hydrate({
+    id: 44,
+    companyId: 7,
+    expenseDate: new Date("2026-08-01"),
+    reason: "Warehouse repair",
+    expenseType: ExpenseType.WORK,
+    totalAmount: 500,
+    createdBy: 11,
+    createdAt: new Date("2026-08-01T10:00:00Z"),
+    requiresApproval: true,
+    status: ExpenseStatus.DRAFT,
+    ...overrides
+  });
+}
+
+function band(overrides: Partial<any> = {}): ExpenseApprovalBand {
+  return ExpenseApprovalBand.create({
+    companyId: 7,
+    roleId: 3,
+    minAmount: 0,
+    maxAmount: 1000,
+    canSubmit: true,
+    canApprove: true,
+    canReject: true,
+    ...overrides
+  });
+}
+
+const employee = { userId: 11, isOwner: false, roleId: 3 };
+const manager = { userId: 12, isOwner: false, roleId: 3 };
+const owner = { userId: 99, isOwner: true, roleId: null };
+
+describe("ExpenseApprovalBand amount rules", () => {
+  it("matches an amount exactly at the minimum", () => {
+    expect(band({ minAmount: 500, maxAmount: 900 }).matches(500, "approve")).toBe(true);
+  });
+
+  it("matches an amount exactly at the maximum", () => {
+    expect(band({ minAmount: 100, maxAmount: 500 }).matches(500, "approve")).toBe(true);
+  });
+
+  it("treats a null maximum as unbounded", () => {
+    expect(band({ minAmount: 1000, maxAmount: null }).matches(9000000, "approve")).toBe(true);
+  });
+
+  it("does not match below the minimum", () => {
+    expect(band({ minAmount: 501 }).matches(500, "approve")).toBe(false);
+  });
+
+  it("does not match above a finite maximum", () => {
+    expect(band({ maxAmount: 499 }).matches(500, "approve")).toBe(false);
+  });
+
+  it("checks the permission for the requested action", () => {
+    const onlySubmit = band({ canSubmit: true, canApprove: false, canReject: false });
+    expect(onlySubmit.matches(500, "submit")).toBe(true);
+    expect(onlySubmit.matches(500, "approve")).toBe(false);
+    expect(onlySubmit.matches(500, "reject")).toBe(false);
+  });
+
+  it("rejects a negative minimum", () => {
+    expect(() => band({ minAmount: -0.01 })).toThrow("minimum amount must be zero or greater");
+  });
+
+  it("rejects a maximum below the minimum", () => {
+    expect(() => band({ minAmount: 500, maxAmount: 499.99 })).toThrow("maximum amount must be greater than or equal");
+  });
+
+  it("rejects a band with no allowed action", () => {
+    expect(() => band({ canSubmit: false, canApprove: false, canReject: false })).toThrow("must allow at least one action");
+  });
+});
+
+describe("ExpenseApprovalGate submission rules", () => {
+  it("lets the creator submit when their role has a matching submit band", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense(), employee, [band()])).not.toThrow();
+  });
+
+  it("denies submission by somebody other than the creator", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense(), manager, [band()]))
+      .toThrow("Only the expense creator can submit it");
+  });
+
+  it("lets an owner submit their own draft without any bands", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense({ createdBy: 99 }), owner, [])).not.toThrow();
+  });
+
+  it("still requires an owner to be the creator when submitting", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense({ createdBy: 11 }), owner, []))
+      .toThrow("Only the expense creator can submit it");
+  });
+
+  it("denies a non-owner with no employee role", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense(), { ...employee, roleId: null }, [band()]))
+      .toThrow("employee role is required");
+  });
+
+  it("denies a role whose band does not cover the amount", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense(), employee, [band({ maxAmount: 499.99 })]))
+      .toThrow("not allowed to submit");
+  });
+
+  it("denies a role whose amount band lacks submit permission", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense(), employee, [band({ canSubmit: false })]))
+      .toThrow("not allowed to submit");
+  });
+
+  it("does not allow a submitted expense to be submitted again", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(expense({ status: ExpenseStatus.SUBMITTED }), employee, [band()]))
+      .toThrow("Only draft expenses can be submitted");
+  });
+
+  it("does not put a legacy posted expense into the approval flow", () => {
+    expect(() => ExpenseApprovalGate.assertCanSubmit(
+      expense({ requiresApproval: false, status: ExpenseStatus.POSTED }),
+      employee,
+      [band()]
+    )).toThrow("does not require approval");
+  });
+});
+
+describe("ExpenseApprovalGate approve and reject rules", () => {
+  const submitted = () => expense({ status: ExpenseStatus.SUBMITTED });
+
+  it("lets a different employee approve with a matching band", () => {
+    expect(() => ExpenseApprovalGate.assertCanApprove(submitted(), manager, [band()])).not.toThrow();
+  });
+
+  it("lets a different employee reject with a matching band", () => {
+    expect(() => ExpenseApprovalGate.assertCanReject(submitted(), manager, [band()])).not.toThrow();
+  });
+
+  it("never lets a creator approve their own expense", () => {
+    expect(() => ExpenseApprovalGate.assertCanApprove(submitted(), employee, [band()]))
+      .toThrow("cannot approve or reject their own expense");
+  });
+
+  it("never lets an owner approve their own expense", () => {
+    expect(() => ExpenseApprovalGate.assertCanApprove(
+      Expense.hydrate({ ...submitted().toPrimitives(), createdBy: 99 }),
+      owner,
+      []
+    )).toThrow("cannot approve or reject their own expense");
+  });
+
+  it("lets an owner approve somebody else's submitted expense without bands", () => {
+    expect(() => ExpenseApprovalGate.assertCanApprove(submitted(), owner, [])).not.toThrow();
+  });
+
+  it("lets an owner reject somebody else's submitted expense without bands", () => {
+    expect(() => ExpenseApprovalGate.assertCanReject(submitted(), owner, [])).not.toThrow();
+  });
+
+  it("denies approval when a matching band only grants rejection", () => {
+    expect(() => ExpenseApprovalGate.assertCanApprove(
+      submitted(),
+      manager,
+      [band({ canApprove: false, canReject: true })]
+    )).toThrow("not allowed to approve");
+  });
+
+  it("denies rejection when a matching band only grants approval", () => {
+    expect(() => ExpenseApprovalGate.assertCanReject(
+      submitted(),
+      manager,
+      [band({ canReject: false, canApprove: true })]
+    )).toThrow("not allowed to reject");
+  });
+
+  it("does not let a draft be approved", () => {
+    expect(() => ExpenseApprovalGate.assertCanApprove(expense(), manager, [band()]))
+      .toThrow("Only submitted expenses can be approved or rejected");
+  });
+
+  it("does not let an approved expense be rejected later", () => {
+    expect(() => ExpenseApprovalGate.assertCanReject(
+      expense({ status: ExpenseStatus.APPROVED }),
+      manager,
+      [band()]
+    )).toThrow("Only submitted expenses can be approved or rejected");
+  });
+
+  it("uses any matching band for the actor role", () => {
+    const bands = [
+      band({ minAmount: 0, maxAmount: 100, canApprove: true }),
+      band({ minAmount: 101, maxAmount: 1000, canApprove: true })
+    ];
+    expect(() => ExpenseApprovalGate.assertCanApprove(submitted(), manager, bands)).not.toThrow();
+  });
+
+  it("does not borrow permission from another role's band", () => {
+    expect(() => ExpenseApprovalGate.assertCanApprove(
+      submitted(),
+      manager,
+      [band({ roleId: 4 })]
+    )).toThrow("not allowed to approve");
+  });
+});
+
+describe("Expense approval decisions", () => {
+  it("trims and keeps a rejection reason", () => {
+    const decision = ExpenseApprovalDecision.create({
+      companyId: 7,
+      expenseId: 44,
+      action: ExpenseApprovalAction.REJECTED,
+      actorUserId: 12,
+      actorRoleId: 3,
+      amount: 500,
+      reason: "  missing receipt  "
+    });
+    expect(decision.toPrimitives().reason).toBe("missing receipt");
+  });
+
+  it("rejects an empty rejection reason", () => {
+    expect(() => ExpenseApprovalDecision.create({
+      companyId: 7,
+      expenseId: 44,
+      action: ExpenseApprovalAction.REJECTED,
+      actorUserId: 12,
+      actorRoleId: 3,
+      amount: 500,
+      reason: "   "
+    })).toThrow("Rejection reason is required");
+  });
+
+  it("rejects a rejection reason longer than 1000 characters", () => {
+    expect(() => ExpenseApprovalDecision.create({
+      companyId: 7,
+      expenseId: 44,
+      action: ExpenseApprovalAction.REJECTED,
+      actorUserId: 12,
+      actorRoleId: 3,
+      amount: 500,
+      reason: "x".repeat(1001)
+    })).toThrow("1000 characters or fewer");
+  });
+
+  it("allows exactly 1000 characters in a rejection reason", () => {
+    const reason = "x".repeat(1000);
+    const decision = ExpenseApprovalDecision.create({
+      companyId: 7,
+      expenseId: 44,
+      action: ExpenseApprovalAction.REJECTED,
+      actorUserId: 12,
+      actorRoleId: 3,
+      amount: 500,
+      reason
+    });
+    expect(decision.toPrimitives().reason).toHaveLength(1000);
+  });
+
+  it("allows submit and approve decisions without a reason", () => {
+    for (const action of [ExpenseApprovalAction.SUBMITTED, ExpenseApprovalAction.APPROVED]) {
+      expect(() => ExpenseApprovalDecision.create({
+        companyId: 7,
+        expenseId: 44,
+        action,
+        actorUserId: 12,
+        actorRoleId: 3,
+        amount: 500,
+        reason: null
+      })).not.toThrow();
+    }
+  });
+});
+
+describe("Expense approval state defaults", () => {
+  it("keeps ordinary expenses posted by default", () => {
+    const ordinary = Expense.create({
+      companyId: 7,
+      expenseDate: new Date("2026-08-01"),
+      reason: "Fuel",
+      expenseType: ExpenseType.WORK,
+      totalAmount: 50
+    });
+    expect(ordinary.requiresApproval).toBe(false);
+    expect(ordinary.status).toBe(ExpenseStatus.POSTED);
+  });
+
+  it("starts approval-required expenses as drafts", () => {
+    const approvalRequired = Expense.create({
+      companyId: 7,
+      expenseDate: new Date("2026-08-01"),
+      reason: "Fuel",
+      expenseType: ExpenseType.WORK,
+      totalAmount: 50,
+      requiresApproval: true
+    });
+    expect(approvalRequired.requiresApproval).toBe(true);
+    expect(approvalRequired.status).toBe(ExpenseStatus.DRAFT);
+  });
+});
