@@ -0,0 +1,517 @@
+import { Expense, ExpensePayment, ExpenseType, PaymentMethod } from "../../domain/Expense";
+import {
+  ExpenseApprovalAction,
+  ExpenseApprovalBand,
+  ExpenseApprovalDecision,
+  ExpenseStatus
+} from "../../domain/ExpenseApproval";
+import {
+  ApproveExpenseUseCase,
+  GetExpenseApprovalHistoryUseCase,
+  ListExpenseApprovalBandsUseCase,
+  RejectExpenseUseCase,
+  SetExpenseApprovalBandsUseCase,
+  SubmitExpenseUseCase
+} from "../ExpenseApprovalUseCases";
+import { RecordExpenseUseCase } from "../RecordExpenseUseCase";
+
+function makeExpense(overrides: Partial<any> = {}): Expense {
+  return Expense.hydrate({
+    id: 50,
+    companyId: 2,
+    expenseDate: new Date("2026-08-20"),
+    reason: "Generator service",
+    expenseType: ExpenseType.WORK,
+    totalAmount: 600,
+    note: null,
+    createdBy: 10,
+    createdAt: new Date("2026-08-20T12:00:00Z"),
+    requiresApproval: true,
+    status: ExpenseStatus.DRAFT,
+    ...overrides
+  });
+}
+
+function makeBand(overrides: Partial<any> = {}): ExpenseApprovalBand {
+  return ExpenseApprovalBand.hydrate({
+    id: 1,
+    companyId: 2,
+    roleId: 8,
+    minAmount: 0,
+    maxAmount: 1000,
+    canSubmit: true,
+    canApprove: true,
+    canReject: true,
+    createdAt: new Date("2026-08-01"),
+    ...overrides
+  });
+}
+
+function payment(lines: any[]): ExpensePayment {
+  return ExpensePayment.hydrate({
+    id: 70,
+    companyId: 2,
+    expenseId: 50,
+    createdBy: 10,
+    createdAt: new Date("2026-08-20"),
+    lines
+  });
+}
+
+function txManager() {
+  return {
+    run: jest.fn(async (callback: any) => callback({ marker: "client" }))
+  } as any;
+}
+
+function workflowRepo(current: Expense = makeExpense()) {
+  return {
+    findExpenseForUpdate: jest.fn().mockResolvedValue(current),
+    updateStatus: jest.fn().mockResolvedValue(undefined),
+    addDecision: jest.fn(async (decision: ExpenseApprovalDecision) => decision),
+    listDecisions: jest.fn().mockResolvedValue([])
+  } as any;
+}
+
+function bandRepo(bands: ExpenseApprovalBand[] = [makeBand()]) {
+  return {
+    replaceForRole: jest.fn(async (_companyId: number, _roleId: number, incoming: ExpenseApprovalBand[]) => incoming),
+    list: jest.fn().mockResolvedValue(bands)
+  } as any;
+}
+
+function employeeRepo(roleId = 8) {
+  return {
+    findByUserId: jest.fn().mockResolvedValue({ roleId })
+  } as any;
+}
+
+describe("approval band application behavior", () => {
+  it("replaces all bands for a role after confirming the role belongs to the company", async () => {
+    const roleRepo = { findById: jest.fn().mockResolvedValue({ id: 8 }) } as any;
+    const bands = bandRepo([]);
+    const useCase = new SetExpenseApprovalBandsUseCase(roleRepo, bands);
+
+    const result = await useCase.execute(2, 8, [{
+      minAmount: 0,
+      maxAmount: 2500,
+      canSubmit: true,
+      canApprove: false,
+      canReject: false
+    }]);
+
+    expect(roleRepo.findById).toHaveBeenCalledWith(2, 8);
+    expect(bands.replaceForRole).toHaveBeenCalledTimes(1);
+    expect(result[0]).toEqual(expect.objectContaining({ companyId: 2, roleId: 8, maxAmount: 2500 }));
+  });
+
+  it("uses an empty list to clear the role's approval bands", async () => {
+    const roleRepo = { findById: jest.fn().mockResolvedValue({ id: 8 }) } as any;
+    const bands = bandRepo([]);
+    const useCase = new SetExpenseApprovalBandsUseCase(roleRepo, bands);
+
+    const result = await useCase.execute(2, 8, []);
+
+    expect(result).toEqual([]);
+    expect(bands.replaceForRole.mock.calls[0][2]).toEqual([]);
+  });
+
+  it("does not configure a role from another company", async () => {
+    const roleRepo = { findById: jest.fn().mockResolvedValue(null) } as any;
+    const bands = bandRepo([]);
+    const useCase = new SetExpenseApprovalBandsUseCase(roleRepo, bands);
+
+    await expect(useCase.execute(2, 999, [])).rejects.toThrow("Role not found");
+    expect(bands.replaceForRole).not.toHaveBeenCalled();
+  });
+
+  it("returns company bands and forwards an optional role filter", async () => {
+    const bands = bandRepo([makeBand()]);
+    const useCase = new ListExpenseApprovalBandsUseCase(bands);
+
+    const result = await useCase.execute(2, 8);
+
+    expect(bands.list).toHaveBeenCalledWith(2, 8);
+    expect(result).toHaveLength(1);
+    expect(result[0].roleId).toBe(8);
+  });
+});
+
+describe("submitting approval-required expenses", () => {
+  it("moves the creator's draft to submitted and records the actor, role and amount", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo();
+    const bands = bandRepo();
+    const employees = employeeRepo();
+    const useCase = new SubmitExpenseUseCase(tx, workflow, bands, employees);
+
+    const result = await useCase.execute(2, 50, { userId: 10, isOwner: false });
+
+    expect(result).toEqual({ expenseId: 50, status: ExpenseStatus.SUBMITTED });
+    expect(workflow.updateStatus).toHaveBeenCalledWith(2, 50, ExpenseStatus.SUBMITTED, expect.anything());
+    const decision = workflow.addDecision.mock.calls[0][0].toPrimitives();
+    expect(decision).toEqual(expect.objectContaining({
+      action: ExpenseApprovalAction.SUBMITTED,
+      actorUserId: 10,
+      actorRoleId: 8,
+      amount: 600
+    }));
+  });
+
+  it("checks a non-owner's current employee role", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo();
+    const bands = bandRepo();
+    const employees = employeeRepo(8);
+    const useCase = new SubmitExpenseUseCase(tx, workflow, bands, employees);
+
+    await useCase.execute(2, 50, { userId: 10, isOwner: false });
+
+    expect(employees.findByUserId).toHaveBeenCalledWith(2, 10, expect.anything());
+    expect(bands.list).toHaveBeenCalledWith(2, 8, expect.anything());
+  });
+
+  it("does not require an employee row or band lookup for an owner", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo(makeExpense({ createdBy: 99 }));
+    const bands = bandRepo([]);
+    const employees = employeeRepo();
+    const useCase = new SubmitExpenseUseCase(tx, workflow, bands, employees);
+
+    await useCase.execute(2, 50, { userId: 99, isOwner: true });
+
+    expect(employees.findByUserId).not.toHaveBeenCalled();
+    expect(bands.list).not.toHaveBeenCalled();
+  });
+
+  it("does not update state or history when the submit band does not allow the amount", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo();
+    const bands = bandRepo([makeBand({ maxAmount: 599 })]);
+    const useCase = new SubmitExpenseUseCase(tx, workflow, bands, employeeRepo());
+
+    await expect(useCase.execute(2, 50, { userId: 10, isOwner: false }))
+      .rejects.toThrow("not allowed to submit");
+
+    expect(workflow.updateStatus).not.toHaveBeenCalled();
+    expect(workflow.addDecision).not.toHaveBeenCalled();
+  });
+
+  it("returns not found without writing when the expense is outside the company", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo();
+    workflow.findExpenseForUpdate.mockResolvedValue(null);
+    const useCase = new SubmitExpenseUseCase(tx, workflow, bandRepo(), employeeRepo());
+
+    await expect(useCase.execute(2, 50, { userId: 10, isOwner: false })).rejects.toThrow("Expense not found");
+    expect(workflow.updateStatus).not.toHaveBeenCalled();
+  });
+});
+
+describe("approving and posting expenses", () => {
+  function setup(options: { expense?: Expense; storedPayments?: ExpensePayment[]; bands?: ExpenseApprovalBand[] } = {}) {
+    const tx = txManager();
+    const workflow = workflowRepo(options.expense ?? makeExpense({ status: ExpenseStatus.SUBMITTED }));
+    const bands = bandRepo(options.bands ?? [makeBand()]);
+    const employees = employeeRepo();
+    const payments = {
+      findByExpenseId: jest.fn().mockResolvedValue(options.storedPayments ?? [payment([
+        { method: PaymentMethod.CASH, accountId: 5, amount: 600, date: new Date("2026-08-20"), description: null }
+      ])])
+    } as any;
+    const accountTx = { executeBatch: jest.fn().mockResolvedValue(undefined) } as any;
+    const loanTx = { executeBatch: jest.fn().mockResolvedValue(undefined) } as any;
+    const partners = { findByIdForUpdate: jest.fn() } as any;
+    const useCase = new ApproveExpenseUseCase(tx, workflow, bands, employees, payments, accountTx, loanTx, partners);
+    return { tx, workflow, bands, employees, payments, accountTx, loanTx, partners, useCase };
+  }
+
+  it("posts a stored cash payment and then marks the expense approved", async () => {
+    const s = setup();
+
+    const result = await s.useCase.execute(2, 50, { userId: 20, isOwner: false });
+
+    expect(result).toEqual({ expenseId: 50, status: ExpenseStatus.APPROVED });
+    expect(s.payments.findByExpenseId).toHaveBeenCalledWith(2, 50, expect.anything());
+    expect(s.accountTx.executeBatch).toHaveBeenCalledTimes(1);
+    const posted = s.accountTx.executeBatch.mock.calls[0][0][0].toPrimitives();
+    expect(posted).toEqual(expect.objectContaining({ accountId: 5, amount: -600, sourceType: "EXPENSE_PAYMENT", sourceId: 70 }));
+    expect(s.workflow.updateStatus).toHaveBeenCalledWith(2, 50, ExpenseStatus.APPROVED, expect.anything());
+  });
+
+  it("records the approver's role and the expense amount in history", async () => {
+    const s = setup();
+
+    await s.useCase.execute(2, 50, { userId: 20, isOwner: false });
+
+    const decision = s.workflow.addDecision.mock.calls[0][0].toPrimitives();
+    expect(decision).toEqual(expect.objectContaining({
+      action: ExpenseApprovalAction.APPROVED,
+      actorUserId: 20,
+      actorRoleId: 8,
+      amount: 600
+    }));
+  });
+
+  it("posts a partner payment through the loan ledger", async () => {
+    const stored = payment([
+      { method: PaymentMethod.PARTNER, partnerId: 33, amount: 600, date: new Date("2026-08-20"), description: "Partner covered it" }
+    ]);
+    const s = setup({ storedPayments: [stored] });
+    s.partners.findByIdForUpdate.mockResolvedValue({ id: 33, toPrimitives: () => ({ id: 33, loanBalance: 0 }) });
+
+    await s.useCase.execute(2, 50, { userId: 20, isOwner: false });
+
+    expect(s.partners.findByIdForUpdate).toHaveBeenCalledWith(2, 33, expect.anything());
+    expect(s.loanTx.executeBatch).toHaveBeenCalledTimes(1);
+    const loan = s.loanTx.executeBatch.mock.calls[0][0][0];
+    expect(loan).toEqual(expect.objectContaining({ partnerId: 33, amount: -600, sourceId: 50, createdBy: 10 }));
+    expect(s.accountTx.executeBatch).not.toHaveBeenCalled();
+  });
+
+  it("posts mixed payment lines without changing their amounts", async () => {
+    const stored = payment([
+      { method: PaymentMethod.CASH, accountId: 5, amount: 200, date: new Date("2026-08-20") },
+      { method: PaymentMethod.BANK, accountId: 6, amount: 150, date: new Date("2026-08-20") },
+      { method: PaymentMethod.PARTNER, partnerId: 33, amount: 250, date: new Date("2026-08-20") }
+    ]);
+    const s = setup({ storedPayments: [stored] });
+    s.partners.findByIdForUpdate.mockResolvedValue({ id: 33, toPrimitives: () => ({ id: 33, loanBalance: 0 }) });
+
+    await s.useCase.execute(2, 50, { userId: 20, isOwner: false });
+
+    const accountAmounts = s.accountTx.executeBatch.mock.calls[0][0].map((t: any) => t.toPrimitives().amount);
+    expect(accountAmounts).toEqual([-200, -150]);
+    expect(s.loanTx.executeBatch.mock.calls[0][0][0].amount).toBe(-250);
+  });
+
+  it("does not post when stored payment intent is missing", async () => {
+    const s = setup({ storedPayments: [] });
+
+    await expect(s.useCase.execute(2, 50, { userId: 20, isOwner: false }))
+      .rejects.toThrow("Stored expense payments do not equal total expense amount");
+
+    expect(s.accountTx.executeBatch).not.toHaveBeenCalled();
+    expect(s.loanTx.executeBatch).not.toHaveBeenCalled();
+    expect(s.workflow.updateStatus).not.toHaveBeenCalled();
+  });
+
+  it("does not post when stored payment intent no longer totals to the expense", async () => {
+    const s = setup({ storedPayments: [payment([
+      { method: PaymentMethod.CASH, accountId: 5, amount: 599, date: new Date("2026-08-20") }
+    ])] });
+
+    await expect(s.useCase.execute(2, 50, { userId: 20, isOwner: false }))
+      .rejects.toThrow("Stored expense payments do not equal total expense amount");
+
+    expect(s.accountTx.executeBatch).not.toHaveBeenCalled();
+    expect(s.workflow.updateStatus).not.toHaveBeenCalled();
+  });
+
+  it("leaves state unchanged when account posting fails", async () => {
+    const s = setup();
+    s.accountTx.executeBatch.mockRejectedValue(new Error("account write failed"));
+
+    await expect(s.useCase.execute(2, 50, { userId: 20, isOwner: false }))
+      .rejects.toThrow("account write failed");
+
+    expect(s.workflow.updateStatus).not.toHaveBeenCalled();
+    expect(s.workflow.addDecision).not.toHaveBeenCalled();
+  });
+
+  it("leaves state unchanged when partner posting fails", async () => {
+    const s = setup({ storedPayments: [payment([
+      { method: PaymentMethod.PARTNER, partnerId: 33, amount: 600, date: new Date("2026-08-20") }
+    ])] });
+    s.partners.findByIdForUpdate.mockResolvedValue({ id: 33, toPrimitives: () => ({ id: 33, loanBalance: 0 }) });
+    s.loanTx.executeBatch.mockRejectedValue(new Error("loan write failed"));
+
+    await expect(s.useCase.execute(2, 50, { userId: 20, isOwner: false }))
+      .rejects.toThrow("loan write failed");
+
+    expect(s.workflow.updateStatus).not.toHaveBeenCalled();
+    expect(s.workflow.addDecision).not.toHaveBeenCalled();
+  });
+
+  it("never reads or posts payment intent when the approver is the creator", async () => {
+    const s = setup();
+
+    await expect(s.useCase.execute(2, 50, { userId: 10, isOwner: false }))
+      .rejects.toThrow("cannot approve or reject their own expense");
+
+    expect(s.payments.findByExpenseId).not.toHaveBeenCalled();
+    expect(s.accountTx.executeBatch).not.toHaveBeenCalled();
+  });
+
+  it("lets an owner approve someone else's submitted expense without approval bands", async () => {
+    const s = setup({ bands: [] });
+
+    await expect(s.useCase.execute(2, 50, { userId: 99, isOwner: true })).resolves.toEqual({
+      expenseId: 50,
+      status: ExpenseStatus.APPROVED
+    });
+    expect(s.bands.list).not.toHaveBeenCalled();
+    expect(s.employees.findByUserId).not.toHaveBeenCalled();
+  });
+
+  it("does not approve the same expense after it is already approved", async () => {
+    const s = setup({ expense: makeExpense({ status: ExpenseStatus.APPROVED }) });
+
+    await expect(s.useCase.execute(2, 50, { userId: 20, isOwner: false }))
+      .rejects.toThrow("Only submitted expenses can be approved or rejected");
+
+    expect(s.payments.findByExpenseId).not.toHaveBeenCalled();
+    expect(s.accountTx.executeBatch).not.toHaveBeenCalled();
+  });
+});
+
+describe("rejecting expenses", () => {
+  it("moves a submitted expense to rejected and saves the trimmed reason", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo(makeExpense({ status: ExpenseStatus.SUBMITTED }));
+    const useCase = new RejectExpenseUseCase(tx, workflow, bandRepo(), employeeRepo());
+
+    const result = await useCase.execute(2, 50, { userId: 20, isOwner: false }, "  receipt is missing  ");
+
+    expect(result).toEqual({ expenseId: 50, status: ExpenseStatus.REJECTED });
+    expect(workflow.updateStatus).toHaveBeenCalledWith(2, 50, ExpenseStatus.REJECTED, expect.anything());
+    expect(workflow.addDecision.mock.calls[0][0].toPrimitives()).toEqual(expect.objectContaining({
+      action: ExpenseApprovalAction.REJECTED,
+      actorUserId: 20,
+      actorRoleId: 8,
+      reason: "receipt is missing"
+    }));
+  });
+
+  it("rejects an empty reason before changing state", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo(makeExpense({ status: ExpenseStatus.SUBMITTED }));
+    const useCase = new RejectExpenseUseCase(tx, workflow, bandRepo(), employeeRepo());
+
+    await expect(useCase.execute(2, 50, { userId: 20, isOwner: false }, "   "))
+      .rejects.toThrow("Rejection reason is required");
+
+    expect(workflow.updateStatus).not.toHaveBeenCalled();
+    expect(workflow.addDecision).not.toHaveBeenCalled();
+  });
+
+  it("allows an owner to reject another user's submitted expense without bands", async () => {
+    const tx = txManager();
+    const workflow = workflowRepo(makeExpense({ status: ExpenseStatus.SUBMITTED }));
+    const bands = bandRepo([]);
+    const employees = employeeRepo();
+    const useCase = new RejectExpenseUseCase(tx, workflow, bands, employees);
+
+    await useCase.execute(2, 50, { userId: 99, isOwner: true }, "Duplicate request");
+
+    expect(bands.list).not.toHaveBeenCalled();
+    expect(employees.findByUserId).not.toHaveBeenCalled();
+    expect(workflow.updateStatus).toHaveBeenCalled();
+  });
+});
+
+describe("approval history", () => {
+  it("returns stored decisions in repository order", async () => {
+    const first = ExpenseApprovalDecision.hydrate({
+      id: 1,
+      companyId: 2,
+      expenseId: 50,
+      action: ExpenseApprovalAction.SUBMITTED,
+      actorUserId: 10,
+      actorRoleId: 8,
+      amount: 600,
+      reason: null,
+      createdAt: new Date("2026-08-20T12:00:00Z")
+    });
+    const second = ExpenseApprovalDecision.hydrate({
+      id: 2,
+      companyId: 2,
+      expenseId: 50,
+      action: ExpenseApprovalAction.APPROVED,
+      actorUserId: 20,
+      actorRoleId: 8,
+      amount: 600,
+      reason: null,
+      createdAt: new Date("2026-08-20T13:00:00Z")
+    });
+    const workflow = workflowRepo();
+    workflow.listDecisions.mockResolvedValue([first, second]);
+    const expenses = { findById: jest.fn().mockResolvedValue(makeExpense()) } as any;
+    const useCase = new GetExpenseApprovalHistoryUseCase(workflow, expenses);
+
+    const result = await useCase.execute(2, 50);
+
+    expect(result.map((d) => d.action)).toEqual([ExpenseApprovalAction.SUBMITTED, ExpenseApprovalAction.APPROVED]);
+  });
+
+  it("does not expose another company's expense history", async () => {
+    const workflow = workflowRepo();
+    const expenses = { findById: jest.fn().mockResolvedValue(null) } as any;
+    const useCase = new GetExpenseApprovalHistoryUseCase(workflow, expenses);
+
+    await expect(useCase.execute(2, 50)).rejects.toThrow("Expense not found");
+    expect(workflow.listDecisions).not.toHaveBeenCalled();
+  });
+});
+
+describe("recording an expense that requires approval", () => {
+  function setupRecorder() {
+    const tx = txManager();
+    const expenses = {
+      save: jest.fn(async (e: Expense) => Expense.hydrate({ ...e.toPrimitives(), id: 50 }))
+    } as any;
+    const payments = {
+      savePayment: jest.fn(async (p: ExpensePayment) => ExpensePayment.hydrate({ ...p.toPrimitives(), id: 70 }))
+    } as any;
+    const accountTx = { executeBatch: jest.fn() } as any;
+    const loanTx = { executeBatch: jest.fn() } as any;
+    const partners = { findByIdForUpdate: jest.fn() } as any;
+    const useCase = new RecordExpenseUseCase(tx, expenses, payments, accountTx, loanTx, partners);
+    return { tx, expenses, payments, accountTx, loanTx, partners, useCase };
+  }
+
+  const input = {
+    companyId: 2,
+    expenseDate: new Date("2026-08-20"),
+    reason: "Generator service",
+    expenseType: ExpenseType.WORK,
+    totalAmount: 600,
+    createdBy: 10,
+    payments: [
+      { method: PaymentMethod.CASH, accountId: 5, amount: 600, date: new Date("2026-08-20") }
+    ]
+  };
+
+  it("stores approval-required payment lines as intent without posting them", async () => {
+    const s = setupRecorder();
+
+    const result = await s.useCase.execute({ ...input, requiresApproval: true });
+
+    expect(result).toEqual({ expenseId: 50, status: ExpenseStatus.DRAFT });
+    expect(s.payments.savePayment).toHaveBeenCalledTimes(1);
+    expect(s.accountTx.executeBatch).not.toHaveBeenCalled();
+    expect(s.loanTx.executeBatch).not.toHaveBeenCalled();
+  });
+
+  it("persists approval-required expenses as drafts", async () => {
+    const s = setupRecorder();
+
+    await s.useCase.execute({ ...input, requiresApproval: true });
+
+    const saved = s.expenses.save.mock.calls[0][0] as Expense;
+    expect(saved.requiresApproval).toBe(true);
+    expect(saved.status).toBe(ExpenseStatus.DRAFT);
+  });
+
+  it("keeps the legacy response and immediate account posting when approval is not requested", async () => {
+    const s = setupRecorder();
+
+    const result = await s.useCase.execute(input);
+
+    expect(result).toEqual({ expenseId: 50 });
+    expect(s.accountTx.executeBatch).toHaveBeenCalledTimes(1);
+    const saved = s.expenses.save.mock.calls[0][0] as Expense;
+    expect(saved.requiresApproval).toBe(false);
+    expect(saved.status).toBe(ExpenseStatus.POSTED);
+  });
+});
