+import {
+  listExpenseApprovalBandsSchema,
+  recordExpenseSchema,
+  rejectExpenseSchema,
+  setExpenseApprovalBandsSchema
+} from "../ExpenseSchemas";
+
+const expenseBody = {
+  expenseDate: "2026-08-20",
+  reason: "Generator service",
+  expenseType: "WORK",
+  totalAmount: 600,
+  payments: [
+    { method: "CASH", accountId: 5, amount: 600, date: "2026-08-20" }
+  ]
+};
+
+describe("expense approval request schemas", () => {
+  it("defaults requiresApproval to false for existing callers", () => {
+    expect(recordExpenseSchema.parse(expenseBody).requiresApproval).toBe(false);
+  });
+
+  it("accepts requiresApproval true", () => {
+    expect(recordExpenseSchema.parse({ ...expenseBody, requiresApproval: true }).requiresApproval).toBe(true);
+  });
+
+  it("rejects non-boolean requiresApproval values", () => {
+    expect(recordExpenseSchema.safeParse({ ...expenseBody, requiresApproval: "yes" }).success).toBe(false);
+  });
+
+  it("accepts an empty band list so a role can be cleared", () => {
+    expect(setExpenseApprovalBandsSchema.parse({ bands: [] })).toEqual({ bands: [] });
+  });
+
+  it("accepts an unbounded band with a null maximum", () => {
+    const result = setExpenseApprovalBandsSchema.parse({
+      bands: [{
+        minAmount: 1000,
+        maxAmount: null,
+        canSubmit: false,
+        canApprove: true,
+        canReject: true
+      }]
+    });
+    expect(result.bands[0].maxAmount).toBeNull();
+  });
+
+  it("requires all three action flags on each band", () => {
+    expect(setExpenseApprovalBandsSchema.safeParse({
+      bands: [{ minAmount: 0, maxAmount: 100, canSubmit: true, canApprove: true }]
+    }).success).toBe(false);
+  });
+
+  it("rejects a negative band minimum before application validation", () => {
+    expect(setExpenseApprovalBandsSchema.safeParse({
+      bands: [{ minAmount: -1, maxAmount: 100, canSubmit: true, canApprove: false, canReject: false }]
+    }).success).toBe(false);
+  });
+
+  it("rejects a negative finite maximum", () => {
+    expect(setExpenseApprovalBandsSchema.safeParse({
+      bands: [{ minAmount: 0, maxAmount: -1, canSubmit: true, canApprove: false, canReject: false }]
+    }).success).toBe(false);
+  });
+
+  it("coerces a roleId query parameter to a positive number", () => {
+    expect(listExpenseApprovalBandsSchema.parse({ roleId: "8" }).roleId).toBe(8);
+  });
+
+  it("normalizes an omitted roleId filter the same way as other optional query ids", () => {
+    expect(listExpenseApprovalBandsSchema.parse({}).roleId).toBeNull();
+  });
+
+  it("rejects zero as a roleId filter", () => {
+    expect(listExpenseApprovalBandsSchema.safeParse({ roleId: "0" }).success).toBe(false);
+  });
+
+  it("trims a rejection reason", () => {
+    expect(rejectExpenseSchema.parse({ reason: "  missing receipt  " }).reason).toBe("missing receipt");
+  });
+
+  it("rejects an empty rejection reason", () => {
+    expect(rejectExpenseSchema.safeParse({ reason: "   " }).success).toBe(false);
+  });
+
+  it("accepts a rejection reason of exactly 1000 characters", () => {
+    expect(rejectExpenseSchema.safeParse({ reason: "x".repeat(1000) }).success).toBe(true);
+  });
+
+  it("rejects a rejection reason longer than 1000 characters", () => {
+    expect(rejectExpenseSchema.safeParse({ reason: "x".repeat(1001) }).success).toBe(false);
+  });
+});
