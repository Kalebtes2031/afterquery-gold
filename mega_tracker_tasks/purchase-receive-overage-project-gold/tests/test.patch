+import { DocumentStatus, PurchaseOrder, PurchaseOrderItem, ReceiveOption } from "../PurchaseOrder";
+import { ValidationError } from "../../../../shared/domain/DomainError";
+import { createPurchaseOrderSchema, recordPurchaseReceiveSchema } from "../../presentation/PurchaseSchemas";
+
+const makeItem = (over: Partial<any> = {}) => PurchaseOrderItem.hydrate({
+  id: 11,
+  purchaseOrderId: 7,
+  productId: 101,
+  quantityOrdered: 100,
+  unitCost: 2,
+  subtotalCost: 200,
+  quantityReceived: 0,
+  quantityRemaining: 100,
+  ...over,
+});
+
+const makeOrder = (over: Partial<any> = {}, items: PurchaseOrderItem[] = [makeItem()]) => PurchaseOrder.hydrate({
+  id: 7,
+  companyId: 1,
+  supplierId: 4,
+  orderNo: "PO-TOL-1",
+  orderDate: new Date("2026-07-01T00:00:00.000Z"),
+  expectedReceiveDate: null,
+  receiveOption: ReceiveOption.RECEIVE_LATER,
+  receiveOverageTolerancePercent: 5,
+  branchId: 2,
+  note: null,
+  totalItemsCost: items.reduce((sum, item) => sum + item.subtotalCost, 0),
+  totalPaidAmount: 0,
+  status: DocumentStatus.OPEN,
+  createdBy: 9,
+  createdAt: new Date("2026-07-01T00:00:00.000Z"),
+  items,
+  ...over,
+} as any);
+
+const createPayload = (over: Record<string, unknown> = {}) => ({
+  supplierId: 4,
+  orderNo: "PO-TOL-1",
+  orderDate: "2026-07-01T00:00:00.000Z",
+  receiveOption: "RECEIVE_LATER",
+  branchId: 2,
+  items: [{ productId: 101, quantityOrdered: 100, unitCost: 2 }],
+  ...over,
+});
+
+describe("purchase receive overage domain behavior", () => {
+  it("defaults a newly created purchase order to zero receive overage tolerance", () => {
+    const order = PurchaseOrder.create({
+      companyId: 1,
+      supplierId: 4,
+      orderNo: "PO-DEFAULT",
+      orderDate: new Date(),
+      receiveOption: ReceiveOption.RECEIVE_LATER,
+      branchId: 2,
+    }, [{ productId: 101, quantityOrdered: 10, unitCost: 2 }]);
+
+    expect(order.toPrimitives().receiveOverageTolerancePercent).toBe(0);
+  });
+
+  it("rejects a negative receive overage tolerance in the purchase order domain", () => {
+    expect(() => PurchaseOrder.create({
+      companyId: 1,
+      supplierId: 4,
+      orderNo: "PO-NEG",
+      orderDate: new Date(),
+      receiveOption: ReceiveOption.RECEIVE_LATER,
+      branchId: 2,
+      receiveOverageTolerancePercent: -0.01,
+    } as any, [{ productId: 101, quantityOrdered: 10, unitCost: 2 }])).toThrow(ValidationError);
+  });
+
+  it("rejects a receive overage tolerance above one hundred percent", () => {
+    expect(() => PurchaseOrder.create({
+      companyId: 1,
+      supplierId: 4,
+      orderNo: "PO-HIGH",
+      orderDate: new Date(),
+      receiveOption: ReceiveOption.RECEIVE_LATER,
+      branchId: 2,
+      receiveOverageTolerancePercent: 100.000001,
+    } as any, [{ productId: 101, quantityOrdered: 10, unitCost: 2 }])).toThrow(/tolerance/i);
+  });
+
+  it("accepts an over-receipt exactly at a five percent cumulative limit", () => {
+    const item = makeItem();
+    (item.recordReceive as any)(105, 5);
+    expect(item.quantityReceived).toBe(105);
+  });
+
+  it("clamps ordered remaining to zero when a tolerated overage is accepted", () => {
+    const item = makeItem();
+    (item.recordReceive as any)(105, 5);
+    expect(item.quantityRemaining).toBe(0);
+  });
+
+  it("rejects a receipt one micro-unit beyond the configured tolerance", () => {
+    const item = makeItem();
+    expect(() => (item.recordReceive as any)(105.000001, 5)).toThrow(/tolerance/i);
+  });
+
+  it("uses the original ordered quantity as the tolerance base after a partial receipt", () => {
+    const item = makeItem({ quantityReceived: 90, quantityRemaining: 10 });
+    (item.recordReceive as any)(15, 5);
+    expect(item.quantityReceived).toBe(105);
+  });
+
+  it("does not compound tolerance from the shrinking remaining quantity", () => {
+    const item = makeItem({ quantityReceived: 90, quantityRemaining: 10 });
+    expect(() => (item.recordReceive as any)(15.000001, 5)).toThrow(/tolerance/i);
+  });
+
+  it("allows a decimal overage exactly on a ten percent boundary", () => {
+    const item = makeItem({ quantityOrdered: 7, subtotalCost: 14, quantityRemaining: 7 });
+    (item.recordReceive as any)(7.7, 10);
+    expect(item.quantityReceived).toBe(7.7);
+  });
+
+  it("rounds cumulative receive math to six decimal places", () => {
+    const item = makeItem({ quantityOrdered: 3, subtotalCost: 6, quantityReceived: 2, quantityRemaining: 1 });
+    (item.recordReceive as any)(1.1000004, 3.333333);
+    expect(item.quantityReceived).toBe(3.1);
+  });
+
+  it("reports the full receivable quantity including tolerance before any receipt", () => {
+    const item = makeItem();
+    expect((item as any).receivableQuantity(5)).toBe(105);
+  });
+
+  it("reports only the unused cumulative allowance after prior receipts", () => {
+    const item = makeItem({ quantityReceived: 99, quantityRemaining: 1 });
+    expect((item as any).receivableQuantity(5)).toBe(6);
+  });
+
+  it("reports zero receivable quantity after the tolerance cap has been consumed", () => {
+    const item = makeItem({ quantityReceived: 105, quantityRemaining: 0 });
+    expect((item as any).receivableQuantity(5)).toBe(0);
+  });
+
+  it("exposes a purchase-order receive allowance using the stored tolerance", () => {
+    const order = makeOrder();
+    const allowance = (order as any).getReceiveAllowance();
+    expect(allowance.tolerancePercent).toBe(5);
+    expect(allowance.items[0].maximumReceivableTotal).toBe(105);
+    expect(allowance.items[0].quantityReceivable).toBe(105);
+  });
+
+  it("includes original remaining and tolerated availability as separate allowance values", () => {
+    const order = makeOrder({}, [makeItem({ quantityReceived: 90, quantityRemaining: 10 })]);
+    const item = (order as any).getReceiveAllowance().items[0];
+    expect(item.quantityRemaining).toBe(10);
+    expect(item.quantityReceivable).toBe(15);
+  });
+
+  it("shows already received overage separately from ordered remaining", () => {
+    const order = makeOrder({}, [makeItem({ quantityReceived: 103, quantityRemaining: 0 })]);
+    const item = (order as any).getReceiveAllowance().items[0];
+    expect(item.overageReceived).toBe(3);
+    expect(item.quantityRemaining).toBe(0);
+  });
+
