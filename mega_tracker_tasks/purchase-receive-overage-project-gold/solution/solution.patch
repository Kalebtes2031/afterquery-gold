new file mode 100644
index 0000000..a52fccf
--- /dev/null
+++ b/db/migrations/035_purchase_receive_overage_tolerance.sql
@@ -0,0 +1,66 @@
+-- Keep purchase receiving limits stable for the lifetime of each order.
+-- Existing orders retain the strict historical behavior with a zero-percent tolerance.
+ALTER TABLE purchase_order
+  ADD COLUMN IF NOT EXISTS receive_overage_tolerance_percent NUMERIC(8, 6) NOT NULL DEFAULT 0;
+
+ALTER TABLE purchase_order
+  DROP CONSTRAINT IF EXISTS purchase_order_receive_overage_tolerance_percent_check;
+
+ALTER TABLE purchase_order
+  ADD CONSTRAINT purchase_order_receive_overage_tolerance_percent_check
+  CHECK (
+    receive_overage_tolerance_percent >= 0
+    AND receive_overage_tolerance_percent <= 100
+  );
+
+-- The application performs the friendly preflight check, but keep the same
+-- cumulative invariant at the database boundary as protection for future
+-- import jobs or repository code that updates purchase_order_item directly.
+CREATE OR REPLACE FUNCTION enforce_purchase_receive_overage_limit()
+RETURNS TRIGGER
+LANGUAGE plpgsql
+AS $$
+DECLARE
+  tolerance_percent NUMERIC;
+  maximum_total NUMERIC;
+BEGIN
+  SELECT receive_overage_tolerance_percent
+    INTO tolerance_percent
+    FROM purchase_order
+   WHERE id = NEW.purchase_order_id;
+
+  IF tolerance_percent IS NULL THEN
+    tolerance_percent := 0;
+  END IF;
+
+  maximum_total := ROUND(
+    NEW.quantity_ordered * (1 + tolerance_percent / 100.0),
+    6
+  );
+
+  IF ROUND(NEW.quantity_received, 6) > maximum_total THEN
+    RAISE EXCEPTION
+      'purchase receive quantity % exceeds maximum % for order item %',
+      NEW.quantity_received,
+      maximum_total,
+      NEW.id
+      USING ERRCODE = '23514';
+  END IF;
+
+  NEW.quantity_received := ROUND(NEW.quantity_received, 6);
+  NEW.quantity_remaining := ROUND(
+    GREATEST(0::numeric, NEW.quantity_ordered - NEW.quantity_received),
+    6
+  );
+
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_purchase_receive_overage_limit ON purchase_order_item;
+
+CREATE TRIGGER trg_purchase_receive_overage_limit
+BEFORE INSERT OR UPDATE OF quantity_ordered, quantity_received, quantity_remaining
+ON purchase_order_item
+FOR EACH ROW
+EXECUTE FUNCTION enforce_purchase_receive_overage_limit();
