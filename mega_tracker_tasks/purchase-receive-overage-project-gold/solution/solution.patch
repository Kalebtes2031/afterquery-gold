diff --git a/src/modules/purchases/domain/PurchaseReceivePolicy.ts b/src/modules/purchases/domain/PurchaseReceivePolicy.ts
new file mode 100644
index 0000000..c1f6112
--- /dev/null
+++ b/src/modules/purchases/domain/PurchaseReceivePolicy.ts
@@ -0,0 +1,237 @@
+import { ValidationError } from "../../../shared/domain/DomainError";
+
+/**
+ * Purchase quantities are stored as PostgreSQL numeric values but become
+ * JavaScript numbers in the domain. Keeping all receive-limit arithmetic at a
+ * fixed precision prevents tiny binary floating point differences from
+ * turning a boundary receipt into an overage.
+ */
+export const RECEIVE_QUANTITY_DECIMAL_PLACES = 6;
+export const MAX_RECEIVE_OVERAGE_TOLERANCE_PERCENT = 100;
+
+const QUANTITY_SCALE = 10 ** RECEIVE_QUANTITY_DECIMAL_PLACES;
+
+export interface PurchaseReceiveAllowanceInput {
+  quantityOrdered: number;
+  quantityReceived: number;
+  quantityRequested: number;
+  tolerancePercent?: number | null;
+}
+
+
+export interface PurchaseReceiveOrderLineSnapshot {
+  purchaseOrderItemId?: number;
+  productId: number;
+  quantityOrdered: number;
+  quantityReceived: number;
+}
+
+export interface PurchaseReceiveOrderLineAllowance {
+  purchaseOrderItemId?: number;
+  productId: number;
+  quantityOrdered: number;
+  quantityReceived: number;
+  quantityRemaining: number;
+  toleranceQuantity: number;
+  maximumReceivableTotal: number;
+  quantityReceivable: number;
+  overageReceived: number;
+  atOrderedQuantity: boolean;
+  atToleranceLimit: boolean;
+}
+
+export interface PurchaseReceiveOrderAllowance {
+  tolerancePercent: number;
+  canReceive: boolean;
+  totalOrdered: number;
+  totalReceived: number;
+  totalRemaining: number;
+  totalReceivable: number;
+  totalOverageReceived: number;
+  items: PurchaseReceiveOrderLineAllowance[];
+}
+
+export interface PurchaseReceiveAllowance {
+  quantityOrdered: number;
+  quantityReceivedBefore: number;
+  quantityRequested: number;
+  quantityReceivedAfter: number;
+  orderedRemainingBefore: number;
+  orderedRemainingAfter: number;
+  tolerancePercent: number;
+  toleranceQuantity: number;
+  maximumReceivableTotal: number;
+  availableWithinToleranceBefore: number;
+  overageAfter: number;
+  exceedsTolerance: boolean;
+}
+
+/**
+ * Pure receiving math shared by purchase creation and later receipt posting.
+ *
+ * The tolerance is deliberately calculated from the original ordered
+ * quantity, never from the shrinking remaining quantity. This means a 5%
+ * tolerance on an order line for 100 units always caps cumulative receipts at
+ * 105, regardless of how many partial receipts are posted.
+ */
+export class PurchaseReceivePolicy {
+  static roundQuantity(value: number): number {
+    if (!Number.isFinite(value)) {
+      throw new ValidationError("Receive quantity must be a finite number");
+    }
+
+    // Number.EPSILON helps values such as 1.005 land on the expected side of
+    // the integer rounding boundary without changing the six-decimal contract.
+    const adjusted = value >= 0 ? value + Number.EPSILON : value - Number.EPSILON;
+    return Math.round(adjusted * QUANTITY_SCALE) / QUANTITY_SCALE;
+  }
+
+  static normalizeTolerancePercent(value?: number | null): number {
+    const tolerance = value ?? 0;
+    if (!Number.isFinite(tolerance) || tolerance < 0 || tolerance > MAX_RECEIVE_OVERAGE_TOLERANCE_PERCENT) {
+      throw new ValidationError(
+        `Receive overage tolerance must be between 0 and ${MAX_RECEIVE_OVERAGE_TOLERANCE_PERCENT} percent`
+      );
+    }
+    return this.roundQuantity(tolerance);
+  }
+
+  static calculateMaximumReceivableTotal(quantityOrdered: number, tolerancePercent?: number | null): number {
+    this.assertOrderedQuantity(quantityOrdered);
+    const tolerance = this.normalizeTolerancePercent(tolerancePercent);
+    const toleranceQuantity = quantityOrdered * (tolerance / 100);
+    return this.roundQuantity(quantityOrdered + toleranceQuantity);
+  }
+
+  static calculateAvailableWithinTolerance(
+    quantityOrdered: number,
+    quantityReceived: number,
+    tolerancePercent?: number | null
+  ): number {
+    this.assertOrderedQuantity(quantityOrdered);
+    this.assertAlreadyReceivedQuantity(quantityReceived);
+    const maximum = this.calculateMaximumReceivableTotal(quantityOrdered, tolerancePercent);
+    return this.roundQuantity(Math.max(0, maximum - this.roundQuantity(quantityReceived)));
+  }
+
+  static evaluate(input: PurchaseReceiveAllowanceInput): PurchaseReceiveAllowance {
+    this.assertOrderedQuantity(input.quantityOrdered);
+    this.assertAlreadyReceivedQuantity(input.quantityReceived);
+    this.assertRequestedQuantity(input.quantityRequested);
+
+    const quantityOrdered = this.roundQuantity(input.quantityOrdered);
+    const quantityReceivedBefore = this.roundQuantity(input.quantityReceived);
+    const quantityRequested = this.roundQuantity(input.quantityRequested);
+    const tolerancePercent = this.normalizeTolerancePercent(input.tolerancePercent);
+    const toleranceQuantity = this.roundQuantity(quantityOrdered * (tolerancePercent / 100));
+    const maximumReceivableTotal = this.roundQuantity(quantityOrdered + toleranceQuantity);
+    const availableWithinToleranceBefore = this.roundQuantity(
+      Math.max(0, maximumReceivableTotal - quantityReceivedBefore)
+    );
+    const quantityReceivedAfter = this.roundQuantity(quantityReceivedBefore + quantityRequested);
+    const orderedRemainingBefore = this.roundQuantity(
+      Math.max(0, quantityOrdered - quantityReceivedBefore)
+    );
+    const orderedRemainingAfter = this.roundQuantity(
+      Math.max(0, quantityOrdered - quantityReceivedAfter)
+    );
+    const overageAfter = this.roundQuantity(
+      Math.max(0, quantityReceivedAfter - quantityOrdered)
+    );
+
+    return {
+      quantityOrdered,
+      quantityReceivedBefore,
+      quantityRequested,
+      quantityReceivedAfter,
+      orderedRemainingBefore,
+      orderedRemainingAfter,
+      tolerancePercent,
+      toleranceQuantity,
+      maximumReceivableTotal,
+      availableWithinToleranceBefore,
+      overageAfter,
+      exceedsTolerance: quantityReceivedAfter > maximumReceivableTotal
+    };
+  }
+
+  static summarizeOrder(
+    lines: PurchaseReceiveOrderLineSnapshot[],
+    tolerancePercent?: number | null,
+    canReceive: boolean = true
+  ): PurchaseReceiveOrderAllowance {
+    const tolerance = this.normalizeTolerancePercent(tolerancePercent);
+    const items = lines.map((line): PurchaseReceiveOrderLineAllowance => {
+      this.assertOrderedQuantity(line.quantityOrdered);
+      this.assertAlreadyReceivedQuantity(line.quantityReceived);
+
+      const quantityOrdered = this.roundQuantity(line.quantityOrdered);
+      const quantityReceived = this.roundQuantity(line.quantityReceived);
+      const maximumReceivableTotal = this.calculateMaximumReceivableTotal(quantityOrdered, tolerance);
+      const toleranceQuantity = this.roundQuantity(maximumReceivableTotal - quantityOrdered);
+      const mathematicalReceivable = this.calculateAvailableWithinTolerance(
+        quantityOrdered,
+        quantityReceived,
+        tolerance
+      );
+      const quantityRemaining = this.roundQuantity(Math.max(0, quantityOrdered - quantityReceived));
+      const overageReceived = this.roundQuantity(Math.max(0, quantityReceived - quantityOrdered));
+
+      return {
+        purchaseOrderItemId: line.purchaseOrderItemId,
+        productId: line.productId,
+        quantityOrdered,
+        quantityReceived,
+        quantityRemaining,
+        toleranceQuantity,
+        maximumReceivableTotal,
+        quantityReceivable: canReceive ? mathematicalReceivable : 0,
+        overageReceived,
+        atOrderedQuantity: quantityReceived >= quantityOrdered,
+        atToleranceLimit: quantityReceived >= maximumReceivableTotal
+      };
+    });
+
+    const sum = (selector: (item: PurchaseReceiveOrderLineAllowance) => number): number =>
+      this.roundQuantity(items.reduce((total, item) => total + selector(item), 0));
+
+    return {
+      tolerancePercent: tolerance,
+      canReceive,
+      totalOrdered: sum((item) => item.quantityOrdered),
+      totalReceived: sum((item) => item.quantityReceived),
+      totalRemaining: sum((item) => item.quantityRemaining),
+      totalReceivable: sum((item) => item.quantityReceivable),
+      totalOverageReceived: sum((item) => item.overageReceived),
+      items
+    };
+  }
+
+  static assertCanReceive(input: PurchaseReceiveAllowanceInput): PurchaseReceiveAllowance {
+    const allowance = this.evaluate(input);
+    if (allowance.exceedsTolerance) {
+      throw new ValidationError(
+        `Cannot receive ${allowance.quantityRequested} units; only ${allowance.availableWithinToleranceBefore} remain within the ${allowance.tolerancePercent}% receive tolerance`
+      );
+    }
+    return allowance;
+  }
+
+  private static assertOrderedQuantity(value: number): void {
+    if (!Number.isFinite(value) || value <= 0) {
+      throw new ValidationError("Quantity ordered must be greater than zero");
+    }
+  }
+
+  private static assertAlreadyReceivedQuantity(value: number): void {
+    if (!Number.isFinite(value) || value < 0) {
+      throw new ValidationError("Quantity already received cannot be negative");
+    }
+  }
+
+  private static assertRequestedQuantity(value: number): void {
+    if (!Number.isFinite(value) || value <= 0) {
+      throw new ValidationError("Receive quantity must be positive");
+    }
+  }
+}
