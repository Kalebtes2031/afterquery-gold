+import * as financeUseCases from "../ListFinanceUseCase";
+import { Account } from "../../../accounts/domain/Account";
+import { AccountTransaction } from "../../domain/AccountTransaction";
+import { EntityNotFoundError } from "../../../../shared/domain/DomainError";
+
+function account(overrides: Record<string, unknown> = {}) {
+  return Account.hydrate({
+    id: 1,
+    companyId: 7,
+    accountHolderName: "Operating Account",
+    accountNumber: "001",
+    bankName: "Example Bank",
+    bankBranch: null,
+    accountType: "BANK",
+    openingBalance: 100,
+    balance: 100,
+    isActive: true,
+    createdAt: new Date("2026-01-01T00:00:00.000Z"),
+    ...overrides,
+  } as any);
+}
+
+function transaction(
+  amount: number,
+  overrides: Record<string, unknown> = {}
+) {
+  return AccountTransaction.hydrate({
+    id: 1,
+    companyId: 7,
+    accountId: 1,
+    date: new Date("2026-02-01T00:00:00.000Z"),
+    amount,
+    balanceBefore: null,
+    balanceAfter: null,
+    description: "movement",
+    sourceType: "SALE_PAYMENT",
+    sourceId: null,
+    performedBy: null,
+    createdAt: new Date("2026-02-01T00:00:00.000Z"),
+    ...overrides,
+  } as any);
+}
+
+function reportUseCase(accountRepo: any, accountTxRepo: any) {
+  const Constructor = (financeUseCases as any).GetAccountBalanceReconciliationUseCase;
+  expect(Constructor).toBeDefined();
+  return new Constructor(accountRepo, accountTxRepo);
+}
+
+function repairUseCase(accountRepo: any, accountTxRepo: any, txManager: any) {
+  const Constructor = (financeUseCases as any).ReconcileAccountBalanceUseCase;
+  expect(Constructor).toBeDefined();
+  return new Constructor(accountRepo, accountTxRepo, txManager);
+}
+
+function immediateTransactionManager(client: any = { transaction: "client" }) {
+  return {
+    run: jest.fn(async (callback: (client: any) => Promise<any>) => callback(client)),
+  };
+}
+
+function standardReportRepos(accounts: Account[], transactions: AccountTransaction[]) {
+  return {
+    accountRepo: {
+      findById: jest.fn(async (_companyId: number, id: number) =>
+        accounts.find((item) => item.id === id) ?? null
+      ),
+      listByCompany: jest.fn(async () => accounts),
+    },
+    accountTxRepo: {
+      listForReconciliation: jest.fn(async () => transactions),
+    },
+  };
+}
+
+describe("current account balance read behavior", () => {
