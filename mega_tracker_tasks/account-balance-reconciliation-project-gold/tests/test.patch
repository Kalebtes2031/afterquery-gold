+import * as schemas from "../FinanceSchemas";
+
+function reconciliationSchema() {
+  const schema = (schemas as any).accountReconciliationQuerySchema;
+  expect(schema).toBeDefined();
+  return schema;
+}
+
+describe("account reconciliation query behavior", () => {
+  it("defaults a missing accountId to null", () => {
+    const parsed = reconciliationSchema().parse({});
+    expect(parsed.accountId).toBeNull();
+  });
+
+  it("defaults driftOnly to false", () => {
+    const parsed = reconciliationSchema().parse({});
+    expect(parsed.driftOnly).toBe(false);
+  });
+
+  it("coerces a positive accountId query string", () => {
+    const parsed = reconciliationSchema().parse({ accountId: "42" });
+    expect(parsed.accountId).toBe(42);
+  });
+
+  it("accepts an already numeric positive accountId", () => {
+    const parsed = reconciliationSchema().parse({ accountId: 8 });
+    expect(parsed.accountId).toBe(8);
+  });
+
+  it("treats an empty accountId as omitted", () => {
+    const parsed = reconciliationSchema().parse({ accountId: "" });
+    expect(parsed.accountId).toBeNull();
+  });
+
+  it("treats a null accountId as omitted", () => {
+    const parsed = reconciliationSchema().parse({ accountId: null });
+    expect(parsed.accountId).toBeNull();
+  });
+
+  it("rejects zero as an accountId", () => {
+    expect(() => reconciliationSchema().parse({ accountId: "0" })).toThrow();
+  });
+
+  it("rejects a negative accountId", () => {
+    expect(() => reconciliationSchema().parse({ accountId: "-4" })).toThrow();
+  });
+
+  it("rejects a fractional accountId", () => {
+    expect(() => reconciliationSchema().parse({ accountId: "2.5" })).toThrow();
+  });
+
+  it("rejects a non-numeric accountId", () => {
+    expect(() => reconciliationSchema().parse({ accountId: "bank" })).toThrow();
+  });
+
+  it("parses driftOnly=true", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: "true" });
+    expect(parsed.driftOnly).toBe(true);
+  });
+
+  it("parses driftOnly=false", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: "false" });
+    expect(parsed.driftOnly).toBe(false);
+  });
+
+  it("parses driftOnly=1 as true", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: "1" });
+    expect(parsed.driftOnly).toBe(true);
+  });
+
+  it("parses driftOnly=0 as false", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: "0" });
+    expect(parsed.driftOnly).toBe(false);
+  });
+
+  it("accepts a boolean true value", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: true });
+    expect(parsed.driftOnly).toBe(true);
+  });
+
+  it("accepts a boolean false value", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: false });
+    expect(parsed.driftOnly).toBe(false);
+  });
+
+  it("treats an empty driftOnly query as false", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: "" });
+    expect(parsed.driftOnly).toBe(false);
+  });
+
+  it("treats a null driftOnly query as false", () => {
+    const parsed = reconciliationSchema().parse({ driftOnly: null });
+    expect(parsed.driftOnly).toBe(false);
+  });
+
+  it("rejects an arbitrary driftOnly word", () => {
+    expect(() => reconciliationSchema().parse({ driftOnly: "yes" })).toThrow();
+  });
+
+  it("rejects uppercase TRUE instead of silently widening accepted values", () => {
+    expect(() => reconciliationSchema().parse({ driftOnly: "TRUE" })).toThrow();
+  });
+
+  it("rejects an array supplied for driftOnly", () => {
+    expect(() => reconciliationSchema().parse({ driftOnly: ["true", "false"] })).toThrow();
+  });
+
+  it("parses accountId and driftOnly together", () => {
+    const parsed = reconciliationSchema().parse({ accountId: "17", driftOnly: "true" });
+    expect(parsed).toEqual({ accountId: 17, driftOnly: true });
+  });
+
+  it("keeps accountId null while enabling driftOnly", () => {
+    const parsed = reconciliationSchema().parse({ accountId: "", driftOnly: "1" });
+    expect(parsed).toEqual({ accountId: null, driftOnly: true });
+  });
+});
