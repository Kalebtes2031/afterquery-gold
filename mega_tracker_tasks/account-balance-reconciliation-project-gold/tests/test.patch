+      listForReconciliation: jest.fn().mockResolvedValue([
+        transaction(300, { accountId: 2 }),
+        transaction(10, { id: 2, accountId: 1 }),
+      ]),
+    };
+
+    const result = await repairUseCase(
+      accountRepo,
+      accountTxRepo,
+      immediateTransactionManager()
+    ).execute(7, 1);
+
+    expect(result.ledgerBalance).toBe(85);
+  });
+
+  it("normalizes repaired balances to cents", async () => {
+    const acc = account({ openingBalance: 0.1, balance: 9 });
+    const accountRepo = {
+      findByIdWithLock: jest.fn().mockResolvedValue(acc),
+      save: jest.fn(),
+    };
+    const accountTxRepo = {
+      listForReconciliation: jest.fn().mockResolvedValue([transaction(0.2)]),
+    };
+
+    const result = await repairUseCase(
+      accountRepo,
+      accountTxRepo,
+      immediateTransactionManager()
+    ).execute(7, 1);
+
+    expect(result.ledgerBalance).toBe(0.3);
+    expect(result.balance).toBe(0.3);
+    expect(acc.balance).toBe(0.3);
+  });
+
+  it("propagates a ledger read failure and never saves a guessed balance", async () => {
+    const acc = account({ balance: 500 });
+    const accountRepo = {
+      findByIdWithLock: jest.fn().mockResolvedValue(acc),
+      save: jest.fn(),
+    };
+    const accountTxRepo = {
+      listForReconciliation: jest.fn().mockRejectedValue(new Error("ledger unavailable")),
+    };
+
+    await expect(
+      repairUseCase(accountRepo, accountTxRepo, immediateTransactionManager()).execute(7, 1)
+    ).rejects.toThrow("ledger unavailable");
+
+    expect(accountRepo.save).not.toHaveBeenCalled();
+    expect(acc.balance).toBe(500);
+  });
+
+  it("propagates a persistence failure so the enclosing transaction can roll back", async () => {
+    const acc = account({ openingBalance: 10, balance: 500 });
+    const accountRepo = {
+      findByIdWithLock: jest.fn().mockResolvedValue(acc),
+      save: jest.fn().mockRejectedValue(new Error("write failed")),
+    };
+    const accountTxRepo = {
+      listForReconciliation: jest.fn().mockResolvedValue([transaction(5)]),
+    };
+
+    await expect(
+      repairUseCase(accountRepo, accountTxRepo, immediateTransactionManager()).execute(7, 1)
+    ).rejects.toThrow("write failed");
+  });
+
+  it("reports the pre-repair signed drift rather than zeroing the response after correction", async () => {
+    const acc = account({ openingBalance: 100, balance: 150 });
+    const accountRepo = {
+      findByIdWithLock: jest.fn().mockResolvedValue(acc),
+      save: jest.fn(),
+    };
+    const accountTxRepo = {
+      listForReconciliation: jest.fn().mockResolvedValue([transaction(20)]),
+    };
+
+    const result = await repairUseCase(
+      accountRepo,
+      accountTxRepo,
+      immediateTransactionManager()
+    ).execute(7, 1);
+
+    expect(result.drift).toBe(30);
+    expect(result.previousStoredBalance).toBe(150);
+    expect(result.balance).toBe(120);
+  });
+});
