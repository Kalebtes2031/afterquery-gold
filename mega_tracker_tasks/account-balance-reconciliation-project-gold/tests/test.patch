+    const acc = account({ openingBalance: 100, balance: 999 });
+    const accountRepo = { findById: jest.fn().mockResolvedValue(acc) };
+    const accountTxRepo = {
+      getBalance: jest.fn().mockResolvedValue(999),
+      listForReconciliation: jest.fn().mockResolvedValue([transaction(25)]),
+    };
+
+    const result = await new financeUseCases.GetAccountBalanceUseCase(
+      accountRepo as any,
+      accountTxRepo as any
+    ).execute(7, 1);
+
+    expect(result).toEqual({ balance: 125 });
+    expect(accountTxRepo.listForReconciliation).toHaveBeenCalledWith(7, [1]);
+  });
+
+  it("does not double count an OPENING_BALANCE row in the current balance read", async () => {
+    const acc = account({ openingBalance: 80, balance: 999 });
+    const accountRepo = { findById: jest.fn().mockResolvedValue(acc) };
+    const accountTxRepo = {
+      getBalance: jest.fn().mockResolvedValue(999),
+      listForReconciliation: jest.fn().mockResolvedValue([
+        transaction(80, { sourceType: "OPENING_BALANCE" }),
+        transaction(20, { id: 2 }),
+      ]),
+    };
+
+    const result = await new financeUseCases.GetAccountBalanceUseCase(
+      accountRepo as any,
+      accountTxRepo as any
+    ).execute(7, 1);
+
+    expect(result.balance).toBe(100);
+  });
+
+  it("supports legacy current-balance reads with no opening audit row", async () => {
