+    const accountRepo = { findById: jest.fn().mockResolvedValue(acc) };
+    const accountTxRepo = {
+      getBalance: jest.fn().mockResolvedValue(999),
+      listForReconciliation: jest.fn().mockResolvedValue([transaction(-10)]),
+    };
+
+    const result = await new financeUseCases.GetAccountBalanceUseCase(
+      accountRepo as any,
+      accountTxRepo as any
+    ).execute(7, 1);
+
+    expect(result.balance).toBe(65);
