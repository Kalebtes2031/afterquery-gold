@@ -0,0 +1,126 @@
+import { Account } from "../../accounts/domain/Account";
+import { AccountTransaction } from "./AccountTransaction";
+
+/**
+ * Reconciliation treats the account row as a cached/denormalized balance and
+ * the immutable opening balance plus ledger movements as the source of truth.
+ * OPENING_BALANCE transactions are audit rows for the opening amount, so they
+ * must never be added a second time during reconstruction.
+ */
+export interface AccountBalanceReconciliationItem {
+  accountId: number;
+  accountHolderName: string;
+  accountType: "BANK" | "CASH";
+  isActive: boolean;
+  openingBalance: number;
+  storedBalance: number;
+  ledgerBalance: number;
+  drift: number;
+  inSync: boolean;
+}
+
+export interface AccountBalanceReconciliationSummary {
+  totalAccounts: number;
+  driftedAccounts: number;
+  storedTotal: number;
+  ledgerTotal: number;
+  netDrift: number;
+}
+
+export interface AccountBalanceReconciliationResult {
+  summary: AccountBalanceReconciliationSummary;
+  accounts: AccountBalanceReconciliationItem[];
+}
+
+export interface ReconcileAccountBalanceResult {
+  accountId: number;
+  previousStoredBalance: number;
+  ledgerBalance: number;
+  balance: number;
+  drift: number;
+  repaired: boolean;
+}
+
+/**
+ * PostgreSQL stores these monetary values at two decimal places. JavaScript
+ * arithmetic can still produce values such as 0.30000000000000004, so every
+ * externally observable reconciliation number is normalized to cents.
+ */
+export function roundMoney(value: number): number {
+  if (!Number.isFinite(value)) return value;
+  const nudged = value + Math.sign(value || 1) * Number.EPSILON;
+  return Math.round(nudged * 100) / 100;
+}
+
+export function reconstructLedgerBalance(
+  account: Account,
+  transactions: AccountTransaction[]
+): number {
+  const accountId = account.id;
+  let balance = Number(account.openingBalance);
+
+  for (const transaction of transactions) {
+    const props = transaction.toPrimitives();
+
+    // Reconciliation callers normally pre-filter by company/account, but the
+    // pure calculation deliberately refuses to let unrelated rows leak in.
+    if (accountId !== undefined && props.accountId !== accountId) continue;
+    if (props.companyId !== account.companyId) continue;
+
+    // Current accounts record their opening balance twice: once on account
+    // and once as an OPENING_BALANCE ledger audit row. The account field is
+    // immutable and is counted exactly once for both current and legacy data.
+    if (props.sourceType === "OPENING_BALANCE") continue;
+
+    balance = roundMoney(balance + Number(props.amount));
+  }
+
+  return roundMoney(balance);
+}
+
+export function buildAccountBalanceReconciliation(
+  account: Account,
+  transactions: AccountTransaction[]
+): AccountBalanceReconciliationItem {
+  if (account.id === undefined) {
+    throw new Error("Cannot reconcile an account without an id");
+  }
+
+  const ledgerBalance = reconstructLedgerBalance(account, transactions);
+  const storedBalance = roundMoney(Number(account.balance));
+  const drift = roundMoney(storedBalance - ledgerBalance);
+
+  return {
+    accountId: account.id,
+    accountHolderName: account.accountHolderName,
+    accountType: account.accountType,
+    isActive: account.isActive,
+    openingBalance: roundMoney(Number(account.openingBalance)),
+    storedBalance,
+    ledgerBalance,
+    drift,
+    inSync: drift === 0
+  };
+}
+
+export function summarizeAccountBalanceReconciliations(
+  items: AccountBalanceReconciliationItem[]
+): AccountBalanceReconciliationSummary {
+  let storedTotal = 0;
+  let ledgerTotal = 0;
+  let driftedAccounts = 0;
+
+  for (const item of items) {
+    storedTotal = roundMoney(storedTotal + item.storedBalance);
+    ledgerTotal = roundMoney(ledgerTotal + item.ledgerBalance);
+    if (!item.inSync) driftedAccounts += 1;
+  }
+
+  return {
+    totalAccounts: items.length,
+    driftedAccounts,
+    storedTotal: roundMoney(storedTotal),
+    ledgerTotal: roundMoney(ledgerTotal),
+    netDrift: roundMoney(storedTotal - ledgerTotal)
+  };
+}
