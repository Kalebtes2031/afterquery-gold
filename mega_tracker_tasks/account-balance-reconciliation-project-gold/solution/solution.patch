+export interface GetAccountBalanceReconciliationOptions {
+  accountId?: number | null;
+  driftOnly?: boolean;
+}
+
+/**
+ * Builds a company-scoped reconciliation view from immutable opening balances
+ * and account transaction amounts. The account.balance column is intentionally
+ * treated as a cached value so it can be compared rather than trusted.
+ */
+export class GetAccountBalanceReconciliationUseCase {
+  constructor(
+    private readonly accountRepo: AccountRepository,
+    private readonly accountTxRepo: AccountTransactionRepository
+  ) {}
+
+  async execute(
+    companyId: number,
+    options: GetAccountBalanceReconciliationOptions = {}
+  ): Promise<AccountBalanceReconciliationResult> {
+    const accounts = await this.loadAccounts(companyId, options.accountId ?? null);
+    const accountIds = accounts
+      .map(account => account.id)
+      .filter((id): id is number => id !== undefined);
+
+    const transactions = accountIds.length === 0
+      ? []
+      : await this.accountTxRepo.listForReconciliation(companyId, accountIds);
+
+    const transactionsByAccount = this.groupTransactions(companyId, transactions);
+    const reconciliations = accounts.map(account =>
+      buildAccountBalanceReconciliation(
+        account,
+        account.id === undefined ? [] : (transactionsByAccount.get(account.id) ?? [])
+      )
+    );
+
+    const summary = summarizeAccountBalanceReconciliations(reconciliations);
+    const visibleAccounts = options.driftOnly
+      ? reconciliations.filter(item => !item.inSync)
+      : reconciliations;
+
+    return {
+      summary,
+      accounts: visibleAccounts
+    };
+  }
+
+  private async loadAccounts(companyId: number, accountId: number | null) {
+    if (accountId !== null) {
+      const account = await this.accountRepo.findById(companyId, accountId);
+      if (!account) {
+        throw new EntityNotFoundError("Account not found");
+      }
+      return [account];
+    }
+
+    return this.accountRepo.listByCompany(companyId);
+  }
+
+  private groupTransactions(
+    companyId: number,
+    transactions: AccountTransaction[]
+  ): Map<number, AccountTransaction[]> {
+    const grouped = new Map<number, AccountTransaction[]>();
+
+    for (const transaction of transactions) {
+      const props = transaction.toPrimitives();
+      if (props.companyId !== companyId) continue;
+
+      const list = grouped.get(props.accountId) ?? [];
+      list.push(transaction);
+      grouped.set(props.accountId, list);
+    }
+
+    return grouped;
+  }
+}
