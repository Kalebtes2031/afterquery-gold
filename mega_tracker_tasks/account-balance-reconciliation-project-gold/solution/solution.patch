+  async listForReconciliation(
+    companyId: number,
+    accountIds?: number[] | null,
+    client?: PoolClient
+  ): Promise<AccountTransaction[]> {
+    if (accountIds && accountIds.length === 0) return [];
+
+    const db = client || pgPool;
+    const params: any[] = [companyId];
+    let query = `
+      SELECT *
+      FROM account_transaction
+      WHERE company_id = $1
+    `;
+
+    if (accountIds) {
+      params.push(accountIds);
+      query += ` AND account_id = ANY($2::bigint[])`;
+    }
+
+    query += ` ORDER BY account_id ASC, date ASC, id ASC`;
+
+    const result = await db.query(query, params);
+    return result.rows.map(mapRowToAccountTransaction);
+  }
+
   async getBalance(companyId: number, accountId: number, client?: PoolClient): Promise<number> {
     const db = client || pgPool;
     const result = await db.query(
-      `SELECT balance FROM account WHERE company_id = $1 AND id = $2`,
+      `SELECT
+         a.opening_balance + COALESCE(
+           SUM(
+             CASE
+               WHEN at.source_type = 'OPENING_BALANCE' THEN 0
+               ELSE at.amount
+             END
+           ),
+           0
+         ) AS balance
+       FROM account a
+       LEFT JOIN account_transaction at
+         ON at.company_id = a.company_id
+        AND at.account_id = a.id
+       WHERE a.company_id = $1 AND a.id = $2
+       GROUP BY a.id, a.opening_balance`,
       [companyId, accountId]
     );
+
     if (result.rowCount === 0) return 0;
     return parseFloat(result.rows[0].balance);
   }
