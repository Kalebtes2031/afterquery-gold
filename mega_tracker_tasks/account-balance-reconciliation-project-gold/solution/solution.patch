+/**
+ * Repairs only the denormalized account.balance field. The ledger itself is
+ * never rewritten and no synthetic transaction is created during a repair.
+ * The account row is locked before reconstruction so normal posting paths that
+ * also lock accounts cannot race the correction.
+ */
+export class ReconcileAccountBalanceUseCase {
+  constructor(
+    private readonly accountRepo: AccountRepository,
+    private readonly accountTxRepo: AccountTransactionRepository,
+    private readonly txManager: TransactionManager
+  ) {}
+
+  async execute(
+    companyId: number,
+    accountId: number
+  ): Promise<ReconcileAccountBalanceResult> {
+    return this.txManager.run(async client => {
+      const account = await this.accountRepo.findByIdWithLock(companyId, accountId, client);
+      if (!account) {
+        throw new EntityNotFoundError("Account not found");
+      }
+
+      const transactions = await this.accountTxRepo.listForReconciliation(
+        companyId,
+        [accountId],
+        client
+      );
+      const reconciliation = buildAccountBalanceReconciliation(account, transactions);
+      const previousStoredBalance = reconciliation.storedBalance;
+      const repaired = !reconciliation.inSync;
+
+      if (repaired) {
+        account.updateBalance(reconciliation.ledgerBalance);
+        await this.accountRepo.save(account, client);
+      }
+
+      return {
+        accountId,
+        previousStoredBalance,
+        ledgerBalance: reconciliation.ledgerBalance,
+        balance: roundMoney(account.balance),
+        drift: reconciliation.drift,
+        repaired
+      };
+    });
+  }
+}
