+/**
+ * @openapi
+ * /api/v1/finance/accounts/reconciliation:
+ *   get:
+ *     summary: Compare stored account balances with reconstructed ledger balances
+ *     tags:
+ *       - Finance
+ *     security:
+ *       - bearerAuth: []
+ *     parameters:
+ *       - in: query
+ *         name: accountId
+ *         required: false
+ *         schema:
+ *           type: integer
+ *           minimum: 1
+ *       - in: query
+ *         name: driftOnly
+ *         required: false
+ *         schema:
+ *           type: boolean
+ *           default: false
+ *     responses:
+ *       200:
+ *         description: Account balance reconciliation report
+ *         content:
+ *           application/json:
+ *             schema:
+ *               $ref: '#/components/schemas/AccountBalanceReconciliationReport'
+ *       404:
+ *         description: Filtered account not found
+ */
+FinanceRouter.get(
+  "/accounts/reconciliation",
+  requireAuth,
+  requirePermission(accessPolicy, "FINANCE", "view"),
+  async (req: Request, res: Response) => {
+    try {
+      const companyId = parseCompanyId(req);
+      const query = accountReconciliationQuerySchema.parse(req.query);
+      const result = await getAccountBalanceReconciliationUseCase.execute(companyId, {
+        accountId: query.accountId,
+        driftOnly: query.driftOnly
+      });
+      res.json(result);
+    } catch (err) {
+      sendErrorResponse(res, err);
+    }
+  }
+);
+
+/**
+ * @openapi
+ * /api/v1/finance/accounts/{id}/reconcile:
+ *   post:
+ *     summary: Repair a stored account balance from its ledger
+ *     tags:
+ *       - Finance
+ *     security:
+ *       - bearerAuth: []
+ *     parameters:
+ *       - in: path
+ *         name: id
+ *         required: true
+ *         schema:
+ *           type: integer
+ *           minimum: 1
+ *     responses:
+ *       200:
+ *         description: Reconciliation result
+ *         content:
+ *           application/json:
+ *             schema:
+ *               $ref: '#/components/schemas/AccountBalanceRepairResult'
+ *       404:
+ *         description: Account not found
+ */
+FinanceRouter.post(
+  "/accounts/:id/reconcile",
+  requireAuth,
+  requirePermission(accessPolicy, "FINANCE", "update"),
+  async (req: Request, res: Response) => {
+    try {
+      const companyId = parseCompanyId(req);
+      const accountId = Number(req.params.id);
+      const result = await reconcileAccountBalanceUseCase.execute(companyId, accountId);
+      res.json(result);
+    } catch (err) {
+      sendErrorResponse(res, err);
+    }
+  }
+);
