+ */
+PartnerRouter.put("/:id/credit-limit", requireAuth, requirePermission(accessPolicy, "PARTNERS", "update"), async (req: Request, res: Response) => {
+  try {
+    const companyId = parseCompanyId(req);
+    const partnerId = Number(req.params.id);
+    if (!partnerId || Number.isNaN(partnerId)) {
+      throw new ValidationError("Invalid partner id");
+    }
+    const body = partnerCreditLimitSchema.parse(req.body);
+    const result = await setPartnerCreditLimitUseCase.execute(companyId, partnerId, body.creditLimit);
+    res.json(result);
