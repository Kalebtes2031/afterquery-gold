diff --git a/src/modules/partners/application/PartnerCreditUseCases.ts b/src/modules/partners/application/PartnerCreditUseCases.ts
new file mode 100644
index 0000000..d4c0acb
--- /dev/null
+++ b/src/modules/partners/application/PartnerCreditUseCases.ts
@@ -0,0 +1,138 @@
+import { PoolClient } from "pg";
+import { EntityNotFoundError, ValidationError } from "../../../shared/domain/DomainError";
+import { Partner, PartnerRepository } from "../domain/Partner";
+import {
+  calculatePartnerCreditStatus,
+  normalizeMoney,
+  PartnerCreditDelta,
+  PartnerCreditExposureRepository,
+  PartnerCreditLimitExceededError,
+  PartnerCreditStatus,
+  validateCreditLimitValue,
+} from "../domain/PartnerCredit";
+
+export class GetPartnerCreditStatusUseCase {
+  constructor(private readonly creditRepository: PartnerCreditExposureRepository) {}
+
+  async execute(companyId: number, partnerId: number): Promise<PartnerCreditStatus> {
+    const components = await this.creditRepository.getComponents(companyId, partnerId);
+    if (!components) {
+      throw new EntityNotFoundError("Partner not found");
+    }
+    return calculatePartnerCreditStatus(components);
+  }
+}
+
+export class SetPartnerCreditLimitUseCase {
+  constructor(private readonly partnerRepository: PartnerRepository) {}
+
+  async execute(
+    companyId: number,
+    partnerId: number,
+    creditLimit: number | null
+  ): Promise<{ partnerId: number; creditLimit: number | null }> {
+    validateCreditLimitValue(creditLimit);
+
+    const partner = await this.partnerRepository.findById(companyId, partnerId);
+    if (!partner) {
+      throw new EntityNotFoundError("Partner not found");
+    }
+
+    partner.update({ creditLimit });
+    const saved = await this.partnerRepository.update(partner);
+    return {
+      partnerId: saved.id!,
+      creditLimit: saved.toPrimitives().creditLimit ?? null,
+    };
+  }
+}
+
+/**
+ * Serializes credit-increasing mutations on the partner row, then compares
+ * the current observable exposure with the net increase the workflow is
+ * about to commit. A workflow can submit multiple deltas for one partner;
+ * they are netted before the check so a same-transaction payment can offset
+ * a same-transaction increase.
+ */
+export class PartnerCreditLimitService {
+  constructor(
+    private readonly partnerRepository: PartnerRepository,
+    private readonly creditRepository: PartnerCreditExposureRepository
+  ) {}
+
+  async getStatus(
+    companyId: number,
+    partnerId: number,
+    client?: PoolClient
+  ): Promise<PartnerCreditStatus> {
+    const components = await this.creditRepository.getComponents(companyId, partnerId, client);
+    if (!components) {
+      throw new EntityNotFoundError("Partner not found");
+    }
+    return calculatePartnerCreditStatus(components);
+  }
+
+  async assertProjectedDeltas(
+    companyId: number,
+    deltas: PartnerCreditDelta[],
+    client: PoolClient
+  ): Promise<void> {
+    const aggregated = this.aggregateDeltas(deltas);
+    const positivePartnerIds = Array.from(aggregated.entries())
+      .filter(([, amount]) => amount > 0)
+      .map(([partnerId]) => partnerId)
+      .sort((a, b) => a - b);
+
+    for (const partnerId of positivePartnerIds) {
+      const delta = aggregated.get(partnerId)!;
+      const partner = await this.partnerRepository.findByIdForUpdate(companyId, partnerId, client);
+      if (!partner) {
+        throw new EntityNotFoundError("Partner not found");
+      }
+      await this.assertPartnerDelta(companyId, partner, delta, client);
+    }
+  }
+
+  private aggregateDeltas(deltas: PartnerCreditDelta[]): Map<number, number> {
+    const result = new Map<number, number>();
+    for (const delta of deltas) {
+      if (!Number.isInteger(delta.partnerId) || delta.partnerId <= 0) {
+        throw new ValidationError("Partner id must be a positive integer");
+      }
+      const amount = normalizeMoney(delta.amount);
+      result.set(delta.partnerId, normalizeMoney((result.get(delta.partnerId) ?? 0) + amount));
+    }
+    return result;
+  }
+
+  private async assertPartnerDelta(
+    companyId: number,
+    partner: Partner,
+    delta: number,
+    client: PoolClient
+  ): Promise<void> {
+    const creditLimit = partner.toPrimitives().creditLimit ?? null;
+    if (creditLimit == null || delta <= 0) {
+      return;
+    }
+
+    const components = await this.creditRepository.getComponents(companyId, partner.id!, client);
+    if (!components) {
+      throw new EntityNotFoundError("Partner not found");
+    }
+
+    const status = calculatePartnerCreditStatus({
+      ...components,
+      creditLimit,
+    });
+    const projectedExposure = normalizeMoney(status.exposure + delta);
+    if (projectedExposure > creditLimit) {
+      throw new PartnerCreditLimitExceededError(
+        partner.id!,
+        creditLimit,
+        status.exposure,
+        projectedExposure
+      );
+    }
+  }
+}
