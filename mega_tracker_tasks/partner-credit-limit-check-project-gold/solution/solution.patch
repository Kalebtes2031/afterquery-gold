@@ -0,0 +1,61 @@
+import { PoolClient } from "pg";
+import { pgPool } from "../../../shared/infrastructure/db/pgPool";
+import {
+  PartnerCreditComponents,
+  PartnerCreditExposureRepository,
+} from "../domain/PartnerCredit";
+
+export class PgPartnerCreditExposureRepository implements PartnerCreditExposureRepository {
+  async getComponents(
+    companyId: number,
+    partnerId: number,
+    client?: PoolClient
+  ): Promise<PartnerCreditComponents | null> {
+    const db = client || pgPool;
+    const result = await db.query(
+      `WITH sales AS (
+         SELECT
+           so.customer_id AS partner_id,
+           COALESCE(SUM(so.total_items_price), 0)::numeric AS open_sales,
+           COALESCE(SUM(so.total_paid_amount), 0)::numeric AS payments
+         FROM sale_order so
+         WHERE so.company_id = $1
+           AND so.customer_id = $2
+           AND so.status <> 'CANCELLED'
+         GROUP BY so.customer_id
+       ),
+       loans AS (
+         SELECT
+           lt.partner_id,
+           COALESCE(SUM(lt.amount), 0)::numeric AS loan_amount
+         FROM loan_transaction lt
+         WHERE lt.company_id = $1
+           AND lt.partner_id = $2
+           AND lt.source_type NOT IN ('SALE', 'PURCHASE', 'PAYMENT')
+         GROUP BY lt.partner_id
+       )
+       SELECT
+         p.id AS partner_id,
+         p.credit_limit,
+         COALESCE(s.open_sales, 0) AS open_sales,
+         COALESCE(l.loan_amount, 0) AS loans,
+         COALESCE(s.payments, 0) AS payments
+       FROM partner p
+       LEFT JOIN sales s ON s.partner_id = p.id
+       LEFT JOIN loans l ON l.partner_id = p.id
+       WHERE p.company_id = $1
+         AND p.id = $2`,
+      [companyId, partnerId]
+    );
+
+    if (result.rowCount === 0) return null;
+    const row = result.rows[0];
+    return {
+      partnerId: Number(row.partner_id),
+      creditLimit: row.credit_limit == null ? null : Number(row.credit_limit),
+      openSales: Number(row.open_sales),
+      loans: Number(row.loans),
+      payments: Number(row.payments),
+    };
+  }
+}
