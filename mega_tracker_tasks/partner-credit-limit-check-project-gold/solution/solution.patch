diff --git a/src/modules/partners/domain/PartnerCredit.ts b/src/modules/partners/domain/PartnerCredit.ts
new file mode 100644
index 0000000..f347221
--- /dev/null
+++ b/src/modules/partners/domain/PartnerCredit.ts
@@ -0,0 +1,97 @@
+import { PoolClient } from "pg";
+import { DomainError, ValidationError } from "../../../shared/domain/DomainError";
+
+export interface PartnerCreditComponents {
+  partnerId: number;
+  creditLimit: number | null;
+  openSales: number;
+  loans: number;
+  payments: number;
+}
+
+export interface PartnerCreditStatus extends PartnerCreditComponents {
+  exposure: number;
+  availableCredit: number | null;
+  overLimit: boolean;
+}
+
+export interface PartnerCreditExposureRepository {
+  getComponents(
+    companyId: number,
+    partnerId: number,
+    client?: PoolClient
+  ): Promise<PartnerCreditComponents | null>;
+}
+
+export interface PartnerCreditDelta {
+  partnerId: number;
+  amount: number;
+}
+
+export class PartnerCreditLimitExceededError extends DomainError {
+  readonly code = "PARTNER_CREDIT_LIMIT_EXCEEDED";
+  readonly status = 409;
+
+  constructor(
+    readonly partnerId: number,
+    readonly creditLimit: number,
+    readonly currentExposure: number,
+    readonly projectedExposure: number
+  ) {
+    super(
+      `Partner ${partnerId} credit limit ${creditLimit.toFixed(2)} would be exceeded by projected exposure ${projectedExposure.toFixed(2)}`
+    );
+  }
+}
+
+export function normalizeMoney(value: number): number {
+  if (!Number.isFinite(value)) {
+    throw new ValidationError("Credit amounts must be finite numbers");
+  }
+  return Math.round((value + Number.EPSILON) * 100) / 100;
+}
+
+export function calculatePartnerCreditStatus(
+  components: PartnerCreditComponents
+): PartnerCreditStatus {
+  const openSales = normalizeMoney(components.openSales);
+  const loans = normalizeMoney(components.loans);
+  const payments = normalizeMoney(components.payments);
+  const creditLimit = components.creditLimit == null
+    ? null
+    : normalizeMoney(components.creditLimit);
+
+  if (creditLimit != null && creditLimit < 0) {
+    throw new ValidationError("Credit limit cannot be negative");
+  }
+
+  const rawExposure = normalizeMoney(openSales + loans - payments);
+  const exposure = Math.max(0, rawExposure);
+  const availableCredit = creditLimit == null
+    ? null
+    : normalizeMoney(creditLimit - exposure);
+
+  return {
+    partnerId: components.partnerId,
+    creditLimit,
+    openSales,
+    loans,
+    payments,
+    exposure,
+    availableCredit,
+    overLimit: creditLimit != null && exposure > creditLimit,
+  };
+}
+
+export function validateCreditLimitValue(value: number | null): void {
+  if (value == null) return;
+  if (!Number.isFinite(value)) {
+    throw new ValidationError("Credit limit must be a finite number or null");
+  }
+  if (value < 0) {
+    throw new ValidationError("Credit limit cannot be negative");
+  }
+  if (Math.abs(Math.round(value * 100) - value * 100) > 1e-8) {
+    throw new ValidationError("Credit limit can have at most two decimal places");
+  }
+}
