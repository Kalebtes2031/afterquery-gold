+describe("partner credit status application behavior", () => {
+  it("returns calculated status for a company partner", async () => {
+    const repo: any = {
+      getComponents: jest.fn().mockResolvedValue(makeComponents(8, 500, 300, 50, 100)),
+    };
+    const result = await new GetPartnerCreditStatusUseCase(repo).execute(2, 8);
+    expect(repo.getComponents).toHaveBeenCalledWith(2, 8);
+    expect(result).toMatchObject({
+      partnerId: 8,
+      creditLimit: 500,
+      exposure: 250,
+      availableCredit: 250,
+      overLimit: false,
+    });
+  });
+
+  it("returns over-limit status without rejecting reads", async () => {
+    const repo: any = {
+      getComponents: jest.fn().mockResolvedValue(makeComponents(8, 200, 300, 25, 50)),
+    };
+    const result = await new GetPartnerCreditStatusUseCase(repo).execute(2, 8);
+    expect(result.exposure).toBe(275);
+    expect(result.overLimit).toBe(true);
+    expect(result.availableCredit).toBe(-75);
+  });
+
+  it("throws not found when the partner is outside the company", async () => {
+    const repo: any = { getComponents: jest.fn().mockResolvedValue(null) };
