+describe("partner credit limit guard behavior", () => {
+  function setup(limit = 500, exposure = 200) {
+    const partnerRepo: any = {
+      findByIdForUpdate: jest.fn((_companyId: number, partnerId: number) =>
+        Promise.resolve(makePartner(partnerId, limit))
+      ),
+    };
+    const creditRepo: any = {
+      getComponents: jest.fn((_companyId: number, partnerId: number) =>
+        Promise.resolve(makeComponents(partnerId, limit, exposure, 0, 0))
+      ),
+    };
+    return {
+      partnerRepo,
+      creditRepo,
+      service: new PartnerCreditLimitService(partnerRepo, creditRepo),
+      client: {} as any,
+    };
+  }
+
+  it("admits a projected increase below the ceiling", async () => {
+    const s = setup(500, 200);
+    await expect(
+      s.service.assertProjectedDeltas(1, [{ partnerId: 7, amount: 299.99 }], s.client)
+    ).resolves.toBeUndefined();
+  });
+
+  it("admits a projected increase exactly at the ceiling", async () => {
+    const s = setup(500, 200);
+    await expect(
+      s.service.assertProjectedDeltas(1, [{ partnerId: 7, amount: 300 }], s.client)
+    ).resolves.toBeUndefined();
+  });
+
+  it("rejects a projected increase above the ceiling with the stable conflict error", async () => {
+    const s = setup(500, 200);
+    await expect(
+      s.service.assertProjectedDeltas(1, [{ partnerId: 7, amount: 300.01 }], s.client)
+    ).rejects.toMatchObject({
+      code: "PARTNER_CREDIT_LIMIT_EXCEEDED",
+      status: 409,
+      currentExposure: 200,
+      projectedExposure: 500.01,
+    });
+  });
+
+  it("does not block a partner merely because existing exposure is over the lowered limit when delta is nonpositive", async () => {
+    const s = setup(100, 200);
+    await expect(
+      s.service.assertProjectedDeltas(1, [{ partnerId: 7, amount: -10 }], s.client)
+    ).resolves.toBeUndefined();
+    expect(s.partnerRepo.findByIdForUpdate).not.toHaveBeenCalled();
+  });
+
+  it("does not lock or query partners for a zero net delta", async () => {
+    const s = setup(100, 90);
+    await s.service.assertProjectedDeltas(
+      1,
+      [
+        { partnerId: 7, amount: 25 },
+        { partnerId: 7, amount: -25 },
+      ],
+      s.client
+    );
+    expect(s.partnerRepo.findByIdForUpdate).not.toHaveBeenCalled();
+    expect(s.creditRepo.getComponents).not.toHaveBeenCalled();
+  });
+
+  it("nets multiple changes for one partner before comparing the ceiling", async () => {
+    const s = setup(100, 80);
+    await s.service.assertProjectedDeltas(
+      1,
+      [
+        { partnerId: 7, amount: 30 },
+        { partnerId: 7, amount: -15 },
+      ],
+      s.client
+    );
+    expect(s.partnerRepo.findByIdForUpdate).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects the combined increase when individual changes would each fit", async () => {
+    const s = setup(100, 50);
+    await expect(
+      s.service.assertProjectedDeltas(
+        1,
+        [
+          { partnerId: 7, amount: 30 },
+          { partnerId: 7, amount: 25 },
+        ],
+        s.client
+      )
+    ).rejects.toBeInstanceOf(PartnerCreditLimitExceededError);
+  });
+
+  it("checks different partners independently", async () => {
+    const s = setup(100, 10);
+    await s.service.assertProjectedDeltas(
+      1,
+      [
+        { partnerId: 7, amount: 20 },
+        { partnerId: 9, amount: 30 },
+      ],
+      s.client
+    );
+    expect(s.partnerRepo.findByIdForUpdate).toHaveBeenCalledTimes(2);
+    expect(s.creditRepo.getComponents).toHaveBeenCalledTimes(2);
+  });
+
+  it("locks positive-delta partners in id order", async () => {
+    const s = setup(100, 0);
+    await s.service.assertProjectedDeltas(
+      1,
+      [
+        { partnerId: 9, amount: 10 },
+        { partnerId: 2, amount: 10 },
+        { partnerId: 6, amount: 10 },
+      ],
+      s.client
+    );
+    expect(s.partnerRepo.findByIdForUpdate.mock.calls.map((call: unknown[]) => call[1])).toEqual([2, 6, 9]);
+  });
+
+  it("skips the exposure query for an unlimited partner", async () => {
+    const s = setup(500, 200);
+    s.partnerRepo.findByIdForUpdate.mockResolvedValue(makePartner(7, null));
+    await s.service.assertProjectedDeltas(1, [{ partnerId: 7, amount: 100000 }], s.client);
+    expect(s.creditRepo.getComponents).not.toHaveBeenCalled();
+  });
+
+  it("throws not found when a positive-delta partner cannot be locked", async () => {
+    const s = setup();
+    s.partnerRepo.findByIdForUpdate.mockResolvedValue(null);
+    await expect(
+      s.service.assertProjectedDeltas(1, [{ partnerId: 404, amount: 1 }], s.client)
+    ).rejects.toBeInstanceOf(EntityNotFoundError);
+  });
+
+  it("throws not found when exposure disappears after the partner lock", async () => {
+    const s = setup();
+    s.creditRepo.getComponents.mockResolvedValue(null);
+    await expect(
+      s.service.assertProjectedDeltas(1, [{ partnerId: 7, amount: 1 }], s.client)
+    ).rejects.toBeInstanceOf(EntityNotFoundError);
+  });
+});
