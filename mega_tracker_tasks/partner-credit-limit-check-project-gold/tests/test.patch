+function salePaymentSetup(customerId = 11) {
+  const order = SaleOrder.hydrate({
+    id: 90,
+    companyId: 1,
+    customerId,
+    orderNo: "SO-90",
+    orderDate: new Date("2026-07-01"),
+    shipmentOption: ShipmentOption.SHIP_LATER,
+    branchId: 2,
+    totalItemsPrice: 100,
+    totalPaidAmount: 0,
+    profitAmount: 0,
+    status: DocumentStatus.OPEN,
+    items: [
+      SaleOrderItem.create({ productId: 1, quantityOrdered: 5, unitPrice: 20 }),
+    ],
+  });
+  const txManager: any = { run: jest.fn((op: (client: unknown) => unknown) => op({ tx: true })) };
+  const saleOrderRepo: any = {
+    findByIdForUpdate: jest.fn().mockResolvedValue(order),
+    update: jest.fn(),
+  };
+  const salePaymentRepo: any = {
