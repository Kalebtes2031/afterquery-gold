+const makePartner = (id: number, creditLimit: number | null = null, companyId = 1) =>
+  Partner.hydrate({
+    id,
+    companyId,
+    partnerNo: `PAR-${String(id).padStart(6, "0")}`,
+    fullName: `Partner ${id}`,
+    phone: `555-${id}`,
+    isCustomer: true,
+    isSupplier: false,
+    isLoanLender: false,
+    isLoanBorrower: false,
+    isWalkIn: false,
+    loanBalance: 0,
+    creditLimit,
+  });
+
+const makeComponents = (
+  partnerId: number,
+  creditLimit: number | null,
+  openSales = 0,
+  loans = 0,
+  payments = 0
+) => ({ partnerId, creditLimit, openSales, loans, payments });
