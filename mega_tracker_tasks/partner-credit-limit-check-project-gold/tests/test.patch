+  const accountTx: any = { execute: jest.fn() };
+  const loanTx: any = { execute: jest.fn() };
+  const credit: any = { assertProjectedDeltas: jest.fn().mockResolvedValue(undefined) };
+  const useCase = new RecordSalePaymentUseCase(
