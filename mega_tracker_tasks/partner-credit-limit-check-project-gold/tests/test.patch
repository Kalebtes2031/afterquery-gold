diff --git a/src/modules/partners/domain/__tests__/PartnerCreditLimit.behavior.test.ts b/src/modules/partners/domain/__tests__/PartnerCreditLimit.behavior.test.ts
new file mode 100644
index 0000000..263f519
--- /dev/null
+++ b/src/modules/partners/domain/__tests__/PartnerCreditLimit.behavior.test.ts
@@ -0,0 +1,255 @@
+import { Partner } from "../Partner";
+import {
+  calculatePartnerCreditStatus,
+  normalizeMoney,
+  PartnerCreditLimitExceededError,
+  validateCreditLimitValue,
+} from "../PartnerCredit";
+import { ValidationError } from "../../../../shared/domain/DomainError";
+
+const baseComponents = {
+  partnerId: 17,
+  creditLimit: 1000 as number | null,
+  openSales: 400,
+  loans: 100,
+  payments: 150,
+};
+
+const partner = (creditLimit: number | null = null) =>
+  Partner.hydrate({
+    id: 17,
+    companyId: 3,
+    partnerNo: "PAR-000017",
+    fullName: "Northwind Customer",
+    phone: "555-017",
+    isCustomer: true,
+    isSupplier: false,
+    isLoanLender: false,
+    isLoanBorrower: false,
+    isWalkIn: false,
+    loanBalance: 0,
+    creditLimit,
+  });
+
+describe("partner credit exposure calculation", () => {
+  it("uses open sales plus loans minus payments", () => {
+    const status = calculatePartnerCreditStatus(baseComponents);
+    expect(status.exposure).toBe(350);
+  });
+
+  it("floors a negative raw exposure at zero", () => {
+    const status = calculatePartnerCreditStatus({
+      ...baseComponents,
+      openSales: 50,
+      loans: -200,
+      payments: 25,
+    });
+    expect(status.exposure).toBe(0);
+  });
+
+  it("keeps each exposure component in the public result", () => {
+    const status = calculatePartnerCreditStatus(baseComponents);
+    expect(status).toMatchObject({
+      partnerId: 17,
+      openSales: 400,
+      loans: 100,
+      payments: 150,
+    });
+  });
+
+  it("reports remaining credit when the partner is under a limit", () => {
+    const status = calculatePartnerCreditStatus(baseComponents);
+    expect(status.availableCredit).toBe(650);
+    expect(status.overLimit).toBe(false);
+  });
+
+  it("allows exposure exactly equal to the configured limit", () => {
+    const status = calculatePartnerCreditStatus({
+      ...baseComponents,
+      creditLimit: 350,
+    });
+    expect(status.exposure).toBe(350);
+    expect(status.availableCredit).toBe(0);
+    expect(status.overLimit).toBe(false);
+  });
+
+  it("reports negative available credit when the stored exposure is already over limit", () => {
+    const status = calculatePartnerCreditStatus({
+      ...baseComponents,
+      creditLimit: 300,
+    });
+    expect(status.availableCredit).toBe(-50);
+    expect(status.overLimit).toBe(true);
+  });
+
+  it("uses null available credit for an unlimited partner", () => {
+    const status = calculatePartnerCreditStatus({
+      ...baseComponents,
+      creditLimit: null,
+    });
+    expect(status.availableCredit).toBeNull();
+    expect(status.overLimit).toBe(false);
+  });
+
+  it("rounds monetary arithmetic to cents", () => {
+    const status = calculatePartnerCreditStatus({
+      partnerId: 1,
+      creditLimit: 0.3,
+      openSales: 0.1,
+      loans: 0.2,
+      payments: 0,
+    });
+    expect(status.exposure).toBe(0.3);
+    expect(status.availableCredit).toBe(0);
+  });
+
+  it("rejects non-finite exposure inputs", () => {
+    expect(() =>
+      calculatePartnerCreditStatus({
+        ...baseComponents,
+        loans: Number.POSITIVE_INFINITY,
+      })
+    ).toThrow(ValidationError);
+  });
+
+  it("rejects a negative limit in a raw status calculation", () => {
+    expect(() =>
+      calculatePartnerCreditStatus({
+        ...baseComponents,
+        creditLimit: -1,
+      })
+    ).toThrow("Credit limit cannot be negative");
+  });
+});
+
+describe("partner credit limit value rules", () => {
+  it("accepts null as the no-limit setting", () => {
+    expect(() => validateCreditLimitValue(null)).not.toThrow();
+  });
+
+  it("accepts a zero credit limit", () => {
+    expect(() => validateCreditLimitValue(0)).not.toThrow();
+  });
+
+  it("accepts a positive amount with two decimals", () => {
+    expect(() => validateCreditLimitValue(1234.56)).not.toThrow();
+  });
+
+  it("rejects a negative credit limit", () => {
+    expect(() => validateCreditLimitValue(-0.01)).toThrow(ValidationError);
+  });
+
+  it("rejects a credit limit with more than two decimals", () => {
+    expect(() => validateCreditLimitValue(12.345)).toThrow(
+      "Credit limit can have at most two decimal places"
+    );
+  });
+
+  it("rejects NaN as a credit limit", () => {
+    expect(() => validateCreditLimitValue(Number.NaN)).toThrow(
+      "Credit limit must be a finite number or null"
+    );
+  });
+
+  it("rejects infinity as a credit limit", () => {
+    expect(() => validateCreditLimitValue(Number.POSITIVE_INFINITY)).toThrow(
+      ValidationError
+    );
+  });
+
+  it("normalizes regular monetary amounts to cents", () => {
+    expect(normalizeMoney(12.345)).toBe(12.35);
+  });
+
+  it("normalizes floating point addition artifacts", () => {
+    expect(normalizeMoney(0.1 + 0.2)).toBe(0.3);
+  });
+});
+
+describe("partner credit limit persistence on the domain object", () => {
+  it("hydrates an existing configured limit", () => {
+    expect(partner(750).toPrimitives().creditLimit).toBe(750);
+  });
+
+  it("hydrates an unlimited partner as null", () => {
+    expect(partner(null).toPrimitives().creditLimit).toBeNull();
+  });
+
+  it("defaults a newly created partner to unlimited credit", () => {
+    const created = Partner.create({
+      companyId: 3,
+      partnerNo: "PAR-000018",
+      fullName: "Fresh Partner",
+      phone: "555-018",
+      isCustomer: false,
+      isSupplier: false,
+      isLoanLender: false,
+      isLoanBorrower: false,
+      isWalkIn: false,
+    });
+    expect(created.toPrimitives().creditLimit).toBeNull();
+  });
+
+  it("allows a newly created partner to start with a limit", () => {
+    const created = Partner.create({
+      companyId: 3,
+      partnerNo: "PAR-000019",
+      fullName: "Limited Partner",
+      phone: "555-019",
+      isCustomer: true,
+      isSupplier: false,
+      isLoanLender: false,
+      isLoanBorrower: false,
+      isWalkIn: false,
+      creditLimit: 250,
+    });
+    expect(created.toPrimitives().creditLimit).toBe(250);
+  });
+
+  it("updates an existing limit", () => {
+    const subject = partner(500);
+    subject.update({ creditLimit: 325.5 });
+    expect(subject.toPrimitives().creditLimit).toBe(325.5);
+  });
+
+  it("clears an existing limit with null", () => {
+    const subject = partner(500);
+    subject.update({ creditLimit: null });
+    expect(subject.toPrimitives().creditLimit).toBeNull();
+  });
+
+  it("does not change the limit when an unrelated field is updated", () => {
+    const subject = partner(500);
+    subject.update({ fullName: "Renamed Partner" });
+    expect(subject.toPrimitives().creditLimit).toBe(500);
+  });
+
+  it("rejects an invalid limit during hydration", () => {
+    expect(() => partner(-1)).toThrow(ValidationError);
+  });
+
+  it("rejects an invalid limit during update without persisting it", () => {
+    const subject = partner(500);
+    expect(() => subject.update({ creditLimit: 4.567 })).toThrow(ValidationError);
+  });
+});
+
+describe("partner credit limit exceeded error contract", () => {
+  it("uses a conflict status and stable public code", () => {
+    const err = new PartnerCreditLimitExceededError(9, 100, 80, 120);
+    expect(err.status).toBe(409);
+    expect(err.code).toBe("PARTNER_CREDIT_LIMIT_EXCEEDED");
+  });
+
+  it("includes the partner and projected amount in its message", () => {
+    const err = new PartnerCreditLimitExceededError(9, 100, 80, 120);
+    expect(err.message).toContain("Partner 9");
+    expect(err.message).toContain("120.00");
+  });
+
+  it("retains the current and projected exposure values", () => {
+    const err = new PartnerCreditLimitExceededError(9, 100, 80, 120);
+    expect(err.currentExposure).toBe(80);
+    expect(err.projectedExposure).toBe(120);
+  });
+});
diff --git a/src/modules/partners/presentation/__tests__/PartnerCreditSchemas.behavior.test.ts b/src/modules/partners/presentation/__tests__/PartnerCreditSchemas.behavior.test.ts
