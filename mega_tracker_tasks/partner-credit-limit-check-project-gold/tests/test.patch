@@ -0,0 +1,64 @@
+import { partnerCreditLimitSchema } from "../PartnerSchemas";
+
+describe("partner credit limit request validation", () => {
+  it("accepts a positive integer limit", () => {
+    expect(partnerCreditLimitSchema.parse({ creditLimit: 1000 })).toEqual({ creditLimit: 1000 });
+  });
+
+  it("accepts a positive limit with cents", () => {
+    expect(partnerCreditLimitSchema.parse({ creditLimit: 1000.25 })).toEqual({ creditLimit: 1000.25 });
+  });
+
+  it("accepts zero as a hard no-credit ceiling", () => {
+    expect(partnerCreditLimitSchema.parse({ creditLimit: 0 })).toEqual({ creditLimit: 0 });
+  });
+
+  it("accepts null to clear the ceiling", () => {
+    expect(partnerCreditLimitSchema.parse({ creditLimit: null })).toEqual({ creditLimit: null });
+  });
+
+  it("requires the creditLimit property", () => {
+    const result = partnerCreditLimitSchema.safeParse({});
+    expect(result.success).toBe(false);
+  });
+
+  it("rejects a negative limit", () => {
+    const result = partnerCreditLimitSchema.safeParse({ creditLimit: -1 });
+    expect(result.success).toBe(false);
+    if (!result.success) {
+      expect(result.error.issues[0].message).toBe("Credit limit cannot be negative");
+    }
+  });
+
+  it("rejects a limit with more than two decimal places", () => {
+    const result = partnerCreditLimitSchema.safeParse({ creditLimit: 12.345 });
+    expect(result.success).toBe(false);
+    if (!result.success) {
+      expect(result.error.issues.some((issue) => issue.message.includes("two decimal"))).toBe(true);
+    }
+  });
+
+  it("rejects a numeric string instead of coercing it", () => {
+    expect(partnerCreditLimitSchema.safeParse({ creditLimit: "100" }).success).toBe(false);
+  });
+
+  it("rejects an empty string", () => {
+    expect(partnerCreditLimitSchema.safeParse({ creditLimit: "" }).success).toBe(false);
+  });
+
+  it("rejects NaN", () => {
+    expect(partnerCreditLimitSchema.safeParse({ creditLimit: Number.NaN }).success).toBe(false);
+  });
+
+  it("rejects positive infinity", () => {
+    expect(partnerCreditLimitSchema.safeParse({ creditLimit: Number.POSITIVE_INFINITY }).success).toBe(false);
+  });
+
+  it("rejects negative infinity", () => {
+    expect(partnerCreditLimitSchema.safeParse({ creditLimit: Number.NEGATIVE_INFINITY }).success).toBe(false);
+  });
+
+  it("strips unrelated request fields using the normal zod object behavior", () => {
+    expect(partnerCreditLimitSchema.parse({ creditLimit: 50, ignored: true })).toEqual({ creditLimit: 50 });
+  });
+});
