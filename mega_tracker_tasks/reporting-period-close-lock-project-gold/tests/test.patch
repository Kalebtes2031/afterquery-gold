diff --git a/src/modules/reporting/domain/__tests__/ReportingPeriodClose.behavior.test.ts b/src/modules/reporting/domain/__tests__/ReportingPeriodClose.behavior.test.ts
new file mode 100644
index 0000000..f3c74c0
--- /dev/null
+++ b/src/modules/reporting/domain/__tests__/ReportingPeriodClose.behavior.test.ts
@@ -0,0 +1,190 @@
+import { ValidationError } from "../../../../shared/domain/DomainError";
+import {
+  ReportingPeriodAlreadyClosedError,
+  ReportingPeriodCloseBlockedError,
+  ReportingPeriodClosedError,
+  ReportingPeriodState,
+  compareBusinessDates,
+  formatBusinessDate,
+  normalizeBusinessDate
+} from "../ReportingPeriodClose";
+
+describe("reporting period calendar-day rules", () => {
+  it("normalizes a timestamp to its UTC calendar day", () => {
+    const result = normalizeBusinessDate(new Date("2026-08-31T23:59:59.999Z"));
+    expect(result.toISOString()).toBe("2026-08-31T00:00:00.000Z");
+  });
+
+  it("formats a business date as YYYY-MM-DD", () => {
+    expect(formatBusinessDate(new Date("2026-02-03T15:20:00Z"))).toBe("2026-02-03");
+  });
+
+  it("compares two timestamps on the same business day as equal", () => {
+    expect(compareBusinessDates(
+      new Date("2026-07-15T00:01:00Z"),
+      new Date("2026-07-15T22:30:00Z")
+    )).toBe(0);
+  });
+
+  it("orders an earlier business day before a later day", () => {
+    expect(compareBusinessDates(new Date("2026-07-14"), new Date("2026-07-15"))).toBe(-1);
+  });
+
+  it("orders a later business day after an earlier day", () => {
+    expect(compareBusinessDates(new Date("2026-07-16"), new Date("2026-07-15"))).toBe(1);
+  });
+
+  it("rejects invalid Date objects instead of comparing them", () => {
+    expect(() => normalizeBusinessDate(new Date("not-a-date"))).toThrow(ValidationError);
+  });
+});
+
+describe("ReportingPeriodState", () => {
+  const record = () => ({
+    id: 9,
+    companyId: 12,
+    closedThrough: new Date("2026-08-31T18:00:00Z"),
+    closedAt: new Date("2026-09-02T10:11:12Z"),
+    closedBy: 44
+  });
+
+  it("represents a company with no close boundary as open", () => {
+    const state = ReportingPeriodState.open(12);
+    expect(state.toPrimitives()).toEqual({
+      companyId: 12,
+      closedThrough: null,
+      closedAt: null,
+      closedBy: null
+    });
+  });
+
+  it("never locks dates when the company has not closed a period", () => {
+    const state = ReportingPeriodState.open(12);
+    expect(state.isClosed(new Date("2001-01-01"))).toBe(false);
+    expect(() => state.assertOpen(new Date("2001-01-01"))).not.toThrow();
+  });
+
+  it("hydrates the current boundary and keeps close audit fields", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    const props = state.toPrimitives();
+    expect(props.companyId).toBe(12);
+    expect(props.closedThrough?.toISOString()).toBe("2026-08-31T00:00:00.000Z");
+    expect(props.closedAt?.toISOString()).toBe("2026-09-02T10:11:12.000Z");
+    expect(props.closedBy).toBe(44);
+  });
+
+  it("treats the exact close boundary as closed", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(state.isClosed(new Date("2026-08-31T23:59:59Z"))).toBe(true);
+  });
+
+  it("treats every earlier date as closed", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(state.isClosed(new Date("2026-01-01"))).toBe(true);
+  });
+
+  it("allows the day immediately after the close boundary", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(state.isClosed(new Date("2026-09-01"))).toBe(false);
+    expect(() => state.assertOpen(new Date("2026-09-01"))).not.toThrow();
+  });
+
+  it("throws a reporting-period-closed conflict for a boundary-day write", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(() => state.assertOpen(new Date("2026-08-31"))).toThrow(ReportingPeriodClosedError);
+  });
+
+  it("throws a reporting-period-closed conflict for a backdated write", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(() => state.assertOpen(new Date("2026-08-01"))).toThrow(ReportingPeriodClosedError);
+  });
+
+  it("does not allow a close request to repeat the current boundary", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(() => state.assertCanAdvanceTo(new Date("2026-08-31"))).toThrow(ReportingPeriodAlreadyClosedError);
+  });
+
+  it("does not allow a close request to move the boundary backwards", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(() => state.assertCanAdvanceTo(new Date("2026-07-31"))).toThrow(ReportingPeriodAlreadyClosedError);
+  });
+
+  it("allows a close request to move the boundary forward", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    expect(() => state.assertCanAdvanceTo(new Date("2026-09-30"))).not.toThrow();
+  });
+
+  it("rejects an invalid company id for an open state", () => {
+    expect(() => ReportingPeriodState.open(0)).toThrow(ValidationError);
+  });
+
+  it("rejects a fractional company id", () => {
+    expect(() => ReportingPeriodState.open(1.5)).toThrow(ValidationError);
+  });
+
+  it("rejects an invalid company id when hydrating a close", () => {
+    expect(() => ReportingPeriodState.hydrate({ ...record(), companyId: -2 })).toThrow(ValidationError);
+  });
+
+  it("rejects an invalid closed-through date when hydrating", () => {
+    expect(() => ReportingPeriodState.hydrate({ ...record(), closedThrough: new Date("bad") })).toThrow(ValidationError);
+  });
+
+  it("rejects an invalid closed-at timestamp when hydrating", () => {
+    expect(() => ReportingPeriodState.hydrate({ ...record(), closedAt: new Date("bad") })).toThrow(ValidationError);
+  });
+
+  it("returns copies of stored Date values from primitives", () => {
+    const state = ReportingPeriodState.hydrate(record());
+    const first = state.toPrimitives();
+    first.closedThrough!.setUTCDate(1);
+    first.closedAt!.setUTCFullYear(2000);
+    const second = state.toPrimitives();
+    expect(second.closedThrough?.toISOString()).toBe("2026-08-31T00:00:00.000Z");
+    expect(second.closedAt?.getUTCFullYear()).toBe(2026);
+  });
+});
+
+describe("reporting period conflict errors", () => {
+  it("uses the public closed-period code and HTTP 409", () => {
+    const error = new ReportingPeriodClosedError(new Date("2026-08-20"), new Date("2026-08-31"));
+    expect(error.code).toBe("REPORTING_PERIOD_CLOSED");
+    expect(error.status).toBe(409);
+  });
+
+  it("includes both the attempted date and close boundary in the closed-period message", () => {
+    const error = new ReportingPeriodClosedError(new Date("2026-08-20"), new Date("2026-08-31"));
+    expect(error.message).toContain("2026-08-20");
+    expect(error.message).toContain("2026-08-31");
+  });
+
+  it("uses the public already-closed code and HTTP 409", () => {
+    const error = new ReportingPeriodAlreadyClosedError(new Date("2026-07-31"), new Date("2026-08-31"));
+    expect(error.code).toBe("PERIOD_ALREADY_CLOSED");
+    expect(error.status).toBe(409);
+  });
+
+  it("uses the public close-blocked code and HTTP 409", () => {
+    const error = new ReportingPeriodCloseBlockedError([{ type: "OPEN_SALES", count: 2 }]);
+    expect(error.code).toBe("PERIOD_CLOSE_BLOCKED");
+    expect(error.status).toBe(409);
+  });
+
+  it("summarizes positive blocker counts in the close-blocked message", () => {
+    const error = new ReportingPeriodCloseBlockedError([
+      { type: "OPEN_SALES", count: 2 },
+      { type: "OPEN_PURCHASES", count: 3 }
+    ]);
+    expect(error.message).toContain("OPEN_SALES:2");
+    expect(error.message).toContain("OPEN_PURCHASES:3");
+  });
+
+  it("does not put zero-count blockers in the close-blocked message", () => {
+    const error = new ReportingPeriodCloseBlockedError([
+      { type: "OPEN_SALES", count: 0 },
+      { type: "OPEN_PURCHASES", count: 1 }
+    ]);
+    expect(error.message).not.toContain("OPEN_SALES");
+    expect(error.blockers).toHaveLength(2);
+  });
+});
