+import {
+  CloseReportingPeriodBodySchema,
+  ReportingPeriodCloseEligibilityQuerySchema
+} from "../ReportingPeriodCloseSchemas";
+
+describe("reporting period close request dates", () => {
+  it("accepts a date-only eligibility throughDate", () => {
+    const parsed = ReportingPeriodCloseEligibilityQuerySchema.parse({ throughDate: "2026-08-31" });
+    expect(parsed.throughDate.toISOString()).toBe("2026-08-31T00:00:00.000Z");
+  });
+
+  it("accepts leap day in a leap year", () => {
+    const parsed = CloseReportingPeriodBodySchema.parse({ throughDate: "2028-02-29" });
+    expect(parsed.throughDate.toISOString()).toBe("2028-02-29T00:00:00.000Z");
+  });
+
+  it("accepts the first calendar day of a year", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2027-01-01" }).success).toBe(true);
+  });
+
+  it("accepts the last calendar day of a year", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2027-12-31" }).success).toBe(true);
+  });
+
+  it("rejects an impossible day of month", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2026-02-30" }).success).toBe(false);
+  });
+
+  it("rejects leap day in a non-leap year", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2027-02-29" }).success).toBe(false);
+  });
+
+  it("rejects month zero", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2026-00-10" }).success).toBe(false);
+  });
+
+  it("rejects month thirteen", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2026-13-10" }).success).toBe(false);
+  });
+
+  it("rejects day zero", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2026-08-00" }).success).toBe(false);
+  });
+
+  it("rejects timestamps because the public close boundary is date-only", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2026-08-31T00:00:00Z" }).success).toBe(false);
+  });
+
+  it("rejects slash-separated dates", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2026/08/31" }).success).toBe(false);
+  });
+
+  it("rejects non-padded dates", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({ throughDate: "2026-8-1" }).success).toBe(false);
+  });
+
+  it("requires throughDate in the close body", () => {
+    expect(CloseReportingPeriodBodySchema.safeParse({}).success).toBe(false);
+  });
+
+  it("requires throughDate in the eligibility query", () => {
+    expect(ReportingPeriodCloseEligibilityQuerySchema.safeParse({}).success).toBe(false);
+  });
+
+  it("rejects non-string query values", () => {
+    expect(ReportingPeriodCloseEligibilityQuerySchema.safeParse({ throughDate: 20260831 }).success).toBe(false);
+  });
+});
