diff --git a/src/modules/reporting/application/__tests__/ReportingPeriodCloseWorkflow.behavior.test.ts b/src/modules/reporting/application/__tests__/ReportingPeriodCloseWorkflow.behavior.test.ts
new file mode 100644
index 0000000..a60a277
--- /dev/null
+++ b/src/modules/reporting/application/__tests__/ReportingPeriodCloseWorkflow.behavior.test.ts
@@ -0,0 +1,322 @@
+import {
+  CheckReportingPeriodCloseEligibilityUseCase,
+  CloseReportingPeriodUseCase,
+  GetReportingPeriodCloseUseCase
+} from "../ReportingPeriodCloseUseCases";
+import { ReportingPeriodGuard } from "../ReportingPeriodGuard";
+import {
+  ReportingPeriodAlreadyClosedError,
+  ReportingPeriodCloseBlockedError,
+  ReportingPeriodClosedError
+} from "../../domain/ReportingPeriodClose";
+
+const closedRecord = (overrides: Record<string, unknown> = {}) => ({
+  id: 8,
+  companyId: 5,
+  closedThrough: new Date("2026-08-31"),
+  closedAt: new Date("2026-09-02T09:15:00Z"),
+  closedBy: 41,
+  ...overrides
+});
+
+function repository(overrides: Record<string, unknown> = {}) {
+  return {
+    acquireCompanyCloseLock: jest.fn().mockResolvedValue(undefined),
+    getCurrent: jest.fn().mockResolvedValue(null),
+    getEligibilityBlockers: jest.fn().mockResolvedValue([
+      { type: "OPEN_SALES", count: 0 },
+      { type: "OPEN_PURCHASES", count: 0 }
+    ]),
+    insertClose: jest.fn().mockResolvedValue(closedRecord()),
+    ...overrides
+  } as any;
+}
+
+function txManager(client: any = { transaction: "client" }) {
+  return {
+    run: jest.fn(async (callback: any) => callback(client))
+  } as any;
+}
+
+describe("reporting period close status", () => {
+  it("returns null close fields for a company that has never closed a period", async () => {
+    const repo = repository();
+    const result = await new GetReportingPeriodCloseUseCase(repo).execute(5);
+    expect(result).toEqual({ closedThrough: null, closedAt: null, closedBy: null });
+  });
+
+  it("returns the latest close boundary as a date-only string", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    const result = await new GetReportingPeriodCloseUseCase(repo).execute(5);
+    expect(result.closedThrough).toBe("2026-08-31");
+  });
+
+  it("returns close time as an ISO timestamp", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    const result = await new GetReportingPeriodCloseUseCase(repo).execute(5);
+    expect(result.closedAt).toBe("2026-09-02T09:15:00.000Z");
+  });
+
+  it("returns the user who closed the current boundary", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    const result = await new GetReportingPeriodCloseUseCase(repo).execute(5);
+    expect(result.closedBy).toBe(41);
+  });
+
+  it("keeps a null closer for system-created close records", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord({ closedBy: null })) });
+    const result = await new GetReportingPeriodCloseUseCase(repo).execute(5);
+    expect(result.closedBy).toBeNull();
+  });
+});
+
+describe("period-close eligibility", () => {
+  it("marks a never-closed company eligible when no open documents block it", async () => {
+    const repo = repository();
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-08-31"));
+    expect(result).toEqual({
+      throughDate: "2026-08-31",
+      closedThrough: null,
+      eligible: true,
+      blockers: []
+    });
+  });
+
+  it("returns open sales as a blocker", async () => {
+    const repo = repository({
+      getEligibilityBlockers: jest.fn().mockResolvedValue([
+        { type: "OPEN_SALES", count: 4 },
+        { type: "OPEN_PURCHASES", count: 0 }
+      ])
+    });
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-08-31"));
+    expect(result.eligible).toBe(false);
+    expect(result.blockers).toEqual([{ type: "OPEN_SALES", count: 4 }]);
+  });
+
+  it("returns open purchases as a blocker", async () => {
+    const repo = repository({
+      getEligibilityBlockers: jest.fn().mockResolvedValue([
+        { type: "OPEN_SALES", count: 0 },
+        { type: "OPEN_PURCHASES", count: 2 }
+      ])
+    });
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-08-31"));
+    expect(result.blockers).toEqual([{ type: "OPEN_PURCHASES", count: 2 }]);
+  });
+
+  it("returns both document blockers when both categories are open", async () => {
+    const repo = repository({
+      getEligibilityBlockers: jest.fn().mockResolvedValue([
+        { type: "OPEN_SALES", count: 1 },
+        { type: "OPEN_PURCHASES", count: 3 }
+      ])
+    });
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-08-31"));
+    expect(result.blockers).toHaveLength(2);
+    expect(result.eligible).toBe(false);
+  });
+
+  it("drops zero-count blocker categories from the response", async () => {
+    const repo = repository({
+      getEligibilityBlockers: jest.fn().mockResolvedValue([
+        { type: "OPEN_SALES", count: 0 },
+        { type: "OPEN_PURCHASES", count: 6 }
+      ])
+    });
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-08-31"));
+    expect(result.blockers).not.toContainEqual({ type: "OPEN_SALES", count: 0 });
+  });
+
+  it("passes the company and normalized boundary to blocker lookup", async () => {
+    const getEligibilityBlockers = jest.fn().mockResolvedValue([]);
+    const repo = repository({ getEligibilityBlockers });
+    await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(23, new Date("2026-08-31T22:00:00Z"));
+    expect(getEligibilityBlockers).toHaveBeenCalledWith(23, new Date("2026-08-31T00:00:00.000Z"));
+  });
+
+  it("reports the existing boundary while checking a later period", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-09-30"));
+    expect(result.closedThrough).toBe("2026-08-31");
+    expect(result.eligible).toBe(true);
+  });
+
+  it("marks the current boundary ineligible as already closed", async () => {
+    const lookup = jest.fn();
+    const repo = repository({
+      getCurrent: jest.fn().mockResolvedValue(closedRecord()),
+      getEligibilityBlockers: lookup
+    });
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-08-31"));
+    expect(result.eligible).toBe(false);
+    expect(result.blockers).toEqual([{ type: "ALREADY_CLOSED", count: 1 }]);
+    expect(lookup).not.toHaveBeenCalled();
+  });
+
+  it("marks an earlier requested boundary ineligible as already closed", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    const result = await new CheckReportingPeriodCloseEligibilityUseCase(repo).execute(5, new Date("2026-07-31"));
+    expect(result.blockers).toEqual([{ type: "ALREADY_CLOSED", count: 1 }]);
+    expect(result.closedThrough).toBe("2026-08-31");
+  });
+});
+
+describe("closing a reporting period", () => {
+  it("serializes close attempts with a company-scoped transaction lock", async () => {
+    const client = { id: "tx" };
+    const repo = repository();
+    await new CloseReportingPeriodUseCase(txManager(client), repo).execute(5, new Date("2026-08-31"), 41);
+    expect(repo.acquireCompanyCloseLock).toHaveBeenCalledWith(5, client);
+  });
+
+  it("checks the current close within the same transaction", async () => {
+    const client = { id: "tx" };
+    const repo = repository();
+    await new CloseReportingPeriodUseCase(txManager(client), repo).execute(5, new Date("2026-08-31"), 41);
+    expect(repo.getCurrent).toHaveBeenCalledWith(5, client);
+  });
+
+  it("checks blockers inside the close transaction", async () => {
+    const client = { id: "tx" };
+    const repo = repository();
+    await new CloseReportingPeriodUseCase(txManager(client), repo).execute(5, new Date("2026-08-31"), 41);
+    expect(repo.getEligibilityBlockers).toHaveBeenCalledWith(5, new Date("2026-08-31T00:00:00.000Z"), client);
+  });
+
+  it("persists the new boundary and closer only after eligibility succeeds", async () => {
+    const client = { id: "tx" };
+    const repo = repository();
+    await new CloseReportingPeriodUseCase(txManager(client), repo).execute(5, new Date("2026-08-31"), 41);
+    expect(repo.insertClose).toHaveBeenCalledWith(5, new Date("2026-08-31T00:00:00.000Z"), 41, client);
+  });
+
+  it("uses null when no closer is supplied", async () => {
+    const repo = repository();
+    await new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-08-31"));
+    expect(repo.insertClose.mock.calls[0][2]).toBeNull();
+  });
+
+  it("returns the saved boundary rather than constructing a timestamp itself", async () => {
+    const repo = repository({
+      insertClose: jest.fn().mockResolvedValue(closedRecord({ closedThrough: new Date("2026-09-30"), closedBy: 55 }))
+    });
+    const result = await new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-09-30"), 55);
+    expect(result.closedThrough).toBe("2026-09-30");
+    expect(result.closedBy).toBe(55);
+  });
+
+  it("rejects a repeated close boundary before checking document blockers", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    await expect(
+      new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-08-31"), 41)
+    ).rejects.toBeInstanceOf(ReportingPeriodAlreadyClosedError);
+    expect(repo.getEligibilityBlockers).not.toHaveBeenCalled();
+    expect(repo.insertClose).not.toHaveBeenCalled();
+  });
+
+  it("rejects a backwards close boundary", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    await expect(
+      new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-07-31"), 41)
+    ).rejects.toBeInstanceOf(ReportingPeriodAlreadyClosedError);
+  });
+
+  it("rejects closing while an open sale remains in the requested period", async () => {
+    const repo = repository({
+      getEligibilityBlockers: jest.fn().mockResolvedValue([{ type: "OPEN_SALES", count: 1 }])
+    });
+    await expect(
+      new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-08-31"), 41)
+    ).rejects.toBeInstanceOf(ReportingPeriodCloseBlockedError);
+    expect(repo.insertClose).not.toHaveBeenCalled();
+  });
+
+  it("rejects closing while an open purchase remains in the requested period", async () => {
+    const repo = repository({
+      getEligibilityBlockers: jest.fn().mockResolvedValue([{ type: "OPEN_PURCHASES", count: 2 }])
+    });
+    await expect(
+      new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-08-31"), 41)
+    ).rejects.toMatchObject({ code: "PERIOD_CLOSE_BLOCKED", status: 409 });
+  });
+
+  it("ignores zero-count blocker rows returned by storage", async () => {
+    const repo = repository({
+      getEligibilityBlockers: jest.fn().mockResolvedValue([
+        { type: "OPEN_SALES", count: 0 },
+        { type: "OPEN_PURCHASES", count: 0 }
+      ])
+    });
+    await new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-08-31"), 41);
+    expect(repo.insertClose).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not swallow an insert failure", async () => {
+    const failure = new Error("write failed");
+    const repo = repository({ insertClose: jest.fn().mockRejectedValue(failure) });
+    await expect(
+      new CloseReportingPeriodUseCase(txManager(), repo).execute(5, new Date("2026-08-31"), 41)
+    ).rejects.toBe(failure);
+  });
+});
+
+describe("reporting period mutation guard", () => {
+  it("does not query storage for an empty date set", async () => {
+    const repo = repository();
+    await new ReportingPeriodGuard(repo).assertOpen(5, []);
+    expect(repo.getCurrent).not.toHaveBeenCalled();
+  });
+
+  it("allows every date when the company has no close record", async () => {
+    const repo = repository();
+    await expect(
+      new ReportingPeriodGuard(repo).assertOpen(5, [new Date("2020-01-01"), new Date("2026-08-31")])
+    ).resolves.toBeUndefined();
+  });
+
+  it("allows a business date after the current boundary", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    await expect(new ReportingPeriodGuard(repo).assertOpen(5, [new Date("2026-09-01")])).resolves.toBeUndefined();
+  });
+
+  it("rejects the exact boundary day", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    await expect(new ReportingPeriodGuard(repo).assertOpen(5, [new Date("2026-08-31")]))
+      .rejects.toBeInstanceOf(ReportingPeriodClosedError);
+  });
+
+  it("rejects an earlier business date", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    await expect(new ReportingPeriodGuard(repo).assertOpen(5, [new Date("2026-08-01")]))
+      .rejects.toMatchObject({ code: "REPORTING_PERIOD_CLOSED", status: 409 });
+  });
+
+  it("rejects a request when any one of several dates falls in the closed period", async () => {
+    const repo = repository({ getCurrent: jest.fn().mockResolvedValue(closedRecord()) });
+    await expect(new ReportingPeriodGuard(repo).assertOpen(5, [
+      new Date("2026-09-02"),
+      new Date("2026-08-20"),
+      new Date("2026-09-03")
+    ])).rejects.toBeInstanceOf(ReportingPeriodClosedError);
+  });
+
+  it("loads the close boundary only once for a multi-date request", async () => {
+    const getCurrent = jest.fn().mockResolvedValue(closedRecord());
+    const repo = repository({ getCurrent });
+    await expect(new ReportingPeriodGuard(repo).assertOpen(5, [
+      new Date("2026-09-01"),
+      new Date("2026-09-02"),
+      new Date("2026-09-03")
+    ])).resolves.toBeUndefined();
+    expect(getCurrent).toHaveBeenCalledTimes(1);
+    expect(getCurrent).toHaveBeenCalledWith(5);
+  });
+
+  it("uses each company's own close boundary", async () => {
+    const getCurrent = jest.fn(async (companyId: number) => companyId === 7 ? closedRecord({ companyId: 7 }) : null);
+    const repo = repository({ getCurrent });
+    await expect(new ReportingPeriodGuard(repo).assertOpen(6, [new Date("2026-08-01")])).resolves.toBeUndefined();
+    await expect(new ReportingPeriodGuard(repo).assertOpen(7, [new Date("2026-08-01")])).rejects.toBeInstanceOf(ReportingPeriodClosedError);
+  });
+});
diff --git a/src/modules/reporting/application/__tests__/ReportingPeriodMutationMatrix.behavior.test.ts b/src/modules/reporting/application/__tests__/ReportingPeriodMutationMatrix.behavior.test.ts
