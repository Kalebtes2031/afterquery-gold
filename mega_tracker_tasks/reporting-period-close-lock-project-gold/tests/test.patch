@@ -0,0 +1,463 @@
+import { RecordExpenseUseCase } from "../../../expenses/application/RecordExpenseUseCase";
+import { ExpenseType, PaymentMethod as ExpensePaymentMethod } from "../../../expenses/domain/Expense";
+import { CreateSaleOrderUseCase } from "../../../sales/application/CreateSaleOrderUseCase";
+import { RecordSalePaymentUseCase } from "../../../sales/application/RecordSalePaymentUseCase";
+import { RecordShipmentUseCase } from "../../../sales/application/RecordShipmentUseCase";
+import { ShipmentOption } from "../../../sales/domain/SaleOrder";
+import { PaymentMethod as SalePaymentMethod } from "../../../sales/domain/SalePayment";
+import { CreatePurchaseOrderUseCase } from "../../../purchases/application/CreatePurchaseOrderUseCase";
+import { RecordPurchasePaymentUseCase } from "../../../purchases/application/RecordPurchasePaymentUseCase";
+import { RecordPurchaseReceiveUseCase } from "../../../purchases/application/RecordPurchaseReceiveUseCase";
+import { ReceiveOption } from "../../../purchases/domain/PurchaseOrder";
+import { PaymentMethod as PurchasePaymentMethod } from "../../../purchases/domain/PurchasePayment";
+import { CreateInventoryAdjustmentUseCase } from "../../../inventory/application/CreateInventoryAdjustmentUseCase";
+import { AdjustmentType } from "../../../inventory/domain/InventoryAdjustment";
+import { TransferBetweenAccountsUseCase } from "../../../accounts/application/TransferBetweenAccountsUseCase";
+import {
+  RecordDirectLoanUseCase,
+  RecordHistoricalLoanUseCase,
+  RecordPartnerToPartnerLoanUseCase
+} from "../../../finance/application/LoanUseCases";
+
+const denied = new Error("period guard rejected the write");
+
+function txManager() {
+  return { run: jest.fn() } as any;
+}
+
+function rejectingGuard() {
+  return { assertOpen: jest.fn().mockRejectedValue(denied) } as any;
+}
+
+async function expectGuarded(call: Promise<unknown>, tx: any) {
+  await expect(call).rejects.toBe(denied);
+  expect(tx.run).not.toHaveBeenCalled();
+}
+
+describe("expense and account mutation period locks", () => {
+  it("checks the expense date and every payment date before recording an expense", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const useCase = new RecordExpenseUseCase(tx, null as any, null as any, null as any, null as any, null as any, guard);
+    const expenseDate = new Date("2026-09-03");
+    const cashDate = new Date("2026-08-30");
+    const partnerDate = new Date("2026-09-04");
+    const call = useCase.execute({
+      companyId: 3,
+      expenseDate,
+      reason: "Freight",
+      expenseType: ExpenseType.WORK,
+      totalAmount: 100,
+      payments: [
+        { method: ExpensePaymentMethod.CASH, accountId: 8, amount: 40, date: cashDate },
+        { method: ExpensePaymentMethod.PARTNER, partnerId: 9, amount: 60, date: partnerDate }
+      ]
+    });
+    await expectGuarded(call, tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(3, [expenseDate, cashDate, partnerDate]);
+  });
+
+  it("checks the expense date even when a zero-value expense has no payment rows", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const useCase = new RecordExpenseUseCase(tx, null as any, null as any, null as any, null as any, null as any, guard);
+    const date = new Date("2026-08-31");
+    await expectGuarded(useCase.execute({
+      companyId: 3,
+      expenseDate: date,
+      reason: "Adjustment",
+      expenseType: ExpenseType.WORK,
+      totalAmount: 0,
+      payments: []
+    }), tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(3, [date]);
+  });
+
+  it("checks an account transfer's effective date before locking accounts", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const useCase = new TransferBetweenAccountsUseCase(null as any, null as any, null as any, tx, null as any, guard);
+    const date = new Date("2026-08-31");
+    await expectGuarded(useCase.execute({
+      companyId: 7,
+      fromAccountId: 1,
+      toAccountId: 2,
+      amount: 25,
+      date
+    }), tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(7, [date]);
+  });
+
+  it("keeps transfer validation ahead of the period lookup for an invalid amount", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const useCase = new TransferBetweenAccountsUseCase(null as any, null as any, null as any, tx, null as any, guard);
+    await expect(useCase.execute({
+      companyId: 7,
+      fromAccountId: 1,
+      toAccountId: 2,
+      amount: 0,
+      date: new Date("2026-08-31")
+    })).rejects.not.toBe(denied);
+    expect(guard.assertOpen).not.toHaveBeenCalled();
+  });
+});
+
+describe("sale mutation period locks", () => {
+  function createSale(guard: any, tx: any) {
+    return new CreateSaleOrderUseCase(
+      tx, null as any, null as any, null as any, null as any,
+      null as any, null as any, null as any, guard
+    );
+  }
+
+  it("checks the order date when creating a sale order", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const orderDate = new Date("2026-08-31");
+    await expectGuarded(createSale(guard, tx).execute({
+      companyId: 4,
+      customerId: 2,
+      orderNo: "SO-1",
+      orderDate,
+      shipmentOption: ShipmentOption.SHIP_LATER,
+      branchId: 1,
+      items: [{ productId: 5, quantityOrdered: 2, unitPrice: 10 }]
+    }), tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(4, [orderDate]);
+  });
+
+  it("checks nested sale payment dates during order creation", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const orderDate = new Date("2026-09-05");
+    const paymentDate = new Date("2026-08-31");
+    await expectGuarded(createSale(guard, tx).execute({
+      companyId: 4,
+      customerId: 2,
+      orderNo: "SO-2",
+      orderDate,
+      shipmentOption: ShipmentOption.SHIP_LATER,
+      branchId: 1,
+      items: [{ productId: 5, quantityOrdered: 2, unitPrice: 10 }],
+      payments: [{ method: SalePaymentMethod.CASH, accountId: 7, amount: 20, date: paymentDate }]
+    }), tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(4, [orderDate, paymentDate]);
+  });
+
+  it("checks the actual initial shipment date for a fully shipped sale", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const orderDate = new Date("2026-09-02");
+    const shipmentDate = new Date("2026-08-31");
+    await expectGuarded(createSale(guard, tx).execute({
+      companyId: 4,
+      customerId: 2,
+      orderNo: "SO-3",
+      orderDate,
+      shipmentDate,
+      shipmentOption: ShipmentOption.SHIPPED_ALL,
+      branchId: 1,
+      items: [{ productId: 5, quantityOrdered: 2, unitPrice: 10 }]
+    }), tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(4, [orderDate, shipmentDate]);
+  });
+
+  it("uses the order date as the initial shipment date when none is supplied", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const orderDate = new Date("2026-08-31");
+    await expectGuarded(createSale(guard, tx).execute({
+      companyId: 4,
+      customerId: 2,
+      orderNo: "SO-4",
+      orderDate,
+      shipmentOption: ShipmentOption.SHIPPED_ALL,
+      branchId: 1,
+      items: [{ productId: 5, quantityOrdered: 2, unitPrice: 10 }]
+    }), tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(4, [orderDate, orderDate]);
+  });
+
+  it("does not treat a planned shipment date as posted activity for ship-later orders", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const orderDate = new Date("2026-09-05");
+    const plannedDate = new Date("2026-08-31");
+    await expectGuarded(createSale(guard, tx).execute({
+      companyId: 4,
+      customerId: 2,
+      orderNo: "SO-5",
+      orderDate,
+      shipmentDate: plannedDate,
+      shipmentOption: ShipmentOption.SHIP_LATER,
+      branchId: 1,
+      items: [{ productId: 5, quantityOrdered: 2, unitPrice: 10 }]
+    }), tx);
+    expect(guard.assertOpen).toHaveBeenCalledWith(4, [orderDate]);
+  });
+
+  it("checks a partial initial shipment when a shipped quantity is supplied", async () => {
+    const tx = txManager();
+    const guard = rejectingGuard();
+    const orderDate = new Date("2026-09-05");
+    const shipmentDate = new Date("2026-08-31");
+    await expectGuarded(createSale(guard, tx).execute({
+      companyId: 4,
+      customerId: 2,
+      orderNo: "SO-6",
+      orderDate,
+      shipmentDate,
+      shipmentOption: ShipmentOption.SHIPPED_PARTIALLY,
+      branchId: 1,
