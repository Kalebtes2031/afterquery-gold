+import { z } from "zod";
+
+function dateOnlySchema() {
+  return z.string()
+    .regex(/^\d{4}-\d{2}-\d{2}$/, "Date must use YYYY-MM-DD")
+    .superRefine((value, ctx) => {
+      const [year, month, day] = value.split("-").map(Number);
+      const parsed = new Date(Date.UTC(year, month - 1, day));
+      const same = parsed.getUTCFullYear() === year && parsed.getUTCMonth() === month - 1 && parsed.getUTCDate() === day;
+      if (!same) {
+        ctx.addIssue({ code: z.ZodIssueCode.custom, message: "Date is not a valid calendar day" });
+      }
+    })
+    .transform((value) => {
+      const [year, month, day] = value.split("-").map(Number);
+      return new Date(Date.UTC(year, month - 1, day));
+    });
+}
+
+export const ReportingPeriodCloseEligibilityQuerySchema = z.object({
+  throughDate: dateOnlySchema()
+});
+
+export const CloseReportingPeriodBodySchema = z.object({
+  throughDate: dateOnlySchema()
+});
