diff --git a/src/modules/reporting/application/ReportingPeriodCloseUseCases.ts b/src/modules/reporting/application/ReportingPeriodCloseUseCases.ts
new file mode 100644
index 0000000..a6d7ca2
--- /dev/null
+++ b/src/modules/reporting/application/ReportingPeriodCloseUseCases.ts
@@ -0,0 +1,108 @@
+import { TransactionManager } from "../../../shared/infrastructure/transactions/TransactionManager";
+import {
+  PeriodCloseBlocker,
+  ReportingPeriodAlreadyClosedError,
+  ReportingPeriodCloseBlockedError,
+  ReportingPeriodState,
+  formatBusinessDate,
+  normalizeBusinessDate
+} from "../domain/ReportingPeriodClose";
+import { ReportingPeriodCloseRepository } from "../domain/ReportingPeriodCloseRepository";
+
+export interface ReportingPeriodStatusOutput {
+  closedThrough: string | null;
+  closedAt: string | null;
+  closedBy: number | null;
+}
+
+export interface ReportingPeriodEligibilityOutput {
+  throughDate: string;
+  closedThrough: string | null;
+  eligible: boolean;
+  blockers: PeriodCloseBlocker[];
+}
+
+function stateFromRecord(companyId: number, record: Awaited<ReturnType<ReportingPeriodCloseRepository["getCurrent"]>>): ReportingPeriodState {
+  return record ? ReportingPeriodState.hydrate(record) : ReportingPeriodState.open(companyId);
+}
+
+function statusFromState(state: ReportingPeriodState): ReportingPeriodStatusOutput {
+  const p = state.toPrimitives();
+  return {
+    closedThrough: p.closedThrough ? formatBusinessDate(p.closedThrough) : null,
+    closedAt: p.closedAt ? p.closedAt.toISOString() : null,
+    closedBy: p.closedBy
+  };
+}
+
+function positiveBlockers(blockers: PeriodCloseBlocker[]): PeriodCloseBlocker[] {
+  return blockers.filter((blocker) => blocker.count > 0);
+}
+
+export class GetReportingPeriodCloseUseCase {
+  constructor(private readonly repository: ReportingPeriodCloseRepository) {}
+
+  async execute(companyId: number): Promise<ReportingPeriodStatusOutput> {
+    const current = await this.repository.getCurrent(companyId);
+    return statusFromState(stateFromRecord(companyId, current));
+  }
+}
+
+export class CheckReportingPeriodCloseEligibilityUseCase {
+  constructor(private readonly repository: ReportingPeriodCloseRepository) {}
+
+  async execute(companyId: number, throughDate: Date): Promise<ReportingPeriodEligibilityOutput> {
+    const requested = normalizeBusinessDate(throughDate);
+    const current = stateFromRecord(companyId, await this.repository.getCurrent(companyId));
+    const currentProps = current.toPrimitives();
+
+    if (currentProps.closedThrough) {
+      try {
+        current.assertCanAdvanceTo(requested);
+      } catch (error) {
+        if (error instanceof ReportingPeriodAlreadyClosedError) {
+          return {
+            throughDate: formatBusinessDate(requested),
+            closedThrough: formatBusinessDate(currentProps.closedThrough),
+            eligible: false,
+            blockers: [{ type: "ALREADY_CLOSED", count: 1 }]
+          };
+        }
+        throw error;
+      }
+    }
+
+    const blockers = positiveBlockers(await this.repository.getEligibilityBlockers(companyId, requested));
+    return {
+      throughDate: formatBusinessDate(requested),
+      closedThrough: currentProps.closedThrough ? formatBusinessDate(currentProps.closedThrough) : null,
+      eligible: blockers.length === 0,
+      blockers
+    };
+  }
+}
+
+export class CloseReportingPeriodUseCase {
+  constructor(
+    private readonly txManager: TransactionManager,
+    private readonly repository: ReportingPeriodCloseRepository
+  ) {}
+
+  async execute(companyId: number, throughDate: Date, closedBy?: number | null): Promise<ReportingPeriodStatusOutput> {
+    const requested = normalizeBusinessDate(throughDate);
+
+    return this.txManager.run(async (client) => {
+      await this.repository.acquireCompanyCloseLock(companyId, client);
+      const current = stateFromRecord(companyId, await this.repository.getCurrent(companyId, client));
+      current.assertCanAdvanceTo(requested);
+
+      const blockers = positiveBlockers(await this.repository.getEligibilityBlockers(companyId, requested, client));
+      if (blockers.length > 0) {
+        throw new ReportingPeriodCloseBlockedError(blockers);
+      }
+
+      const saved = await this.repository.insertClose(companyId, requested, closedBy ?? null, client);
+      return statusFromState(ReportingPeriodState.hydrate(saved));
+    });
+  }
+}
