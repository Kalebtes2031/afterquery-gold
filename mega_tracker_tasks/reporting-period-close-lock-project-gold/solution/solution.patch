+import { ReportingPeriodState } from "../domain/ReportingPeriodClose";
+import { ReportingPeriodCloseRepository } from "../domain/ReportingPeriodCloseRepository";
+
+export interface ReportingPeriodWriteGuard {
+  assertOpen(companyId: number, dates: Date[]): Promise<void>;
+}
+
+export const allowAllReportingPeriods: ReportingPeriodWriteGuard = {
+  async assertOpen(): Promise<void> {
+    return;
+  }
+};
+
+export class ReportingPeriodGuard implements ReportingPeriodWriteGuard {
+  constructor(private readonly repository: ReportingPeriodCloseRepository) {}
+
+  async assertOpen(companyId: number, dates: Date[]): Promise<void> {
+    if (dates.length === 0) return;
+    const current = await this.repository.getCurrent(companyId);
+    if (!current) return;
+
+    const state = ReportingPeriodState.hydrate(current);
+    for (const date of dates) {
+      state.assertOpen(date);
+    }
+  }
+}
diff --git a/src/modules/reporting/domain/ReportingPeriodClose.ts b/src/modules/reporting/domain/ReportingPeriodClose.ts
new file mode 100644
index 0000000..6ebb14f
--- /dev/null
+++ b/src/modules/reporting/domain/ReportingPeriodClose.ts
@@ -0,0 +1,136 @@
+import { DomainError, ValidationError } from "../../../shared/domain/DomainError";
+
+export type PeriodCloseBlockerType = "OPEN_SALES" | "OPEN_PURCHASES" | "ALREADY_CLOSED";
+
+export interface PeriodCloseBlocker {
+  type: PeriodCloseBlockerType;
+  count: number;
+}
+
+export interface ReportingPeriodCloseRecord {
+  id?: number;
+  companyId: number;
+  closedThrough: Date;
+  closedAt: Date;
+  closedBy: number | null;
+}
+
+function assertValidDate(value: Date): void {
+  if (!(value instanceof Date) || Number.isNaN(value.getTime())) {
+    throw new ValidationError("A valid business date is required");
+  }
+}
+
+export function normalizeBusinessDate(value: Date): Date {
+  assertValidDate(value);
+  return new Date(Date.UTC(value.getUTCFullYear(), value.getUTCMonth(), value.getUTCDate()));
+}
+
+export function formatBusinessDate(value: Date): string {
+  return normalizeBusinessDate(value).toISOString().slice(0, 10);
+}
+
+export function compareBusinessDates(left: Date, right: Date): number {
+  const a = normalizeBusinessDate(left).getTime();
+  const b = normalizeBusinessDate(right).getTime();
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+export class ReportingPeriodClosedError extends DomainError {
+  readonly code = "REPORTING_PERIOD_CLOSED";
+  readonly status = 409;
+
+  constructor(readonly businessDate: Date, readonly closedThrough: Date) {
+    super(
+      `Reporting period is closed through ${formatBusinessDate(closedThrough)}; ` +
+      `${formatBusinessDate(businessDate)} cannot be changed`
+    );
+  }
+}
+
+export class ReportingPeriodAlreadyClosedError extends DomainError {
+  readonly code = "PERIOD_ALREADY_CLOSED";
+  readonly status = 409;
+
+  constructor(readonly requestedThrough: Date, readonly closedThrough: Date) {
+    super(
+      `Reporting period is already closed through ${formatBusinessDate(closedThrough)}; ` +
+      `cannot close through ${formatBusinessDate(requestedThrough)}`
+    );
+  }
+}
+
+export class ReportingPeriodCloseBlockedError extends DomainError {
+  readonly code = "PERIOD_CLOSE_BLOCKED";
+  readonly status = 409;
+
+  constructor(readonly blockers: PeriodCloseBlocker[]) {
+    const summary = blockers
+      .filter((blocker) => blocker.count > 0)
+      .map((blocker) => `${blocker.type}:${blocker.count}`)
+      .join(", ");
+    super(summary ? `Reporting period cannot be closed (${summary})` : "Reporting period cannot be closed");
+  }
+}
+
+export class ReportingPeriodState {
+  private constructor(
+    readonly companyId: number,
+    readonly closedThrough: Date | null,
+    readonly closedAt: Date | null,
+    readonly closedBy: number | null
+  ) {}
+
+  static open(companyId: number): ReportingPeriodState {
+    if (!Number.isInteger(companyId) || companyId <= 0) {
+      throw new ValidationError("Company ID must be a positive integer");
+    }
+    return new ReportingPeriodState(companyId, null, null, null);
+  }
+
+  static hydrate(record: ReportingPeriodCloseRecord): ReportingPeriodState {
+    if (!Number.isInteger(record.companyId) || record.companyId <= 0) {
+      throw new ValidationError("Company ID must be a positive integer");
+    }
+    assertValidDate(record.closedThrough);
+    assertValidDate(record.closedAt);
+    return new ReportingPeriodState(
+      record.companyId,
+      normalizeBusinessDate(record.closedThrough),
+      new Date(record.closedAt.getTime()),
+      record.closedBy ?? null
+    );
+  }
+
+  isClosed(date: Date): boolean {
+    if (!this.closedThrough) return false;
+    return compareBusinessDates(date, this.closedThrough) <= 0;
+  }
+
+  assertOpen(date: Date): void {
+    if (this.closedThrough && this.isClosed(date)) {
+      throw new ReportingPeriodClosedError(date, this.closedThrough);
+    }
+  }
+
+  assertCanAdvanceTo(date: Date): void {
+    const requested = normalizeBusinessDate(date);
+    if (this.closedThrough && compareBusinessDates(requested, this.closedThrough) <= 0) {
+      throw new ReportingPeriodAlreadyClosedError(requested, this.closedThrough);
+    }
+  }
+
+  toPrimitives(): {
+    companyId: number;
+    closedThrough: Date | null;
+    closedAt: Date | null;
+    closedBy: number | null;
+  } {
+    return {
+      companyId: this.companyId,
+      closedThrough: this.closedThrough ? new Date(this.closedThrough.getTime()) : null,
+      closedAt: this.closedAt ? new Date(this.closedAt.getTime()) : null,
+      closedBy: this.closedBy
+    };
+  }
+}
