new file mode 100644
index 0000000..653d935
--- /dev/null
+++ b/db/migrations/035_reporting_period_close.sql
@@ -0,0 +1,13 @@
+-- Company-scoped reporting close history. The most recent closed_through date is
+-- the active lock boundary; prior rows are retained as an audit trail.
+CREATE TABLE reporting_period_close (
+  id             BIGSERIAL PRIMARY KEY,
+  company_id     BIGINT NOT NULL REFERENCES company(id) ON DELETE CASCADE,
+  closed_through DATE NOT NULL,
+  closed_by      BIGINT REFERENCES user_account(id),
+  closed_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  CONSTRAINT uq_reporting_period_close_company_date UNIQUE (company_id, closed_through)
+);
+
+CREATE INDEX idx_reporting_period_close_current
+  ON reporting_period_close (company_id, closed_through DESC, id DESC);
