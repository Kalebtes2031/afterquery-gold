@@ -0,0 +1,98 @@
+import { PoolClient } from "pg";
+import { pgPool } from "../../../shared/infrastructure/db/pgPool";
+import {
+  PeriodCloseBlocker,
+  ReportingPeriodCloseRecord,
+  normalizeBusinessDate
+} from "../domain/ReportingPeriodClose";
+import { ReportingPeriodCloseRepository } from "../domain/ReportingPeriodCloseRepository";
+
+type Queryable = {
+  query(text: string, params?: any[]): Promise<{ rowCount: number | null; rows: any[] }>;
+};
+
+function parseDatabaseDate(value: unknown): Date {
+  if (value instanceof Date) {
+    return new Date(Date.UTC(value.getFullYear(), value.getMonth(), value.getDate()));
+  }
+  const text = String(value);
+  const dateOnly = text.match(/^\d{4}-\d{2}-\d{2}/)?.[0];
+  if (!dateOnly) {
+    return new Date(NaN);
+  }
+  return new Date(`${dateOnly}T00:00:00.000Z`);
+}
+
+function mapRecord(row: any): ReportingPeriodCloseRecord {
+  return {
+    id: Number(row.id),
+    companyId: Number(row.company_id),
+    closedThrough: parseDatabaseDate(row.closed_through),
+    closedAt: new Date(row.closed_at),
+    closedBy: row.closed_by == null ? null : Number(row.closed_by)
+  };
+}
+
+export class PgReportingPeriodCloseRepository implements ReportingPeriodCloseRepository {
+  private db(client?: PoolClient): Queryable {
+    return client ?? pgPool;
+  }
+
+  async acquireCompanyCloseLock(companyId: number, client: PoolClient): Promise<void> {
+    await client.query("SELECT pg_advisory_xact_lock($1)", [companyId]);
+  }
+
+  async getCurrent(companyId: number, client?: PoolClient): Promise<ReportingPeriodCloseRecord | null> {
+    const result = await this.db(client).query(
+      `SELECT id, company_id, closed_through, closed_at, closed_by
+       FROM reporting_period_close
+       WHERE company_id = $1
+       ORDER BY closed_through DESC, id DESC
+       LIMIT 1`,
+      [companyId]
+    );
+    return result.rowCount ? mapRecord(result.rows[0]) : null;
+  }
+
+  async getEligibilityBlockers(companyId: number, throughDate: Date, client?: PoolClient): Promise<PeriodCloseBlocker[]> {
+    const date = normalizeBusinessDate(throughDate);
+    const result = await this.db(client).query(
+      `SELECT
+         (SELECT COUNT(*)::int
+            FROM sale_order
+           WHERE company_id = $1
+             AND order_date <= $2::date
+             AND status NOT IN ('CLOSED', 'CANCELLED')) AS open_sales,
+         (SELECT COUNT(*)::int
+            FROM purchase_order
+           WHERE company_id = $1
+             AND order_date <= $2::date
+             AND status NOT IN ('CLOSED', 'CANCELLED')) AS open_purchases`,
+      [companyId, formatDateParameter(date)]
+    );
+    const row = result.rows[0] ?? { open_sales: 0, open_purchases: 0 };
+    return [
+      { type: "OPEN_SALES", count: Number(row.open_sales ?? 0) },
+      { type: "OPEN_PURCHASES", count: Number(row.open_purchases ?? 0) }
+    ];
+  }
+
+  async insertClose(
+    companyId: number,
+    throughDate: Date,
+    closedBy: number | null,
+    client: PoolClient
+  ): Promise<ReportingPeriodCloseRecord> {
+    const result = await client.query(
+      `INSERT INTO reporting_period_close (company_id, closed_through, closed_by)
+       VALUES ($1, $2::date, $3)
+       RETURNING id, company_id, closed_through, closed_at, closed_by`,
+      [companyId, formatDateParameter(throughDate), closedBy]
+    );
+    return mapRecord(result.rows[0]);
+  }
+}
+
+function formatDateParameter(value: Date): string {
+  return normalizeBusinessDate(value).toISOString().slice(0, 10);
+}
