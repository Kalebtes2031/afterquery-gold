+
+  it("rejects an empty reserve item list", () => {
+    expect(reserveBranchStockSchema.safeParse({ draftKey: "draft-a", branchId: 2, items: [] }).success).toBe(false);
+  });
+
+  it("rejects non-positive reserve quantities", () => {
+    expect(reserveBranchStockSchema.safeParse({
+      draftKey: "draft-a",
+      branchId: 2,
+      items: [{ productId: 10, quantity: 0 }],
+    }).success).toBe(false);
+  });
+
+  it("accepts ttl bounds in reserve payloads", () => {
+    expect(reserveBranchStockSchema.safeParse({ draftKey: "a", branchId: 2, ttlMinutes: 1, items: [{ productId: 10, quantity: 1 }] }).success).toBe(true);
+    expect(reserveBranchStockSchema.safeParse({ draftKey: "a", branchId: 2, ttlMinutes: 120, items: [{ productId: 10, quantity: 1 }] }).success).toBe(true);
+  });
+
+  it("rejects ttl values outside reserve bounds", () => {
+    expect(reserveBranchStockSchema.safeParse({ draftKey: "a", branchId: 2, ttlMinutes: 0, items: [{ productId: 10, quantity: 1 }] }).success).toBe(false);
+    expect(reserveBranchStockSchema.safeParse({ draftKey: "a", branchId: 2, ttlMinutes: 121, items: [{ productId: 10, quantity: 1 }] }).success).toBe(false);
