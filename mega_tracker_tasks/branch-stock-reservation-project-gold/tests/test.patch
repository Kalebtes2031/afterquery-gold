+    d.repo.sumActiveReserved.mockResolvedValue(new Map([[10, 4], [11, 2]]));
+    const result = await d.service.availability(1, 2, [10, 11]);
+    expect(result).toEqual({
+      branchId: 2,
+      items: [
+        { productId: 10, onHand: 10, reserved: 4, available: 6 },
+        { productId: 11, onHand: 8, reserved: 2, available: 6 },
