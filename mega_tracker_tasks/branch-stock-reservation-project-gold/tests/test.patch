+import {
+  BranchStockReservation,
+  BranchStockReservationEventType,
+  BranchStockReservationStatus,
+  normalizeReservationQuantity,
+} from "../BranchStockReservation";
+import { ValidationError } from "../../../../shared/domain/DomainError";
+
+const NOW = new Date("2026-07-01T10:00:00.000Z");
+const LATER = new Date("2026-07-01T10:15:00.000Z");
+
+function make(overrides: any = {}) {
+  return BranchStockReservation.create({
+    companyId: 1,
+    draftKey: "draft-a",
+    branchId: 2,
+    expiresAt: LATER,
+    createdBy: 9,
+    items: [{ productId: 10, quantity: 3 }],
+    now: NOW,
+    ...overrides,
+  });
+}
+
+function hydrated(overrides: any = {}) {
+  return BranchStockReservation.hydrate({
