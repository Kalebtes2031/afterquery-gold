+
+  it("trims a reserve draft key", () => {
+    const parsed = reserveBranchStockSchema.parse({
+      draftKey: "  draft-a  ",
+      branchId: 2,
+      items: [{ productId: 10, quantity: 2 }],
+    });
+    expect(parsed.draftKey).toBe("draft-a");
+  });
+
+  it("rejects duplicate product lines in reserve payloads", () => {
+    const result = reserveBranchStockSchema.safeParse({
+      draftKey: "draft-a",
+      branchId: 2,
+      items: [{ productId: 10, quantity: 1 }, { productId: 10, quantity: 2 }],
