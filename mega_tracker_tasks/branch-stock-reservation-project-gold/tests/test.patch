+    const result = await d.service.reserve(reserveInput({ branchId: 3 }));
+    expect(result.branchId).toBe(3);
+    expect(d.repo.sumActiveReserved).toHaveBeenCalledWith(1, 3, [10], NOW, 55, CLIENT);
+  });
+
+  it("records branch, expiry and item snapshot in the reservation event", async () => {
