+    d.branches.findById.mockResolvedValue(null);
+    await expect(d.service.reserve(reserveInput())).rejects.toBeInstanceOf(EntityNotFoundError);
+  });
+
+  it("rejects an inactive branch", async () => {
+    const d = deps();
+    d.branches.findById.mockResolvedValue(branch(2, false));
+    await expect(d.service.reserve(reserveInput())).rejects.toBeInstanceOf(ValidationError);
+  });
+
+  it("rejects a product that does not belong to the company", async () => {
+    const d = deps();
+    d.products.findByIds.mockResolvedValue([]);
+    await expect(d.service.reserve(reserveInput())).rejects.toBeInstanceOf(EntityNotFoundError);
+  });
+
+  it("rejects an inactive product", async () => {
+    const d = deps();
+    d.products.findByIds.mockResolvedValue([product(10, false)]);
+    await expect(d.service.reserve(reserveInput())).rejects.toBeInstanceOf(ValidationError);
+  });
+
+  it("trims the draft key before repository lookup and persistence", async () => {
+    const d = deps();
+    const result = await d.service.reserve(reserveInput({ draftKey: "  draft-a  " }));
+    expect(result.draftKey).toBe("draft-a");
+    expect(d.repo.findByDraftKey).toHaveBeenCalledWith(1, "draft-a", CLIENT, true);
+  });
+
+  it("releases an active reservation and appends one release event", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
+    const result = await d.service.release(1, "draft-a", 12);
+    expect(result.status).toBe(BranchStockReservationStatus.RELEASED);
+    expect(d.repo.save).toHaveBeenCalledTimes(1);
+    expect(d.repo.appendEvent).toHaveBeenCalledWith(expect.objectContaining({
+      eventType: BranchStockReservationEventType.RELEASED,
+      createdBy: 12,
+    }), CLIENT);
+  });
+
+  it("makes releasing an already released reservation idempotent", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation({ status: BranchStockReservationStatus.RELEASED }));
+    const result = await d.service.release(1, "draft-a", 12);
+    expect(result.status).toBe(BranchStockReservationStatus.RELEASED);
+    expect(d.repo.save).not.toHaveBeenCalled();
+    expect(d.repo.appendEvent).not.toHaveBeenCalled();
+  });
+
+  it("returns not found when releasing an unknown draft", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(null);
+    await expect(d.service.release(1, "missing")).rejects.toBeInstanceOf(EntityNotFoundError);
+  });
+
+  it("expires due reservations before release lookup", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation({ status: BranchStockReservationStatus.EXPIRED }));
+    await d.service.release(1, "draft-a");
+    expect(d.repo.expireDue).toHaveBeenCalledWith(1, NOW, CLIENT);
+  });
+
+  it("refreshes an active reservation and emits REFRESHED", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
+    const result = await d.service.refresh(1, "draft-a", 30, 8);
+    expect(result.expiresAt).toEqual(new Date(NOW.getTime() + 30 * 60_000));
+    expect(d.repo.appendEvent).toHaveBeenCalledWith(expect.objectContaining({
+      eventType: BranchStockReservationEventType.REFRESHED,
+      createdBy: 8,
+    }), CLIENT);
+  });
+
+  it("uses default ttl when refreshing without ttlMinutes", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
+    const result = await d.service.refresh(1, "draft-a");
+    expect(result.expiresAt).toEqual(new Date(NOW.getTime() + 15 * 60_000));
+  });
+
+  it("rejects refreshing a released reservation", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation({ status: BranchStockReservationStatus.RELEASED }));
+    await expect(d.service.refresh(1, "draft-a", 30)).rejects.toBeInstanceOf(ValidationError);
+    expect(d.repo.save).not.toHaveBeenCalled();
+  });
+
+  it("returns not found when refreshing an unknown draft", async () => {
+    const d = deps();
+    await expect(d.service.refresh(1, "missing", 30)).rejects.toBeInstanceOf(EntityNotFoundError);
+  });
+
+  it("gets a reservation after first sweeping expirations", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
+    const result = await d.service.get(1, "draft-a");
+    expect(result.id).toBe(55);
+    expect(d.repo.expireDue).toHaveBeenCalledWith(1, NOW, CLIENT);
+  });
+
+  it("returns not found when getting an unknown draft", async () => {
+    const d = deps();
+    await expect(d.service.get(1, "missing")).rejects.toBeInstanceOf(EntityNotFoundError);
+  });
+
+  it("returns reservation ledger events in repository order", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
+    d.repo.listEvents.mockResolvedValue([
+      { id: 1, companyId: 1, reservationId: 55, draftKey: "draft-a", eventType: BranchStockReservationEventType.RESERVED, eventAt: NOW },
+      { id: 2, companyId: 1, reservationId: 55, draftKey: "draft-a", eventType: BranchStockReservationEventType.REFRESHED, eventAt: new Date(NOW.getTime() + 1) },
+    ]);
+    const result = await d.service.events(1, "draft-a");
+    expect(result.map(x => x.eventType)).toEqual(["RESERVED", "REFRESHED"]);
+    expect(d.repo.listEvents).toHaveBeenCalledWith(1, "draft-a", CLIENT);
+  });
+
+  it("does not expose an event ledger for an unknown reservation", async () => {
+    const d = deps();
+    await expect(d.service.events(1, "missing")).rejects.toBeInstanceOf(EntityNotFoundError);
+    expect(d.repo.listEvents).not.toHaveBeenCalled();
+  });
+
+  it("availability subtracts active reservations from physical on-hand stock", async () => {
