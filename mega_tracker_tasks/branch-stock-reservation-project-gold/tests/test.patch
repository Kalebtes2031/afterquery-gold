+import { BranchStockReservationUseCases } from "../BranchStockReservationUseCases";
+import {
+  BranchStockReservation,
+  BranchStockReservationEventType,
+  BranchStockReservationStatus,
+} from "../../domain/BranchStockReservation";
+import { Branch } from "../../../branches/domain/Branch";
+import { InventoryBalance } from "../../../inventory/domain/InventoryBalance";
+import { Product } from "../../../inventory/domain/Product";
+import { ConflictError, EntityNotFoundError, ValidationError } from "../../../../shared/domain/DomainError";
+import {
+  branchStockAvailabilityQuerySchema,
+  refreshBranchStockReservationSchema,
+  reserveBranchStockSchema,
+} from "../../presentation/SaleSchemas";
+
+const NOW = new Date("2026-07-01T10:00:00.000Z");
+const CLIENT = { marker: "tx-client" };
+
+function product(id: number, active = true) {
+  return Product.hydrate({
+    id,
+    companyId: 1,
+    productNo: `P-${id}`,
+    name: `Product ${id}`,
+    unitType: "pcs",
+    boughtPrice: 2,
+    sellingPrice: 3,
+    isActive: active,
+  });
+}
+
+function branch(id = 2, active = true) {
+  return Branch.hydrate({
+    id,
+    companyId: 1,
+    code: `B-${id}`,
+    name: `Branch ${id}`,
+    isWarehouse: false,
+    isActive: active,
+  });
+}
+
+function balance(productId: number, quantity: number, branchId = 2) {
+  return InventoryBalance.hydrate({ companyId: 1, branchId, productId, quantityOnHand: quantity });
+}
+
+function reservation(overrides: any = {}) {
+  return BranchStockReservation.hydrate({
+    id: 55,
+    companyId: 1,
+    draftKey: "draft-a",
+    branchId: 2,
+    status: BranchStockReservationStatus.ACTIVE,
+    expiresAt: new Date(NOW.getTime() + 15 * 60_000),
+    createdBy: 7,
+    createdAt: NOW,
+    updatedAt: NOW,
+    items: [{ productId: 10, quantity: 3 }],
+    ...overrides,
+  });
+}
+
+function deps() {
+  const repo = {
+    findByDraftKey: jest.fn().mockResolvedValue(null),
+    save: jest.fn().mockImplementation(async (r: BranchStockReservation) => {
+      const p = r.toPrimitives();
+      return BranchStockReservation.hydrate({ ...p, id: p.id ?? 55 });
+    }),
+    expireDue: jest.fn().mockResolvedValue(0),
+    sumActiveReserved: jest.fn().mockResolvedValue(new Map<number, number>()),
+    appendEvent: jest.fn().mockResolvedValue(undefined),
+    listEvents: jest.fn().mockResolvedValue([]),
+  } as any;
+  const balances = {
+    findByProductsBranch: jest.fn().mockResolvedValue([balance(10, 10), balance(11, 8)]),
+  } as any;
+  const products = {
+    findByIds: jest.fn().mockImplementation(async (_company: number, ids: number[]) => ids.map(id => product(id))),
+  } as any;
+  const branches = {
+    findById: jest.fn().mockResolvedValue(branch()),
+  } as any;
+  const tx = {
+    run: jest.fn().mockImplementation((cb: any) => cb(CLIENT)),
+  } as any;
+  const service = new BranchStockReservationUseCases(tx, repo, balances, products, branches, () => new Date(NOW));
+  return { repo, balances, products, branches, tx, service };
+}
+
+const reserveInput = (overrides: any = {}) => ({
+  companyId: 1,
+  draftKey: "draft-a",
+  branchId: 2,
+  createdBy: 7,
+  items: [{ productId: 10, quantity: 3 }],
+  ...overrides,
+});
+
+describe("branch stock reservation application behavior", () => {
+  it("reserves stock when requested quantity is within available branch stock", async () => {
+    const d = deps();
+    const result = await d.service.reserve(reserveInput());
+    expect(result.status).toBe(BranchStockReservationStatus.ACTIVE);
+    expect(result.items).toEqual([{ productId: 10, quantity: 3 }]);
+    expect(d.repo.save).toHaveBeenCalledTimes(1);
+  });
+
+  it("uses a 15 minute expiry by default", async () => {
+    const d = deps();
+    const result = await d.service.reserve(reserveInput());
+    expect(result.expiresAt).toEqual(new Date(NOW.getTime() + 15 * 60_000));
+  });
+
+  it("honors a custom reservation ttl", async () => {
+    const d = deps();
+    const result = await d.service.reserve(reserveInput({ ttlMinutes: 60 }));
+    expect(result.expiresAt).toEqual(new Date(NOW.getTime() + 60 * 60_000));
+  });
+
+  it("allows the minimum ttl of one minute", async () => {
+    const d = deps();
+    const result = await d.service.reserve(reserveInput({ ttlMinutes: 1 }));
+    expect(result.expiresAt).toEqual(new Date(NOW.getTime() + 60_000));
+  });
+
+  it("allows the maximum ttl of 120 minutes", async () => {
+    const d = deps();
+    const result = await d.service.reserve(reserveInput({ ttlMinutes: 120 }));
+    expect(result.expiresAt).toEqual(new Date(NOW.getTime() + 120 * 60_000));
+  });
+
+  it("rejects ttl zero before opening a transaction", async () => {
+    const d = deps();
+    await expect(d.service.reserve(reserveInput({ ttlMinutes: 0 }))).rejects.toBeInstanceOf(ValidationError);
+    expect(d.tx.run).not.toHaveBeenCalled();
+  });
+
+  it("rejects ttl above 120 before opening a transaction", async () => {
+    const d = deps();
+    await expect(d.service.reserve(reserveInput({ ttlMinutes: 121 }))).rejects.toBeInstanceOf(ValidationError);
+    expect(d.tx.run).not.toHaveBeenCalled();
+  });
+
+  it("rejects fractional ttl before opening a transaction", async () => {
+    const d = deps();
+    await expect(d.service.reserve(reserveInput({ ttlMinutes: 1.5 }))).rejects.toBeInstanceOf(ValidationError);
+  });
+
+  it("expires due reservations before evaluating a new reservation", async () => {
+    const d = deps();
+    await d.service.reserve(reserveInput());
+    expect(d.repo.expireDue).toHaveBeenCalledWith(1, NOW, CLIENT);
+    expect(d.repo.expireDue.mock.invocationCallOrder[0]).toBeLessThan(d.repo.sumActiveReserved.mock.invocationCallOrder[0]);
+  });
+
+  it("locks branch balances while checking reservation capacity", async () => {
+    const d = deps();
+    await d.service.reserve(reserveInput());
+    expect(d.balances.findByProductsBranch).toHaveBeenCalledWith(1, 2, [10], CLIENT, true);
+  });
+
+  it("subtracts quantities held by other active reservations", async () => {
+    const d = deps();
+    d.repo.sumActiveReserved.mockResolvedValue(new Map([[10, 8]]));
+    await expect(d.service.reserve(reserveInput({ items: [{ productId: 10, quantity: 3 }] }))).rejects.toBeInstanceOf(ConflictError);
+  });
+
+  it("allows a reservation exactly equal to available stock", async () => {
+    const d = deps();
+    d.repo.sumActiveReserved.mockResolvedValue(new Map([[10, 7]]));
+    await expect(d.service.reserve(reserveInput({ items: [{ productId: 10, quantity: 3 }] }))).resolves.toMatchObject({ status: "ACTIVE" });
+  });
+
+  it("reports requested and available quantity in a stock conflict", async () => {
+    const d = deps();
+    d.repo.sumActiveReserved.mockResolvedValue(new Map([[10, 9]]));
+    await expect(d.service.reserve(reserveInput())).rejects.toThrow("requested 3, available 1");
+  });
+
+  it("treats a missing branch balance as zero stock", async () => {
+    const d = deps();
+    d.balances.findByProductsBranch.mockResolvedValue([]);
+    await expect(d.service.reserve(reserveInput())).rejects.toBeInstanceOf(ConflictError);
+  });
+
+  it("validates every requested line before persisting anything", async () => {
+    const d = deps();
+    d.repo.sumActiveReserved.mockResolvedValue(new Map([[11, 8]]));
+    await expect(d.service.reserve(reserveInput({
+      items: [{ productId: 10, quantity: 1 }, { productId: 11, quantity: 1 }],
+    }))).rejects.toBeInstanceOf(ConflictError);
+    expect(d.repo.save).not.toHaveBeenCalled();
+    expect(d.repo.appendEvent).not.toHaveBeenCalled();
+  });
+
+  it("excludes the same draft reservation from reserved-by-others capacity", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
