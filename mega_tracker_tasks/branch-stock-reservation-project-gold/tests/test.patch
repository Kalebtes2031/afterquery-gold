+  });
+
+  it("logs RESERVED when a released draft key is reused", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation({ status: BranchStockReservationStatus.RELEASED }));
+    await d.service.reserve(reserveInput());
+    expect(d.repo.appendEvent).toHaveBeenCalledWith(expect.objectContaining({
+      eventType: BranchStockReservationEventType.RESERVED,
+    }), CLIENT);
+  });
+
+  it("allows an existing draft reservation to move to another branch", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
