+
+  it("logs REPLACED when the same active draft changes its reservation", async () => {
+    const d = deps();
+    d.repo.findByDraftKey.mockResolvedValue(reservation());
+    await d.service.reserve(reserveInput({ items: [{ productId: 10, quantity: 4 }] }));
+    expect(d.repo.appendEvent).toHaveBeenCalledWith(expect.objectContaining({
+      eventType: BranchStockReservationEventType.REPLACED,
+      draftKey: "draft-a",
