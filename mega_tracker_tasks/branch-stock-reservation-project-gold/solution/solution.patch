+    const query = branchStockAvailabilityQuerySchema.parse(req.query);
+    const result = await branchStockReservationUseCases.availability(companyId, query.branchId, query.productIds);
+    res.json(result);
+  } catch (err) {
+    sendErrorResponse(res, err);
+  }
+});
