+        ctx.addIssue({
+          code: z.ZodIssueCode.custom,
+          path: [i, "productId"],
+          message: `Product ${items[i].productId} cannot appear more than once`
+        });
+      }
+      seen.add(items[i].productId);
+    }
+  })
+});
+
+export const refreshBranchStockReservationSchema = z.object({
+  ttlMinutes: z.number().int().min(1).max(120).optional().default(15)
+});
+
+export const branchStockAvailabilityQuerySchema = z.object({
+  branchId: z.coerce.number().int().positive(),
+  productIds: z.string().min(1).transform(value => value.split(",").map(part => Number(part.trim())))
+}).superRefine((value, ctx) => {
+  if (value.productIds.length === 0 || value.productIds.length > 100) {
+    ctx.addIssue({ code: z.ZodIssueCode.custom, path: ["productIds"], message: "Provide between 1 and 100 product IDs" });
+  }
+  if (value.productIds.some(id => !Number.isInteger(id) || id <= 0)) {
+    ctx.addIssue({ code: z.ZodIssueCode.custom, path: ["productIds"], message: "productIds must be positive integers" });
