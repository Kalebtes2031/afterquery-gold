+SaleRouter.post("/stock-reservations", requireAuth, requirePermission(accessPolicy, "SALES", "create"), async (req: Request, res: Response) => {
+  try {
+    const companyId = parseCompanyId(req);
+    const createdBy = parseUserId(req);
+    const body = reserveBranchStockSchema.parse(req.body);
+    const result = await branchStockReservationUseCases.reserve({ companyId, createdBy, ...body });
+    res.status(201).json(result);
+  } catch (err) {
+    sendErrorResponse(res, err);
+  }
+});
+
+SaleRouter.get("/stock-reservations/availability", requireAuth, requirePermission(accessPolicy, "SALES", "view"), async (req: Request, res: Response) => {
+  try {
