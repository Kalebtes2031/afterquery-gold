+import { Pool, PoolClient } from "pg";
+import { pgPool } from "../../../shared/infrastructure/db/pgPool";
+import {
+  BranchStockReservation,
+  BranchStockReservationEventProps,
+  BranchStockReservationEventType,
+  BranchStockReservationProps,
+  BranchStockReservationRepository,
+  BranchStockReservationStatus
+} from "../domain/BranchStockReservation";
+
+function dbOf(client?: Pool | PoolClient): Pool | PoolClient {
+  return client || pgPool;
+}
+
+export class PgBranchStockReservationRepository implements BranchStockReservationRepository {
+  private async loadItems(reservationId: number, client?: Pool | PoolClient): Promise<Array<{ productId: number; quantity: number }>> {
+    const res = await dbOf(client).query(
+      `SELECT product_id, quantity
+         FROM branch_stock_reservation_item
+        WHERE reservation_id = $1
+        ORDER BY product_id`,
+      [reservationId]
+    );
+    return res.rows.map(row => ({
+      productId: Number(row.product_id),
+      quantity: Number(row.quantity)
+    }));
+  }
+
+  private async mapRow(row: any, client?: Pool | PoolClient): Promise<BranchStockReservation> {
+    const items = await this.loadItems(Number(row.id), client);
+    const props: BranchStockReservationProps = {
+      id: Number(row.id),
+      companyId: Number(row.company_id),
+      draftKey: String(row.draft_key),
+      branchId: Number(row.branch_id),
+      status: row.status as BranchStockReservationStatus,
+      expiresAt: new Date(row.expires_at),
+      createdBy: row.created_by == null ? null : Number(row.created_by),
+      createdAt: new Date(row.created_at),
+      updatedAt: new Date(row.updated_at),
+      items
+    };
+    return BranchStockReservation.hydrate(props);
+  }
+
+  async findByDraftKey(
+    companyId: number,
+    draftKey: string,
+    client?: Pool | PoolClient,
+    forUpdate = false
+  ): Promise<BranchStockReservation | null> {
+    const sql = `SELECT *
+                   FROM branch_stock_reservation
+                  WHERE company_id = $1 AND draft_key = $2${forUpdate ? " FOR UPDATE" : ""}`;
+    const res = await dbOf(client).query(sql, [companyId, draftKey]);
+    if (res.rowCount === 0) return null;
+    return this.mapRow(res.rows[0], client);
+  }
+
+  async save(reservation: BranchStockReservation, client?: Pool | PoolClient): Promise<BranchStockReservation> {
+    const db = dbOf(client);
+    const p = reservation.toPrimitives();
+    const saved = await db.query(
+      `INSERT INTO branch_stock_reservation (
+         company_id, draft_key, branch_id, status, expires_at, created_by, created_at, updated_at
+       )
+       VALUES ($1,$2,$3,$4,$5,$6,COALESCE($7,NOW()),COALESCE($8,NOW()))
+       ON CONFLICT (company_id, draft_key) DO UPDATE SET
+         branch_id = EXCLUDED.branch_id,
+         status = EXCLUDED.status,
+         expires_at = EXCLUDED.expires_at,
+         created_by = EXCLUDED.created_by,
+         updated_at = EXCLUDED.updated_at
+       RETURNING id`,
+      [
+        p.companyId,
+        p.draftKey,
+        p.branchId,
+        p.status,
+        p.expiresAt,
+        p.createdBy ?? null,
+        p.createdAt ?? null,
+        p.updatedAt ?? null
+      ]
+    );
+
+    const reservationId = Number(saved.rows[0].id);
+    await db.query("DELETE FROM branch_stock_reservation_item WHERE reservation_id = $1", [reservationId]);
+
+    if (p.items.length > 0) {
+      await db.query(
+        `INSERT INTO branch_stock_reservation_item (reservation_id, product_id, quantity)
+         SELECT $1, product_id, quantity
+           FROM unnest($2::bigint[], $3::numeric[]) AS x(product_id, quantity)`,
+        [reservationId, p.items.map(i => i.productId), p.items.map(i => i.quantity)]
+      );
+    }
+
+    const reloaded = await this.findByDraftKey(p.companyId, p.draftKey, client);
+    if (!reloaded) throw new Error("Failed to reload saved stock reservation");
+    return reloaded;
+  }
+
+  async expireDue(companyId: number, now: Date, client?: Pool | PoolClient): Promise<number> {
+    const res = await dbOf(client).query(
+      `WITH expired AS (
+         UPDATE branch_stock_reservation
+            SET status = 'EXPIRED', updated_at = $2
+          WHERE company_id = $1
+            AND status = 'ACTIVE'
+            AND expires_at <= $2
+         RETURNING id, company_id, draft_key, created_by, expires_at
+       ), inserted AS (
+         INSERT INTO branch_stock_reservation_event (
+           company_id, reservation_id, draft_key, event_type, event_at, created_by, details
+         )
+         SELECT company_id,
+                id,
+                draft_key,
+                'EXPIRED',
+                $2,
+                created_by,
+                jsonb_build_object('expiredAt', expires_at)
+           FROM expired
+         RETURNING id
+       )
+       SELECT COUNT(*)::int AS count FROM inserted`,
+      [companyId, now]
+    );
+    return Number(res.rows[0]?.count || 0);
+  }
+
+  async sumActiveReserved(
+    companyId: number,
+    branchId: number,
+    productIds: number[],
+    now: Date,
+    excludeReservationId?: number | null,
+    client?: Pool | PoolClient
+  ): Promise<Map<number, number>> {
+    if (productIds.length === 0) return new Map();
+    const res = await dbOf(client).query(
+      `SELECT i.product_id, COALESCE(SUM(i.quantity), 0) AS reserved_quantity
+         FROM branch_stock_reservation r
+         JOIN branch_stock_reservation_item i ON i.reservation_id = r.id
+        WHERE r.company_id = $1
+          AND r.branch_id = $2
+          AND r.status = 'ACTIVE'
+          AND r.expires_at > $3
+          AND i.product_id = ANY($4::bigint[])
+          AND ($5::bigint IS NULL OR r.id <> $5)
+        GROUP BY i.product_id`,
+      [companyId, branchId, now, productIds, excludeReservationId ?? null]
+    );
+
+    const totals = new Map<number, number>();
+    for (const row of res.rows) {
+      totals.set(Number(row.product_id), Number(row.reserved_quantity));
+    }
+    return totals;
+  }
+
+  async appendEvent(event: BranchStockReservationEventProps, client?: Pool | PoolClient): Promise<void> {
+    await dbOf(client).query(
+      `INSERT INTO branch_stock_reservation_event (
+         company_id, reservation_id, draft_key, event_type, event_at, created_by, details
+       ) VALUES ($1,$2,$3,$4,$5,$6,$7::jsonb)`,
+      [
+        event.companyId,
+        event.reservationId,
+        event.draftKey,
+        event.eventType,
+        event.eventAt,
+        event.createdBy ?? null,
+        JSON.stringify(event.details ?? {})
+      ]
+    );
+  }
+
+  async listEvents(companyId: number, draftKey: string, client?: Pool | PoolClient): Promise<BranchStockReservationEventProps[]> {
+    const res = await dbOf(client).query(
+      `SELECT id, company_id, reservation_id, draft_key, event_type, event_at, created_by, details
+         FROM branch_stock_reservation_event
+        WHERE company_id = $1 AND draft_key = $2
+        ORDER BY event_at, id`,
+      [companyId, draftKey]
+    );
+    return res.rows.map(row => ({
+      id: Number(row.id),
+      companyId: Number(row.company_id),
+      reservationId: Number(row.reservation_id),
+      draftKey: String(row.draft_key),
+      eventType: row.event_type as BranchStockReservationEventType,
+      eventAt: new Date(row.event_at),
+      createdBy: row.created_by == null ? null : Number(row.created_by),
+      details: row.details || {}
+    }));
+  }
+}
