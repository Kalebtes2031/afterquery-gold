+            .message
+            .contains("missing `endautoescape`"));
+    }
+
+    #[test]
+    fn stray_endautoescape_is_reported() {
+        assert!(template_err("{% endautoescape %}")
+            .message
+            .contains("unexpected `endautoescape`"));
+    }
+
+    #[test]
+    fn nested_autoescape_regions_parse() {
+        let parsed = template(
+            r#"{% autoescape "html" %}{% autoescape "js" %}x{% endautoescape %}{% endautoescape %}"#,
+        );
+        match &parsed.nodes[0] {
+            Node::Autoescape { mode, body, .. } => {
+                assert_eq!(*mode, EscapeMode::Html);
+                match &body[0] {
+                    Node::Autoescape { mode: inner, .. } => assert_eq!(*inner, EscapeMode::Js),
+                    other => panic!("expected inner autoescape, got {other:?}"),
+                }
+            }
+            other => panic!("expected autoescape, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn autoescape_rejects_dynamic_mode_expressions() {
+        assert!(template_err("{% autoescape mode %}x{% endautoescape %}")
+            .message
+            .contains("needs a mode name"));
+    }
+
+    #[test]
+    fn autoescape_can_wrap_filter_blocks() {
+        match &template(r#"{% autoescape "html" %}{% filter upper %}x{% endfilter %}{% endautoescape %}"#).nodes[0]
+        {
+            Node::Autoescape { body, .. } => match &body[0] {
+                Node::FilterBlock { .. } => {}
+                other => panic!("expected filter block, got {other:?}"),
+            },
+            other => panic!("expected autoescape, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn autoescape_can_wrap_include_tags() {
+        match &template(r#"{% autoescape "html" %}{% include "part" %}{% endautoescape %}"#).nodes[0] {
+            Node::Autoescape { body, .. } => match &body[0] {
+                Node::Include { .. } => {}
+                other => panic!("expected include, got {other:?}"),
+            },
+            other => panic!("expected autoescape, got {other:?}"),
+        }
+    }
 }
