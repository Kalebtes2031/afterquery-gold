 //! Escaping for the output languages a template usually targets.
 
+/// How `{{ … }}` output is escaped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum EscapeMode {
+    /// Values are written verbatim.
+    #[default]
+    None,
+    /// Values are HTML escaped unless the expression's outermost filter is
+    /// `safe`.
+    Html,
+    /// Values are escaped for XML attribute contexts.
+    Xml,
+    /// Values are percent-encoded for URL contexts.
+    Url,
+    /// Values are escaped for JavaScript string contexts.
+    Js,
+}
+
+impl EscapeMode {
+    /// The name used on the command line and in diagnostics.
+    pub fn name(self) -> &'static str {
+        match self {
+            EscapeMode::None => "none",
+            EscapeMode::Html => "html",
+            EscapeMode::Xml => "xml",
+            EscapeMode::Url => "url",
+            EscapeMode::Js => "js",
+        }
+    }
+
+    /// Parses a mode name, case-insensitively.
+    pub fn parse_case_insensitive(name: &str) -> Option<EscapeMode> {
+        match name.to_ascii_lowercase().as_str() {
+            "none" | "off" | "false" => Some(EscapeMode::None),
+            "html" => Some(EscapeMode::Html),
+            "xml" => Some(EscapeMode::Xml),
+            "url" => Some(EscapeMode::Url),
+            "js" => Some(EscapeMode::Js),
+            _ => None,
+        }
+    }
+
+    /// Parses a mode name for the command line.
+    pub fn parse(name: &str) -> Option<EscapeMode> {
+        Self::parse_case_insensitive(name)
+    }
+
+    /// Escapes text for this mode.
+    pub fn apply(self, text: &str) -> String {
+        match self {
+            EscapeMode::None => text.to_string(),
+            EscapeMode::Html => html(text),
+            EscapeMode::Xml => xml_attribute(text),
+            EscapeMode::Url => url(text),
+            EscapeMode::Js => js(text),
+        }
+    }
+}
+
 /// The five characters HTML escaping replaces.
 pub const HTML_UNSAFE: [char; 5] = ['&', '<', '>', '"', '\''];
 
