+//! Scoped autoescape regions and multi-mode output escaping at render time.
+
+use stencilworks::{memory_environment, Environment, EscapeMode, ErrorKind, Options, Value, ValueMap};
+
+fn context() -> ValueMap {
+    let mut map = ValueMap::new();
+    map.insert("html", Value::text("<b>bold</b>"));
+    map.insert("url", Value::text("a/b?c=d"));
+    map.insert("js", Value::text("line\nbreak"));
+    map.insert("tab", Value::text("a\tb"));
+    map.insert("quote", Value::text("say \"hi\""));
+    map.insert("plain", Value::text("hello"));
+    map
+}
+
+fn render(text: &str) -> String {
+    Environment::new()
+        .render("page", text, &context())
+        .unwrap()
+}
+
+fn render_with_options(text: &str, options: Options) -> String {
+    let mut env = Environment::new();
+    env.set_options(options);
+    env.render("page", text, &context()).unwrap()
+}
+
+fn render_with_loader(text: &str, templates: &[(&str, &str)]) -> String {
+    memory_environment(templates.iter().copied())
+        .render("page", text, &context())
+        .unwrap()
+}
+
+fn fail(text: &str) -> stencilworks::Error {
+    Environment::new()
+        .render("page", text, &context())
+        .unwrap_err()
+}
+
+#[test]
+fn default_rendering_leaves_values_unescaped() {
