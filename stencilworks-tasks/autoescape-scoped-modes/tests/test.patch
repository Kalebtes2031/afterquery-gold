+#[test]
+fn inner_render_errors_do_not_leak_escape_mode() {
+    let options = Options::new().escaping(EscapeMode::Html);
+    let mut env = Environment::new();
+    env.set_options(options);
+    let tpl = concat!(
+        "{% autoescape \"url\" %}",
+        "{% autoescape \"js\" %}{{ missing }}{% endautoescape %}",
+        "{% endautoescape %}"
+    );
+    let err = env.render("page", tpl, &context()).unwrap_err();
+    assert_eq!(err.kind, ErrorKind::Undefined);
+    let tpl = "{% autoescape \"html\" %}{{ html }}{% endautoescape %}";
+    assert_eq!(env.render("page", tpl, &context()).unwrap(), "&lt;b&gt;bold&lt;/b&gt;");
