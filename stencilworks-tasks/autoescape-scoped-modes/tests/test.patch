+//! Parsing autoescape regions, template checking, and CLI escape flags.
+
+use std::path::PathBuf;
+use std::process::Command;
+
+use stencilworks::{
+    parse_template, Environment, EscapeMode, ErrorKind, Options, Source,
+};
+use stencilworks::syntax::printer::{outline, print_template};
+
+struct Tree {
+    root: PathBuf,
+}
+
+impl Tree {
+    fn new(files: &[(&str, &str)]) -> Tree {
+        let stamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or(0);
+        let mut root = std::env::temp_dir();
+        root.push(format!(
+            "stencilworks-autoescape-{stamp}-{:?}",
+            std::thread::current().id()
+        ));
+        std::fs::create_dir_all(&root).expect("create tree");
+        for (name, text) in files {
+            let path = root.join(name);
+            if let Some(parent) = path.parent() {
+                std::fs::create_dir_all(parent).expect("create parent");
+            }
+            std::fs::write(path, text).expect("write file");
+        }
+        Tree { root }
+    }
+
+    fn path(&self, name: &str) -> String {
+        self.root.join(name).to_string_lossy().to_string()
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+struct Output {
+    stdout: String,
+    stderr: String,
+    code: i32,
+}
+
+fn stencil(arguments: &[&str]) -> Output {
+    let result = Command::new(env!("CARGO_BIN_EXE_stencil"))
+        .args(arguments)
+        .output()
+        .expect("run the binary");
+    Output {
+        stdout: String::from_utf8_lossy(&result.stdout).to_string(),
+        stderr: String::from_utf8_lossy(&result.stderr).to_string(),
+        code: result.status.code().unwrap_or(-1),
+    }
+}
+
+fn parse(name: &str, text: &str) -> stencilworks::Template {
+    parse_template(&Source::new(name, text)).unwrap()
+}
+
+fn fail_parse(name: &str, text: &str) -> stencilworks::Error {
+    parse_template(&Source::new(name, text)).unwrap_err()
+}
+
+#[test]
+fn autoescape_parses_into_a_dedicated_node() {
+    let template = parse("t", "{% autoescape \"html\" %}{{ x }}{% endautoescape %}");
+    assert_eq!(template.nodes.len(), 1);
+    assert_eq!(template.nodes[0].kind(), "autoescape");
+}
+
+#[test]
+fn autoescape_accepts_every_supported_mode() {
+    for mode in ["html", "xml", "url", "js", "none"] {
+        let text = format!("{{% autoescape \"{mode}\" %}}x{{% endautoescape %}}");
+        let template = parse("t", &text);
+        assert_eq!(template.nodes.len(), 1, "mode {mode}");
+        assert_eq!(template.nodes[0].kind(), "autoescape");
+    }
+}
+
+#[test]
+fn autoescape_accepts_boolean_false() {
+    let template = parse("t", "{% autoescape false %}{{ x }}{% endautoescape %}");
+    assert_eq!(template.nodes.len(), 1);
+    assert_eq!(template.nodes[0].kind(), "autoescape");
+}
+
+#[test]
+fn autoescape_mode_names_parse_case_insensitively() {
