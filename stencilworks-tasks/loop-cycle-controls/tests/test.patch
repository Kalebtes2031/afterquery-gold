+//! Loop cycling through `loop.cycle` and the `{% cycle %}` tag.
+
+use stencilworks::{parse_template, Environment, Source, Value, ValueMap};
+
+fn list(values: &[&str]) -> Value {
+    Value::List(values.iter().map(|text| Value::text(*text)).collect())
+}
+
+fn render(text: &str, context: &ValueMap) -> String {
+    Environment::new().render("t", text, context).unwrap()
+}
+
+fn fail(text: &str, context: &ValueMap) -> stencilworks::Error {
+    Environment::new()
+        .render("t", text, context)
+        .unwrap_err()
+}
+
+fn ctx(items: &[&str]) -> ValueMap {
+    let mut map = ValueMap::new();
+    map.insert("items", list(items));
+    map
+}
+
+#[test]
+fn loop_cycle_alternates_by_iteration_index() {
+    let out = render(
+        r#"{% for item in items %}{{ loop.cycle("odd", "even") }} {% endfor %}"#,
+        &ctx(&["a", "b", "c", "d"]),
+    );
+    assert_eq!(out, "odd even odd even ");
+}
+
+#[test]
+fn loop_cycle_wraps_by_argument_count() {
+    let out = render(
+        r#"{% for item in items %}{{ loop.cycle("a", "b", "c") }}{% endfor %}"#,
+        &ctx(&["1", "2", "3", "4", "5"]),
+    );
+    assert_eq!(out, "abcab");
+}
+
+#[test]
+fn loop_cycle_with_no_arguments_renders_nothing() {
+    let out = render(
+        r#"{% for item in items %}[{{ loop.cycle() }}]{% endfor %}"#,
+        &ctx(&["x"]),
+    );
+    assert_eq!(out, "[]");
+}
+
+#[test]
+fn loop_cycle_outside_a_for_loop_is_an_error() {
+    let err = fail(r#"{{ loop.cycle("a") }}"#, &ValueMap::new());
+    assert!(err.to_string().contains("inside a for loop"));
+}
+
+#[test]
+fn anonymous_cycle_tag_rotates_each_time_it_runs() {
+    let out = render(
+        r#"{% for item in items %}{% cycle "a", "b", "c" %}{% endfor %}"#,
+        &ctx(&["1", "2", "3", "4"]),
+    );
+    assert_eq!(out, "abca");
+}
+
+#[test]
+fn named_cycle_groups_advance_across_separate_loops() {
+    let out = render(
+        r#"{% for item in items %}{% cycle stripe "x", "y" %}{% endfor %}|{% for item in items %}{% cycle stripe "x", "y" %}{% endfor %}"#,
+        &ctx(&["1", "2"]),
+    );
+    assert_eq!(out, "xy|xy");
+}
+
+#[test]
+fn named_cycle_works_outside_a_for_loop() {
+    let out = render(r#"{% cycle row "a", "b" %}{% cycle row "a", "b" %}"#, &ValueMap::new());
+    assert_eq!(out, "ab");
+}
+
+#[test]
+fn anonymous_cycle_outside_a_for_loop_is_an_error() {
+    let err = fail(r#"{% cycle "a", "b" %}"#, &ValueMap::new());
+    assert!(err.to_string().contains("inside a for loop"));
+}
+
+#[test]
+fn nested_loops_keep_independent_anonymous_cycle_cursors() {
+    let mut map = ValueMap::new();
+    map.insert("rows", list(&["r1", "r2"]));
+    map.insert("cols", list(&["c1", "c2"]));
+    let out = render(
+        r#"{% for row in rows %}{% for col in cols %}{% cycle "A", "B" %}{% endfor %};{% endfor %}"#,
+        &map,
+    );
+    assert_eq!(out, "AB;AB;");
+}
+
+#[test]
+fn loop_cycle_in_a_nested_loop_uses_the_inner_loop_index() {
+    let mut map = ValueMap::new();
+    map.insert("rows", list(&["r1", "r2"]));
+    map.insert("cols", list(&["c1", "c2", "c3"]));
+    let out = render(
+        r#"{% for row in rows %}{% for col in cols %}{{ loop.cycle("0", "1") }}{% endfor %}|{% endfor %}"#,
+        &map,
+    );
+    assert_eq!(out, "010|010|");
+}
+
+#[test]
+fn existing_loop_fields_stay_available_alongside_cycle() {
+    let out = render(
+        r#"{% for item in items %}{{ loop.index }}:{{ loop.cycle("x", "y") }};{% endfor %}"#,
+        &ctx(&["a", "b", "c"]),
+    );
+    assert_eq!(out, "1:x;2:y;3:x;");
+}
+
+#[test]
+fn empty_loops_do_not_render_cycle_output() {
+    let mut map = ValueMap::new();
+    map.insert("items", list(&[]));
+    let out = render(
+        r#"{% for item in items %}{% cycle "a", "b" %}{% else %}empty{% endfor %}"#,
+        &map,
+    );
+    assert_eq!(out, "empty");
+}
+
+#[test]
+fn named_cycle_continues_after_an_empty_loop() {
+    let mut map = ValueMap::new();
+    map.insert("empty", list(&[]));
+    map.insert("items", list(&["a", "b"]));
+    let out = render(
+        r#"{% for x in empty %}{% cycle band "1", "2" %}{% endfor %}{% for y in items %}{% cycle band "1", "2" %}{% endfor %}"#,
+        &map,
+    );
+    assert_eq!(out, "12");
+}
+
+#[test]
+fn cycle_tag_evaluates_expressions_for_values() {
+    let mut map = ValueMap::new();
+    map.insert("items", list(&["a", "b", "c"]));
+    map.insert("left", Value::text("L"));
+    map.insert("right", Value::text("R"));
+    let out = render(
+        r#"{% for item in items %}{% cycle left, right %}{% endfor %}"#,
+        &map,
+    );
+    assert_eq!(out, "LRL");
+}
+
+#[test]
+fn repeated_renders_with_the_same_template_stay_stable() {
+    let template = r#"{% for item in items %}{{ loop.cycle("a", "b") }}{% endfor %}"#;
+    let context = ctx(&["1", "2", "3"]);
+    let first = render(template, &context);
+    let second = render(template, &context);
+    assert_eq!(first, "aba");
+    assert_eq!(second, "aba");
+}
+
+#[test]
+fn cycle_with_a_single_value_repeats_it() {
+    let out = render(
+        r#"{% for item in items %}{% cycle "only" %}{% endfor %}"#,
+        &ctx(&["1", "2", "3"]),
+    );
+    assert_eq!(out, "onlyonlyonly");
+}
+
+#[test]
+fn multiple_cycle_tags_in_one_iteration_advance_the_cursor() {
+    let out = render(
+        r#"{% for item in items %}{% cycle "a", "b" %}/{% cycle "a", "b" %};{% endfor %}"#,
+        &ctx(&["1", "2"]),
+    );
+    assert_eq!(out, "a/b;a/b;");
+}
+
+#[test]
+fn loop_cycle_and_cycle_tag_are_independent() {
+    let out = render(
+        r#"{% for item in items %}{{ loop.cycle("L", "R") }}:{% cycle "T", "B" %};{% endfor %}"#,
+        &ctx(&["1", "2", "3"]),
+    );
+    assert_eq!(out, "L:T;R:B;L:T;");
+}
+
+#[test]
+fn a_cycle_tag_with_no_values_is_a_parse_error() {
+    let err = parse_template(&Source::new("t", "{% cycle %}")).unwrap_err();
+    assert!(err.to_string().contains("at least one value"));
+}
+
+#[test]
+fn check_accepts_templates_with_cycle_tags() {
+    let parsed = parse_template(&Source::new(
+        "page",
+        r#"{% for x in xs %}{% cycle "a", "b" %}{% endfor %}"#,
+    ))
+    .unwrap();
+    assert_eq!(parsed.nodes.len(), 1);
+}
+
