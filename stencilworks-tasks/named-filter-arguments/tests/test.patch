+//! Keyword arguments on filters, exercised through `Environment::render`.
+
+use stencilworks::{Environment, ErrorKind, Value, ValueMap};
+
+fn context() -> ValueMap {
+    let mut map = ValueMap::new();
+    map.insert("text", Value::text("Hello Brave World"));
+    map.insert("padded", Value::text("hi"));
+    map.insert("messy", Value::text("--ab--"));
+    map.insert("csvish", Value::text("a,b,c,d"));
+    map.insert("swap", Value::text("aa-aa"));
+    map.insert("n", Value::from(1234.5678));
+    map.insert("half", Value::from(1234.5));
+    map.insert("blank", Value::Null);
+    map.insert("empty", Value::text(""));
+    map.insert(
+        "items",
+        Value::list([Value::from(1.0), Value::from(2.0), Value::from(3.0)]),
+    );
+    map.insert(
+        "people",
+        Value::list([
+            Value::map([
+                ("name".to_string(), Value::text("bo")),
+                ("team".to_string(), Value::text("ops")),
+            ]),
+            Value::map([
+                ("name".to_string(), Value::text("ada")),
+                ("team".to_string(), Value::text("core")),
+            ]),
+        ]),
+    );
+    map.insert(
+        "config",
+        Value::map([
+            ("a".to_string(), Value::from(1.0)),
+            ("b".to_string(), Value::from(2.0)),
+        ]),
+    );
+    map.insert("multiline", Value::text("a\n\nb"));
+    map.insert("width", Value::from(8.0));
+    map.insert("suffix", Value::text("..."));
+    map
+}
+
+fn render(text: &str) -> String {
+    Environment::new().render("t", text, &context()).unwrap()
+}
+
+fn fail(text: &str) -> stencilworks::Error {
+    Environment::new()
+        .render("page.html", text, &context())
+        .unwrap_err()
+}
+
+#[test]
+fn truncate_accepts_positional_width_with_keyword_end_using_ascii_dots() {
+    assert_eq!(
+        render(r#"{{ text | truncate(12, end="...") }}"#),
+        "Hello Bra..."
+    );
+    assert_eq!(
+        render(r#"{{ text | truncate(8, end="..") }}"#),
+        "Hello .."
+    );
+}
+
+#[test]
+fn truncate_accepts_positional_width_with_unicode_ellipsis_keyword() {
+    assert_eq!(
+        render("{{ text | truncate(12, end=\"…\") }}"),
+        "Hello Brave…"
+    );
+    assert_eq!(
+        render("{{ text | truncate(8, end=\"…\") }}"),
+        "Hello B…"
+    );
+}
+
+#[test]
+fn truncate_accepts_both_width_and_end_as_keywords() {
+    assert_eq!(
+        render(r#"{{ text | truncate(width=12, end="...") }}"#),
+        "Hello Bra..."
+    );
+    assert_eq!(
+        render("{{ text | truncate(width=8, end=\"…\") }}"),
+        "Hello B…"
+    );
+    assert_eq!(
+        render(r#"{{ text | truncate(end="!", width=10) }}"#),
+        "Hello Bra!"
+    );
+}
+
+#[test]
+fn pad_family_accepts_fill_keyword_alongside_width() {
+    assert_eq!(
+        render(r#"{{ padded | pad_start(width=5, fill="*") }}"#),
+        "***hi"
+    );
+    assert_eq!(
+        render(r#"{{ padded | pad_end(width=5, fill="-") }}"#),
+        "hi---"
+    );
+    assert_eq!(
+        render(r#"{{ padded | center(width=6, fill=".") }}"#),
+        "..hi.."
+    );
+    assert_eq!(
+        render(r#"{{ padded | pad_start(5, fill="0") }}"#),
+        "000hi"
+    );
+}
+
+#[test]
+fn indent_accepts_prefix_and_blank_keywords() {
+    assert_eq!(
+        render(r#"{{ multiline | indent(prefix=">") }}"#),
+        ">a\n\n>b"
+    );
+    assert_eq!(
+        render(r#"{{ multiline | indent(prefix=">", blank=true) }}"#),
+        ">a\n>\n>b"
+    );
+    assert_eq!(
+        render(r#"{{ multiline | indent(prefix=">>", blank=false) }}"#),
+        ">>a\n\n>>b"
+    );
+}
+
+#[test]
+fn replace_accepts_count_keyword_to_limit_substitutions() {
+    assert_eq!(
+        render(r#"{{ swap | replace(pattern="a", replacement="x", count=2) }}"#),
+        "xx-aa"
+    );
+    assert_eq!(
+        render(r#"{{ swap | replace("a", "x", count=1) }}"#),
+        "xa-aa"
+    );
+    assert_eq!(
+        render(r#"{{ swap | replace(pattern="a", replacement="x") }}"#),
+        "xx-xx"
+    );
+}
+
+#[test]
+fn split_accepts_sep_and_limit_keywords() {
+    assert_eq!(
+        render(r#"{{ csvish | split(sep=",", limit=2) | join(sep="|") }}"#),
+        "a|b,c,d"
+    );
+    assert_eq!(
+        render(r#"{{ csvish | split(sep=",") | length }}"#),
+        "4"
+    );
+    assert_eq!(
+        render(r#"{{ csvish | split(sep=",", limit=3) | join("-") }}"#),
+        "a-b-c,d"
+    );
+}
+
+#[test]
+fn trim_variants_accept_chars_keyword() {
+    assert_eq!(render(r#"{{ messy | trim(chars="-") }}"#), "ab");
+    assert_eq!(render(r#"{{ messy | ltrim(chars="-") }}"#), "ab--");
+    assert_eq!(render(r#"{{ messy | rtrim(chars="-") }}"#), "--ab");
+    assert_eq!(
+        render(r#"{{ "xxabxx" | trim(chars="x") }}"#),
+        "ab"
+    );
+}
+
+#[test]
+fn slice_accepts_start_and_end_keywords() {
+    assert_eq!(
+        render(r#"{{ text | slice(start=0, end=5) }}"#),
+        "Hello"
+    );
+    assert_eq!(
+        render(r#"{{ text | slice(start=6, end=11) }}"#),
+        "Brave"
+    );
+    assert_eq!(
+        render(r#"{{ text | slice(6, end=11) }}"#),
+        "Brave"
+    );
+}
+
+#[test]
+fn join_accepts_sep_and_final_sep_keywords() {
+    assert_eq!(
+        render(r#"{{ items | join(sep=",", final_sep=" and ") }}"#),
+        "1,2 and 3"
+    );
+    assert_eq!(
+        render(r#"{{ items | join(sep="-") }}"#),
+        "1-2-3"
+    );
+    assert_eq!(
+        render(r#"{{ items | join(final_sep=" + ", sep=", ") }}"#),
+        "1, 2 + 3"
+    );
+}
+
+#[test]
+fn sort_accepts_field_keyword_for_record_lists() {
+    assert_eq!(
+        render(r#"{{ people | sort(field="name") | pluck("name") | join(",") }}"#),
+        "ada,bo"
+    );
+    assert_eq!(
+        render(r#"{{ people | sort(field="team") | pluck("team") | join("/") }}"#),
+        "core/ops"
+    );
+}
+
+#[test]
+fn get_accepts_key_and_default_keywords() {
+    assert_eq!(
+        render(r#"{{ config | get(key="a") }}"#),
+        "1"
+    );
+    assert_eq!(
+        render(r#"{{ config | get(key="z", default="missing") }}"#),
+        "missing"
+    );
+    assert_eq!(
+        render(r#"{{ config | get("z", default="gone") }}"#),
+        "gone"
+    );
+}
+
+#[test]
+fn default_filter_accepts_fallback_and_falsy_keywords() {
+    assert_eq!(
+        render(r#"{{ blank | default(fallback="none") }}"#),
+        "none"
+    );
+    assert_eq!(
+        render(r#"{{ empty | default(fallback="none") }}"#),
+        ""
+    );
+    assert_eq!(
+        render(r#"{{ empty | default(fallback="none", falsy=true) }}"#),
+        "none"
+    );
+    assert_eq!(
+        render(r#"{{ text | default(fallback="x", falsy=true) }}"#),
+        "Hello Brave World"
+    );
+}
+
+#[test]
+fn round_accepts_digits_keyword() {
+    assert_eq!(render(r#"{{ n | round(digits=2) }}"#), "1234.57");
+    assert_eq!(render(r#"{{ n | round(digits=0) }}"#), "1235");
+    assert_eq!(render(r#"{{ 1.005 | round(digits=2) }}"#), "1.01");
+}
+
+#[test]
+fn mixed_positional_then_keyword_binds_remaining_slots() {
+    assert_eq!(
+        render(r#"{{ text | truncate(10, end="!") }}"#),
+        "Hello Bra!"
+    );
+    assert_eq!(
+        render(r#"{{ padded | pad_end(4, fill=".") }}"#),
+        "hi.."
+    );
+    assert_eq!(
+        render(r#"{{ swap | replace("a", "Q", count=1) }}"#),
+        "Qa-aa"
+    );
+    assert_eq!(
+        render(r#"{{ csvish | split(",", limit=2) | first }}"#),
+        "a"
+    );
+}
+
+#[test]
+fn keyword_values_may_be_expressions_and_filter_pipelines() {
+    assert_eq!(
+        render(r#"{{ text | truncate(width=width, end=suffix) }}"#),
+        "Hello..."
+    );
+    assert_eq!(
+        render(r#"{{ text | truncate(width=items | length, end=".") }}"#),
+        "He."
+    );
+    assert_eq!(
+        render(r#"{{ text | slice(start=0, end=width | int) }}"#),
+        "Hello Br"
+    );
+    assert_eq!(
+        render(r#"{{ items | join(sep=suffix | slice(0, 1)) }}"#),
+        "1.2.3"
+    );
+}
+
+#[test]
+fn unknown_keyword_error_names_the_filter() {
+    let err = fail(r#"{{ text | truncate(width=8, nope=1) }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("truncate"), "{}", err.message);
+    assert!(err.message.contains("unknown keyword"), "{}", err.message);
+    assert!(err.message.contains("nope"), "{}", err.message);
+}
+
+#[test]
+fn duplicate_keyword_error_names_the_filter() {
+    let err = fail(r#"{{ text | truncate(width=5, width=8) }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("truncate"), "{}", err.message);
+    assert!(err.message.contains("duplicate keyword"), "{}", err.message);
+    assert!(err.message.contains("width"), "{}", err.message);
+}
+
+#[test]
+fn positional_argument_after_keyword_is_a_syntax_error() {
+    let err = fail(r#"{{ text | truncate(end="...", 12) }}"#);
+    assert_eq!(err.kind, ErrorKind::Syntax);
+    assert!(
+        err.message.contains("positional argument after keyword"),
+        "{}",
+        err.message
+    );
+}
+
+#[test]
+fn malformed_keyword_assign_without_value_is_a_syntax_error() {
+    let err = fail(r#"{{ text | truncate(end=) }}"#);
+    assert_eq!(err.kind, ErrorKind::Syntax);
+    assert!(
+        err.message.contains("expected a value after `end=`"),
+        "{}",
+        err.message
+    );
+    let err = fail(r#"{{ text | truncate(width=, end="x") }}"#);
+    assert!(
+        err.message.contains("expected a value after `width=`"),
+        "{}",
+        err.message
+    );
+}
+
+#[test]
+fn arity_still_enforced_when_required_slots_are_missing() {
+    let err = fail(r#"{{ text | truncate(end="...") }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("truncate"), "{}", err.message);
+    let err = fail(r#"{{ padded | pad_start(fill="*") }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("pad_start"), "{}", err.message);
+}
+
+#[test]
+fn filters_without_declared_keywords_reject_keyword_calls() {
+    let err = fail(r#"{{ text | upper(x=1) }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("upper"), "{}", err.message);
+    assert!(err.message.contains("unknown keyword"), "{}", err.message);
+    assert!(err.message.contains("x"), "{}", err.message);
+
+    let err = fail(r#"{{ items | length(n=1) }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("length"), "{}", err.message);
+    assert!(err.message.contains("unknown keyword"), "{}", err.message);
+}
+
+#[test]
+fn pure_positional_forms_match_equivalent_keyword_forms() {
+    assert_eq!(
+        render(r#"{{ text | truncate(8) }}"#),
+        render(r#"{{ text | truncate(width=8) }}"#)
+    );
+    assert_eq!(
+        render(r#"{{ text | truncate(10, "...") }}"#),
+        render(r#"{{ text | truncate(width=10, end="...") }}"#)
+    );
+    assert_eq!(
+        render(r#"{{ padded | pad_start(5, "*") }}"#),
+        render(r#"{{ padded | pad_start(width=5, fill="*") }}"#)
+    );
+    assert_eq!(
+        render(r#"{{ padded | pad_end(5, "-") }}"#),
+        render(r#"{{ padded | pad_end(width=5, fill="-") }}"#)
+    );
+    assert_eq!(
+        render(r#"{{ padded | center(6, ".") }}"#),
+        render(r#"{{ padded | center(width=6, fill=".") }}"#)
+    );
+}
+
+#[test]
+fn filter_block_accepts_keyword_arguments_on_the_filter_tag() {
+    assert_eq!(
+        render("{% filter indent(prefix=\">\") %}a\nb{% endfilter %}"),
+        ">a\n>b"
+    );
+    assert_eq!(
+        render("{% filter indent(prefix=\">>\", blank=true) %}a\n\nb{% endfilter %}"),
+        ">>a\n>>\n>>b"
+    );
+    assert_eq!(
+        render(r#"{% filter truncate(width=6, end="!") %}abcdefghi{% endfilter %}"#),
+        "abcde!"
+    );
+}
+
+#[test]
+fn chained_and_nested_filters_carry_keyword_arguments() {
+    assert_eq!(
+        render(r#"{{ text | lower | truncate(width=9, end="...") }}"#),
+        "hello ..."
+    );
+    assert_eq!(
+        render(r#"{{ text | slice(start=0, end=11) | truncate(width=8, end="!") }}"#),
+        "Hello B!"
+    );
+    assert_eq!(
+        render(
+            r#"{{ people | sort(field="name") | pluck("name") | join(sep="/", final_sep="+") }}"#
+        ),
+        "ada+bo"
+    );
+}
+
+#[test]
+fn multiple_independent_keyword_calls_in_one_template() {
+    let out = render(
+        r#"{{ text | truncate(width=5, end=".") }}|{{ padded | pad_start(width=4, fill="0") }}|{{ n | round(digits=1) }}"#,
+    );
+    assert_eq!(out, "Hell.|00hi|1234.6");
+    let out = render(
+        r#"{% set a = text | slice(start=0, end=5) %}{% set b = items | join(sep=":") %}{{ a }}-{{ b }}"#,
+    );
+    assert_eq!(out, "Hello-1:2:3");
+}
+
+#[test]
+fn empty_argument_lists_still_work_for_zero_arity_and_optional_slots() {
+    assert_eq!(render(r#"{{ text | upper() }}"#), "HELLO BRAVE WORLD");
+    assert_eq!(render(r#"{{ items | join() }}"#), "123");
+    assert_eq!(render(r#"{{ n | round() }}"#), "1235");
+    assert_eq!(
+        render(r#"{{ text | truncate(width=8,) }}"#),
+        render(r#"{{ text | truncate(width=8) }}"#)
+    );
+}
+
+#[test]
+fn group_json_and_csv_accept_their_declared_keywords() {
+    assert_eq!(
+        render(r#"{{ half | group(sep="_", point=",") }}"#),
+        "1_234,5"
+    );
+    assert_eq!(
+        render(r#"{{ items | json(indent=2) }}"#),
+        "[\n  1,\n  2,\n  3\n]"
+    );
+    assert_eq!(
+        render(r#"{{ items | csv(delimiter=";") }}"#),
+        "1;2;3"
+    );
+    assert_eq!(
+        render(r#"{{ half | group(sep=" ") }}"#),
+        "1 234.5"
+    );
+}
+
+#[test]
+fn unknown_keyword_messages_include_the_filter_name_for_several_filters() {
+    for (template, filter) in [
+        (r#"{{ text | slice(begin=0) }}"#, "slice"),
+        (r#"{{ items | join(glue=",") }}"#, "join"),
+        (r#"{{ n | round(places=2) }}"#, "round"),
+        (r#"{{ config | get(name="a") }}"#, "get"),
+    ] {
+        let err = fail(template);
+        assert_eq!(err.kind, ErrorKind::Arity);
+        assert!(
+            err.message.contains(filter),
+            "expected `{filter}` in {}",
+            err.message
+        );
+        assert!(
+            err.message.contains("unknown keyword"),
+            "{}",
+            err.message
+        );
+    }
+}
+
+#[test]
+fn keyword_names_are_matched_case_sensitively() {
+    let err = fail(r#"{{ text | truncate(Width=8) }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("truncate"), "{}", err.message);
+    assert!(err.message.contains("unknown keyword"), "{}", err.message);
+    assert!(err.message.contains("Width"), "{}", err.message);
+
+    let err = fail(r#"{{ text | truncate(END="...") }}"#);
+    assert!(err.message.contains("END"), "{}", err.message);
+}
+
+#[test]
+fn truncate_words_also_accepts_width_and_end_keywords() {
+    assert_eq!(
+        render(r#"{{ text | truncate_words(width=12, end="...") }}"#),
+        "Hello Brave..."
+    );
+    assert_eq!(
+        render("{{ text | truncate_words(11, end=\"…\") }}"),
+        "Hello…"
+    );
+}
+
+#[test]
+fn ltrim_and_rtrim_keywords_compose_with_other_text_filters() {
+    assert_eq!(
+        render(r#"{{ messy | ltrim(chars="-") | rtrim(chars="-") | upper }}"#),
+        "AB"
+    );
+    assert_eq!(
+        render(r#"{{ "  spaced  " | trim(chars=" ") | truncate(width=4, end="!") }}"#),
+        "spa!"
+    );
+}
+
+#[test]
+fn get_default_keyword_can_be_an_expression() {
+    assert_eq!(
+        render(r#"{{ config | get(key="missing", default=items | first) }}"#),
+        "1"
+    );
+    assert_eq!(
+        render(r#"{{ config | get(key="a", default=999) }}"#),
+        "1"
+    );
+}
+
+#[test]
+fn duplicate_keywords_are_rejected_across_filter_families() {
+    let err = fail(r#"{{ padded | pad_start(width=3, fill=".", fill="*") }}"#);
+    assert!(err.message.contains("pad_start"), "{}", err.message);
+    assert!(err.message.contains("duplicate keyword"), "{}", err.message);
+    assert!(err.message.contains("fill"), "{}", err.message);
+
+    let err = fail(r#"{{ blank | default(fallback="a", fallback="b") }}"#);
+    assert!(err.message.contains("default"), "{}", err.message);
+    assert!(err.message.contains("duplicate keyword"), "{}", err.message);
+}
+
+#[test]
+fn required_positional_slots_remain_required_beside_optional_keywords() {
+    let err = fail(r#"{{ swap | replace(replacement="x", count=1) }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("replace"), "{}", err.message);
+
+    let err = fail(r#"{{ config | get(default="x") }}"#);
+    assert_eq!(err.kind, ErrorKind::Arity);
+    assert!(err.message.contains("get"), "{}", err.message);
+}
+
+#[test]
+fn keyword_only_calls_can_skip_optional_trailing_slots() {
+    assert_eq!(
+        render(r#"{{ text | truncate(width=20) }}"#),
+        "Hello Brave World"
+    );
+    assert_eq!(
+        render(r#"{{ padded | pad_start(width=2) }}"#),
+        "hi"
+    );
+    assert_eq!(
+        render(r#"{{ items | join(sep=",") }}"#),
+        "1,2,3"
+    );
+}
+
+#[test]
+fn render_errors_for_keyword_issues_carry_the_template_name() {
+    let err = fail(r#"{{ text | truncate(bogus=1) }}"#);
+    assert_eq!(err.template.as_deref(), Some("page.html"));
+    assert!(err.message.contains("truncate"));
+}
