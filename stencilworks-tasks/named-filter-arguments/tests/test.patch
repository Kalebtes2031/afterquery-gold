+//! Parse, print, outline, and CLI coverage for keyword filter arguments.
+
+use stencilworks::cli::args::CheckArgs;
+use stencilworks::cli::commands::inspect::{check, list_filters, show_outline};
+use stencilworks::syntax::{outline, parse_expression, parse_template, print_expression, FilterArg};
+use stencilworks::{Environment, ErrorKind, Source, ValueMap};
+use std::path::PathBuf;
+
+fn expr(text: &str) -> stencilworks::syntax::Expr {
+    let source = Source::anonymous(text);
+    parse_expression(&source, text, 0).unwrap()
+}
+
+fn expr_err(text: &str) -> stencilworks::Error {
+    let source = Source::anonymous(text);
+    parse_expression(&source, text, 0).unwrap_err()
+}
+
+fn shape(text: &str) -> String {
+    print_expression(&expr(text))
+}
+
+fn template(text: &str) -> stencilworks::Template {
+    parse_template(&Source::new("t", text)).unwrap()
+}
+
+fn template_err(text: &str) -> stencilworks::Error {
+    parse_template(&Source::new("t", text)).unwrap_err()
+}
+
+struct Tree {
+    root: PathBuf,
+}
+
+impl Tree {
+    fn new(files: &[(&str, &str)]) -> Tree {
+        let stamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or(0);
+        let mut root = std::env::temp_dir();
+        root.push(format!(
+            "stencilworks-kw-cli-{stamp}-{:?}",
+            std::thread::current().id()
+        ));
+        std::fs::create_dir_all(&root).expect("create tree");
+        for (name, text) in files {
+            let path = root.join(name);
+            if let Some(parent) = path.parent() {
+                std::fs::create_dir_all(parent).expect("create parent");
+            }
+            std::fs::write(path, text).expect("write file");
+        }
+        Tree { root }
+    }
+
+    fn args(&self, templates: &[&str]) -> CheckArgs {
+        CheckArgs {
+            templates: templates.iter().map(|t| t.to_string()).collect(),
+            root: Some(self.root.to_string_lossy().to_string()),
+        }
+    }
+}
+
+impl Drop for Tree {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
