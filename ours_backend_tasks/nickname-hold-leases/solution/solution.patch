--- /dev/null
+++ b/packages/backend/src/services/nickname_hold_utils.ts
@@ -0,0 +1,93 @@
+import { isValidNickname } from "#ours/shared/inputValidation.ts";
+import {
+  CONFIRMED_LEASE_SECONDS,
+  DEFAULT_HOLD_SECONDS,
+  MAX_HOLD_SECONDS,
+  MIN_HOLD_SECONDS,
+  type NicknameHoldFailure,
+  type NicknameHoldFailureReason,
+  type NicknameHoldRecord,
+  type NicknameHoldView,
+} from "#ours/backend/services/nickname_hold_types.ts";
+
+export function readClock(now?: number): number {
+  if (typeof now === "number" && Number.isFinite(now)) {
+    return Math.trunc(now);
+  }
+  return Date.now();
+}
+
+export function remainingSeconds(expiresAt: number, now: number): number {
+  return Math.max(0, Math.floor((expiresAt - now) / 1000));
+}
+
+export function isHoldExpired(record: NicknameHoldRecord, now: number): boolean {
+  return record.expiresAt <= now;
+}
+
+export function clampHoldSeconds(ttlSeconds?: number): number {
+  const raw = typeof ttlSeconds === "number" && Number.isFinite(ttlSeconds) ? ttlSeconds : DEFAULT_HOLD_SECONDS;
+  const truncated = Math.trunc(raw);
+  return Math.min(MAX_HOLD_SECONDS, Math.max(MIN_HOLD_SECONDS, truncated));
+}
+
+export function confirmedExpiry(now: number): number {
+  return now + CONFIRMED_LEASE_SECONDS * 1000;
+}
+
+export function holdExpiry(now: number, ttlSeconds?: number): number {
+  return now + clampHoldSeconds(ttlSeconds) * 1000;
+}
+
+export function normalizeHolderId(holderId: string): string | null {
+  if (typeof holderId !== "string") {
+    return null;
+  }
+  const trimmed = holderId.trim();
+  return trimmed.length > 0 ? trimmed : null;
+}
+
+export function normalizeHeldNickname(nickname: string): string | null {
+  if (typeof nickname !== "string") {
+    return null;
+  }
+  const trimmed = nickname.trim();
+  if (!isValidNickname(trimmed)) {
+    return null;
+  }
+  return trimmed.normalize("NFC").toLowerCase();
+}
+
+export function toHoldView(record: NicknameHoldRecord, now: number): NicknameHoldView {
+  return {
+    nickname: record.nickname,
+    holderId: record.holderId,
+    status: record.status,
+    expiresAt: record.expiresAt,
+    remainingSeconds: remainingSeconds(record.expiresAt, now),
+  };
+}
+
+export function holdFailure(
+  reason: NicknameHoldFailureReason,
+  extra: Omit<NicknameHoldFailure, "ok" | "reason"> = {},
+): NicknameHoldFailure {
+  return { ok: false, reason, ...extra };
+}
+
+export function sortHoldViews(views: NicknameHoldView[]): NicknameHoldView[] {
+  return [...views].sort((left, right) => {
+    const nameOrder = left.nickname.localeCompare(right.nickname);
+    if (nameOrder !== 0) {
+      return nameOrder;
+    }
+    return left.holderId.localeCompare(right.holderId);
+  });
+}
+
+export function liveHold(record: NicknameHoldRecord | null, now: number): NicknameHoldRecord | null {
+  if (!record || isHoldExpired(record, now)) {
+    return null;
+  }
+  return record;
+}
diff --git a/packages/backend/src/services/nickname_hold_store.ts b/packages/backend/src/services/nickname_hold_store.ts
new file mode 100644
index 0000000..1111111
