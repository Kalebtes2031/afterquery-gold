@@ -0,0 +1,70 @@
+import {
+  isNicknameHoldRecord,
+  type NicknameHoldRecord,
+  type NicknameHoldStore,
+} from "#ours/backend/services/nickname_hold_types.ts";
+
+const cloneHold = (record: NicknameHoldRecord): NicknameHoldRecord => ({
+  nickname: record.nickname,
+  holderId: record.holderId,
+  status: record.status,
+  expiresAt: record.expiresAt,
+});
+
+export class MemoryNicknameHoldStore implements NicknameHoldStore {
+  private readonly records = new Map<string, NicknameHoldRecord>();
+
+  async getHold(nickname: string): Promise<NicknameHoldRecord | null> {
+    const record = this.records.get(nickname);
+    return record ? cloneHold(record) : null;
+  }
+
+  async putHold(record: NicknameHoldRecord): Promise<void> {
+    if (!isNicknameHoldRecord(record)) {
+      return;
+    }
+    this.records.set(record.nickname, cloneHold(record));
+  }
+
+  async deleteHold(nickname: string): Promise<void> {
+    this.records.delete(nickname);
+  }
+
+  async listHolds(): Promise<NicknameHoldRecord[]> {
+    return [...this.records.values()].map(cloneHold);
+  }
+
+  async compareAndSetHold(
+    nickname: string,
+    expectedHolderId: string | null,
+    record: NicknameHoldRecord,
+  ): Promise<boolean> {
+    if (!isNicknameHoldRecord(record) || record.nickname !== nickname) {
+      return false;
+    }
+
+    const current = this.records.get(nickname);
+    if (expectedHolderId === null) {
+      if (current) {
+        return false;
+      }
+    } else if (!current || current.holderId !== expectedHolderId) {
+      return false;
+    }
+
+    this.records.set(nickname, cloneHold(record));
+    return true;
+  }
+
+  clear(): void {
+    this.records.clear();
+  }
+
+  size(): number {
+    return this.records.size;
+  }
+}
+
+export function createMemoryNicknameHoldStore(): MemoryNicknameHoldStore {
+  return new MemoryNicknameHoldStore();
+}
