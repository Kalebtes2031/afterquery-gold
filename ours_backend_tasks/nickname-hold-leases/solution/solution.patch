+export const DEFAULT_HOLD_SECONDS = 45;
+export const MIN_HOLD_SECONDS = 5;
+export const MAX_HOLD_SECONDS = 120;
+export const CONFIRMED_LEASE_SECONDS = 1800;
+
+export const NICKNAME_HOLD_STATUSES = ["held", "confirmed"] as const;
+export type NicknameHoldStatus = (typeof NICKNAME_HOLD_STATUSES)[number];
+
+export const NICKNAME_HOLD_FAILURE_REASONS = [
+  "invalid_nickname",
+  "invalid_holder",
+  "held",
+  "not_found",
+  "holder_mismatch",
+  "expired",
+] as const;
+export type NicknameHoldFailureReason = (typeof NICKNAME_HOLD_FAILURE_REASONS)[number];
+
+export interface NicknameHoldRecord {
+  nickname: string;
+  holderId: string;
+  status: NicknameHoldStatus;
+  expiresAt: number;
+}
+
+export interface NicknameHoldView extends NicknameHoldRecord {
+  remainingSeconds: number;
+}
+
+export interface NicknameHoldClockOptions {
+  now?: number;
+}
+
+export interface ClaimNicknameHoldOptions extends NicknameHoldClockOptions {
+  ttlSeconds?: number;
+}
+
+export interface NicknameHoldSuccess {
+  ok: true;
+  nickname: string;
+  holderId: string;
+  status: NicknameHoldStatus | "refreshed";
+  expiresAt: number;
+  remainingSeconds: number;
+}
+
+export interface NicknameHoldFailure {
+  ok: false;
+  reason: NicknameHoldFailureReason;
+  nickname?: string;
+  holderId?: string;
+  expiresAt?: number;
+  remainingSeconds?: number;
+}
+
+export type ClaimNicknameHoldResult = NicknameHoldSuccess | NicknameHoldFailure;
+export type ConfirmNicknameHoldResult = NicknameHoldSuccess | NicknameHoldFailure;
+
+export interface ReleaseNicknameHoldSuccess {
+  ok: true;
+  nickname: string;
+  released: true;
+}
+
+export type ReleaseNicknameHoldResult = ReleaseNicknameHoldSuccess | NicknameHoldFailure;
+
+export interface ListNicknameHoldsOptions extends NicknameHoldClockOptions {
+  holderId?: string;
+}
+
+export interface NicknameHoldStore {
+  getHold(nickname: string): Promise<NicknameHoldRecord | null>;
+  putHold(record: NicknameHoldRecord): Promise<void>;
+  deleteHold(nickname: string): Promise<void>;
+  listHolds(): Promise<NicknameHoldRecord[]>;
+  compareAndSetHold(
+    nickname: string,
+    expectedHolderId: string | null,
+    record: NicknameHoldRecord,
+  ): Promise<boolean>;
+}
+
+export function isNicknameHoldRecord(value: unknown): value is NicknameHoldRecord {
+  if (value === null || typeof value !== "object") {
+    return false;
+  }
+
+  const record = value as Partial<NicknameHoldRecord>;
+  return (
+    typeof record.nickname === "string" &&
+    record.nickname.length > 0 &&
+    typeof record.holderId === "string" &&
+    record.holderId.length > 0 &&
+    (record.status === "held" || record.status === "confirmed") &&
+    typeof record.expiresAt === "number" &&
+    Number.isFinite(record.expiresAt)
+  );
+}
diff --git a/packages/backend/src/services/nickname_hold_utils.ts b/packages/backend/src/services/nickname_hold_utils.ts
new file mode 100644
