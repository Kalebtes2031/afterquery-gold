+export {
+  NicknameHoldService,
+  claimNicknameHold,
+  confirmNicknameHold,
+  createNicknameHoldService,
+  getNicknameHold,
+  listNicknameHolds,
+  releaseNicknameHold,
+} from "#ours/backend/services/nickname_hold_service.ts";
+
+export {
+  MemoryNicknameHoldStore,
+  createMemoryNicknameHoldStore,
+} from "#ours/backend/services/nickname_hold_store.ts";
+
+export {
+  CONFIRMED_LEASE_SECONDS,
+  DEFAULT_HOLD_SECONDS,
+  MAX_HOLD_SECONDS,
+  MIN_HOLD_SECONDS,
+  NICKNAME_HOLD_FAILURE_REASONS,
+  NICKNAME_HOLD_STATUSES,
+  isNicknameHoldRecord,
+  type ClaimNicknameHoldOptions,
+  type ClaimNicknameHoldResult,
+  type ConfirmNicknameHoldResult,
+  type ListNicknameHoldsOptions,
+  type NicknameHoldClockOptions,
+  type NicknameHoldFailure,
+  type NicknameHoldFailureReason,
+  type NicknameHoldRecord,
+  type NicknameHoldStatus,
+  type NicknameHoldStore,
+  type NicknameHoldSuccess,
+  type NicknameHoldView,
+  type ReleaseNicknameHoldResult,
+} from "#ours/backend/services/nickname_hold_types.ts";
+
+export {
+  clampHoldSeconds,
+  confirmedExpiry,
+  holdExpiry,
+  holdFailure,
+  isHoldExpired,
+  liveHold,
+  normalizeHeldNickname,
+  normalizeHolderId,
+  readClock,
+  remainingSeconds,
+  sortHoldViews,
+  toHoldView,
+} from "#ours/backend/services/nickname_hold_utils.ts";
+
+export {
+  DEFAULT_HOLD_DURATION_POLICY,
+  canStealHold,
+  describeHoldPolicy,
+  expiryFromDuration,
+  resolveHoldDuration,
+  sameHolder,
+  type HoldDurationPolicy,
+} from "#ours/backend/services/nickname_hold_policy.ts";
