@@ -0,0 +1,42 @@
+import {
+  CONFIRMED_LEASE_SECONDS,
+  DEFAULT_HOLD_SECONDS,
+  MAX_HOLD_SECONDS,
+  MIN_HOLD_SECONDS,
+  type NicknameHoldRecord,
+} from "#ours/backend/services/nickname_hold_types.ts";
+
+export interface HoldDurationPolicy {
+  defaultSeconds: number;
+  minSeconds: number;
+  maxSeconds: number;
+  confirmedSeconds: number;
+}
+
+export const DEFAULT_HOLD_DURATION_POLICY: HoldDurationPolicy = {
+  defaultSeconds: DEFAULT_HOLD_SECONDS,
+  minSeconds: MIN_HOLD_SECONDS,
+  maxSeconds: MAX_HOLD_SECONDS,
+  confirmedSeconds: CONFIRMED_LEASE_SECONDS,
+};
+
+export function resolveHoldDuration(ttlSeconds: number | undefined, policy: HoldDurationPolicy = DEFAULT_HOLD_DURATION_POLICY): number {
+  const raw = typeof ttlSeconds === "number" && Number.isFinite(ttlSeconds) ? ttlSeconds : policy.defaultSeconds;
+  return Math.min(policy.maxSeconds, Math.max(policy.minSeconds, Math.trunc(raw)));
+}
+
+export function expiryFromDuration(now: number, seconds: number): number {
+  return now + seconds * 1000;
+}
+
+export function sameHolder(record: NicknameHoldRecord, holderId: string): boolean {
+  return record.holderId === holderId;
+}
+
+export function canStealHold(record: NicknameHoldRecord | null, now: number): boolean {
+  return record === null || record.expiresAt <= now;
+}
+
+export function describeHoldPolicy(policy: HoldDurationPolicy = DEFAULT_HOLD_DURATION_POLICY): string {
+  return `hold ${policy.minSeconds}-${policy.maxSeconds}s (default ${policy.defaultSeconds}s); confirmed ${policy.confirmedSeconds}s`;
+}
diff --git a/packages/backend/src/services/nickname_hold_service.ts b/packages/backend/src/services/nickname_hold_service.ts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/packages/backend/src/services/nickname_hold_service.ts
@@ -0,0 +1,295 @@
+import {
+  createMemoryNicknameHoldStore,
+} from "#ours/backend/services/nickname_hold_store.ts";
+import type {
+  ClaimNicknameHoldOptions,
+  ClaimNicknameHoldResult,
+  ConfirmNicknameHoldResult,
+  ListNicknameHoldsOptions,
+  NicknameHoldClockOptions,
+  NicknameHoldRecord,
+  NicknameHoldStore,
+  NicknameHoldView,
+  ReleaseNicknameHoldResult,
+} from "#ours/backend/services/nickname_hold_types.ts";
+import {
+  clampHoldSeconds,
+  confirmedExpiry,
+  holdExpiry,
+  holdFailure,
+  liveHold,
+  normalizeHeldNickname,
+  normalizeHolderId,
+  readClock,
+  remainingSeconds,
+  sortHoldViews,
+  toHoldView,
+} from "#ours/backend/services/nickname_hold_utils.ts";
+
+export class NicknameHoldService {
+  private readonly store: NicknameHoldStore;
+
+  constructor(store: NicknameHoldStore = createMemoryNicknameHoldStore()) {
+    this.store = store;
+  }
+
+  async claimNicknameHold(
+    nickname: string,
+    holderId: string,
+    options: ClaimNicknameHoldOptions = {},
+  ): Promise<ClaimNicknameHoldResult> {
+    const canonical = normalizeHeldNickname(nickname);
+    if (!canonical) {
+      return holdFailure("invalid_nickname");
+    }
+
+    const holder = normalizeHolderId(holderId);
+    if (!holder) {
+      return holdFailure("invalid_holder", { nickname: canonical });
+    }
+
+    const now = readClock(options.now);
+    const expiresAt = holdExpiry(now, options.ttlSeconds);
+    const current = await this.store.getHold(canonical);
+    const live = liveHold(current, now);
+
+    if (live && live.holderId !== holder) {
+      return holdFailure("held", {
+        nickname: canonical,
+        holderId: live.holderId,
+        expiresAt: live.expiresAt,
+        remainingSeconds: remainingSeconds(live.expiresAt, now),
+      });
+    }
+
+    const next: NicknameHoldRecord = {
+      nickname: canonical,
+      holderId: holder,
+      status: "held",
+      expiresAt,
+    };
+
+    if (live && live.holderId === holder) {
+      const swapped = await this.store.compareAndSetHold(canonical, holder, next);
+      if (!swapped) {
+        return this.claimNicknameHold(nickname, holderId, options);
+      }
+      return {
+        ok: true,
+        nickname: canonical,
+        holderId: holder,
+        status: "refreshed",
+        expiresAt,
+        remainingSeconds: remainingSeconds(expiresAt, now),
+      };
+    }
+
+    if (current && !live) {
+      await this.store.deleteHold(canonical);
+    }
+
+    const created = await this.store.compareAndSetHold(canonical, null, next);
+    if (!created) {
+      const winner = liveHold(await this.store.getHold(canonical), now);
+      if (winner && winner.holderId === holder) {
+        return {
+          ok: true,
+          nickname: canonical,
+          holderId: holder,
+          status: "held",
+          expiresAt: winner.expiresAt,
+          remainingSeconds: remainingSeconds(winner.expiresAt, now),
+        };
+      }
+      if (winner) {
+        return holdFailure("held", {
+          nickname: canonical,
+          holderId: winner.holderId,
+          expiresAt: winner.expiresAt,
+          remainingSeconds: remainingSeconds(winner.expiresAt, now),
+        });
+      }
+      return this.claimNicknameHold(nickname, holderId, options);
+    }
+
+    return {
+      ok: true,
+      nickname: canonical,
+      holderId: holder,
+      status: "held",
+      expiresAt,
+      remainingSeconds: remainingSeconds(expiresAt, now),
+    };
+  }
+
+  async confirmNicknameHold(
+    nickname: string,
+    holderId: string,
+    options: NicknameHoldClockOptions = {},
+  ): Promise<ConfirmNicknameHoldResult> {
+    const canonical = normalizeHeldNickname(nickname);
+    if (!canonical) {
+      return holdFailure("invalid_nickname");
+    }
+
+    const holder = normalizeHolderId(holderId);
+    if (!holder) {
+      return holdFailure("invalid_holder", { nickname: canonical });
+    }
+
+    const now = readClock(options.now);
+    const current = await this.store.getHold(canonical);
+    if (!current) {
+      return holdFailure("not_found", { nickname: canonical });
+    }
+    if (current.expiresAt <= now) {
+      await this.store.deleteHold(canonical);
+      return holdFailure("expired", { nickname: canonical, holderId: current.holderId });
+    }
+    if (current.holderId !== holder) {
+      return holdFailure("holder_mismatch", {
+        nickname: canonical,
+        holderId: current.holderId,
+        expiresAt: current.expiresAt,
+        remainingSeconds: remainingSeconds(current.expiresAt, now),
+      });
+    }
+
+    const expiresAt = confirmedExpiry(now);
+    const next: NicknameHoldRecord = {
+      nickname: canonical,
+      holderId: holder,
+      status: "confirmed",
+      expiresAt,
+    };
+    const swapped = await this.store.compareAndSetHold(canonical, holder, next);
+    if (!swapped) {
+      return this.confirmNicknameHold(nickname, holderId, options);
+    }
+
+    return {
+      ok: true,
+      nickname: canonical,
+      holderId: holder,
+      status: "confirmed",
+      expiresAt,
+      remainingSeconds: remainingSeconds(expiresAt, now),
+    };
+  }
+
+  async releaseNicknameHold(
+    nickname: string,
+    holderId: string,
+    options: NicknameHoldClockOptions = {},
+  ): Promise<ReleaseNicknameHoldResult> {
+    const canonical = normalizeHeldNickname(nickname);
+    if (!canonical) {
+      return holdFailure("invalid_nickname");
+    }
+
+    const holder = normalizeHolderId(holderId);
+    if (!holder) {
+      return holdFailure("invalid_holder", { nickname: canonical });
+    }
+
+    const current = await this.store.getHold(canonical);
+    if (!current) {
+      return holdFailure("not_found", { nickname: canonical });
+    }
+
+    const now = readClock(options.now);
+    if (current.expiresAt <= now) {
+      await this.store.deleteHold(canonical);
+      return holdFailure("not_found", { nickname: canonical });
+    }
+    if (current.holderId !== holder) {
+      return holdFailure("holder_mismatch", {
+        nickname: canonical,
+        holderId: current.holderId,
+        expiresAt: current.expiresAt,
+        remainingSeconds: remainingSeconds(current.expiresAt, now),
+      });
+    }
+
+    await this.store.deleteHold(canonical);
+    return { ok: true, nickname: canonical, released: true };
+  }
+
+  async getNicknameHold(nickname: string, options: NicknameHoldClockOptions = {}): Promise<NicknameHoldView | null> {
+    const canonical = normalizeHeldNickname(nickname);
+    if (!canonical) {
+      return null;
+    }
+
+    const now = readClock(options.now);
+    const live = liveHold(await this.store.getHold(canonical), now);
+    return live ? toHoldView(live, now) : null;
+  }
+
+  async listNicknameHolds(options: ListNicknameHoldsOptions = {}): Promise<NicknameHoldView[]> {
+    const now = readClock(options.now);
+    const holder = options.holderId === undefined ? undefined : normalizeHolderId(options.holderId);
+    const views: NicknameHoldView[] = [];
+
+    for (const record of await this.store.listHolds()) {
+      const live = liveHold(record, now);
+      if (!live) {
+        continue;
+      }
+      if (holder !== undefined && live.holderId !== holder) {
+        continue;
+      }
+      views.push(toHoldView(live, now));
+    }
+
+    return sortHoldViews(views);
+  }
+}
+
+export function createNicknameHoldService(store?: NicknameHoldStore): NicknameHoldService {
+  return new NicknameHoldService(store ?? createMemoryNicknameHoldStore());
+}
+
+export async function claimNicknameHold(
+  nickname: string,
+  holderId: string,
+  options: ClaimNicknameHoldOptions = {},
+  store?: NicknameHoldStore,
+): Promise<ClaimNicknameHoldResult> {
+  return createNicknameHoldService(store).claimNicknameHold(nickname, holderId, options);
+}
+
+export async function confirmNicknameHold(
+  nickname: string,
+  holderId: string,
+  options: NicknameHoldClockOptions = {},
+  store?: NicknameHoldStore,
+): Promise<ConfirmNicknameHoldResult> {
+  return createNicknameHoldService(store).confirmNicknameHold(nickname, holderId, options);
+}
+
+export async function releaseNicknameHold(
+  nickname: string,
+  holderId: string,
+  options: NicknameHoldClockOptions = {},
+  store?: NicknameHoldStore,
+): Promise<ReleaseNicknameHoldResult> {
+  return createNicknameHoldService(store).releaseNicknameHold(nickname, holderId, options);
+}
+
+export async function getNicknameHold(
+  nickname: string,
+  options: NicknameHoldClockOptions = {},
+  store?: NicknameHoldStore,
+): Promise<NicknameHoldView | null> {
+  return createNicknameHoldService(store).getNicknameHold(nickname, options);
+}
+
+export async function listNicknameHolds(
+  options: ListNicknameHoldsOptions = {},
+  store?: NicknameHoldStore,
+): Promise<NicknameHoldView[]> {
+  return createNicknameHoldService(store).listNicknameHolds(options);
+}
+
+export { clampHoldSeconds };
