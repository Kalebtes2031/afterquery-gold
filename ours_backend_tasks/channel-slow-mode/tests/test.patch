diff --git a/packages/backend/src/gold_tests/slow_mode_config.test.ts b/packages/backend/src/gold_tests/slow_mode_config.test.ts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/packages/backend/src/gold_tests/slow_mode_config.test.ts
@@ -0,0 +1,114 @@
+import { describe, expect, it } from "vitest";
+import {
+  DEFAULT_SLOW_MODE_SECONDS,
+  MAX_SLOW_MODE_SECONDS,
+  MIN_SLOW_MODE_SECONDS,
+  ChannelSlowModeService,
+  MemoryChannelSlowModeStore,
+  clearChannelSlowMode,
+  getChannelSlowMode,
+  setChannelSlowMode,
+} from "#ours/backend/services/slow_mode.ts";
+
+const service = () => new ChannelSlowModeService(new MemoryChannelSlowModeStore());
+
+describe("Channel slow mode config", () => {
+  it("enables slow mode with the default interval", async () => {
+    const result = await service().setChannelSlowMode("room-1");
+    expect(result).toEqual({
+      ok: true,
+      channelId: "room-1",
+      intervalSeconds: DEFAULT_SLOW_MODE_SECONDS,
+      enabled: true,
+    });
+  });
+
+  it("trims the channel id and keeps its case including colons", async () => {
+    const slow = service();
+    const result = await slow.setChannelSlowMode("  Team:West  ", { intervalSeconds: 12 });
+    expect(result).toMatchObject({ ok: true, channelId: "Team:West", intervalSeconds: 12 });
+    await expect(slow.getChannelSlowMode("Team:West")).resolves.toEqual({
+      channelId: "Team:West",
+      intervalSeconds: 12,
+      enabled: true,
+    });
+  });
+
+  it("rejects an empty channel id", async () => {
+    await expect(service().setChannelSlowMode("   ")).resolves.toEqual({
+      ok: false,
+      reason: "invalid_channel",
+    });
+  });
+
+  it("rejects a non-finite interval", async () => {
+    await expect(service().setChannelSlowMode("room-1", { intervalSeconds: Number.NaN })).resolves.toEqual({
+      ok: false,
+      reason: "invalid_interval",
+      channelId: "room-1",
+    });
+  });
+
+  it("clamps an interval below the minimum to one second", async () => {
+    const result = await service().setChannelSlowMode("room-1", { intervalSeconds: 0 });
+    expect(result).toMatchObject({ ok: true, intervalSeconds: MIN_SLOW_MODE_SECONDS });
+  });
+
+  it("clamps an interval above the maximum to six hundred seconds", async () => {
+    const result = await service().setChannelSlowMode("room-1", { intervalSeconds: 9999 });
+    expect(result).toMatchObject({ ok: true, intervalSeconds: MAX_SLOW_MODE_SECONDS });
+  });
+
+  it("truncates a fractional interval before clamping", async () => {
+    const result = await service().setChannelSlowMode("room-1", { intervalSeconds: 15.9 });
+    expect(result).toMatchObject({ ok: true, intervalSeconds: 15 });
+  });
+
+  it("overwrites a previous interval when set again", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 10 });
+    await expect(slow.setChannelSlowMode("room-1", { intervalSeconds: 40 })).resolves.toMatchObject({
+      intervalSeconds: 40,
+    });
+    await expect(slow.getChannelSlowMode("room-1")).resolves.toMatchObject({ intervalSeconds: 40 });
+  });
+
+  it("returns null from get when slow mode was never enabled", async () => {
+    await expect(service().getChannelSlowMode("room-1")).resolves.toBeNull();
+  });
+
+  it("returns null from get for an invalid channel id", async () => {
+    await expect(service().getChannelSlowMode("  ")).resolves.toBeNull();
+  });
+
+  it("clears an enabled channel and removes its cooldowns", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 20 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: 1_000 });
+    await expect(slow.clearChannelSlowMode("room-1")).resolves.toEqual({
+      ok: true,
+      channelId: "room-1",
+      cleared: true,
+    });
+    await expect(slow.getChannelSlowMode("room-1")).resolves.toBeNull();
+    await expect(slow.listActiveCooldowns("room-1", { now: 1_000 })).resolves.toEqual([]);
+  });
+
+  it("reports not_enabled when clearing a channel that has no slow mode", async () => {
+    await expect(service().clearChannelSlowMode("room-1")).resolves.toEqual({
+      ok: false,
+      reason: "not_enabled",
+      channelId: "room-1",
+    });
+  });
+
+  it("supports the config convenience helpers", async () => {
+    const store = new MemoryChannelSlowModeStore();
+    await expect(setChannelSlowMode("room-1", { intervalSeconds: 25 }, store)).resolves.toMatchObject({
+      ok: true,
+      intervalSeconds: 25,
+    });
+    await expect(getChannelSlowMode("room-1", store)).resolves.toMatchObject({ enabled: true });
+    await expect(clearChannelSlowMode("room-1", store)).resolves.toMatchObject({ cleared: true });
+  });
+});
diff --git a/packages/backend/src/gold_tests/slow_mode_speak.test.ts b/packages/backend/src/gold_tests/slow_mode_speak.test.ts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/packages/backend/src/gold_tests/slow_mode_speak.test.ts
@@ -0,0 +1,157 @@
+import { describe, expect, it } from "vitest";
+import {
+  ChannelSlowModeService,
+  MemoryChannelSlowModeStore,
+  canSpeak,
+  recordChannelSpeak,
+  trySpeak,
+} from "#ours/backend/services/slow_mode.ts";
+
+const NOW = 1_700_000_000_000;
+const service = () => new ChannelSlowModeService(new MemoryChannelSlowModeStore());
+
+describe("Channel slow mode speak gate", () => {
+  it("allows speaking when slow mode is off", async () => {
+    await expect(service().canSpeak("room-1", "alice", { now: NOW })).resolves.toEqual({
+      ok: true,
+      allowed: true,
+      channelId: "room-1",
+      nickname: "alice",
+      availableAt: NOW,
+      remainingSeconds: 0,
+    });
+  });
+
+  it("allows the first speak after slow mode is enabled", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await expect(slow.canSpeak("room-1", "alice", { now: NOW })).resolves.toMatchObject({
+      ok: true,
+      allowed: true,
+      remainingSeconds: 0,
+    });
+  });
+
+  it("records a speak and opens a cooldown window", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await expect(slow.recordChannelSpeak("room-1", "alice", { now: NOW })).resolves.toEqual({
+      ok: true,
+      channelId: "room-1",
+      nickname: "alice",
+      lastSpokeAt: NOW,
+      availableAt: NOW + 30_000,
+    });
+  });
+
+  it("denies speaking while the cooldown is still active", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.canSpeak("room-1", "alice", { now: NOW + 5_000 })).resolves.toEqual({
+      ok: true,
+      allowed: false,
+      channelId: "room-1",
+      nickname: "alice",
+      availableAt: NOW + 30_000,
+      remainingSeconds: 25,
+    });
+  });
+
+  it("allows speaking again once the cooldown expires", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 20 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.canSpeak("room-1", "alice", { now: NOW + 20_000 })).resolves.toMatchObject({
+      allowed: true,
+      remainingSeconds: 0,
+    });
+  });
+
+  it("refuses to record another speak while the cooldown is active", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.recordChannelSpeak("room-1", "alice", { now: NOW + 1_000 })).resolves.toEqual({
+      ok: false,
+      reason: "cooldown_active",
+      channelId: "room-1",
+      nickname: "alice",
+    });
+  });
+
+  it("stores nicknames lowercase after trimming", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 15 });
+    const result = await slow.recordChannelSpeak("room-1", "  AlIce  ", { now: NOW });
+    expect(result).toMatchObject({ ok: true, nickname: "alice" });
+  });
+
+  it("rejects an invalid nickname on speak checks", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 15 });
+    await expect(slow.canSpeak("room-1", "ab", { now: NOW })).resolves.toEqual({
+      ok: false,
+      reason: "invalid_nickname",
+      channelId: "room-1",
+    });
+  });
+
+  it("rejects recording a speak when slow mode is not enabled", async () => {
+    await expect(service().recordChannelSpeak("room-1", "alice", { now: NOW })).resolves.toEqual({
+      ok: false,
+      reason: "not_enabled",
+      channelId: "room-1",
+      nickname: "alice",
+    });
+  });
+
+  it("trySpeak records on success and returns allowed true", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 25 });
+    await expect(slow.trySpeak("room-1", "alice", { now: NOW })).resolves.toEqual({
+      ok: true,
+      allowed: true,
+      channelId: "room-1",
+      nickname: "alice",
+      availableAt: NOW + 25_000,
+      remainingSeconds: 0,
+    });
+    await expect(slow.canSpeak("room-1", "alice", { now: NOW + 1_000 })).resolves.toMatchObject({
+      allowed: false,
+      remainingSeconds: 24,
+    });
+  });
+
+  it("trySpeak returns the denial without recording when blocked", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.trySpeak("room-1", "alice", { now: NOW + 2_000 })).resolves.toMatchObject({
+      ok: true,
+      allowed: false,
+      remainingSeconds: 28,
+    });
+  });
+
+  it("keeps remainingSeconds floored and never negative", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 10 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.canSpeak("room-1", "alice", { now: NOW + 9_400 })).resolves.toMatchObject({
+      allowed: false,
+      remainingSeconds: 0,
+    });
+  });
+
+  it("supports the speak convenience helpers", async () => {
+    const store = new MemoryChannelSlowModeStore();
+    const slow = new ChannelSlowModeService(store);
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 20 });
+    await expect(canSpeak("room-1", "alice", { now: NOW }, store)).resolves.toMatchObject({ allowed: true });
+    await expect(recordChannelSpeak("room-1", "alice", { now: NOW }, store)).resolves.toMatchObject({ ok: true });
+    await expect(trySpeak("room-1", "alice", { now: NOW + 1_000 }, store)).resolves.toMatchObject({
+      allowed: false,
+    });
+  });
+});
diff --git a/packages/backend/src/gold_tests/slow_mode_cooldowns.test.ts b/packages/backend/src/gold_tests/slow_mode_cooldowns.test.ts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/packages/backend/src/gold_tests/slow_mode_cooldowns.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from "vitest";
+import {
+  ChannelSlowModeService,
+  MemoryChannelSlowModeStore,
+  getCooldown,
+  listActiveCooldowns,
+  sweepExpiredCooldowns,
+} from "#ours/backend/services/slow_mode.ts";
+
+const NOW = 1_700_000_000_000;
+const service = () => new ChannelSlowModeService(new MemoryChannelSlowModeStore());
+
+describe("Channel slow mode cooldowns", () => {
+  it("lists active cooldowns sorted by nickname", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 40 });
+    await slow.recordChannelSpeak("room-1", "zoe", { now: NOW });
+    await slow.recordChannelSpeak("room-1", "amy", { now: NOW });
+    await slow.recordChannelSpeak("room-1", "bob", { now: NOW });
+    const listed = await slow.listActiveCooldowns("room-1", { now: NOW + 1_000 });
+    expect(listed.map((row) => row.nickname)).toEqual(["amy", "bob", "zoe"]);
+  });
+
+  it("skips expired cooldowns from the active list", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 10 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 40 });
+    await slow.recordChannelSpeak("room-1", "bob", { now: NOW + 10_000 });
+    const listed = await slow.listActiveCooldowns("room-1", { now: NOW + 10_000 });
+    expect(listed.map((row) => row.nickname)).toEqual(["bob"]);
+  });
+
+  it("returns an empty list for an invalid channel", async () => {
+    await expect(service().listActiveCooldowns("  ", { now: NOW })).resolves.toEqual([]);
+  });
+
+  it("returns a live cooldown view from getCooldown", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.getCooldown("room-1", "ALICE", { now: NOW + 4_000 })).resolves.toEqual({
+      channelId: "room-1",
+      nickname: "alice",
+      lastSpokeAt: NOW,
+      availableAt: NOW + 30_000,
+      remainingSeconds: 26,
+    });
+  });
+
+  it("returns null from getCooldown when the window has expired", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 12 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.getCooldown("room-1", "alice", { now: NOW + 12_000 })).resolves.toBeNull();
+  });
+
+  it("sweeps expired cooldowns and reports sorted nicknames", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 10 });
+    await slow.recordChannelSpeak("room-1", "zoe", { now: NOW });
+    await slow.recordChannelSpeak("room-1", "amy", { now: NOW });
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 40 });
+    await slow.recordChannelSpeak("room-1", "bob", { now: NOW + 10_000 });
+    await expect(slow.sweepExpiredCooldowns("room-1", { now: NOW + 10_000 })).resolves.toEqual({
+      removed: 2,
+      nicknames: ["amy", "zoe"],
+    });
+    await expect(slow.listActiveCooldowns("room-1", { now: NOW + 10_000 })).resolves.toHaveLength(1);
+  });
+
+  it("returns a zero sweep for an invalid channel", async () => {
+    await expect(service().sweepExpiredCooldowns(" ", { now: NOW })).resolves.toEqual({
+      removed: 0,
+      nicknames: [],
+    });
+  });
+
+  it("lets users keep independent cooldown clocks", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.canSpeak("room-1", "bob", { now: NOW + 1_000 })).resolves.toMatchObject({
+      allowed: true,
+    });
+  });
+
+  it("does not carry cooldowns across different channels", async () => {
+    const slow = service();
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 30 });
+    await slow.setChannelSlowMode("room-2", { intervalSeconds: 30 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.canSpeak("room-2", "alice", { now: NOW + 1_000 })).resolves.toMatchObject({
+      allowed: true,
+    });
+  });
+
+  it("supports the cooldown convenience helpers", async () => {
+    const store = new MemoryChannelSlowModeStore();
+    const slow = new ChannelSlowModeService(store);
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 20 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(getCooldown("room-1", "alice", { now: NOW }, store)).resolves.toMatchObject({
+      nickname: "alice",
+    });
+    await expect(listActiveCooldowns("room-1", { now: NOW }, store)).resolves.toHaveLength(1);
+    await expect(sweepExpiredCooldowns("room-1", { now: NOW + 20_000 }, store)).resolves.toEqual({
+      removed: 1,
+      nicknames: ["alice"],
+    });
+  });
+});
diff --git a/packages/backend/src/gold_tests/slow_mode_edges.test.ts b/packages/backend/src/gold_tests/slow_mode_edges.test.ts
new file mode 100644
