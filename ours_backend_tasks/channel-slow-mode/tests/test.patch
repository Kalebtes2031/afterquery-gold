+++ b/packages/backend/src/gold_tests/slow_mode_edges.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import {
+  ChannelSlowModeService,
+  MemoryChannelSlowModeStore,
+  createChannelSlowModeService,
+} from "#ours/backend/services/slow_mode.ts";
+
+const NOW = 1_700_000_000_000;
+
+describe("Channel slow mode edges", () => {
+  it("accepts a one second interval at the minimum bound", async () => {
+    const slow = createChannelSlowModeService(new MemoryChannelSlowModeStore());
+    await expect(slow.setChannelSlowMode("room-1", { intervalSeconds: 1 })).resolves.toMatchObject({
+      intervalSeconds: 1,
+    });
+  });
+
+  it("accepts a six hundred second interval at the maximum bound", async () => {
+    const slow = createChannelSlowModeService(new MemoryChannelSlowModeStore());
+    await expect(slow.setChannelSlowMode("room-1", { intervalSeconds: 600 })).resolves.toMatchObject({
+      intervalSeconds: 600,
+    });
+  });
+
+  it("rejects a blank nickname when recording a speak", async () => {
+    const slow = createChannelSlowModeService(new MemoryChannelSlowModeStore());
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 20 });
+    await expect(slow.recordChannelSpeak("room-1", "  ", { now: NOW })).resolves.toEqual({
+      ok: false,
+      reason: "invalid_nickname",
+      channelId: "room-1",
+    });
+  });
+
+  it("rejects an empty channel when recording a speak", async () => {
+    const slow = createChannelSlowModeService(new MemoryChannelSlowModeStore());
+    await expect(slow.recordChannelSpeak("  ", "alice", { now: NOW })).resolves.toEqual({
+      ok: false,
+      reason: "invalid_channel",
+    });
+  });
+
+  it("allows a new speak window after an expired cooldown is recorded again", async () => {
+    const slow = createChannelSlowModeService(new MemoryChannelSlowModeStore());
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 15 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await expect(slow.recordChannelSpeak("room-1", "alice", { now: NOW + 15_000 })).resolves.toEqual({
+      ok: true,
+      channelId: "room-1",
+      nickname: "alice",
+      lastSpokeAt: NOW + 15_000,
+      availableAt: NOW + 30_000,
+    });
+  });
+
+  it("uses the latest interval when opening a new cooldown", async () => {
+    const slow = createChannelSlowModeService(new MemoryChannelSlowModeStore());
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 10 });
+    await slow.recordChannelSpeak("room-1", "alice", { now: NOW });
+    await slow.setChannelSlowMode("room-1", { intervalSeconds: 50 });
+    await expect(slow.recordChannelSpeak("room-1", "alice", { now: NOW + 10_000 })).resolves.toMatchObject({
+      availableAt: NOW + 10_000 + 50_000,
+    });
+  });
+
+  it("returns null from getCooldown for an invalid nickname", async () => {
+    const slow = createChannelSlowModeService(new MemoryChannelSlowModeStore());
+    await expect(slow.getCooldown("room-1", "ab", { now: NOW })).resolves.toBeNull();
+  });
+
+  it("can construct the service through createChannelSlowModeService", async () => {
+    const store = new MemoryChannelSlowModeStore();
+    const slow = createChannelSlowModeService(store);
+    expect(slow).toBeInstanceOf(ChannelSlowModeService);
+    await expect(slow.getChannelSlowMode("room-1")).resolves.toBeNull();
+  });
+});
diff --git a/packages/backend/src/gold_tests/p2p_constants_compat.test.ts b/packages/backend/src/gold_tests/p2p_constants_compat.test.ts
