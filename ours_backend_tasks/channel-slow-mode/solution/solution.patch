+import {
+  DEFAULT_SLOW_MODE_SECONDS,
+  MAX_SLOW_MODE_SECONDS,
+  MIN_SLOW_MODE_SECONDS,
+} from "#ours/backend/services/slow_mode_types.ts";
+
+export interface SlowModePolicy {
+  defaultSeconds: number;
+  minSeconds: number;
+  maxSeconds: number;
+}
+
+export const DEFAULT_SLOW_MODE_POLICY: SlowModePolicy = {
+  defaultSeconds: DEFAULT_SLOW_MODE_SECONDS,
+  minSeconds: MIN_SLOW_MODE_SECONDS,
+  maxSeconds: MAX_SLOW_MODE_SECONDS,
+};
+
+export function describeSlowModePolicy(policy: SlowModePolicy = DEFAULT_SLOW_MODE_POLICY): string {
+  return `slow-mode ${policy.minSeconds}-${policy.maxSeconds}s (default ${policy.defaultSeconds}s)`;
+}
+
+export function isWithinSlowModeBounds(seconds: number, policy: SlowModePolicy = DEFAULT_SLOW_MODE_POLICY): boolean {
+  return Number.isFinite(seconds) && seconds >= policy.minSeconds && seconds <= policy.maxSeconds;
+}
diff --git a/packages/backend/src/services/slow_mode_service.ts b/packages/backend/src/services/slow_mode_service.ts
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/packages/backend/src/services/slow_mode_service.ts
@@ -0,0 +1,297 @@
+import { createMemoryChannelSlowModeStore } from "#ours/backend/services/slow_mode_store.ts";
+import type {
+  ChannelSlowModeConfig,
+  ChannelSlowModeStore,
+  ChannelSpeakCooldown,
+  ClearSlowModeResult,
+  CooldownSweepResult,
+  RecordSpeakResult,
+  SetSlowModeOptions,
+  SetSlowModeResult,
+  SlowModeClockOptions,
+  SpeakAttemptResult,
+  SpeakCooldownView,
+} from "#ours/backend/services/slow_mode_types.ts";
+import {
+  availableAtFromSpeak,
+  clampSlowModeSeconds,
+  isCooldownActive,
+  normalizeSlowChannelId,
+  normalizeSlowNickname,
+  readSlowModeClock,
+  remainingCooldownSeconds,
+  slowModeFailure,
+  sortCooldownViews,
+  toCooldownView,
+  uniqueSortedNicknames,
+} from "#ours/backend/services/slow_mode_utils.ts";
+
+export class ChannelSlowModeService {
+  private readonly store: ChannelSlowModeStore;
+
+  constructor(store: ChannelSlowModeStore = createMemoryChannelSlowModeStore()) {
+    this.store = store;
+  }
+
+  async setChannelSlowMode(channelId: string, options: SetSlowModeOptions = {}): Promise<SetSlowModeResult> {
+    const channel = normalizeSlowChannelId(channelId);
+    if (!channel) return slowModeFailure("invalid_channel");
+
+    const intervalSeconds = clampSlowModeSeconds(options.intervalSeconds);
+    if (intervalSeconds === null) return slowModeFailure("invalid_interval", { channelId: channel });
+
+    const config: ChannelSlowModeConfig = {
+      channelId: channel,
+      intervalSeconds,
+      enabled: true,
+    };
+    await this.store.putConfig(config);
+    return { ok: true, channelId: channel, intervalSeconds, enabled: true };
+  }
+
+  async getChannelSlowMode(channelId: string): Promise<ChannelSlowModeConfig | null> {
+    const channel = normalizeSlowChannelId(channelId);
+    if (!channel) return null;
+    const config = await this.store.getConfig(channel);
+    if (!config || !config.enabled) return null;
+    return config;
+  }
+
+  async clearChannelSlowMode(channelId: string): Promise<ClearSlowModeResult> {
+    const channel = normalizeSlowChannelId(channelId);
+    if (!channel) return slowModeFailure("invalid_channel");
+
+    const current = await this.store.getConfig(channel);
+    if (!current || !current.enabled) return slowModeFailure("not_enabled", { channelId: channel });
+
+    await this.store.deleteConfig(channel);
+    for (const cooldown of await this.store.listCooldowns(channel)) {
+      await this.store.deleteCooldown(channel, cooldown.nickname);
+    }
+    return { ok: true, channelId: channel, cleared: true };
+  }
+
+  async canSpeak(
+    channelId: string,
+    nickname: string,
+    options: SlowModeClockOptions = {},
+  ): Promise<SpeakAttemptResult | ReturnType<typeof slowModeFailure>> {
+    const channel = normalizeSlowChannelId(channelId);
+    if (!channel) return slowModeFailure("invalid_channel");
+    const user = normalizeSlowNickname(nickname);
+    if (!user) return slowModeFailure("invalid_nickname", { channelId: channel });
+
+    const now = readSlowModeClock(options.now);
+    const config = await this.store.getConfig(channel);
+    if (!config || !config.enabled) {
+      return {
+        ok: true,
+        allowed: true,
+        channelId: channel,
+        nickname: user,
+        availableAt: now,
+        remainingSeconds: 0,
+      };
+    }
+
+    const cooldown = await this.store.getCooldown(channel, user);
+    if (!cooldown || !isCooldownActive(cooldown, now)) {
+      return {
+        ok: true,
+        allowed: true,
+        channelId: channel,
+        nickname: user,
+        availableAt: now,
+        remainingSeconds: 0,
+      };
+    }
+
+    return {
+      ok: true,
+      allowed: false,
+      channelId: channel,
+      nickname: user,
+      availableAt: cooldown.availableAt,
+      remainingSeconds: remainingCooldownSeconds(cooldown.availableAt, now),
+    };
+  }
+
+  async recordChannelSpeak(
+    channelId: string,
+    nickname: string,
+    options: SlowModeClockOptions = {},
+  ): Promise<RecordSpeakResult> {
+    const channel = normalizeSlowChannelId(channelId);
+    if (!channel) return slowModeFailure("invalid_channel");
+    const user = normalizeSlowNickname(nickname);
+    if (!user) return slowModeFailure("invalid_nickname", { channelId: channel });
+
+    const config = await this.store.getConfig(channel);
+    if (!config || !config.enabled) return slowModeFailure("not_enabled", { channelId: channel, nickname: user });
+
+    const now = readSlowModeClock(options.now);
+    const current = await this.store.getCooldown(channel, user);
+    if (current && isCooldownActive(current, now)) {
+      return slowModeFailure("cooldown_active", { channelId: channel, nickname: user });
+    }
+
+    const availableAt = availableAtFromSpeak(now, config.intervalSeconds);
+    const next: ChannelSpeakCooldown = {
+      channelId: channel,
+      nickname: user,
+      lastSpokeAt: now,
+      availableAt,
+    };
+
+    if (current) {
+      const swapped = await this.store.compareAndSetCooldown(channel, user, current.availableAt, next);
+      if (!swapped) return this.recordChannelSpeak(channelId, nickname, options);
+      return { ok: true, channelId: channel, nickname: user, lastSpokeAt: now, availableAt };
+    }
+
+    const created = await this.store.compareAndSetCooldown(channel, user, null, next);
+    if (!created) return this.recordChannelSpeak(channelId, nickname, options);
+    return { ok: true, channelId: channel, nickname: user, lastSpokeAt: now, availableAt };
+  }
+
+  async trySpeak(
+    channelId: string,
+    nickname: string,
+    options: SlowModeClockOptions = {},
+  ): Promise<SpeakAttemptResult | ReturnType<typeof slowModeFailure>> {
+    const check = await this.canSpeak(channelId, nickname, options);
+    if (!check.ok || !check.allowed) return check;
+    const recorded = await this.recordChannelSpeak(channelId, nickname, options);
+    if (!recorded.ok) {
+      // Race: someone else recorded first; re-check.
+      return this.canSpeak(channelId, nickname, options);
+    }
+    return {
+      ok: true,
+      allowed: true,
+      channelId: recorded.channelId,
+      nickname: recorded.nickname,
+      availableAt: recorded.availableAt,
+      remainingSeconds: 0,
+    };
+  }
+
+  async listActiveCooldowns(channelId: string, options: SlowModeClockOptions = {}): Promise<SpeakCooldownView[]> {
+    const channel = normalizeSlowChannelId(channelId);
+    if (!channel) return [];
+    const now = readSlowModeClock(options.now);
+    const views: SpeakCooldownView[] = [];
+    for (const cooldown of await this.store.listCooldowns(channel)) {
+      if (!isCooldownActive(cooldown, now)) continue;
+      views.push(toCooldownView(cooldown, now));
+    }
+    return sortCooldownViews(views);
+  }
+
+  async getCooldown(
+    channelId: string,
+    nickname: string,
+    options: SlowModeClockOptions = {},
+  ): Promise<SpeakCooldownView | null> {
+    const channel = normalizeSlowChannelId(channelId);
+    const user = normalizeSlowNickname(nickname);
+    if (!channel || !user) return null;
+    const now = readSlowModeClock(options.now);
+    const cooldown = await this.store.getCooldown(channel, user);
+    if (!cooldown || !isCooldownActive(cooldown, now)) return null;
+    return toCooldownView(cooldown, now);
+  }
+
+  async sweepExpiredCooldowns(channelId: string, options: SlowModeClockOptions = {}): Promise<CooldownSweepResult> {
+    const channel = normalizeSlowChannelId(channelId);
+    if (!channel) return { removed: 0, nicknames: [] };
+    const now = readSlowModeClock(options.now);
+    const nicknames: string[] = [];
+    let removed = 0;
+    for (const cooldown of await this.store.listCooldowns(channel)) {
+      if (isCooldownActive(cooldown, now)) continue;
+      await this.store.deleteCooldown(channel, cooldown.nickname);
+      removed += 1;
+      nicknames.push(cooldown.nickname);
+    }
+    return { removed, nicknames: uniqueSortedNicknames(nicknames) };
+  }
+}
+
+export function createChannelSlowModeService(store?: ChannelSlowModeStore): ChannelSlowModeService {
+  return new ChannelSlowModeService(store ?? createMemoryChannelSlowModeStore());
+}
+
+export async function setChannelSlowMode(
+  channelId: string,
+  options: SetSlowModeOptions = {},
+  store?: ChannelSlowModeStore,
+): Promise<SetSlowModeResult> {
+  return createChannelSlowModeService(store).setChannelSlowMode(channelId, options);
+}
+
+export async function getChannelSlowMode(
+  channelId: string,
+  store?: ChannelSlowModeStore,
+): Promise<ChannelSlowModeConfig | null> {
+  return createChannelSlowModeService(store).getChannelSlowMode(channelId);
+}
+
+export async function clearChannelSlowMode(
+  channelId: string,
+  store?: ChannelSlowModeStore,
+): Promise<ClearSlowModeResult> {
+  return createChannelSlowModeService(store).clearChannelSlowMode(channelId);
+}
+
+export async function canSpeak(
+  channelId: string,
+  nickname: string,
+  options: SlowModeClockOptions = {},
+  store?: ChannelSlowModeStore,
+) {
+  return createChannelSlowModeService(store).canSpeak(channelId, nickname, options);
+}
+
+export async function recordChannelSpeak(
+  channelId: string,
+  nickname: string,
+  options: SlowModeClockOptions = {},
+  store?: ChannelSlowModeStore,
+): Promise<RecordSpeakResult> {
+  return createChannelSlowModeService(store).recordChannelSpeak(channelId, nickname, options);
+}
+
+export async function trySpeak(
+  channelId: string,
+  nickname: string,
+  options: SlowModeClockOptions = {},
+  store?: ChannelSlowModeStore,
+) {
+  return createChannelSlowModeService(store).trySpeak(channelId, nickname, options);
+}
+
+export async function listActiveCooldowns(
+  channelId: string,
+  options: SlowModeClockOptions = {},
+  store?: ChannelSlowModeStore,
+): Promise<SpeakCooldownView[]> {
+  return createChannelSlowModeService(store).listActiveCooldowns(channelId, options);
+}
+
+export async function getCooldown(
+  channelId: string,
+  nickname: string,
+  options: SlowModeClockOptions = {},
+  store?: ChannelSlowModeStore,
+): Promise<SpeakCooldownView | null> {
+  return createChannelSlowModeService(store).getCooldown(channelId, nickname, options);
+}
+
+export async function sweepExpiredCooldowns(
+  channelId: string,
+  options: SlowModeClockOptions = {},
+  store?: ChannelSlowModeStore,
+): Promise<CooldownSweepResult> {
+  return createChannelSlowModeService(store).sweepExpiredCooldowns(channelId, options);
+}
diff --git a/packages/backend/src/services/slow_mode.ts b/packages/backend/src/services/slow_mode.ts
