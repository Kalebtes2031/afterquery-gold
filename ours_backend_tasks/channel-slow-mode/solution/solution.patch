@@ -0,0 +1,64 @@
+export {
+  ChannelSlowModeService,
+  canSpeak,
+  clearChannelSlowMode,
+  createChannelSlowModeService,
+  getChannelSlowMode,
+  getCooldown,
+  listActiveCooldowns,
+  recordChannelSpeak,
+  setChannelSlowMode,
+  sweepExpiredCooldowns,
+  trySpeak,
+} from "#ours/backend/services/slow_mode_service.ts";
+
+export {
+  MemoryChannelSlowModeStore,
+  createMemoryChannelSlowModeStore,
+} from "#ours/backend/services/slow_mode_store.ts";
+
+export {
+  DEFAULT_COOLDOWN_SWEEP_LIMIT,
+  DEFAULT_SLOW_MODE_SECONDS,
+  MAX_SLOW_MODE_SECONDS,
+  MIN_SLOW_MODE_SECONDS,
+  SLOW_MODE_FAILURE_REASONS,
+  isChannelSlowModeConfig,
+  isChannelSpeakCooldown,
+  type ChannelSlowModeConfig,
+  type ChannelSlowModeStore,
+  type ChannelSpeakCooldown,
+  type ClearSlowModeResult,
