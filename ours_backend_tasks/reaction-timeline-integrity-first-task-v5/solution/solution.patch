@@ -0,0 +1,83 @@
+import type { RedisClientType } from "redis";
+import { classifyRecordIssue, parseReactionTimestamp } from "#ours/backend/session/reaction_record.ts";
+import { collectRoomReactionSnapshots, reactionKeys } from "#ours/backend/session/reaction_snapshot.ts";
+import { buildReactionRepairPlan, countRepairActions } from "#ours/backend/session/reaction_repair_plan.ts";
+import { inspectReactionIndexes } from "#ours/backend/session/reaction_index_observation.ts";
+import { buildRoomReactionAudit } from "#ours/backend/session/reaction_audit_report.ts";
+import type {
+  ReactionIntegrityIssue,
+  ReactionRecordSnapshot,
+  RoomReactionAudit,
+  RoomReactionRepairResult,
+} from "#ours/backend/session/reaction_integrity_types.ts";
+
+export const auditRoomReactionIntegrity = async (client: RedisClientType, roomId: string): Promise<RoomReactionAudit> => {
+  const snapshots = await collectRoomReactionSnapshots(client, roomId);
+  const issues: ReactionIntegrityIssue[] = [];
+  const validIds = new Set<string>();
+
+  for (const snapshot of snapshots) {
+    const snapshotIssues = await inspectReactionIndexes(client, roomId, snapshot);
+    issues.push(...snapshotIssues);
+    if (!classifyRecordIssue(snapshot, roomId)) validIds.add(snapshot.reactionId);
+  }
+
+  return buildRoomReactionAudit(roomId, validIds.size, issues);
+};
+
+const applyRepairPlan = (
+  pipeline: ReturnType<RedisClientType["multi"]>,
+  roomId: string,
+  plan: ReturnType<typeof buildReactionRepairPlan>,
+) => {
+  for (const entry of plan) {
+    if (entry.action === "remove") {
+      pipeline.sRem(reactionKeys.roomReactions(roomId), entry.reactionId);
+      pipeline.zRem(reactionKeys.roomReactionsByTime(roomId), entry.reactionId);
+      continue;
+    }
+
+    pipeline.sAdd(reactionKeys.roomReactions(roomId), entry.reactionId);
+    pipeline.sAdd(reactionKeys.messageReactions(entry.messageId), entry.reactionId);
+    pipeline.sAdd(reactionKeys.userMessageReactions(entry.userId, entry.messageId), entry.reactionId);
+    pipeline.zAdd(reactionKeys.roomReactionsByTime(roomId), {
+      score: entry.timestamp,
+      value: entry.reactionId,
+    });
+  }
+};
+
+export const repairRoomReactionIntegrity = async (
+  client: RedisClientType,
+  roomId: string,
+): Promise<RoomReactionRepairResult> => {
+  const before = await auditRoomReactionIntegrity(client, roomId);
+  const snapshots = await collectRoomReactionSnapshots(client, roomId);
+  const plan = buildReactionRepairPlan(roomId, snapshots, before.issues);
+  const pipeline = client.multi();
+  applyRepairPlan(pipeline, roomId, plan);
+  if (plan.length > 0) await pipeline.exec();
+  const after = await auditRoomReactionIntegrity(client, roomId);
+  const counts = countRepairActions(plan);
+  return {
+    roomId,
+    beforeIssueCount: before.issueCount,
+    repaired: counts.repaired,
+    removed: counts.removed,
+    afterIssueCount: after.issueCount,
+  };
+};
+
+export const refreshReactionTimelineScore = async (
+  client: RedisClientType,
+  roomId: string,
+  reactionId: string,
+  timestamp: Date,
+) => {
+  await client.zAdd(reactionKeys.roomReactionsByTime(roomId), {
+    score: timestamp.getTime(),
+    value: reactionId,
+  });
+};
+
+export const timestampForSnapshot = (snapshot: ReactionRecordSnapshot) => parseReactionTimestamp(snapshot.data.timestamp);
