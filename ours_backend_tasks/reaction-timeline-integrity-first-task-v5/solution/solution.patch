index 0000000..384d4d8
--- /dev/null
+++ b/packages/backend/src/session/reaction_timeline.ts
@@ -0,0 +1,37 @@
+import type { RedisClientType } from "redis";
+import {
+  compareTimelineEntries,
+  normalizeTimelineOptions,
+  timelineRangeIsValid,
+  toTimelineEntry,
+} from "#ours/backend/session/reaction_record.ts";
+import { collectRoomReactionSnapshots } from "#ours/backend/session/reaction_snapshot.ts";
+import type {
+  RoomReactionTimelineEntry,
+  RoomReactionTimelineOptions,
+} from "#ours/backend/session/reaction_integrity_types.ts";
+
+const withinBoundary = (entry: RoomReactionTimelineEntry, since: number | undefined, until: number | undefined) => {
+  const value = entry.timestamp.getTime();
+  if (since !== undefined && value < since) return false;
+  if (until !== undefined && value > until) return false;
+  return true;
+};
+
+export const getRoomReactionTimeline = async (
+  client: RedisClientType,
+  roomId: string,
+  options?: RoomReactionTimelineOptions,
+) => {
+  const normalized = normalizeTimelineOptions(options);
+  if (!timelineRangeIsValid(normalized.since, normalized.until)) return [];
+
+  const snapshots = await collectRoomReactionSnapshots(client, roomId);
+  const entries = snapshots
+    .map(toTimelineEntry)
+    .filter((entry): entry is RoomReactionTimelineEntry => entry !== null && entry.roomId === roomId)
+    .filter((entry) => withinBoundary(entry, normalized.since, normalized.until))
+    .sort(compareTimelineEntries);
+
+  return entries.slice(0, normalized.limit);
+};
