+import {
+  countReactionIssues,
+  REACTION_INTEGRITY_CODES,
+  totalReactionIssueCount,
+} from "#ours/backend/session/reaction_issue_counts.ts";
+import type {
+  ReactionIntegrityIssue,
+  RoomReactionAudit,
+} from "#ours/backend/session/reaction_integrity_types.ts";
+
+const codePosition = new Map(
+  REACTION_INTEGRITY_CODES.map((code, index) => [code, index] as const),
+);
+
+const compareReactionIssues = (left: ReactionIntegrityIssue, right: ReactionIntegrityIssue) => {
+  const idDifference = left.reactionId.localeCompare(right.reactionId);
+  if (idDifference !== 0) return idDifference;
+  return (codePosition.get(left.code) ?? 0) - (codePosition.get(right.code) ?? 0);
+};
+
+const issueKey = (issue: ReactionIntegrityIssue) => `${issue.reactionId}\u0000${issue.code}`;
+
+export const normalizeReactionIssues = (issues: ReactionIntegrityIssue[]) => {
+  const unique = new Map<string, ReactionIntegrityIssue>();
+  for (const issue of issues) unique.set(issueKey(issue), issue);
+  return Array.from(unique.values()).sort(compareReactionIssues);
+};
+
+export const buildRoomReactionAudit = (
+  roomId: string,
+  reactionCount: number,
+  issues: ReactionIntegrityIssue[],
+): RoomReactionAudit => {
+  const normalizedIssues = normalizeReactionIssues(issues);
+  const issueCounts = countReactionIssues(normalizedIssues);
+  const issueCount = totalReactionIssueCount(issueCounts);
+
+  return {
+    roomId,
+    reactionCount,
+    issueCount,
+    healthy: issueCount === 0,
+    issueCounts,
+    issues: normalizedIssues,
+  };
+};
diff --git a/packages/backend/src/session/reaction_index_observation.ts b/packages/backend/src/session/reaction_index_observation.ts
new file mode 100644
index 0000000..94b9bb2
--- /dev/null
+++ b/packages/backend/src/session/reaction_index_observation.ts
@@ -0,0 +1,100 @@
+import type { RedisClientType } from "redis";
+import { classifyRecordIssue, toReactionEntity } from "#ours/backend/session/reaction_record.ts";
+import { reactionKeys } from "#ours/backend/session/reaction_snapshot.ts";
+import type {
+  ReactionIntegrityIssue,
+  ReactionIntegrityIssueCode,
+  ReactionRecordSnapshot,
+} from "#ours/backend/session/reaction_integrity_types.ts";
+
+interface ReactionIndexObservation {
+  reactionId: string;
+  recordIssue: ReactionIntegrityIssueCode | null;
+  expectedTimestamp: number | null;
+  roomIndexed: boolean;
+  timelineIndexed: boolean;
+  timelineScore: number | null;
+  messageIndexed: boolean;
+  userIndexed: boolean;
+}
+
+const emptyObservation = (
+  snapshot: ReactionRecordSnapshot,
+  recordIssue: ReactionIntegrityIssueCode,
+): ReactionIndexObservation => ({
+  reactionId: snapshot.reactionId,
+  recordIssue,
+  expectedTimestamp: null,
+  roomIndexed: snapshot.roomIndexed,
+  timelineIndexed: snapshot.timelineScore !== null,
+  timelineScore: snapshot.timelineScore,
+  messageIndexed: false,
+  userIndexed: false,
+});
+
+export const observeReactionIndexes = async (
+  client: RedisClientType,
+  roomId: string,
+  snapshot: ReactionRecordSnapshot,
+): Promise<ReactionIndexObservation> => {
+  const recordIssue = classifyRecordIssue(snapshot, roomId);
+  if (recordIssue) return emptyObservation(snapshot, recordIssue);
+
+  const entity = toReactionEntity(snapshot.data);
+  if (!entity) return emptyObservation(snapshot, "invalid_timestamp");
+
+  const [messageIndexed, userIndexed] = await Promise.all([
+    client.sIsMember(reactionKeys.messageReactions(entity.messageId), snapshot.reactionId),
+    client.sIsMember(
+      reactionKeys.userMessageReactions(entity.userId, entity.messageId),
+      snapshot.reactionId,
+    ),
+  ]);
+
+  return {
+    reactionId: snapshot.reactionId,
+    recordIssue: null,
+    expectedTimestamp: entity.timestamp.getTime(),
+    roomIndexed: snapshot.roomIndexed,
+    timelineIndexed: snapshot.timelineScore !== null,
+    timelineScore: snapshot.timelineScore,
+    messageIndexed,
+    userIndexed,
+  };
+};
+
+const addIssue = (
+  issues: ReactionIntegrityIssue[],
+  reactionId: string,
+  code: ReactionIntegrityIssueCode,
+  when: boolean,
+) => {
+  if (when) issues.push({ reactionId, code });
+};
+
+export const issuesForReactionObservation = (
+  observation: ReactionIndexObservation,
+): ReactionIntegrityIssue[] => {
+  if (observation.recordIssue) {
+    return [{ reactionId: observation.reactionId, code: observation.recordIssue }];
+  }
+
+  const issues: ReactionIntegrityIssue[] = [];
+  addIssue(issues, observation.reactionId, "missing_room_index", !observation.roomIndexed);
+  addIssue(issues, observation.reactionId, "missing_timeline_index", !observation.timelineIndexed);
+  addIssue(
+    issues,
+    observation.reactionId,
+    "stale_timeline_score",
+    observation.timelineIndexed && observation.timelineScore !== observation.expectedTimestamp,
+  );
+  addIssue(issues, observation.reactionId, "missing_message_index", !observation.messageIndexed);
+  addIssue(issues, observation.reactionId, "missing_user_index", !observation.userIndexed);
+  return issues;
+};
+
+export const inspectReactionIndexes = async (
+  client: RedisClientType,
+  roomId: string,
+  snapshot: ReactionRecordSnapshot,
+) => issuesForReactionObservation(await observeReactionIndexes(client, roomId, snapshot));
