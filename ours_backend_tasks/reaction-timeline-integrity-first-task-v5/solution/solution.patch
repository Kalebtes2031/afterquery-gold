@@ -0,0 +1,40 @@
+import type {
+  ReactionIntegrityIssue,
+  ReactionIntegrityIssueCode,
+} from "#ours/backend/session/reaction_integrity_types.ts";
+
+export const REACTION_INTEGRITY_CODES = [
+  "invalid_timestamp",
+  "missing_message_index",
+  "missing_record",
+  "missing_room_index",
+  "missing_timeline_index",
+  "missing_user_index",
+  "stale_timeline_score",
+  "wrong_room",
+] as const satisfies readonly ReactionIntegrityIssueCode[];
+
+export type ReactionIssueCounts = Record<ReactionIntegrityIssueCode, number>;
+
+export const emptyReactionIssueCounts = (): ReactionIssueCounts => ({
+  invalid_timestamp: 0,
+  missing_message_index: 0,
+  missing_record: 0,
+  missing_room_index: 0,
+  missing_timeline_index: 0,
+  missing_user_index: 0,
+  stale_timeline_score: 0,
+  wrong_room: 0,
+});
+
+export const countReactionIssues = (issues: ReactionIntegrityIssue[]) => {
+  const counts = emptyReactionIssueCounts();
+  for (const issue of issues) counts[issue.code] += 1;
+  return counts;
+};
+
+export const issueCodesForCount = (counts: ReactionIssueCounts) =>
+  REACTION_INTEGRITY_CODES.filter((code) => counts[code] > 0);
+
+export const totalReactionIssueCount = (counts: ReactionIssueCounts) =>
+  REACTION_INTEGRITY_CODES.reduce((total, code) => total + counts[code], 0);
