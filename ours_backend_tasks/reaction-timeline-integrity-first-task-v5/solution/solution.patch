+import type { ReactionEventEntity } from "#ours/backend/session/models/index.ts";
+
+export type ReactionIntegrityIssueCode =
+  | "invalid_timestamp"
+  | "missing_message_index"
+  | "missing_record"
+  | "missing_room_index"
+  | "missing_timeline_index"
+  | "missing_user_index"
+  | "stale_timeline_score"
+  | "wrong_room";
+
+export interface ReactionIntegrityIssue {
+  reactionId: string;
+  code: ReactionIntegrityIssueCode;
+}
+
+export interface RoomReactionAudit {
+  roomId: string;
+  reactionCount: number;
+  issueCount: number;
+  healthy: boolean;
+  issueCounts: Record<ReactionIntegrityIssueCode, number>;
+  issues: ReactionIntegrityIssue[];
+}
+
+export interface RoomReactionRepairResult {
+  roomId: string;
+  beforeIssueCount: number;
+  repaired: number;
+  removed: number;
+  afterIssueCount: number;
+}
+
+export interface RoomReactionTimelineOptions {
+  since?: number;
+  until?: number;
+  limit?: number;
+}
+
+export interface RoomReactionTimelineEntry extends ReactionEventEntity {
+  reactionId: string;
+}
+
+export interface ReactionRecordSnapshot {
+  reactionId: string;
+  data: Record<string, string>;
+  roomIndexed: boolean;
+  timelineScore: number | null;
+}
