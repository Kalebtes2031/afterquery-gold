@@ -0,0 +1,68 @@
+import type { ReactionEventEntity } from "#ours/backend/session/models/index.ts";
+import type {
+  ReactionIntegrityIssueCode,
+  ReactionRecordSnapshot,
+  RoomReactionTimelineEntry,
+} from "#ours/backend/session/reaction_integrity_types.ts";
+
+const REQUIRED_TEXT_FIELDS = ["messageId", "userId", "reaction", "roomId"] as const;
+
+export const parseReactionTimestamp = (value: string | undefined) => {
+  if (!value) return null;
+  const timestamp = new Date(value);
+  return Number.isFinite(timestamp.getTime()) ? timestamp : null;
+};
+
+export const isReactionRecordPresent = (data: Record<string, string>) => Object.keys(data).length > 0;
+
+export const hasRequiredReactionFields = (data: Record<string, string>) =>
+  REQUIRED_TEXT_FIELDS.every((field) => typeof data[field] === "string" && data[field].length > 0);
+
+export const toReactionEntity = (data: Record<string, string>): ReactionEventEntity | null => {
+  const timestamp = parseReactionTimestamp(data.timestamp);
+  if (!timestamp || !hasRequiredReactionFields(data)) return null;
+  return {
+    messageId: data.messageId,
+    userId: data.userId,
+    reaction: data.reaction,
+    roomId: data.roomId,
+    timestamp,
+  };
+};
+
+export const toTimelineEntry = (snapshot: ReactionRecordSnapshot): RoomReactionTimelineEntry | null => {
+  const entity = toReactionEntity(snapshot.data);
+  if (!entity) return null;
+  return { ...entity, reactionId: snapshot.reactionId };
+};
+
+export const classifyRecordIssue = (snapshot: ReactionRecordSnapshot, roomId: string) => {
+  if (!isReactionRecordPresent(snapshot.data)) return "missing_record" satisfies ReactionIntegrityIssueCode;
+  if (!parseReactionTimestamp(snapshot.data.timestamp)) return "invalid_timestamp" satisfies ReactionIntegrityIssueCode;
+  if (!hasRequiredReactionFields(snapshot.data)) return "invalid_timestamp" satisfies ReactionIntegrityIssueCode;
+  if (snapshot.data.roomId !== roomId) return "wrong_room" satisfies ReactionIntegrityIssueCode;
+  return null;
+};
+
+export const compareTimelineEntries = (left: RoomReactionTimelineEntry, right: RoomReactionTimelineEntry) => {
+  const timeDifference = right.timestamp.getTime() - left.timestamp.getTime();
+  if (timeDifference !== 0) return timeDifference;
+  return left.reactionId.localeCompare(right.reactionId);
+};
+
+export const normalizeTimelineLimit = (value: number | undefined) => {
+  if (value === undefined || !Number.isFinite(value)) return 100;
+  return Math.min(100, Math.max(1, Math.trunc(value)));
+};
+
+export const normalizeTimelineBoundary = (value: number | undefined) =>
+  value !== undefined && Number.isFinite(value) ? value : undefined;
+
+export const normalizeTimelineOptions = (options?: { since?: number; until?: number; limit?: number }) => ({
+  since: normalizeTimelineBoundary(options?.since),
+  until: normalizeTimelineBoundary(options?.until),
+  limit: normalizeTimelineLimit(options?.limit),
+});
+
+export const timelineRangeIsValid = (since: number | undefined, until: number | undefined) =>
+  since === undefined || until === undefined || since <= until;
diff --git a/packages/backend/src/session/reaction_repair_plan.ts b/packages/backend/src/session/reaction_repair_plan.ts
new file mode 100644
index 0000000..9948531
--- /dev/null
+++ b/packages/backend/src/session/reaction_repair_plan.ts
@@ -0,0 +1,61 @@
+import { classifyRecordIssue, toReactionEntity } from "#ours/backend/session/reaction_record.ts";
+import type {
+  ReactionIntegrityIssue,
+  ReactionRecordSnapshot,
+} from "#ours/backend/session/reaction_integrity_types.ts";
+
+export interface ReactionRepairPlanRemove {
+  action: "remove";
+  reactionId: string;
+}
+
+export interface ReactionRepairPlanRestore {
+  action: "restore";
+  reactionId: string;
+  messageId: string;
+  userId: string;
+  timestamp: number;
+}
+
+export type ReactionRepairPlanEntry = ReactionRepairPlanRemove | ReactionRepairPlanRestore;
+
+const affectedReactionIds = (issues: ReactionIntegrityIssue[]) => new Set(issues.map((issue) => issue.reactionId));
+
+const toPlanEntry = (roomId: string, snapshot: ReactionRecordSnapshot): ReactionRepairPlanEntry | null => {
+  if (classifyRecordIssue(snapshot, roomId)) {
+    return { action: "remove", reactionId: snapshot.reactionId };
+  }
+
+  const entity = toReactionEntity(snapshot.data);
+  if (!entity) return { action: "remove", reactionId: snapshot.reactionId };
+
+  return {
+    action: "restore",
+    reactionId: snapshot.reactionId,
+    messageId: entity.messageId,
+    userId: entity.userId,
+    timestamp: entity.timestamp.getTime(),
+  };
+};
+
+export const buildReactionRepairPlan = (
+  roomId: string,
+  snapshots: ReactionRecordSnapshot[],
+  issues: ReactionIntegrityIssue[],
+) => {
+  const affected = affectedReactionIds(issues);
+  const plan: ReactionRepairPlanEntry[] = [];
+
+  for (const snapshot of snapshots) {
+    if (!affected.has(snapshot.reactionId)) continue;
+    const entry = toPlanEntry(roomId, snapshot);
+    if (entry) plan.push(entry);
+  }
+
+  return plan.sort((left, right) => left.reactionId.localeCompare(right.reactionId));
+};
+
+export const countRepairActions = (plan: ReactionRepairPlanEntry[]) => ({
+  repaired: plan.filter((entry) => entry.action === "restore").length,
+  removed: plan.filter((entry) => entry.action === "remove").length,
+});
diff --git a/packages/backend/src/session/reaction_snapshot.ts b/packages/backend/src/session/reaction_snapshot.ts
