+
+    const result = await auditRoom("room-1");
+
+    expect(result.reactionCount).toBe(1);
+  });
+
+  it("tracks issue totals by code", async () => {
+    redis.seedReaction({ messageId: "m-1", userId: "u-1", messageIndexed: false });
+    redis.seedReaction({ messageId: "m-2", userId: "u-2", messageIndexed: false });
+    redis.seedRoomReference("room-1", "missing-id", 10);
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issueCounts).toEqual({
+      invalid_timestamp: 0,
+      missing_message_index: 2,
+      missing_record: 1,
