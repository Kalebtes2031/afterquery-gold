@@ -0,0 +1,204 @@
+import { beforeEach, describe, expect, it, installFixedDate, runRegisteredTests } from "#ours/backend/gold_tests/gold_node_harness.test.ts";
+import {
+  FakeRedisClient,
+  getNodeClientMock,
+  invokeOperation,
+} from "#ours/backend/gold_tests/reaction_integrity_fixture.test.ts";
+
+const reactionOperations = await import("#ours/backend/session/operations/reactions.ts");
+const operationBarrel = await import("#ours/backend/session/operations/index.ts");
+
+
+interface TimelineEntry {
+  reactionId: string;
+  messageId: string;
+  userId: string;
+  reaction: string;
+  roomId: string;
+  timestamp: Date;
+}
+
+const readTimeline = (roomId: string, options?: { since?: number; until?: number; limit?: number }) =>
+  invokeOperation<TimelineEntry[]>(reactionOperations as Record<string, unknown>, "getRoomReactionTimeline", roomId, options);
+
+const timestamp = (value: string) => new Date(value).getTime();
+
+let redis: FakeRedisClient;
+
+beforeEach(() => {
+  redis = new FakeRedisClient();
+  getNodeClientMock.mockResolvedValue(redis);
+});
+
+describe("Reaction timeline integrity", () => {
+  it("exports the integrity operations from the reaction operations barrel", () => {
+    expect(typeof operationBarrel.getRoomReactionTimeline).toBe("function");
+    expect(typeof operationBarrel.auditRoomReactionIntegrity).toBe("function");
+    expect(typeof operationBarrel.repairRoomReactionIntegrity).toBe("function");
+  });
+
+  it("returns the complete public timeline entry shape", async () => {
+    const id = redis.seedReaction({
+      messageId: "message-shape",
+      userId: "user-shape",
+      reaction: "FIRE",
+      roomId: "room-1",
+      timestamp: "2026-01-05T06:07:08.000Z",
+    });
+
+    const result = await readTimeline("room-1");
+
+    expect(result).toEqual([{
+      reactionId: id,
+      messageId: "message-shape",
+      userId: "user-shape",
+      reaction: "FIRE",
+      roomId: "room-1",
+      timestamp: new Date("2026-01-05T06:07:08.000Z"),
+    }]);
+  });
+
+  it("returns a canonical room timeline newest first", async () => {
+    redis.seedReaction({ messageId: "old", timestamp: "2026-01-01T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "new", timestamp: "2026-01-03T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "middle", timestamp: "2026-01-02T00:00:00.000Z" });
+
+    const result = await readTimeline("room-1");
+
+    expect(result.map((entry) => entry.messageId)).toEqual(["new", "middle", "old"]);
+  });
+
+  it("uses the reaction hash timestamp instead of a stale sorted-set score", async () => {
+    redis.seedReaction({
+      messageId: "really-new",
+      timestamp: "2026-01-04T00:00:00.000Z",
+      timelineScore: timestamp("2025-01-01T00:00:00.000Z"),
+    });
+    redis.seedReaction({ messageId: "older", timestamp: "2026-01-02T00:00:00.000Z" });
+
+    const result = await readTimeline("room-1");
+
+    expect(result.map((entry) => entry.messageId)).toEqual(["really-new", "older"]);
+  });
+
+  it("includes a valid reaction that is missing only from the timeline index", async () => {
+    redis.seedReaction({ messageId: "message-a", timelineIndexed: false });
+
+    const result = await readTimeline("room-1");
+
+    expect(result).toHaveLength(1);
+    expect(result[0].messageId).toBe("message-a");
+  });
+
+  it("includes a valid reaction that is present only in the timeline index", async () => {
+    const id = redis.seedReaction({ messageId: "message-a", roomIndexed: false });
+
+    const result = await readTimeline("room-1");
+
+    expect(result.map((entry) => entry.reactionId)).toEqual([id]);
+  });
+
+  it("ignores room index entries whose reaction hash is missing", async () => {
+    redis.seedRoomReference("room-1", "missing-id", timestamp("2026-01-01T00:00:00.000Z"));
+
+    expect(await readTimeline("room-1")).toEqual([]);
+  });
+
+  it("ignores records that belong to another room", async () => {
+    const id = redis.seedReaction({ roomId: "room-2" });
+    redis.seedRoomReference("room-1", id, timestamp("2026-01-01T00:00:00.000Z"));
+
+    expect(await readTimeline("room-1")).toEqual([]);
+  });
+
+  it("ignores records with an invalid timestamp", async () => {
+    redis.seedReaction({ timestamp: "not-a-date" });
+
+    expect(await readTimeline("room-1")).toEqual([]);
+  });
+
+  it("applies the since boundary inclusively", async () => {
+    redis.seedReaction({ messageId: "before", timestamp: "2026-01-01T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "at", timestamp: "2026-01-02T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "after", timestamp: "2026-01-03T00:00:00.000Z" });
+
+    const result = await readTimeline("room-1", { since: timestamp("2026-01-02T00:00:00.000Z") });
+
+    expect(result.map((entry) => entry.messageId)).toEqual(["after", "at"]);
+  });
+
+  it("applies the until boundary inclusively", async () => {
+    redis.seedReaction({ messageId: "before", timestamp: "2026-01-01T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "at", timestamp: "2026-01-02T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "after", timestamp: "2026-01-03T00:00:00.000Z" });
+
+    const result = await readTimeline("room-1", { until: timestamp("2026-01-02T00:00:00.000Z") });
+
+    expect(result.map((entry) => entry.messageId)).toEqual(["at", "before"]);
+  });
+
+  it("returns no reactions when since is after until", async () => {
+    redis.seedReaction();
+
+    const result = await readTimeline("room-1", {
+      since: timestamp("2026-01-03T00:00:00.000Z"),
+      until: timestamp("2026-01-02T00:00:00.000Z"),
+    });
+
+    expect(result).toEqual([]);
+  });
+
+  it("uses one item when the requested limit is zero", async () => {
+    redis.seedReaction({ messageId: "one", timestamp: "2026-01-02T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "two", timestamp: "2026-01-01T00:00:00.000Z" });
+
+    expect(await readTimeline("room-1", { limit: 0 })).toHaveLength(1);
+  });
+
+  it("truncates a fractional limit before applying it", async () => {
+    redis.seedReaction({ messageId: "one", timestamp: "2026-01-03T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "two", timestamp: "2026-01-02T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "three", timestamp: "2026-01-01T00:00:00.000Z" });
+
+    expect(await readTimeline("room-1", { limit: 2.9 })).toHaveLength(2);
+  });
+
+  it("uses the default limit for a non-finite limit", async () => {
+    for (let index = 0; index < 4; index += 1) {
+      redis.seedReaction({ messageId: `message-${index}`, userId: `user-${index}` });
+    }
+
+    expect(await readTimeline("room-1", { limit: Number.NaN })).toHaveLength(4);
+  });
+
+  it("caps the timeline at one hundred reactions", async () => {
+    for (let index = 0; index < 105; index += 1) {
+      redis.seedReaction({
+        messageId: `message-${index}`,
+        userId: `user-${index}`,
+        timestamp: new Date(1_760_000_000_000 + index).toISOString(),
+      });
+    }
+
+    expect(await readTimeline("room-1", { limit: 500 })).toHaveLength(100);
+  });
+
+  it("ignores non-finite time boundaries", async () => {
+    redis.seedReaction({ messageId: "kept" });
+
+    const result = await readTimeline("room-1", { since: Number.NaN, until: Number.POSITIVE_INFINITY });
+
+    expect(result.map((entry) => entry.messageId)).toEqual(["kept"]);
+  });
+
+  it("breaks equal timestamp ties by reaction id", async () => {
+    const first = redis.seedReaction({ messageId: "a", userId: "u-a" });
+    const second = redis.seedReaction({ messageId: "b", userId: "u-b" });
+
+    const result = await readTimeline("room-1");
+
+    expect(result.map((entry) => entry.reactionId)).toEqual([first, second].sort((a, b) => a.localeCompare(b)));
+  });
+});
+
+await runRegisteredTests();
