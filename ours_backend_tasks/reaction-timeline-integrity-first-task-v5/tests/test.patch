@@ -0,0 +1,97 @@
+import { describe, expect, it, runRegisteredTests } from "#ours/backend/gold_tests/gold_node_harness.test.ts";
+import { FakeRedisClient, getNodeClientMock, reactionIdFor } from "#ours/backend/gold_tests/reaction_integrity_fixture.test.ts";
+
+const reactionOperations = await import("#ours/backend/session/operations/reactions.ts");
+
+const freshRedis = () => {
+  const redis = new FakeRedisClient();
+  getNodeClientMock.mockResolvedValue(redis);
+  return redis;
+};
+
+describe("Existing reaction operations", () => {
+  it("adds a new reaction and returns its supplied identity fields", async () => {
+    freshRedis();
+    const result = await reactionOperations.addReaction("m1", "u1", "HEART", "room-1");
+    expect(result.messageId).toBe("m1");
+    expect(result.userId).toBe("u1");
+    expect(result.reaction).toBe("HEART");
+    expect(result.roomId).toBe("room-1");
+  });
+
+  it("stores a new reaction hash", async () => {
+    const redis = freshRedis();
+    await reactionOperations.addReaction("m1", "u1", "HEART", "room-1");
+    expect(redis.hashes.size).toBe(1);
+  });
+
+  it("indexes a new reaction by message", async () => {
+    const redis = freshRedis();
+    await reactionOperations.addReaction("m1", "u1", "HEART", "room-1");
+    const id = reactionIdFor("m1", "u1", "HEART");
+    expect(redis.sets.get("message_reactions:m1")?.has(id)).toBe(true);
+  });
+
+  it("indexes a new reaction by user and message", async () => {
+    const redis = freshRedis();
+    await reactionOperations.addReaction("m1", "u1", "HEART", "room-1");
+    expect(redis.sets.get("user_message_reactions:u1:m1")?.size).toBe(1);
+  });
+
+  it("indexes a new reaction by room", async () => {
+    const redis = freshRedis();
+    await reactionOperations.addReaction("m1", "u1", "HEART", "room-1");
+    expect(redis.sets.get("room_reactions:room-1")?.size).toBe(1);
+  });
+
+  it("indexes a new reaction in the room timeline", async () => {
+    const redis = freshRedis();
+    await reactionOperations.addReaction("m1", "u1", "HEART", "room-1");
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.size).toBe(1);
+  });
+
+  it("removes an existing reaction from its hash and indexes", async () => {
+    const redis = freshRedis();
+    const id = redis.seedReaction({ messageId: "m1", userId: "u1", reaction: "HEART" });
+    expect(await reactionOperations.removeReaction("m1", "u1", "HEART")).toBe(true);
+    expect(redis.hashes.has(`reaction:${id}`)).toBe(false);
+    expect(redis.sets.get("message_reactions:m1")?.has(id)).toBe(false);
+    expect(redis.sets.get("user_message_reactions:u1:m1")?.has(id)).toBe(false);
+    expect(redis.sets.get("room_reactions:room-1")?.has(id)).toBe(false);
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.has(id)).toBe(false);
+  });
+
+  it("returns false when removing a reaction that does not exist", async () => {
+    freshRedis();
+    expect(await reactionOperations.removeReaction("m1", "u1", "HEART")).toBe(false);
+  });
+
+  it("groups message reactions and reports the total count", async () => {
+    const redis = freshRedis();
+    redis.seedReaction({ messageId: "m1", userId: "u1", reaction: "HEART" });
+    redis.seedReaction({ messageId: "m1", userId: "u2", reaction: "HEART" });
+    redis.seedReaction({ messageId: "m1", userId: "u3", reaction: "FIRE" });
+    const result = await reactionOperations.getMessageReactions("m1");
+    expect(result.totalCount).toBe(3);
+    expect(result.reactions).toContainEqual({ reaction: "HEART", count: 2 });
+    expect(result.reactions).toContainEqual({ reaction: "FIRE", count: 1 });
+  });
+
+  it("returns the current user's reactions for a message", async () => {
+    const redis = freshRedis();
+    redis.seedReaction({ messageId: "m1", userId: "u1", reaction: "HEART" });
+    redis.seedReaction({ messageId: "m1", userId: "u1", reaction: "FIRE" });
+    const result = await reactionOperations.getUserReactionsForMessage("m1", "u1");
+    expect(result.sort()).toEqual(["FIRE", "HEART"]);
+  });
+
+  it("returns room reactions in newest-first timeline order", async () => {
+    const redis = freshRedis();
+    redis.seedReaction({ messageId: "older", userId: "u1", timestamp: "2026-01-01T00:00:00.000Z" });
+    redis.seedReaction({ messageId: "newer", userId: "u2", timestamp: "2026-01-02T00:00:00.000Z" });
+    const result = await reactionOperations.getRoomReactions("room-1", 10);
+    expect(result.map((item) => item.messageId)).toEqual(["newer", "older"]);
+  });
+});
+
+await runRegisteredTests();
diff --git a/packages/backend/src/gold_tests/reaction_audit_behavior.test.ts b/packages/backend/src/gold_tests/reaction_audit_behavior.test.ts
new file mode 100644
index 0000000..af9f3fc
--- /dev/null
+++ b/packages/backend/src/gold_tests/reaction_audit_behavior.test.ts
@@ -0,0 +1,212 @@
+import { beforeEach, describe, expect, it, installFixedDate, runRegisteredTests } from "#ours/backend/gold_tests/gold_node_harness.test.ts";
+import {
+  FakeRedisClient,
+  getNodeClientMock,
+  invokeOperation,
+} from "#ours/backend/gold_tests/reaction_integrity_fixture.test.ts";
+
+const reactionOperations = await import("#ours/backend/session/operations/reactions.ts");
+
+
+type IssueCode =
+  | "invalid_timestamp"
+  | "missing_message_index"
+  | "missing_record"
+  | "missing_room_index"
+  | "missing_timeline_index"
+  | "missing_user_index"
+  | "stale_timeline_score"
+  | "wrong_room";
+
+interface AuditResult {
+  roomId: string;
+  reactionCount: number;
+  issueCount: number;
+  healthy: boolean;
+  issueCounts: Record<IssueCode, number>;
+  issues: Array<{ reactionId: string; code: IssueCode }>;
+}
+
+const auditRoom = (roomId: string) =>
+  invokeOperation<AuditResult>(reactionOperations as Record<string, unknown>, "auditRoomReactionIntegrity", roomId);
+
+const codes = (result: AuditResult) => result.issues.map((issue) => issue.code);
+
+let redis: FakeRedisClient;
+
+beforeEach(() => {
+  redis = new FakeRedisClient();
+  getNodeClientMock.mockResolvedValue(redis);
+});
+
+describe("Reaction index audit", () => {
+  it("reports a healthy room with no issues", async () => {
+    redis.seedReaction();
+
+    const result = await auditRoom("room-1");
+
+    expect(result.roomId).toBe("room-1");
+    expect(result.reactionCount).toBe(1);
+    expect(result.issueCount).toBe(0);
+    expect(result.healthy).toBe(true);
+    expect(result.issues).toEqual([]);
+  });
+
+  it("returns zero counts for every issue code when healthy", async () => {
+    redis.seedReaction();
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issueCounts).toEqual({
+      invalid_timestamp: 0,
+      missing_message_index: 0,
+      missing_record: 0,
+      missing_room_index: 0,
+      missing_timeline_index: 0,
+      missing_user_index: 0,
+      stale_timeline_score: 0,
+      wrong_room: 0,
+    });
+  });
+
+  it("reports a room index reference with no backing hash", async () => {
+    redis.seedRoomReference("room-1", "missing-id", 10);
+
+    const result = await auditRoom("room-1");
+
+    expect(result.healthy).toBe(false);
+    expect(result.reactionCount).toBe(0);
+    expect(result.issues).toEqual([{ reactionId: "missing-id", code: "missing_record" }]);
+  });
+
+  it("reports a record indexed into the wrong room", async () => {
+    const id = redis.seedReaction({ roomId: "room-2" });
+    redis.seedRoomReference("room-1", id, 10);
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issues).toEqual([{ reactionId: id, code: "wrong_room" }]);
+  });
+
+  it("reports an invalid timestamp before checking secondary indexes", async () => {
+    const id = redis.seedReaction({ timestamp: "bad-time", messageIndexed: false, userIndexed: false });
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issues).toEqual([{ reactionId: id, code: "invalid_timestamp" }]);
+  });
+
+  it("reports a timeline-only record as missing its room set index", async () => {
+    const id = redis.seedReaction({ roomIndexed: false });
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issues).toContainEqual({ reactionId: id, code: "missing_room_index" });
+  });
+
+  it("reports a room-set record missing from the timeline index", async () => {
+    const id = redis.seedReaction({ timelineIndexed: false });
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issues).toContainEqual({ reactionId: id, code: "missing_timeline_index" });
+  });
+
+  it("reports a stale timeline score", async () => {
+    const id = redis.seedReaction({ timelineScore: 1 });
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issues).toContainEqual({ reactionId: id, code: "stale_timeline_score" });
+  });
+
+  it("reports a missing message index", async () => {
+    const id = redis.seedReaction({ messageIndexed: false });
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issues).toContainEqual({ reactionId: id, code: "missing_message_index" });
+  });
+
+  it("reports a missing user-message index", async () => {
+    const id = redis.seedReaction({ userIndexed: false });
+
+    const result = await auditRoom("room-1");
+
+    expect(result.issues).toContainEqual({ reactionId: id, code: "missing_user_index" });
+  });
+
+  it("can report several index problems for one valid reaction", async () => {
+    const id = redis.seedReaction({
