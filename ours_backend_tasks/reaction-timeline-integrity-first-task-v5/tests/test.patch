+import { beforeEach, describe, expect, it, installFixedDate, runRegisteredTests } from "#ours/backend/gold_tests/gold_node_harness.test.ts";
+import {
+  FakeRedisClient,
+  getNodeClientMock,
+  invokeOperation,
+} from "#ours/backend/gold_tests/reaction_integrity_fixture.test.ts";
+
+const reactionOperations = await import("#ours/backend/session/operations/reactions.ts");
+
+
+interface RepairResult {
+  roomId: string;
+  beforeIssueCount: number;
+  repaired: number;
+  removed: number;
+  afterIssueCount: number;
+}
+
+const repairRoom = (roomId: string) =>
+  invokeOperation<RepairResult>(reactionOperations as Record<string, unknown>, "repairRoomReactionIntegrity", roomId);
+
+const auditRoom = (roomId: string) =>
+  invokeOperation<{ issueCount: number }>(reactionOperations as Record<string, unknown>, "auditRoomReactionIntegrity", roomId);
+
+let redis: FakeRedisClient;
+
+beforeEach(() => {
+  redis = new FakeRedisClient();
+  getNodeClientMock.mockResolvedValue(redis);
+});
+
+describe("Reaction index repair", () => {
+  it("leaves a healthy room unchanged", async () => {
+    redis.seedReaction();
+
+    const result = await repairRoom("room-1");
+
+    expect(result).toEqual({
+      roomId: "room-1",
+      beforeIssueCount: 0,
+      repaired: 0,
+      removed: 0,
+      afterIssueCount: 0,
+    });
+  });
+
+  it("removes a missing record from both room indexes", async () => {
+    redis.seedRoomReference("room-1", "missing-id", 10);
+
+    const result = await repairRoom("room-1");
+
+    expect(result.removed).toBe(1);
+    expect(redis.sets.get("room_reactions:room-1")?.has("missing-id")).toBe(false);
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.has("missing-id")).toBe(false);
+  });
+
+  it("removes a wrong-room record from the audited room without deleting its hash", async () => {
+    const id = redis.seedReaction({ roomId: "room-2" });
+    redis.seedRoomReference("room-1", id, 10);
+
+    await repairRoom("room-1");
+
+    expect(redis.sets.get("room_reactions:room-1")?.has(id)).toBe(false);
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.has(id)).toBe(false);
+    expect(redis.hashes.get(`reaction:${id}`)?.roomId).toBe("room-2");
+  });
+
+  it("removes an invalid-timestamp record from the room indexes", async () => {
+    const id = redis.seedReaction({ timestamp: "bad-time" });
+
+    const result = await repairRoom("room-1");
+
+    expect(result.removed).toBe(1);
+    expect(redis.sets.get("room_reactions:room-1")?.has(id)).toBe(false);
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.has(id)).toBe(false);
+  });
+
+  it("restores a missing room set index", async () => {
+    const id = redis.seedReaction({ roomIndexed: false });
+
+    const result = await repairRoom("room-1");
+
+    expect(result.repaired).toBe(1);
+    expect(redis.sets.get("room_reactions:room-1")?.has(id)).toBe(true);
+  });
+
+  it("restores a missing timeline index", async () => {
+    const id = redis.seedReaction({ timelineIndexed: false, timestamp: "2026-01-02T00:00:00.000Z" });
+
+    await repairRoom("room-1");
+
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.get(id)).toBe(
+      new Date("2026-01-02T00:00:00.000Z").getTime(),
+    );
+  });
+
+  it("corrects a stale timeline score from the hash timestamp", async () => {
+    const id = redis.seedReaction({ timestamp: "2026-01-02T00:00:00.000Z", timelineScore: 1 });
+
+    await repairRoom("room-1");
+
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.get(id)).toBe(
+      new Date("2026-01-02T00:00:00.000Z").getTime(),
+    );
+  });
+
+  it("restores a missing message index", async () => {
+    const id = redis.seedReaction({ messageId: "m-1", messageIndexed: false });
+
+    await repairRoom("room-1");
+
+    expect(redis.sets.get("message_reactions:m-1")?.has(id)).toBe(true);
+  });
+
+  it("restores a missing user-message index", async () => {
+    const id = redis.seedReaction({ messageId: "m-1", userId: "u-1", userIndexed: false });
+
+    await repairRoom("room-1");
+
+    expect(redis.sets.get("user_message_reactions:u-1:m-1")?.has(id)).toBe(true);
+  });
+
+  it("counts one repaired record even when several indexes were wrong", async () => {
+    redis.seedReaction({ roomIndexed: false, timelineScore: 1, messageIndexed: false, userIndexed: false });
+
+    const result = await repairRoom("room-1");
+
+    expect(result.beforeIssueCount).toBe(4);
+    expect(result.repaired).toBe(1);
+    expect(result.removed).toBe(0);
+    expect(result.afterIssueCount).toBe(0);
+  });
+
+  it("repairs several damaged records in one run", async () => {
+    const first = redis.seedReaction({ messageId: "m-1", userId: "u-1", messageIndexed: false });
+    const second = redis.seedReaction({ messageId: "m-2", userId: "u-2", timelineIndexed: false });
+
+    const result = await repairRoom("room-1");
+
+    expect(result.repaired).toBe(2);
+    expect(redis.sets.get("message_reactions:m-1")?.has(first)).toBe(true);
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.has(second)).toBe(true);
+    expect(result.afterIssueCount).toBe(0);
+  });
+
+  it("reports zero remaining issues after a successful repair", async () => {
+    redis.seedReaction({ messageIndexed: false, userIndexed: false, timelineScore: 1 });
+
+    const result = await repairRoom("room-1");
+
+    expect(result.afterIssueCount).toBe(0);
+    expect((await auditRoom("room-1")).issueCount).toBe(0);
+  });
+
+  it("is idempotent when run a second time", async () => {
+    redis.seedReaction({ messageIndexed: false });
+
+    await repairRoom("room-1");
+    const second = await repairRoom("room-1");
+
+    expect(second.beforeIssueCount).toBe(0);
+    expect(second.repaired).toBe(0);
+    expect(second.removed).toBe(0);
+    expect(second.afterIssueCount).toBe(0);
+  });
+
+  it("does not rewrite a valid reaction hash while repairing indexes", async () => {
+    const id = redis.seedReaction({ timestamp: "2026-01-02T00:00:00.000Z", messageIndexed: false });
+    const before = { ...redis.hashes.get(`reaction:${id}`) };
+
+    await repairRoom("room-1");
+
+    expect(redis.hashes.get(`reaction:${id}`)).toEqual(before);
+  });
+
+  it("does not add invalid records to message or user indexes", async () => {
+    const id = redis.seedReaction({
+      messageId: "m-1",
+      userId: "u-1",
+      timestamp: "bad-time",
+      messageIndexed: false,
+      userIndexed: false,
+    });
+
+    await repairRoom("room-1");
+
+    expect(redis.sets.get("message_reactions:m-1")?.has(id)).not.toBe(true);
+    expect(redis.sets.get("user_message_reactions:u-1:m-1")?.has(id)).not.toBe(true);
+  });
+
+  it("refreshing an existing reaction updates the timeline score with its new timestamp", async () => {
+    const id = redis.seedReaction({ timestamp: "2025-01-01T00:00:00.000Z", timelineScore: 1 });
+    const restoreDate = installFixedDate("2026-02-03T04:05:06.000Z");
+
+    await reactionOperations.addReaction("message-1", "user-1", "HEART", "room-1");
+
+    expect(redis.hashes.get(`reaction:${id}`)?.timestamp).toBe("2026-02-03T04:05:06.000Z");
+    expect(redis.sortedSets.get("room_reactions_by_time:room-1")?.get(id)).toBe(
+      new Date("2026-02-03T04:05:06.000Z").getTime(),
+    );
+    restoreDate();
+  });
+
+  it("refreshing an existing reaction keeps the stored room as canonical", async () => {
+    const id = redis.seedReaction({ roomId: "room-original" });
+    const restoreDate = installFixedDate("2026-02-03T04:05:06.000Z");
+
+    const result = await reactionOperations.addReaction("message-1", "user-1", "HEART", "room-other");
+
+    expect(result.roomId).toBe("room-original");
+    expect(redis.sortedSets.get("room_reactions_by_time:room-original")?.has(id)).toBe(true);
+    expect(redis.sortedSets.get("room_reactions_by_time:room-other")?.has(id)).not.toBe(true);
+    restoreDate();
+  });
+
+});
+
+await runRegisteredTests();
diff --git a/packages/backend/src/gold_tests/reaction_timeline_behavior.test.ts b/packages/backend/src/gold_tests/reaction_timeline_behavior.test.ts
