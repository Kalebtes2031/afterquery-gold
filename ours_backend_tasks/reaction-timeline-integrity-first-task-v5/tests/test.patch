diff --git a/packages/backend/src/gold_tests/gold_node_harness.test.ts b/packages/backend/src/gold_tests/gold_node_harness.test.ts
new file mode 100644
index 0000000..efef34c
--- /dev/null
+++ b/packages/backend/src/gold_tests/gold_node_harness.test.ts
@@ -0,0 +1,107 @@
+import assert from "node:assert/strict";
+import { isDeepStrictEqual } from "node:util";
+
+const tests = [];
+const beforeEachHooks = [];
+const suiteStack = [];
+
+export const describe = (name, body) => {
+  suiteStack.push(name);
+  try { body(); } finally { suiteStack.pop(); }
+};
+
+export const it = (name, body) => {
+  const prefix = suiteStack.join(" > ");
+  tests.push({ name: prefix ? `${prefix} > ${name}` : name, body });
+};
+
+export const beforeEach = (hook) => { beforeEachHooks.push(hook); };
+
+const check = (condition, message, negated) => {
+  const ok = negated ? !condition : condition;
+  if (!ok) throw new assert.AssertionError({ message });
+};
+
+const makeExpect = (actual, negated = false) => ({
+  toBe(expected) {
+    check(Object.is(actual, expected), `expected ${String(actual)} ${negated ? "not " : ""}to be ${String(expected)}`, negated);
+  },
+  toEqual(expected) {
+    check(isDeepStrictEqual(actual, expected), `expected values ${negated ? "not " : ""}to be deeply equal`, negated);
+  },
+  toContain(expected) {
+    const found = typeof actual?.includes === "function" && actual.includes(expected);
+    check(found, `expected value ${negated ? "not " : ""}to contain ${String(expected)}`, negated);
+  },
+  toContainEqual(expected) {
+    const found = Array.isArray(actual) && actual.some((value) => isDeepStrictEqual(value, expected));
+    check(found, `expected array ${negated ? "not " : ""}to contain deeply equal value`, negated);
+  },
+  toHaveLength(expected) {
+    check(actual != null && actual.length === expected, `expected length ${expected}, received ${actual?.length}`, negated);
+  },
+  toBeGreaterThan(expected) {
+    check(actual > expected, `expected ${actual} ${negated ? "not " : ""}to be greater than ${expected}`, negated);
+  },
+  toThrow(expected) {
+    let thrown;
+    try { actual(); } catch (error) { thrown = error; }
+    let matched = thrown !== undefined;
+    if (matched && typeof expected === "string") matched = String(thrown?.message ?? thrown).includes(expected);
+    if (matched && typeof expected === "function") matched = thrown instanceof expected;
+    check(matched, `expected function ${negated ? "not " : ""}to throw expected error`, negated);
+  },
+  get not() { return makeExpect(actual, !negated); },
+});
+
+export const expect = (actual) => makeExpect(actual);
+
+export const mockFunction = () => {
+  let implementation = () => undefined;
+  const fn = (...args) => {
+    fn.mock.calls.push(args);
+    return implementation(...args);
+  };
+  fn.mock = { calls: [] };
+  fn.mockResolvedValue = (value) => { implementation = () => Promise.resolve(value); return fn; };
+  fn.mockImplementation = (value) => { implementation = value; return fn; };
+  fn.mockClear = () => { fn.mock.calls.length = 0; return fn; };
+  return fn;
+};
+
+export const installFixedDate = (iso) => {
+  const RealDate = globalThis.Date;
+  const fixed = new RealDate(iso).getTime();
+  class FixedDate extends RealDate {
+    constructor(...args) { super(...(args.length ? args : [fixed])); }
+    static now() { return fixed; }
+  }
+  globalThis.Date = FixedDate;
+  return () => { globalThis.Date = RealDate; };
+};
+
+export const runRegisteredTests = async () => {
+  const results = [];
+  for (const test of tests) {
+    const started = Date.now();
+    try {
+      for (const hook of beforeEachHooks) await hook();
+      await test.body();
+      results.push({ name: test.name, status: "passed", duration: Date.now() - started });
+    } catch (error) {
+      results.push({
+        name: test.name,
+        status: "failed",
+        duration: Date.now() - started,
+        message: String(error?.stack ?? error),
+      });
+    }
+  }
+  const output = process.env.GOLD_RESULT_FILE;
+  if (!output) throw new Error("GOLD_RESULT_FILE is required");
+  const { writeFile } = await import("node:fs/promises");
+  await writeFile(output, `${JSON.stringify(results, null, 2)}\n`);
+  const passed = results.filter((item) => item.status === "passed").length;
+  console.log(`[gold-node] ${passed}/${results.length} passed`);
+  if (passed !== results.length) process.exitCode = 1;
+};
