+
+export const reactionIdFor = (messageId: string, userId: string, reaction: string) =>
+  createHash("sha256").update(`${messageId}:${userId}:${reaction}`).digest("hex").substring(0, 16);
+
+const cloneHash = (value: Record<string, string> | undefined) => ({ ...(value ?? {}) });
+
+const flattenStrings = (values: unknown[]) =>
+  values.flatMap((value) => (Array.isArray(value) ? value : [value])).map(String);
+
+const globMatches = (value: string, pattern = "*") => {
+  const expression = pattern
+    .replace(/[.+^${}()|\\]/g, "\\$&")
+    .replace(/\*/g, ".*")
+    .replace(/\?/g, ".");
+  return new RegExp(`^${expression}$`).test(value);
+};
+
+export class FakeRedisClient {
+  readonly hashes = new Map<string, Record<string, string>>();
+  readonly sets = new Map<string, Set<string>>();
+  readonly sortedSets = new Map<string, Map<string, number>>();
+
+  private setFor(key: string) {
+    const existing = this.sets.get(key);
+    if (existing) return existing;
+    const created = new Set<string>();
+    this.sets.set(key, created);
+    return created;
+  }
+
+  private sortedSetFor(key: string) {
+    const existing = this.sortedSets.get(key);
+    if (existing) return existing;
+    const created = new Map<string, number>();
+    this.sortedSets.set(key, created);
+    return created;
+  }
+
+  private allKeys() {
+    return Array.from(new Set([...this.hashes.keys(), ...this.sets.keys(), ...this.sortedSets.keys()])).sort();
+  }
+
+  private keyType(key: string) {
+    if (this.hashes.has(key)) return "hash";
+    if (this.sets.has(key)) return "set";
+    if (this.sortedSets.has(key)) return "zset";
+    return "none";
+  }
+
+  private sortedEntries(key: string, reverse = false) {
+    const entries = Array.from(this.sortedSets.get(key)?.entries() ?? []).sort((left, right) => {
+      const scoreDifference = left[1] - right[1];
+      if (scoreDifference !== 0) return scoreDifference;
+      return left[0].localeCompare(right[0]);
+    });
+    return reverse ? entries.reverse() : entries;
+  }
+
+  private sliceRange<T>(values: T[], start: number, stop: number) {
+    const from = start < 0 ? Math.max(0, values.length + start) : start;
+    const through = stop < 0 ? values.length + stop : stop;
+    if (through < from) return [];
+    return values.slice(from, through + 1);
+  }
+
+  async exists(...input: unknown[]) {
+    return flattenStrings(input).filter((key) => this.keyType(key) !== "none").length;
+  }
+
+  async type(key: string) {
+    return this.keyType(key);
+  }
+
+  async keys(pattern = "*") {
+    return this.allKeys().filter((key) => globMatches(key, pattern));
+  }
+
+  async scan(_cursor: string | number, options: { MATCH?: string; COUNT?: number; TYPE?: string } = {}) {
+    const keys = this.allKeys().filter((key) => {
+      if (options.MATCH && !globMatches(key, options.MATCH)) return false;
+      if (options.TYPE && this.keyType(key) !== options.TYPE) return false;
+      return true;
+    });
+    return { cursor: "0", keys };
+  }
+
+  async *scanIterator(options: { cursor?: string; MATCH?: string; COUNT?: number; TYPE?: string } = {}) {
+    const { keys } = await this.scan(options.cursor ?? "0", options);
+    if (keys.length > 0) yield keys;
+  }
+
+  async hGetAll(key: string) {
+    return cloneHash(this.hashes.get(key));
+  }
+
+  async hGet(key: string, field: string) {
+    return this.hashes.get(key)?.[field] ?? null;
+  }
+
+  async hMGet(key: string, ...input: unknown[]) {
+    const fields = flattenStrings(input);
+    return fields.map((field) => this.hashes.get(key)?.[field] ?? null);
+  }
+
+  async hmGet(key: string, ...input: unknown[]) {
+    return this.hMGet(key, ...input);
+  }
+
+  async hExists(key: string, field: string) {
+    return Object.hasOwn(this.hashes.get(key) ?? {}, field);
+  }
+
+  async hKeys(key: string) {
+    return Object.keys(this.hashes.get(key) ?? {});
+  }
+
+  async hSet(key: string, fieldOrValue: string | Record<string, string>, value?: string) {
+    const current = cloneHash(this.hashes.get(key));
+    if (typeof fieldOrValue === "string") {
+      current[fieldOrValue] = value ?? "";
+    } else {
+      Object.assign(current, fieldOrValue);
+    }
+    this.hashes.set(key, current);
+    return 1;
+  }
+
+  async hScan(key: string, _cursor: string | number, options: { MATCH?: string; COUNT?: number } = {}) {
+    const entries = Object.entries(this.hashes.get(key) ?? {})
+      .filter(([field]) => !options.MATCH || globMatches(field, options.MATCH))
+      .map(([field, value]) => ({ field, value }));
+    return { cursor: "0", entries };
+  }
+
+  async *hScanIterator(key: string, options: { cursor?: string; MATCH?: string; COUNT?: number } = {}) {
+    const { entries } = await this.hScan(key, options.cursor ?? "0", options);
+    if (entries.length > 0) yield entries;
+  }
+
+  async sMembers(key: string) {
+    return Array.from(this.sets.get(key) ?? []);
+  }
+
+  async sIsMember(key: string, value: string) {
+    return this.sets.get(key)?.has(value) ?? false;
+  }
+
+  async sMIsMember(key: string, ...input: unknown[]) {
+    return flattenStrings(input).map((value) => this.sets.get(key)?.has(value) ?? false);
+  }
+
+  async sCard(key: string) {
+    return this.sets.get(key)?.size ?? 0;
+  }
+
+  async sAdd(key: string, ...input: unknown[]) {
+    const set = this.setFor(key);
+    const before = set.size;
+    for (const value of flattenStrings(input)) set.add(value);
+    return set.size - before;
+  }
+
+  async sRem(key: string, ...input: unknown[]) {
+    let removed = 0;
+    const set = this.sets.get(key);
+    for (const value of flattenStrings(input)) {
+      if (set?.delete(value)) removed += 1;
+    }
+    return removed;
+  }
+
+  async sScan(key: string, _cursor: string | number, options: { MATCH?: string; COUNT?: number } = {}) {
+    const members = Array.from(this.sets.get(key) ?? []).filter(
+      (value) => !options.MATCH || globMatches(value, options.MATCH),
+    );
+    return { cursor: "0", members };
+  }
+
+  async *sScanIterator(key: string, options: { cursor?: string; MATCH?: string; COUNT?: number } = {}) {
+    const { members } = await this.sScan(key, options.cursor ?? "0", options);
+    if (members.length > 0) yield members;
+  }
+
+  async zAdd(key: string, ...input: unknown[]) {
+    const entries = input.flatMap((value) => (Array.isArray(value) ? value : [value])) as Array<{
+      score: number;
+      value: string;
+    }>;
+    const set = this.sortedSetFor(key);
+    let added = 0;
+    for (const entry of entries) {
+      if (!set.has(entry.value)) added += 1;
+      set.set(entry.value, Number(entry.score));
+    }
+    return added;
+  }
+
+  async zRem(key: string, ...input: unknown[]) {
+    let removed = 0;
+    const set = this.sortedSets.get(key);
+    for (const value of flattenStrings(input)) {
+      if (set?.delete(value)) removed += 1;
+    }
+    return removed;
+  }
+
+  async zScore(key: string, value: string) {
+    return this.sortedSets.get(key)?.get(value) ?? null;
+  }
+
+  async zMScore(key: string, ...input: unknown[]) {
+    return flattenStrings(input).map((value) => this.sortedSets.get(key)?.get(value) ?? null);
+  }
+
+  async zCard(key: string) {
+    return this.sortedSets.get(key)?.size ?? 0;
+  }
+
+  async zRange(key: string, start: number, stop: number, options?: { REV?: boolean }) {
+    return this.sliceRange(this.sortedEntries(key, options?.REV), start, stop).map(([value]) => value);
+  }
+
+  async zRangeWithScores(key: string, start: number, stop: number, options?: { REV?: boolean }) {
+    return this.sliceRange(this.sortedEntries(key, options?.REV), start, stop).map(([value, score]) => ({ value, score }));
+  }
+
+  async zScan(key: string, _cursor: string | number, options: { MATCH?: string; COUNT?: number } = {}) {
+    const members = this.sortedEntries(key)
+      .filter(([value]) => !options.MATCH || globMatches(value, options.MATCH))
+      .map(([value, score]) => ({ value, score }));
+    return { cursor: "0", members };
+  }
+
+  async *zScanIterator(key: string, options: { cursor?: string; MATCH?: string; COUNT?: number } = {}) {
+    const { members } = await this.zScan(key, options.cursor ?? "0", options);
+    if (members.length > 0) yield members;
+  }
+
+  async del(...input: unknown[]) {
+    let removed = 0;
+    for (const key of flattenStrings(input)) {
+      const existed = this.keyType(key) !== "none";
+      this.hashes.delete(key);
+      this.sets.delete(key);
+      this.sortedSets.delete(key);
+      if (existed) removed += 1;
+    }
+    return removed;
+  }
+
+  async unlink(...input: unknown[]) {
+    return this.del(...input);
+  }
+
+  multi() {
+    const commands: Array<{ command: string; args: unknown[] }> = [];
+    const queue = (command: string, args: unknown[]) => {
+      commands.push({ command, args });
+      return pipeline;
+    };
+    const pipeline = {
+      exists: (...args: unknown[]) => queue("exists", args),
+      type: (...args: unknown[]) => queue("type", args),
+      keys: (...args: unknown[]) => queue("keys", args),
+      scan: (...args: unknown[]) => queue("scan", args),
+      hGetAll: (...args: unknown[]) => queue("hGetAll", args),
+      hGet: (...args: unknown[]) => queue("hGet", args),
+      hMGet: (...args: unknown[]) => queue("hMGet", args),
+      hmGet: (...args: unknown[]) => queue("hMGet", args),
+      hExists: (...args: unknown[]) => queue("hExists", args),
+      hKeys: (...args: unknown[]) => queue("hKeys", args),
+      hSet: (...args: unknown[]) => queue("hSet", args),
+      hScan: (...args: unknown[]) => queue("hScan", args),
+      sMembers: (...args: unknown[]) => queue("sMembers", args),
+      sIsMember: (...args: unknown[]) => queue("sIsMember", args),
+      sMIsMember: (...args: unknown[]) => queue("sMIsMember", args),
+      sCard: (...args: unknown[]) => queue("sCard", args),
+      sAdd: (...args: unknown[]) => queue("sAdd", args),
+      sRem: (...args: unknown[]) => queue("sRem", args),
+      sScan: (...args: unknown[]) => queue("sScan", args),
+      zAdd: (...args: unknown[]) => queue("zAdd", args),
+      zRem: (...args: unknown[]) => queue("zRem", args),
+      zScore: (...args: unknown[]) => queue("zScore", args),
+      zMScore: (...args: unknown[]) => queue("zMScore", args),
+      zCard: (...args: unknown[]) => queue("zCard", args),
+      zRange: (...args: unknown[]) => queue("zRange", args),
+      zRangeWithScores: (...args: unknown[]) => queue("zRangeWithScores", args),
+      zScan: (...args: unknown[]) => queue("zScan", args),
+      del: (...args: unknown[]) => queue("del", args),
+      unlink: (...args: unknown[]) => queue("unlink", args),
+      exec: async () => {
+        const results: unknown[] = [];
+        for (const entry of commands) results.push(await this.execute(entry.command, entry.args));
+        return results;
+      },
+    };
+    return pipeline;
+  }
+
+  private async execute(command: string, args: unknown[]) {
+    const candidate = (this as unknown as Record<string, unknown>)[command];
+    if (typeof candidate !== "function") throw new Error(`Unsupported fake Redis command: ${command}`);
+    return candidate.apply(this, args);
+  }
+
+  seedReaction(options: SeedReactionOptions = {}) {
+    const messageId = options.messageId ?? "message-1";
+    const userId = options.userId ?? "user-1";
+    const reaction = options.reaction ?? "HEART";
+    const roomId = options.roomId ?? "room-1";
+    const timestamp = options.timestamp ?? "2026-01-01T00:00:00.000Z";
+    const reactionId = reactionIdFor(messageId, userId, reaction);
+    this.hashes.set(`reaction:${reactionId}`, { messageId, userId, reaction, roomId, timestamp });
+
+    if (options.roomIndexed ?? true) this.setFor(`room_reactions:${roomId}`).add(reactionId);
+    if (options.timelineIndexed ?? true) {
+      const score = options.timelineScore ?? new Date(timestamp).getTime();
+      this.sortedSetFor(`room_reactions_by_time:${roomId}`).set(reactionId, score);
+    }
+    if (options.messageIndexed ?? true) this.setFor(`message_reactions:${messageId}`).add(reactionId);
+    if (options.userIndexed ?? true) this.setFor(`user_message_reactions:${userId}:${messageId}`).add(reactionId);
+    return reactionId;
+  }
+
+  seedRoomReference(roomId: string, reactionId: string, timelineScore = 1) {
+    this.setFor(`room_reactions:${roomId}`).add(reactionId);
+    this.sortedSetFor(`room_reactions_by_time:${roomId}`).set(reactionId, timelineScore);
+  }
+}
+
+export const invokeOperation = async <T>(module: Record<string, unknown>, name: string, ...args: unknown[]) => {
+  const candidate = module[name];
+  if (typeof candidate !== "function") throw new Error(`Missing operation: ${name}`);
+  return (await candidate(...args)) as T;
+};
