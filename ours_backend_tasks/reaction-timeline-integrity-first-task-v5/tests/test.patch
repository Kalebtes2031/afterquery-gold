+import { createHash } from "node:crypto";
+import { mock } from "node:test";
+import { mockFunction } from "#ours/backend/gold_tests/gold_node_harness.test.ts";
+
+export const getNodeClientMock = mockFunction();
+
+mock.module("#ours/backend/session/redis.ts", {
+  namedExports: {
+    getNodeClient: (...args: unknown[]) => getNodeClientMock(...args),
+  },
+});
+
+export interface SeedReactionOptions {
+  messageId?: string;
+  userId?: string;
+  reaction?: string;
+  roomId?: string;
+  timestamp?: string;
+  roomIndexed?: boolean;
+  timelineIndexed?: boolean;
+  messageIndexed?: boolean;
+  userIndexed?: boolean;
