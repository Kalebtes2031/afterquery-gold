diff --git a/packages/backend/src/gold_tests/presence_audit_behavior.test.ts b/packages/backend/src/gold_tests/presence_audit_behavior.test.ts
new file mode 100644
index 0000000..7d55bee
--- /dev/null
+++ b/packages/backend/src/gold_tests/presence_audit_behavior.test.ts
@@ -0,0 +1,214 @@
+import { describe, expect, it } from "vitest";
+import {
+  PresenceReconciliationService,
+  auditChannelPresence,
+} from "#ours/backend/services/presence_reconciliation_service.ts";
+import type { PresenceStore } from "#ours/backend/services/presence_reconciliation_types.ts";
+import type { UserSession } from "#ours/backend/session/types.ts";
+
+const user = (nickname: string, channelId: string): UserSession => ({
+  sessionId: `session-${nickname}`,
+  nickname,
+  userType: "temporary",
+  channelId,
+  joinedAt: 1000,
+  lastActivity: 2000,
+  chatUserId: `chat-${nickname}`,
+  connectionStatus: "active",
+});
+
+class FakePresenceStore implements PresenceStore {
+  readonly channels = new Map<string, Set<string>>();
+  readonly users = new Map<string, { session: UserSession | null; ttl: number }>();
+
+  channel(channelId: string, ...nicknames: string[]): this {
+    this.channels.set(channelId, new Set(nicknames));
+    return this;
+  }
+
+  session(nickname: string, channelId: string, ttl = 1200): this {
+    this.users.set(nickname, { session: user(nickname, channelId), ttl });
+    return this;
+  }
+
+  malformed(nickname: string): this {
+    this.users.set(nickname, { session: null, ttl: 1200 });
+    return this;
+  }
+
+  async listChannelIds(): Promise<string[]> {
+    return [...this.channels.keys()];
+  }
+
+  async listUserNicknames(): Promise<string[]> {
+    return [...this.users.keys()];
+  }
+
+  async getChannelUsers(channelId: string): Promise<string[]> {
+    return [...(this.channels.get(channelId) ?? new Set<string>())];
+  }
+
+  async getUserByNickname(nickname: string): Promise<UserSession | null> {
+    return this.users.get(nickname)?.session ?? null;
+  }
+
+  async getUserTtl(nickname: string): Promise<number> {
+    return this.users.get(nickname)?.ttl ?? -2;
+  }
+
+  async addUserToChannel(channelId: string, nickname: string): Promise<void> {
+    const members = this.channels.get(channelId) ?? new Set<string>();
+    members.add(nickname);
+    this.channels.set(channelId, members);
+  }
+
+  async removeUserFromChannel(channelId: string, nickname: string): Promise<void> {
+    this.channels.get(channelId)?.delete(nickname);
+  }
+
+  async ensureUserTtl(nickname: string, ttlSeconds = 1800): Promise<boolean> {
+    const record = this.users.get(nickname);
+    if (!record || record.ttl !== -1) return false;
+    record.ttl = ttlSeconds;
+    return true;
+  }
+}
+
+const zeroCounts = {
+  missing_session: 0,
+  channel_mismatch: 0,
+  missing_membership: 0,
+  missing_session_ttl: 0,
+};
+
+describe("Channel presence audit", () => {
+  it("reports a healthy channel with matching sessions and memberships", async () => {
+    const store = new FakePresenceStore().channel("c1", "alice").session("alice", "c1");
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit).toEqual({
+      channelId: "c1",
+      memberCount: 1,
+      sessionCount: 1,
+      validCount: 1,
+      healthy: true,
+      issueCounts: zeroCounts,
+      issues: [],
+    });
+  });
+
+  it("keeps every issue counter present when the channel is healthy", async () => {
+    const audit = await new PresenceReconciliationService(new FakePresenceStore()).auditChannel("c1");
+    expect(audit.issueCounts).toEqual(zeroCounts);
+  });
+
+  it("reports a member whose session is missing", async () => {
+    const store = new FakePresenceStore().channel("c1", "ghost");
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([{ nickname: "ghost", code: "missing_session" }]);
+    expect(audit.issueCounts.missing_session).toBe(1);
+  });
+
+  it("reports a member whose session points at another channel", async () => {
+    const store = new FakePresenceStore().channel("c1", "alice").session("alice", "c2");
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([
+      { nickname: "alice", code: "channel_mismatch", sessionChannelId: "c2" },
+    ]);
+  });
+
+  it("reports a session that claims the channel but is absent from its member set", async () => {
+    const store = new FakePresenceStore().session("alice", "c1");
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([{ nickname: "alice", code: "missing_membership" }]);
+    expect(audit.sessionCount).toBe(1);
+    expect(audit.validCount).toBe(0);
+  });
+
+  it("reports a channel session that has no Redis expiry", async () => {
+    const store = new FakePresenceStore().channel("c1", "alice").session("alice", "c1", -1);
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([{ nickname: "alice", code: "missing_session_ttl" }]);
+    expect(audit.validCount).toBe(1);
+  });
+
+  it("can report missing membership and missing ttl for the same session", async () => {
+    const store = new FakePresenceStore().session("alice", "c1", -1);
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([
+      { nickname: "alice", code: "missing_membership" },
+      { nickname: "alice", code: "missing_session_ttl" },
+    ]);
+  });
+
+  it("sorts issues by nickname and then by the stable issue-code order", async () => {
+    const store = new FakePresenceStore()
+      .channel("c1", "zoe", "bob")
+      .session("amy", "c1", -1)
+      .session("bob", "c2")
+      .malformed("zoe");
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([
+      { nickname: "amy", code: "missing_membership" },
+      { nickname: "amy", code: "missing_session_ttl" },
+      { nickname: "bob", code: "channel_mismatch", sessionChannelId: "c2" },
+      { nickname: "zoe", code: "missing_session" },
+    ]);
+  });
+
+  it("counts members sessions and valid memberships independently", async () => {
+    const store = new FakePresenceStore()
+      .channel("c1", "alice", "bob", "ghost")
+      .session("alice", "c1")
+      .session("bob", "c2")
+      .session("carol", "c1");
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect({ memberCount: audit.memberCount, sessionCount: audit.sessionCount, validCount: audit.validCount }).toEqual({
+      memberCount: 3,
+      sessionCount: 2,
+      validCount: 1,
+    });
+  });
+
+  it("tracks totals for every issue code", async () => {
+    const store = new FakePresenceStore()
+      .channel("c1", "ghost", "bob")
+      .session("bob", "c2")
+      .session("alice", "c1", -1);
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issueCounts).toEqual({
+      missing_session: 1,
+      channel_mismatch: 1,
+      missing_membership: 1,
+      missing_session_ttl: 1,
+    });
+    expect(audit.healthy).toBe(false);
+  });
+
+  it("does not treat an unreadable unindexed user key as a channel issue", async () => {
+    const store = new FakePresenceStore().malformed("orphan");
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([]);
+    expect(audit.healthy).toBe(true);
+  });
+
+  it("does not report ttl drift for a session owned by another channel", async () => {
+    const store = new FakePresenceStore().channel("c1", "alice").session("alice", "c2", -1);
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.issues).toEqual([
+      { nickname: "alice", code: "channel_mismatch", sessionChannelId: "c2" },
+    ]);
+  });
+
+  it("deduplicates channel members before calculating counts", async () => {
+    const store = new FakePresenceStore().session("alice", "c1");
+    store.getChannelUsers = async () => ["alice", "alice", "alice"];
+    const audit = await new PresenceReconciliationService(store).auditChannel("c1");
+    expect(audit.memberCount).toBe(1);
+    expect(audit.validCount).toBe(1);
+  });
+
+  it("supports the auditChannelPresence convenience function", async () => {
+    const store = new FakePresenceStore().channel("c1", "alice").session("alice", "c1");
+    await expect(auditChannelPresence("c1", store)).resolves.toMatchObject({ channelId: "c1", healthy: true });
+  });
+});
diff --git a/packages/backend/src/gold_tests/presence_default_store_behavior.test.ts b/packages/backend/src/gold_tests/presence_default_store_behavior.test.ts
