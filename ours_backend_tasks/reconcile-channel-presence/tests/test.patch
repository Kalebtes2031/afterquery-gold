+import { describe, expect, it } from "vitest";
+import {
+  PresenceReconciliationService,
+  auditPresenceChannels,
+  repairPresenceChannels,
+} from "#ours/backend/services/presence_reconciliation_service.ts";
+import type { PresenceStore } from "#ours/backend/services/presence_reconciliation_types.ts";
+import type { UserSession } from "#ours/backend/session/types.ts";
+
+const user = (nickname: string, channelId: string): UserSession => ({
+  sessionId: `session-${nickname}`,
+  nickname,
+  userType: "temporary",
+  channelId,
+  joinedAt: 1000,
+  lastActivity: 2000,
+  chatUserId: `chat-${nickname}`,
+  connectionStatus: "active",
+});
+
+class FakePresenceStore implements PresenceStore {
+  readonly channels = new Map<string, Set<string>>();
+  readonly users = new Map<string, { session: UserSession | null; ttl: number }>();
+
+  channel(channelId: string, ...nicknames: string[]): this { this.channels.set(channelId, new Set(nicknames)); return this; }
+  session(nickname: string, channelId: string, ttl = 1200): this { this.users.set(nickname, { session: user(nickname, channelId), ttl }); return this; }
+  async listChannelIds(): Promise<string[]> { return [...this.channels.keys()]; }
+  async listUserNicknames(): Promise<string[]> { return [...this.users.keys()]; }
+  async getChannelUsers(channelId: string): Promise<string[]> { return [...(this.channels.get(channelId) ?? new Set())]; }
+  async getUserByNickname(nickname: string): Promise<UserSession | null> { return this.users.get(nickname)?.session ?? null; }
+  async getUserTtl(nickname: string): Promise<number> { return this.users.get(nickname)?.ttl ?? -2; }
+  async addUserToChannel(channelId: string, nickname: string): Promise<void> { const set = this.channels.get(channelId) ?? new Set<string>(); set.add(nickname); this.channels.set(channelId, set); }
+  async removeUserFromChannel(channelId: string, nickname: string): Promise<void> { this.channels.get(channelId)?.delete(nickname); }
+  async ensureUserTtl(nickname: string, ttlSeconds = 1800): Promise<boolean> { const record = this.users.get(nickname); if (!record || record.ttl !== -1) return false; record.ttl = ttlSeconds; return true; }
+}
+
+describe("Presence reconciliation sweeps", () => {
+  it("audits tracked channels in lexical order", async () => {
+    const store = new FakePresenceStore().channel("z-room").channel("a-room");
+    const sweep = await new PresenceReconciliationService(store).auditAllChannels();
+    expect(sweep.channels.map((channel) => channel.channelId)).toEqual(["a-room", "z-room"]);
+  });
+
+  it("discovers a channel that exists only in a user session", async () => {
+    const store = new FakePresenceStore().session("alice", "session-only");
+    const sweep = await new PresenceReconciliationService(store).auditAllChannels();
+    expect(sweep.channels.map((channel) => channel.channelId)).toEqual(["session-only"]);
+    expect(sweep.channels[0]?.issues).toEqual([{ nickname: "alice", code: "missing_membership" }]);
+  });
+
+  it("deduplicates channels found from sets and sessions", async () => {
+    const store = new FakePresenceStore().channel("c1", "alice").session("alice", "c1");
+    const sweep = await new PresenceReconciliationService(store).auditAllChannels();
+    expect(sweep.summary.channelCount).toBe(1);
+  });
+
+  it("returns an empty zeroed summary when there are no channels", async () => {
+    const sweep = await new PresenceReconciliationService(new FakePresenceStore()).auditAllChannels();
+    expect(sweep).toEqual({
+      channels: [],
+      summary: {
+        channelCount: 0,
+        healthyChannels: 0,
+        unhealthyChannels: 0,
+        issueCount: 0,
+        issueCounts: {
+          missing_session: 0,
+          channel_mismatch: 0,
+          missing_membership: 0,
+          missing_session_ttl: 0,
+        },
+      },
+    });
+  });
+
+  it("summarizes healthy and unhealthy channels", async () => {
+    const store = new FakePresenceStore()
+      .channel("c1", "alice")
+      .channel("c2", "ghost")
+      .session("alice", "c1");
+    const sweep = await new PresenceReconciliationService(store).auditAllChannels();
+    expect(sweep.summary.healthyChannels).toBe(1);
+    expect(sweep.summary.unhealthyChannels).toBe(1);
+    expect(sweep.summary.issueCount).toBe(1);
+  });
+
+  it("aggregates issue counts across channels", async () => {
+    const store = new FakePresenceStore().channel("c1", "ghost").session("alice", "c2", -1);
+    const sweep = await new PresenceReconciliationService(store).auditAllChannels();
+    expect(sweep.summary.issueCounts).toEqual({
+      missing_session: 1,
+      channel_mismatch: 0,
+      missing_membership: 1,
+      missing_session_ttl: 1,
+    });
+  });
+
+  it("auditChannels sorts and deduplicates an explicit channel selection", async () => {
+    const store = new FakePresenceStore().channel("b").channel("a").channel("ignored");
+    const sweep = await new PresenceReconciliationService(store).auditChannels(["b", "a", "b", ""]);
+    expect(sweep.channels.map((channel) => channel.channelId)).toEqual(["a", "b"]);
+    expect(sweep.summary.channelCount).toBe(2);
+  });
+
+  it("repairAllChannels moves a mismatched user to the channel named by its session", async () => {
+    const store = new FakePresenceStore().channel("old", "alice").session("alice", "new");
+    const sweep = await new PresenceReconciliationService(store).repairAllChannels();
+    expect(await store.getChannelUsers("old")).toEqual([]);
+    expect(await store.getChannelUsers("new")).toEqual(["alice"]);
+    expect(sweep.summary.remainingIssues).toBe(0);
+  });
+
+  it("counts one repaired user across several channel repairs", async () => {
+    const store = new FakePresenceStore().channel("old", "alice").session("alice", "new", -1);
+    const sweep = await new PresenceReconciliationService(store).repairAllChannels();
+    expect(sweep.summary.repairedChannels).toBe(2);
+    expect(sweep.summary.repairedUsers).toBe(1);
+  });
+
+  it("reports remaining issue counts after all repairs finish", async () => {
+    const store = new FakePresenceStore().channel("c1", "ghost").session("alice", "c2", -1);
+    const sweep = await new PresenceReconciliationService(store).repairAllChannels();
+    expect(sweep.summary.remainingIssues).toBe(0);
+    expect(sweep.summary.issueCounts).toEqual({
+      missing_session: 0,
+      channel_mismatch: 0,
+      missing_membership: 0,
+      missing_session_ttl: 0,
+    });
+  });
+
+  it("repairChannels touches only the explicit channel selection", async () => {
+    const store = new FakePresenceStore().channel("a", "ghost-a").channel("b", "ghost-b");
+    const sweep = await new PresenceReconciliationService(store).repairChannels(["a"]);
+    expect(sweep.repairs.map((repair) => repair.channelId)).toEqual(["a"]);
+    expect(await store.getChannelUsers("a")).toEqual([]);
+    expect(await store.getChannelUsers("b")).toEqual(["ghost-b"]);
+  });
+
+  it("supports the batch convenience functions", async () => {
+    const store = new FakePresenceStore().channel("c1", "ghost");
+    const audit = await auditPresenceChannels(["c1"], store);
+    expect(audit.summary.issueCount).toBe(1);
+    const repair = await repairPresenceChannels(["c1"], store);
+    expect(repair.summary.repairedUsers).toBe(1);
+    expect(repair.summary.remainingIssues).toBe(0);
+  });
+});
