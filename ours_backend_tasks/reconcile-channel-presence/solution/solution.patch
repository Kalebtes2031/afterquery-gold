+import type { UserSession } from "#ours/backend/session/types.ts";
+
+export const PRESENCE_ISSUE_CODES = [
+  "missing_session",
+  "channel_mismatch",
+  "missing_membership",
+  "missing_session_ttl",
+] as const;
+
+export type PresenceIssueCode = (typeof PRESENCE_ISSUE_CODES)[number];
+
+export interface PresenceIssue {
+  nickname: string;
+  code: PresenceIssueCode;
+  sessionChannelId?: string;
+}
+
+export type PresenceIssueCounts = Record<PresenceIssueCode, number>;
+
+export interface ChannelPresenceAudit {
+  channelId: string;
+  memberCount: number;
+  sessionCount: number;
+  validCount: number;
+  healthy: boolean;
+  issueCounts: PresenceIssueCounts;
+  issues: PresenceIssue[];
+}
+
+export interface ChannelPresenceRepair {
+  channelId: string;
+  removed: string[];
+  added: string[];
+  ttlFixed: string[];
+  repairedUsers: number;
+  before: ChannelPresenceAudit;
+  after: ChannelPresenceAudit;
+}
+
+export interface PresenceSweepSummary {
+  channelCount: number;
+  healthyChannels: number;
+  unhealthyChannels: number;
+  issueCount: number;
+  issueCounts: PresenceIssueCounts;
+}
+
+export interface PresenceAuditSweep {
+  channels: ChannelPresenceAudit[];
+  summary: PresenceSweepSummary;
+}
+
+export interface PresenceRepairSweepSummary {
+  channelCount: number;
+  repairedChannels: number;
+  repairedUsers: number;
+  remainingIssues: number;
+  issueCounts: PresenceIssueCounts;
+}
+
+export interface PresenceRepairSweep {
+  repairs: ChannelPresenceRepair[];
+  summary: PresenceRepairSweepSummary;
+}
+
+export interface PresenceStore {
+  listChannelIds(): Promise<string[]>;
+  listUserNicknames(): Promise<string[]>;
+  getChannelUsers(channelId: string): Promise<string[]>;
+  getUserByNickname(nickname: string): Promise<UserSession | null>;
+  getUserTtl(nickname: string): Promise<number>;
+  addUserToChannel(channelId: string, nickname: string): Promise<void>;
+  removeUserFromChannel(channelId: string, nickname: string): Promise<void>;
+  ensureUserTtl(nickname: string, ttlSeconds?: number): Promise<boolean>;
+}
+
+export function createEmptyPresenceIssueCounts(): PresenceIssueCounts {
+  return {
+    missing_session: 0,
+    channel_mismatch: 0,
+    missing_membership: 0,
+    missing_session_ttl: 0,
+  };
+}
