+import * as session from "#ours/backend/session/index.ts";
+import type { UserSession } from "#ours/backend/session/types.ts";
+import type { PresenceStore } from "#ours/backend/services/presence_reconciliation_types.ts";
+
+export class RedisPresenceStore implements PresenceStore {
+  async listChannelIds(): Promise<string[]> {
+    return await session.users.listChannelIds();
+  }
+
+  async listUserNicknames(): Promise<string[]> {
+    return await session.users.listUserNicknames();
+  }
+
+  async getChannelUsers(channelId: string): Promise<string[]> {
+    return await session.users.getChannelUsers(channelId);
+  }
+
+  async getUserByNickname(nickname: string): Promise<UserSession | null> {
+    return await session.users.getUserByNickname(nickname);
+  }
+
+  async getUserTtl(nickname: string): Promise<number> {
+    return await session.users.getUserTtl(nickname);
+  }
+
+  async addUserToChannel(channelId: string, nickname: string): Promise<void> {
+    await session.users.addUserToChannel(channelId, nickname);
+  }
+
+  async removeUserFromChannel(channelId: string, nickname: string): Promise<void> {
+    await session.users.removeUserFromChannel(channelId, nickname);
+  }
+
+  async ensureUserTtl(nickname: string, ttlSeconds?: number): Promise<boolean> {
+    return await session.users.ensureUserTtl(nickname, ttlSeconds);
+  }
+}
+
+export function createRedisPresenceStore(): PresenceStore {
+  return new RedisPresenceStore();
+}
