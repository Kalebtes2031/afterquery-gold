diff --git a/packages/backend/src/services/presence_reconciliation_service.ts b/packages/backend/src/services/presence_reconciliation_service.ts
new file mode 100644
index 0000000..105fbec
--- /dev/null
+++ b/packages/backend/src/services/presence_reconciliation_service.ts
@@ -0,0 +1,238 @@
+import type { UserSession } from "#ours/backend/session/types.ts";
+import { createRedisPresenceStore } from "#ours/backend/services/redis_presence_store.ts";
+import {
+  createEmptyPresenceIssueCounts,
+  type ChannelPresenceAudit,
+  type ChannelPresenceRepair,
+  type PresenceAuditSweep,
+  type PresenceIssue,
+  type PresenceRepairSweep,
+  type PresenceStore,
+} from "#ours/backend/services/presence_reconciliation_types.ts";
+import {
+  addPresenceIssueCounts,
+  repairedNicknames as listRepairedNicknames,
+  sortPresenceIssues,
+  totalPresenceIssues,
+  uniquePresenceValues,
+  countPresenceIssues,
+} from "#ours/backend/services/presence_reconciliation_utils.ts";
+
+const DEFAULT_SESSION_TTL_SECONDS = 1800;
+
+export class PresenceReconciliationService {
+  private readonly store: PresenceStore;
+
+  constructor(store: PresenceStore = createRedisPresenceStore()) {
+    this.store = store;
+  }
+
+  private async loadSessions(nicknames: string[]): Promise<Map<string, UserSession | null>> {
+    const sessions = new Map<string, UserSession | null>();
+    for (const nickname of nicknames) {
+      sessions.set(nickname, await this.store.getUserByNickname(nickname));
+    }
+    return sessions;
+  }
+
+  private async discoverChannelIds(): Promise<string[]> {
+    const trackedChannels = await this.store.listChannelIds();
+    const nicknames = uniquePresenceValues(await this.store.listUserNicknames());
+    const channelIds = new Set(trackedChannels);
+
+    for (const nickname of nicknames) {
+      const user = await this.store.getUserByNickname(nickname);
+      if (user?.channelId) channelIds.add(user.channelId);
+    }
+
+    return uniquePresenceValues(channelIds);
+  }
+
+  async auditChannel(channelId: string): Promise<ChannelPresenceAudit> {
+    const members = uniquePresenceValues(await this.store.getChannelUsers(channelId));
+    const memberSet = new Set(members);
+    const storedNicknames = uniquePresenceValues(await this.store.listUserNicknames());
+    const candidates = uniquePresenceValues([...members, ...storedNicknames]);
+    const sessions = await this.loadSessions(candidates);
+    const issues: PresenceIssue[] = [];
+    let sessionCount = 0;
+    let validCount = 0;
+
+    for (const nickname of candidates) {
+      const user = sessions.get(nickname) ?? null;
+      const isMember = memberSet.has(nickname);
+
+      if (isMember && !user) {
+        issues.push({ nickname, code: "missing_session" });
+        continue;
+      }
+
+      if (isMember && user && user.channelId !== channelId) {
+        issues.push({
+          nickname,
+          code: "channel_mismatch",
+          sessionChannelId: user.channelId,
+        });
+      }
+
+      if (user?.channelId !== channelId) continue;
+
+      sessionCount += 1;
+      if (isMember) validCount += 1;
+      else issues.push({ nickname, code: "missing_membership" });
+
+      const ttl = await this.store.getUserTtl(nickname);
+      if (ttl === -1) issues.push({ nickname, code: "missing_session_ttl" });
+    }
+
+    const sortedIssues = sortPresenceIssues(issues);
+    const issueCounts = countPresenceIssues(sortedIssues);
+
+    return {
+      channelId,
+      memberCount: members.length,
+      sessionCount,
+      validCount,
+      healthy: sortedIssues.length === 0,
+      issueCounts,
+      issues: sortedIssues,
+    };
+  }
+
+  async repairChannel(channelId: string): Promise<ChannelPresenceRepair> {
+    const before = await this.auditChannel(channelId);
+    const removed = new Set<string>();
+    const added = new Set<string>();
+    const ttlFixed = new Set<string>();
+
+    for (const issue of before.issues) {
+      switch (issue.code) {
+        case "missing_session":
+        case "channel_mismatch":
+          if (!removed.has(issue.nickname)) {
+            await this.store.removeUserFromChannel(channelId, issue.nickname);
+            removed.add(issue.nickname);
+          }
+          break;
+        case "missing_membership":
+          if (!added.has(issue.nickname)) {
+            await this.store.addUserToChannel(channelId, issue.nickname);
+            added.add(issue.nickname);
+          }
+          break;
+        case "missing_session_ttl":
+          if (!ttlFixed.has(issue.nickname)) {
+            const fixed = await this.store.ensureUserTtl(issue.nickname, DEFAULT_SESSION_TTL_SECONDS);
+            if (fixed) ttlFixed.add(issue.nickname);
+          }
+          break;
+      }
+    }
+
+    const after = await this.auditChannel(channelId);
+    const repairedNicknames = new Set([...removed, ...added, ...ttlFixed]);
+
+    return {
+      channelId,
+      removed: uniquePresenceValues(removed),
+      added: uniquePresenceValues(added),
+      ttlFixed: uniquePresenceValues(ttlFixed),
+      repairedUsers: repairedNicknames.size,
+      before,
+      after,
+    };
+  }
+
+  async auditChannels(channelIds: string[]): Promise<PresenceAuditSweep> {
+    const channels: ChannelPresenceAudit[] = [];
+    const issueCounts = createEmptyPresenceIssueCounts();
+
+    for (const channelId of uniquePresenceValues(channelIds)) {
+      const audit = await this.auditChannel(channelId);
+      channels.push(audit);
+      addPresenceIssueCounts(issueCounts, audit.issueCounts);
+    }
+
+    const healthyChannels = channels.filter((channel) => channel.healthy).length;
+
+    return {
+      channels,
+      summary: {
+        channelCount: channels.length,
+        healthyChannels,
+        unhealthyChannels: channels.length - healthyChannels,
+        issueCount: totalPresenceIssues(issueCounts),
+        issueCounts,
+      },
+    };
+  }
+
+  async auditAllChannels(): Promise<PresenceAuditSweep> {
+    return await this.auditChannels(await this.discoverChannelIds());
+  }
+
+  async repairChannels(channelIds: string[]): Promise<PresenceRepairSweep> {
+    const repairs: ChannelPresenceRepair[] = [];
+    const repairedNicknames = new Set<string>();
+    const remainingIssueCounts = createEmptyPresenceIssueCounts();
+    let repairedChannels = 0;
+
+    for (const channelId of uniquePresenceValues(channelIds)) {
+      const repair = await this.repairChannel(channelId);
+      repairs.push(repair);
+
+      if (repair.repairedUsers > 0) repairedChannels += 1;
+      for (const nickname of listRepairedNicknames(repair)) {
+        repairedNicknames.add(nickname);
+      }
+      addPresenceIssueCounts(remainingIssueCounts, repair.after.issueCounts);
+    }
+
+    return {
+      repairs,
+      summary: {
+        channelCount: repairs.length,
+        repairedChannels,
+        repairedUsers: repairedNicknames.size,
+        remainingIssues: totalPresenceIssues(remainingIssueCounts),
+        issueCounts: remainingIssueCounts,
+      },
+    };
+  }
+
+  async repairAllChannels(): Promise<PresenceRepairSweep> {
+    return await this.repairChannels(await this.discoverChannelIds());
+  }
+}
+
+export function createPresenceReconciliationService(store?: PresenceStore): PresenceReconciliationService {
+  return new PresenceReconciliationService(store);
+}
+
+export async function auditChannelPresence(
+  channelId: string,
+  store?: PresenceStore,
+): Promise<ChannelPresenceAudit> {
+  return await createPresenceReconciliationService(store).auditChannel(channelId);
+}
+
+export async function repairChannelPresence(
+  channelId: string,
+  store?: PresenceStore,
+): Promise<ChannelPresenceRepair> {
+  return await createPresenceReconciliationService(store).repairChannel(channelId);
+}
+
+export async function auditPresenceChannels(
+  channelIds: string[],
+  store?: PresenceStore,
+): Promise<PresenceAuditSweep> {
+  return await createPresenceReconciliationService(store).auditChannels(channelIds);
+}
+
+export async function repairPresenceChannels(
+  channelIds: string[],
+  store?: PresenceStore,
+): Promise<PresenceRepairSweep> {
+  return await createPresenceReconciliationService(store).repairChannels(channelIds);
+}
