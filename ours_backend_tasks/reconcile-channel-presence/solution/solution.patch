+import {
+  PRESENCE_ISSUE_CODES,
+  createEmptyPresenceIssueCounts,
+  type ChannelPresenceRepair,
+  type PresenceIssue,
+  type PresenceIssueCode,
+  type PresenceIssueCounts,
+} from "#ours/backend/services/presence_reconciliation_types.ts";
+
+const ISSUE_RANK = new Map<PresenceIssueCode, number>(
+  PRESENCE_ISSUE_CODES.map((code, index) => [code, index]),
+);
+
+export function uniquePresenceValues(values: Iterable<string>): string[] {
+  const unique = new Set<string>();
+
+  for (const value of values) {
+    if (value.length === 0) continue;
+    unique.add(value);
+  }
+
+  return [...unique].sort((left, right) => left.localeCompare(right));
+}
+
+export function sortPresenceIssues(issues: Iterable<PresenceIssue>): PresenceIssue[] {
+  return [...issues].sort((left, right) => {
+    const nicknameOrder = left.nickname.localeCompare(right.nickname);
+    if (nicknameOrder !== 0) return nicknameOrder;
+
+    const leftRank = ISSUE_RANK.get(left.code) ?? Number.MAX_SAFE_INTEGER;
+    const rightRank = ISSUE_RANK.get(right.code) ?? Number.MAX_SAFE_INTEGER;
+    return leftRank - rightRank;
+  });
+}
+
+export function countPresenceIssues(issues: Iterable<PresenceIssue>): PresenceIssueCounts {
+  const counts = createEmptyPresenceIssueCounts();
+
+  for (const issue of issues) {
+    counts[issue.code] += 1;
+  }
+
+  return counts;
+}
+
+export function addPresenceIssueCounts(
+  target: PresenceIssueCounts,
+  source: PresenceIssueCounts,
+): PresenceIssueCounts {
+  for (const code of PRESENCE_ISSUE_CODES) {
+    target[code] += source[code];
+  }
+
+  return target;
+}
+
+export function totalPresenceIssues(counts: PresenceIssueCounts): number {
+  let total = 0;
+
+  for (const code of PRESENCE_ISSUE_CODES) {
+    total += counts[code];
+  }
+
+  return total;
+}
+
+export function repairedNicknames(repair: ChannelPresenceRepair): string[] {
+  return uniquePresenceValues([
+    ...repair.removed,
+    ...repair.added,
+    ...repair.ttlFixed,
+  ]);
+}
+
+export function collectRepairedNicknames(
+  repairs: Iterable<ChannelPresenceRepair>,
+): Set<string> {
+  const nicknames = new Set<string>();
+
+  for (const repair of repairs) {
+    for (const nickname of repairedNicknames(repair)) {
+      nicknames.add(nickname);
+    }
+  }
+
+  return nicknames;
+}
