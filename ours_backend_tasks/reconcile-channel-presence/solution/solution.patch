+
+export async function getUserTtl(nickname: string): Promise<number> {
+  const client = await getNodeClient();
+  return await client.ttl(`user:${nickname}`);
+}
+
+export async function ensureUserTtl(
+  nickname: string,
+  ttlSeconds = DEFAULT_TTL_SECONDS,
+): Promise<boolean> {
+  const client = await getNodeClient();
+  const key = `user:${nickname}`;
+  const ttl = await client.ttl(key);
+
+  if (ttl === -2) return false;
+  if (ttl !== -1) return false;
+
+  return Boolean(await client.expire(key, ttlSeconds));
+}
+
+export async function listUserNicknames(): Promise<string[]> {
+  const client = await getNodeClient();
+  const keys: string[] = await client.keys("user:*");
+  return [...new Set<string>(keys.map((key: string) => key.slice("user:".length)).filter(Boolean))].sort((a, b) =>
+    a.localeCompare(b),
+  );
+}
+
+export async function listChannelIds(): Promise<string[]> {
+  const client = await getNodeClient();
+  const keys: string[] = await client.keys("channel:*:users");
+  const channelIds: string[] = [];
+
+  for (const key of keys) {
+    const match = /^channel:(.+):users$/.exec(key);
+    if (match?.[1]) channelIds.push(match[1]);
+  }
+
+  return [...new Set(channelIds)].sort((a, b) => a.localeCompare(b));
+}
+
 export async function userExists(nickname: string, userId?: string): Promise<boolean> {
   const client = await getNodeClient();
   const key = `user:${nickname}`;
